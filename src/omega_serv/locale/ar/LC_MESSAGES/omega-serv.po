msgstr "اسم سلطة الشهادات."

#: src/omega_serv/interfaces/cli/main.py:2030
msgid "Validité en jours (défaut : 3650)."
msgstr "الصلاحية بالأيام (الافتراضي: 3650)."

#: src/omega_serv/interfaces/cli/main.py:2032
msgid "Type de clé (défaut : rsa4096)."
msgstr "نوع المفتاح (الافتراضي: rsa4096)."

