msgid "Organisation (défaut : OMEGA-SERV)."
msgstr "المؤسسة (الافتراضي: OMEGA-SERV)."

#: src/omega_serv/interfaces/cli/main.py:2002
msgid "Service ou département."
msgstr "الوحدة أو القسم."

#: src/omega_serv/interfaces/cli/main.py:2003
msgid "Ville."
msgstr "المدينة."

#: src/omega_serv/interfaces/cli/main.py:2004
msgid "Région."
msgstr "المنطقة."

#: src/omega_serv/interfaces/cli/main.py:2005
