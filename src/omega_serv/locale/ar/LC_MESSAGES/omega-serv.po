#: src/omega_serv/interfaces/cli/main.py:2152
msgid "TEXTE"
msgstr "نص"

#: src/omega_serv/interfaces/cli/main.py:1830
msgid "Texte libre enregistré avec la sauvegarde."
msgstr "نص حر يُحفظ مع النسخة الاحتياطية."

#: src/omega_serv/interfaces/cli/main.py:1832
msgid "Restaure une sauvegarde."
msgstr "يستعيد نسخة احتياطية."

#: src/omega_serv/interfaces/cli/main.py:1833
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:80
