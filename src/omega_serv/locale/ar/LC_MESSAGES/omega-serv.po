#: src/omega_serv/interfaces/cli/main.py:1903
#: src/omega_serv/interfaces/cli/riposte_action_commands.py:322
msgid "RESEAU"
msgstr "شبكة"

#: src/omega_serv/interfaces/cli/main.py:1894
