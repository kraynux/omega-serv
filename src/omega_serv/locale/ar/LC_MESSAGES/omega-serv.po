msgstr "عنوان IP أو شبكة CIDR، مثلًا 203.0.113.7 أو 203.0.113.0/24."

#: src/omega_serv/interfaces/cli/main.py:1895
msgid "Motif du ban."
msgstr "سبب الحظر."

#: src/omega_serv/interfaces/cli/main.py:1896
#: src/omega_serv/interfaces/cli/main.py:2160
msgid "SECONDES"
msgstr "ثوان"

