msgid "FORMATS"
msgstr "صيغ"

#: src/omega_serv/interfaces/cli/main.py:1980
msgid ""
"Un ou plusieurs formats séparés par des virgules : json, csv, stix, misp "
"(défaut : json)."
msgstr "صيغة أو أكثر مفصولة بفواصل: json, csv, stix, misp (الافتراضي: json)."

#: src/omega_serv/interfaces/cli/main.py:1983
msgid "Écrit le rapport Markdown d'un incident."
msgstr "يكتب تقرير Markdown لحادثة."

#: src/omega_serv/interfaces/cli/main.py:1987
msgid "Leurres Active Defense."
msgstr "طُعوم Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1988
msgid "Liste les sources envoyées vers un leurre."
msgstr "يسرد المصادر المرسلة إلى طُعم."

#: src/omega_serv/interfaces/cli/main.py:1990
msgid "Libère une source de son leurre."
msgstr "يحرّر مصدرًا من طُعمه."

#: src/omega_serv/interfaces/cli/main.py:1992
msgid "Identifiant de la source, tel qu'affiché par deception list."
msgstr "معرّف المصدر كما يعرضه deception list."

#: src/omega_serv/interfaces/cli/main.py:1995
msgid "Certificats TLS (via OpenSSL)."
msgstr "شهادات TLS (عبر OpenSSL)."

