msgstr "ملف الإعداد (الافتراضي: config/omega-serve.json الخاص بالتثبيت)."

#: src/omega_serv/interfaces/cli/main.py:1778
msgid "Accepte un certificat auto-signé sur une adresse publique."
msgstr "يقبل شهادة موقّعة ذاتيًا على عنوان عام."

#: src/omega_serv/interfaces/cli/main.py:1779
msgid ""
"Accepte des zones à mot de passe sans TLS (mots de passe lisibles sur le "
"réseau)."
msgstr ""
"يقبل مناطق محمية بكلمة مرور بدون TLS (كلمات المرور مقروءة على الشبكة)."

#: src/omega_serv/interfaces/cli/main.py:1780
msgid "Méthode HTTP (défaut : GET)."
msgstr "طريقة HTTP (الافتراضي: GET)."

#: src/omega_serv/interfaces/cli/main.py:1783
msgid ""
"Démarre le serveur au premier plan (c'est ce que lance le service système). "
"Refuse de tourner en root."
msgstr ""
"يشغّل الخادم في المقدمة (هذا ما تشغّله خدمة النظام). يرفض العمل بصلاحيات "
"root."

#: src/omega_serv/interfaces/cli/main.py:1789
msgid "Fichier de configuration : création, vérification, TLS, sauvegardes."
msgstr "ملف الإعداد: الإنشاء، الفحص، TLS، النسخ الاحتياطية."

#: src/omega_serv/interfaces/cli/main.py:1790
msgid "Crée le fichier de configuration par défaut."
msgstr "ينشئ ملف الإعداد الافتراضي."

#: src/omega_serv/interfaces/cli/main.py:1791
msgid "Écrase le fichier existant."
msgstr "يستبدل الملف الموجود."

#: src/omega_serv/interfaces/cli/main.py:1794
msgid ""
"Vérifie la configuration et l'environnement (chemins, droits, certificats) "
"sans démarrer."
msgstr "يفحص الإعداد والبيئة (المسارات، الصلاحيات، الشهادات) دون تشغيل."

#: src/omega_serv/interfaces/cli/main.py:1798
msgid "Affiche la configuration chargée, en JSON."
msgstr "يعرض الإعداد المحمَّل بصيغة JSON."

#: src/omega_serv/interfaces/cli/main.py:1799
msgid "Active TLS dans la configuration."
msgstr "يفعّل TLS في الإعداد."

#: src/omega_serv/interfaces/cli/main.py:1801
msgid "Certificat à utiliser (sinon celui déjà configuré)."
msgstr "الشهادة المستخدمة (وإلا فالمُعدّة مسبقًا)."

#: src/omega_serv/interfaces/cli/main.py:1803
msgid "Clé privée à utiliser (sinon celle déjà configurée)."
msgstr "المفتاح الخاص المستخدم (وإلا فالمُعدّ مسبقًا)."

#: src/omega_serv/interfaces/cli/main.py:1805
msgid ""
"direct : omega-serv chiffre lui-même ; behind_proxy : derrière un reverse "
"proxy (défaut : direct)."
msgstr ""
"direct: يتولى omega-serv التشفير بنفسه؛ behind_proxy: خلف وكيل عكسي "
"(الافتراضي: direct)."

#: src/omega_serv/interfaces/cli/main.py:1807
msgid "Désactive TLS dans la configuration."
msgstr "يعطّل TLS في الإعداد."

#: src/omega_serv/interfaces/cli/main.py:1810
msgid ""
"Crée une sauvegarde : la configuration toujours, le reste selon les options "
"--include-*."
msgstr "ينشئ نسخة احتياطية: الإعداد دائمًا، والباقي حسب خيارات --include-*."

#: src/omega_serv/interfaces/cli/main.py:1811
msgid "Ajoute les règles et listes du WAF."
msgstr "يضيف قواعد WAF وقوائمه."

#: src/omega_serv/interfaces/cli/main.py:1813
msgid ""
"Ajoute les utilisateurs et les zones protégées (secrets : demande --confirm-"
"secrets)."
msgstr "يضيف المستخدمين والمناطق المحمية (أسرار: يتطلب --confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:1815
msgid ""
"Ajoute les certificats et les clés TLS (secrets : demande --confirm-"
"secrets)."
msgstr "يضيف شهادات TLS ومفاتيحه (أسرار: يتطلب --confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:1817
msgid "Ajoute la base Active Defense."
msgstr "يضيف قاعدة بيانات Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1819
msgid "Ajoute les pages d'erreur personnalisées."
msgstr "يضيف صفحات الخطأ المخصصة."

#: src/omega_serv/interfaces/cli/main.py:1821
msgid "Ajoute les préférences de l'interface."
msgstr "يضيف تفضيلات الواجهة."

#: src/omega_serv/interfaces/cli/main.py:1823
msgid "Ajoute la bibliothèque des journaux."
msgstr "يضيف مكتبة السجلات."

#: src/omega_serv/interfaces/cli/main.py:1824
msgid "Ajoute la base RIPOSTE."
msgstr "يضيف قاعدة بيانات RIPOSTE."

#: src/omega_serv/interfaces/cli/main.py:1826
msgid ""
"Tout sauvegarder : toutes les options --include-* (secrets compris : demande"
" --confirm-secrets)."
msgstr ""
"نسخ كل شيء احتياطيًا: كل خيارات --include-* (مع الأسرار: يتطلب --confirm-"
"secrets)."

#: src/omega_serv/interfaces/cli/main.py:1828
msgid ""
"Confirme l'ajout de secrets non chiffrés (hash de mots de passe, clés "
"privées)."
msgstr "يؤكد إضافة أسرار غير مشفّرة (تجزئات كلمات المرور، المفاتيح الخاصة)."

