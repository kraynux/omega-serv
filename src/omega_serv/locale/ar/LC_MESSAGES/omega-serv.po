msgid "Clé privée à créer."
msgstr "المفتاح الخاص المراد إنشاؤه."

#: src/omega_serv/interfaces/cli/main.py:2043
msgid "Demande de signature à créer."
msgstr "طلب التوقيع المراد إنشاؤه."

