msgstr "TLS (قائمة)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:12
msgid "Accueil -> Configuration détaillée -> TLS"
msgstr "الرئيسية -> التهيئة التفصيلية -> TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:13
msgid ""
"Sous-menu regroupant les 5 écrans liés à TLS : statut, génération, CA "
"locale, révocation, activation."
msgstr ""
"قائمة فرعية تجمع شاشات TLS الخمس: الحالة، الإنشاء، CA المحلية، الإبطال، "
"التفعيل."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:20
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:55
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:28
msgid "Statut TLS"
msgstr "حالة TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:21
msgid "Configuration détaillée -> TLS -> Statut TLS"
msgstr "التهيئة التفصيلية -> TLS -> حالة TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:22
msgid ""
"Inspecte le certificat actuellement configuré : validité, expiration, "
"correspondance avec la clé privée, permissions."
msgstr ""
"يفحص الشهادة المهيأة حاليًا: الصلاحية، الانتهاء، التطابق مع المفتاح الخاص، "
"الأذونات."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:26
msgid "Relit et reanalyse le certificat configuré."
msgstr "يعيد قراءة الشهادة المهيأة وتحليلها."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:28
msgid "Relance l'inspection."
msgstr "يعيد الفحص."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:35
msgid ""
"Inspecte le FICHIER sur disque, pas nécessairement celui réellement servi "
"par un serveur déjà lancé si celui-ci a changé depuis le dernier "
"redémarrage."
msgstr ""
"يفحص الملف على القرص، وليس بالضرورة ذلك الذي يقدّمه فعلًا خادم مُشغَّل "
"مسبقًا إذا تغيّر منذ آخر إعادة تشغيل."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:43
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:56
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:29
msgid "Générer un certificat auto-signé"
msgstr "إنشاء شهادة موقّعة ذاتيًا"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:44
msgid "Configuration détaillée -> TLS -> Générer un certificat auto-signé"
msgstr "التهيئة التفصيلية -> TLS -> إنشاء شهادة موقّعة ذاتيًا"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:45
msgid ""
"Génère un certificat auto-signé (jamais reconnu par défaut par les "
"navigateurs) et l'écrit sur disque."
msgstr ""
"ينشئ شهادة موقّعة ذاتيًا (لا تعترف بها المتصفحات افتراضيًا أبدًا) ويكتبها "
"على القرص."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:48
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:99
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:86
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:41
#: src/omega_serv/interfaces/tui/screens/wizard_tls_screen.py:51
msgid "Nom commun (CN)"
msgstr "الاسم الشائع (CN)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:49
msgid "Nom commun du certificat."
msgstr "الاسم الشائع للشهادة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:50
msgid "Chaîne libre, généralement le nom d'hôte du serveur."
msgstr "نص حر، عادةً اسم مضيف الخادم."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:51
#: src/omega_serv/interfaces/tui/guide/content/tls.py:58
#: src/omega_serv/interfaces/tui/guide/content/tls.py:65
#: src/omega_serv/interfaces/tui/guide/content/tls.py:72
#: src/omega_serv/interfaces/tui/guide/content/tls.py:79
#: src/omega_serv/interfaces/tui/guide/content/tls.py:86
msgid "Utilisé à la génération."
msgstr "يُستخدم عند الإنشاء."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:52
msgid "Écrit réellement le certificat/la clé sur disque immédiatement."
msgstr "يكتب الشهادة/المفتاح فعليًا على القرص فورًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:55
msgid "SAN DNS / SAN IP"
msgstr "SAN DNS / SAN IP"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:56
msgid "Noms DNS et adresses IP alternatifs couverts par le certificat."
msgstr "أسماء DNS وعناوين IP البديلة التي تغطيها الشهادة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:57
msgid "Listes séparées par des virgules, optionnelles."
msgstr "قوائم مفصولة بفواصل، اختيارية."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:59
#: src/omega_serv/interfaces/tui/guide/content/tls.py:66
#: src/omega_serv/interfaces/tui/guide/content/tls.py:73
#: src/omega_serv/interfaces/tui/guide/content/tls.py:80
#: src/omega_serv/interfaces/tui/guide/content/tls.py:87
msgid "Écrit sur disque immédiatement."
msgstr "يكتب على القرص فورًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:62
msgid "Organisation / Unité / Ville / Région / Pays"
msgstr "المؤسسة / الوحدة / المدينة / المنطقة / البلد"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:63
msgid "Champs d'identité du certificat (sujet X.509)."
msgstr "حقول هوية الشهادة (موضوع X.509)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:64
msgid ""
"Chaînes libres, tous optionnels sauf Organisation (pré-rempli : OMEGA-SERV)."
msgstr "نصوص حرة، كلها اختيارية عدا المؤسسة (مملوءة مسبقًا: OMEGA-SERV)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:69
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:92
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:55
msgid "Validité en jours"
msgstr "الصلاحية بالأيام"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:70
msgid "Durée de validité du certificat généré."
msgstr "مدة صلاحية الشهادة المنشأة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:71
msgid "Entier positif, en jours. Valeur par défaut : 365."
msgstr "عدد صحيح موجب، بالأيام. القيمة الافتراضية: 365."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:76
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:113
msgid "Type de clé"
msgstr "نوع المفتاح"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:77
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:114
msgid "Algorithme et taille de la clé privée générée."
msgstr "خوارزمية المفتاح الخاص المنشأ وحجمه."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:78
msgid ""
"Valeurs valides indiquées dans le sous-titre. Valeur par défaut : rsa2048."
msgstr "القيم الصالحة مذكورة في العنوان الفرعي. القيمة الافتراضية: rsa2048."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:83
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:59
msgid "Mot de passe de clé (optionnel)"
msgstr "كلمة مرور المفتاح (اختيارية)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:84
msgid "Passphrase protégeant la clé privée générée."
msgstr "عبارة مرور تحمي المفتاح الخاص المنشأ."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:85
msgid "Chaîne libre, optionnelle - saisie masquée."
msgstr "نص حر، اختياري - إدخال مخفي."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:91
msgid ""
"Génère réellement des fichiers sur disque des le clic sur Générer. Si TLS "
"est DÉJÀ actif, le serveur en cours d'exécution continue de servir l'ANCIEN "
"certificat jusqu'à un REDÉMARRAGE COMPLET, même si le fichier a changé (le "
"contexte SSL n'est construit qu'une seule fois au démarrage)."
msgstr ""
"ينشئ ملفات فعليًا على القرص فور النقر على إنشاء. إذا كان TLS نشطًا مسبقًا، "
"يواصل الخادم الجاري تقديم الشهادة القديمة حتى إعادة تشغيل كاملة، حتى لو "
"تغيّر الملف (لا يُبنى سياق SSL إلا مرة واحدة عند الإقلاع)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:100
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:57
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:30
msgid "Assistant CA locale"
msgstr "معالج CA المحلية"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:101
msgid "Configuration détaillée -> TLS -> Assistant CA locale"
msgstr "التهيئة التفصيلية -> TLS -> معالج CA المحلية"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:103
msgid ""
"Enchaîne trois étapes indépendantes : générer une autorité de certification "
"locale, générer une demande de signature (CSR) pour ce serveur, signer cette"
" CSR avec la CA - permet d'obtenir un certificat reconnu par les clients "
"ayant importe la CA, sans passer par une autorité publique."
msgstr ""
"يسلسل ثلاث خطوات مستقلة: إنشاء سلطة شهادات محلية، إنشاء طلب توقيع (CSR) لهذا"
" الخادم، توقيع هذا الـ CSR بالـ CA - يتيح الحصول على شهادة يعترف بها العملاء"
" الذين استوردوا الـ CA، دون المرور بسلطة عامة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:110
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:61
msgid "1. Générer la CA"
msgstr "1. إنشاء الـ CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:111
msgid "Crée l'autorité de certification locale (clé + certificat racine)."
msgstr "ينشئ سلطة الشهادات المحلية (المفتاح + الشهادة الجذر)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:112
msgid ""
"CN, organisation, validité (défaut 3650 jours), type de clé, passphrase "
"OBLIGATOIRE (saisie deux fois)."
msgstr ""
"CN، المؤسسة، الصلاحية (الافتراضي 3650 يومًا)، نوع المفتاح، عبارة مرور "
"إلزامية (تُدخل مرتين)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:113
msgid ""
"Écrit root-ca.key/root-ca.pem/serial.txt/index.txt sous "
"secure/certificates/ca/."
msgstr ""
"يكتب root-ca.key/root-ca.pem/serial.txt/index.txt تحت "
"secure/certificates/ca/."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:114
msgid "Écrit réellement sur disque immédiatement. À faire une seule fois."
msgstr "يكتب فعليًا على القرص فورًا. يُجرى مرة واحدة فقط."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:117
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:63
msgid "2. Générer la CSR"
msgstr "2. إنشاء الـ CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:118
msgid "Crée une demande de signature de certificat pour CE serveur."
msgstr "ينشئ طلب توقيع شهادة لهذا الخادم."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:119
msgid "CN, SAN DNS/IP, identité, type de clé - pas de passphrase ici."
msgstr "CN، ‏SAN DNS/IP، الهوية، نوع المفتاح - لا عبارة مرور هنا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:120
msgid "Écrit le fichier .csr à côté de la clé privée du serveur."
msgstr "يكتب ملف ‎.csr بجوار المفتاح الخاص للخادم."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:121
msgid "Écrit réellement sur disque immédiatement."
msgstr "يكتب فعليًا على القرص فورًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:124
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:65
msgid "3. Signer la CSR"
msgstr "3. توقيع الـ CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:125
msgid ""
"Signe la CSR générée à l'étape 2 avec la CA de l'étape 1, produit le "
"certificat final."
msgstr ""
"يوقّع الـ CSR المنشأ في الخطوة 2 بالـ CA من الخطوة 1، وينتج الشهادة "
"النهائية."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:126
msgid ""
"Chemin de la CSR (pré-rempli), passphrase de la CA (resaisie), validité en "
"jours (défaut 365)."
msgstr ""
"مسار الـ CSR (مملوء مسبقًا)، عبارة مرور الـ CA (تُعاد كتابتها)، الصلاحية "
"بالأيام (الافتراضي 365)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:127
msgid "Écrit le certificat signé (et la chaîne complète) sur disque."
msgstr "يكتب الشهادة الموقّعة (والسلسلة الكاملة) على القرص."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:129
msgid ""
"Écrit réellement sur disque immédiatement. Si TLS est DÉJÀ actif, un "
"REDÉMARRAGE COMPLET reste nécessaire pour que le serveur serve ce nouveau "
"certificat (le contexte SSL en mémoire ne se recharge jamais tout seul)."
msgstr ""
"يكتب فعليًا على القرص فورًا. إذا كان TLS نشطًا مسبقًا، تبقى إعادة التشغيل "
"الكاملة لازمة ليقدّم الخادم هذه الشهادة الجديدة (سياق SSL في الذاكرة لا "
"يُعاد تحميله وحده أبدًا)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:136
msgid ""
"Le certificat racine de la CA (root-ca.pem) doit être importe manuellement "
"dans le magasin de confiance de chaque client pour que le certificat final "
"soit reconnu - rappelé dans le journal de l'assistant après chaque étape "
"réussie."
msgstr ""
"يجب استيراد الشهادة الجذر للـ CA ‏(root-ca.pem) يدويًا في مخزن الثقة لدى كل "
"عميل ليُعترف بالشهادة النهائية - يُذكَّر بذلك في سجل المعالج بعد كل خطوة "
"ناجحة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:142
msgid ""
"La passphrase de la CA n'est jamais conservée en mémoire entre les étapes - "
"elle est resaisie explicitement à l'étape 3."
msgstr ""
"لا تُحفظ عبارة مرور الـ CA في الذاكرة بين الخطوات أبدًا - تُعاد كتابتها "
"صراحةً في الخطوة 3."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:150
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:58
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:31
msgid "Assistant Let's Encrypt (Certbot)"
msgstr "معالج Let's Encrypt ‏(Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:151
msgid "Configuration détaillée -> TLS -> Assistant Let's Encrypt (Certbot)"
msgstr "التهيئة التفصيلية -> TLS -> معالج Let's Encrypt ‏(Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:153
msgid ""
"Obtient un certificat public reconnu par les navigateurs via Certbot (défi "
"HTTP-01, mode webroot) - jamais --standalone (le port 80 est déjà occupé par"
" OMEGA-SERV) et jamais /etc/letsencrypt/ (tout est écrit sous "
"secure/certificates/letsencrypt/ du projet, entièrement non-privilégié). "
"Importe automatiquement le certificat obtenu et installe un script de "
"renouvellement (voir Renouvellement automatique (Certbot))."
msgstr ""
"يحصل على شهادة عامة تعترف بها المتصفحات عبر Certbot (تحدي HTTP-01، وضع "
"webroot) - ليس أبدًا --standalone (المنفذ 80 يشغله OMEGA-SERV مسبقًا) وليس "
"أبدًا /etc/letsencrypt/ (يُكتب كل شيء تحت secure/certificates/letsencrypt/ "
"للمشروع، دون صلاحيات مميزة كليًا). يستورد الشهادة المحصَّلة تلقائيًا ويثبّت "
"سكربت تجديد (انظر التجديد التلقائي (Certbot))."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:161
msgid "Domaine"
msgstr "النطاق"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:162
msgid "Nom de domaine public déjà pointé vers ce serveur (obligatoire)."
msgstr "اسم نطاق عام يشير مسبقًا إلى هذا الخادم (إلزامي)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:163
msgid ""
"Ex : monserveur.dynu.com - un DDNS (Dynu ou équivalent) reste à configurer "
"par vous-même, hors de cet assistant."
msgstr ""
"مثال: monserveur.dynu.com - يبقى عليك تهيئة DDNS ‏(Dynu أو ما يعادلها) "
"بنفسك، خارج هذا المعالج."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:164
msgid "Utilisé pour la demande Certbot et le défi HTTP-01."
msgstr "يُستخدم لطلب Certbot ولتحدي HTTP-01."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:165
msgid ""
"Aucun effet avant confirmation - le résumé préalable rappelle le domaine et "
"le mode choisis."
msgstr "لا أثر قبل التأكيد - يذكّر الملخص المسبق بالنطاق والوضع المختارين."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:168
msgid "Email"
msgstr "البريد الإلكتروني"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:169
msgid ""
"Adresse utilisée par Let's Encrypt pour les alertes d'expiration "
"(optionnelle)."
msgstr "العنوان الذي تستخدمه Let's Encrypt لتنبيهات الانتهاء (اختياري)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:170
msgid ""
"Chaîne libre. Vide : Certbot s'enregistre sans email (--register-unsafely-"
"without-email)."
msgstr ""
"نص حر. فارغ: يُسجَّل Certbot دون بريد (--register-unsafely-without-email)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:171
msgid "Transmis à Certbot à la demande."
msgstr "يُمرَّر إلى Certbot عند الطلب."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:172
msgid "Aucun effet avant confirmation."
msgstr "لا أثر قبل التأكيد."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:175
msgid "Mode test (staging)"
msgstr "وضع الاختبار (staging)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:176
msgid ""
"Utilise l'environnement de test de Let's Encrypt plutôt que la production."
msgstr "يستخدم بيئة الاختبار لدى Let's Encrypt بدلًا من الإنتاج."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:177
msgid ""
"Case à cocher, COCHÉE PAR DÉFAUT - certificat non reconnu par les "
"navigateurs mais jamais soumis aux limites de taux réelles."
msgstr ""
"خانة اختيار، محدَّدة افتراضيًا - شهادة لا تعترف بها المتصفحات لكنها لا تخضع "
"أبدًا لحدود المعدل الحقيقية."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:178
msgid "Transmis à Certbot (--staging) si coché."
msgstr "يُمرَّر إلى Certbot ‏(--staging) إذا حُدّد."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:179
msgid ""
"À décocher seulement une fois le domaine/webroot vérifiés fonctionnels en "
"mode test."
msgstr "لا يُلغى تحديده إلا بعد التحقق من عمل النطاق/webroot في وضع الاختبار."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:182
#: src/omega_serv/interfaces/tui/screens/lets_encrypt_screen.py:70
msgid "Obtenir le certificat"
msgstr "الحصول على الشهادة"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:183
msgid "Lance la demande après un résumé et une confirmation explicite."
msgstr "يطلق الطلب بعد ملخص وتأكيد صريح."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:184
msgid "Aucune saisie - déclenche l'appel réseau réel à Let's Encrypt."
msgstr "لا إدخال - يُطلق الاستدعاء الشبكي الحقيقي إلى Let's Encrypt."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:185
msgid ""
"Exécute Certbot puis importe le certificat obtenu (déporté dans un thread de"
" travail, l'interface reste réactive)."
msgstr ""
"ينفّذ Certbot ثم يستورد الشهادة المحصَّلة (في خيط عمل منفصل، وتبقى الواجهة "
"مستجيبة)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:187
msgid ""
"Écrit réellement sur disque en cas de succès. Si TLS est DÉJÀ actif, le "
"serveur en cours d'exécution continue de servir l'ANCIEN certificat jusqu'à "
"un REDÉMARRAGE COMPLET."
msgstr ""
"يكتب فعليًا على القرص عند النجاح. إذا كان TLS نشطًا مسبقًا، يواصل الخادم "
"الجاري تقديم الشهادة القديمة حتى إعادة تشغيل كاملة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:194
msgid ""
"Le port 80 doit rester accessible depuis Internet le temps du défi HTTP-01 "
"(webroot) - échoue sinon (pare-feu, redirection de port non faite sur le "
"routeur, DNS/DDNS pas encore propagé). Soumis aux limites de taux réelles de"
" Let's Encrypt en mode production (jamais en mode test)."
msgstr ""
"يجب أن يبقى المنفذ 80 قابلًا للوصول من الإنترنت طوال تحدي HTTP-01 ‏(webroot)"
" - وإلا يفشل (جدار حماية، إعادة توجيه منفذ لم تُجرَ على الموجّه، DNS/DDNS لم"
" ينتشر بعد). يخضع لحدود المعدل الحقيقية لدى Let's Encrypt في وضع الإنتاج "
"(وليس أبدًا في وضع الاختبار)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:201
msgid ""
"Le DDNS (Dynu ou équivalent) et la redirection de port restent ENTIÈREMENT à"
" votre charge - cet assistant ne configure jamais rien en dehors de ce "
"serveur."
msgstr ""
"يبقى DDNS ‏(Dynu أو ما يعادلها) وإعادة توجيه المنافذ على عاتقك كليًا - لا "
"يهيّئ هذا المعالج أبدًا أي شيء خارج هذا الخادم."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:205
msgid ""
"Si OMEGA-SERV tourne dans un conteneur : exécutez cet assistant HORS du "
"conteneur qui sert le trafic (sur l'hôte, ou un conteneur/sidecar distinct "
"partageant le même volume secure/ et le même webroot) - jamais Certbot à "
"l'intérieur du conteneur servant déjà le trafic public, voir la FAQ."
msgstr ""
"إذا كان OMEGA-SERV يعمل داخل حاوية: شغّل هذا المعالج خارج الحاوية التي تقدّم"
" حركة المرور (على المضيف، أو في حاوية/sidecar منفصلة تشارك وحدة التخزين "
"secure/ نفسها وwebroot نفسه) - وليس Certbot أبدًا داخل الحاوية التي تقدّم "
"حركة المرور العامة مسبقًا، انظر الأسئلة الشائعة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:215
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:59
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:32
msgid "Renouvellement automatique (Certbot)"
msgstr "التجديد التلقائي (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:216
msgid "Configuration détaillée -> TLS -> Renouvellement automatique (Certbot)"
msgstr "التهيئة التفصيلية -> TLS -> التجديد التلقائي (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:218
msgid ""
"Planifie le renouvellement automatique des certificats Certbot déjà obtenus "
"(Assistant Let's Encrypt) - s'adapte au gestionnaire de service réellement "
"détecté pour CETTE instance : timer systemd installé depuis l'interface, "
"sinon une ligne crontab si possible, sinon des instructions manuelles "
"affichées sans rien écrire. Jamais un mécanisme global partagé entre "
"plusieurs instances multi-instance."
msgstr ""
"يجدول التجديد التلقائي لشهادات Certbot المحصَّلة مسبقًا (معالج Let's "
"Encrypt) - يتكيف مع مدير الخدمات المكتشف فعلًا لهذا المثيل: مؤقّت systemd "
"يُثبَّت من الواجهة، وإلا سطر crontab إن أمكن، وإلا تُعرض تعليمات يدوية دون "
"كتابة أي شيء. وليس أبدًا آلية عامة مشتركة بين عدة مثيلات."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:226
#: src/omega_serv/interfaces/tui/screens/renewal_schedule_screen.py:51
msgid "Configurer maintenant"
msgstr "التهيئة الآن"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:227
msgid ""
"Installe (ou réinstalle) le mécanisme de renouvellement adapté à ce système."
msgstr "يثبّت (أو يعيد تثبيت) آلية التجديد الملائمة لهذا النظام."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:230
msgid ""
"systemd : écrit et active un timer (sudo ponctuel, même mécanisme que "
"l'écran SERVICE). OpenRC/runit/aucun gestionnaire reconnu : ajoute une ligne"
" à votre crontab utilisateur si `crontab` est disponible, sinon affiche la "
"ligne à ajouter vous-même."
msgstr ""
"systemd: يكتب مؤقّتًا ويفعّله (sudo مؤقت، الآلية نفسها لشاشة SERVICE). "
"OpenRC/runit/لا مدير معروف: يضيف سطرًا إلى crontab المستخدم إن كان `crontab`"
" متاحًا، وإلا يعرض السطر لتضيفه بنفسك."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:235
msgid ""
"Reconfigurer ne dupliqué jamais l'entrée (idempotent) - remplace toujours "
"l'entrée précédente de CETTE instance."
msgstr ""
"إعادة التهيئة لا تكرر الإدخال أبدًا (idempotent) - تستبدل دائمًا الإدخال "
"السابق لهذا المثيل."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:239
msgid ""
"Une fois installé, le renouvellement tourne deux fois par jour sans aucune "
"intervention - le script de hook (Assistant Let's Encrypt) réimporte "
"automatiquement chaque certificat renouvelé puis redémarre le service."
msgstr ""
"بعد التثبيت، يعمل التجديد مرتين يوميًا دون أي تدخل - يعيد سكربت hook ‏(معالج"
" Let's Encrypt) استيراد كل شهادة مجدَّدة تلقائيًا ثم يعيد تشغيل الخدمة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:245
msgid ""
"Sur certaines distributions (dont Arch/Manjaro), le paquet Certbot "
"n'installe AUCUN timer par défaut, contrairement à Debian/Ubuntu - vérifiez "
"toujours le statut affiché ici plutôt que de supposer qu'un mécanisme existe"
" déjà."
msgstr ""
"في بعض التوزيعات (منها Arch/Manjaro)، لا تثبّت حزمة Certbot أي مؤقّت "
"افتراضيًا، بخلاف Debian/Ubuntu - تحقق دائمًا من الحالة المعروضة هنا بدلًا من"
" افتراض وجود آلية مسبقًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:250
msgid ""
"Ne concerne QUE les certificats gérés par Certbot "
"(secure/certificates/letsencrypt/) - un certificat auto-signé ou signé par "
"la CA locale n'a pas besoin (et ne bénéficie pas) de ce renouvellement."
msgstr ""
"لا يخص إلا الشهادات التي يديرها Certbot ‏(secure/certificates/letsencrypt/) "
"- الشهادة الموقّعة ذاتيًا أو الموقّعة من الـ CA المحلية لا تحتاج (ولا تستفيد"
" من) هذا التجديد."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:259
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:60
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:33
msgid "Révoquer un certificat"
msgstr "إبطال شهادة"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:260
msgid "Configuration détaillée -> TLS -> Révoquer un certificat"
msgstr "التهيئة التفصيلية -> TLS -> إبطال شهادة"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:261
msgid ""
"Marque un certificat comme révoqué dans le registre de la CA (index.txt) - "
"action irréversible pour ce certificat."
msgstr ""
"يسم شهادة كمُبطَلة في سجل الـ CA ‏(index.txt) - إجراء لا رجعة فيه لهذه "
"الشهادة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:264
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:40
msgid "Certificat à révoquer"
msgstr "الشهادة المراد إبطالها"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:265
msgid "Chemin du certificat à marquer comme révoqué."
msgstr "مسار الشهادة المراد وسمها كمُبطَلة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:266
msgid "Chemin relatif au projet."
msgstr "مسار نسبي للمشروع."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:267
#: src/omega_serv/interfaces/tui/guide/content/tls.py:274
#: src/omega_serv/interfaces/tui/guide/content/tls.py:281
msgid "Utilisé à la confirmation."
msgstr "يُستخدم عند التأكيد."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:268
msgid "Modifie index.txt immédiatement après confirmation."
msgstr "يعدّل index.txt فور التأكيد."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:271
msgid "Clé / Certificat de la CA"
msgstr "مفتاح / شهادة الـ CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:272
msgid ""
"Identité de l'autorité de certification qui a signé le certificat visé."
msgstr "هوية سلطة الشهادات التي وقّعت الشهادة المستهدفة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:273
msgid "Chemins pré-remplis vers secure/certificates/ca/."
msgstr "مسارات مملوءة مسبقًا نحو secure/certificates/ca/."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:275
#: src/omega_serv/interfaces/tui/guide/content/tls.py:282
msgid "Modifie index.txt immédiatement."
msgstr "يعدّل index.txt فورًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:278
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:127
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:52
msgid "Passphrase de la clé CA"
msgstr "عبارة مرور مفتاح الـ CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:279
msgid "Nécessaire pour prouver l'autorité sur la CA avant de révoquer."
msgstr "لازمة لإثبات السلطة على الـ CA قبل الإبطال."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:280
msgid "Saisie masquée."
msgstr "إدخال مخفي."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:286
msgid ""
"Demande une confirmation explicite (action irréversible pour ce certificat)."
" Si le certificat révoqué est celui ACTUELLEMENT utilisé par un serveur TLS "
"déjà actif, un REDÉMARRAGE COMPLET est nécessaire, sinon il continue d'être "
"présenté aux clients malgré sa révocation."
msgstr ""
"يطلب تأكيدًا صريحًا (إجراء لا رجعة فيه لهذه الشهادة). إذا كانت الشهادة "
"المُبطَلة هي تلك المستخدمة حاليًا من خادم TLS نشط مسبقًا، تلزم إعادة تشغيل "
"كاملة، وإلا تبقى تُقدَّم للعملاء رغم إبطالها."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:293
msgid ""
"Pas de distribution CRL complète en V1 - la révocation reste locale "
"(index.txt), jamais publiée vers les clients automatiquement."
msgstr ""
"لا توزيع CRL كامل في V1 - يبقى الإبطال محليًا (index.txt)، ولا يُنشر للعملاء"
" تلقائيًا أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:301
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:61
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:34
msgid "Activer / désactiver TLS"
msgstr "تفعيل / تعطيل TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:302
msgid "Configuration détaillée -> TLS -> Activer / désactiver TLS"
msgstr "التهيئة التفصيلية -> TLS -> تفعيل / تعطيل TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:303
msgid ""
"Active ou désactive TLS, et choisit son mode (direct ou derrière un proxy "
"qui termine déjà le TLS)."
msgstr "يفعّل TLS أو يعطّله، ويختار وضعه (مباشر أو خلف وكيل ينهي TLS مسبقًا)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:307
msgid "Comment TLS est géré par ce serveur."
msgstr "كيف يدير هذا الخادم TLS."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:309
msgid ""
"direct (ce serveur termine TLS lui-même, via ssl.SSLContext local) ou "
"behind_proxy (TLS déjà terminé en amont, ce serveur reste en HTTP simple)."
msgstr ""
"direct (هذا الخادم ينهي TLS بنفسه، عبر ssl.SSLContext محلي) أو behind_proxy "
"‏(TLS منتهٍ مسبقًا في المنبع، ويبقى هذا الخادم على HTTP العادي)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:312
msgid "Enregistre au clic sur Activer TLS."
msgstr "يحفظ عند النقر على تفعيل TLS."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:313
msgid ""
"Nécessite TOUJOURS un REDÉMARRAGE COMPLET, jamais un simple rechargement."
msgstr "يتطلب دائمًا إعادة تشغيل كاملة، وليس إعادة تحميل بسيطة أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:316
msgid "Chemin du certificat / de la clé privée"
msgstr "مسار الشهادة / المفتاح الخاص"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:317
msgid ""
"Fichiers utilisés si le mode est 'direct'. Optionnels : conservent la valeur"
" actuelle si vides."
msgstr ""
"الملفات المستخدمة إذا كان الوضع 'direct'. اختيارية: تحتفظ بالقيمة الحالية "
"إذا كانت فارغة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:318
msgid "Chemins relatifs au projet."
msgstr "مسارات نسبية للمشروع."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:320
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET."
msgstr "يتطلب دائمًا إعادة تشغيل كاملة."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:324
msgid ""
"Le contexte SSL n'est construit qu'une seule fois au démarrage - activer, "
"désactiver, ou changer le mode TLS exige SYSTÉMATIQUEMENT un redémarrage "
"complet, que ce soit pour l'activation ou la désactivation."
msgstr ""
"لا يُبنى سياق SSL إلا مرة واحدة عند الإقلاع - تفعيل TLS أو تعطيله أو تغيير "
"وضعه يتطلب دائمًا إعادة تشغيل كاملة، سواء للتفعيل أو للتعطيل."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:330
msgid ""
"À ne pas confondre avec le réglage 'reverse_proxy' (Configuration détaillée "
"-> Reverse Proxy) : ici, 'behind_proxy' signifie qu'OMEGA-SERV est DERRIÈRE "
"un proxy TLS externe, l'inverse d'agir soi-même comme proxy."
msgstr ""
"لا تخلط بينه وبين الإعداد 'reverse_proxy' (التهيئة التفصيلية -> الوكيل "
"العكسي): هنا يعني 'behind_proxy' أن OMEGA-SERV يقع خلف وكيل TLS خارجي، وهو "
"عكس العمل كوكيل بنفسه."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:10
msgid "Assistant premier lancement - 1/8 Bienvenue"
msgstr "معالج التشغيل الأول - 1/8 مرحبًا"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:11
msgid "Accueil -> Assistant premier lancement"
msgstr "الرئيسية -> معالج التشغيل الأول"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:13
msgid ""
"Point d'entrée de l'assistant guide qui compose une première configuration "
"complète, étape par étape."
msgstr "نقطة دخول المعالج الموجَّه الذي يركّب تهيئة أولى كاملة، خطوة بخطوة."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:18
#: src/omega_serv/interfaces/tui/screens/wizard_welcome_screen.py:42
msgid "Commencer"
msgstr "ابدأ"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:19
msgid "Démarre le parcours guide."
msgstr "يبدأ المسار الموجَّه."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:20
msgid "Aucune saisie à cette étape."
msgstr "لا إدخال في هذه الخطوة."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:21
msgid "Ouvre l'étape 2/8 (Registre des capacités)."
msgstr "يفتح الخطوة 2/8 (سجل القدرات)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:22
msgid "Aucun effet sur disque - rien n'est écrit avant l'étape 7 (Résumé)."
msgstr "لا أثر على القرص - لا يُكتب شيء قبل الخطوة 7 (الملخص)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:25
msgid "Aucune - purement informatif."
msgstr "لا شيء - للعلم فقط."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:30
msgid "Assistant premier lancement - 2/8 Capacités"
msgstr "معالج التشغيل الأول - 2/8 القدرات"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:31
msgid "Assistant premier lancement -> étape 2/8"
msgstr "معالج التشغيل الأول -> الخطوة 2/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:33
msgid ""
"Scan en lecture seule de l'environnement (port par défaut déjà occupé, "
"openssl présent...), avec le port par défaut - aucun profil ni port "
"personnalisé n'est encore choisi."
msgstr ""
"فحص للبيئة للقراءة فقط (المنفذ الافتراضي مشغول مسبقًا، وجود openssl...)، "
"بالمنفذ الافتراضي - لم يُختر بعد أي ملف تعريف ولا منفذ مخصّص."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:38
msgid "Suivant / Précédent"
msgstr "التالي / السابق"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:39
msgid "Navigation entre les étapes."
msgstr "التنقل بين الخطوات."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:40
msgid "Aucune saisie à cette étape (table en lecture seule)."
msgstr "لا إدخال في هذه الخطوة (جدول للقراءة فقط)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:41
msgid "Suivant ouvre l'étape 3/8 (Profil)."
msgstr "'التالي' يفتح الخطوة 3/8 (ملف التعريف)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:42
msgid "Aucun effet - purement informatif."
msgstr "لا أثر - للعلم فقط."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:50
msgid "Assistant premier lancement - 3/8 Profil"
msgstr "معالج التشغيل الأول - 3/8 ملف التعريف"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:51
msgid "Assistant premier lancement -> étape 3/8"
msgstr "معالج التشغيل الأول -> الخطوة 3/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:52
msgid "Choix d'un profil de base parmi les quatre profils preconfigures."
msgstr "اختيار ملف تعريف أساسي من بين ملفات التعريف الأربعة المهيأة مسبقًا."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:55
msgid "Table des profils"
msgstr "جدول ملفات التعريف"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:56
msgid "Liste des profils disponibles avec leur description au clic."
msgstr "قائمة ملفات التعريف المتاحة مع وصفها عند النقر."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:57
msgid "4 profils : minimal, standard, hardened, development."
msgstr "4 ملفات تعريف: minimal، ‏standard، ‏hardened، ‏development."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:58
msgid ""
"Sélectionner une ligne affiche sa description et active le bouton Suivant."
msgstr "اختيار سطر يعرض وصفه ويفعّل زر التالي."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:59
msgid ""
"Le profil choisi est appliqué à la CONFIGURATION CANDIDATE EN MÉMOIRE "
"uniquement."
msgstr "يُطبَّق ملف التعريف المختار على التهيئة المرشحة في الذاكرة فقط."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:62
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:86
msgid "Rien n'est encore écrit sur disque à cette étape."
msgstr "لا يُكتب شيء على القرص بعد في هذه الخطوة."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:67
msgid "Assistant premier lancement - 4/8 Configuration de base"
msgstr "معالج التشغيل الأول - 4/8 التهيئة الأساسية"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:68
msgid "Assistant premier lancement -> étape 4/8"
msgstr "معالج التشغيل الأول -> الخطوة 4/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:69
msgid ""
"Ajuste uniquement l'adresse d'écoute et le port - le reste vient du profil "
"choisi."
msgstr ""
"يضبط فقط عنوان الاستماع والمنفذ - والبقية تأتي من ملف التعريف المختار."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:72
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:56
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:130
#: src/omega_serv/interfaces/tui/screens/wizard_base_config_screen.py:36
msgid "Adresse d'écoute (server.bind)"
msgstr "عنوان الاستماع (server.bind)"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:73
msgid "Adresse IP sur laquelle le serveur écoutera."
msgstr "عنوان IP الذي سيستمع عليه الخادم."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:74
msgid "Une adresse IP valide. Pré-remplie avec la valeur du profil choisi."
msgstr "عنوان IP صالح. مملوء مسبقًا بقيمة ملف التعريف المختار."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:75
msgid "Validée (structurellement) au clic sur Suivant."
msgstr "يُتحقق منه (بنيويًا) عند النقر على التالي."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:76
msgid ""
"En mémoire uniquement à ce stade - voir l'étape 7 pour l'écriture réelle."
msgstr "في الذاكرة فقط في هذه المرحلة - انظر الخطوة 7 للكتابة الفعلية."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:79
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:58
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:131
#: src/omega_serv/interfaces/tui/screens/wizard_base_config_screen.py:38
msgid "Port (server.port)"
msgstr "المنفذ (server.port)"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:81
msgid "Un entier de port valide. Pré-rempli avec la valeur du profil choisi."
msgstr "عدد صحيح لمنفذ صالح. مملوء مسبقًا بقيمة ملف التعريف المختار."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:82
msgid "Validé au clic sur Suivant."
msgstr "يُتحقق منه عند النقر على التالي."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:83
msgid "En mémoire uniquement à ce stade."
msgstr "في الذاكرة فقط في هذه المرحلة."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:91
msgid "Assistant premier lancement - 5/8 TLS"
msgstr "معالج التشغيل الأول - 5/8 TLS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:92
msgid "Assistant premier lancement -> étape 5/8"
msgstr "معالج التشغيل الأول -> الخطوة 5/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:94
msgid ""
"Propose de générer un certificat auto-signé et d'activer TLS - jamais force,"
" et jamais proposé du tout si le profil choisi est 'development'."
msgstr ""
"يقترح إنشاء شهادة موقّعة ذاتيًا وتفعيل TLS - دون فرض أبدًا، ولا يُقترح "
"إطلاقًا إذا كان ملف التعريف المختار 'development'."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:100
msgid ""
"Nom commun (Common Name) du certificat - généralement le nom d'hôte du "
"serveur."
msgstr "الاسم الشائع (Common Name) للشهادة - عادةً اسم مضيف الخادم."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:101
msgid "Chaîne libre, ex: mon-serveur.local."
msgstr "نص حر، مثال: mon-serveur.local."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:102
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:109
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:116
msgid "Utilisé au clic sur 'Générer et activer TLS'."
msgstr "يُستخدم عند النقر على 'إنشاء TLS وتفعيله'."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:103
msgid ""
"Génère réellement le certificat sur disque immédiatement (pas différé à "
"l'étape 7)."
msgstr "ينشئ الشهادة فعليًا على القرص فورًا (لا يُؤجَّل إلى الخطوة 7)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:106
msgid "SAN DNS"
msgstr "SAN DNS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:107
msgid ""
"Noms DNS alternatifs couverts par le certificat (Subject Alternative Name)."
msgstr "أسماء DNS البديلة التي تغطيها الشهادة (Subject Alternative Name)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:108
msgid "Liste séparée par des virgules, optionnelle."
msgstr "قائمة مفصولة بفواصل، اختيارية."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:110
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:117
msgid "Génère réellement le certificat sur disque immédiatement."
msgstr "ينشئ الشهادة فعليًا على القرص فورًا."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:115
msgid ""
"Valeurs valides listées dans le sous-titre du champ. Valeur par défaut : "
"rsa2048."
msgstr ""
"القيم الصالحة مسرودة في العنوان الفرعي للحقل. القيمة الافتراضية: rsa2048."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:121
msgid ""
"Générer un certificat ici écrit réellement des fichiers sur disque tout de "
"suite (contrairement au reste de l'assistant) - active tls.enabled en "
"mémoire pour la suite du parcours, écrit dans la configuration finale à "
"l'étape 7."
msgstr ""
"إنشاء شهادة هنا يكتب ملفات فعليًا على القرص فورًا (بخلاف بقية المعالج) - "
"ويفعّل tls.enabled في الذاكرة لبقية المسار، ويُكتب في التهيئة النهائية في "
"الخطوة 7."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:126
msgid ""
"Cette étape est entièrement absente pour le profil 'development' - remplacée"
" par un simple message."
msgstr ""
"هذه الخطوة غائبة كليًا لملف التعريف 'development' - ويحل محلها رسالة بسيطة."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:132
msgid "Assistant premier lancement - 6/8 Vérification"
msgstr "معالج التشغيل الأول - 6/8 التحقق"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:133
msgid "Assistant premier lancement -> étape 6/8"
msgstr "معالج التشغيل الأول -> الخطوة 6/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:135
msgid ""
"Vérification automatique (structurelle puis environnement réel) avant de "
"pouvoir continuer - les mêmes deux couches que l'écran 'Vérifier la "
"configuration'."
msgstr ""
"تحقق تلقائي (بنيوي ثم البيئة الحقيقية) قبل التمكن من المتابعة - الطبقتان "
"نفسهما لشاشة 'التحقق من التهيئة'."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:140
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:36
msgid "Confirmer : bind public + certificat auto-signé"
msgstr "تأكيد: ربط عام + شهادة موقّعة ذاتيًا"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:142
msgid ""
"Porte de confirmation explicite requise pour continuer si le serveur écoute "
"publiquement avec un certificat auto-signé (jamais reconnu par les "
"navigateurs)."
msgstr ""
"بوابة تأكيد صريح مطلوبة للمتابعة إذا كان الخادم يستمع علنًا بشهادة موقّعة "
"ذاتيًا (لا تعترف بها المتصفحات أبدًا)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:145
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:155
msgid "À cocher uniquement si cette combinaison est réellement voulue."
msgstr "لا تحدّدها إلا إذا كان هذا التركيب مقصودًا فعلًا."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:146
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:156
msgid "Pris en compte au prochain clic sur Vérifier."
msgstr "يُعتمد عند النقر التالي على تحقق."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:147
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:157
msgid ""
"Sans cette confirmation, le bouton Suivant reste désactivé si la situation "
"s'applique."
msgstr "دون هذا التأكيد، يبقى زر التالي معطّلًا إذا انطبقت الحالة."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:150
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:37
msgid "Confirmer : authentification sans TLS"
msgstr "تأكيد: مصادقة دون TLS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:152
msgid ""
"Porte de confirmation explicite requise pour continuer si l'authentification"
" est active sans TLS (identifiants transmis en clair)."
msgstr ""
"بوابة تأكيد صريح مطلوبة للمتابعة إذا كانت المصادقة نشطة دون TLS (بيانات "
"الاعتماد تُرسل بنص واضح)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:160
msgid ""
"Rien n'est encore écrit sur disque à cette étape - seulement des "
"vérifications."
msgstr "لا يُكتب شيء على القرص بعد في هذه الخطوة - تحققات فقط."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:165
msgid "Assistant premier lancement - 7/8 Résumé"
msgstr "معالج التشغيل الأول - 7/8 الملخص"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:166
msgid "Assistant premier lancement -> étape 7/8"
msgstr "معالج التشغيل الأول -> الخطوة 7/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:168
msgid ""
"Affiche la différence complète entre les valeurs par défaut et la "
"configuration composée par l'assistant, puis écrit réellement le fichier de "
"configuration."
msgstr ""
"يعرض الفرق الكامل بين القيم الافتراضية والتهيئة التي ركّبها المعالج، ثم يكتب"
" ملف التهيئة فعليًا."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:173
#: src/omega_serv/interfaces/tui/screens/wizard_summary_screen.py:40
msgid "Écrire la configuration"
msgstr "كتابة التهيئة"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:174
msgid "Confirme et écrit la configuration composée."
msgstr "يؤكد التهيئة المركّبة ويكتبها."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:175
msgid "À vérifier attentivement le résumé affiché avant de cliquer."
msgstr "راجع الملخص المعروض بعناية قبل النقر."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:176
msgid ""
"Écrit config/omega-serve.json (une sauvegarde de l'ancien fichier est faite "
"automatiquement s'il existait)."
msgstr ""
"يكتب config/omega-serve.json (تُنشأ نسخة احتياطية من الملف القديم تلقائيًا "
"إن وُجد)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:177
msgid ""
"C'EST LA PREMIÈRE ÉCRITURE RÉELLE de tout le parcours - ouvre ensuite "
"l'étape 8/8."
