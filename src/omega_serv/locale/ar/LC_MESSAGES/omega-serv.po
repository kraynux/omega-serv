msgid ""
"Génère un certificat auto-signé aux chemins de la configuration (l'ancien "
"est sauvegardé)."
msgstr ""
"يولّد شهادة موقّعة ذاتيًا في مسارات الإعداد (تُحفظ القديمة احتياطيًا)."

#: src/omega_serv/interfaces/cli/main.py:2018
#: src/omega_serv/interfaces/cli/main.py:2029
#: src/omega_serv/interfaces/cli/main.py:2053
#: src/omega_serv/interfaces/cli/main.py:2087
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:244
msgid "JOURS"
msgstr "أيام"

#: src/omega_serv/interfaces/cli/main.py:2019
#: src/omega_serv/interfaces/cli/main.py:2054
msgid "Validité en jours (défaut : 365)."
msgstr "الصلاحية بالأيام (الافتراضي: 365)."

#: src/omega_serv/interfaces/cli/main.py:2021
#: src/omega_serv/interfaces/cli/main.py:2041
msgid "Type de clé (défaut : rsa2048)."
msgstr "نوع المفتاح (الافتراضي: rsa2048)."

#: src/omega_serv/interfaces/cli/main.py:2022
#: src/omega_serv/interfaces/cli/main.py:2033
#: src/omega_serv/interfaces/cli/main.py:2051
#: src/omega_serv/interfaces/cli/main.py:2072
#: src/omega_serv/interfaces/cli/main.py:2099
#: src/omega_serv/interfaces/cli/main.py:2108
msgid "MOT-DE-PASSE"
msgstr "كلمة-المرور"

