#: src/omega_serv/interfaces/tui/guide/content/accueil.py:75
msgid "Regroupe, dans l'ordre d'une attaque : WAF (protéger), Active Defense (détecter), RIPOSTE (riposter dans la durée) et, dessous, INTERVENTION MANUELLE (bannir ou débannir une adresse IP à la main)."
msgstr "يجمع حسب تسلسل الهجوم: WAF (الدفاع)، Active Defense (الكشف)، RIPOSTE (الرد عبر الزمن)، وفي الأسفل تدخل يدوي (حظر عنوان IP أو رفع حظره يدويًا)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:77
msgid "À utiliser pour la sécurité active du serveur."
msgstr "لاستخدام الأمان النشط للخادم."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:78
msgid "Ouvre le menu Active Sécurité."
msgstr "يفتح قائمة الأمان النشط."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:83
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...)."
msgstr "فحوص استشارية (الخدمة، تدوير السجلات، وضع WAF...)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:84
msgid "À lancer ponctuellement pour un avis global."
msgstr "يُشغَّل من حين لآخر للحصول على رأي شامل."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:85
msgid "Ouvre l'écran d'audit."
msgstr "يفتح شاشة التدقيق."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:89
#: src/omega_serv/interfaces/tui/guide/content/divers.py:171
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:93
#: src/omega_serv/interfaces/tui/screens/home.py:89
msgid "Sauvegarde de configuration"
msgstr "نسخ التهيئة احتياطيًا"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:90
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration."
msgstr "إنشاء نسخ احتياطية كاملة للتهيئة أو سردها أو استعادتها أو حذفها."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:91
msgid "À utiliser avant un changement risque, ou pour migrer une configuration."
msgstr "للاستخدام قبل تغيير محفوف بالمخاطر، أو لنقل تهيئة."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:92
msgid "Ouvre l'écran de sauvegarde."
msgstr "يفتح شاشة النسخ الاحتياطي."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:93
msgid "Restaurer ÉCRASE directement les fichiers vises - voir sa propre fiche."
msgstr "الاستعادة تكتب مباشرةً فوق الملفات المستهدفة - انظر بطاقتها الخاصة."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:96
#: src/omega_serv/interfaces/tui/guide/content/divers.py:491
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1251
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:94
#: src/omega_serv/interfaces/tui/screens/home.py:93
msgid "Rapport complet"
msgstr "التقرير الكامل"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:97
msgid "Tout ce qui est configuré et actif, d'un coup d'œil : instance, profil, service et uptime, adresse et mode, moteur, TLS, options, nombres de zones, sécurité, contrôles, sauvegardes, journaux."
msgstr "كل ما هو مُهيّأ ونشط، بنظرة واحدة: المثيل، ملف التعريف، الخدمة ومدة التشغيل، العنوان والوضع، المحرك، TLS، الخيارات، أعداد المناطق، الأمان، الفحوص، النسخ الاحتياطية، السجلات."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:100
msgid "Le sommaire s'affiche ; le détail coché part dans l'export (HTML, TXT ou JSON)."
msgstr "يُعرض الملخص؛ وتذهب التفاصيل المحدَّدة إلى التصدير (HTML أو TXT أو JSON)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:101
msgid "Ouvre l'écran du rapport ; la génération tourne en arrière-plan."
msgstr "يفتح شاشة التقرير؛ يجري الإنشاء في الخلفية."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:102
msgid "Lecture seule : aucun réglage n'est modifié, aucun secret n'est exporté."
msgstr "قراءة فقط: لا يُعدَّل أي إعداد، ولا يُصدَّر أي سر."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:105
msgid "Cet écran ne modifie jamais la configuration lui-même - uniquement de la navigation."
msgstr "هذه الشاشة لا تعدّل التهيئة بنفسها أبدًا - تنقّل فقط."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:108
msgid "Pour quitter : Échap, q ou Ctrl+Q depuis cet écran, avec confirmation (il n'y a plus de bouton Quitter dans le menu). Ailleurs, Échap revient simplement en arrière."
msgstr "للخروج: Esc أو q أو Ctrl+Q من هذه الشاشة، مع تأكيد (لم يعد في القائمة زر خروج). في الأماكن الأخرى، يعود Esc ببساطة إلى الخلف."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:112
msgid "Dans tous les écrans à liste ou à long formulaire, Retour et les boutons principaux restent dans une barre fixe en bas, toujours visible : inutile de dérouler la liste pour revenir ou enregistrer."
msgstr "في كل شاشة تحتوي على قائمة أو نموذج طويل، يبقى زر الرجوع والأزرار الرئيسية في شريط ثابت في الأسفل، ظاهر دائمًا: لا داعي لتمرير القائمة للرجوع أو الحفظ."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:12
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
msgid "Configuration détaillée (menu)"
msgstr "التهيئة التفصيلية (قائمة)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:13
msgid "Accueil -> Configuration détaillée"
msgstr "الرئيسية -> التهيئة التفصيلية"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:15
msgid "Sous-menu regroupant tous les écrans de configuration du serveur et des options superposables, plus deux raccourcis (Voir options actives, Vérifier la configuration)."
msgstr "قائمة فرعية تجمع كل شاشات تهيئة الخادم والخيارات القابلة للتراكب، مع اختصارين (عرض الخيارات النشطة، التحقق من التهيئة)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:18
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:23
#: src/omega_serv/interfaces/tui/guide/content/tls.py:15
msgid "Aucune - purement navigation."
msgstr "لا شيء - تنقّل فقط."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "التهيئة الأساسية"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "الرئيسية -> التهيئة التفصيلية -> التهيئة الأساسية"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid "Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier explicite, moteur HTTP (Python ou natif C++)."
msgstr "الإعدادات الأساسية للخادم: عنوان الاستماع، والمنفذ، واسم الخادم المُعلن، وملفات الفهرس التي يُبحث عنها في مجلد بلا اسم ملف صريح، ومحرك HTTP (Python أو أصلي C++)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse d'écoute (bind)"
msgstr "عنوان الاستماع (bind)"

