msgstr "يرسل طلبًا وهميًا إلى WAF ويعرض قراره (القواعد، النقاط، الحالة)."

#: src/omega_serv/interfaces/cli/main.py:1877
msgid "Chemin de la requête."
msgstr "مسار الطلب."

#: src/omega_serv/interfaces/cli/main.py:1878
