msgstr "خدمة النظام (systemd أو OpenRC أو runit)."

#: src/omega_serv/interfaces/cli/main.py:2132
msgid "Nom du service (défaut : omega-serv)."
msgstr "اسم الخدمة (الافتراضي: omega-serv)."

#: src/omega_serv/interfaces/cli/main.py:2133
msgid "Fichier d'unité (défaut : /etc/systemd/system/<nom>.service)."
msgstr "ملف الوحدة (الافتراضي: /etc/systemd/system/<الاسم>.service)."

#: src/omega_serv/interfaces/cli/main.py:2136
msgid "Affiche l'état du service."
msgstr "يعرض حالة الخدمة."

#: src/omega_serv/interfaces/cli/main.py:2137
msgid "Démarre le service."
msgstr "يشغّل الخدمة."

#: src/omega_serv/interfaces/cli/main.py:2138
msgid "Arrête le service."
msgstr "يوقف الخدمة."

#: src/omega_serv/interfaces/cli/main.py:2139
msgid "Redémarre le service (nécessaire après une mise à jour)."
msgstr "يعيد تشغيل الخدمة (ضروري بعد التحديث)."

#: src/omega_serv/interfaces/cli/main.py:2141
msgid ""
"Recharge sans couper : règles WAF et zones ; bind, port, TLS et moteur "
"demandent un redémarrage."
msgstr ""
"يعيد التحميل دون انقطاع: قواعد WAF والمناطق؛ أما bind والمنفذ وTLS والمحرك "
"فتتطلب إعادة تشغيل."

#: src/omega_serv/interfaces/cli/main.py:2142
msgid "Active le démarrage automatique au boot."
msgstr "يفعّل التشغيل التلقائي عند الإقلاع."

#: src/omega_serv/interfaces/cli/main.py:2143
msgid "Désactive le démarrage automatique au boot."
msgstr "يعطّل التشغيل التلقائي عند الإقلاع."

#: src/omega_serv/interfaces/cli/main.py:2150
msgid ""
"Crée l'unité systemd du service (systemd seulement ; demande les droits "
"administrateur)."
msgstr "ينشئ وحدة systemd للخدمة (systemd فقط؛ يتطلب صلاحيات المسؤول)."

#: src/omega_serv/interfaces/cli/main.py:2153
msgid "Description de l'unité (défaut : OMEGA-SERV web server)."
msgstr "وصف الوحدة (الافتراضي: OMEGA-SERV web server)."

#: src/omega_serv/interfaces/cli/main.py:2155
msgid "Python à utiliser (défaut : celui du .venv de l'installation)."
msgstr "Python المستخدم (الافتراضي: الموجود في .venv الخاص بالتثبيت)."

#: src/omega_serv/interfaces/cli/main.py:2157
msgid "Compte système qui fait tourner le service (défaut : omega-serv)."
msgstr "حساب النظام الذي يشغّل الخدمة (الافتراضي: omega-serv)."

#: src/omega_serv/interfaces/cli/main.py:2159
msgid "Groupe du service (défaut : omega-serv)."
msgstr "مجموعة الخدمة (الافتراضي: omega-serv)."

#: src/omega_serv/interfaces/cli/main.py:2161
msgid "Délai laissé à l'arrêt avant de forcer (défaut : 15)."
msgstr "المهلة الممنوحة للإيقاف قبل فرضه (الافتراضي: 15)."

#: src/omega_serv/interfaces/cli/main.py:2165
msgid "Supprime l'unité du service."
msgstr "يحذف وحدة الخدمة."

#: src/omega_serv/interfaces/cli/main.py:2170
msgid "Audit de sécurité."
msgstr "تدقيق أمني."

#: src/omega_serv/interfaces/cli/main.py:2172
msgid ""
"Audite l'installation : configuration, droits, TLS, service. Code 1 si "
"critique, 2 si élevé, 3 si la configuration est illisible."
msgstr ""
"يدقق التثبيت: الإعداد، الصلاحيات، TLS، الخدمة. الرمز 1 إن كان حرجًا، و2 إن "
"كان مرتفعًا، و3 إن تعذرت قراءة الإعداد."

#: src/omega_serv/interfaces/cli/main.py:2175
msgid "Format du rapport (défaut : text)."
msgstr "صيغة التقرير (الافتراضي: text)."

#: src/omega_serv/interfaces/cli/main.py:2177
msgid "N'affiche que ce niveau et les plus graves (défaut : info)."
msgstr "لا يعرض إلا هذا المستوى وما هو أخطر (الافتراضي: info)."

#: src/omega_serv/interfaces/cli/main.py:2187
msgid ""
"Liens avec les autres outils omega (omega-connect) : jeton d'installation et"
" fiche de l'instance."
msgstr ""
"الروابط مع أدوات omega الأخرى (omega-connect): رمز التثبيت وبطاقة النسخة."

#: src/omega_serv/interfaces/cli/main.py:2190
msgid ""
"Crée ou met à jour le jeton d'installation (var/omega-jeton.json) et "
"l'affiche en JSON."
msgstr "ينشئ رمز التثبيت (var/omega-jeton.json) أو يحدّثه ويعرضه بصيغة JSON."

#: src/omega_serv/interfaces/cli/main.py:2191
msgid ""
"Lancée par install.sh et à chaque ouverture de l'interface. Jamais en root."
msgstr "يشغّله install.sh وعند كل فتح للواجهة. لا يعمل أبدًا بصلاحيات root."

#: src/omega_serv/interfaces/cli/main.py:2194
msgid ""
"Affiche la fiche de cette instance (fonctions actives, service, journaux "
"partagés), pour omega-connect."
msgstr ""
"يعرض بطاقة هذه النسخة (الوظائف المفعّلة، الخدمة، السجلات المشتركة) لأجل "
"omega-connect."

#: src/omega_serv/interfaces/cli/main.py:2196
msgid "Format de sortie : json seulement (non traduit, versionné)."
msgstr "صيغة الإخراج: json فقط (غير مترجمة، ذات إصدار)."

#: src/omega_serv/interfaces/cli/main.py:2200
msgid ""
"Affiche la version installée ; --check la compare à la dernière version "
"publiée sur le site."
msgstr ""
"يعرض الإصدار المثبّت؛ ويقارنه الخيار --check بآخر إصدار منشور على الموقع."

#: src/omega_serv/interfaces/cli/main.py:2202
msgid ""
"Lit la liste des versions publiées (download/sha.txt du site) ; rien n'est "
"envoyé."
msgstr ""
"يقرأ قائمة الإصدارات المنشورة (download/sha.txt على الموقع)؛ ولا يُرسَل شيء."

#: src/omega_serv/interfaces/cli/main.py:2206
msgid ""
"Affiche l'arbre de toutes les commandes, ou d'une branche (ex. : omega-serv "
"help riposte)."
msgstr "يعرض شجرة كل الأوامر أو فرع واحد (مثال: omega-serv help riposte)."

#: src/omega_serv/interfaces/cli/main.py:2207
msgid "Branche à afficher (facultatif)."
msgstr "الفرع المراد عرضه (اختياري)."

#: src/omega_serv/interfaces/cli/main.py:2247
#, python-brace-format
msgid ""
"Erreur : lancée en root, cette commande créerait dans {root} des fichiers "
"que le service ne pourrait plus modifier. Relancez-la sans sudo, sous le "
"compte propriétaire du dossier ({owner})."
msgstr ""
"خطأ: عند التشغيل بصلاحيات root، سينشئ هذا الأمر في {root} ملفات لن تتمكن "
"الخدمة من تعديلها. أعد تشغيله دون sudo، بحساب مالك المجلد ({owner})."

