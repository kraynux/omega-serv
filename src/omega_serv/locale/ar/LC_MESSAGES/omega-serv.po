msgid ""
"Installe un certificat existant aux chemins de la configuration (Let's "
"Encrypt, CA d'entreprise...)."
msgstr "يثبّت شهادة موجودة في مسارات الإعداد (Let's Encrypt، CA مؤسسية...)."

#: src/omega_serv/interfaces/cli/main.py:2062
msgid "Clé privée."
msgstr "المفتاح الخاص."

#: src/omega_serv/interfaces/cli/main.py:2063
msgid "Certificat."
msgstr "الشهادة."

#: src/omega_serv/interfaces/cli/main.py:2065
msgid "Chaîne des certificats intermédiaires (facultatif)."
msgstr "سلسلة الشهادات الوسيطة (اختياري)."

#: src/omega_serv/interfaces/cli/main.py:2068
msgid "Révoque un certificat émis par une CA locale."
msgstr "يلغي شهادة أصدرتها CA محلية."

#: src/omega_serv/interfaces/cli/main.py:2069
msgid "Certificat à révoquer."
msgstr "الشهادة المراد إلغاؤها."

#: src/omega_serv/interfaces/cli/main.py:2076
msgid "Certificat à lire (défaut : celui de la configuration)."
msgstr "الشهادة المراد قراءتها (الافتراضي: شهادة الإعداد)."

#: src/omega_serv/interfaces/cli/main.py:2078
msgid ""
"Vérifie un certificat : dates, correspondance avec la clé, droits de la clé."
" Code 1 s'il a expiré."
msgstr ""
"يفحص شهادة: التواريخ، المطابقة مع المفتاح، صلاحيات المفتاح. الرمز 1 إن انتهت"
" صلاحيتها."

#: src/omega_serv/interfaces/cli/main.py:2081
msgid "Affiche le détail d'un certificat (même rapport que verify)."
msgstr "يعرض تفاصيل شهادة (التقرير نفسه الذي يعطيه verify)."

#: src/omega_serv/interfaces/cli/main.py:2085
msgid "Même rapport que verify, avec une alerte si l'expiration approche."
msgstr "التقرير نفسه الذي يعطيه verify، مع تنبيه إن اقترب الانتهاء."

#: src/omega_serv/interfaces/cli/main.py:2088
msgid "Seuil d'alerte en jours (défaut : 30)."
msgstr "عتبة التنبيه بالأيام (الافتراضي: 30)."

#: src/omega_serv/interfaces/cli/main.py:2092
msgid "Authentification HTTP Basic : utilisateurs et zones protégées."
msgstr "مصادقة HTTP Basic: المستخدمون والمناطق المحمية."

#: src/omega_serv/interfaces/cli/main.py:2093
msgid "Nom d'utilisateur."
msgstr "اسم المستخدم."

#: src/omega_serv/interfaces/cli/main.py:2094
msgid ""
"Mot de passe (sinon demandé au clavier, conseillé : il resterait dans "
"l'historique)."
msgstr ""
"كلمة المرور (وإلا تُطلب من لوحة المفاتيح، موصى به: وإلا بقيت في السجل)."

#: src/omega_serv/interfaces/cli/main.py:2095
msgid "Début de chemin protégé, par exemple /admin."
msgstr "بداية مسار محمي، مثلًا /admin."

#: src/omega_serv/interfaces/cli/main.py:2097
msgid "Crée un utilisateur."
msgstr "ينشئ مستخدمًا."

#: src/omega_serv/interfaces/cli/main.py:2102
msgid "Supprime un utilisateur."
msgstr "يحذف مستخدمًا."

#: src/omega_serv/interfaces/cli/main.py:2106
msgid "Change le mot de passe d'un utilisateur."
msgstr "يغيّر كلمة مرور مستخدم."

#: src/omega_serv/interfaces/cli/main.py:2111
msgid "Protège un chemin par mot de passe."
msgstr "يحمي مسارًا بكلمة مرور."

#: src/omega_serv/interfaces/cli/main.py:2114
msgid "Nom affiché par le navigateur dans la demande de connexion."
msgstr "الاسم الذي يعرضه المتصفح عند طلب تسجيل الدخول."

#: src/omega_serv/interfaces/cli/main.py:2116
msgid "Utilisateurs autorisés dans la zone."
msgstr "المستخدمون المسموح لهم في المنطقة."

#: src/omega_serv/interfaces/cli/main.py:2117
msgid "METHODE"
msgstr "طريقة"

#: src/omega_serv/interfaces/cli/main.py:2118
msgid ""
"Seules ces méthodes HTTP sont acceptées dans la zone (défaut : toutes celles"
" que le serveur autorise)."
msgstr ""
"لا تُقبل في المنطقة إلا طرق HTTP هذه (الافتراضي: كل ما يسمح به الخادم)."

#: src/omega_serv/interfaces/cli/main.py:2121
msgid "Retire la protection d'un chemin."
msgstr "يزيل حماية مسار."

#: src/omega_serv/interfaces/cli/main.py:2125
msgid "Liste les utilisateurs et les zones protégées."
msgstr "يسرد المستخدمين والمناطق المحمية."

#: src/omega_serv/interfaces/cli/main.py:2127
