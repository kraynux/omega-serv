msgstr "طلب التوقيع المراد توقيعه."

#: src/omega_serv/interfaces/cli/main.py:2049
#: src/omega_serv/interfaces/cli/main.py:2070
msgid "Clé privée de la CA."
msgstr "المفتاح الخاص لـ CA."

#: src/omega_serv/interfaces/cli/main.py:2050
#: src/omega_serv/interfaces/cli/main.py:2071
msgid "Certificat de la CA."
msgstr "شهادة CA."

#: src/omega_serv/interfaces/cli/main.py:2055
msgid "Certificat signé à écrire."
msgstr "الشهادة الموقّعة المراد كتابتها."

#: src/omega_serv/interfaces/cli/main.py:2057
msgid "Écrit aussi la chaîne complète (certificat puis CA)."
msgstr "يكتب أيضًا السلسلة الكاملة (الشهادة ثم CA)."

