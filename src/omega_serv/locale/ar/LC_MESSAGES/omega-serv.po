#: src/omega_serv/interfaces/cli/main.py:1991
msgid "SOURCE"
msgstr "مصدر"

#: src/omega_serv/interfaces/cli/main.py:1958
msgid "Identifiant de la source, tel qu'affiché par threats list."
msgstr "معرّف المصدر كما يعرضه threats list."

#: src/omega_serv/interfaces/cli/main.py:1961
msgid "Incidents Active Defense."
msgstr "حوادث Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1962
msgid "Identifiant de l'incident (voir incidents list)."
msgstr "معرّف الحادثة (انظر incidents list)."

#: src/omega_serv/interfaces/cli/main.py:1963
msgid "Liste les incidents."
msgstr "يسرد الحوادث."

#: src/omega_serv/interfaces/cli/main.py:1965
msgid "Seulement les incidents ouverts (open) ou fermés (closed)."
msgstr "الحوادث المفتوحة (open) أو المغلقة (closed) فقط."

#: src/omega_serv/interfaces/cli/main.py:1966
msgid "HEURES"
msgstr "ساعات"

#: src/omega_serv/interfaces/cli/main.py:1967
msgid "Seulement les incidents des N dernières heures."
msgstr "حوادث آخر N ساعة فقط."

