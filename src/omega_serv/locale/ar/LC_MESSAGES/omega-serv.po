msgid ""
"Durée du ban. Sans durée, le ban est permanent et demande --confirm-"
"permanent."
msgstr "مدة الحظر. بدون مدة يكون الحظر دائمًا ويتطلب --confirm-permanent."

#: src/omega_serv/interfaces/cli/main.py:1898
msgid "Confirme un ban permanent."
msgstr "يؤكد حظرًا دائمًا."

#: src/omega_serv/interfaces/cli/main.py:1899
#: src/omega_serv/interfaces/cli/main.py:1905
msgid "OUTIL"
msgstr "أداة"

#: src/omega_serv/interfaces/cli/main.py:1900
msgid ""
"Outil qui pose le ban (ex. omega-fire) : lui seul pourra le lever avec "
"--origin."
msgstr ""
"الأداة التي تضع الحظر (مثل omega-fire): هي وحدها من يستطيع رفعه باستخدام "
"--origin."

#: src/omega_serv/interfaces/cli/main.py:1902
msgid "Lève un ban."
msgstr "يرفع حظرًا."

#: src/omega_serv/interfaces/cli/main.py:1904
msgid "Adresse ou réseau, tel qu'affiché par blocklist list."
msgstr "عنوان أو شبكة كما يعرضها blocklist list."

#: src/omega_serv/interfaces/cli/main.py:1906
msgid "Ne lève le ban que s'il a été posé avec cette origine."
msgstr "لا يرفع الحظر إلا إذا وُضع بهذا المصدر."

#: src/omega_serv/interfaces/cli/main.py:1910
msgid ""
"Active Defense : état, simulation, purge (voir aussi threats, incidents, "
"deception)."
msgstr ""
"Active Defense: الحالة، المحاكاة، التنظيف (انظر أيضًا threats وincidents "
"وdeception)."

#: src/omega_serv/interfaces/cli/main.py:1913
msgid ""
"Affiche l'état : mode, mode guerre, leurres, nombre de sources suivies."
msgstr "يعرض الحالة: الوضع، وضع الحرب، الطُّعوم، عدد المصادر المتتبَّعة."

#: src/omega_serv/interfaces/cli/main.py:1916
msgid ""
"Montre la décision qu'Active Defense prendrait pour une source, sans rien "
"écrire."
msgstr ""
"يبيّن القرار الذي سيتخذه Active Defense تجاه مصدر ما، دون كتابة أي شيء."

#: src/omega_serv/interfaces/cli/main.py:1917
msgid "Adresse de la source simulée."
msgstr "عنوان المصدر المحاكى."

#: src/omega_serv/interfaces/cli/main.py:1919
msgid "Chemin observé (défaut : /)."
msgstr "المسار المرصود (الافتراضي: /)."

#: src/omega_serv/interfaces/cli/main.py:1921
msgid "User-Agent de la source."
msgstr "User-Agent الخاص بالمصدر."

#: src/omega_serv/interfaces/cli/main.py:1922
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:230
msgid "CLASSE"
msgstr "فئة"

#: src/omega_serv/interfaces/cli/main.py:1923
msgid "Classe d'attaque (défaut : scan ; liste affichée si inconnue)."
msgstr "فئة الهجوم (الافتراضي: scan؛ تُعرض القائمة إن كانت غير معروفة)."

#: src/omega_serv/interfaces/cli/main.py:1924
msgid "POINTS"
msgstr "نقاط"

#: src/omega_serv/interfaces/cli/main.py:1925
msgid "Points ajoutés au score de menace (défaut : 10)."
msgstr "النقاط المضافة إلى درجة التهديد (الافتراضي: 10)."

#: src/omega_serv/interfaces/cli/main.py:1928
msgid ""
"Purge les menaces expirées, ferme les incidents redevenus calmes, supprime "
"les incidents fermés depuis plus de 90 jours."
msgstr ""
"ينظّف التهديدات المنتهية، ويغلق الحوادث التي هدأت، ويحذف الحوادث المغلقة منذ"
" أكثر من 90 يومًا."

#: src/omega_serv/interfaces/cli/main.py:1931
msgid "Logs d'omega-serv."
msgstr "سجلات omega-serv."

#: src/omega_serv/interfaces/cli/main.py:1933
msgid ""
"Fait tourner les logs dont l'automatisation (Rotate / archivage) est à "
"échéance."
msgstr "يدوّر السجلات التي حان موعد أتمتتها (التدوير / الأرشفة)."

#: src/omega_serv/interfaces/cli/main.py:1934
msgid ""
"Lancée chaque nuit par le timer systemd ou la ligne crontab installés par "
"l'interface."
msgstr ""
"تُشغَّل كل ليلة بواسطة مؤقّت systemd أو سطر crontab المثبَّت من الواجهة."

#: src/omega_serv/interfaces/cli/main.py:1937
msgid "Moteur HTTP (Python ou natif)."
msgstr "محرك HTTP (Python أو أصلي)."

#: src/omega_serv/interfaces/cli/main.py:1939
msgid ""
"Affiche le moteur demandé, celui qui tourne et la raison d'un éventuel "
"repli."
msgstr "يعرض المحرك المطلوب والمحرك العامل وسبب أي تراجع إن وُجد."

