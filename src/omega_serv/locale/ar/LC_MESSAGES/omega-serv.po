msgid "Accueil -> Profils"
msgstr "الرئيسية -> ملفات التعريف"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid "Liste les 4 profils fournis (minimal/standard/hardened/development) et vos profils personnalisés (colonne Type), avec leur libellé."
msgstr "يسرد ملفات التعريف الأربعة المرفقة (minimal/standard/hardened/development) وملفات التعريف المخصصة الخاصة بك (عمود النوع)، مع تسميتها."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
#: src/omega_serv/interfaces/tui/guide/content/divers.py:123
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:42
msgid "Appliquer"
msgstr "تطبيق"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "يفتح شاشة تأكيد تطبيق ملف التعريف المختار."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Sélectionner un profil active ce bouton."
msgstr "اختيار ملف تعريف يفعّل هذا الزر."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Ouvre ApplyProfileScreen."
msgstr "يفتح ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:54
msgid "Un profil personnalisé ne fixe que la sécurité et l'état des options : adresse, port, TLS, chemins, journaux et réglages des options (zones, listes) restent ceux de l'instance."
msgstr "ملف التعريف المخصص لا يحدد إلا الأمان وحالة الخيارات: العنوان والمنفذ و TLS والمسارات والسجلات وإعدادات الخيارات (المناطق، القوائم) تبقى كما هي في المثيل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:58
#: src/omega_serv/interfaces/tui/guide/content/divers.py:78
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:44
msgid "Créer un profil personnalisé"
msgstr "إنشاء ملف تعريف مخصص"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:59
msgid "Ouvre l'assistant. Si un profil personnalisé est sélectionné, l'assistant repart de ses choix (un profil personnalisé ne se modifie pas : on en recrée un)."
msgstr "يفتح المعالج. إذا كان ملف تعريف مخصص محددًا، ينطلق المعالج من اختياراته (ملف التعريف المخصص لا يُعدَّل: يُنشأ واحد جديد)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
msgid "Aucune limite de nombre : un seul profil est appliqué à la fois."
msgstr "لا حد للعدد: يُطبَّق ملف تعريف واحد فقط في كل مرة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Enregistre config/profiles/custom/<nom>.json ; la configuration n'est pas touchée."
msgstr "يحفظ config/profiles/custom/<الاسم>.json؛ لا تُمَس التهيئة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid "Compris dans toute sauvegarde de configuration et repris lors d'une mise à jour."
msgstr "مُدرج في كل نسخة احتياطية للتهيئة ويُحتفظ به عند التحديث."

