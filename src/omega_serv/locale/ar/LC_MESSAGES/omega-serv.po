msgstr "يعرض فقط ما سيتغير، دون كتابة أي شيء."

#: src/omega_serv/interfaces/cli/main.py:1851
msgid "Applique malgré des problèmes bloquants."
msgstr "يطبّق رغم المشكلات المانعة."

#: src/omega_serv/interfaces/cli/main.py:1855
msgid "Modules optionnels (waf, fastcgi, active_defense, riposte...)."
msgstr "وحدات اختيارية (waf, fastcgi, active_defense, riposte...)."

#: src/omega_serv/interfaces/cli/main.py:1856
msgid "Liste les options et leur état."
msgstr "يسرد الخيارات وحالتها."

#: src/omega_serv/interfaces/cli/main.py:1857
msgid "Nom de l'option (voir option list)."
msgstr "اسم الخيار (انظر option list)."

#: src/omega_serv/interfaces/cli/main.py:1858
msgid "Active une option."
msgstr "يفعّل خيارًا."

#: src/omega_serv/interfaces/cli/main.py:1859
msgid ""
"Première activation du WAF : tous les packs de secure/waf/rules/ sont "
"ajoutés, en mode log-only."
msgstr ""
"أول تفعيل لـ WAF: تُضاف كل الحزم الموجودة في secure/waf/rules/ بوضع log-"
"only."

#: src/omega_serv/interfaces/cli/main.py:1862
msgid "Désactive une option."
msgstr "يعطّل خيارًا."

#: src/omega_serv/interfaces/cli/main.py:1867
msgid ""
"Montre comment le serveur traiterait une requête (chemin, règles, statut, "
"en-têtes), sans l'envoyer."
msgstr ""
"يبيّن كيف سيعالج الخادم طلبًا (المسار، القواعد، الحالة، الترويسات) دون "
"إرساله."

#: src/omega_serv/interfaces/cli/main.py:1869
#: src/omega_serv/interfaces/cli/main.py:1877
#: src/omega_serv/interfaces/cli/main.py:1918
#: src/omega_serv/interfaces/cli/main.py:2112
#: src/omega_serv/interfaces/cli/main.py:2122
msgid "CHEMIN"
msgstr "مسار"

#: src/omega_serv/interfaces/cli/main.py:1870
msgid "Chemin demandé, par exemple /docs/index.html."
msgstr "المسار المطلوب، مثلًا /docs/index.html."

#: src/omega_serv/interfaces/cli/main.py:1873
msgid "Pare-feu applicatif (WAF)."
msgstr "جدار حماية التطبيقات (WAF)."

#: src/omega_serv/interfaces/cli/main.py:1875
msgid ""
"Soumet une requête fictive au WAF et affiche sa décision (règles, score, "
