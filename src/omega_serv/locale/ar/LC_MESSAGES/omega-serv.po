msgstr "البلد، رمز من حرفين (FR, BE...)."

#: src/omega_serv/interfaces/cli/main.py:2009
msgid "Noms de domaine supplémentaires couverts par le certificat."
msgstr "أسماء نطاقات إضافية تغطيها الشهادة."

#: src/omega_serv/interfaces/cli/main.py:2011
msgid "Adresses IP couvertes par le certificat."
msgstr "عناوين IP التي تغطيها الشهادة."

#: src/omega_serv/interfaces/cli/main.py:2013
msgid "Nom commun : le nom de domaine principal."
msgstr "الاسم الشائع: اسم النطاق الرئيسي."

