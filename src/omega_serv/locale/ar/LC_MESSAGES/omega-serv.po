msgid "ID"
msgstr "المعرّف"

#: src/omega_serv/interfaces/cli/main.py:1834
msgid "Identifiant de la sauvegarde (voir config list-backups)."
msgstr "معرّف النسخة الاحتياطية (انظر config list-backups)."

#: src/omega_serv/interfaces/cli/main.py:1836
msgid ""
"Arrête le service, restaure, puis le redémarre (nécessaire si le service "
"tourne)."
msgstr "يوقف الخدمة ويستعيد ثم يعيد تشغيلها (ضروري إن كانت الخدمة تعمل)."

#: src/omega_serv/interfaces/cli/main.py:1838
msgid "Liste les sauvegardes."
msgstr "يسرد النسخ الاحتياطية."

#: src/omega_serv/interfaces/cli/main.py:1840
