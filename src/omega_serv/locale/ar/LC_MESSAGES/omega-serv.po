#: src/omega_serv/interfaces/cli/main.py:1879
#: src/omega_serv/interfaces/cli/main.py:1895
#: src/omega_serv/interfaces/cli/main.py:1920
#: src/omega_serv/interfaces/cli/main.py:2000
#: src/omega_serv/interfaces/cli/main.py:2002
