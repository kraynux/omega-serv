msgid ""
"text (défaut, traduit) ou json (pour les autres outils, jamais traduit)."
msgstr "text (الافتراضي، مترجم) أو json (للأدوات الأخرى، لا يُترجم أبدًا)."

#: src/omega_serv/interfaces/cli/main.py:1892
msgid "Bannit une adresse ou un réseau."
msgstr "يحظر عنوانًا أو شبكة."

