msgid "Liste les profils disponibles."
msgstr "يسرد ملفات التعريف المتاحة."

#: src/omega_serv/interfaces/cli/main.py:1842
msgid "Nom du profil (voir profile list)."
msgstr "اسم ملف التعريف (انظر profile list)."

#: src/omega_serv/interfaces/cli/main.py:1843
msgid "Affiche un profil et les valeurs qu'il fixe."
msgstr "يعرض ملف تعريف والقيم التي يضبطها."

#: src/omega_serv/interfaces/cli/main.py:1847
msgid ""
"Applique un profil à la configuration (modifications et conflits affichés "
