#: src/omega_serv/interfaces/tui/screens/home.py:89
msgid "Active Sécurité"
msgstr "الأمان النشط"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:75
msgid ""
"Regroupe, dans l'ordre d'une attaque : WAF (protéger), Active Defense "
"(détecter), RIPOSTE (riposter dans la durée) et, dessous, INTERVENTION "
"MANUELLE (bannir ou débannir une adresse IP à la main)."
msgstr ""
"يجمع حسب تسلسل الهجوم: WAF (الدفاع)، Active Defense (الكشف)، RIPOSTE (الرد "
"عبر الزمن)، وفي الأسفل تدخل يدوي (حظر عنوان IP أو رفع حظره يدويًا)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:77
msgid "À utiliser pour la sécurité active du serveur."
msgstr "لاستخدام الأمان النشط للخادم."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:78
msgid "Ouvre le menu Active Sécurité."
msgstr "يفتح قائمة الأمان النشط."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:82
#: src/omega_serv/interfaces/tui/guide/content/divers.py:85
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:83
#: src/omega_serv/interfaces/tui/screens/home.py:86
msgid "Audit de sécurité"
msgstr "تدقيق الأمان"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:83
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...)."
msgstr "فحوص استشارية (الخدمة، تدوير السجلات، وضع WAF...)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:84
msgid "À lancer ponctuellement pour un avis global."
msgstr "يُشغَّل من حين لآخر للحصول على رأي شامل."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:85
msgid "Ouvre l'écran d'audit."
msgstr "يفتح شاشة التدقيق."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:89
#: src/omega_serv/interfaces/tui/guide/content/divers.py:102
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:84
#: src/omega_serv/interfaces/tui/screens/home.py:88
msgid "Sauvegarde de configuration"
msgstr "نسخ التهيئة احتياطيًا"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:90
msgid ""
"Créer, lister, restaurer ou supprimer des sauvegardes complètes de la "
"configuration."
msgstr "إنشاء نسخ احتياطية كاملة للتهيئة أو سردها أو استعادتها أو حذفها."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:91
msgid ""
"À utiliser avant un changement risque, ou pour migrer une configuration."
msgstr "للاستخدام قبل تغيير محفوف بالمخاطر، أو لنقل تهيئة."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:92
msgid "Ouvre l'écran de sauvegarde."
msgstr "يفتح شاشة النسخ الاحتياطي."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:93
msgid ""
"Restaurer ÉCRASE directement les fichiers vises - voir sa propre fiche."
msgstr "الاستعادة تكتب مباشرةً فوق الملفات المستهدفة - انظر بطاقتها الخاصة."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:96
msgid ""
"Cet écran ne modifie jamais la configuration lui-même - uniquement de la "
"navigation."
msgstr "هذه الشاشة لا تعدّل التهيئة بنفسها أبدًا - تنقّل فقط."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:99
msgid ""
"Appuyer sur Échap depuis cet écran demande une confirmation de sortie de "
"l'application (contrairement aux autres écrans, où Échap revient simplement "
"en arrière)."
msgstr ""
"الضغط على Esc في هذه الشاشة يطلب تأكيد الخروج من التطبيق (بخلاف الشاشات "
"الأخرى، حيث يعود Esc ببساطة إلى الخلف)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:12
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
msgid "Configuration détaillée (menu)"
msgstr "التهيئة التفصيلية (قائمة)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:13
msgid "Accueil -> Configuration détaillée"
msgstr "الرئيسية -> التهيئة التفصيلية"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:15
msgid ""
"Sous-menu regroupant tous les écrans de configuration du serveur et des "
"options superposables, plus deux raccourcis (Voir options actives, Vérifier "
"la configuration)."
msgstr ""
"قائمة فرعية تجمع كل شاشات تهيئة الخادم والخيارات القابلة للتراكب، مع "
"اختصارين (عرض الخيارات النشطة، التحقق من التهيئة)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:18
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:19
#: src/omega_serv/interfaces/tui/guide/content/tls.py:15
msgid "Aucune - purement navigation."
msgstr "لا شيء - تنقّل فقط."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "التهيئة الأساسية"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "الرئيسية -> التهيئة التفصيلية -> التهيئة الأساسية"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid ""
"Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur "
"annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier "
"explicite, moteur HTTP (Python ou natif C++)."
msgstr ""
"الإعدادات الأساسية للخادم: عنوان الاستماع، والمنفذ، واسم الخادم المُعلن، "
"وملفات الفهرس التي يُبحث عنها في مجلد بلا اسم ملف صريح، ومحرك HTTP (Python "
"أو أصلي C++)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse d'écoute (bind)"
msgstr "عنوان الاستماع (bind)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:34
msgid "Adresse IP sur laquelle le serveur accepte les connexions."
msgstr "عنوان IP الذي يقبل الخادم الاتصالات عليه."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:36
msgid ""
"Une adresse IP valide - '127.0.0.1' (local uniquement) ou '0.0.0.0' (toutes "
"les interfaces réseau). Valeur par défaut : 127.0.0.1."
msgstr ""
"عنوان IP صالح - '127.0.0.1' (محلي فقط) أو '0.0.0.0' (كل واجهات الشبكة). "
"القيمة الافتراضية: 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:39
msgid ""
"Enregistre dans server.bind après validation structurelle de la "
"configuration."
msgstr "يحفظ في server.bind بعد التحقق البنيوي من التهيئة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:41
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - le socket d'écoute n'est jamais retouché "
"par un simple rechargement. Un bouton 'Redémarrer maintenant' est proposé "
"après l'enregistrement si un service est détecté."
msgstr ""
"يتطلب إعادة تشغيل كاملة - إعادة التحميل البسيطة لا تمس مقبس الاستماع أبدًا. "
"يُقترح زر 'إعادة التشغيل الآن' بعد الحفظ إذا اكتُشفت خدمة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:47
msgid "Port (port)"
msgstr "المنفذ (port)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:48
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:80
msgid "Port TCP d'écoute."
msgstr "منفذ TCP للاستماع."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:50
msgid ""
"Un entier de port valide (1-65535 ; 0 signifie 'port libre choisi par le "
"système', surtout utile pour des tests). Valeur par défaut : 8080."
msgstr ""
"عدد صحيح لمنفذ صالح (1-65535؛ 0 يعني 'منفذ متاح يختاره النظام'، مفيد خاصةً "
"للاختبارات). القيمة الافتراضية: 8080."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:53
msgid "Enregistre dans server.port après validation."
msgstr "يحفظ في server.port بعد التحقق."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:54
msgid "Nécessite un REDÉMARRAGE COMPLET, même raison que l'adresse d'écoute."
msgstr "يتطلب إعادة تشغيل كاملة، للسبب نفسه الخاص بعنوان الاستماع."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:57
msgid "Nom de serveur (server_name)"
msgstr "اسم الخادم (server_name)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:58
msgid "Nom de serveur utilisé en interne (transmis notamment à FastCGI)."
msgstr "اسم الخادم المستخدم داخليًا (يُمرَّر خصوصًا إلى FastCGI)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:59
msgid "Chaîne libre, optionnelle. Vide par défaut."
msgstr "نص حر، اختياري. فارغ افتراضيًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:60
msgid "Enregistre dans server.server_name."
msgstr "يحفظ في server.server_name."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:62
msgid ""
"Se recharge à chaud (pas de redémarrage complet nécessaire) - mais reste "
"sans effet tant qu'un rechargement du service en cours n'a pas eu lieu "
"(automatique si un service actif existe, sinon à faire manuellement depuis "
"l'écran SERVICE)."
msgstr ""
"يُعاد تحميله أثناء التشغيل (لا حاجة لإعادة تشغيل كاملة) - لكنه يبقى بلا أثر "
"ما لم تُعَد تحميل الخدمة الجارية (تلقائيًا إن وُجدت خدمة نشطة، وإلا يدويًا "
"من شاشة SERVICE)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:68
msgid "Fichiers d'index (index_files)"
msgstr "ملفات الفهرس (index_files)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:70
msgid ""
"Noms de fichiers cherches, dans l'ordre, quand une URL pointe vers un "
"répertoire sans fichier explicite."
msgstr ""
"أسماء الملفات التي يُبحث عنها بالترتيب حين يشير URL إلى دليل دون ملف صريح."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:73
msgid "Liste séparée par des virgules. Valeur par défaut : index.html."
msgstr "قائمة مفصولة بفواصل. القيمة الافتراضية: index.html."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:74
msgid "Enregistre dans server.index_files."
msgstr "يحفظ في server.index_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:75
msgid ""
"Même réaction que le nom de serveur - rechargement nécessaire, jamais un "
"redémarrage complet."
msgstr ""
"رد الفعل نفسه الخاص باسم الخادم - تلزم إعادة التحميل، وليس إعادة تشغيل كاملة"
" أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:78
msgid "Moteur HTTP (engine)"
msgstr "محرك HTTP (engine)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:80
msgid ""
"Programme qui traite les requêtes HTTP. Python (par défaut) : l'interpréteur"
" Python traite tout. Natif C++ (omega-http-core) : un programme compilé, qui"
" utilise tous les cœurs, traite lui-même le contenu statique, les "
"redirections, le cache et TLS ; il cherche lui-même les règles du WAF et "
"sert seul une requête sur laquelle aucune ne correspond ; il confie au "
"processus Python les autres contrôles de sécurité (requête suspecte ou "
"douteuse, Active Defense, authentification), le listing, les pages internes "
"et les routes applicatives (reverse proxy, FastCGI, envoi de fichiers). Dans"
" les deux cas : mêmes réponses, mêmes journaux, même sécurité. Ce que le "
"choix change, mesuré : FAQ, « Moteur Python ou natif : qu'est-ce que ça "
"change concrètement ? »."
msgstr ""
"البرنامج الذي يعالج طلبات HTTP. ‏Python (افتراضي): مفسّر Python يعالج كل "
"شيء. ‏المحرك الأصلي C++ (omega-http-core): برنامج مُترجَم يستخدم كل الأنوية،"
" يعالج بنفسه المحتوى الثابت وإعادة التوجيه والتخزين المؤقت وTLS، ويفحص بنفسه"
" قواعد WAF ويخدم وحده الطلب الذي لا تنطبق عليه أي قاعدة منها، ويُسند إلى "
"عملية Python بقية فحوص الأمان (طلب مريب أو مشكوك فيه، Active Defense، "
"المصادقة) وعرض قوائم المجلدات والصفحات الداخلية ومسارات التطبيقات (الوكيل "
"العكسي وFastCGI وإرسال الملفات). في الحالتين: الردود نفسها والسجلات نفسها "
"والأمان نفسه. ما الذي يغيّره الاختيار، بالقياس: الأسئلة الشائعة، «محرك "
"Python أم المحرك الأصلي: ما الذي يتغير عمليًا؟»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:90
msgid ""
"Python ou Natif C++. Le choix natif est GRISÉ tant qu'une cause l'empêche "
"(binaire absent, TLS en mode direct avec reverse proxy, FastCGI ou envoi de "
"fichiers) : la liste des causes, et comment lever chacune, s'affiche sous le"
" choix. Lever d'abord la cause, puis revenir ici."
msgstr ""
"Python أو المحرك الأصلي C++. يبقى خيار المحرك الأصلي رمادياً ما دام هناك سبب"
" يمنعه (الملف التنفيذي غير موجود، أو TLS مباشر مع وكيل عكسي أو FastCGI أو "
"رفع ملفات): تُعرض أسفل الخيار قائمة الأسباب وطريقة إزالة كل منها. أزل السبب "
"أولاً ثم عد إلى هنا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:94
msgid "Enregistre dans server.engine."
msgstr "يحفظ في server.engine."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:96
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - un rechargement qui changerait de moteur "
"est refusé. Le moteur réellement utilisé est affiché dans État & Ressources "
"(section MOTEUR HTTP, avec le tableau des connecteurs)."
msgstr ""
"يتطلب إعادة تشغيل كاملة - تُرفض إعادة التحميل التي تغيّر المحرك. يُعرض "
"المحرك المستخدم فعلياً في الحالة والموارد (قسم محرك HTTP، مع جدول الموصلات)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:103
msgid ""
"bind/port et le moteur HTTP exigent toujours un redémarrage complet. "
"server_name/index_files se rechargent à chaud mais nécessitent quand même un"
" rechargement du service déjà lancé pour être pris en compte."
msgstr ""
"يتطلب bind/port ومحرك HTTP دائماً إعادة تشغيل كاملة. يُعاد تحميل "
"server_name/index_files أثناء التشغيل، لكن يلزم مع ذلك إعادة تحميل الخدمة "
"العاملة لتصبح سارية."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:109
msgid ""
"Changer bind/port pendant qu'un service systemd est déjà actif ne prend "
"jamais effet tant qu'un redémarrage complet n'a pas eu lieu - toutes les "
"connexions en cours sont alors coupées, contrairement à un simple "
"rechargement."
msgstr ""
"تغيير bind/port أثناء نشاط خدمة systemd لا يسري أبدًا قبل إعادة تشغيل كاملة "
"- عندها تُقطع كل الاتصالات الجارية، بخلاف إعادة التحميل البسيطة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:118
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:47
msgid "Résistance et limites"
msgstr "المتانة والحدود"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:119
msgid "Accueil -> Configuration détaillée -> Résistance et limites"
msgstr "الرئيسية -> التهيئة التفصيلية -> المتانة والحدود"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:121
msgid ""
"Dix réglages numériques anti-abus : bornes de taille/nombre/delai appliquées"
" à chaque connexion et requête."
msgstr ""
"عشرة إعدادات رقمية لمكافحة الإساءة: حدود الحجم/العدد/المهلة المطبَّقة على كل"
" اتصال وطلب."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:126
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:36
msgid "Connexions simultanées max (max_connections)"
msgstr "الحد الأقصى للاتصالات المتزامنة (max_connections)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:127
msgid "Nombre maximal de connexions ouvertes en même temps."
msgstr "الحد الأقصى لعدد الاتصالات المفتوحة في الوقت نفسه."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:128
msgid "Entier positif. Valeur par défaut : 256."
msgstr "عدد صحيح موجب. القيمة الافتراضية: 256."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:129
msgid "Enregistre dans server.max_connections."
msgstr "يحفظ في server.max_connections."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:130
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:262
msgid ""
"Se recharge à chaud (rechargement du service nécessaire, automatique si "
"actif)."
msgstr ""
"يُعاد تحميله أثناء التشغيل (تلزم إعادة تحميل الخدمة، تلقائيًا إن كانت نشطة)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:133
msgid "Taille max de requête (max_request_size)"
msgstr "الحد الأقصى لحجم الطلب (max_request_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:134
msgid "Taille maximale acceptée pour le corps d'une requête, en octets."
msgstr "الحد الأقصى المقبول لحجم جسم الطلب، بالبايت."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:135
msgid "Entier positif, en octets. Valeur par défaut : 10 485 760 (10 Mio)."
msgstr "عدد صحيح موجب، بالبايت. القيمة الافتراضية: 10 485 760 (10 MiB)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:136
msgid "Enregistre dans server.max_request_size."
msgstr "يحفظ في server.max_request_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:137
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:147
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:154
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:161
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:168
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:175
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:188
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:208
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:272
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:279
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:301
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:326
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:333
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:340
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:347
msgid "Se recharge à chaud."
msgstr "يُعاد تحميله أثناء التشغيل."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:140
msgid "Taille max des en-têtes (max_header_size)"
msgstr "الحد الأقصى لحجم الترويسات (max_header_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:142
msgid ""
"Taille cumulée maximale des en-têtes HTTP d'une requête, en octets - "
"protection contre les en-têtes surdimensionnés (HTTP smuggling, saturation "
"mémoire)."
msgstr ""
"الحد الأقصى للحجم الإجمالي لترويسات HTTP في طلب، بالبايت - حماية من "
"الترويسات المفرطة الحجم (HTTP smuggling، إغراق الذاكرة)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:145
msgid "Entier positif, en octets. Valeur par défaut : 16 384."
msgstr "عدد صحيح موجب، بالبايت. القيمة الافتراضية: 16 384."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:146
msgid "Enregistre dans server.max_header_size."
msgstr "يحفظ في server.max_header_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:150
msgid "Taille max de la ligne de requête (max_request_line_size)"
msgstr "الحد الأقصى لحجم سطر الطلب (max_request_line_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:151
msgid ""
"Taille maximale de la première ligne HTTP (méthode + chemin + version), en "
"octets."
msgstr "الحد الأقصى لحجم أول سطر HTTP (الطريقة + المسار + الإصدار)، بالبايت."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:152
msgid "Entier positif, en octets. Valeur par défaut : 8 192."
msgstr "عدد صحيح موجب، بالبايت. القيمة الافتراضية: 8 192."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:153
msgid "Enregistre dans server.max_request_line_size."
msgstr "يحفظ في server.max_request_line_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:157
msgid "Délai de lecture (read_timeout_seconds)"
msgstr "مهلة القراءة (read_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:158
msgid ""
"Délai maximal, en secondes, pour recevoir une requête complète avant "
"coupure."
msgstr "المهلة القصوى بالثواني لاستلام طلب كامل قبل القطع."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:159
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:206
msgid "Entier positif, en secondes. Valeur par défaut : 10."
msgstr "عدد صحيح موجب، بالثواني. القيمة الافتراضية: 10."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:160
msgid "Enregistre dans server.read_timeout_seconds."
msgstr "يحفظ في server.read_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:164
msgid "Délai d'écriture (write_timeout_seconds)"
msgstr "مهلة الكتابة (write_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:165
msgid "Délai maximal, en secondes, pour envoyer la réponse avant coupure."
msgstr "المهلة القصوى بالثواني لإرسال الاستجابة قبل القطع."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:166
msgid "Entier positif, en secondes. Valeur par défaut : 15."
msgstr "عدد صحيح موجب، بالثواني. القيمة الافتراضية: 15."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:167
msgid "Enregistre dans server.write_timeout_seconds."
msgstr "يحفظ في server.write_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:171
msgid "Délai keep-alive (keepalive_timeout_seconds)"
msgstr "مهلة keep-alive ‏(keepalive_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:172
msgid ""
"Délai d'inactivité, en secondes, avant fermeture d'une connexion gardée "
"ouverte."
msgstr "مهلة الخمول بالثواني قبل إغلاق اتصال مُبقى مفتوحًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:173
msgid "Entier positif, en secondes. Valeur par défaut : 5."
msgstr "عدد صحيح موجب، بالثواني. القيمة الافتراضية: 5."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:174
msgid "Enregistre dans server.keepalive_timeout_seconds."
msgstr "يحفظ في server.keepalive_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:178
msgid "Requêtes max en keep-alive (max_keepalive_requests)"
msgstr "الحد الأقصى للطلبات في keep-alive ‏(max_keepalive_requests)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:180
msgid ""
"Nombre maximal de requêtes traitées sur une même connexion gardée ouverte. "
"Une fois atteint, la connexion est simplement fermée et le navigateur en "
"ouvre une nouvelle : aucune erreur, aucun bannissement. Sans rapport avec la"
" limite de débit du WAF (Active Sécurité -> Exclusions et débit), qui compte"
" les requêtes par IP toutes connexions confondues."
msgstr ""
"الحد الأقصى لعدد الطلبات المعالجة على اتصال واحد يبقى مفتوحًا. عند بلوغه "
"يُغلق الاتصال فقط ويفتح المتصفح اتصالًا جديدًا: لا خطأ ولا حظر. لا علاقة له "
"بحد المعدل في WAF (الأمان النشط -> الاستثناءات وحد المعدل) الذي يعدّ الطلبات"
" لكل IP عبر جميع الاتصالات."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:186
msgid "Entier positif. Valeur par défaut : 30."
msgstr "عدد صحيح موجب. القيمة الافتراضية: 30."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:187
msgid "Enregistre dans server.max_keepalive_requests."
msgstr "يحفظ في server.max_keepalive_requests."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:191
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:44
msgid "File d'attente d'écoute (listen_backlog)"
msgstr "طابور الاستماع (listen_backlog)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:193
msgid ""
"Taille de la file d'attente de connexions en attente d'acceptation par le "
"système d'exploitation (paramètre backlog du socket d'écoute)."
msgstr ""
"حجم طابور الاتصالات المنتظرة لقبولها من نظام التشغيل (معامل backlog لمقبس "
"الاستماع)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:196
msgid "Entier positif. Valeur par défaut : 128."
msgstr "عدد صحيح موجب. القيمة الافتراضية: 128."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:197
msgid "Enregistre dans server.listen_backlog."
msgstr "يحفظ في server.listen_backlog."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:199
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - fixé au moment de la création du socket "
"d'écoute, comme bind/port, jamais retouché par un simple rechargement."
msgstr ""
"يتطلب إعادة تشغيل كاملة - يُحدَّد عند إنشاء مقبس الاستماع، مثل bind/port، "
"ولا تمسه إعادة التحميل البسيطة أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:204
msgid "Délai de grâce à l'arrêt (shutdown_grace_period_seconds)"
msgstr "مهلة السماح عند الإيقاف (shutdown_grace_period_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:205
msgid ""
"Délai, en secondes, laissé aux connexions actives pour se terminer lors d'un"
" arrêt."
msgstr "المهلة بالثواني الممنوحة للاتصالات النشطة لتنتهي عند الإيقاف."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:207
msgid "Enregistre dans server.shutdown_grace_period_seconds."
msgstr "يحفظ في server.shutdown_grace_period_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:211
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:62
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:178
msgid "Nombre de processus (workers)"
msgstr "عدد العمليات (workers)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:213
msgid ""
"Avec le moteur Python : nombre de processus serveur qui se partagent le port"
" ; un processus Python n'utilise qu'un cœur, plusieurs servent davantage de "
"requêtes en parallèle. Avec le moteur natif (Configuration de base) : nombre"
" de processus Python qui font les contrôles de sécurité, le natif utilisant "
"déjà tous les cœurs. Les compteurs de sécurité (rate limit, récidive) sont "
"partagés entre processus et restent exacts ; un script magnet garde ses "
"propres compteurs dans chaque processus."
msgstr ""
"مع محرك Python: عدد عمليات الخادم التي تتشارك المنفذ؛ عملية Python الواحدة "
"تستخدم نواة واحدة فقط، وعدة عمليات تخدم طلبات أكثر بالتوازي. مع المحرك "
"الأصلي (التهيئة الأساسية): عدد عمليات Python التي تجري فحوص الأمان، إذ إن "
"المحرك الأصلي يستخدم كل الأنوية أصلًا. عدّادات الأمان (تحديد المعدل، "
"العَوْد) مشتركة بين العمليات وتبقى دقيقة؛ ويحتفظ سكربت magnet بعدّاداته "
"الخاصة في كل عملية."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:221
msgid ""
"Le maximum dépend du moteur et du processeur détecté, et s'affiche sous le "
"champ avec ce qu'augmenter apporte sur cette machine : moteur Python, un "
"processus par cœur physique ; moteur natif, 1, ou 2 à partir de 4 cœurs "
"physiques (un 2e n'aide que si un contrôle de sécurité est actif). Une "
"valeur au-delà du maximum est refusée. Ce que le choix change, mesuré : FAQ,"
" « Combien de processus choisir ? »."
msgstr ""
"يعتمد الحد الأقصى على المحرك والمعالج المكتشَف، ويظهر تحت الحقل مع ما تجلبه "
"الزيادة على هذا الجهاز: محرك Python، عملية لكل نواة فعلية؛ المحرك الأصلي، 1،"
" أو 2 ابتداءً من 4 أنوية فعلية (العملية الثانية لا تفيد إلا إذا كان فحص أمان"
" مفعّلًا). تُرفض أي قيمة تتجاوز الحد الأقصى. ما الذي يغيّره الاختيار، "
"بالقياس: الأسئلة الشائعة، «كم عملية أختار؟»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:227
msgid "Enregistre dans server.workers."
msgstr "يحفظ في server.workers."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:229
msgid ""
"Redémarrage complet nécessaire. Si la configuration est recopiée sur une "
"machine plus petite, le serveur se limite au maximum de cette machine et "
"l'écrit dans le journal et dans État & Ressources."
msgstr ""
"يلزم إعادة تشغيل كاملة. إذا نُسخت التهيئة إلى جهاز أصغر، يقتصر الخادم على "
"الحد الأقصى لذلك الجهاز ويسجّل ذلك في السجل وفي الحالة والموارد."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:236
msgid ""
"Neuf champs sur onze se rechargent à chaud (rechargement du service "
"nécessaire, automatique si actif). listen_backlog et le nombre de processus "
"exigent un redémarrage complet."
msgstr ""
"تسعة حقول من أحد عشر يُعاد تحميلها فورًا (يلزم إعادة تحميل الخدمة، تلقائيًا "
"إن كانت مفعّلة). يتطلب listen_backlog وعدد العمليات إعادة تشغيل كاملة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:241
msgid ""
"Un listen_backlog trop bas sous forte charge fait échouer des connexions "
"entrantes avant même qu'elles atteignent OMEGA-SERV (comportement du système"
" d'exploitation) - ne descendre sous 128 qu'en connaissance de cause."
msgstr ""
"قيمة listen_backlog منخفضة جدًا تحت حمل ثقيل تُفشل اتصالات واردة حتى قبل أن "
"تصل إلى OMEGA-SERV (سلوك نظام التشغيل) - لا تنزل تحت 128 إلا عن دراية."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:250
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:39
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:48
msgid "Sécurité générique"
msgstr "الأمان العام"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:251
msgid "Accueil -> Configuration détaillée -> Sécurité générique"
msgstr "الرئيسية -> التهيئة التفصيلية -> الأمان العام"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:253
msgid ""
"Règles de sécurité génériques appliquées à toutes les requêtes : méthodes "
"autorisées, fichiers cachés, en-têtes de sécurité, CSP, HSTS."
msgstr ""
"قواعد أمان عامة تُطبَّق على كل الطلبات: الطرق المسموحة، الملفات المخفية، "
"ترويسات الأمان، CSP، HSTS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:258
msgid "Méthodes autorisées"
msgstr "الطرق المسموحة"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:259
msgid ""
"Liste blanche des méthodes HTTP acceptées - tout le reste est refusé par "
"défaut."
msgstr "قائمة بيضاء لطرق HTTP المقبولة - كل ما عداها مرفوض افتراضيًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:260
msgid ""
"Liste séparée par des virgules, ex: GET, HEAD. Valeur par défaut : GET, "
"HEAD."
msgstr "قائمة مفصولة بفواصل، مثال: GET, HEAD. القيمة الافتراضية: GET, HEAD."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:261
msgid "Enregistre dans security.allowed_methods."
msgstr "يحفظ في security.allowed_methods."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:265
#: src/omega_serv/interfaces/tui/screens/security_screen.py:58
msgid "Refuser les fichiers cachés (oui/non)"
msgstr "رفض الملفات المخفية (نعم/لا)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:267
msgid ""
"Masque tout fichier ou dossier dont un segment de chemin commence par un "
"point (dotfile) - à la fois en accès direct et dans le directory listing."
msgstr ""
"يُخفي كل ملف أو مجلد يبدأ جزء من مساره بنقطة (dotfile) - في الوصول المباشر "
"وفي سرد الدليل على حد سواء."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:270
msgid "oui ou non (accepte aussi true/1/o/y). Valeur par défaut : oui."
msgstr "نعم أو لا (يُقبل أيضًا true/1/o/y). القيمة الافتراضية: نعم."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:271
msgid "Enregistre dans security.deny_hidden_files."
msgstr "يحفظ في security.deny_hidden_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:275
msgid "Mode CSP"
msgstr "وضع CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:276
msgid ""
"Mode d'application de la Content-Security-Policy envoyée dans les réponses."
msgstr "وضع تطبيق Content-Security-Policy المرسلة في الاستجابات."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:277
msgid ""
"enforce (bloque) ou report-only (signale sans bloquer). Valeur par défaut : "
"enforce."
msgstr ""
"enforce (يحظر) أو report-only (يبلّغ دون حظر). القيمة الافتراضية: enforce."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:278
msgid "Enregistre dans security.csp_mode."
msgstr "يحفظ في security.csp_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:282
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:284
msgid ""
"Isolation cross-origin - 'require-corp'/'credentialless' peuvent bloquer des"
" ressources cross-origin (polices, images, iframes tiers) que ce serveur "
"générique ne connaît pas à l'avance, contrairement à COOP/CORP (toujours "
"actifs, sans ce risque)."
msgstr ""
"عزل عبر المصادر - قد تحظر 'require-corp'/'credentialless' موارد عبر المصادر "
"(خطوط، صور، iframes من جهات خارجية) لا يعرفها هذا الخادم العام مسبقًا، بخلاف"
" COOP/CORP (نشطتان دائمًا، دون هذا الخطر)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:290
msgid ""
"unsafe-none (permissif, par défaut partout y compris hardened), require-corp"
" ou credentialless - à activer uniquement en connaissance du contenu "
"réellement servi."
msgstr ""
"unsafe-none (متساهل، الافتراضي في كل مكان حتى hardened)، أو require-corp أو "
"credentialless - لا تفعّلها إلا عن دراية بالمحتوى المقدَّم فعلًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:293
msgid "Enregistre dans security.coep_mode."
msgstr "يحفظ في security.coep_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:294
msgid ""
"Se recharge à chaud - toujours émis explicitement, même en unsafe-none "
"(jamais un en-tête absent)."
msgstr ""
"يُعاد تحميله أثناء التشغيل - يُرسَل دائمًا صراحةً، حتى مع unsafe-none (لا "
"تغيب الترويسة أبدًا)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:297
#: src/omega_serv/interfaces/tui/screens/security_screen.py:64
msgid "En-têtes de sécurité actifs (oui/non)"
msgstr "ترويسات الأمان نشطة (نعم/لا)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:298
msgid ""
"Active l'envoi des en-têtes de sécurité standard (CSP, X-Content-Type-"
"Options...)."
msgstr "يفعّل إرسال ترويسات الأمان القياسية (CSP، X-Content-Type-Options...)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:299
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:338
msgid "oui ou non. Valeur par défaut : oui."
msgstr "نعم أو لا. القيمة الافتراضية: نعم."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:300
msgid "Enregistre dans security.security_headers_enabled."
msgstr "يحفظ في security.security_headers_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:304
msgid "Zones CSP (Ajouter une zone / Retirer)"
msgstr "مناطق CSP (إضافة منطقة / إزالة)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:306
msgid ""
"Exceptions EXPLICITES à la CSP globale, par préfixe de chemin - ex. 'unsafe-"
"inline' uniquement sous /un-dossier/ qui en a réellement besoin, sans jamais"
" relâcher la CSP du reste du site."
msgstr ""
"استثناءات صريحة من CSP العامة حسب بادئة المسار - مثلًا 'unsafe-inline' فقط "
"تحت /مجلد-ما/ يحتاجه فعلًا، دون التساهل أبدًا في CSP بقية الموقع."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:311
msgid ""
"Préfixe (ex: /public-widgets/) + politique CSP COMPLÈTE pour ce préfixe "
"(remplace entièrement le défaut pour ces chemins, jamais une fusion de "
"directives)."
msgstr ""
"البادئة (مثال: /public-widgets/) + سياسة CSP كاملة لهذه البادئة (تستبدل "
"الافتراضي كليًا لهذه المسارات، وليست دمجًا للتوجيهات أبدًا)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:314
msgid ""
"Enregistre immédiatement dans security.csp_zones, sans passer par "
"Enregistrer."
msgstr "يحفظ فورًا في security.csp_zones، دون المرور بزر الحفظ."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:316
msgid ""
"Rechargement automatique immédiat si un service actif existe. Une exception "
"comme 'unsafe-inline' reste TOUJOURS visible dans 'omega-serv audit "
"security' (CSP-001/CSP-002), même délibérée - jamais silencieuse."
msgstr ""
"إعادة تحميل تلقائية فورية إن وُجدت خدمة نشطة. يبقى استثناء مثل 'unsafe-"
"inline' ظاهرًا دائمًا في 'omega-serv audit security' (CSP-001/CSP-002)، حتى "
"لو كان متعمَّدًا - لا يكون صامتًا أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:322
#: src/omega_serv/interfaces/tui/screens/security_screen.py:66
msgid "HSTS actif (oui/non)"
msgstr "HSTS نشط (نعم/لا)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:323
msgid ""
"Active l'en-tête Strict-Transport-Security (force HTTPS pour les visites "
"futures)."
msgstr ""
"يفعّل ترويسة Strict-Transport-Security (تفرض HTTPS للزيارات المستقبلية)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:324
msgid ""
"oui ou non. Valeur par défaut : non. N'a de sens que si TLS est réellement "
"actif."
msgstr ""
"نعم أو لا. القيمة الافتراضية: لا. لا معنى له إلا إذا كان TLS نشطًا فعلًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:325
msgid "Enregistre dans security.hsts_enabled."
msgstr "يحفظ في security.hsts_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:329
msgid "HSTS max-age"
msgstr "HSTS max-age"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:330
msgid ""
"Durée, en secondes, pendant laquelle un navigateur retient l'obligation "
"HTTPS."
msgstr "المدة بالثواني التي يتذكر خلالها المتصفح إلزامية HTTPS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:331
msgid "Entier positif, en secondes. Valeur par défaut : 31 536 000 (un an)."
msgstr "عدد صحيح موجب، بالثواني. القيمة الافتراضية: 31 536 000 (سنة)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:332
msgid "Enregistre dans security.hsts_max_age."
msgstr "يحفظ في security.hsts_max_age."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:336
#: src/omega_serv/interfaces/tui/screens/security_screen.py:70
msgid "HSTS includeSubDomains (oui/non)"
msgstr "HSTS includeSubDomains (نعم/لا)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:337
msgid "Étend l'obligation HTTPS à tous les sous-domaines."
msgstr "يوسّع إلزامية HTTPS لتشمل كل النطاقات الفرعية."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:339
msgid "Enregistre dans security.hsts_include_subdomains."
msgstr "يحفظ في security.hsts_include_subdomains."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:343
#: src/omega_serv/interfaces/tui/screens/security_screen.py:72
msgid "HSTS preload (oui/non)"
msgstr "HSTS preload (نعم/لا)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:344
msgid ""
"Signale l'éligibilité à la liste de prechargement HSTS des navigateurs."
msgstr "يشير إلى الأهلية لقائمة HSTS المحمَّلة مسبقًا في المتصفحات."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:345
#: src/omega_serv/interfaces/tui/guide/content/routage.py:31
msgid "oui ou non. Valeur par défaut : non."
msgstr "نعم أو لا. القيمة الافتراضية: لا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:346
msgid "Enregistre dans security.hsts_preload."
msgstr "يحفظ في security.hsts_preload."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:350
msgid ""
"Tous les champs de cet écran se rechargent à chaud - aucun n'exige de "
"redémarrage complet."
msgstr ""
"كل حقول هذه الشاشة يُعاد تحميلها أثناء التشغيل - لا يتطلب أي منها إعادة "
"تشغيل كاملة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:353
msgid ""
"Activer HSTS sans que TLS soit réellement actif n'a aucun effet utile - le "
"navigateur ignore cet en-tête reçu en HTTP simple."
msgstr ""
"تفعيل HSTS دون أن يكون TLS نشطًا فعلًا لا فائدة منه - يتجاهل المتصفح هذه "
"الترويسة إذا وصلت عبر HTTP العادي."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:361
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:40
msgid "Sécurité générique - Assistant zone CSP"
msgstr "الأمان العام - معالج منطقة CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:362
msgid "Sécurité générique -> Ajouter une zone"
msgstr "الأمان العام -> إضافة منطقة"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:364
msgid ""
"Construit la politique CSP d'une zone directive par directive, chacune pré-"
"remplie avec sa valeur ACTUELLE (la politique globale) - une zone remplace "
"ENTIÈREMENT la politique par défaut pour son préfixe, jamais un simple "
"ajout, d'où le pré-remplissage pour éviter de perdre des directives sans le "
"vouloir."
msgstr ""
"يبني سياسة CSP لمنطقة توجيهًا تلو الآخر، كلٌّ منها مملوء مسبقًا بقيمته "
"الحالية (السياسة العامة) - تستبدل المنطقة السياسة الافتراضية لبادئتها كليًا،"
" وليست إضافة بسيطة أبدًا، ولذلك يُملأ مسبقًا لتجنّب فقدان توجيهات دون قصد."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:371
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:83
#: src/omega_serv/interfaces/tui/screens/security_screen.py:98
msgid "Préfixe"
msgstr "البادئة"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:372
msgid "Chemin URL auquel s'applique cette politique de remplacement."
msgstr "مسار URL الذي تنطبق عليه سياسة الاستبدال هذه."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:373
msgid "Doit commencer par '/', ex: /public-widgets/."
msgstr "يجب أن يبدأ بـ '/'، مثال: /public-widgets/."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:374
msgid "Utilisé au clic sur Valider."
msgstr "يُستخدم عند النقر على تأكيد."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:375
msgid "Aucun effet avant Valider."
msgstr "لا أثر قبل التأكيد."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:378
msgid "Directives (une par ligne, ex. style-src, script-src...)"
msgstr "التوجيهات (واحد لكل سطر، مثال style-src، script-src...)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:379
msgid ""
"Chaque champ contrôle une famille de ressources - l'indice sous chaque champ"
" explique précisément laquelle."
msgstr "كل حقل يتحكم في عائلة من الموارد - يوضح التلميح تحت كل حقل أيها بدقة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:380
msgid ""
"Pré-rempli avec la valeur actuelle - modifier uniquement ce qui doit "
"changer, vider pour omettre la directive dans la zone."
msgstr ""
"مملوء مسبقًا بالقيمة الحالية - عدّل فقط ما يجب تغييره، وأفرغه لحذف التوجيه "
"من المنطقة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:381
msgid "Reassemblees en une seule politique au clic sur Valider."
msgstr "يُعاد تجميعها في سياسة واحدة عند النقر على تأكيد."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:382
msgid ""
"Une valeur contenant unsafe-inline/unsafe-eval/'*' déclenche une "
"confirmation explicite supplémentaire avant d'enregistrer."
msgstr ""
"قيمة تحتوي unsafe-inline/unsafe-eval/'*' تتطلب تأكيدًا صريحًا إضافيًا قبل "
"الحفظ."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:386
msgid ""
"La zone créée reste visible dans 'omega-serv audit security' "
"(CSP-001/CSP-002 scannent aussi les zones) si elle contient une relâche - "
"jamais silencieuse, même délibérée."
msgstr ""
"تبقى المنطقة المنشأة ظاهرة في 'omega-serv audit security' (تفحص "
"CSP-001/CSP-002 المناطق أيضًا) إذا احتوت على تساهل - لا تكون صامتة أبدًا، "
"حتى لو كانت متعمَّدة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:393
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:41
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:49
msgid "Contrôle d'accès"
msgstr "التحكم في الوصول"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:394
msgid "Accueil -> Configuration détaillée -> Contrôle d'accès"
msgstr "الرئيسية -> التهيئة التفصيلية -> التحكم في الوصول"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:396
msgid ""
"CRUD de règles allow/deny par préfixe d'URL, avec filtre optionnel par "
"extension - permet par exemple de bloquer des extensions sensibles partout "
"SAUF dans une zone précise."
msgstr ""
"إدارة قواعد allow/deny حسب بادئة URL، مع تصفية اختيارية حسب الامتداد - تتيح "
"مثلًا حظر امتدادات حساسة في كل مكان باستثناء منطقة محددة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:401
#: src/omega_serv/interfaces/tui/guide/content/routage.py:15
#: src/omega_serv/interfaces/tui/guide/content/routage.py:58
#: src/omega_serv/interfaces/tui/guide/content/routage.py:354
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:127
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:60
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:110
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:81
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:63
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:112
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:172
msgid "Préfixe URL"
msgstr "بادئة URL"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:402
msgid "Le préfixe de chemin auquel s'applique la règle."
msgstr "بادئة المسار التي تنطبق عليها القاعدة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:403
msgid ""
"Doit commencer par '/', ex: /private/. Le plus long préfixe correspondant "
"gagne."
msgstr "يجب أن تبدأ بـ '/'، مثال: /private/. تفوز أطول بادئة مطابقة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:404
msgid "Ajoute/modifie une règle via Ajouter/Modifier."
msgstr "يضيف/يعدّل قاعدة عبر إضافة/تعديل."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:405
#: src/omega_serv/interfaces/tui/guide/content/routage.py:19
#: src/omega_serv/interfaces/tui/guide/content/routage.py:135
#: src/omega_serv/interfaces/tui/guide/content/routage.py:220
#: src/omega_serv/interfaces/tui/guide/content/routage.py:317
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:111
msgid "Aucun effet sans rechargement du service (automatique si actif)."
msgstr "لا أثر دون إعادة تحميل الخدمة (تلقائيًا إن كانت نشطة)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:408
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Verdict"
msgstr "الحكم"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:409
msgid "Ce que décide la règle pour les chemins qu'elle couvre."
msgstr "ما تقرره القاعدة للمسارات التي تغطيها."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:410
msgid "allow ou deny."
msgstr "allow أو deny."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:411
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:421
msgid "Ajoute/modifie une règle."
msgstr "يضيف/يعدّل قاعدة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:412
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:422
#: src/omega_serv/interfaces/tui/guide/content/routage.py:26
#: src/omega_serv/interfaces/tui/guide/content/routage.py:33
#: src/omega_serv/interfaces/tui/guide/content/routage.py:62
#: src/omega_serv/interfaces/tui/guide/content/routage.py:69
#: src/omega_serv/interfaces/tui/guide/content/routage.py:76
#: src/omega_serv/interfaces/tui/guide/content/routage.py:99
#: src/omega_serv/interfaces/tui/guide/content/routage.py:106
#: src/omega_serv/interfaces/tui/guide/content/routage.py:142
#: src/omega_serv/interfaces/tui/guide/content/routage.py:156
#: src/omega_serv/interfaces/tui/guide/content/routage.py:163
#: src/omega_serv/interfaces/tui/guide/content/routage.py:170
#: src/omega_serv/interfaces/tui/guide/content/routage.py:181
#: src/omega_serv/interfaces/tui/guide/content/routage.py:227
#: src/omega_serv/interfaces/tui/guide/content/routage.py:240
#: src/omega_serv/interfaces/tui/guide/content/routage.py:329
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:121
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:128
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:146
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:153
msgid "Aucun effet sans rechargement du service."
msgstr "لا أثر دون إعادة تحميل الخدمة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:415
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Extensions"
msgstr "الامتدادات"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:417
msgid ""
"Restreint la règle aux chemins se terminant par l'une de ces extensions - "
"vide signifie 'toutes', la règle s'applique alors à tout chemin sous ce "
"préfixe."
msgstr ""
"يقيّد القاعدة بالمسارات المنتهية بأحد هذه الامتدادات - الفراغ يعني 'الكل'، "
"فتنطبق القاعدة عندها على كل مسار تحت هذه البادئة."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:420
msgid ""
"Liste séparée par des virgules, ex: .key, .pem. Vide par défaut (toutes)."
msgstr "قائمة مفصولة بفواصل، مثال: .key, .pem. فارغة افتراضيًا (الكل)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:426
msgid ""
"L'option access_control doit être activée (écran Options) pour que ces "
"règles soient réellement appliquées. Toutes les modifications se rechargent "
"à chaud."
msgstr ""
"يجب تفعيل الخيار access_control (شاشة الخيارات) لتُطبَّق هذه القواعد فعلًا. "
"كل التعديلات يُعاد تحميلها أثناء التشغيل."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:431
msgid ""
"Le plus long préfixe correspondant gagne : une règle 'allow' plus spécifique"
" lève le 'deny' d'un préfixe parent (ex: deny /private/, allow "
"/private/.assets/). Une règle 'allow' explicite lève aussi les règles "
"génériques dotfiles/motifs de l'écran Sécurité générique sur ce chemin "
"précis."
msgstr ""
"تفوز أطول بادئة مطابقة: قاعدة 'allow' أكثر تحديدًا ترفع 'deny' بادئة أصلية "
"(مثال: deny /private/، allow /private/.assets/). وقاعدة 'allow' صريحة ترفع "
"أيضًا القواعد العامة للملفات المخفية/الأنماط في شاشة الأمان العام على هذا "
"المسار تحديدًا."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:437
msgid ""
"Pour bloquer une extension sensible PARTOUT sauf dans une zone : une règle "
"deny sur '/' avec l'extension visée, puis une règle allow (sans extension) "
"sur le préfixe à excepter - le préfixe le plus spécifique l'emporte."
msgstr ""
"لحظر امتداد حساس في كل مكان عدا منطقة واحدة: قاعدة deny على '/' مع الامتداد "
"المستهدف، ثم قاعدة allow (دون امتداد) على البادئة المستثناة - تتغلب البادئة "
"الأكثر تحديدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:12
msgid "Accueil -> Registre des capacités"
msgstr "الرئيسية -> سجل القدرات"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:13
msgid ""
"Scan complet de l'environnement (port libre, openssl présent, PHP-FPM si "
"FastCGI actif...), avec export."
msgstr ""
"فحص كامل للبيئة (منفذ متاح، وجود openssl، PHP-FPM إن كان FastCGI نشطًا...)، "
"مع التصدير."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:16
#: src/omega_serv/interfaces/tui/guide/content/logs.py:511
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1023
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:85
#: src/omega_serv/interfaces/tui/screens/capabilities_screen.py:52
#: src/omega_serv/interfaces/tui/screens/export_log_archives_screen.py:43
#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:114
#: src/omega_serv/interfaces/tui/screens/log_stats_screen.py:107
msgid "Thème d'export HTML"
msgstr "سمة تصدير HTML"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "لوحة الألوان لتصدير HTML."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:513
msgid "5 thèmes disponibles."
msgstr "5 سمات متاحة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:514
msgid "Utilisé au clic sur Exporter HTML."
msgstr "يُستخدم عند النقر على تصدير HTML."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/logs.py:282
#: src/omega_serv/interfaces/tui/guide/content/logs.py:515
msgid "Aucun effet sur le serveur."
msgstr "لا أثر على الخادم."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "تحديث / تصدير JSON / تصدير HTML"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "يعيد الفحص، أو يصدّر نتيجته."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:520
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:247
msgid "Aucune saisie supplémentaire."
msgstr "لا إدخال إضافي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr "التحديث يعيد الفحص؛ والتصديرات تكتب ملفًا مؤرَّخًا بالوقت."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid ""
"Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "لا أثر على الخادم ولا على تهيئته (قراءة فقط + تصدير)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "للاطلاع/التصدير فقط."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "تفاصيل قدرة"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "سجل القدرات -> النقر على سطر"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid ""
"Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : "
"statut, raison, détails techniques, date du dernier scan."
msgstr ""
"التفاصيل الكاملة لقدرة سبق فحصها (دون فحص جديد أبدًا): الحالة، السبب، "
"التفاصيل التقنية، تاريخ آخر فحص."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:197
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:330
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:502
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:171
msgid "Purement consultatif."
msgstr "للاطلاع فقط."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "الرئيسية -> ملفات التعريف"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid ""
"Liste et décrit les 4 profils de base preconfigures "
"(minimal/standard/hardened/development)."
msgstr ""
"يسرد ملفات التعريف الأساسية الأربعة المهيأة مسبقًا "
"(minimal/standard/hardened/development) ويصفها."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:49
#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:39
msgid "Appliquer"
msgstr "تطبيق"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "يفتح شاشة تأكيد تطبيق ملف التعريف المختار."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Sélectionner un profil active ce bouton."
msgstr "اختيار ملف تعريف يفعّل هذا الزر."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Ouvre ApplyProfileScreen."
msgstr "يفتح ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Aucun effet ici - voir la fiche d'ApplyProfileScreen."
msgstr "لا أثر هنا - انظر بطاقة ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:56
msgid "Purement consultatif - aucune modification depuis cet écran lui-même."
msgstr "للاطلاع فقط - لا تعديل من هذه الشاشة نفسها."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "تطبيق ملف تعريف"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Profils -> Appliquer"
msgstr "ملفات التعريف -> تطبيق"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid ""
"Affiche TOUJOURS la différence complète avant toute confirmation, puis "
"écrase la configuration active avec le profil choisi."
msgstr ""
"يعرض دائمًا الفرق الكامل قبل أي تأكيد، ثم يكتب فوق التهيئة النشطة بملف "
"التعريف المختار."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Confirme et écrit le profil choisi."
msgstr "يؤكد ملف التعريف المختار ويكتبه."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid ""
"Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "الفرق الكامل معروض أعلاه مسبقًا - راجعه قبل النقر."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid ""
"Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr "يكتب فوق config/omega-serve.json بالتهيئة المركّبة من ملف التعريف."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:71
msgid ""
"Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si "
"bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire"
" ; sinon un simple rechargement suffit (automatique si un service actif "
"existe)."
msgstr ""
"يمكن لملف تعريف أن يغيّر أي إعداد دفعة واحدة. إذا تغيّر "
"bind/port/listen_backlog/TLS، تلزم إعادة تشغيل كاملة؛ وإلا تكفي إعادة تحميل "
"بسيطة (تلقائيًا إن وُجدت خدمة نشطة)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:77
msgid ""
"Des conflits ou erreurs de validation bloquants demandent une confirmation "
"supplémentaire explicite pour forcer quand même."
msgstr ""
"التعارضات أو أخطاء التحقق الحاجبة تتطلب تأكيدًا صريحًا إضافيًا للفرض رغم "
"ذلك."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid ""
"Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste "
"de la configuration active est conservé tel quel."
msgstr ""
"لا يعدّل ملف التعريف إلا الحقول التي يحددها صراحةً - تبقى بقية التهيئة "
"النشطة كما هي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Accueil -> Audit de sécurité"
msgstr "الرئيسية -> تدقيق الأمان"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid ""
"Vérifications consultatives (service, rotation des logs, mode WAF...) - "
"mêmes règles que l'audit CLI."
msgstr ""
"فحوص استشارية (الخدمة، تدوير السجلات، وضع WAF...) - القواعد نفسها الخاصة "
"بتدقيق CLI."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:52
msgid "Auditer"
msgstr "تدقيق"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:91
msgid "Relance explicitement l'audit."
msgstr "يعيد التدقيق صراحةً."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:92
msgid ""
"Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture "
"de l'écran."
msgstr "لا إدخال - يجري تدقيق أول تلقائيًا عند فتح الشاشة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "يعيد قراءة التهيئة ويعيد حساب كل قواعد التدقيق."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:221
msgid ""
"Aucun effet sur le serveur (lecture seule) - notifie explicitement le "
"résultat sur un clic explicite."
msgstr ""
"لا أثر على الخادم (قراءة فقط) - يُبلغ النتيجة صراحةً عند النقر الصريح."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "استشاري فقط - لا يعدّل شيئًا أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Accueil -> Sauvegarde de configuration"
msgstr "الرئيسية -> نسخ التهيئة احتياطيًا"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:104
msgid ""
"Créer, lister, restaurer ou supprimer des sauvegardes complètes de la "
"configuration - le fichier de configuration est toujours inclus, jamais "
"chiffre par défaut."
msgstr ""
"إنشاء نسخ احتياطية كاملة للتهيئة أو سردها أو استعادتها أو حذفها - ملف "
"التهيئة مضمَّن دائمًا، وغير مشفَّر افتراضيًا أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:107
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:51
msgid "Tout sauvegarder (configuration complète)"
msgstr "نسخ كل شيء احتياطيًا (إعدادات كاملة)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid ""
"Coche toutes les cases : de quoi retrouver la configuration entière et ses "
"modules."
msgstr "يحدد كل الخانات: كل ما يلزم لاستعادة الإعدادات كاملة ووحداتها."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
msgid ""
"Case à cocher ; les secrets (zones Auth, clés TLS) restent confirmés à la "
"création."
msgstr ""
"خانة اختيار. البيانات السرية (مناطق Auth، مفاتيح TLS) لا تزال تطلب تأكيدًا "
"عند الإنشاء."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:110
#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
#: src/omega_serv/interfaces/tui/guide/content/divers.py:135
#: src/omega_serv/interfaces/tui/guide/content/divers.py:142
#: src/omega_serv/interfaces/tui/guide/content/divers.py:149
msgid "Pris en compte à la création."
msgstr "يُعتمد عند الإنشاء."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:111
msgid ""
"Ce qui est désigné hors du dossier omega-serv (ex. un certificat dans /etc) "
"n'est jamais archivé, et c'est indiqué après la création."
msgstr ""
"ما يقع خارج مجلد omega-serv (مثل شهادة في /etc) لا يُؤرشف، ويُشار إلى ذلك "
"بعد الإنشاء."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:115
msgid "RIPOSTE, pages d'erreur, préférences, bibliothèque des journaux"
msgstr "RIPOSTE، صفحات الخطأ، الإعدادات الشخصية، مكتبة السجلات"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:116
msgid ""
"Base RIPOSTE ; pages d'erreur personnalisées ; thème, langues et nom du "
"service ; favoris, sources distantes et rotations planifiées des journaux."
msgstr ""
"قاعدة بيانات RIPOSTE، صفحات الخطأ المخصصة، السمة/اللغة/اسم الخدمة، مفضلات "
"السجلات/المصادر البعيدة/التدويرات المجدولة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
msgid ""
"Cases à cocher. Les règles WAF comprennent aussi les listes de mots-clés et "
"les scripts Magnet."
msgstr ""
"خانة اختيار. تشمل قواعد WAF أيضًا قوائم الكلمات المفتاحية وسكربتات Magnet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:119
msgid ""
"Pris en compte à la création ; les bases (Active Defense, RIPOSTE) sont "
"copiées de façon cohérente, serveur en marche."
msgstr ""
"يُطبَّق عند الإنشاء. تُنسخ قواعد البيانات (Active Defense، RIPOSTE) بشكل "
"متسق حتى أثناء عمل الخادم."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:121
msgid ""
"Une sauvegarde qui contient une base n'est jamais restaurée sous un serveur "
"actif : « Arrêter, restaurer, redémarrer » est proposé, et les bases "
"actuelles sont mises de côté."
msgstr ""
"لا تُستعاد نسخة احتياطية تحتوي قواعد بيانات أبدًا أثناء عمل الخادم: يُقترح "
"'إيقاف واستعادة وإعادة تشغيل' وتُحفظ قواعد البيانات الحالية جانبًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid "Inclure les règles WAF"
msgstr "تضمين قواعد WAF"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:126
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "يضيف قواعد WAF وقائمة الحظر إلى النسخة الاحتياطية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:127
#: src/omega_serv/interfaces/tui/guide/content/divers.py:148
msgid "Case à cocher."
msgstr "خانة اختيار."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:129
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "لا أثر فوري - فقط محتوى النسخة الاحتياطية المنشأة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:132
msgid "Inclure les zones d'authentification"
msgstr "تضمين مناطق المصادقة"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:133
msgid ""
"Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la "
"sauvegarde."
msgstr ""
"يضيف users.json/zones.json (أسرار حقيقية: تجزئة كلمات المرور) إلى النسخة "
"الاحتياطية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:134
#: src/omega_serv/interfaces/tui/guide/content/divers.py:141
msgid ""
"Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "خانة اختيار - تتطلب تأكيدًا صريحًا إضافيًا إذا حُدّدت."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "تحتوي النسخة الاحتياطية على أسرار حقيقية، غير مشفّرة أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:139
msgid "Inclure les certificats"
msgstr "تضمين الشهادات"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:140
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "يضيف شهادات TLS، بما فيها المفاتيح الخاصة، إلى النسخة الاحتياطية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "تحتوي النسخة الاحتياطية على مفاتيح خاصة حقيقية، غير مشفّرة أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:146
msgid "Inclure Active Defense"
msgstr "تضمين Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr ""
"يضيف قاعدة بيانات التهديدات/الحوادث الخاصة بـ Active Defense إلى النسخة "
"الاحتياطية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:150
#: src/omega_serv/interfaces/tui/guide/content/divers.py:157
msgid "Aucun effet immédiat."
msgstr "لا أثر فوري."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:153
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:62
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:80
msgid "Description"
msgstr "الوصف"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:154
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "ملاحظة حرة مرتبطة بالنسخة الاحتياطية، للعثور عليها لاحقًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid "Texte libre, optionnel."
msgstr "نص حر، اختياري."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:156
msgid "Enregistrée avec la sauvegarde."
msgstr "يُحفظ مع النسخة الاحتياطية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:160
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:72
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "استعادة"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:161
msgid ""
"Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX "
"MÊMES EMPLACEMENTS."
msgstr ""
"يكتب فوق الملفات الحالية بملفات النسخة الاحتياطية المختارة، في المواقع "
"نفسها."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:162
#: src/omega_serv/interfaces/tui/guide/content/divers.py:173
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "اختر نسخة احتياطية، ثم أكّد."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:163
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "كتابة فعلية وفورية للملفات المعنية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:165
msgid ""
"Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration "
"peut écraser n'importe quel fichier (configuration, certificats TLS...), et "
"un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr ""
"يتطلب دائمًا إعادة تشغيل كاملة احتياطًا - قد تكتب الاستعادة فوق أي ملف "
"(التهيئة، شهادات TLS...)، والشهادة المحمَّلة في الذاكرة لا يُعاد تحميلها "
"تلقائيًا أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:171
#: src/omega_serv/interfaces/tui/guide/content/logs.py:88
#: src/omega_serv/interfaces/tui/guide/content/logs.py:139
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:69
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:52
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:57
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:65
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:74
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:92
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:51
#: src/omega_serv/interfaces/tui/screens/purge_log_archives_screen.py:38
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:55
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:77
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:162
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:60
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:54
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:70
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:62
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:93
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:195
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:97
msgid "Supprimer"
msgstr "حذف"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:172
msgid ""
"Supprime définitivement une sauvegarde (n'existe pas côté CLI, confort TUI "
"uniquement)."
msgstr "يحذف نسخة احتياطية نهائيًا (غير موجود في CLI، ميزة راحة في TUI فقط)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:174
msgid "Suppression immédiate et définitive."
msgstr "حذف فوري ونهائي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:175
msgid ""
"Aucun effet sur le serveur - seulement sur les sauvegardes disponibles."
msgstr "لا أثر على الخادم - فقط على النسخ الاحتياطية المتاحة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:178
msgid ""
"Restaurer écrase directement les fichiers vises, sans filet - la seule "
"protection est la confirmation demandée avant."
msgstr ""
"الاستعادة تكتب مباشرةً فوق الملفات المستهدفة دون شبكة أمان - الحماية الوحيدة"
" هي التأكيد المطلوب مسبقًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:183
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:112
msgid "Réglages de l'application"
msgstr "إعدادات التطبيق"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:184
msgid "Raccourci clavier 'o' (footer), depuis n'importe quel écran"
msgstr "اختصار لوحة المفاتيح 'o' (التذييل)، من أي شاشة"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:186
msgid ""
"PRÉFÉRENCES D'INTERFACE uniquement (thème, rendu, chemins d'export/captures)"
" - PAS des réglages du serveur (ceux-là vivent dans Configuration "
"détaillée)."
msgstr ""
"تفضيلات الواجهة فقط (السمة، العرض، مسارات التصدير/اللقطات) - وليست إعدادات "
"الخادم (تلك موجودة في التهيئة التفصيلية)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:192
msgid "Thème visuel de l'interface elle-même."
msgstr "السمة المرئية للواجهة نفسها."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:193
msgid "Un des thèmes disponibles."
msgstr "إحدى السمات المتاحة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:194
msgid "Appliqué immédiatement au changement."
msgstr "تُطبَّق فور التغيير."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:195
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "أثر فوري، لا حاجة لإعادة التشغيل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:198
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:207
msgid "Profil de rendu"
msgstr "ملف العرض"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:199
msgid ""
"Force un profil de rendu Textual particulier plutôt que la détection "
"automatique."
msgstr "يفرض ملف عرض Textual محددًا بدلًا من الاكتشاف التلقائي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:200
msgid "Automatique, ou un profil précis."
msgstr "تلقائي، أو ملف محدد."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:201
msgid "Enregistre la préférence."
msgstr "يحفظ التفضيل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:202
msgid ""
"Appliqué seulement AU PROCHAIN DÉMARRAGE de l'interface, jamais à chaud."
msgstr "يُطبَّق فقط عند التشغيل التالي للواجهة، وليس أثناء التشغيل أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:207
msgid ""
"Langue de l'interface. Chaque langue est écrite dans sa propre langue, "
"Français toujours en tête ; le libellé 'Langue / Language' n'est jamais "
"traduit, pour être retrouvé même dans une langue qu'on ne lit pas. Une "
"langue non encore validée porte la mention 'en test'."
msgstr ""
"لغة الواجهة. كل لغة مكتوبة بلغتها، والفرنسية دائمًا في المقدمة؛ لا تُترجَم "
"التسمية 'Langue / Language' أبدًا، ليُعثر عليها حتى في لغة لا تقرؤها. اللغة "
"التي لم يُتحقق منها بعد تحمل عبارة 'قيد الاختبار'."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:212
msgid ""
"Choisir une langue dans la liste, puis confirmer le redémarrage de "
"l'interface."
msgstr "اختر لغة من القائمة، ثم أكّد إعادة تشغيل الواجهة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:214
msgid ""
"Enregistre la langue puis redémarre L'INTERFACE (pas le service : le serveur"
" continue de tourner). Un écran de confirmation affiche la langue et la "
"phrase d'invite déjà traduite."
msgstr ""
"يحفظ اللغة ثم يعيد تشغيل الواجهة (وليس الخدمة: يواصل الخادم العمل). تعرض "
"شاشة تأكيد اللغة وعبارة الدعوة مترجمة مسبقًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:218
msgid ""
"Retour au français toujours possible : ce même réglage ; ou lancer une fois "
"'OMEGA_SERV_LANG=fr serv' ; ou retirer la clé 'language' de "
"var/settings.json. Langue indisponible ou catalogue illisible : l'interface "
"démarre en français avec un message. Les journaux du serveur (journalctl) "
"restent toujours en français."
msgstr ""
"العودة إلى الفرنسية ممكنة دائمًا: الإعداد نفسه؛ أو تشغيل 'OMEGA_SERV_LANG=fr"
" serv' مرة واحدة؛ أو حذف المفتاح 'language' من var/settings.json. لغة غير "
"متاحة أو كتالوج غير مقروء: تبدأ الواجهة بالفرنسية مع رسالة. سجلات الخادم "
"(journalctl) تبقى دائمًا بالفرنسية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:225
msgid "Export / Captures d'écran (chemins)"
msgstr "التصدير / لقطات الشاشة (المسارات)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:226
msgid "Répertoires où sont écrits les exports et les captures d'écran."
msgstr "الأدلة التي تُكتب فيها التصديرات ولقطات الشاشة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:227
msgid "Chemin libre - vide revient au répertoire par défaut."
msgstr "مسار حر - الفراغ يعيد إلى الدليل الافتراضي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:228
msgid "Enregistre à chaque changement de texte."
msgstr "يحفظ عند كل تغيير في النص."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:229
msgid "Effet immédiat sur les prochains exports/captures."
msgstr "أثر فوري على التصديرات/اللقطات التالية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:232
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:105
msgid "Langue des exports"
msgstr "لغة التصدير"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:234
msgid ""
"Langue des exports HTML (registre des capacités, archives de logs, guide "
"d'aide) et du rapport d'incident Markdown - un fichier qui se diffuse, pas "
"forcément à quelqu'un qui lit la langue de l'interface. Les exports JSON et "
"CSV n'ont pas de texte à traduire."
msgstr ""
"لغة تصديرات HTML (سجل القدرات، أرشيفات السجلات، دليل المساعدة) وتقرير "
"الحادثة بصيغة Markdown - ملف يُتداول، وليس بالضرورة مع من يقرأ لغة الواجهة. "
"تصديرات JSON وCSV لا تحتوي على نص للترجمة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:238
msgid "« Comme l'interface » (défaut) ou une des langues de la liste."
msgstr "« مثل الواجهة » (الافتراضي) أو إحدى اللغات في القائمة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:240
msgid ""
"Enregistre immédiatement. Dans une autre langue que l'interface, chaque "
"export est produit par un processus séparé lancé dans cette langue : "
"quelques secondes, l'interface reste utilisable."
msgstr ""
"يُحفَظ فورًا. بلغة غير لغة الواجهة، يُنتج كل تصدير عبر عملية منفصلة تُشغَّل "
"بتلك اللغة: بضع ثوانٍ، وتبقى الواجهة قابلة للاستخدام."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:245
msgid ""
"Si ce processus échoue, l'export HTML n'est pas écrit (raison affichée) ; le"
" rapport d'incident, lui, est quand même écrit dans la langue de "
"l'interface, avec un avertissement."
msgstr ""
"إذا فشلت تلك العملية، لا يُكتب تصدير HTML (مع عرض السبب)؛ أما تقرير الحادثة "
"فيُكتب مع ذلك بلغة الواجهة، مع تحذير."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:250
msgid "Supprimer les exports / Supprimer les screenshots"
msgstr "حذف التصديرات / حذف اللقطات"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:251
msgid "Vide complètement le répertoire concerne."
msgstr "يفرغ الدليل المعني كليًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:252
msgid "Confirmation obligatoire."
msgstr "التأكيد إلزامي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:253
msgid ""
"Suppression immédiate et définitive de tous les fichiers du répertoire."
msgstr "حذف فوري ونهائي لكل ملفات الدليل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:254
msgid "Action irréversible."
msgstr "إجراء لا رجعة فيه."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:257
msgid ""
"Ne touche jamais config/omega-serve.json - réglages purement locaux à cette "
"interface."
msgstr ""
"لا يمس config/omega-serve.json أبدًا - إعدادات محلية لهذه الواجهة فقط."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:262
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:113
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:56
msgid "Contact et support"
msgstr "التواصل والدعم"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:263
msgid "Guide d'aide (touche a) -> Contact et support"
msgstr "دليل المساعدة (المفتاح a) -> التواصل والدعم"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:264
msgid ""
"Payer un café au développeur, se déclarer utilisateur anonyme d'omega-serv, "
"contacter le support, ou vérifier si une nouvelle version est publiée. Les "
"adresses sont toujours affichées en clair."
msgstr ""
"ادفع ثمن قهوة للمطوّر، أو سجّل نفسك كمستخدم مجهول الهوية لـ omega-serv، أو "
"تواصل مع الدعم، أو تحقق مما إذا كان قد نُشر إصدار جديد. تُعرض العناوين "
"دائمًا كاملة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:269
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:49
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:53
msgid "Payer un café"
msgstr "ادفع ثمن قهوة"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:270
msgid "Ouvre la page PayPal du développeur (https://paypal.me/kraynux)."
msgstr "يفتح صفحة PayPal الخاصة بالمطوّر (https://paypal.me/kraynux)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:271
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:159
#: src/omega_serv/interfaces/tui/guide/content/tls.py:27
#: src/omega_serv/interfaces/tui/guide/content/tls.py:228
msgid "Aucune saisie."
msgstr "لا إدخال."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:272
msgid ""
"Ouvre l'adresse dans votre navigateur, même si l'interface tourne sous sudo."
msgstr "يفتح العنوان في متصفحك، حتى لو كانت الواجهة تعمل عبر sudo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:273
msgid ""
"Sans session graphique (SSH, serveur), un message rappelle l'adresse à "
"ouvrir vous-même."
msgstr ""
"بدون جلسة رسومية (SSH، خادم)، تذكّرك رسالة بالعنوان الذي عليك فتحه بنفسك."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:276
msgid "Se déclarer utilisateur (anonyme) / Modifier ma déclaration"
msgstr "تسجيلي كمستخدم (مجهول الهوية) / تعديل تسجيلي"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:277
msgid "Ouvre le formulaire de déclaration anonyme."
msgstr "يفتح نموذج التسجيل المجهول الهوية."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:278
msgid "Le libellé devient « Modifier ma déclaration » une fois déclaré."
msgstr "تصبح التسمية «تعديل تسجيلي» بعد التسجيل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:279
msgid "Ouvre le formulaire Se déclarer utilisateur (anonyme)."
msgstr "يفتح نموذج «تسجيلي كمستخدم (مجهول الهوية)»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:280
msgid "Aucun effet ici - voir la fiche du formulaire."
msgstr "لا أثر هنا - راجع صفحة النموذج."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:283
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:63
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:128
msgid "Ne plus me déclarer"
msgstr "إلغاء تسجيلي"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:284
msgid "Retire la déclaration."
msgstr "يسحب التسجيل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:285
msgid "Actif seulement une fois déclaré ; une confirmation est demandée."
msgstr "نشط فقط بعد التسجيل، ويُطلب تأكيد."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:286
msgid ""
"Envoie un retrait : votre entrée est supprimée du compteur, puis la clé est "
"effacée de cette installation et les envois quotidiens s'arrêtent."
msgstr ""
"يرسل طلب سحب: يُحذف إدخالك من العدّاد، ثم يُمحى المفتاح من هذا التثبيت "
"ويتوقف الإرسال اليومي."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:288
msgid ""
"Réception injoignable : la clé est quand même effacée ; l'entrée disparaît "
"seule (90 jours en envoi quotidien, 1 an en envoi unique)."
msgstr ""
"تعذّر الوصول إلى جهة الاستقبال: يُمحى المفتاح على أي حال، ويختفي الإدخال "
"تلقائيًا (90 يومًا في الإرسال اليومي، وسنة واحدة في الإرسال لمرة واحدة)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:292
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:65
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:69
msgid "Contacter le support"
msgstr "التواصل مع الدعم"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:293
msgid ""
"Ouvre le formulaire de contact du site (https://kraynux.snake-"
"mackarel.ts.net/contact/). L'adresse kraynux@proton.me est aussi affichée."
msgstr ""
"يفتح نموذج التواصل في الموقع (https://kraynux.snake-"
"mackarel.ts.net/contact/). ويُعرض أيضًا العنوان kraynux@proton.me."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:295
msgid "Aucune saisie : omega-serv n'envoie jamais de message lui-même."
msgstr "لا شيء لإدخاله: لا يرسل omega-serv أي رسالة بنفسه أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:296
msgid "Ouvre l'adresse dans votre navigateur."
msgstr "يفتح العنوان في متصفحك."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:297
msgid "Sans session graphique, recopiez l'adresse affichée."
msgstr "بدون جلسة رسومية، انسخ العنوان المعروض."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:300
msgid "Vérifier les mises à jour / Voir les nouveautés"
msgstr "التحقق من التحديثات / عرض الجديد"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:301
msgid ""
"Compare la version installée (aussi affichée dans la barre de titre) à la "
"liste des versions publiées sur le site (download/sha.txt)."
msgstr ""
"يقارن الإصدار المثبّت (المعروض أيضًا في شريط العنوان) بقائمة الإصدارات "
"المنشورة على الموقع (download/sha.txt)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:303
msgid ""
"Seulement sur votre clic : aucune vérification automatique, rien n'est "
"envoyé. Même vérification en ligne de commande : omega-serv version --check."
msgstr ""
"فقط عند نقرك: لا تحقق تلقائي ولا يُرسَل شيء. التحقق نفسه متاح من سطر "
"الأوامر: omega-serv version --check."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:305
msgid ""
"Affiche « à jour », la nouvelle version avec l'adresse de son archive, ou "
"une version en cours plus récente que la dernière publiée."
msgstr ""
"يعرض «محدّث»، أو الإصدار الجديد مع عنوان أرشيفه، أو إصدارًا قيد التطوير أحدث"
" من آخر إصدار منشور."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:307
msgid ""
"Si une version plus récente existe, « Voir les nouveautés » ouvre son résumé"
" dans votre navigateur. Rien n'est installé : la mise à jour se fait comme "
"décrit dans le README."
msgstr ""
"إذا وُجد إصدار أحدث، يفتح «عرض الجديد» ملخّصه في متصفحك. لا يُثبَّت شيء: يتم"
" التحديث كما هو موضح في README."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:311
msgid ""
"Rien n'est envoyé sans un clic explicite sur Envoyer (formulaire de "
"déclaration) ou sur Ne plus me déclarer."
msgstr ""
"لا يُرسل أي شيء دون نقرة صريحة على «إرسال» (نموذج التسجيل) أو على «إلغاء "
"تسجيلي»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:317
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:114
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:55
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:61
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:96
msgid "Se déclarer utilisateur (anonyme)"
msgstr "تسجيلي كمستخدم (مجهول الهوية)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:318
msgid "Contact et support -> Se déclarer utilisateur (anonyme)"
msgstr "التواصل والدعم -> تسجيلي كمستخدم (مجهول الهوية)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:319
msgid ""
"Déclaration volontaire et anonyme : elle compte les utilisateurs d'omega-"
"serv et, si vous le souhaitez, leur continent ou leur pays. Rien n'est "
"activé par défaut."
msgstr ""
"تسجيل طوعي ومجهول الهوية: يعدّ مستخدمي omega-serv، وإن شئت قارتهم أو بلدهم. "
"لا شيء مفعّل افتراضيًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:323
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:85
msgid "Envoi"
msgstr "الإرسال"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:324
msgid "Une seule fois, ou chaque jour."
msgstr "مرة واحدة، أو كل يوم."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:325
msgid ""
"Obligatoire, aucun choix présélectionné : Envoyer reste grisé tant qu'il "
"n'est pas choisi."
msgstr ""
"إلزامي، ولا شيء محدد مسبقًا: يبقى زر «إرسال» معطّلًا حتى يتم الاختيار."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:326
msgid ""
"Une seule fois : un envoi maintenant. Chaque jour : le service omega-serv "
"renvoie le même message au plus une fois par 24 h, ce qui permet de compter "
"les installations actives."
msgstr ""
"مرة واحدة: إرسال واحد الآن. كل يوم: تعيد خدمة omega-serv إرسال الرسالة نفسها"
" مرة واحدة على الأكثر كل 24 ساعة، مما يتيح عدّ التثبيتات النشطة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:328
msgid ""
"L'envoi quotidien tourne dans un processus à part : il ne ralentit jamais le"
" serveur, ni au démarrage ni à l'arrêt. DO_NOT_TRACK=1 dans l'environnement "
"du service le désactive."
msgstr ""
"يعمل الإرسال اليومي في عملية منفصلة: لا يبطّئ الخادم أبدًا، لا عند التشغيل "
"ولا عند الإيقاف. ضبط DO_NOT_TRACK=1 في بيئة الخدمة يعطّله."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:332
msgid "Continent / Pays"
msgstr "القارة / البلد"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:333
msgid ""
"Deux listes indépendantes, facultatives, chacune avec « Autre (non "
"référencé) »."
msgstr "قائمتان مستقلتان واختياريتان، في كل منهما «أخرى (غير مدرجة)»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:334
msgid "Laisser « Non précisé » pour ne rien envoyer de ce champ."
msgstr "اترك «غير محدد» حتى لا يُرسل شيء من هذا الحقل."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:335
msgid "Ajoute le code choisi au message (EU, FR... ou autre)."
msgstr "يضيف الرمز المختار إلى الرسالة (EU، FR... أو autre)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:336
msgid "Ni ville, ni texte libre."
msgstr "لا مدينة ولا نص حر."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:339
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:102
msgid "Message envoyé"
msgstr "الرسالة المُرسلة"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:340
msgid "Le message exact, mis à jour à chaque choix."
msgstr "الرسالة كما هي بالضبط، وتُحدَّث مع كل اختيار."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:341
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:197
msgid "Lecture seule."
msgstr "للقراءة فقط."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:342
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:45
msgid "Aucune."
msgstr "لا شيء."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:343
msgid ""
"Une clé tirée au hasard (32 caractères) est créée au premier envoi, sous "
"var/lib/declaration/ ; elle ne dérive ni de la machine ni de vous."
msgstr ""
"يُنشأ مفتاح عشوائي (32 حرفًا) عند أول إرسال، في var/lib/declaration/؛ ولا "
"يُشتق من الجهاز ولا منك."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:347
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:115
msgid "Envoyer"
msgstr "إرسال"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:348
msgid "Envoie la déclaration en HTTPS vers le site du développeur."
msgstr "يرسل التسجيل عبر HTTPS إلى موقع المطوّر."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:349
msgid "5 secondes au plus ; l'écran ne se fige pas."
msgstr "5 ثوانٍ على الأكثر؛ ولا تتجمد الشاشة أبدًا."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:350
msgid "Succès : retour à Contact et support, état « déclaré »."
msgstr "نجاح: عودة إلى «التواصل والدعم»، والحالة «مُسجَّل»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:351
msgid ""
"Réception injoignable : en « une seule fois », rien n'est enregistré ; en « "
"chaque jour », l'accord est gardé et le service réessaie dans 24 h."
msgstr ""
"تعذّر الوصول إلى جهة الاستقبال: مع «مرة واحدة» لا يُسجَّل شيء؛ ومع «كل يوم» "
"تُحفظ الموافقة وتعيد الخدمة المحاولة بعد 24 ساعة."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:356
msgid ""
"L'adresse IP n'est pas enregistrée dans les déclarations, mais comme pour "
"toute visite d'un site, elle passe par les contrôles de sécurité et le "
"journal technique du serveur de réception."
msgstr ""
"لا يُسجَّل عنوان IP في التسجيلات، لكن كما في أي زيارة لموقع، يمر عبر فحوص "
"الأمان والسجل التقني لخادم الاستقبال."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:358
msgid ""
"Ligne de commande : omega-serv declaration status | declare --mode "
"unique|quotidien [--continent X] [--pays Y] --yes | withdraw."
msgstr ""
"سطر الأوامر: omega-serv declaration status | declare --mode unique|quotidien"
" [--continent X] [--pays Y] --yes | withdraw."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:12
#: src/omega_serv/interfaces/tui/guide/content/faq.py:28
#: src/omega_serv/interfaces/tui/guide/content/faq.py:40
#: src/omega_serv/interfaces/tui/guide/content/faq.py:52
#: src/omega_serv/interfaces/tui/guide/content/faq.py:72
msgid "Redémarrage et rechargement"
msgstr "إعادة التشغيل وإعادة التحميل"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:13
msgid ""
"J'ai active/modifie une option, mais rien ne change sur le serveur - "
"pourquoi ?"
msgstr "فعّلتُ/عدّلتُ خيارًا، لكن لا شيء يتغير على الخادم - لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:15
msgid ""
"Le serveur tourne dans un PROCESSUS DÉJÀ LANCÉ, séparé de l'interface. "
"Écrire un changement dans le fichier de configuration ne le fait jamais "
"relire tout seul par ce processus : il faut soit le RECHARGER (SIGHUP, écran"
" SERVICE -> Recharger - léger, aucune coupure de connexion), soit le "
"REDÉMARRER COMPLÈTEMENT (coupe toutes les connexions en cours). La plupart "
"des écrans de configuration détaillée déclenchent désormais ce rechargement "
"automatiquement dès qu'un service systemd actif est détecté, et vous "
"avertissent sinon. Quelques réglages (bind/port, listen_backlog, TLS, 1ere "
"activation de fastcgi/reverse_proxy, active_defense) exigent toujours un "
"redémarrage complet - jamais un simple rechargement - car ils touchent le "
"socket d'écoute ou des composants construits une seule fois au démarrage."
msgstr ""
"يعمل الخادم في عملية مُشغَّلة مسبقًا، منفصلة عن الواجهة. كتابة تغيير في ملف "
"التهيئة لا تجعل هذه العملية تعيد قراءته من تلقاء نفسها أبدًا: يجب إما إعادة "
"تحميلها (SIGHUP، شاشة SERVICE -> إعادة تحميل - خفيفة، دون قطع أي اتصال)، أو "
"إعادة تشغيلها كليًا (تقطع كل الاتصالات الجارية). معظم شاشات التهيئة "
"التفصيلية تُطلق الآن إعادة التحميل هذه تلقائيًا فور اكتشاف خدمة systemd "
"نشطة، وتنبّهك خلاف ذلك. بعض الإعدادات (bind/port، listen_backlog، TLS، "
"التفعيل الأول لـ fastcgi/reverse_proxy، active_defense) تتطلب دائمًا إعادة "
"تشغيل كاملة - لا إعادة تحميل بسيطة أبدًا - لأنها تمس مقبس الاستماع أو "
"مكوّنات تُبنى مرة واحدة عند الإقلاع."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:29
msgid ""
"Après une mise à jour d'omega-serv, mes nouveaux réglages ne s'appliquent "
"pas alors que le service est « rechargé » - pourquoi ?"
msgstr ""
"بعد تحديث omega-serv لا تُطبَّق إعداداتي الجديدة رغم أن الخدمة « أُعيد "
"تحميلها » - لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:31
msgid ""
"Un rechargement ne relit que la configuration, jamais le programme déjà "
"chargé en mémoire. Si le service tournait déjà avant l'extraction de la mise"
" à jour, il exécute toujours l'ancienne version, qui ignore les réglages "
"apparus depuis. Redémarrez le service une fois après chaque mise à jour "
"(écran SERVICE -> Redémarrer). L'interface le signale : notification à "
"l'accueil, et avertissement après chaque rechargement, tant que le service "
"n'a pas été redémarré (systemd et runit)."
msgstr ""
"إعادة التحميل تعيد قراءة التهيئة فقط، ولا تعيد أبدًا قراءة البرنامج المحمَّل"
" في الذاكرة. إذا كانت الخدمة تعمل قبل فك ضغط التحديث، فهي ما زالت تشغّل "
"النسخة القديمة التي تتجاهل الإعدادات المضافة بعده. أعد تشغيل الخدمة مرة "
"واحدة بعد كل تحديث (شاشة SERVICE -> إعادة تشغيل). تنبّهك الواجهة إلى ذلك: "
"إشعار في الشاشة الرئيسية وتحذير بعد كل إعادة تحميل، ما دامت الخدمة لم يُعَد "
"تشغيلها (systemd وrunit)."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:41
msgid ""
"Comment savoir si un changement précis a besoin d'un rechargement ou d'un "
"redémarrage complet ?"
msgstr "كيف أعرف إن كان تغيير محدد يحتاج إعادة تحميل أم إعادة تشغيل كاملة؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:43
msgid ""
"La réaction exacte de chaque champ est indiquée dans sa fiche du guide "
"(touche F1 depuis l'écran concerne). En règle générale : tout ce qui touche "
"le socket d'écoute (adresse, port, listen_backlog), le contexte TLS, ou un "
"composant construit une seule fois au démarrage (client FastCGI/reverse "
"proxy à la première activation, Active Defense) exige un redémarrage "
"complet. Tout le reste se recharge à chaud."
msgstr ""
"رد الفعل الدقيق لكل حقل مذكور في بطاقته في الدليل (المفتاح F1 من الشاشة "
"المعنية). كقاعدة عامة: كل ما يمس مقبس الاستماع (العنوان، المنفذ، "
"listen_backlog)، أو سياق TLS، أو مكوّنًا يُبنى مرة واحدة عند الإقلاع (عميل "
"FastCGI/الوكيل العكسي عند التفعيل الأول، Active Defense) يتطلب إعادة تشغيل "
"كاملة. وكل ما عدا ذلك يُعاد تحميله أثناء التشغيل."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:54
msgid ""
"J'ai mis à jour le code d'OMEGA-SERV (nouvelle archive, correctif appliqué) "
"mais le comportement ne change jamais, même après un rechargement (SIGHUP) -"
" pourquoi ?"
msgstr ""
"حدّثتُ شيفرة OMEGA-SERV (أرشيف جديد، تصحيح مطبَّق) لكن السلوك لا يتغير "
"أبدًا، حتى بعد إعادة التحميل (SIGHUP) - لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:58
msgid ""
"Piège réel rencontré (2026-10-10, correctif du rendu du directory listing "
"sous une CSP stricte) : le rechargement à chaud (SIGHUP, écran SERVICE -> "
"Recharger) ne relit QUE certains éléments de CONFIGURATION (règles WAF, "
"zones d'authentification) - il ne recharge JAMAIS le CODE Python lui-même, "
"qui reste celui chargé en mémoire depuis le DERNIER DÉMARRAGE du processus, "
"aussi anciens soient les fichiers sur disque. Après une mise à jour du code "
"(nouvelle archive installée, correctif appliqué), un REDÉMARRAGE COMPLET est"
" TOUJOURS nécessaire (`systemctl restart <service>`, ou écran SERVICE -> "
"Arrêter puis Démarrer) - jamais un simple rechargement, même pour un "
"changement qui semble léger. Vérifiez `systemctl status <service>` : une "
"date de démarrage ('Active: active (running) since ...') plus ancienne que "
"votre mise à jour confirme immédiatement ce diagnostic."
msgstr ""
"فخ حقيقي صودف (2026-10-10، تصحيح عرض سرد الدليل تحت CSP صارمة): إعادة "
"التحميل أثناء التشغيل (SIGHUP، شاشة SERVICE -> إعادة تحميل) لا تعيد قراءة "
"إلا بعض عناصر التهيئة (قواعد WAF، مناطق المصادقة) - ولا تعيد أبدًا تحميل "
"شيفرة Python نفسها، التي تبقى تلك المحمَّلة في الذاكرة منذ آخر إقلاع "
"للعملية، مهما كانت الملفات على القرص أحدث. بعد تحديث الشيفرة (أرشيف جديد "
"مثبَّت، تصحيح مطبَّق)، تلزم دائمًا إعادة تشغيل كاملة (`systemctl restart "
"<service>`، أو شاشة SERVICE -> إيقاف ثم تشغيل) - لا إعادة تحميل بسيطة أبدًا،"
" حتى لتغيير يبدو طفيفًا. تحقق من `systemctl status <service>`: تاريخ إقلاع "
"('Active: active (running) since ...') أقدم من تحديثك يؤكد هذا التشخيص "
"فورًا."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:73
msgid ""
"Le rechargement/redemarrage automatique ne s'est pas déclenché - pourquoi ?"
msgstr "لم تُطلَق إعادة التحميل/إعادة التشغيل التلقائية - لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:75
msgid ""
"Le déclenchement automatique ne fonctionne que si un gestionnaire de service"
" système (systemd/OpenRC/runit) est reconnu ET qu'un service est réellement "
"ACTIF pour ce répertoire. Si vous faites tourner le serveur via l'assistant "
"premier lancement (\"Lancer maintenant\", sans service installé), aucun "
"rechargement automatique n'est possible - relancez manuellement, ou "
"installez le service depuis l'écran SERVICE."
msgstr ""
"لا يعمل الإطلاق التلقائي إلا إذا تم التعرف على مدير خدمات نظام "
"(systemd/OpenRC/runit) وكانت هناك خدمة نشطة فعلًا لهذا الدليل. إذا كنت تشغّل"
" الخادم عبر معالج التشغيل الأول (\"التشغيل الآن\"، دون خدمة مثبّتة)، فلا "
"يمكن أي إعادة تحميل تلقائية - أعد التشغيل يدويًا، أو ثبّت الخدمة من شاشة "
"SERVICE."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:84
#: src/omega_serv/interfaces/tui/guide/content/faq.py:95
msgid "Service système"
msgstr "خدمة النظام"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:85
msgid ""
"Juste après 'Installer l'unité', l'écran État & Ressources affiche 'Arrêté' "
"alors que le service tourne - pourquoi ?"
msgstr ""
"مباشرة بعد 'تثبيت الوحدة'، تعرض شاشة الحالة والموارد 'متوقف' بينما الخدمة "
"تعمل - لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:87
msgid ""
"L'installation crée un compte système dédié et ajoute votre session au "
"groupe correspondant, mais l'appartenance à un NOUVEAU groupe Unix ne "
"s'applique jamais à une session déjà ouverte (même terminal déjà lancé avant"
" l'installation). Déconnectez-vous puis reconnectez-vous UNE SEULE FOIS - "
"l'écran affichera alors l'état réel. En attendant, vérifiez via l'écran "
"SERVICE ou `systemctl status`."
msgstr ""
"ينشئ التثبيت حساب نظام مخصّصًا ويضيف جلستك إلى المجموعة المقابلة، لكن "
"العضوية في مجموعة Unix جديدة لا تُطبَّق أبدًا على جلسة مفتوحة مسبقًا (حتى "
"طرفية فُتحت قبل التثبيت). سجّل الخروج ثم الدخول مرة واحدة فقط - ستعرض الشاشة"
" عندها الحالة الحقيقية. في الأثناء، تحقق عبر شاشة SERVICE أو `systemctl "
"status`."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:96
msgid ""
"Le champ 'Nom du service' dans l'écran SERVICE ne correspond pas à ce que je"
" pilote ailleurs - pourquoi ?"
msgstr ""
"الحقل 'اسم الخدمة' في شاشة SERVICE لا يطابق ما أتحكم فيه في مكان آخر - "
"لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:98
msgid ""
"Ce champ persiste une préférence d'interface, distincte de la configuration "
"serveur. Si cette instance est enregistrée en multi-instance, le nom est "
"FIGÉ (celui choisi à la création) - jamais improvisé ici. Une seule "
"interface peut déjà piloter n'importe quelle unité installée en tapant "
"simplement son nom exact, même celle d'une autre copie du projet."
msgstr ""
"يحفظ هذا الحقل تفضيلًا للواجهة، منفصلًا عن تهيئة الخادم. إذا كان هذا المثيل "
"مسجّلًا في المثيلات المتعددة، فالاسم ثابت (الذي اختير عند الإنشاء) - ولا "
"يُرتجل هنا أبدًا. يمكن لواجهة واحدة أن تتحكم في أي وحدة مثبّتة بمجرد كتابة "
"اسمها الدقيق، حتى وحدة نسخة أخرى من المشروع."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:106
#: src/omega_serv/interfaces/tui/guide/content/faq.py:118
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:115
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:78
#: src/omega_serv/interfaces/tui/screens/home.py:84
msgid "Multi-instance"
msgstr "المثيلات المتعددة"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:107
msgid ""
"Puis-je installer une seconde unité systemd qui pointe vers le même "
"répertoire, sous un autre nom ?"
msgstr "هل يمكنني تثبيت وحدة systemd ثانية تشير إلى الدليل نفسه، باسم آخر؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:109
msgid ""
"Non - deux garde-fous bloquent explicitement cette situation avant toute "
"écriture : une unité différente pointant déjà vers ce répertoire "
"(partagerait silencieusement var/, la configuration et le compte système "
"dédié), et un nom déjà utilisé par une unité pointant vers un AUTRE "
"répertoire (volerait ce nom, écrasant l'unité existante). Pour héberger "
"plusieurs serveurs, utilisez Multi-instance : chaque instance a son propre "
"répertoire, sa propre configuration et son propre compte système."
msgstr ""
"لا - حارسان يمنعان هذا الوضع صراحةً قبل أي كتابة: وحدة مختلفة تشير مسبقًا "
"إلى هذا الدليل (ستتقاسم بصمت var/ والتهيئة وحساب النظام المخصّص)، واسم "
"مستخدم مسبقًا من وحدة تشير إلى دليل آخر (ستسلبها الاسم وتكتب فوق الوحدة "
"الموجودة). لاستضافة عدة خوادم، استخدم المثيلات المتعددة: لكل مثيل دليله "
"وتهيئته وحساب نظامه الخاص."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:119
msgid ""
"La création d'une nouvelle instance échoue à l'étape 4/6 (Installation des "
"dépendances) - pourquoi ?"
msgstr "يفشل إنشاء مثيل جديد في الخطوة 4/6 (تثبيت الاعتماديات) - لماذا؟"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:121
msgid ""
"Piège réel corrigé : si le message d'échec mentionne 'omega-lib' et 'No "
"matching distribution found', c'était un bug de la création d'instance elle-"
"même, pas une erreur de votre part - omega-lib n'est pas publiée sur PyPI, "
"et l'ancienne version ne savait retrouver sa source réelle (vendorée ou "
"depuis un clone de développement) que dans un seul des deux cas. Corrigé : "
"la nouvelle instance réutilise désormais la même source qu'omega-lib déjà "
"installée pour l'instance en cours, quelle que soit sa provenance. Si "
"l'échec persiste malgré une version à jour, vérifiez que le réseau est "
"disponible pour les AUTRES dépendances (`textual`, `pyte`, `jinja2`, "
"`psutil`), qui viennent bien de PyPI."
msgstr ""
"فخ حقيقي تم تصحيحه: إذا ذكرت رسالة الفشل 'omega-lib' و'No matching "
"distribution found'، فذلك كان خللًا في إنشاء المثيل نفسه، لا خطأً منك - "
"omega-lib غير منشورة على PyPI، والإصدار القديم لم يكن يعرف كيف يجد مصدرها "
"الحقيقي (المضمَّن أو من نسخة تطوير) إلا في حالة واحدة من اثنتين. تم التصحيح:"
" يعيد المثيل الجديد الآن استخدام المصدر نفسه لـ omega-lib المثبّتة للمثيل "
"الحالي، أيًّا كان مصدرها. إذا استمر الفشل رغم إصدار محدَّث، فتحقق من توفر "
"الشبكة للاعتماديات الأخرى (`textual`، `pyte`، `jinja2`، `psutil`)، التي تأتي"
" فعلًا من PyPI."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:133
#: src/omega_serv/interfaces/tui/guide/content/faq.py:143
#: src/omega_serv/interfaces/tui/guide/content/faq.py:156
#: src/omega_serv/interfaces/tui/guide/content/faq.py:172
#: src/omega_serv/interfaces/tui/guide/content/faq.py:184
