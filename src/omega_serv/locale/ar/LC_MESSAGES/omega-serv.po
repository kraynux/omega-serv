msgid "Adresses bannies."
msgstr "العناوين المحظورة."

#: src/omega_serv/interfaces/cli/main.py:1888
msgid "Affiche les bans : réseau, origine, expiration, motif."
msgstr "يعرض الحظر: الشبكة، المصدر، الانتهاء، السبب."

