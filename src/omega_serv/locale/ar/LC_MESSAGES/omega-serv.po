msgstr "كتابة فعلية فورية على القرص."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:220
#: src/omega_serv/interfaces/tui/screens/incidents_screen.py:60
msgid "Générer rapport"
msgstr "إنشاء تقرير"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:221
