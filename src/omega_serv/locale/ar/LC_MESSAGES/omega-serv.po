msgid "RIPOSTE : bans de plus en plus longs pour les récidivistes."
msgstr "RIPOSTE: حظر يطول أكثر فأكثر للمخالفين المتكررين."

#: src/omega_serv/interfaces/cli/main.py:1945
msgid ""
"Lance le processus RIPOSTE au premier plan (normalement lancé par serve ; "
"utile au diagnostic)."
msgstr "يشغّل عملية RIPOSTE في المقدمة (يطلقها serve عادةً؛ مفيد للتشخيص)."

#: src/omega_serv/interfaces/cli/main.py:1947
msgid "Affiche l'état de RIPOSTE (lecture seule)."
msgstr "يعرض حالة RIPOSTE (قراءة فقط)."

#: src/omega_serv/interfaces/cli/main.py:1951
msgid "Menaces suivies par Active Defense."
msgstr "التهديدات التي يتتبعها Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1952
msgid "Liste les sources suivies avec leur score et leur niveau."
msgstr "يسرد المصادر المتتبَّعة مع درجتها ومستواها."

#: src/omega_serv/interfaces/cli/main.py:1954
msgid "Seulement ce niveau."
msgstr "هذا المستوى فقط."

#: src/omega_serv/interfaces/cli/main.py:1956
msgid "Affiche le détail d'une source suivie."
msgstr "يعرض تفاصيل مصدر متتبَّع."

