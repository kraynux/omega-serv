msgstr "हमला वर्ग"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:279
msgid "Type d'attaque simulé."
msgstr "सिम्युलेटेड हमले का प्रकार।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:280
msgid "Doit être une classe connue (ex: scan). Valeur par défaut : scan."
msgstr "एक ज्ञात वर्ग होना चाहिए (उदा.: scan)। डिफ़ॉल्ट मान: scan।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:285
#: src/omega_serv/interfaces/tui/screens/threats_screen.py:44
msgid "Score"
msgstr "स्कोर"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:286
msgid "Delta de score appliqué à la simulation."
msgstr "सिमुलेशन पर लागू स्कोर delta।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:287
msgid "Entier. Valeur par défaut : 10."
msgstr "पूर्णांक। डिफ़ॉल्ट मान: 10।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:292
msgid "Aucune - dry-run complet, jamais d'écriture (aucun repository.save()/create() appelé)."
msgstr "कोई नहीं - पूरा dry-run, कभी लेखन नहीं (कोई repository.save()/create() नहीं बुलाया जाता)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:297
msgid "WAF - État"
msgstr "WAF - स्थिति"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:298
msgid "Accueil -> Active Sécurité -> État (bloc WAF)"
msgstr "होम -> एक्टिव सुरक्षा -> स्थिति (WAF खंड)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:299
msgid "Vue d'ensemble en lecture seule : mode, comportement en cas d'erreur interne, packs de règles référencés, taille de la blocklist."
msgstr "केवल-पढ़ने वाला अवलोकन: मोड, आंतरिक त्रुटि पर व्यवहार, संदर्भित नियम पैक, ब्लॉकलिस्ट का आकार।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:304
msgid "Si aucun pack de règles n'est référence, le WAF ne peut RIEN détecter même actif - l'écran l'indique explicitement, corrige un vrai trou signalé par l'utilisateur."
msgstr "यदि कोई नियम पैक संदर्भित नहीं है, तो WAF सक्रिय होने पर भी कुछ नहीं पहचान सकता - स्क्रीन इसे स्पष्ट रूप से बताती है, उपयोगकर्ता द्वारा बताई गई एक वास्तविक कमी को ठीक करती है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:312
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:91
msgid "WAF - Modules"
msgstr "WAF - मॉड्यूल"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:313
msgid "Accueil -> Active Sécurité -> Modules (bloc WAF)"
msgstr "होम -> एक्टिव सुरक्षा -> मॉड्यूल (WAF खंड)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:314
msgid "Trois sections : mode/comportement d'erreur, gestion des packs de règles actifs, gestion de la liste de blocage."
msgstr "तीन अनुभाग: मोड/त्रुटि व्यवहार, सक्रिय नियम पैक का प्रबंधन, ब्लॉकलिस्ट का प्रबंधन।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:318
msgid "Comportement du WAF face à une requête jugée malveillante."
msgstr "दुर्भावनापूर्ण माने गए अनुरोध पर WAF का व्यवहार।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:319
msgid "log-only (journalise sans bloquer) ou block (bloque réellement)."
msgstr "log-only (ब्लॉक किए बिना लॉग करता है) या block (वास्तव में ब्लॉक करता है)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:321
msgid "Rechargement AUTOMATIQUE déclenché des l'enregistrement si un service actif existe."
msgstr "सक्रिय सर्विस होने पर सेव करते ही स्वचालित रीलोड ट्रिगर होता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:324
msgid "Comportement en cas d'erreur interne"
msgstr "आंतरिक त्रुटि पर व्यवहार"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:325
msgid "Que faire si le moteur WAF rencontre une erreur inattendue en analysant une requête."
msgstr "अनुरोध का विश्लेषण करते समय WAF इंजन को अप्रत्याशित त्रुटि मिलने पर क्या करें।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:326
msgid "fail-open (laisse passer) ou fail-closed (bloque par prudence)."
msgstr "fail-open (जाने देता है) या fail-closed (सावधानी के लिए ब्लॉक करता है)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:327
#: src/omega_serv/interfaces/tui/guide/content/tls.py:319
msgid "Enregistre avec le mode."
msgstr "मोड के साथ सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:328
msgid "Rechargement automatique."
msgstr "स्वचालित रीलोड।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:331
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:73
msgid "Packs de règles (rule_paths)"
msgstr "नियम पैक (rule_paths)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:332
msgid "Fichiers de règles réellement charges par le WAF - sans au moins un pack, rien n'est détecté."
msgstr "WAF द्वारा वास्तव में लोड की गई नियम फ़ाइलें - कम से कम एक पैक के बिना कुछ भी नहीं पहचाना जाता।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:333
msgid "Ajouter ouvre un sélecteur des packs présents sous secure/waf/rules/ non déjà référencés."
msgstr "'जोड़ें' secure/waf/rules/ के अंतर्गत मौजूद, अभी तक संदर्भित न किए गए पैक का चयनकर्ता खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:334
msgid "Ajoute/retire une référence de pack."
msgstr "पैक संदर्भ जोड़ता/हटाता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:335
msgid "Rechargement automatique déclenché immédiatement (recompile les règles en mémoire)."
msgstr "तुरंत स्वचालित रीलोड ट्रिगर होता है (मेमोरी में नियम फिर से compile होते हैं)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:338
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:82
msgid "Liste de blocage"
msgstr "ब्लॉकलिस्ट"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:340
msgid "IP/reseaux bannis, avec motif et expiration optionnelle. Fichier par défaut : var/lib/waf/blocklist.json (sous var/, le seul dossier où le service systemd peut écrire ses auto-bans). Un ancien secure/waf/blocklist.json est repris une fois au démarrage et laissé en place comme sauvegarde."
msgstr "बैन किए गए IP/नेटवर्क, कारण और वैकल्पिक समाप्ति के साथ। डिफ़ॉल्ट फ़ाइल: var/lib/waf/blocklist.json (var/ के अंतर्गत, एकमात्र फ़ोल्डर जहाँ systemd सर्विस अपने ऑटो-बैन लिख सकती है)। पुरानी secure/waf/blocklist.json स्टार्ट पर एक बार ली जाती है और बैकअप के रूप में वहीं छोड़ दी जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:345
msgid "Réseau (CIDR), motif, durée en secondes (vide = permanent, confirmation requise dans ce cas)."
msgstr "नेटवर्क (CIDR), कारण, सेकंड में अवधि (खाली = स्थायी, इस स्थिति में पुष्टि आवश्यक)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:346
msgid "Ajoute/retire une entrée."
msgstr "एक एंट्री जोड़ता/हटाता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:348
msgid "EFFET IMMÉDIAT, sans rechargement nécessaire - la blocklist est relue depuis le disque à CHAQUE requête, jamais mise en cache en mémoire (contrairement au mode et aux packs de règles)."
msgstr "तत्काल प्रभाव, रीलोड आवश्यक नहीं - ब्लॉकलिस्ट हर अनुरोध पर डिस्क से फिर से पढ़ी जाती है, मेमोरी में कभी कैश नहीं होती (मोड और नियम पैक के विपरीत)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:355
msgid "Mode/comportement d'erreur/packs de règles nécessitent un rechargement pour s'appliquer (automatique si un service actif existe). La liste de blocage, elle, s'applique instantanément sans aucune action supplémentaire."
msgstr "मोड/त्रुटि व्यवहार/नियम पैक लागू होने के लिए रीलोड आवश्यक है (सक्रिय सर्विस होने पर स्वचालित)। ब्लॉकलिस्ट, इसके विपरीत, बिना किसी अतिरिक्त एक्शन के तुरंत लागू होती है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:363
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:92
msgid "WAF - Exclusions et débit"
msgstr "WAF - अपवाद और दर सीमा"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:364
msgid "Accueil -> Active Sécurité -> Exclusions et débit (bloc WAF)"
msgstr "होम -> एक्टिव सुरक्षा -> अपवाद और दर सीमा (WAF खंड)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:366
msgid "Règle la limite de débit (rate limit) du WAF natif : la limite globale, des règles par dossier et des règles par IP/réseau, ainsi que les exclusions d'inspection. Sert surtout aux pages lourdes (une galerie d'images, par exemple) qui dépassent la limite globale et reçoivent une erreur 429."
msgstr "नेटिव WAF की दर सीमा (rate limit) सेट करता है: वैश्विक सीमा, फ़ोल्डर के अनुसार नियम और IP/नेटवर्क के अनुसार नियम, साथ ही जाँच के अपवाद। मुख्य रूप से भारी पेजों (जैसे इमेज गैलरी) के लिए उपयोगी, जो वैश्विक सीमा पार करके 429 त्रुटि पाते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:373
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:83
msgid "Limite globale"
msgstr "वैश्विक सीमा"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:374
msgid "Nombre de requêtes autorisées par IP et par fenêtre, pour tout ce qui n'a pas de règle spécifique."
msgstr "हर उस चीज़ के लिए जिसका कोई विशेष नियम नहीं है, प्रति IP और प्रति विंडो अनुमत अनुरोधों की संख्या।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:375
msgid "Rate limit actif (oui/non), nombre de requêtes, fenêtre en secondes."
msgstr "rate limit सक्रिय (हाँ/नहीं), अनुरोधों की संख्या, सेकंड में विंडो।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:377
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:822
msgid "Rechargement automatique déclenché si un service actif existe."
msgstr "सक्रिय सर्विस होने पर स्वचालित रीलोड ट्रिगर होता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:380
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:93
msgid "Règles par dossier"
msgstr "फ़ोल्डर के अनुसार नियम"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:382
msgid "Une règle REMPLACE la limite globale pour ce dossier et a son propre compteur : les requêtes sur ce dossier ne consomment plus la limite globale. 0 = illimité. Si plusieurs dossiers correspondent, le plus long gagne. /images couvre /images/a.png mais jamais /images2."
msgstr "नियम उस फ़ोल्डर के लिए वैश्विक सीमा की जगह लेता है और उसका अपना काउंटर होता है: इस फ़ोल्डर के अनुरोध अब वैश्विक सीमा खर्च नहीं करते। 0 = असीमित। कई फ़ोल्डर मेल खाएँ तो सबसे लंबा जीतता है। /images में /images/a.png आता है, पर /images2 कभी नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:387
msgid "Ajouter / Modifier : dossier, requêtes par fenêtre, fenêtre en secondes. Sélectionner une ligne pour la modifier ou la retirer."
msgstr "जोड़ें / बदलें: फ़ोल्डर, प्रति विंडो अनुरोध, सेकंड में विंडो। बदलने या हटाने के लिए एक पंक्ति चुनें।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:388
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:406
msgid "Enregistré dès la validation du formulaire."
msgstr "फ़ॉर्म की पुष्टि होते ही सेव हो जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:390
msgid "Rechargement automatique. Une IP publique qui dépasse une règle de dossier est toujours journalisée comme un blocage, donc bannissable par omega-jail."
msgstr "स्वचालित रीलोड। फ़ोल्डर नियम पार करने वाला सार्वजनिक IP अब भी ब्लॉक के रूप में लॉग होता है, इसलिए omega-jail उसे बैन कर सकता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:395
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:108
msgid "Règles par IP / réseau"
msgstr "IP / नेटवर्क के अनुसार नियम"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:397
msgid "Même principe pour une IP ou un réseau (ex. le réseau Tailscale 100.64.0.0/10). Une règle de dossier passe avant une règle IP/réseau ; entre deux réseaux, le plus précis gagne."
msgstr "IP या नेटवर्क के लिए भी यही सिद्धांत (जैसे Tailscale नेटवर्क 100.64.0.0/10)। फ़ोल्डर नियम IP/नेटवर्क नियम से पहले आता है; दो नेटवर्कों में अधिक सटीक वाला जीतता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:402
msgid "IP ou réseau (CIDR), requêtes, fenêtre, Source sûre (oui/non). Une source sûre qui dépasse la limite reçoit toujours le 429, mais la ligne est journalisée « throttle » : jamais bannissable."
msgstr "IP या नेटवर्क (CIDR), अनुरोध, विंडो, सुरक्षित स्रोत (हाँ/नहीं)। सीमा पार करने वाले सुरक्षित स्रोत को भी 429 मिलता है, पर पंक्ति « throttle » के रूप में लॉग होती है: कभी बैन नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:408
msgid "Les réseaux never_auto_block (affichés au-dessus du tableau) sont toujours sûrs d'office. Sans proxy de confiance actif, une règle couvrant 127.0.0.1/::1 est ignorée."
msgstr "never_auto_block नेटवर्क (तालिका के ऊपर दिखाए गए) हमेशा डिफ़ॉल्ट रूप से सुरक्षित हैं। सक्रिय विश्वसनीय प्रॉक्सी न होने पर 127.0.0.1/::1 को कवर करने वाला नियम अनदेखा किया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:414
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:119
msgid "Exclusions d'inspection"
msgstr "जाँच के अपवाद"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:415
msgid "Dossiers et extensions jamais inspectés par le WAF natif ni par magnet, et dossiers dont seul le corps n'est pas inspecté."
msgstr "फ़ोल्डर और एक्सटेंशन जिनकी जाँच न नेटिव WAF करता है न magnet, और वे फ़ोल्डर जिनकी केवल बॉडी की जाँच नहीं होती।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:416
msgid "Valeurs séparées par des virgules ; un dossier commence par « / »."
msgstr "कॉमा से अलग मान; फ़ोल्डर « / » से शुरू होता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:418
msgid "Le rate limit s'applique toujours à ces chemins : une exclusion ne règle jamais un 429."
msgstr "इन पाथ पर rate limit अब भी लागू होता है: अपवाद से 429 कभी हल नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:421
msgid "Une règle de débit ne désactive jamais l'inspection : une attaque sur un dossier à débit élevé reste détectée et bloquée."
msgstr "दर नियम जाँच को कभी बंद नहीं करता: ऊँची दर वाले फ़ोल्डर पर हमला अब भी पकड़ा और ब्लॉक किया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:424
msgid "Un dossier en illimité (0) ne protège plus contre un robot qui le martèle depuis une IP publique : préférer une valeur haute (ex. 600 / 60 s) à l'illimité."
msgstr "असीमित (0) फ़ोल्डर अब सार्वजनिक IP से लगातार अनुरोध भेजने वाले बॉट से नहीं बचाता: असीमित के बजाय ऊँचा मान (जैसे 600 / 60 सेकंड) चुनें।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:428
msgid "Sans rapport avec « Requêtes max par connexion keep-alive » (Configuration détaillée -> Résistance et limites) : ce réglage ferme seulement une connexion après N requêtes, le navigateur en rouvre une aussitôt. Il ne renvoie jamais 429 et ne compte rien par IP : c'est la limite de débit, ici, qui produit le 429."
msgstr "« प्रति keep-alive कनेक्शन अधिकतम अनुरोध » (विस्तृत कॉन्फ़िगरेशन -> मज़बूती और सीमाएँ) से इसका कोई संबंध नहीं: वह सेटिंग केवल N अनुरोधों के बाद कनेक्शन बंद करती है, और ब्राउज़र तुरंत नया खोल लेता है। वह कभी 429 नहीं लौटाती और प्रति IP कुछ नहीं गिनती: यहाँ 429 दर सीमा से ही आता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:434
msgid "Script magnet : son propre rate limit (429) ne compte jamais comme une détection, donc ne mène jamais à l'auto-ban. Sur une requête couverte par une règle de dossier ou d'IP/réseau ci-dessus, c'est cette règle qui fait foi : le 429 de magnet est ignoré (ses signatures d'attaque restent appliquées)."
msgstr "magnet स्क्रिप्ट: उसकी अपनी rate limit (429) कभी पहचान के रूप में नहीं गिनी जाती, इसलिए कभी स्वचालित बैन नहीं होता। ऊपर के किसी फ़ोल्डर या IP/नेटवर्क नियम के दायरे वाले अनुरोध पर वही नियम लागू होता है: magnet का 429 अनदेखा किया जाता है (उसके हमला-हस्ताक्षर लागू रहते हैं)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:444
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:93
msgid "WAF - Tester une requête"
msgstr "WAF - अनुरोध टेस्ट करें"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:445
msgid "Accueil -> Active Sécurité -> Tester (bloc WAF)"
msgstr "होम -> एक्टिव सुरक्षा -> टेस्ट (WAF खंड)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:446
msgid "Teste une requête simulée contre les règles WAF ACTUELLEMENT ENREGISTRÉES (pas nécessairement celles réellement chargées par un serveur déjà lancé), sans requête réseau."
msgstr "एक सिम्युलेटेड अनुरोध को वर्तमान में सेव किए गए WAF नियमों (ज़रूरी नहीं कि पहले से चल रहे सर्वर द्वारा वास्तव में लोड किए गए) के विरुद्ध टेस्ट करता है, बिना नेटवर्क अनुरोध के।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:449
msgid "Méthode / Chemin / Query / Body / IP distante"
msgstr "मेथड / पाथ / Query / Body / रिमोट IP"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:450
msgid "Composants de la requête HTTP simulée."
msgstr "सिम्युलेटेड HTTP अनुरोध के घटक।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:451
msgid "Valeurs libres - méthode et chemin pré-remplis (GET, /)."
msgstr "मुक्त मान - मेथड और पाथ पहले से भरे (GET, /)।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:452
msgid "Utilisés au clic sur Tester."
msgstr "'टेस्ट करें' पर क्लिक करने पर उपयोग होते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:453
msgid "Aucun effet réel, aucune requête réseau."
msgstr "कोई वास्तविक प्रभाव नहीं, कोई नेटवर्क अनुरोध नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:459
msgid "Reconstruit le moteur WAF à partir de la configuration SAUVEGARDÉE sur disque à chaque test - si un serveur déjà lancé n'a pas encore été rechargé après un changement de règles, ce test peut refléter un comportement différent de ce que ce serveur applique réellement pour l'instant."
msgstr "हर टेस्ट पर डिस्क पर सेव किए गए कॉन्फ़िगरेशन से WAF इंजन फिर से बनाता है - यदि पहले से चल रहा सर्वर नियम बदलने के बाद अभी तक रीलोड नहीं हुआ है, तो यह टेस्ट उस सर्वर द्वारा अभी वास्तव में लागू व्यवहार से अलग व्यवहार दिखा सकता है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:469
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:94
msgid "WAF - Règles et listes personnalisées"
msgstr "WAF - कस्टम नियम और सूचियाँ"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:470
msgid "Accueil -> Active Sécurité -> Custom (bloc WAF)"
msgstr "होम -> एक्टिव सुरक्षा -> Custom (WAF खंड)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:472
msgid "Un seul tableau pour les RÈGLES (écrites dans secure/waf/rules/custom.json, pack référence automatiquement) et les LISTES (fichiers texte de secure/waf/rules/keywords/, chargées explicitement par l'assistant). La colonne Type fait la différence : une liste n'est pas une règle de custom.json."
msgstr "नियमों (secure/waf/rules/custom.json में लिखे, पैक स्वचालित रूप से संदर्भित) और सूचियों (secure/waf/rules/keywords/ की टेक्स्ट फ़ाइलें, विज़ार्ड द्वारा स्पष्ट रूप से लोड) के लिए एक ही तालिका। प्रकार कॉलम अंतर बताता है: सूची custom.json का नियम नहीं है।"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:479
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:107
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:65
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:48
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:53
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:90
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:58
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:51
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:158
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:56
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:50
