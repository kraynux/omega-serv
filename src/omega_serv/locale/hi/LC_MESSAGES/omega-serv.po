#: src/omega_serv/domain/security/waf/keyword_list.py:57
msgid ""
"# Syntaxe (une entrée par ligne, '#' = commentaire) :\n"
"#   /admin    -> /admin et /admin/xxx, jamais /administrator\n"
"#   /.git/    -> tout ce qui est sous /.git/\n"
"#   /*.bak    -> tout fichier dont le nom finit par .bak\n"
"#   !/api/v1  -> exception : ce chemin n'est jamais compte par cette liste\n"
"#               (prioritaire sur les entrées, quel que soit l'ordre des lignes)"
msgstr ""
"# सिंटैक्स (प्रति पंक्ति एक एंट्री, '#' = टिप्पणी):\n"
"#   /admin    -> /admin और /admin/xxx, कभी /administrator नहीं\n"
"#   /.git/    -> /.git/ के अंतर्गत सब कुछ\n"
"#   /*.bak    -> .bak पर समाप्त होने वाली हर फ़ाइल\n"
"#   !/api/v1  -> अपवाद: यह पाथ इस सूची द्वारा कभी नहीं गिना जाता\n"
"#               (एंट्री पर प्राथमिकता, पंक्तियों का क्रम चाहे जो हो)"

#: src/omega_serv/domain/security/waf/keyword_list.py:64
msgid ""
"# Liste de chemins personnelle (omega-serv)\n"
"#\n"
msgstr ""
"# व्यक्तिगत पाथ सूची (omega-serv)\n"
"#\n"

#: src/omega_serv/domain/security/waf/keyword_list.py:66
msgid ""
"# Liste de mots-clefs personnelle (omega-serv)\n"
"# Un mot-clef par ligne, recherche n'importe où dans la partie choisie de la requête\n"
"# (casse ignorée). '#' = commentaire. Écrivez le texte tel quel, jamais une regex.\n"
msgstr ""
"# व्यक्तिगत कीवर्ड सूची (omega-serv)\n"
"# प्रति पंक्ति एक कीवर्ड, अनुरोध के चुने गए हिस्से में कहीं भी खोजा जाता है\n"
"# (केस अनदेखा)। '#' = टिप्पणी। टेक्स्ट जैसा है वैसा लिखें, कभी regex नहीं।\n"

#: src/omega_serv/domain/security/waf/keyword_list.py:148
msgid "doit commencer par '/' (ou '!/' pour une exception)"
msgstr "'/' से शुरू होना चाहिए (या अपवाद के लिए '!/')"

#: src/omega_serv/domain/security/waf/keyword_list.py:150
