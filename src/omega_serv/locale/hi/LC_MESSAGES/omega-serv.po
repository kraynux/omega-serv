#: src/omega_serv/interfaces/cli/admin_web_entry.py:91
msgid "lecture : voir seulement ; administration : voir et agir."
msgstr "lecture: केवल देखना; administration: देखना और कार्रवाई करना।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:86
#: src/omega_serv/interfaces/cli/admin_web_entry.py:92
msgid "Remplace le maître déjà accepté (révoqué aussitôt)."
msgstr "पहले से स्वीकृत मास्टर को बदलता है (तुरंत रद्द)।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:89
msgid ""
"Ouvre une fenêtre d'appairage de 10 minutes et affiche le code à saisir sur "
"le maître."
msgstr ""
"10 मिनट की पेयरिंग विंडो खोलता है और मास्टर पर डाला जाने वाला कोड दिखाता है।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:94
msgid "Révoque le maître accepté : ses appels sont refusés aussitôt."
msgstr "स्वीकृत मास्टर को रद्द करता है: उसकी कॉल तुरंत अस्वीकृत होती हैं।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:98
msgid ""
"Instances suivies par ce maître (page Instances du tableau de bord web)."
msgstr ""
"इस मास्टर द्वारा ट्रैक किए गए इंस्टेंस (वेब डैशबोर्ड का इंस्टेंस पेज)।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:99
msgid "Affiche en JSON l'identifiant et le nom de ce maître."
msgstr "इस मास्टर का पहचानकर्ता और नाम JSON में दिखाता है।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:101
