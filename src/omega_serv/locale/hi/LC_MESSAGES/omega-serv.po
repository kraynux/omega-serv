#: src/omega_serv/interfaces/tui/widgets/log_library_table.py:32
msgid "Service"
msgstr "सर्विस"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:53
msgid "Pilotage du service système (demarrer/arreter/redemarrer/recharger/installer)."
msgstr "सिस्टम सर्विस का नियंत्रण (शुरू/रोकें/रीस्टार्ट/रीलोड/इंस्टॉल)।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:54
msgid "À utiliser pour piloter le serveur en tant que service système."
msgstr "सर्वर को सिस्टम सर्विस के रूप में नियंत्रित करने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:55
msgid "Ouvre l'écran Service."
msgstr "सर्विस स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:56
msgid "Voir sa propre fiche - certaines actions demandent une authentification (sudo)."
msgstr "उसका अपना विवरण देखें - कुछ एक्शन के लिए प्रमाणीकरण (sudo) आवश्यक है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:59
msgid "Multi-instance / Instances (N)"
msgstr "मल्टी-इंस्टेंस / इंस्टेंस (N)"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:60
msgid "Registre des installations d'OMEGA-SERV connues sur cette machine."
msgstr "इस मशीन पर ज्ञात OMEGA-SERV इंस्टॉलेशन की रजिस्ट्री।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:61
msgid "Le libellé affiche le nombre d'instances dès que 2 ou plus sont enregistrées."
msgstr "2 या अधिक इंस्टेंस दर्ज होते ही लेबल इंस्टेंस की संख्या दिखाता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:62
msgid "Ouvre l'écran Multi-instance."
msgstr "मल्टी-इंस्टेंस स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:63
msgid "Aucun effet direct (lecture) - voir sa propre fiche pour les actions possibles."
msgstr "कोई सीधा प्रभाव नहीं (केवल पढ़ना) - संभावित एक्शन के लिए उसका अपना विवरण देखें।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:66
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:149
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:78
#: src/omega_serv/interfaces/tui/screens/home.py:91
msgid "État & Ressources"
msgstr "स्थिति और संसाधन"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:67
msgid "Vue d'ensemble en direct : état du serveur/service, flux du log d'accès, ressources système."
msgstr "लाइव अवलोकन: सर्वर/सर्विस की स्थिति, access लॉग प्रवाह, सिस्टम संसाधन।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:68
msgid "À consulter pour un diagnostic rapide."
msgstr "त्वरित निदान के लिए देखें।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:69
msgid "Ouvre l'écran État & Ressources."
msgstr "स्थिति और संसाधन स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:70
msgid "Aucun effet (lecture, rafraîchie automatiquement toutes les 2 secondes)."
msgstr "कोई प्रभाव नहीं (केवल पढ़ना, हर 2 सेकंड में स्वतः रीफ़्रेश)।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:73
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:83
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:84
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:85
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:86
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:87
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:88
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:89
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:90
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:91
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:92
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:93
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:94
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:95
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:96
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:97
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:98
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:99
#: src/omega_serv/interfaces/tui/screens/home.py:89
msgid "Active Sécurité"
msgstr "एक्टिव सुरक्षा"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:74
msgid "Regroupe Active Defense (deception/menaces/incidents) et le pare-feu applicatif (WAF)."
msgstr "Active Defense (deception/खतरे/इंसिडेंट) और एप्लिकेशन फ़ायरवॉल (WAF) को एक साथ रखता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:75
msgid "À utiliser pour la sécurité active du serveur."
msgstr "सर्वर की सक्रिय सुरक्षा के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:76
msgid "Ouvre le menu Active Sécurité."
msgstr "एक्टिव सुरक्षा मेन्यू खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:80
#: src/omega_serv/interfaces/tui/guide/content/divers.py:85
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:81
#: src/omega_serv/interfaces/tui/screens/home.py:86
msgid "Audit de sécurité"
msgstr "सुरक्षा ऑडिट"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:81
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...)."
msgstr "सलाहकारी जाँचें (सर्विस, लॉग रोटेशन, WAF मोड...)।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:82
msgid "À lancer ponctuellement pour un avis global."
msgstr "समग्र राय के लिए कभी-कभी चलाएँ।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:83
msgid "Ouvre l'écran d'audit."
msgstr "ऑडिट स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:87
#: src/omega_serv/interfaces/tui/guide/content/divers.py:102
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:82
#: src/omega_serv/interfaces/tui/screens/home.py:88
msgid "Sauvegarde de configuration"
msgstr "कॉन्फ़िगरेशन बैकअप"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:88
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration."
msgstr "कॉन्फ़िगरेशन के पूर्ण बैकअप बनाएँ, सूचीबद्ध करें, रिस्टोर करें या हटाएँ।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:89
msgid "À utiliser avant un changement risque, ou pour migrer une configuration."
msgstr "जोखिम भरे बदलाव से पहले, या कॉन्फ़िगरेशन को स्थानांतरित करने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:90
msgid "Ouvre l'écran de sauvegarde."
msgstr "बैकअप स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:91
msgid "Restaurer ÉCRASE directement les fichiers vises - voir sa propre fiche."
msgstr "रिस्टोर लक्षित फ़ाइलों को सीधे ओवरराइट करता है - उसका अपना विवरण देखें।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:94
msgid "Cet écran ne modifie jamais la configuration lui-même - uniquement de la navigation."
msgstr "यह स्क्रीन स्वयं कभी कॉन्फ़िगरेशन नहीं बदलती - केवल नेविगेशन।"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:97
msgid "Appuyer sur Échap depuis cet écran demande une confirmation de sortie de l'application (contrairement aux autres écrans, où Échap revient simplement en arrière)."
msgstr "इस स्क्रीन पर Esc दबाने से एप्लिकेशन से बाहर निकलने की पुष्टि माँगी जाती है (अन्य स्क्रीन के विपरीत, जहाँ Esc बस पीछे ले जाता है)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:12
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
msgid "Configuration détaillée (menu)"
msgstr "विस्तृत कॉन्फ़िगरेशन (मेन्यू)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:13
msgid "Accueil -> Configuration détaillée"
msgstr "होम -> विस्तृत कॉन्फ़िगरेशन"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:15
msgid "Sous-menu regroupant tous les écrans de configuration du serveur et des options superposables, plus deux raccourcis (Voir options actives, Vérifier la configuration)."
msgstr "सर्वर और परत-दर-परत विकल्पों की सभी कॉन्फ़िगरेशन स्क्रीन वाला उप-मेन्यू, साथ में दो शॉर्टकट (सक्रिय विकल्प देखें, कॉन्फ़िगरेशन जाँचें)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:18
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:17
#: src/omega_serv/interfaces/tui/guide/content/tls.py:15
msgid "Aucune - purement navigation."
msgstr "कोई नहीं - केवल नेविगेशन।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "आधार कॉन्फ़िगरेशन"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "होम -> विस्तृत कॉन्फ़िगरेशन -> आधार कॉन्फ़िगरेशन"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid "Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier explicite."
msgstr "सर्वर की मूल सेटिंग्स: listen पता, पोर्ट, घोषित सर्वर नाम, बिना स्पष्ट फ़ाइल नाम वाली डायरेक्टरी में खोजी जाने वाली index फ़ाइलें।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:32
msgid "Adresse d'écoute (bind)"
msgstr "Listen पता (bind)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse IP sur laquelle le serveur accepte les connexions."
msgstr "वह IP पता जिस पर सर्वर कनेक्शन स्वीकार करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:35
msgid "Une adresse IP valide - '127.0.0.1' (local uniquement) ou '0.0.0.0' (toutes les interfaces réseau). Valeur par défaut : 127.0.0.1."
msgstr "एक मान्य IP पता - '127.0.0.1' (केवल लोकल) या '0.0.0.0' (सभी नेटवर्क इंटरफ़ेस)। डिफ़ॉल्ट मान: 127.0.0.1।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:38
msgid "Enregistre dans server.bind après validation structurelle de la configuration."
msgstr "कॉन्फ़िगरेशन की संरचनात्मक जाँच के बाद server.bind में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:40
msgid "Nécessite un REDÉMARRAGE COMPLET - le socket d'écoute n'est jamais retouché par un simple rechargement. Un bouton 'Redémarrer maintenant' est proposé après l'enregistrement si un service est détecté."
msgstr "पूर्ण रीस्टार्ट आवश्यक - साधारण रीलोड listen सॉकेट को कभी नहीं छूता। यदि कोई सर्विस मिलती है, तो सेव करने के बाद 'अभी रीस्टार्ट करें' बटन दिया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:46
msgid "Port (port)"
msgstr "पोर्ट (port)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:47
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:80
msgid "Port TCP d'écoute."
msgstr "Listen TCP पोर्ट।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:49
msgid "Un entier de port valide (1-65535 ; 0 signifie 'port libre choisi par le système', surtout utile pour des tests). Valeur par défaut : 8080."
msgstr "एक मान्य पोर्ट पूर्णांक (1-65535; 0 का अर्थ है 'सिस्टम द्वारा चुना गया खाली पोर्ट', मुख्यतः टेस्ट के लिए उपयोगी)। डिफ़ॉल्ट मान: 8080।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:52
msgid "Enregistre dans server.port après validation."
msgstr "जाँच के बाद server.port में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:53
msgid "Nécessite un REDÉMARRAGE COMPLET, même raison que l'adresse d'écoute."
msgstr "पूर्ण रीस्टार्ट आवश्यक, listen पते वाले कारण से ही।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:56
msgid "Nom de serveur (server_name)"
msgstr "सर्वर नाम (server_name)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:57
msgid "Nom de serveur utilisé en interne (transmis notamment à FastCGI)."
msgstr "आंतरिक रूप से उपयोग किया जाने वाला सर्वर नाम (विशेष रूप से FastCGI को भेजा जाता है)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:58
msgid "Chaîne libre, optionnelle. Vide par défaut."
msgstr "मुक्त टेक्स्ट, वैकल्पिक। डिफ़ॉल्ट रूप से खाली।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:59
msgid "Enregistre dans server.server_name."
msgstr "server.server_name में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:61
msgid "Se recharge à chaud (pas de redémarrage complet nécessaire) - mais reste sans effet tant qu'un rechargement du service en cours n'a pas eu lieu (automatique si un service actif existe, sinon à faire manuellement depuis l'écran SERVICE)."
msgstr "हॉट रीलोड होता है (पूर्ण रीस्टार्ट आवश्यक नहीं) - लेकिन चल रही सर्विस के रीलोड होने तक बेअसर रहता है (सक्रिय सर्विस होने पर स्वचालित, अन्यथा SERVICE स्क्रीन से हाथ से करें)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:67
msgid "Fichiers d'index (index_files)"
msgstr "Index फ़ाइलें (index_files)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:69
msgid "Noms de fichiers cherches, dans l'ordre, quand une URL pointe vers un répertoire sans fichier explicite."
msgstr "जब URL बिना स्पष्ट फ़ाइल के किसी डायरेक्टरी की ओर इशारा करता है, तब क्रम से खोजे जाने वाले फ़ाइल नाम।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:72
msgid "Liste séparée par des virgules. Valeur par défaut : index.html."
msgstr "कॉमा से अलग की गई सूची। डिफ़ॉल्ट मान: index.html।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:73
msgid "Enregistre dans server.index_files."
msgstr "server.index_files में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:74
msgid "Même réaction que le nom de serveur - rechargement nécessaire, jamais un redémarrage complet."
msgstr "सर्वर नाम जैसी ही प्रतिक्रिया - रीलोड आवश्यक, कभी पूर्ण रीस्टार्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:78
msgid "bind/port exigent toujours un redémarrage complet. server_name/index_files se rechargent à chaud mais nécessitent quand même un rechargement du service déjà lancé pour être pris en compte."
msgstr "bind/port के लिए हमेशा पूर्ण रीस्टार्ट आवश्यक है। server_name/index_files हॉट रीलोड होते हैं, लेकिन लागू होने के लिए पहले से चल रही सर्विस का रीलोड फिर भी आवश्यक है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:84
msgid "Changer bind/port pendant qu'un service systemd est déjà actif ne prend jamais effet tant qu'un redémarrage complet n'a pas eu lieu - toutes les connexions en cours sont alors coupées, contrairement à un simple rechargement."
msgstr "systemd सर्विस पहले से सक्रिय होने पर bind/port बदलना पूर्ण रीस्टार्ट होने तक कभी लागू नहीं होता - उस समय सभी चालू कनेक्शन कट जाते हैं, साधारण रीलोड के विपरीत।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:93
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:47
msgid "Résistance et limites"
msgstr "मज़बूती और सीमाएँ"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:94
msgid "Accueil -> Configuration détaillée -> Résistance et limites"
msgstr "होम -> विस्तृत कॉन्फ़िगरेशन -> मज़बूती और सीमाएँ"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:96
msgid "Dix réglages numériques anti-abus : bornes de taille/nombre/delai appliquées à chaque connexion et requête."
msgstr "दुरुपयोग-रोधी दस संख्यात्मक सेटिंग्स: हर कनेक्शन और अनुरोध पर लागू आकार/संख्या/समय सीमाएँ।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:101
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:30
msgid "Connexions simultanées max (max_connections)"
msgstr "अधिकतम एक साथ कनेक्शन (max_connections)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:102
msgid "Nombre maximal de connexions ouvertes en même temps."
msgstr "एक साथ खुले कनेक्शनों की अधिकतम संख्या।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:103
msgid "Entier positif. Valeur par défaut : 256."
msgstr "धनात्मक पूर्णांक। डिफ़ॉल्ट मान: 256।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:104
msgid "Enregistre dans server.max_connections."
msgstr "server.max_connections में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:105
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:233
msgid "Se recharge à chaud (rechargement du service nécessaire, automatique si actif)."
msgstr "हॉट रीलोड होता है (सर्विस रीलोड आवश्यक, सक्रिय होने पर स्वचालित)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:108
msgid "Taille max de requête (max_request_size)"
msgstr "अधिकतम अनुरोध आकार (max_request_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:109
msgid "Taille maximale acceptée pour le corps d'une requête, en octets."
msgstr "अनुरोध बॉडी का अधिकतम स्वीकार्य आकार, बाइट में।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:110
msgid "Entier positif, en octets. Valeur par défaut : 10 485 760 (10 Mio)."
msgstr "धनात्मक पूर्णांक, बाइट में। डिफ़ॉल्ट मान: 10 485 760 (10 MiB)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:111
msgid "Enregistre dans server.max_request_size."
msgstr "server.max_request_size में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:112
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:122
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:129
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:136
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:143
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:150
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:163
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:183
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:243
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:250
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:272
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:297
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:304
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:311
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:318
msgid "Se recharge à chaud."
msgstr "हॉट रीलोड होता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:115
msgid "Taille max des en-têtes (max_header_size)"
msgstr "हेडर का अधिकतम आकार (max_header_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:117
msgid "Taille cumulée maximale des en-têtes HTTP d'une requête, en octets - protection contre les en-têtes surdimensionnés (HTTP smuggling, saturation mémoire)."
msgstr "एक अनुरोध के HTTP हेडर का अधिकतम कुल आकार, बाइट में - बहुत बड़े हेडर (HTTP smuggling, मेमोरी भराव) से सुरक्षा।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:120
msgid "Entier positif, en octets. Valeur par défaut : 16 384."
msgstr "धनात्मक पूर्णांक, बाइट में। डिफ़ॉल्ट मान: 16 384।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:121
msgid "Enregistre dans server.max_header_size."
msgstr "server.max_header_size में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:125
msgid "Taille max de la ligne de requête (max_request_line_size)"
msgstr "अनुरोध पंक्ति का अधिकतम आकार (max_request_line_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:126
msgid "Taille maximale de la première ligne HTTP (méthode + chemin + version), en octets."
msgstr "पहली HTTP पंक्ति (मेथड + पाथ + संस्करण) का अधिकतम आकार, बाइट में।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:127
msgid "Entier positif, en octets. Valeur par défaut : 8 192."
msgstr "धनात्मक पूर्णांक, बाइट में। डिफ़ॉल्ट मान: 8 192।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:128
msgid "Enregistre dans server.max_request_line_size."
msgstr "server.max_request_line_size में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:132
msgid "Délai de lecture (read_timeout_seconds)"
msgstr "पढ़ने की समय सीमा (read_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:133
msgid "Délai maximal, en secondes, pour recevoir une requête complète avant coupure."
msgstr "कनेक्शन काटने से पहले पूरा अनुरोध प्राप्त करने का अधिकतम समय, सेकंड में।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:134
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:181
msgid "Entier positif, en secondes. Valeur par défaut : 10."
msgstr "धनात्मक पूर्णांक, सेकंड में। डिफ़ॉल्ट मान: 10।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:135
msgid "Enregistre dans server.read_timeout_seconds."
msgstr "server.read_timeout_seconds में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:139
msgid "Délai d'écriture (write_timeout_seconds)"
msgstr "लिखने की समय सीमा (write_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:140
msgid "Délai maximal, en secondes, pour envoyer la réponse avant coupure."
msgstr "कनेक्शन काटने से पहले रिस्पॉन्स भेजने का अधिकतम समय, सेकंड में।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:141
msgid "Entier positif, en secondes. Valeur par défaut : 15."
msgstr "धनात्मक पूर्णांक, सेकंड में। डिफ़ॉल्ट मान: 15।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:142
msgid "Enregistre dans server.write_timeout_seconds."
msgstr "server.write_timeout_seconds में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:146
msgid "Délai keep-alive (keepalive_timeout_seconds)"
msgstr "Keep-alive समय सीमा (keepalive_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:147
msgid "Délai d'inactivité, en secondes, avant fermeture d'une connexion gardée ouverte."
msgstr "खुले रखे गए कनेक्शन को बंद करने से पहले निष्क्रियता का समय, सेकंड में।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:148
msgid "Entier positif, en secondes. Valeur par défaut : 5."
msgstr "धनात्मक पूर्णांक, सेकंड में। डिफ़ॉल्ट मान: 5।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:149
msgid "Enregistre dans server.keepalive_timeout_seconds."
msgstr "server.keepalive_timeout_seconds में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:153
msgid "Requêtes max en keep-alive (max_keepalive_requests)"
msgstr "Keep-alive में अधिकतम अनुरोध (max_keepalive_requests)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:155
msgid "Nombre maximal de requêtes traitées sur une même connexion gardée ouverte. Une fois atteint, la connexion est simplement fermée et le navigateur en ouvre une nouvelle : aucune erreur, aucun bannissement. Sans rapport avec la limite de débit du WAF (Active Sécurité -> Exclusions et débit), qui compte les requêtes par IP toutes connexions confondues."
msgstr "एक ही खुले रखे गए कनेक्शन पर संभाले जाने वाले अनुरोधों की अधिकतम संख्या। यह सीमा पहुँचने पर कनेक्शन बस बंद हो जाता है और ब्राउज़र नया कनेक्शन खोल लेता है: कोई त्रुटि नहीं, कोई बैन नहीं। WAF की दर सीमा (एक्टिव सुरक्षा -> अपवाद और दर सीमा) से इसका कोई संबंध नहीं, जो सभी कनेक्शनों में प्रति IP अनुरोध गिनती है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:161
msgid "Entier positif. Valeur par défaut : 30."
msgstr "धनात्मक पूर्णांक। डिफ़ॉल्ट मान: 30।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:162
msgid "Enregistre dans server.max_keepalive_requests."
msgstr "server.max_keepalive_requests में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:166
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:38
msgid "File d'attente d'écoute (listen_backlog)"
msgstr "Listen कतार (listen_backlog)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:168
msgid "Taille de la file d'attente de connexions en attente d'acceptation par le système d'exploitation (paramètre backlog du socket d'écoute)."
msgstr "ऑपरेटिंग सिस्टम द्वारा स्वीकार किए जाने की प्रतीक्षा में कनेक्शनों की कतार का आकार (listen सॉकेट का backlog पैरामीटर)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:171
msgid "Entier positif. Valeur par défaut : 128."
msgstr "धनात्मक पूर्णांक। डिफ़ॉल्ट मान: 128।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:172
msgid "Enregistre dans server.listen_backlog."
msgstr "server.listen_backlog में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:174
msgid "Nécessite un REDÉMARRAGE COMPLET - fixé au moment de la création du socket d'écoute, comme bind/port, jamais retouché par un simple rechargement."
msgstr "पूर्ण रीस्टार्ट आवश्यक - bind/port की तरह listen सॉकेट बनाते समय तय होता है, साधारण रीलोड इसे कभी नहीं छूता।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:179
msgid "Délai de grâce à l'arrêt (shutdown_grace_period_seconds)"
msgstr "बंद करते समय छूट अवधि (shutdown_grace_period_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:180
msgid "Délai, en secondes, laissé aux connexions actives pour se terminer lors d'un arrêt."
msgstr "बंद करते समय सक्रिय कनेक्शनों को पूरा होने के लिए दिया गया समय, सेकंड में।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:182
msgid "Enregistre dans server.shutdown_grace_period_seconds."
msgstr "server.shutdown_grace_period_seconds में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:186
msgid "Nombre de workers - mode boost (workers)"
msgstr "worker की संख्या - boost मोड (workers)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:188
msgid "Nombre de processus serveur qui se partagent le port. Un processus Python n'utilise qu'un cœur : plusieurs workers servent davantage de requêtes en parallèle. Les compteurs de sécurité (rate limit, récidive) sont partagés entre workers et restent exacts ; un script magnet garde ses propres compteurs dans chaque worker."
msgstr "पोर्ट साझा करने वाली सर्वर प्रक्रियाओं की संख्या। एक Python प्रक्रिया केवल एक कोर इस्तेमाल करती है: कई worker समानांतर में ज़्यादा अनुरोध संभालते हैं। सुरक्षा काउंटर (rate limit, पुनरावृत्ति) worker के बीच साझा रहते हैं और सटीक रहते हैं; magnet स्क्रिप्ट हर worker में अपने काउंटर रखती है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:194
msgid "1 = un seul processus (par défaut, fonctionnement classique) ; 0 = automatique (un par cœur physique) ; sinon un nombre jusqu'aux CPU disponibles de cette machine, affichés sous le champ et dans le registre des capacités. Le nombre doit correspondre à la machine où omega-serv est installé : une valeur plus grande est refusée."
msgstr "1 = एक ही प्रक्रिया (डिफ़ॉल्ट, पारंपरिक तरीका); 0 = स्वचालित (हर भौतिक कोर पर एक); वरना इस मशीन के उपलब्ध CPU तक की संख्या, जो फ़ील्ड के नीचे और क्षमता रजिस्टर में दिखती है। संख्या उस मशीन से मेल खानी चाहिए जिस पर omega-serv इंस्टॉल है: बड़ी संख्या अस्वीकार की जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:199
msgid "Enregistre dans server.workers."
msgstr "server.workers में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:201
msgid "Redémarrage complet nécessaire. Si la configuration est recopiée sur une machine plus petite, le serveur se limite à ses CPU disponibles et l'écrit dans le journal."
msgstr "पूर्ण रीस्टार्ट ज़रूरी है। अगर कॉन्फ़िगरेशन किसी छोटी मशीन पर कॉपी किया जाए, तो सर्वर उसके उपलब्ध CPU तक सीमित रहता है और लॉग में लिखता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:207
msgid "Neuf champs sur onze se rechargent à chaud (rechargement du service nécessaire, automatique si actif). listen_backlog et le nombre de workers exigent un redémarrage complet."
msgstr "ग्यारह में से नौ फ़ील्ड हॉट रीलोड होते हैं (सर्विस रीलोड ज़रूरी, सक्रिय हो तो स्वचालित)। listen_backlog और worker की संख्या के लिए पूर्ण रीस्टार्ट चाहिए।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:212
msgid "Un listen_backlog trop bas sous forte charge fait échouer des connexions entrantes avant même qu'elles atteignent OMEGA-SERV (comportement du système d'exploitation) - ne descendre sous 128 qu'en connaissance de cause."
msgstr "भारी लोड में बहुत कम listen_backlog आने वाले कनेक्शनों को OMEGA-SERV तक पहुँचने से पहले ही विफल कर देता है (ऑपरेटिंग सिस्टम का व्यवहार) - 128 से नीचे केवल सोच-समझकर जाएँ।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:221
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:39
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:48
msgid "Sécurité générique"
msgstr "सामान्य सुरक्षा"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:222
msgid "Accueil -> Configuration détaillée -> Sécurité générique"
msgstr "होम -> विस्तृत कॉन्फ़िगरेशन -> सामान्य सुरक्षा"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:224
msgid "Règles de sécurité génériques appliquées à toutes les requêtes : méthodes autorisées, fichiers cachés, en-têtes de sécurité, CSP, HSTS."
msgstr "सभी अनुरोधों पर लागू सामान्य सुरक्षा नियम: अनुमत मेथड, छिपी फ़ाइलें, सुरक्षा हेडर, CSP, HSTS।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:229
msgid "Méthodes autorisées"
msgstr "अनुमत मेथड"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:230
msgid "Liste blanche des méthodes HTTP acceptées - tout le reste est refusé par défaut."
msgstr "स्वीकार किए जाने वाले HTTP मेथड की श्वेतसूची - बाकी सब डिफ़ॉल्ट रूप से अस्वीकृत।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:231
msgid "Liste séparée par des virgules, ex: GET, HEAD. Valeur par défaut : GET, HEAD."
msgstr "कॉमा से अलग की गई सूची, उदा.: GET, HEAD। डिफ़ॉल्ट मान: GET, HEAD।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:232
msgid "Enregistre dans security.allowed_methods."
msgstr "security.allowed_methods में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:236
#: src/omega_serv/interfaces/tui/screens/security_screen.py:58
msgid "Refuser les fichiers cachés (oui/non)"
msgstr "छिपी फ़ाइलें अस्वीकार करें (हाँ/नहीं)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:238
msgid "Masque tout fichier ou dossier dont un segment de chemin commence par un point (dotfile) - à la fois en accès direct et dans le directory listing."
msgstr "ऐसी हर फ़ाइल या फ़ोल्डर को छिपाता है जिसके पाथ का कोई हिस्सा बिंदु से शुरू होता है (dotfile) - सीधे एक्सेस में भी और directory listing में भी।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:241
msgid "oui ou non (accepte aussi true/1/o/y). Valeur par défaut : oui."
msgstr "हाँ या नहीं (true/1/o/y भी स्वीकार्य)। डिफ़ॉल्ट मान: हाँ।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:242
msgid "Enregistre dans security.deny_hidden_files."
msgstr "security.deny_hidden_files में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:246
msgid "Mode CSP"
msgstr "CSP मोड"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:247
msgid "Mode d'application de la Content-Security-Policy envoyée dans les réponses."
msgstr "रिस्पॉन्स में भेजी जाने वाली Content-Security-Policy का लागू करने का मोड।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:248
msgid "enforce (bloque) ou report-only (signale sans bloquer). Valeur par défaut : enforce."
msgstr "enforce (ब्लॉक करता है) या report-only (बिना ब्लॉक किए रिपोर्ट करता है)। डिफ़ॉल्ट मान: enforce।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:249
msgid "Enregistre dans security.csp_mode."
msgstr "security.csp_mode में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:253
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:255
msgid "Isolation cross-origin - 'require-corp'/'credentialless' peuvent bloquer des ressources cross-origin (polices, images, iframes tiers) que ce serveur générique ne connaît pas à l'avance, contrairement à COOP/CORP (toujours actifs, sans ce risque)."
msgstr "Cross-origin अलगाव - 'require-corp'/'credentialless' ऐसे cross-origin संसाधनों (फ़ॉन्ट, इमेज, तृतीय-पक्ष iframe) को ब्लॉक कर सकते हैं जिन्हें यह सामान्य सर्वर पहले से नहीं जानता, COOP/CORP के विपरीत (जो हमेशा सक्रिय हैं, बिना इस जोखिम के)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:261
msgid "unsafe-none (permissif, par défaut partout y compris hardened), require-corp ou credentialless - à activer uniquement en connaissance du contenu réellement servi."
msgstr "unsafe-none (ढीला, हर जगह डिफ़ॉल्ट, hardened में भी), require-corp या credentialless - केवल वास्तव में परोसी जा रही सामग्री को जानते हुए सक्षम करें।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:264
msgid "Enregistre dans security.coep_mode."
msgstr "security.coep_mode में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:265
msgid "Se recharge à chaud - toujours émis explicitement, même en unsafe-none (jamais un en-tête absent)."
msgstr "हॉट रीलोड होता है - हमेशा स्पष्ट रूप से भेजा जाता है, unsafe-none में भी (हेडर कभी अनुपस्थित नहीं)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:268
#: src/omega_serv/interfaces/tui/screens/security_screen.py:64
msgid "En-têtes de sécurité actifs (oui/non)"
msgstr "सुरक्षा हेडर सक्रिय (हाँ/नहीं)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:269
msgid "Active l'envoi des en-têtes de sécurité standard (CSP, X-Content-Type-Options...)."
msgstr "मानक सुरक्षा हेडर (CSP, X-Content-Type-Options...) भेजना सक्षम करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:270
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:309
msgid "oui ou non. Valeur par défaut : oui."
msgstr "हाँ या नहीं। डिफ़ॉल्ट मान: हाँ।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:271
msgid "Enregistre dans security.security_headers_enabled."
msgstr "security.security_headers_enabled में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:275
msgid "Zones CSP (Ajouter une zone / Retirer)"
msgstr "CSP ज़ोन (ज़ोन जोड़ें / हटाएँ)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:277
msgid "Exceptions EXPLICITES à la CSP globale, par préfixe de chemin - ex. 'unsafe-inline' uniquement sous /un-dossier/ qui en a réellement besoin, sans jamais relâcher la CSP du reste du site."
msgstr "पाथ प्रीफ़िक्स के अनुसार वैश्विक CSP के स्पष्ट अपवाद - उदा. 'unsafe-inline' केवल उस /एक-फ़ोल्डर/ के नीचे जिसे वास्तव में इसकी ज़रूरत है, बाकी साइट की CSP को कभी ढीला किए बिना।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:282
msgid "Préfixe (ex: /public-widgets/) + politique CSP COMPLÈTE pour ce préfixe (remplace entièrement le défaut pour ces chemins, jamais une fusion de directives)."
msgstr "प्रीफ़िक्स (उदा.: /public-widgets/) + इस प्रीफ़िक्स के लिए पूरी CSP नीति (इन पाथ के लिए डिफ़ॉल्ट को पूरी तरह बदल देती है, निर्देशों का विलय कभी नहीं)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:285
msgid "Enregistre immédiatement dans security.csp_zones, sans passer par Enregistrer."
msgstr "'सेव करें' के बिना तुरंत security.csp_zones में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:287
msgid "Rechargement automatique immédiat si un service actif existe. Une exception comme 'unsafe-inline' reste TOUJOURS visible dans 'omega-serv audit security' (CSP-001/CSP-002), même délibérée - jamais silencieuse."
msgstr "सक्रिय सर्विस होने पर तुरंत स्वचालित रीलोड। 'unsafe-inline' जैसा अपवाद 'omega-serv audit security' (CSP-001/CSP-002) में हमेशा दिखाई देता है, जानबूझकर किया गया हो तब भी - कभी छिपा नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:293
#: src/omega_serv/interfaces/tui/screens/security_screen.py:66
msgid "HSTS actif (oui/non)"
msgstr "HSTS सक्रिय (हाँ/नहीं)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:294
msgid "Active l'en-tête Strict-Transport-Security (force HTTPS pour les visites futures)."
msgstr "Strict-Transport-Security हेडर सक्षम करता है (भविष्य की विज़िट के लिए HTTPS अनिवार्य)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:295
msgid "oui ou non. Valeur par défaut : non. N'a de sens que si TLS est réellement actif."
msgstr "हाँ या नहीं। डिफ़ॉल्ट मान: नहीं। केवल तभी सार्थक जब TLS वास्तव में सक्रिय हो।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:296
msgid "Enregistre dans security.hsts_enabled."
msgstr "security.hsts_enabled में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:300
msgid "HSTS max-age"
msgstr "HSTS max-age"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:301
msgid "Durée, en secondes, pendant laquelle un navigateur retient l'obligation HTTPS."
msgstr "वह अवधि, सेकंड में, जिसके दौरान ब्राउज़र HTTPS की अनिवार्यता याद रखता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:302
msgid "Entier positif, en secondes. Valeur par défaut : 31 536 000 (un an)."
msgstr "धनात्मक पूर्णांक, सेकंड में। डिफ़ॉल्ट मान: 31 536 000 (एक वर्ष)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:303
msgid "Enregistre dans security.hsts_max_age."
msgstr "security.hsts_max_age में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:307
#: src/omega_serv/interfaces/tui/screens/security_screen.py:70
msgid "HSTS includeSubDomains (oui/non)"
msgstr "HSTS includeSubDomains (हाँ/नहीं)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:308
msgid "Étend l'obligation HTTPS à tous les sous-domaines."
msgstr "HTTPS की अनिवार्यता सभी सबडोमेन पर लागू करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:310
msgid "Enregistre dans security.hsts_include_subdomains."
msgstr "security.hsts_include_subdomains में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:314
#: src/omega_serv/interfaces/tui/screens/security_screen.py:72
msgid "HSTS preload (oui/non)"
msgstr "HSTS preload (हाँ/नहीं)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:315
msgid "Signale l'éligibilité à la liste de prechargement HSTS des navigateurs."
msgstr "ब्राउज़रों की HSTS preload सूची के लिए पात्रता दर्शाता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:316
#: src/omega_serv/interfaces/tui/guide/content/routage.py:31
msgid "oui ou non. Valeur par défaut : non."
msgstr "हाँ या नहीं। डिफ़ॉल्ट मान: नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:317
msgid "Enregistre dans security.hsts_preload."
msgstr "security.hsts_preload में सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:321
msgid "Tous les champs de cet écran se rechargent à chaud - aucun n'exige de redémarrage complet."
msgstr "इस स्क्रीन के सभी फ़ील्ड हॉट रीलोड होते हैं - किसी के लिए पूर्ण रीस्टार्ट आवश्यक नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:324
msgid "Activer HSTS sans que TLS soit réellement actif n'a aucun effet utile - le navigateur ignore cet en-tête reçu en HTTP simple."
msgstr "TLS वास्तव में सक्रिय हुए बिना HSTS सक्षम करने का कोई उपयोगी प्रभाव नहीं - ब्राउज़र सादे HTTP में प्राप्त इस हेडर को अनदेखा करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:332
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:40
msgid "Sécurité générique - Assistant zone CSP"
msgstr "सामान्य सुरक्षा - CSP ज़ोन विज़ार्ड"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:333
msgid "Sécurité générique -> Ajouter une zone"
msgstr "सामान्य सुरक्षा -> ज़ोन जोड़ें"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:335
msgid "Construit la politique CSP d'une zone directive par directive, chacune pré-remplie avec sa valeur ACTUELLE (la politique globale) - une zone remplace ENTIÈREMENT la politique par défaut pour son préfixe, jamais un simple ajout, d'où le pré-remplissage pour éviter de perdre des directives sans le vouloir."
msgstr "किसी ज़ोन की CSP नीति निर्देश दर निर्देश बनाता है, हर निर्देश उसके वर्तमान मान (वैश्विक नीति) से पहले से भरा होता है - ज़ोन अपने प्रीफ़िक्स के लिए डिफ़ॉल्ट नीति को पूरी तरह बदल देता है, कभी केवल जोड़ता नहीं, इसलिए पहले से भरना अनजाने में निर्देश खोने से बचाता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:342
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:83
#: src/omega_serv/interfaces/tui/screens/security_screen.py:98
msgid "Préfixe"
msgstr "प्रीफ़िक्स"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:343
msgid "Chemin URL auquel s'applique cette politique de remplacement."
msgstr "वह URL पाथ जिस पर यह प्रतिस्थापन नीति लागू होती है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:344
msgid "Doit commencer par '/', ex: /public-widgets/."
msgstr "'/' से शुरू होना चाहिए, उदा.: /public-widgets/।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:345
msgid "Utilisé au clic sur Valider."
msgstr "'पुष्टि करें' पर क्लिक करने पर उपयोग होता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:346
msgid "Aucun effet avant Valider."
msgstr "'पुष्टि करें' से पहले कोई प्रभाव नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:349
msgid "Directives (une par ligne, ex. style-src, script-src...)"
msgstr "निर्देश (प्रति पंक्ति एक, उदा. style-src, script-src...)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:350
msgid "Chaque champ contrôle une famille de ressources - l'indice sous chaque champ explique précisément laquelle."
msgstr "हर फ़ील्ड संसाधनों के एक परिवार को नियंत्रित करता है - हर फ़ील्ड के नीचे का संकेत ठीक-ठीक बताता है कि कौन सा।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:351
msgid "Pré-rempli avec la valeur actuelle - modifier uniquement ce qui doit changer, vider pour omettre la directive dans la zone."
msgstr "वर्तमान मान से पहले से भरा - केवल वही बदलें जो बदलना है, ज़ोन में निर्देश छोड़ने के लिए खाली करें।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:352
msgid "Reassemblees en une seule politique au clic sur Valider."
msgstr "'पुष्टि करें' पर क्लिक करने पर एक ही नीति में फिर से जोड़े जाते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:353
msgid "Une valeur contenant unsafe-inline/unsafe-eval/'*' déclenche une confirmation explicite supplémentaire avant d'enregistrer."
msgstr "unsafe-inline/unsafe-eval/'*' वाला मान सेव करने से पहले एक अतिरिक्त स्पष्ट पुष्टि माँगता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:357
msgid "La zone créée reste visible dans 'omega-serv audit security' (CSP-001/CSP-002 scannent aussi les zones) si elle contient une relâche - jamais silencieuse, même délibérée."
msgstr "बनाया गया ज़ोन यदि ढील रखता है तो 'omega-serv audit security' में दिखाई देता रहता है (CSP-001/CSP-002 ज़ोन भी स्कैन करते हैं) - कभी छिपा नहीं, जानबूझकर किया गया हो तब भी।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:364
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:41
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:49
msgid "Contrôle d'accès"
msgstr "एक्सेस नियंत्रण"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:365
msgid "Accueil -> Configuration détaillée -> Contrôle d'accès"
msgstr "होम -> विस्तृत कॉन्फ़िगरेशन -> एक्सेस नियंत्रण"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:367
msgid "CRUD de règles allow/deny par préfixe d'URL, avec filtre optionnel par extension - permet par exemple de bloquer des extensions sensibles partout SAUF dans une zone précise."
msgstr "URL प्रीफ़िक्स के अनुसार allow/deny नियमों का CRUD, वैकल्पिक extension फ़िल्टर के साथ - उदाहरण के लिए संवेदनशील extensions को हर जगह ब्लॉक करना, किसी एक ज़ोन को छोड़कर।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:372
#: src/omega_serv/interfaces/tui/guide/content/routage.py:15
#: src/omega_serv/interfaces/tui/guide/content/routage.py:58
#: src/omega_serv/interfaces/tui/guide/content/routage.py:354
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:127
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:60
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:110
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:81
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:63
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:112
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:172
msgid "Préfixe URL"
msgstr "URL प्रीफ़िक्स"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:373
msgid "Le préfixe de chemin auquel s'applique la règle."
msgstr "वह पाथ प्रीफ़िक्स जिस पर नियम लागू होता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:374
msgid "Doit commencer par '/', ex: /private/. Le plus long préfixe correspondant gagne."
msgstr "'/' से शुरू होना चाहिए, उदा.: /private/। मेल खाने वाला सबसे लंबा प्रीफ़िक्स जीतता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:375
msgid "Ajoute/modifie une règle via Ajouter/Modifier."
msgstr "जोड़ें/बदलें द्वारा नियम जोड़ता/बदलता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:376
#: src/omega_serv/interfaces/tui/guide/content/routage.py:19
#: src/omega_serv/interfaces/tui/guide/content/routage.py:135
#: src/omega_serv/interfaces/tui/guide/content/routage.py:220
#: src/omega_serv/interfaces/tui/guide/content/routage.py:317
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:111
msgid "Aucun effet sans rechargement du service (automatique si actif)."
msgstr "सर्विस रीलोड के बिना कोई प्रभाव नहीं (सक्रिय होने पर स्वचालित)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:379
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Verdict"
msgstr "Verdict"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:380
msgid "Ce que décide la règle pour les chemins qu'elle couvre."
msgstr "नियम अपने दायरे के पाथ के लिए क्या तय करता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:381
msgid "allow ou deny."
msgstr "allow या deny।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:382
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:392
msgid "Ajoute/modifie une règle."
msgstr "एक नियम जोड़ता/बदलता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:383
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:393
#: src/omega_serv/interfaces/tui/guide/content/routage.py:26
#: src/omega_serv/interfaces/tui/guide/content/routage.py:33
#: src/omega_serv/interfaces/tui/guide/content/routage.py:62
#: src/omega_serv/interfaces/tui/guide/content/routage.py:69
#: src/omega_serv/interfaces/tui/guide/content/routage.py:76
#: src/omega_serv/interfaces/tui/guide/content/routage.py:99
#: src/omega_serv/interfaces/tui/guide/content/routage.py:106
#: src/omega_serv/interfaces/tui/guide/content/routage.py:142
#: src/omega_serv/interfaces/tui/guide/content/routage.py:156
#: src/omega_serv/interfaces/tui/guide/content/routage.py:163
#: src/omega_serv/interfaces/tui/guide/content/routage.py:170
#: src/omega_serv/interfaces/tui/guide/content/routage.py:181
#: src/omega_serv/interfaces/tui/guide/content/routage.py:227
#: src/omega_serv/interfaces/tui/guide/content/routage.py:240
#: src/omega_serv/interfaces/tui/guide/content/routage.py:329
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:121
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:128
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:146
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:153
msgid "Aucun effet sans rechargement du service."
msgstr "सर्विस रीलोड के बिना कोई प्रभाव नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:386
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Extensions"
msgstr "Extensions"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:388
msgid "Restreint la règle aux chemins se terminant par l'une de ces extensions - vide signifie 'toutes', la règle s'applique alors à tout chemin sous ce préfixe."
msgstr "नियम को केवल इनमें से किसी extension पर समाप्त होने वाले पाथ तक सीमित करता है - खाली का अर्थ 'सभी', तब नियम इस प्रीफ़िक्स के नीचे हर पाथ पर लागू होता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:391
msgid "Liste séparée par des virgules, ex: .key, .pem. Vide par défaut (toutes)."
msgstr "कॉमा से अलग की गई सूची, उदा.: .key, .pem। डिफ़ॉल्ट रूप से खाली (सभी)।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:397
msgid "L'option access_control doit être activée (écran Options) pour que ces règles soient réellement appliquées. Toutes les modifications se rechargent à chaud."
msgstr "इन नियमों के वास्तव में लागू होने के लिए access_control विकल्प सक्षम होना चाहिए (विकल्प स्क्रीन)। सभी बदलाव हॉट रीलोड होते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:402
msgid "Le plus long préfixe correspondant gagne : une règle 'allow' plus spécifique lève le 'deny' d'un préfixe parent (ex: deny /private/, allow /private/.assets/). Une règle 'allow' explicite lève aussi les règles génériques dotfiles/motifs de l'écran Sécurité générique sur ce chemin précis."
msgstr "मेल खाने वाला सबसे लंबा प्रीफ़िक्स जीतता है: अधिक विशिष्ट 'allow' नियम पैरेंट प्रीफ़िक्स का 'deny' हटा देता है (उदा.: deny /private/, allow /private/.assets/)। स्पष्ट 'allow' नियम उस विशेष पाथ पर सामान्य सुरक्षा स्क्रीन के सामान्य dotfiles/पैटर्न नियम भी हटा देता है।"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:408
msgid "Pour bloquer une extension sensible PARTOUT sauf dans une zone : une règle deny sur '/' avec l'extension visée, puis une règle allow (sans extension) sur le préfixe à excepter - le préfixe le plus spécifique l'emporte."
msgstr "किसी संवेदनशील extension को एक ज़ोन छोड़कर हर जगह ब्लॉक करने के लिए: '/' पर उस extension के साथ deny नियम, फिर छूट वाले प्रीफ़िक्स पर allow नियम (बिना extension) - सबसे विशिष्ट प्रीफ़िक्स जीतता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:12
msgid "Accueil -> Registre des capacités"
msgstr "होम -> क्षमता रजिस्टर"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:13
msgid "Scan complet de l'environnement (port libre, openssl présent, PHP-FPM si FastCGI actif...), avec export."
msgstr "एनवायरनमेंट का पूरा स्कैन (खाली पोर्ट, openssl मौजूद, FastCGI सक्रिय होने पर PHP-FPM...), एक्सपोर्ट के साथ।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:16
#: src/omega_serv/interfaces/tui/guide/content/logs.py:436
#: src/omega_serv/interfaces/tui/screens/capabilities_screen.py:52
#: src/omega_serv/interfaces/tui/screens/export_log_archives_screen.py:43
msgid "Thème d'export HTML"
msgstr "HTML एक्सपोर्ट थीम"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "HTML एक्सपोर्ट के लिए रंग पैलेट।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:438
msgid "5 thèmes disponibles."
msgstr "5 थीम उपलब्ध।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:439
msgid "Utilisé au clic sur Exporter HTML."
msgstr "'HTML एक्सपोर्ट करें' पर क्लिक करने पर उपयोग होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/logs.py:282
#: src/omega_serv/interfaces/tui/guide/content/logs.py:440
msgid "Aucun effet sur le serveur."
msgstr "सर्वर पर कोई प्रभाव नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "रीफ़्रेश / JSON एक्सपोर्ट करें / HTML एक्सपोर्ट करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "स्कैन फिर से चलाता है, या उसका परिणाम एक्सपोर्ट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:445
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:222
msgid "Aucune saisie supplémentaire."
msgstr "कोई अतिरिक्त इनपुट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr "रीफ़्रेश स्कैन फिर से चलाता है; एक्सपोर्ट समय-चिह्नित फ़ाइल लिखते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid "Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "सर्वर या उसके कॉन्फ़िगरेशन पर कोई प्रभाव नहीं (केवल पढ़ना + एक्सपोर्ट)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "केवल देखने/एक्सपोर्ट के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "क्षमता का विवरण"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "क्षमता रजिस्टर -> किसी पंक्ति पर क्लिक"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid "Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : statut, raison, détails techniques, date du dernier scan."
msgstr "पहले से स्कैन की गई क्षमता का पूरा विवरण (कभी नया स्कैन नहीं): स्थिति, कारण, तकनीकी विवरण, अंतिम स्कैन की तारीख।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:190
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:301
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:456
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:171
msgid "Purement consultatif."
msgstr "केवल देखने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "होम -> प्रोफ़ाइल"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid "Liste et décrit les 4 profils de base preconfigures (minimal/standard/hardened/development)."
msgstr "4 पूर्व-कॉन्फ़िगर आधार प्रोफ़ाइल (minimal/standard/hardened/development) सूचीबद्ध करता है और उनका वर्णन करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:49
#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:45
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:39
msgid "Appliquer"
msgstr "लागू करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "चुनी गई प्रोफ़ाइल लागू करने की पुष्टि स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Sélectionner un profil active ce bouton."
msgstr "प्रोफ़ाइल चुनने पर यह बटन सक्रिय होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Ouvre ApplyProfileScreen."
msgstr "ApplyProfileScreen खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Aucun effet ici - voir la fiche d'ApplyProfileScreen."
msgstr "यहाँ कोई प्रभाव नहीं - ApplyProfileScreen का विवरण देखें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:56
msgid "Purement consultatif - aucune modification depuis cet écran lui-même."
msgstr "केवल देखने के लिए - यह स्क्रीन स्वयं कुछ नहीं बदलती।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "प्रोफ़ाइल लागू करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Profils -> Appliquer"
msgstr "प्रोफ़ाइल -> लागू करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid "Affiche TOUJOURS la différence complète avant toute confirmation, puis écrase la configuration active avec le profil choisi."
msgstr "किसी भी पुष्टि से पहले हमेशा पूरा अंतर दिखाता है, फिर चुनी गई प्रोफ़ाइल से सक्रिय कॉन्फ़िगरेशन ओवरराइट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Confirme et écrit le profil choisi."
msgstr "चुनी गई प्रोफ़ाइल की पुष्टि करता है और लिखता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid "Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "पूरा diff ऊपर पहले से दिखाया गया है - क्लिक करने से पहले जाँचें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid "Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr "प्रोफ़ाइल से बने कॉन्फ़िगरेशन से config/omega-serve.json ओवरराइट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:71
msgid "Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire ; sinon un simple rechargement suffit (automatique si un service actif existe)."
msgstr "एक प्रोफ़ाइल एक साथ कोई भी सेटिंग बदल सकती है। यदि bind/port/listen_backlog/TLS बदलते हैं, तो पूर्ण रीस्टार्ट आवश्यक है; अन्यथा साधारण रीलोड पर्याप्त है (सक्रिय सर्विस होने पर स्वचालित)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:77
msgid "Des conflits ou erreurs de validation bloquants demandent une confirmation supplémentaire explicite pour forcer quand même."
msgstr "अवरोधक टकराव या सत्यापन त्रुटियाँ होने पर फिर भी लागू करने के लिए एक अतिरिक्त स्पष्ट पुष्टि माँगी जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid "Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste de la configuration active est conservé tel quel."
msgstr "प्रोफ़ाइल केवल वही फ़ील्ड बदलती है जिन्हें वह स्पष्ट रूप से निर्दिष्ट करती है - सक्रिय कॉन्फ़िगरेशन का बाकी हिस्सा जैसा है वैसा रहता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Accueil -> Audit de sécurité"
msgstr "होम -> सुरक्षा ऑडिट"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...) - mêmes règles que l'audit CLI."
msgstr "सलाहकारी जाँचें (सर्विस, लॉग रोटेशन, WAF मोड...) - CLI ऑडिट जैसे ही नियम।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:52
msgid "Auditer"
msgstr "ऑडिट करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:91
msgid "Relance explicitement l'audit."
msgstr "ऑडिट को स्पष्ट रूप से फिर से चलाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:92
msgid "Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "कोई इनपुट नहीं - स्क्रीन खुलते ही पहला ऑडिट स्वचालित रूप से हो चुका होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "कॉन्फ़िगरेशन फिर से पढ़ता है और सभी ऑडिट नियम दोबारा गणना करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:221
msgid "Aucun effet sur le serveur (lecture seule) - notifie explicitement le résultat sur un clic explicite."
msgstr "सर्वर पर कोई प्रभाव नहीं (केवल पढ़ना) - स्पष्ट क्लिक पर परिणाम स्पष्ट रूप से सूचित करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "केवल सलाहकारी - कभी कुछ नहीं बदलता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Accueil -> Sauvegarde de configuration"
msgstr "होम -> कॉन्फ़िगरेशन बैकअप"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:104
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration - le fichier de configuration est toujours inclus, jamais chiffre par défaut."
msgstr "कॉन्फ़िगरेशन के पूर्ण बैकअप बनाएँ, सूचीबद्ध करें, रिस्टोर करें या हटाएँ - कॉन्फ़िगरेशन फ़ाइल हमेशा शामिल होती है, डिफ़ॉल्ट रूप से कभी एन्क्रिप्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:107
msgid "Inclure les règles WAF"
msgstr "WAF नियम शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "WAF नियम और ब्लॉकलिस्ट को बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
#: src/omega_serv/interfaces/tui/guide/content/divers.py:130
msgid "Case à cocher."
msgstr "चेकबॉक्स।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:110
#: src/omega_serv/interfaces/tui/guide/content/divers.py:117
#: src/omega_serv/interfaces/tui/guide/content/divers.py:124
#: src/omega_serv/interfaces/tui/guide/content/divers.py:131
msgid "Pris en compte à la création."
msgstr "बनाते समय ध्यान में लिया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:111
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "कोई तत्काल प्रभाव नहीं - केवल बनाए गए बैकअप की सामग्री।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:114
msgid "Inclure les zones d'authentification"
msgstr "प्रमाणीकरण ज़ोन शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:115
msgid "Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la sauvegarde."
msgstr "users.json/zones.json (वास्तविक गोपनीय जानकारी: पासवर्ड hash) को बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:116
#: src/omega_serv/interfaces/tui/guide/content/divers.py:123
msgid "Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "चेकबॉक्स - चुनने पर एक अतिरिक्त स्पष्ट पुष्टि माँगी जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "बैकअप में वास्तविक गोपनीय जानकारी है, कभी एन्क्रिप्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:121
msgid "Inclure les certificats"
msgstr "सर्टिफ़िकेट शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:122
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "TLS सर्टिफ़िकेट, PRIVATE KEY सहित, बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "बैकअप में वास्तविक private keys हैं, कभी एन्क्रिप्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
msgid "Inclure Active Defense"
msgstr "Active Defense शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:129
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr "Active Defense का खतरा/इंसिडेंट डेटाबेस बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:132
#: src/omega_serv/interfaces/tui/guide/content/divers.py:139
msgid "Aucun effet immédiat."
msgstr "कोई तत्काल प्रभाव नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:135
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:55
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:73
msgid "Description"
msgstr "विवरण"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "बैकअप से जुड़ा मुक्त नोट, बाद में उसे ढूँढने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:137
msgid "Texte libre, optionnel."
msgstr "मुक्त टेक्स्ट, वैकल्पिक।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:138
msgid "Enregistrée avec la sauvegarde."
msgstr "बैकअप के साथ सेव किया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:142
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:65
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "रिस्टोर करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX MÊMES EMPLACEMENTS."
msgstr "वर्तमान फ़ाइलों को चुने गए बैकअप की फ़ाइलों से ओवरराइट करता है, उन्हीं स्थानों पर।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:144
#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "एक बैकअप चुनें, फिर पुष्टि करें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:145
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "संबंधित फ़ाइलों का वास्तविक और तत्काल लेखन।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration peut écraser n'importe quel fichier (configuration, certificats TLS...), et un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr "सावधानी के तौर पर हमेशा पूर्ण रीस्टार्ट आवश्यक - रिस्टोर कोई भी फ़ाइल ओवरराइट कर सकता है (कॉन्फ़िगरेशन, TLS सर्टिफ़िकेट...), और मेमोरी में पहले से मौजूद सर्टिफ़िकेट कभी अपने आप रीलोड नहीं होता।"

