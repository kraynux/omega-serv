"tls.protocols min/max_version invalide (attendu : {VALID_TLS_VERSIONS})"
msgstr "अमान्य tls.protocols min/max_version (अपेक्षित: {VALID_TLS_VERSIONS})"

#: src/omega_serv/domain/security/tls/validation.py:43
#, python-brace-format
