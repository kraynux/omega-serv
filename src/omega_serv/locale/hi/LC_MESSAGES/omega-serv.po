#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:114
#: src/omega_serv/interfaces/tui/screens/log_stats_screen.py:107
msgid "Thème d'export HTML"
msgstr "HTML एक्सपोर्ट थीम"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "HTML एक्सपोर्ट के लिए रंग पैलेट।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:523
msgid "5 thèmes disponibles."
msgstr "5 थीम उपलब्ध।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:524
msgid "Utilisé au clic sur Exporter HTML."
msgstr "'HTML एक्सपोर्ट करें' पर क्लिक करने पर उपयोग होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/divers.py:70
#: src/omega_serv/interfaces/tui/guide/content/divers.py:524
#: src/omega_serv/interfaces/tui/guide/content/logs.py:290
#: src/omega_serv/interfaces/tui/guide/content/logs.py:525
msgid "Aucun effet sur le serveur."
msgstr "सर्वर पर कोई प्रभाव नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "रीफ़्रेश / JSON एक्सपोर्ट करें / HTML एक्सपोर्ट करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "स्कैन फिर से चलाता है, या उसका परिणाम एक्सपोर्ट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:530
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:255
msgid "Aucune saisie supplémentaire."
msgstr "कोई अतिरिक्त इनपुट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr ""
"रीफ़्रेश स्कैन फिर से चलाता है; एक्सपोर्ट समय-चिह्नित फ़ाइल लिखते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid ""
"Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr ""
"सर्वर या उसके कॉन्फ़िगरेशन पर कोई प्रभाव नहीं (केवल पढ़ना + एक्सपोर्ट)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "केवल देखने/एक्सपोर्ट के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "क्षमता का विवरण"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "क्षमता रजिस्टर -> किसी पंक्ति पर क्लिक"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid ""
"Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : "
"statut, raison, détails techniques, date du dernier scan."
msgstr ""
"पहले से स्कैन की गई क्षमता का पूरा विवरण (कभी नया स्कैन नहीं): स्थिति, कारण,"
" तकनीकी विवरण, अंतिम स्कैन की तारीख।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:307
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:205
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:332
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:540
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:478
msgid "Purement consultatif."
msgstr "केवल देखने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "होम -> प्रोफ़ाइल"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid ""
"Liste les 4 profils fournis (minimal/standard/hardened/development) et vos "
"profils personnalisés (colonne Type), avec leur libellé."
msgstr ""
"4 दी गई प्रोफ़ाइल (minimal/standard/hardened/development) और आपकी कस्टम "
"प्रोफ़ाइल (प्रकार कॉलम) उनके लेबल के साथ सूचीबद्ध करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
#: src/omega_serv/interfaces/tui/guide/content/divers.py:123
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:42
msgid "Appliquer"
msgstr "लागू करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "चुनी गई प्रोफ़ाइल लागू करने की पुष्टि स्क्रीन खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Sélectionner un profil active ce bouton."
msgstr "प्रोफ़ाइल चुनने पर यह बटन सक्रिय होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Ouvre ApplyProfileScreen."
msgstr "ApplyProfileScreen खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:54
msgid ""
"Un profil personnalisé ne fixe que la sécurité et l'état des options : "
"adresse, port, TLS, chemins, journaux et réglages des options (zones, "
"listes) restent ceux de l'instance."
msgstr ""
"कस्टम प्रोफ़ाइल केवल सुरक्षा और विकल्पों की स्थिति तय करती है: पता, पोर्ट, "
"TLS, पाथ, लॉग और विकल्पों की सेटिंग्स (ज़ोन, सूचियाँ) इंस्टेंस की ही रहती "
"हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:58
#: src/omega_serv/interfaces/tui/guide/content/divers.py:78
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:44
msgid "Créer un profil personnalisé"
msgstr "कस्टम प्रोफ़ाइल बनाएँ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:59
msgid ""
"Ouvre l'assistant. Si un profil personnalisé est sélectionné, l'assistant "
"repart de ses choix (un profil personnalisé ne se modifie pas : on en recrée"
" un)."
msgstr ""
"विज़ार्ड खोलता है। यदि कोई कस्टम प्रोफ़ाइल चुनी गई है, तो विज़ार्ड उसके "
"विकल्पों से शुरू होता है (कस्टम प्रोफ़ाइल बदली नहीं जाती: नई बनाई जाती है)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
msgid "Aucune limite de nombre : un seul profil est appliqué à la fois."
msgstr "संख्या की कोई सीमा नहीं: एक समय में केवल एक प्रोफ़ाइल लागू होती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid ""
"Enregistre config/profiles/custom/<nom>.json ; la configuration n'est pas "
"touchée."
msgstr ""
"config/profiles/custom/<नाम>.json सेव करता है; कॉन्फ़िगरेशन को छुआ नहीं "
"जाता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid ""
"Compris dans toute sauvegarde de configuration et repris lors d'une mise à "
"jour."
msgstr "हर कॉन्फ़िगरेशन बैकअप में शामिल और अपडेट के दौरान बनी रहती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/guide/content/divers.py:297
#: src/omega_serv/interfaces/tui/guide/content/logs.py:88
#: src/omega_serv/interfaces/tui/guide/content/logs.py:139
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:72
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:89
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:55
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:76
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:86
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:91
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:104
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:51
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:46
#: src/omega_serv/interfaces/tui/screens/purge_log_archives_screen.py:38
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:58
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:77
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:184
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:63
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:56
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:71
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:65
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:93
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:195
msgid "Supprimer"
msgstr "हटाएँ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Supprime le profil personnalisé sélectionné, après confirmation."
msgstr "पुष्टि के बाद चुनी गई कस्टम प्रोफ़ाइल हटाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid "Grisé pour les profils fournis."
msgstr "दी गई प्रोफ़ाइल के लिए धूसर।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid "Efface son fichier ; la configuration actuelle n'est pas modifiée."
msgstr "उसकी फ़ाइल मिटाता है; मौजूदा कॉन्फ़िगरेशन नहीं बदलता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:73
msgid "Aucune modification de la configuration depuis cet écran lui-même."
msgstr "यह स्क्रीन स्वयं कॉन्फ़िगरेशन में कोई बदलाव नहीं करती।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid "Accueil -> Profils -> Créer un profil personnalisé"
msgstr "होम -> प्रोफ़ाइल -> कस्टम प्रोफ़ाइल बनाएँ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:80
msgid ""
"Assistant guidé : on part d'un serveur web minimal sans protection et on "
"choisit chaque réglage dans une liste. Ce que le cœur HTTP impose (analyse "
"stricte, confinement au webroot, rejet de la traversée, normalisation, HSTS "
"jamais sans TLS) reste toujours actif et n'est pas proposé."
msgstr ""
"मार्गदर्शित विज़ार्ड: बिना सुरक्षा वाले न्यूनतम वेब सर्वर से शुरू करके हर "
"सेटिंग सूची से चुनी जाती है। HTTP कोर जो अनिवार्य करता है (सख्त विश्लेषण, "
"webroot तक सीमित रखना, ट्रैवर्सल अस्वीकार करना, सामान्यीकरण, TLS के बिना कभी"
" HSTS नहीं) वह हमेशा सक्रिय रहता है और विकल्प के रूप में नहीं दिखता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:85
msgid "Nom, libellé, description"
msgstr "नाम, लेबल, विवरण"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Identification du profil, relue par le tableau de bord."
msgstr "प्रोफ़ाइल की पहचान, जिसे डैशबोर्ड पढ़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid ""
"Nom : 3 à 32 caractères a-z, 0-9, « - », « _ » (nom du fichier), jamais "
"celui d'un autre profil. Libellé : 3 à 40 caractères imprimables. "
"Description : 200 au plus."
msgstr ""
"नाम: 3 से 32 अक्षर a-z, 0-9, “-”, “_” (फ़ाइल का नाम), कभी किसी दूसरी "
"प्रोफ़ाइल का नाम नहीं। लेबल: 3 से 40 प्रिंट होने योग्य अक्षर। विवरण: अधिकतम "
"200।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:89
msgid ""
"Vérifiés à chaque frappe ; l'erreur s'affiche sous le champ, rien n'est "
"effacé."
msgstr ""
"हर कीस्ट्रोक पर जाँचे जाते हैं; त्रुटि फ़ील्ड के नीचे दिखती है, कुछ भी "
"मिटाया नहीं जाता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
msgid "Enregistrer reste grisé tant qu'un champ est faux."
msgstr "जब तक कोई फ़ील्ड गलत है, सेव करें धूसर रहता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Choix"
msgstr "विकल्प"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
msgid ""
"En-têtes de sécurité, CSP, fichiers cachés, Host, méthodes HTTP, WAF, "
"authentification, directory listing, FastCGI, cache, proxy de confiance, "
"contrôle d'accès, reverse proxy."
msgstr ""
"सुरक्षा हेडर, CSP, छिपी फ़ाइलें, Host, HTTP मेथड, WAF, प्रमाणीकरण, directory"
" listing, FastCGI, कैश, विश्वसनीय प्रॉक्सी, एक्सेस नियंत्रण, रिवर्स "
"प्रॉक्सी।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:96
msgid "Listes déroulantes uniquement : aucune valeur à deviner ou à taper."
msgstr ""
"केवल ड्रॉपडाउन सूचियाँ: कोई मान अनुमान लगाने या टाइप करने की ज़रूरत नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
msgid "La vérification se met à jour à chaque changement."
msgstr "हर बदलाव पर जाँच अपडेट होती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:98
msgid ""
"Les réglages détaillés (zones, listes, règles) se font ensuite dans la "
"Configuration détaillée, comme pour tout profil."
msgstr ""
"विस्तृत सेटिंग्स (ज़ोन, सूचियाँ, नियम) बाद में विस्तृत कॉन्फ़िगरेशन में की "
"जाती हैं, किसी भी प्रोफ़ाइल की तरह।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:102
msgid "Vérification"
msgstr "जाँच"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid ""
"Les « trous » de la combinaison choisie : bloquants (ex. FastCGI sans POST) "
"ou à accepter (ex. pas d'en-têtes de sécurité, fichiers cachés servis, pas "
"de WAF), plus les contrôles de la configuration qui en résulterait."
msgstr ""
"चुने गए संयोजन की “कमियाँ”: अवरोधक (उदा. POST के बिना FastCGI) या स्वीकार "
"करने योग्य (उदा. कोई सुरक्षा हेडर नहीं, छिपी फ़ाइलें परोसी जाती हैं, कोई WAF"
" नहीं), साथ ही उससे बनने वाले कॉन्फ़िगरेशन की जाँचें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:106
msgid ""
"Un trou bloquant se corrige en changeant un choix ; chaque trou à accepter "
"est décrit, suivi de sa propre case « J'accepte ce point »."
msgstr ""
"रोकने वाली कमी कोई विकल्प बदलकर ठीक होती है; स्वीकार करने वाली हर कमी का "
"विवरण दिया जाता है, उसके बाद उसका अपना “मैं यह बिंदु स्वीकार करता/करती हूँ” "
"बॉक्स।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid ""
"Enregistrer n'est actif que sans trou bloquant et avec chaque trou accepté."
msgstr ""
"सेव करें तभी सक्रिय होता है जब कोई अवरोधक कमी न हो और हर कमी स्वीकार कर ली "
"गई हो।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
msgid "Jamais une erreur découverte après coup."
msgstr "कोई त्रुटि कभी बाद में सामने नहीं आती।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:112
msgid ""
"Enregistrer crée le profil sans l'appliquer : appliquez-le ensuite depuis "
"l'écran Profils, avec la différence complète affichée avant."
msgstr ""
"सेव करें प्रोफ़ाइल बनाता है, पर उसे लागू नहीं करता: बाद में प्रोफ़ाइल "
"स्क्रीन से लागू करें, पहले पूरा अंतर दिखाया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "प्रोफ़ाइल लागू करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:119
msgid "Profils -> Appliquer"
msgstr "प्रोफ़ाइल -> लागू करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:120
msgid ""
"Affiche TOUJOURS la différence complète avant toute confirmation, puis "
"écrase la configuration active avec le profil choisi."
msgstr ""
"किसी भी पुष्टि से पहले हमेशा पूरा अंतर दिखाता है, फिर चुनी गई प्रोफ़ाइल से "
"सक्रिय कॉन्फ़िगरेशन ओवरराइट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:124
msgid "Confirme et écrit le profil choisi."
msgstr "चुनी गई प्रोफ़ाइल की पुष्टि करता है और लिखता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid ""
"Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "पूरा diff ऊपर पहले से दिखाया गया है - क्लिक करने से पहले जाँचें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:126
msgid ""
"Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr ""
"प्रोफ़ाइल से बने कॉन्फ़िगरेशन से config/omega-serve.json ओवरराइट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
msgid ""
"Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si "
"bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire"
" ; sinon un simple rechargement suffit (automatique si un service actif "
"existe)."
msgstr ""
"एक प्रोफ़ाइल एक साथ कोई भी सेटिंग बदल सकती है। यदि "
"bind/port/listen_backlog/TLS बदलते हैं, तो पूर्ण रीस्टार्ट आवश्यक है; अन्यथा"
" साधारण रीलोड पर्याप्त है (सक्रिय सर्विस होने पर स्वचालित)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:134
msgid ""
"Des conflits ou erreurs de validation bloquants demandent une confirmation "
"supplémentaire explicite pour forcer quand même."
msgstr ""
"अवरोधक टकराव या सत्यापन त्रुटियाँ होने पर फिर भी लागू करने के लिए एक "
"अतिरिक्त स्पष्ट पुष्टि माँगी जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid ""
"Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste "
"de la configuration active est conservé tel quel."
msgstr ""
"प्रोफ़ाइल केवल वही फ़ील्ड बदलती है जिन्हें वह स्पष्ट रूप से निर्दिष्ट करती "
"है - सक्रिय कॉन्फ़िगरेशन का बाकी हिस्सा जैसा है वैसा रहता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "Accueil -> Audit de sécurité"
msgstr "होम -> सुरक्षा ऑडिट"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:144
msgid ""
"Vérifications consultatives (service, rotation des logs, mode WAF...) - "
"mêmes règles que l'audit CLI."
msgstr ""
"सलाहकारी जाँचें (सर्विस, लॉग रोटेशन, WAF मोड...) - CLI ऑडिट जैसे ही नियम।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:53
msgid "Auditer"
msgstr "ऑडिट करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:148
msgid "Relance explicitement l'audit."
msgstr "ऑडिट को स्पष्ट रूप से फिर से चलाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:149
msgid ""
"Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture "
"de l'écran."
msgstr ""
"कोई इनपुट नहीं - स्क्रीन खुलते ही पहला ऑडिट स्वचालित रूप से हो चुका होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:150
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "कॉन्फ़िगरेशन फिर से पढ़ता है और सभी ऑडिट नियम दोबारा गणना करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:151
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:539
msgid ""
"Aucun effet sur le serveur (lecture seule) - notifie explicitement le "
"résultat sur un clic explicite."
msgstr ""
"सर्वर पर कोई प्रभाव नहीं (केवल पढ़ना) - स्पष्ट क्लिक पर परिणाम स्पष्ट रूप से"
" सूचित करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:154
msgid "Fichiers sensibles sous webroot (PERM-003, PERM-004)"
msgstr "webroot के अंतर्गत संवेदनशील फ़ाइलें (PERM-003, PERM-004)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid ""
"Chaque fichier est nommé sous le constat, avec la raison (nom connu comme "
".env, ou extension comme .key) et ce qu'il contient vraiment, lu dans le "
"fichier et non deviné d'après son nom : clé privée, certificat, conteneur "
"PKCS#12, dossier, contenu présent ou fichier vide."
msgstr ""
"हर फ़ाइल का नाम निष्कर्ष के नीचे दिया जाता है, साथ में कारण (ज्ञात नाम जैसे "
".env, या extension जैसे .key) और उसमें वास्तव में क्या है, जो फ़ाइल को पढ़कर"
" पता किया जाता है, नाम से अनुमान लगाकर नहीं: निजी कुंजी, प्रमाणपत्र, PKCS#12"
" कंटेनर, फ़ोल्डर, सामग्री मौजूद या खाली फ़ाइल।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:159
msgid ""
"Un fichier qui a du contenu est critique (PERM-003). Un fichier vide, par "
"exemple un exemple posé pour l'icône du directory listing, est seulement une"
" information (PERM-004)."
msgstr ""
"जिस फ़ाइल में सामग्री है वह गंभीर है (PERM-003)। खाली फ़ाइल, जैसे directory "
"listing के आइकन के लिए रखी गई उदाहरण फ़ाइल, केवल एक सूचना है (PERM-004)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:161
msgid ""
"Dix fichiers au plus sont listés à l'écran, puis « et N autres » ; la liste "
"complète est dans « omega-serv audit security --format json »."
msgstr ""
"स्क्रीन पर अधिकतम दस फ़ाइलें दिखाई जाती हैं, फिर “और N अन्य”; पूरी सूची "
"“omega-serv audit security --format json” में है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:163
msgid ""
"Rien n'est déplacé ni supprimé : à vous de sortir ces fichiers du webroot "
"(ex. secure/)."
msgstr ""
"कुछ भी न तो स्थानांतरित किया जाता है न हटाया जाता है: इन फ़ाइलों को webroot "
"से बाहर ले जाना आपका काम है (उदा. secure/)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:166
#: src/omega_serv/interfaces/tui/guide/content/divers.py:527
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:542
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "केवल सलाहकारी - कभी कुछ नहीं बदलता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:172
msgid "Accueil -> Sauvegarde de configuration"
msgstr "होम -> कॉन्फ़िगरेशन बैकअप"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:173
msgid ""
"Créer, lister, restaurer ou supprimer des sauvegardes complètes de la "
"configuration - le fichier de configuration est toujours inclus, jamais "
"chiffre par défaut."
msgstr ""
"कॉन्फ़िगरेशन के पूर्ण बैकअप बनाएँ, सूचीबद्ध करें, रिस्टोर करें या हटाएँ - "
"कॉन्फ़िगरेशन फ़ाइल हमेशा शामिल होती है, डिफ़ॉल्ट रूप से कभी एन्क्रिप्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:176
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:57
msgid "Tout sauvegarder (configuration complète)"
msgstr "सब कुछ बैकअप करें (पूर्ण कॉन्फ़िगरेशन)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:177
msgid ""
"Coche toutes les cases : de quoi retrouver la configuration entière et ses "
"modules."
msgstr ""
"सभी चेकबॉक्स चुनता है: पूरे कॉन्फ़िगरेशन और उसके मॉड्यूल को पुनर्स्थापित "
"करने के लिए आवश्यक सब कुछ।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:178
msgid ""
"Case à cocher ; les secrets (zones Auth, clés TLS) restent confirmés à la "
"création."
msgstr ""
"चेकबॉक्स। गोपनीय जानकारी (Auth ज़ोन, TLS कुंजियाँ) बनाते समय अब भी पुष्टि "
"माँगती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:179
#: src/omega_serv/interfaces/tui/guide/content/divers.py:197
#: src/omega_serv/interfaces/tui/guide/content/divers.py:204
#: src/omega_serv/interfaces/tui/guide/content/divers.py:211
#: src/omega_serv/interfaces/tui/guide/content/divers.py:218
msgid "Pris en compte à la création."
msgstr "बनाते समय ध्यान में लिया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:180
msgid ""
"Ce qui est désigné hors du dossier omega-serv (ex. un certificat dans /etc) "
"n'est jamais archivé, et c'est indiqué après la création."
msgstr ""
"omega-serv फ़ोल्डर के बाहर की चीज़ें (जैसे /etc में प्रमाणपत्र) आर्काइव नहीं"
" होतीं और बनाने के बाद बताई जाती हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:184
msgid "RIPOSTE, pages d'erreur, préférences, bibliothèque des journaux"
msgstr "RIPOSTE, त्रुटि पृष्ठ, निजी सेटिंग्स, लॉग लाइब्रेरी"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:185
msgid ""
"Base RIPOSTE ; pages d'erreur personnalisées ; thème, langues et nom du "
"service ; favoris, sources distantes et rotations planifiées des journaux."
msgstr ""
"RIPOSTE डेटाबेस, कस्टम त्रुटि पृष्ठ, थीम/भाषा/सेवा नाम, लॉग पसंदीदा/दूरस्थ "
"स्रोत/निर्धारित रोटेशन।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:187
msgid ""
"Cases à cocher. Les règles WAF comprennent aussi les listes de mots-clés et "
"les scripts Magnet."
msgstr ""
"चेकबॉक्स। WAF नियमों में कीवर्ड सूचियाँ और Magnet स्क्रिप्ट भी शामिल हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:188
msgid ""
"Pris en compte à la création ; les bases (Active Defense, RIPOSTE) sont "
"copiées de façon cohérente, serveur en marche."
msgstr ""
"बनाते समय लागू। डेटाबेस (Active Defense, RIPOSTE) सर्वर चलते समय भी सुसंगत "
"रूप से कॉपी होते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:190
msgid ""
"Une sauvegarde qui contient une base n'est jamais restaurée sous un serveur "
"actif : « Arrêter, restaurer, redémarrer » est proposé, et les bases "
"actuelles sont mises de côté."
msgstr ""
"डेटाबेस वाला बैकअप सर्वर चलते समय कभी पुनर्स्थापित नहीं होता: 'रोकें, "
"पुनर्स्थापित करें और फिर शुरू करें' सुझाया जाता है और वर्तमान डेटाबेस अलग "
"रखे जाते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:194
msgid "Inclure les règles WAF"
msgstr "WAF नियम शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:195
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "WAF नियम और ब्लॉकलिस्ट को बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:196
#: src/omega_serv/interfaces/tui/guide/content/divers.py:217
msgid "Case à cocher."
msgstr "चेकबॉक्स।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:198
#: src/omega_serv/interfaces/tui/guide/content/divers.py:250
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "कोई तत्काल प्रभाव नहीं - केवल बनाए गए बैकअप की सामग्री।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:201
msgid "Inclure les zones d'authentification"
msgstr "प्रमाणीकरण ज़ोन शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:202
msgid ""
"Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la "
"sauvegarde."
msgstr ""
"users.json/zones.json (वास्तविक गोपनीय जानकारी: पासवर्ड hash) को बैकअप में "
"जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:203
#: src/omega_serv/interfaces/tui/guide/content/divers.py:210
msgid ""
"Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "चेकबॉक्स - चुनने पर एक अतिरिक्त स्पष्ट पुष्टि माँगी जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:205
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "बैकअप में वास्तविक गोपनीय जानकारी है, कभी एन्क्रिप्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:208
msgid "Inclure les certificats"
msgstr "सर्टिफ़िकेट शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:209
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "TLS सर्टिफ़िकेट, PRIVATE KEY सहित, बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:212
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "बैकअप में वास्तविक private keys हैं, कभी एन्क्रिप्ट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:215
msgid "Inclure Active Defense"
msgstr "Active Defense शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:216
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr "Active Defense का खतरा/इंसिडेंट डेटाबेस बैकअप में जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:219
#: src/omega_serv/interfaces/tui/guide/content/divers.py:278
msgid "Aucun effet immédiat."
msgstr "कोई तत्काल प्रभाव नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:222
msgid "Inclure le contenu du site (webroot)"
msgstr "साइट की सामग्री (webroot) शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:223
msgid ""
"Ajoute tout le dossier du site (pages, images, fichiers), en plus de la "
"configuration."
msgstr ""
"कॉन्फ़िगरेशन के अलावा साइट का पूरा फ़ोल्डर (पेज, चित्र, फ़ाइलें) जोड़ता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:224
msgid ""
"Case à cocher, jamais comprise dans « Tout sauvegarder » : ce n'est pas de "
"la configuration, et un gros site rend la sauvegarde longue et lourde."
msgstr ""
"चेकबॉक्स, “सब कुछ बैकअप करें” में कभी शामिल नहीं: यह कॉन्फ़िगरेशन नहीं है, "
"और बड़ी साइट बैकअप को लंबा और भारी बना देती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:226
msgid ""
"La liste affiche un indicateur d'attente pendant la création ; l'écran reste"
" utilisable."
msgstr ""
"बनाते समय सूची में प्रतीक्षा संकेतक दिखता है; स्क्रीन उपयोग योग्य रहती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:227
msgid ""
"La configuration, elle, contient déjà tout ce qui a été saisi à la main "
"(alias, rewrites, redirections, directory listing, cache, reverse proxy et "
"ses zones)."
msgstr ""
"कॉन्फ़िगरेशन में पहले से ही हाथ से दर्ज किया गया सब कुछ होता है (alias, "
"rewrites, रीडायरेक्ट, directory listing, कैश, रिवर्स प्रॉक्सी और उसके ज़ोन)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:231
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:71
msgid "Inclure les données des zones personnalisées"
msgstr "कस्टम ज़ोन का डेटा शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:232
msgid ""
"Ajoute les dossiers vers lesquels pointent les zones : cible des alias, "
"dossiers du listing (avec leurs fichiers HEADER et README), scripts FastCGI "
"(hors du site par construction). Les réglages de toutes les zones sont déjà "
"dans la configuration."
msgstr ""
"वे फ़ोल्डर जोड़ता है जिनकी ओर ज़ोन इशारा करते हैं: alias के लक्ष्य, listing "
"के फ़ोल्डर (उनकी HEADER और README फ़ाइलों के साथ), FastCGI स्क्रिप्टें "
"(बनावट से ही साइट के बाहर)। सभी ज़ोन की सेटिंग्स पहले से कॉन्फ़िगरेशन में "
"हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:235
msgid ""
"Case à cocher, jamais comprise dans « Tout sauvegarder ». Rewrites, "
"redirections et cache n'ont que des réglages ; le cache du reverse proxy se "
"reconstruit et n'est jamais sauvegardé."
msgstr ""
"चेकबॉक्स, “सब कुछ बैकअप करें” में कभी शामिल नहीं। Rewrites, रीडायरेक्ट और "
"कैश में केवल सेटिंग्स होती हैं; रिवर्स प्रॉक्सी का कैश दोबारा बन जाता है और "
"कभी बैकअप नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:237
msgid ""
"Un dossier déjà couvert par le contenu du site n'est archivé qu'une fois. "
"Une cible hors du dossier omega-serv (alias vers /srv/..., par exemple) est "
"signalée après la création, pas sauvegardée."
msgstr ""
"साइट की सामग्री में पहले से आया फ़ोल्डर केवल एक बार आर्काइव होता है। omega-"
"serv फ़ोल्डर के बाहर का लक्ष्य (उदाहरण के लिए /srv/... की ओर alias) बनाने के"
" बाद बताया जाता है, बैकअप नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:240
msgid ""
"À l'import, ces dossiers sont acceptés seulement si la configuration de "
"l'archive les désigne, jamais un emplacement de l'installation (src, tools, "
"native...)."
msgstr ""
"इम्पोर्ट के समय ये फ़ोल्डर केवल तभी स्वीकार होते हैं जब आर्काइव का "
"कॉन्फ़िगरेशन इन्हें बताता हो, इंस्टॉलेशन की कोई जगह कभी नहीं (src, tools, "
"native...)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:244
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:76
msgid "Inclure les rapports d'export"
msgstr "एक्सपोर्ट रिपोर्टें शामिल करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:245
msgid ""
"Ajoute le dossier des exports (rapports HTML, TXT, JSON, IoC...) : celui "
"choisi dans Réglages, var/exports par défaut."
msgstr ""
"एक्सपोर्ट फ़ोल्डर जोड़ता है (HTML, TXT, JSON, IoC रिपोर्टें...): सेटिंग्स "
"में चुना गया, डिफ़ॉल्ट रूप से var/exports।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:247
msgid ""
"Case à cocher, jamais comprise dans « Tout sauvegarder » : ce sont des "
"documents produits, pas de la configuration."
msgstr ""
"चेकबॉक्स, “सब कुछ बैकअप करें” में कभी शामिल नहीं: ये बनाए गए दस्तावेज़ हैं, "
"कॉन्फ़िगरेशन नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:249
msgid ""
"Un dossier d'export hors du dossier omega-serv est signalé, pas sauvegardé."
msgstr ""
"omega-serv फ़ोल्डर के बाहर का एक्सपोर्ट फ़ोल्डर बताया जाता है, बैकअप नहीं "
"होता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:253
#: src/omega_serv/interfaces/tui/guide/content/divers.py:518
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:89
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:92
#: src/omega_serv/interfaces/tui/screens/full_report_screen.py:68
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:62
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:49
msgid "Exporter"
msgstr "एक्सपोर्ट"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:254
msgid ""
"Copie la sauvegarde SÉLECTIONNÉE hors du dossier omega-serv, avec son "
"empreinte .sha256."
msgstr ""
"चुने गए बैकअप को उसके .sha256 चेकसम के साथ omega-serv फ़ोल्डर के बाहर कॉपी "
"करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:255
msgid ""
"Dossier de destination (votre dossier personnel par défaut). Un fichier déjà"
" présent n'est jamais écrasé ; l'archive est lisible par vous seul (elle "
"peut contenir des secrets)."
msgstr ""
"गंतव्य फ़ोल्डर (डिफ़ॉल्ट रूप से आपका होम फ़ोल्डर)। पहले से मौजूद फ़ाइल कभी "
"ओवरराइट नहीं होती; आर्काइव केवल आप पढ़ सकते हैं (इसमें गोपनीय जानकारी हो "
"सकती है)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:257
msgid "Écrit omega-serv-<instance>-<id>.tar.gz et le fichier .sha256 à côté."
msgstr ""
"omega-serv-<instance>-<id>.tar.gz और उसके बगल में .sha256 फ़ाइल लिखता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:258
msgid ""
"Une sauvegarde exportée survit à la désinstallation d'omega-serv (le dossier"
" var/backups est supprimé avec l'instance)."
msgstr ""
"एक्सपोर्ट किया गया बैकअप omega-serv अनइंस्टॉल होने के बाद भी बचा रहता है "
"(var/backups फ़ोल्डर इंस्टेंस के साथ हटा दिया जाता है)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:262
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:83
msgid "Importer une sauvegarde"
msgstr "बैकअप इम्पोर्ट करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:263
msgid ""
"Ajoute à la liste une sauvegarde exportée, par exemple sur une installation "
"neuve."
msgstr ""
"एक्सपोर्ट किया गया बैकअप सूची में जोड़ता है, उदाहरण के लिए नई इंस्टॉलेशन पर।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:264
msgid ""
"Chemin de l'archive ; son fichier .sha256 doit être à côté. Refusée si "
"l'empreinte est absente ou fausse, si l'archive contient un chemin absolu, «"
" .. », un lien ou un emplacement qu'une sauvegarde omega-serv ne contient "
"pas, ou si elle n'a pas de config/omega-serve.json."
msgstr ""
"आर्काइव का पाथ; उसकी .sha256 फ़ाइल बगल में होनी चाहिए। अस्वीकृत होता है यदि "
"चेकसम मौजूद नहीं या गलत है, यदि आर्काइव में एब्सोल्यूट पाथ, “..”, लिंक या "
"ऐसा स्थान है जो omega-serv बैकअप में नहीं होता, या यदि उसमें config/omega-"
"serve.json नहीं है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:268
msgid "Copie l'archive vérifiée dans la liste ; rien n'est encore restauré."
msgstr ""
"जाँचे गए आर्काइव को सूची में कॉपी करता है; अभी कुछ भी रिस्टोर नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:269
msgid ""
"La restauration reste une étape à part, confirmée : la fenêtre signale une "
"version d'omega-serv différente et un conflit de port avec une autre "
"instance (on peut alors garder l'adresse, le port et le nom de service de "
"l'instance actuelle)."
msgstr ""
"रिस्टोर एक अलग, पुष्टि किया जाने वाला चरण है: विंडो omega-serv के अलग "
"संस्करण और किसी दूसरे इंस्टेंस से पोर्ट टकराव की सूचना देती है (तब आप इस "
"इंस्टेंस का पता, पोर्ट और सर्विस नाम रख सकते हैं)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:274
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:77
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:100
msgid "Description"
msgstr "विवरण"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:275
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "बैकअप से जुड़ा मुक्त नोट, बाद में उसे ढूँढने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:276
msgid "Texte libre, optionnel."
msgstr "मुक्त टेक्स्ट, वैकल्पिक।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:277
msgid "Enregistrée avec la sauvegarde."
msgstr "बैकअप के साथ सेव किया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:281
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:87
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "रिस्टोर करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:282
msgid ""
"Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX "
"MÊMES EMPLACEMENTS."
msgstr ""
"वर्तमान फ़ाइलों को चुने गए बैकअप की फ़ाइलों से ओवरराइट करता है, उन्हीं "
"स्थानों पर।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:283
#: src/omega_serv/interfaces/tui/guide/content/divers.py:299
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "एक बैकअप चुनें, फिर पुष्टि करें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:284
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "संबंधित फ़ाइलों का वास्तविक और तत्काल लेखन।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:286
msgid ""
"Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration "
"peut écraser n'importe quel fichier (configuration, certificats TLS...), et "
"un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr ""
"सावधानी के तौर पर हमेशा पूर्ण रीस्टार्ट आवश्यक - रिस्टोर कोई भी फ़ाइल "
"ओवरराइट कर सकता है (कॉन्फ़िगरेशन, TLS सर्टिफ़िकेट...), और मेमोरी में पहले से"
" मौजूद सर्टिफ़िकेट कभी अपने आप रीलोड नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:290
msgid ""
"Après la restauration, les dossiers des zones actives qui manquent sur le "
"disque (cible d'un alias, dossier d'un listing, scripts d'une zone FastCGI) "
"sont listés sous la liste des sauvegardes : un alias ou un listing absent "
"répond 404, une zone FastCGI active sans dossier empêche le serveur de "
"démarrer."
msgstr ""
"पुनर्स्थापना के बाद, डिस्क पर न मिलने वाले सक्रिय ज़ोन के फ़ोल्डर (उपनाम का "
"लक्ष्य, सूची का फ़ोल्डर, FastCGI ज़ोन की स्क्रिप्ट) बैकअप सूची के नीचे दिखाए"
" जाते हैं: अनुपस्थित उपनाम या सूची 404 देती है, बिना फ़ोल्डर वाला सक्रिय "
"FastCGI ज़ोन सर्वर को शुरू होने से रोकता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:298
msgid ""
"Supprime définitivement une sauvegarde (n'existe pas côté CLI, confort TUI "
"uniquement)."
msgstr ""
"किसी बैकअप को स्थायी रूप से हटाता है (CLI में मौजूद नहीं, केवल TUI सुविधा)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:300
msgid "Suppression immédiate et définitive."
msgstr "तत्काल और स्थायी रूप से हटाना।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:301
msgid ""
"Aucun effet sur le serveur - seulement sur les sauvegardes disponibles."
msgstr "सर्वर पर कोई प्रभाव नहीं - केवल उपलब्ध बैकअप पर।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:304
msgid ""
"Restaurer écrase directement les fichiers vises, sans filet - la seule "
"protection est la confirmation demandée avant."
msgstr ""
"रिस्टोर लक्षित फ़ाइलों को बिना किसी सुरक्षा जाल के सीधे ओवरराइट करता है - "
"एकमात्र सुरक्षा पहले माँगी गई पुष्टि है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:309
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:122
msgid "Réglages de l'application"
msgstr "एप्लिकेशन सेटिंग्स"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:310
msgid "Raccourci clavier 'o' (footer), depuis n'importe quel écran"
msgstr "कीबोर्ड शॉर्टकट 'o' (footer), किसी भी स्क्रीन से"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:312
msgid ""
"PRÉFÉRENCES D'INTERFACE uniquement (thème, rendu, chemins d'export/captures)"
" - PAS des réglages du serveur (ceux-là vivent dans Configuration "
"détaillée)."
msgstr ""
"केवल इंटरफ़ेस प्राथमिकताएँ (थीम, रेंडरिंग, एक्सपोर्ट/स्क्रीनशॉट पाथ) - सर्वर"
" सेटिंग्स नहीं (वे विस्तृत कॉन्फ़िगरेशन में हैं)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:318
msgid "Thème visuel de l'interface elle-même."
msgstr "इंटरफ़ेस की अपनी दृश्य थीम।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:319
msgid "Un des thèmes disponibles."
msgstr "उपलब्ध थीम में से एक।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:320
msgid "Appliqué immédiatement au changement."
msgstr "बदलते ही तुरंत लागू।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:321
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "तत्काल प्रभाव, रीस्टार्ट आवश्यक नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:324
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:207
msgid "Profil de rendu"
msgstr "रेंडरिंग प्रोफ़ाइल"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:325
msgid ""
"Force un profil de rendu Textual particulier plutôt que la détection "
"automatique."
msgstr ""
"स्वचालित पहचान के बजाय कोई विशेष Textual रेंडरिंग प्रोफ़ाइल लागू करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:326
msgid "Automatique, ou un profil précis."
msgstr "स्वचालित, या कोई विशेष प्रोफ़ाइल।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:327
msgid "Enregistre la préférence."
msgstr "प्राथमिकता सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:328
msgid ""
"Appliqué seulement AU PROCHAIN DÉMARRAGE de l'interface, jamais à chaud."
msgstr "केवल इंटरफ़ेस के अगली बार शुरू होने पर लागू, कभी हॉट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:333
msgid ""
"Langue de l'interface. Chaque langue est écrite dans sa propre langue, "
"Français toujours en tête ; le libellé 'Langue / Language' n'est jamais "
"traduit, pour être retrouvé même dans une langue qu'on ne lit pas. Une "
"langue non encore validée porte la mention 'en test'."
msgstr ""
"इंटरफ़ेस की भाषा। हर भाषा अपनी ही भाषा में लिखी है, फ़्रेंच हमेशा सबसे ऊपर; "
"'Langue / Language' लेबल का कभी अनुवाद नहीं होता, ताकि वह उस भाषा में भी मिल"
" जाए जिसे आप नहीं पढ़ते। जिस भाषा की अभी पुष्टि नहीं हुई है उस पर 'परीक्षण "
"में' लिखा होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:338
msgid ""
"Choisir une langue dans la liste, puis confirmer le redémarrage de "
"l'interface."
msgstr "सूची में से एक भाषा चुनें, फिर इंटरफ़ेस रीस्टार्ट की पुष्टि करें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:340
msgid ""
"Enregistre la langue puis redémarre L'INTERFACE (pas le service : le serveur"
" continue de tourner). Un écran de confirmation affiche la langue et la "
"phrase d'invite déjà traduite."
msgstr ""
"भाषा सेव करता है और फिर इंटरफ़ेस रीस्टार्ट करता है (सर्विस नहीं: सर्वर चलता "
"रहता है)। पुष्टि स्क्रीन भाषा और पहले से अनुवादित संकेत वाक्य दिखाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:344
msgid ""
"Retour au français toujours possible : ce même réglage ; ou lancer une fois "
"'OMEGA_SERV_LANG=fr serv' ; ou retirer la clé 'language' de "
"var/settings.json. Langue indisponible ou catalogue illisible : l'interface "
"démarre en français avec un message. Les journaux du serveur (journalctl) "
"restent toujours en français."
msgstr ""
"फ़्रेंच पर लौटना हमेशा संभव: यही सेटिंग; या एक बार 'OMEGA_SERV_LANG=fr serv'"
" चलाएँ; या var/settings.json से 'language' key हटाएँ। भाषा उपलब्ध न हो या "
"कैटलॉग पढ़ा न जा सके: इंटरफ़ेस एक संदेश के साथ फ़्रेंच में शुरू होता है। "
"सर्वर लॉग (journalctl) हमेशा फ़्रेंच में रहते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:351
msgid "Export / Captures d'écran (chemins)"
msgstr "एक्सपोर्ट / स्क्रीनशॉट (पाथ)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:352
msgid "Répertoires où sont écrits les exports et les captures d'écran."
msgstr "वे डायरेक्टरी जहाँ एक्सपोर्ट और स्क्रीनशॉट लिखे जाते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:353
msgid "Chemin libre - vide revient au répertoire par défaut."
msgstr "मुक्त पाथ - खाली करने पर डिफ़ॉल्ट डायरेक्टरी पर लौटता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:354
msgid "Enregistre à chaque changement de texte."
msgstr "हर टेक्स्ट बदलाव पर सेव करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:355
msgid "Effet immédiat sur les prochains exports/captures."
msgstr "अगले एक्सपोर्ट/स्क्रीनशॉट पर तत्काल प्रभाव।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:358
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:105
msgid "Langue des exports"
msgstr "एक्सपोर्ट की भाषा"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:360
msgid ""
"Langue des exports HTML (registre des capacités, archives de logs, guide "
"d'aide) et du rapport d'incident Markdown - un fichier qui se diffuse, pas "
"forcément à quelqu'un qui lit la langue de l'interface. Les exports JSON et "
"CSV n'ont pas de texte à traduire."
msgstr ""
"HTML एक्सपोर्ट (क्षमता रजिस्टर, लॉग आर्काइव, सहायता गाइड) और Markdown "
"इंसिडेंट रिपोर्ट की भाषा - यह फ़ाइल आगे भेजी जाती है, ज़रूरी नहीं कि उसे "
"इंटरफ़ेस की भाषा पढ़ने वाला ही मिले। JSON और CSV एक्सपोर्ट में अनुवाद के लिए"
" कोई टेक्स्ट नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:364
msgid "« Comme l'interface » (défaut) ou une des langues de la liste."
msgstr "« इंटरफ़ेस जैसी » (डिफ़ॉल्ट) या सूची की कोई भाषा।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:366
msgid ""
"Enregistre immédiatement. Dans une autre langue que l'interface, chaque "
"export est produit par un processus séparé lancé dans cette langue : "
"quelques secondes, l'interface reste utilisable."
msgstr ""
"तुरंत सहेजा जाता है। इंटरफ़ेस से अलग भाषा होने पर हर एक्सपोर्ट उस भाषा में "
"शुरू की गई एक अलग प्रोसेस बनाती है: कुछ सेकंड लगते हैं, इंटरफ़ेस इस्तेमाल "
"होता रहता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:371
msgid ""
"Si ce processus échoue, l'export HTML n'est pas écrit (raison affichée) ; le"
" rapport d'incident, lui, est quand même écrit dans la langue de "
"l'interface, avec un avertissement."
msgstr ""
"अगर वह प्रोसेस विफल हो, तो HTML एक्सपोर्ट नहीं लिखा जाता (कारण दिखाया जाता "
"है); इंसिडेंट रिपोर्ट फिर भी इंटरफ़ेस की भाषा में, चेतावनी के साथ, लिखी जाती"
" है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:376
msgid "Supprimer les exports / Supprimer les screenshots"
msgstr "एक्सपोर्ट हटाएँ / स्क्रीनशॉट हटाएँ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:377
msgid "Vide complètement le répertoire concerne."
msgstr "संबंधित डायरेक्टरी को पूरी तरह खाली करता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:378
msgid "Confirmation obligatoire."
msgstr "पुष्टि अनिवार्य।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:379
msgid ""
"Suppression immédiate et définitive de tous les fichiers du répertoire."
msgstr "डायरेक्टरी की सभी फ़ाइलों को तत्काल और स्थायी रूप से हटाना।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:380
msgid "Action irréversible."
msgstr "अपरिवर्तनीय एक्शन।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:383
msgid ""
"Ne touche jamais config/omega-serve.json - réglages purement locaux à cette "
"interface."
msgstr ""
"config/omega-serve.json को कभी नहीं छूता - केवल इस इंटरफ़ेस की लोकल "
"सेटिंग्स।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:388
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:123
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:69
msgid "Contact et support"
msgstr "संपर्क और सहायता"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:389
msgid "Guide d'aide (touche a) -> Contact et support"
msgstr "सहायता गाइड (कुंजी a) -> संपर्क और सहायता"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:390
msgid ""
"Payer un café au développeur, se déclarer utilisateur anonyme d'omega-serv, "
"contacter le support, ou vérifier si une nouvelle version est publiée. Les "
"adresses sont toujours affichées en clair."
msgstr ""
"डेवलपर को कॉफ़ी पिलाएँ, omega-serv के अनाम उपयोगकर्ता के रूप में पंजीकरण "
"करें, सहायता से संपर्क करें, या जाँचें कि कोई नया संस्करण प्रकाशित हुआ है या"
" नहीं। पते हमेशा पूरे दिखाए जाते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:395
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:49
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:53
msgid "Payer un café"
msgstr "एक कॉफ़ी पिलाएँ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:396
msgid "Ouvre la page PayPal du développeur (https://paypal.me/kraynux)."
msgstr "डेवलपर का PayPal पेज (https://paypal.me/kraynux) खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:397
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:466
#: src/omega_serv/interfaces/tui/guide/content/tls.py:27
#: src/omega_serv/interfaces/tui/guide/content/tls.py:52
#: src/omega_serv/interfaces/tui/guide/content/tls.py:252
msgid "Aucune saisie."
msgstr "कोई इनपुट नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:398
msgid ""
"Ouvre l'adresse dans votre navigateur, même si l'interface tourne sous sudo."
msgstr ""
"पता आपके ब्राउज़र में खोलता है, भले ही इंटरफ़ेस sudo के तहत चल रहा हो।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:399
msgid ""
"Sans session graphique (SSH, serveur), un message rappelle l'adresse à "
"ouvrir vous-même."
msgstr ""
"ग्राफ़िकल सत्र के बिना (SSH, सर्वर), एक संदेश वह पता याद दिलाता है जिसे आपको"
" स्वयं खोलना है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:402
msgid "Se déclarer utilisateur (anonyme) / Modifier ma déclaration"
msgstr "उपयोगकर्ता के रूप में पंजीकरण करें (अनाम) / मेरा पंजीकरण बदलें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:403
msgid "Ouvre le formulaire de déclaration anonyme."
msgstr "अनाम पंजीकरण फ़ॉर्म खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:404
msgid "Le libellé devient « Modifier ma déclaration » une fois déclaré."
msgstr "पंजीकरण के बाद लेबल «मेरा पंजीकरण बदलें» हो जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:405
msgid "Ouvre le formulaire Se déclarer utilisateur (anonyme)."
msgstr "«उपयोगकर्ता के रूप में पंजीकरण करें (अनाम)» फ़ॉर्म खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:406
msgid "Aucun effet ici - voir la fiche du formulaire."
msgstr "यहाँ कोई प्रभाव नहीं - फ़ॉर्म का पेज देखें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:409
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:63
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:128
msgid "Ne plus me déclarer"
msgstr "अब मेरा पंजीकरण न करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:410
msgid "Retire la déclaration."
msgstr "पंजीकरण वापस लेता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:411
msgid "Actif seulement une fois déclaré ; une confirmation est demandée."
msgstr "केवल पंजीकरण के बाद सक्रिय; पुष्टि माँगी जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:412
msgid ""
"Envoie un retrait : votre entrée est supprimée du compteur, puis la clé est "
"effacée de cette installation et les envois quotidiens s'arrêtent."
msgstr ""
"वापसी भेजता है: आपकी प्रविष्टि काउंटर से हटाई जाती है, फिर इस इंस्टॉलेशन से "
"कुंजी मिटा दी जाती है और दैनिक भेजाई रुक जाती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:414
msgid ""
"Réception injoignable : la clé est quand même effacée ; l'entrée disparaît "
"seule (90 jours en envoi quotidien, 1 an en envoi unique)."
msgstr ""
"प्राप्तकर्ता तक नहीं पहुँचा जा सका: कुंजी फिर भी मिटा दी जाती है; प्रविष्टि "
"अपने आप हट जाती है (दैनिक भेजाई में 90 दिन, एक बार की भेजाई में 1 वर्ष)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:418
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:65
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:69
msgid "Contacter le support"
msgstr "सहायता से संपर्क करें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:419
msgid ""
"Ouvre le formulaire de contact du site (https://kraynux.snake-"
"mackarel.ts.net/contact/). L'adresse kraynux@proton.me est aussi affichée."
msgstr ""
"साइट का संपर्क फ़ॉर्म (https://kraynux.snake-mackarel.ts.net/contact/) खोलता"
" है। पता kraynux@proton.me भी दिखाया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:421
msgid "Aucune saisie : omega-serv n'envoie jamais de message lui-même."
msgstr "कुछ भरना नहीं: omega-serv कभी स्वयं कोई संदेश नहीं भेजता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:422
msgid "Ouvre l'adresse dans votre navigateur."
msgstr "पता आपके ब्राउज़र में खोलता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:423
msgid "Sans session graphique, recopiez l'adresse affichée."
msgstr "ग्राफ़िकल सत्र के बिना, दिखाया गया पता कॉपी करें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:426
msgid "Vérifier les mises à jour / Voir les nouveautés"
msgstr "अपडेट जाँचें / नया क्या है देखें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:427
msgid ""
"Compare la version installée (aussi affichée dans la barre de titre) à la "
"dernière version publiée : sur la Release GitHub, sinon sur le site kraynux,"
" sinon sur le site craftdark (liste sha.txt)."
msgstr ""
"इंस्टॉल संस्करण (शीर्षक पट्टी में भी दिखता है) की तुलना नवीनतम प्रकाशित "
"संस्करण से करता है: GitHub Release पर, नहीं तो kraynux साइट पर, नहीं तो "
"craftdark साइट पर (sha.txt सूची)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:430
msgid ""
"Seulement sur votre clic : aucune vérification automatique, rien n'est "
"envoyé. Même vérification en ligne de commande : omega-serv version --check."
msgstr ""
"केवल आपके क्लिक करने पर: कोई स्वचालित जाँच नहीं, कुछ भी भेजा नहीं जाता। "
"कमांड लाइन में वही जाँच: omega-serv version --check।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:432
msgid ""
"Affiche « à jour », la nouvelle version avec l'adresse de son archive, ou "
"une version en cours plus récente que la dernière publiée."
msgstr ""
"«अद्यतन है» दिखाता है, या नया संस्करण उसके आर्काइव के पते के साथ, या "
"प्रकाशित नवीनतम संस्करण से नया विकासाधीन संस्करण।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:434
msgid ""
"Si une version plus récente existe, « Voir les nouveautés » ouvre son résumé"
" dans votre navigateur. Rien n'est installé : la mise à jour se fait comme "
"décrit dans le README."
msgstr ""
"यदि नया संस्करण मौजूद है, तो «नया क्या है देखें» उसका सार आपके ब्राउज़र में "
"खोलता है। कुछ भी इंस्टॉल नहीं होता: अपडेट README में बताए अनुसार किया जाता "
"है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:438
msgid ""
"Rien n'est envoyé sans un clic explicite sur Envoyer (formulaire de "
"déclaration) ou sur Ne plus me déclarer."
msgstr ""
"भेजें (पंजीकरण फ़ॉर्म) या अब मेरा पंजीकरण न करें पर स्पष्ट क्लिक के बिना कुछ"
" नहीं भेजा जाता।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:444
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:124
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:55
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:61
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:96
msgid "Se déclarer utilisateur (anonyme)"
msgstr "उपयोगकर्ता के रूप में पंजीकरण करें (अनाम)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:445
msgid "Contact et support -> Se déclarer utilisateur (anonyme)"
msgstr "संपर्क और सहायता -> उपयोगकर्ता के रूप में पंजीकरण करें (अनाम)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:446
msgid ""
"Déclaration volontaire et anonyme : elle compte les utilisateurs d'omega-"
"serv et, si vous le souhaitez, leur continent ou leur pays. Rien n'est "
"activé par défaut."
msgstr ""
"स्वैच्छिक और अनाम पंजीकरण: यह omega-serv के उपयोगकर्ताओं की गिनती करता है "
"और, यदि आप चाहें, उनके महाद्वीप या देश की। डिफ़ॉल्ट रूप से कुछ भी सक्रिय "
"नहीं है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:450
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:85
msgid "Envoi"
msgstr "भेजना"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:451
msgid "Une seule fois, ou chaque jour."
msgstr "एक बार, या हर दिन।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:452
msgid ""
"Obligatoire, aucun choix présélectionné : Envoyer reste grisé tant qu'il "
"n'est pas choisi."
msgstr "अनिवार्य, पहले से कुछ चुना नहीं: चुनने तक भेजें बटन धूसर रहता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:453
msgid ""
"Une seule fois : un envoi maintenant. Chaque jour : le service omega-serv "
"renvoie le même message au plus une fois par 24 h, ce qui permet de compter "
"les installations actives."
msgstr ""
"एक बार: अभी एक बार भेजें। हर दिन: omega-serv सेवा वही संदेश अधिकतम हर 24 "
"घंटे में एक बार दोबारा भेजती है, जिससे सक्रिय इंस्टॉलेशन गिने जा सकते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:455
msgid ""
"L'envoi quotidien tourne dans un processus à part : il ne ralentit jamais le"
" serveur, ni au démarrage ni à l'arrêt. DO_NOT_TRACK=1 dans l'environnement "
"du service le désactive."
msgstr ""
"दैनिक भेजाई एक अलग प्रक्रिया में चलती है: यह सर्वर को कभी धीमा नहीं करती, न "
"शुरू होते समय न रुकते समय। सेवा के परिवेश में DO_NOT_TRACK=1 इसे बंद कर देता"
" है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:459
msgid "Continent / Pays"
msgstr "महाद्वीप / देश"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:460
msgid ""
"Deux listes indépendantes, facultatives, chacune avec « Autre (non "
"référencé) »."
msgstr "दो स्वतंत्र, वैकल्पिक सूचियाँ, हर एक में «अन्य (सूची में नहीं)»।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:461
msgid "Laisser « Non précisé » pour ne rien envoyer de ce champ."
msgstr "इस फ़ील्ड से कुछ न भेजने के लिए «नहीं बताया» रहने दें।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:462
msgid "Ajoute le code choisi au message (EU, FR... ou autre)."
msgstr "चुना गया कोड संदेश में जोड़ता है (EU, FR... या autre)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:463
msgid "Ni ville, ni texte libre."
msgstr "न शहर, न मुक्त पाठ।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:466
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:102
msgid "Message envoyé"
msgstr "भेजा जाने वाला संदेश"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:467
msgid "Le message exact, mis à jour à chaque choix."
msgstr "सटीक संदेश, हर चुनाव पर अपडेट होता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:468
#: src/omega_serv/interfaces/tui/guide/content/divers.py:505
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:197
msgid "Lecture seule."
msgstr "केवल पढ़ने के लिए।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:469
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:45
msgid "Aucune."
msgstr "कोई नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:470
msgid ""
"Une clé tirée au hasard (32 caractères) est créée au premier envoi, sous "
"var/lib/declaration/ ; elle ne dérive ni de la machine ni de vous."
msgstr ""
"पहली भेजाई पर var/lib/declaration/ में एक यादृच्छिक कुंजी (32 अक्षर) बनती "
"है; यह न मशीन से निकाली जाती है न आपसे।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:474
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:115
msgid "Envoyer"
msgstr "भेजें"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:475
msgid "Envoie la déclaration en HTTPS vers le site du développeur."
msgstr "पंजीकरण को HTTPS से डेवलपर की साइट पर भेजता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:476
msgid "5 secondes au plus ; l'écran ne se fige pas."
msgstr "अधिकतम 5 सेकंड; स्क्रीन कभी नहीं अटकती।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:477
msgid "Succès : retour à Contact et support, état « déclaré »."
msgstr "सफलता: संपर्क और सहायता पर वापसी, स्थिति «पंजीकृत»।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:478
msgid ""
"Réception injoignable : en « une seule fois », rien n'est enregistré ; en « "
"chaque jour », l'accord est gardé et le service réessaie dans 24 h."
msgstr ""
"प्राप्तकर्ता तक नहीं पहुँचा जा सका: «एक बार» में कुछ दर्ज नहीं होता; «हर "
"दिन» में सहमति रखी जाती है और सेवा 24 घंटे में फिर कोशिश करती है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:483
msgid ""
"L'adresse IP n'est pas enregistrée dans les déclarations, mais comme pour "
"toute visite d'un site, elle passe par les contrôles de sécurité et le "
"journal technique du serveur de réception."
msgstr ""
"IP पता पंजीकरणों में दर्ज नहीं किया जाता, लेकिन किसी भी वेबसाइट पर जाने की "
"तरह यह प्राप्त करने वाले सर्वर की सुरक्षा जाँच और तकनीकी लॉग से होकर गुज़रता"
" है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:485
msgid ""
"Ligne de commande : omega-serv declaration status | declare --mode "
"unique|quotidien [--continent X] [--pays Y] --yes | withdraw."
msgstr ""
"कमांड लाइन: omega-serv declaration status | declare --mode unique|quotidien "
"[--continent X] [--pays Y] --yes | withdraw।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:493
msgid "Accueil -> Rapport complet"
msgstr "होम -> पूर्ण रिपोर्ट"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:494
msgid ""
"Ce qui est configuré et actif, d'un coup d'œil, sans passer par chaque menu "
": réglages et système, jamais le trafic des visiteurs. Aucun secret : mots "
"de passe, clés et jetons apparaissent au plus comme « défini » ou « absent "
"»."
msgstr ""
"जो कॉन्फ़िगर और सक्रिय है, एक नज़र में, हर मेन्यू में जाए बिना: सेटिंग्स और "
"सिस्टम, विज़िटरों का ट्रैफ़िक कभी नहीं। कोई गोपनीय जानकारी नहीं: पासवर्ड, "
"कुंजियाँ और टोकन अधिक से अधिक “सेट है” या “मौजूद नहीं” के रूप में दिखते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:499
msgid "Sommaire"
msgstr "सारांश"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:500
msgid ""
"Le minimum, toujours présent : identité (instance, dossier, version, profil,"
" machine), fonctionnement (service, unité, en marche, démarrage, uptime, "
"compte, processus), adresse et mode (site web, reverse proxy ou les deux), "
"moteur utilisé, TLS (expiration), options, nombres de zones, sécurité, "
"contrôles de la configuration, sauvegardes, journaux."
msgstr ""
"न्यूनतम जानकारी, हमेशा मौजूद: पहचान (इंस्टेंस, फ़ोल्डर, संस्करण, प्रोफ़ाइल, "
"मशीन), संचालन (सर्विस, यूनिट, चल रही है, स्टार्टअप, uptime, अकाउंट, "
"प्रोसेस), पता और मोड (वेबसाइट, रिवर्स प्रॉक्सी या दोनों), उपयोग किया गया "
"इंजन, TLS (समाप्ति), विकल्प, ज़ोन की संख्या, सुरक्षा, कॉन्फ़िगरेशन की "
"जाँचें, बैकअप, लॉग।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:504
msgid ""
"Actualiser relit tout ; un indicateur d'attente s'affiche pendant la "
"génération."
msgstr ""
"रीफ़्रेश सब कुछ फिर से पढ़ता है; रिपोर्ट बनते समय प्रतीक्षा संकेतक दिखता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:506
msgid "L'écran ne gèle jamais, même sur un serveur très configuré."
msgstr "स्क्रीन कभी अटकती नहीं, बहुत अधिक कॉन्फ़िगर किए गए सर्वर पर भी।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:509
#: src/omega_serv/interfaces/tui/screens/full_report_screen.py:53
msgid "Détail à inclure dans l'export"
msgstr "एक्सपोर्ट में शामिल करने के लिए विवरण"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:510
msgid ""
"Zones détaillées, reverse proxy, règles WAF, Active Defense et RIPOSTE, "
"journaux suivis, réglages de toutes les options, audit de sécurité complet."
msgstr ""
"विस्तृत ज़ोन, रिवर्स प्रॉक्सी, WAF नियम, Active Defense और RIPOSTE, ट्रैक "
"किए गए लॉग, सभी विकल्पों की सेटिंग्स, पूर्ण सुरक्षा ऑडिट।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:512
msgid ""
"Cases à cocher ; le détail ne s'affiche pas à l'écran, il va seulement dans "
"l'export."
msgstr "चेकबॉक्स; विवरण स्क्रीन पर नहीं दिखता, केवल एक्सपोर्ट में जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:513
msgid "L'audit complet peut prendre quelques secondes."
msgstr "पूर्ण ऑडिट में कुछ सेकंड लग सकते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:514
msgid ""
"Les clés qui évoquent un secret (mot de passe, jeton, clé, hachage) sont "
"remplacées par vrai ou faux."
msgstr ""
"जिन कुंजियों से किसी गोपनीय जानकारी का संकेत मिलता है (पासवर्ड, टोकन, कुंजी,"
" हैश) उन्हें true या false से बदल दिया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:519
msgid ""
"HTML dans l'un des 5 thèmes d'export, TXT, ou JSON (données brutes, "
"comparables d'une date à l'autre)."
msgstr ""
"5 एक्सपोर्ट थीम में से किसी एक में HTML, TXT, या JSON (कच्चा डेटा, एक तारीख "
"से दूसरी तारीख तक तुलना योग्य)।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:521
msgid "Choisir le format, le thème pour le HTML, puis Exporter."
msgstr "फ़ॉर्मेट चुनें, HTML के लिए थीम चुनें, फिर एक्सपोर्ट।"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:522
msgid ""
"Écrit omega-serv-rapport.<date>.<format> dans le dossier d'exports "
"(Options), dans la langue des exports."
msgstr ""
"omega-serv-rapport.<date>.<format> को एक्सपोर्ट फ़ोल्डर (विकल्प) में, "
"एक्सपोर्ट की भाषा में लिखता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:12
#: src/omega_serv/interfaces/tui/guide/content/faq.py:28
#: src/omega_serv/interfaces/tui/guide/content/faq.py:40
#: src/omega_serv/interfaces/tui/guide/content/faq.py:52
#: src/omega_serv/interfaces/tui/guide/content/faq.py:72
msgid "Redémarrage et rechargement"
msgstr "रीस्टार्ट और रीलोड"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:13
msgid ""
"J'ai active/modifie une option, mais rien ne change sur le serveur - "
"pourquoi ?"
msgstr "मैंने एक विकल्प सक्षम/बदला, लेकिन सर्वर पर कुछ नहीं बदला - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:15
msgid ""
"Le serveur tourne dans un PROCESSUS DÉJÀ LANCÉ, séparé de l'interface. "
"Écrire un changement dans le fichier de configuration ne le fait jamais "
"relire tout seul par ce processus : il faut soit le RECHARGER (SIGHUP, écran"
" SERVICE -> Recharger - léger, aucune coupure de connexion), soit le "
"REDÉMARRER COMPLÈTEMENT (coupe toutes les connexions en cours). La plupart "
"des écrans de configuration détaillée déclenchent désormais ce rechargement "
"automatiquement dès qu'un service systemd actif est détecté, et vous "
"avertissent sinon. Quelques réglages (bind/port, listen_backlog, TLS, 1ere "
"activation de fastcgi, active_defense) exigent toujours un redémarrage "
"complet - jamais un simple rechargement - car ils touchent le socket "
"d'écoute ou des composants construits une seule fois au démarrage."
msgstr ""
"सर्वर पहले से शुरू किए गए एक प्रोसेस में चलता है, जो इंटरफ़ेस से अलग है। "
"कॉन्फ़िगरेशन फ़ाइल में बदलाव लिखने से यह प्रोसेस उसे अपने आप कभी नहीं पढ़ता:"
" या तो उसे रीलोड करना होगा (SIGHUP, SERVICE स्क्रीन -> रीलोड - हल्का, कोई "
"कनेक्शन नहीं कटता), या पूर्ण रीस्टार्ट (सभी चालू कनेक्शन कट जाते हैं)। "
"अधिकांश विस्तृत कॉन्फ़िगरेशन स्क्रीन अब सक्रिय systemd सर्विस मिलते ही यह "
"रीलोड स्वचालित रूप से करती हैं, अन्यथा आपको सूचित करती हैं। कुछ सेटिंग्स "
"(bind/port, listen_backlog, TLS, fastcgi का पहला सक्षमण, active_defense) के "
"लिए हमेशा पूर्ण रीस्टार्ट आवश्यक है - कभी साधारण रीलोड नहीं - क्योंकि वे "
"listen सॉकेट या शुरुआत में केवल एक बार बनने वाले कंपोनेंट को छूती हैं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:29
msgid ""
"Après une mise à jour d'omega-serv, mes nouveaux réglages ne s'appliquent "
"pas alors que le service est « rechargé » - pourquoi ?"
msgstr ""
"omega-serv अपडेट करने के बाद सर्विस « रीलोड » होने पर भी मेरी नई सेटिंग्स "
"लागू नहीं होतीं - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:31
msgid ""
"Un rechargement ne relit que la configuration, jamais le programme déjà "
"chargé en mémoire. Si le service tournait déjà avant l'extraction de la mise"
" à jour, il exécute toujours l'ancienne version, qui ignore les réglages "
"apparus depuis. Redémarrez le service une fois après chaque mise à jour "
"(écran SERVICE -> Redémarrer). L'interface le signale : notification à "
"l'accueil, et avertissement après chaque rechargement, tant que le service "
"n'a pas été redémarré (systemd et runit)."
msgstr ""
"रीलोड केवल कॉन्फ़िगरेशन दोबारा पढ़ता है, मेमोरी में पहले से लोड प्रोग्राम "
"कभी नहीं। अगर अपडेट निकालने से पहले से सर्विस चल रही थी, तो वह अब भी पुराना "
"संस्करण चला रही है, जो बाद में आई सेटिंग्स को नहीं जानता। हर अपडेट के बाद "
"सर्विस को एक बार रीस्टार्ट करें (SERVICE स्क्रीन -> रीस्टार्ट)। जब तक सर्विस"
" रीस्टार्ट नहीं होती, इंटरफ़ेस बताता है: होम स्क्रीन पर सूचना, और हर रीलोड "
"के बाद चेतावनी (systemd और runit)।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:41
msgid ""
"Comment savoir si un changement précis a besoin d'un rechargement ou d'un "
"redémarrage complet ?"
msgstr "कैसे पता करें कि किसी बदलाव के लिए रीलोड चाहिए या पूर्ण रीस्टार्ट?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:43
msgid ""
"La réaction exacte de chaque champ est indiquée dans sa fiche du guide "
"(touche F1 depuis l'écran concerne). En règle générale : tout ce qui touche "
"le socket d'écoute (adresse, port, listen_backlog), le contexte TLS, ou un "
"composant construit une seule fois au démarrage (client FastCGI à la "
"première activation, Active Defense) exige un redémarrage complet. Tout le "
"reste se recharge à chaud."
msgstr ""
"हर फ़ील्ड की ठीक प्रतिक्रिया गाइड में उसके विवरण में दी गई है (संबंधित "
"स्क्रीन से F1)। सामान्य नियम: जो कुछ भी listen सॉकेट (पता, पोर्ट, "
"listen_backlog), TLS संदर्भ, या शुरुआत में केवल एक बार बनने वाले कंपोनेंट "
"(पहले सक्षमण पर FastCGI क्लाइंट, Active Defense) को छूता है, उसके लिए पूर्ण "
"रीस्टार्ट आवश्यक है। बाकी सब हॉट रीलोड होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:54
msgid ""
"J'ai mis à jour le code d'OMEGA-SERV (nouvelle archive, correctif appliqué) "
"mais le comportement ne change jamais, même après un rechargement (SIGHUP) -"
" pourquoi ?"
msgstr ""
"मैंने OMEGA-SERV का कोड अपडेट किया (नया आर्काइव, सुधार लागू), लेकिन व्यवहार "
"कभी नहीं बदलता, रीलोड (SIGHUP) के बाद भी - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:58
msgid ""
"Piège réel rencontré (2026-10-10, correctif du rendu du directory listing "
"sous une CSP stricte) : le rechargement à chaud (SIGHUP, écran SERVICE -> "
"Recharger) ne relit QUE la CONFIGURATION (règles WAF, zones "
"d'authentification, routage, reverse proxy) - il ne recharge JAMAIS le CODE "
"Python lui-même, qui reste celui chargé en mémoire depuis le DERNIER "
"DÉMARRAGE du processus, aussi anciens soient les fichiers sur disque. Après "
"une mise à jour du code (nouvelle archive installée, correctif appliqué), un"
" REDÉMARRAGE COMPLET est TOUJOURS nécessaire (`systemctl restart <service>`,"
" ou écran SERVICE -> Arrêter puis Démarrer) - jamais un simple rechargement,"
" même pour un changement qui semble léger. Vérifiez `systemctl status "
"<service>` : une date de démarrage ('Active: active (running) since ...') "
"plus ancienne que votre mise à jour confirme immédiatement ce diagnostic."
msgstr ""
"वास्तव में सामने आया जाल (2026-10-10, सख्त CSP के तहत directory listing "
"रेंडरिंग का सुधार): हॉट रीलोड (SIGHUP, SERVICE स्क्रीन -> रीलोड) केवल "
"कॉन्फ़िगरेशन (WAF नियम, प्रमाणीकरण ज़ोन, रूटिंग, रिवर्स प्रॉक्सी) फिर से "
"पढ़ता है - यह Python कोड को कभी रीलोड नहीं करता, जो प्रोसेस के पिछले स्टार्ट"
" के समय से मेमोरी में लोड रहता है, डिस्क पर फ़ाइलें कितनी भी नई हों। कोड "
"अपडेट के बाद (नया आर्काइव इंस्टॉल, सुधार लागू) हमेशा पूर्ण रीस्टार्ट आवश्यक "
"है (`systemctl restart <service>`, या SERVICE स्क्रीन -> रोकें फिर शुरू "
"करें) - कभी साधारण रीलोड नहीं, बदलाव छोटा लगे तब भी। `systemctl status "
"<service>` जाँचें: आपके अपडेट से पुरानी स्टार्ट तारीख ('Active: active "
"(running) since ...') इस निदान की तुरंत पुष्टि करती है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:73
msgid ""
"Le rechargement/redemarrage automatique ne s'est pas déclenché - pourquoi ?"
msgstr "स्वचालित रीलोड/रीस्टार्ट ट्रिगर नहीं हुआ - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:75
msgid ""
"Le déclenchement automatique ne fonctionne que si un gestionnaire de service"
" système (systemd/OpenRC/runit) est reconnu ET qu'un service est réellement "
"ACTIF pour ce répertoire. Si vous faites tourner le serveur via l'assistant "
"premier lancement (\"Lancer maintenant\", sans service installé), aucun "
"rechargement automatique n'est possible - relancez manuellement, ou "
"installez le service depuis l'écran SERVICE."
msgstr ""
"स्वचालित ट्रिगर तभी काम करता है जब कोई सिस्टम सर्विस मैनेजर "
"(systemd/OpenRC/runit) पहचाना गया हो और इस डायरेक्टरी के लिए कोई सर्विस "
"वास्तव में सक्रिय हो। यदि आप सर्वर को पहली बार सेटअप विज़ार्ड से चलाते हैं "
"(\"अभी शुरू करें\", बिना इंस्टॉल की गई सर्विस), तो कोई स्वचालित रीलोड संभव "
"नहीं - हाथ से फिर से चलाएँ, या SERVICE स्क्रीन से सर्विस इंस्टॉल करें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:84
#: src/omega_serv/interfaces/tui/guide/content/faq.py:95
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1195
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1209
msgid "Service système"
msgstr "सिस्टम सर्विस"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:85
msgid ""
"Juste après 'Installer l'unité', l'écran État & Ressources affiche 'Arrêté' "
"alors que le service tourne - pourquoi ?"
msgstr ""
"'यूनिट इंस्टॉल करें' के ठीक बाद स्थिति और संसाधन स्क्रीन 'रुका हुआ' दिखाती "
"है जबकि सर्विस चल रही है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:87
msgid ""
"L'installation crée un compte système dédié et ajoute votre session au "
"groupe correspondant, mais l'appartenance à un NOUVEAU groupe Unix ne "
"s'applique jamais à une session déjà ouverte (même terminal déjà lancé avant"
" l'installation). Déconnectez-vous puis reconnectez-vous UNE SEULE FOIS - "
"l'écran affichera alors l'état réel. En attendant, vérifiez via l'écran "
"SERVICE ou `systemctl status`."
msgstr ""
"इंस्टॉलेशन एक समर्पित सिस्टम अकाउंट बनाता है और आपके सेशन को संबंधित समूह "
"में जोड़ता है, लेकिन नए Unix समूह की सदस्यता पहले से खुले सेशन पर कभी लागू "
"नहीं होती (इंस्टॉलेशन से पहले खोला गया टर्मिनल भी)। केवल एक बार लॉगआउट करके "
"फिर लॉगिन करें - तब स्क्रीन वास्तविक स्थिति दिखाएगी। तब तक SERVICE स्क्रीन "
"या `systemctl status` से जाँचें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:96
msgid ""
"Le champ 'Nom du service' dans l'écran SERVICE ne correspond pas à ce que je"
" pilote ailleurs - pourquoi ?"
msgstr ""
"SERVICE स्क्रीन का 'सर्विस नाम' फ़ील्ड उससे मेल नहीं खाता जिसे मैं कहीं और "
"नियंत्रित करता हूँ - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:98
msgid ""
"Ce champ persiste une préférence d'interface, distincte de la configuration "
"serveur. Si cette instance est enregistrée en multi-instance, le nom est "
"FIGÉ (celui choisi à la création) - jamais improvisé ici. Une seule "
"interface peut déjà piloter n'importe quelle unité installée en tapant "
"simplement son nom exact, même celle d'une autre copie du projet."
msgstr ""
"यह फ़ील्ड एक इंटरफ़ेस प्राथमिकता सहेजता है, सर्वर कॉन्फ़िगरेशन से अलग। यदि "
"यह इंस्टेंस मल्टी-इंस्टेंस में दर्ज है, तो नाम तय होता है (बनाते समय चुना "
"गया) - यहाँ कभी मनमाना नहीं। एक ही इंटरफ़ेस किसी भी इंस्टॉल की गई यूनिट को "
"केवल उसका सटीक नाम लिखकर नियंत्रित कर सकता है, प्रोजेक्ट की किसी दूसरी कॉपी "
"की यूनिट को भी।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:106
#: src/omega_serv/interfaces/tui/guide/content/faq.py:118
#: src/omega_serv/interfaces/tui/guide/content/faq.py:875
#: src/omega_serv/interfaces/tui/guide/content/faq.py:900
#: src/omega_serv/interfaces/tui/guide/content/faq.py:911
#: src/omega_serv/interfaces/tui/guide/content/faq.py:927
#: src/omega_serv/interfaces/tui/guide/content/faq.py:941
#: src/omega_serv/interfaces/tui/guide/content/faq.py:960
#: src/omega_serv/interfaces/tui/guide/content/faq.py:978
#: src/omega_serv/interfaces/tui/guide/content/faq.py:993
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1008
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1029
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1047
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:143
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:80
#: src/omega_serv/interfaces/tui/screens/home.py:85
msgid "Multi-instance"
msgstr "मल्टी-इंस्टेंस"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:107
msgid ""
"Puis-je installer une seconde unité systemd qui pointe vers le même "
"répertoire, sous un autre nom ?"
msgstr ""
"क्या मैं उसी डायरेक्टरी की ओर इशारा करने वाली दूसरी systemd यूनिट किसी अन्य "
"नाम से इंस्टॉल कर सकता हूँ?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:109
msgid ""
"Non - deux garde-fous bloquent explicitement cette situation avant toute "
"écriture : une unité différente pointant déjà vers ce répertoire "
"(partagerait silencieusement var/, la configuration et le compte système "
"dédié), et un nom déjà utilisé par une unité pointant vers un AUTRE "
"répertoire (volerait ce nom, écrasant l'unité existante). Pour héberger "
"plusieurs serveurs, utilisez Multi-instance : chaque instance a son propre "
"répertoire, sa propre configuration et son propre compte système."
msgstr ""
"नहीं - कुछ भी लिखने से पहले दो सुरक्षा उपाय इस स्थिति को स्पष्ट रूप से रोकते"
" हैं: इस डायरेक्टरी की ओर पहले से इशारा करती कोई दूसरी यूनिट (जो चुपचाप "
"var/, कॉन्फ़िगरेशन और समर्पित सिस्टम अकाउंट साझा करेगी), और किसी अन्य "
"डायरेक्टरी की ओर इशारा करने वाली यूनिट द्वारा पहले से उपयोग किया गया नाम (जो"
" वह नाम छीन लेगा और मौजूदा यूनिट को ओवरराइट करेगा)। कई सर्वर होस्ट करने के "
"लिए मल्टी-इंस्टेंस का उपयोग करें: हर इंस्टेंस की अपनी डायरेक्टरी, अपना "
"कॉन्फ़िगरेशन और अपना सिस्टम अकाउंट होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:119
msgid ""
"La création d'une nouvelle instance échoue à l'étape 4/6 (Installation des "
"dépendances) - pourquoi ?"
msgstr ""
"नया इंस्टेंस बनाना चरण 4/6 (डिपेंडेंसी इंस्टॉल) पर विफल होता है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:121
msgid ""
"Piège réel corrigé : si le message d'échec mentionne 'omega-lib' et 'No "
"matching distribution found', c'était un bug de la création d'instance elle-"
"même, pas une erreur de votre part - omega-lib n'est pas publiée sur PyPI, "
"et l'ancienne version ne savait retrouver sa source réelle (vendorée ou "
"depuis un clone de développement) que dans un seul des deux cas. Corrigé : "
"la nouvelle instance réutilise désormais la même source qu'omega-lib déjà "
"installée pour l'instance en cours, quelle que soit sa provenance. Si "
"l'échec persiste malgré une version à jour, vérifiez que le réseau est "
"disponible pour les AUTRES dépendances (`textual`, `pyte`, `jinja2`, "
"`psutil`), qui viennent bien de PyPI."
msgstr ""
"सुधारा गया वास्तविक जाल: यदि विफलता संदेश में 'omega-lib' और 'No matching "
"distribution found' है, तो यह इंस्टेंस बनाने का ही एक bug था, आपकी गलती नहीं"
" - omega-lib PyPI पर प्रकाशित नहीं है, और पुराना संस्करण उसका वास्तविक स्रोत"
" (vendored या डेवलपमेंट क्लोन से) दो में से केवल एक स्थिति में ही ढूँढ पाता "
"था। सुधारा गया: नया इंस्टेंस अब वर्तमान इंस्टेंस के लिए पहले से इंस्टॉल "
"omega-lib का वही स्रोत उपयोग करता है, उसका मूल चाहे जो हो। यदि अपडेटेड "
"संस्करण के बावजूद विफलता बनी रहे, तो जाँचें कि अन्य डिपेंडेंसी (`textual`, "
"`pyte`, `jinja2`, `psutil`) के लिए नेटवर्क उपलब्ध है, जो वास्तव में PyPI से "
"आती हैं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:133
#: src/omega_serv/interfaces/tui/guide/content/faq.py:143
#: src/omega_serv/interfaces/tui/guide/content/faq.py:158
#: src/omega_serv/interfaces/tui/guide/content/faq.py:168
#: src/omega_serv/interfaces/tui/guide/content/faq.py:181
#: src/omega_serv/interfaces/tui/guide/content/faq.py:197
#: src/omega_serv/interfaces/tui/guide/content/faq.py:209
#: src/omega_serv/interfaces/tui/guide/content/faq.py:222
#: src/omega_serv/interfaces/tui/guide/content/faq.py:233
#: src/omega_serv/interfaces/tui/guide/content/faq.py:250
#: src/omega_serv/interfaces/tui/guide/content/faq.py:265
#: src/omega_serv/interfaces/tui/guide/content/faq.py:278
#: src/omega_serv/interfaces/tui/guide/content/faq.py:292
#: src/omega_serv/interfaces/tui/guide/content/faq.py:303
#: src/omega_serv/interfaces/tui/guide/content/faq.py:313
#: src/omega_serv/interfaces/tui/guide/content/faq.py:323
#: src/omega_serv/interfaces/tui/guide/content/faq.py:336
#: src/omega_serv/interfaces/tui/guide/content/faq.py:347
#: src/omega_serv/interfaces/tui/guide/content/faq.py:360
#: src/omega_serv/interfaces/tui/guide/content/faq.py:371
#: src/omega_serv/interfaces/tui/guide/content/faq.py:606
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1105
msgid "WAF/Active Defense"
msgstr "WAF/Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:134
msgid ""
"J'ai coupé le WAF : pourquoi les adresses bannies passent et la limite de "
"débit ne s'applique plus ?"
msgstr ""
"मैंने WAF बंद कर दिया: प्रतिबंधित पते क्यों निकल जाते हैं और दर सीमा अब "
"क्यों लागू नहीं होती?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:136
msgid ""
"C'est voulu : la liste de blocage (page 451) et la limite de débit (429) "
"font partie du WAF. Couper le WAF les coupe aussi, dans les deux moteurs ; "
"les bans déjà posés restent enregistrés et reprennent effet quand le WAF est"
" réactivé. Pour garder les bannissements et la limite de débit sans le "
"filtrage des attaques, laissez le WAF actif en mode log-only plutôt que de "
"le couper."
msgstr ""
"यह जानबूझकर है: ब्लॉकलिस्ट (पेज 451) और दर सीमा (429) WAF का हिस्सा हैं। WAF"
" बंद करने से ये भी बंद हो जाती हैं, दोनों इंजनों में; पहले से लगे प्रतिबंध "
"दर्ज रहते हैं और WAF फिर चालू होने पर दोबारा लागू होते हैं। हमलों की छँटाई "
"के बिना प्रतिबंध और दर सीमा रखने के लिए, WAF को बंद करने के बजाय log-only "
"मोड में चालू रखें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:144
msgid ""
"Une image ou une archive est refusée (403) par le WAF alors que le fichier "
"est sain : pourquoi ?"
msgstr ""
"फ़ाइल सही होने के बावजूद WAF किसी छवि या आर्काइव को अस्वीकार (403) कर देता "
"है: क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:146
msgid ""
"Lu comme du texte, un fichier binaire contient forcément des suites d'octets"
" qui ressemblent à une attaque (substitution de commande, injection). Depuis"
" la 3.0.0, le WAF ne lit plus comme du texte un fichier dont le format est "
"reconnu à son contenu réel - la signature de ses premiers octets, jamais son"
" extension - parmi la liste de l'écran WAF - Modules (« Fichiers binaires "
"non inspectés » : images, vidéo, son, PDF, archives). Un formulaire, du "
"JSON, du XML ou du texte reste toujours inspecté, même précédé d'une fausse "
"signature ; dans un formulaire avec fichiers, seuls les fichiers reconnus "
"sont retirés. Un fichier de format inconnu (ou un exécutable) reste inspecté"
" et peut encore être refusé : ajoutez son format à la liste s'il est connu, "
"ou excluez son chemin du WAF en dernier recours (cela retire aussi les "
"autres contrôles sur ce chemin)."
msgstr ""
"पाठ के रूप में पढ़ने पर, बाइनरी फ़ाइल में अनिवार्य रूप से ऐसे बाइट-क्रम होते"
" हैं जो हमले जैसे दिखते हैं (कमांड प्रतिस्थापन, इंजेक्शन)। 3.0.0 से, WAF ऐसी"
" फ़ाइल को पाठ के रूप में नहीं पढ़ता जिसका फ़ॉर्मेट उसकी वास्तविक सामग्री से "
"पहचाना जाता है - उसके पहले बाइट्स के हस्ताक्षर से, कभी उसके एक्सटेंशन से "
"नहीं - और जो WAF - मॉड्यूल स्क्रीन की सूची में है (« बिना जाँच वाली बाइनरी "
"फ़ाइलें »: छवियाँ, वीडियो, ऑडियो, PDF, आर्काइव)। फ़ॉर्म, JSON, XML या पाठ की"
" जाँच हमेशा होती है, भले ही उससे पहले नकली हस्ताक्षर हो; फ़ाइलों वाले फ़ॉर्म"
" में केवल पहचानी गई फ़ाइलें ही जाँच से हटाई जाती हैं। अज्ञात फ़ॉर्मेट वाली "
"फ़ाइल (या कोई एक्ज़ीक्यूटेबल) की जाँच होती रहती है और वह अब भी अस्वीकार हो "
"सकती है: अगर उसका फ़ॉर्मेट ज्ञात है तो उसे सूची में जोड़ें, या अंतिम उपाय के"
" रूप में उसके पथ को WAF से बाहर रखें (इससे उस पथ पर बाकी जाँचें भी हट जाती "
"हैं)।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:159
msgid "Le WAF est actif mais ne bloque jamais rien - pourquoi ?"
msgstr "WAF सक्रिय है लेकिन कभी कुछ ब्लॉक नहीं करता - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:161
msgid ""
"Vérifiez d'abord l'écran WAF - État : si 'Packs de règles référencés' est à "
"zéro, le WAF ne peut RIEN détecter même actif (piège réel déjà rencontré). "
"Ajoutez au moins un pack depuis WAF - Modules. Vérifiez ensuite le mode : "
"'log-only' journalise sans jamais bloquer, seul 'block' bloque réellement."
msgstr ""
"पहले WAF - स्थिति स्क्रीन जाँचें: यदि 'संदर्भित नियम पैक' शून्य है, तो WAF "
"सक्रिय होने पर भी कुछ नहीं पहचान सकता (पहले भी सामने आया वास्तविक जाल)। WAF "
"- मॉड्यूल से कम से कम एक पैक जोड़ें। फिर मोड जाँचें: 'log-only' केवल लॉग "
"करता है, कभी ब्लॉक नहीं करता; केवल 'block' वास्तव में ब्लॉक करता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:169
msgid ""
"J'ai activé l'option 'active_defense' mais rien ne se passe jamais (aucune "
"menace, aucun incident) - pourquoi ?"
msgstr ""
"मैंने 'active_defense' विकल्प सक्षम किया लेकिन कभी कुछ नहीं होता (कोई खतरा "
"नहीं, कोई इंसिडेंट नहीं) - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:171
msgid ""
"Activer l'option elle-même (menu Options) ne suffit PAS. Un second "
"interrupteur, `war_mode.enabled`, vaut FALSE par défaut - activez-le depuis "
"Active Defense -> Réglages -> 'Mode guerre actif'. Vérifiez la ligne 'Mode "
"guerre' sur l'écran Active Defense - État : si elle affiche 'inactif', c'est"
" la cause. Un REDÉMARRAGE COMPLET est ensuite nécessaire (active_defense "
"n'est jamais rechargé à chaud). Une fois actif, tout devient automatique - "
"le score de chaque source est alimenté par les décisions WAF déjà calculées "
"à chaque requête, sans aucune action manuelle."
msgstr ""
"केवल विकल्प सक्षम करना (विकल्प मेन्यू) पर्याप्त नहीं है। दूसरा स्विच, "
"`war_mode.enabled`, डिफ़ॉल्ट रूप से FALSE है - इसे Active Defense -> "
"सेटिंग्स -> 'वॉर मोड सक्रिय' से सक्षम करें। Active Defense - स्थिति स्क्रीन "
"पर 'वॉर मोड' पंक्ति जाँचें: यदि वह 'निष्क्रिय' दिखाती है, तो यही कारण है। "
"इसके बाद पूर्ण रीस्टार्ट आवश्यक है (active_defense कभी हॉट रीलोड नहीं होता)।"
" सक्रिय होने के बाद सब कुछ स्वचालित हो जाता है - हर स्रोत का स्कोर हर अनुरोध"
" पर पहले से गणना किए गए WAF निर्णयों से बनता है, बिना किसी हाथ के काम के।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:182
msgid "Active Defense en production : quelles limites connaître ?"
msgstr "प्रोडक्शन में Active Defense: कौन-सी सीमाएँ जाननी चाहिए?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:184
msgid ""
"Mesuré sur une machine à 2 cœurs : aucun coût sans attaque. Face à des "
"attaquants qui reviennent, le mode guerre les ralentit (environ 0,4 s par "
"requête) et le serveur sert même plus vite les visiteurs légitimes. Face à "
"un botnet qui change d'adresse à chaque requête, Active Defense coûte de 10 "
"à 16 % de débit. La base est bornée : au plus 200 000 sources suivies (les "
"sources « normal » les plus anciennes partent d'abord), journal d'audit "
"purgé au-delà de 30 jours et de 200 000 lignes, historique d'un incident "
"limité aux 100 premiers et aux 1 000 derniers éléments. La purge des états "
"expirés est automatique (au plus toutes les 10 minutes) ; le fichier de la "
"base ne rétrécit pas, SQLite réutilise la place libérée. Sauvegardez la base"
" avec `config backup --include-active-defense`."
msgstr ""
"2 कोर वाली मशीन पर मापा गया: हमले के बिना कोई लागत नहीं। बार-बार लौटने वाले "
"हमलावरों को वॉर मोड धीमा कर देता है (प्रति अनुरोध लगभग 0.4 सेकंड) और सर्वर "
"सामान्य आगंतुकों को और तेज़ी से सेवा देता है। हर अनुरोध पर पता बदलने वाले "
"बॉटनेट के सामने Active Defense थ्रूपुट का 10 से 16% लेता है। डेटाबेस सीमित "
"है: अधिकतम 200,000 ट्रैक किए गए स्रोत (सबसे पुराने « normal » स्रोत पहले "
"हटते हैं), ऑडिट लॉग 30 दिन और 200,000 पंक्तियों से आगे साफ़ होता है, किसी "
"इंसिडेंट का इतिहास पहले 100 और अंतिम 1,000 तत्वों तक सीमित है। समाप्त हो "
"चुकी स्थितियाँ अपने आप साफ़ होती हैं (अधिकतम हर 10 मिनट में); डेटाबेस फ़ाइल "
"छोटी नहीं होती, SQLite खाली जगह को दोबारा इस्तेमाल करता है। डेटाबेस का बैकअप"
" `config backup --include-active-defense` से लें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:198
msgid ""
"Une purge ou une sauvegarde pendant une attaque peut-elle bloquer le serveur"
" ?"
msgstr "क्या हमले के दौरान सफ़ाई या बैकअप सर्वर को रोक सकता है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:200
msgid ""
"Non : le serveur écrit dans la base d'Active Defense depuis un fil "
"d'arrière-plan, jamais pendant une requête. Si la base est verrouillée "
"(purge, sauvegarde, autre programme), les écritures attendent puis "
"reprennent seules ; error.log reçoit une ligne au début (« écriture en base "
"impossible ») et une à la fin (« rétablie »). Au-delà de 10 000 observations"
" en attente, les suivantes sont abandonnées et comptées ; les requêtes, "
"elles, sont toujours servies."
msgstr ""
"नहीं: सर्वर Active Defense डेटाबेस में बैकग्राउंड थ्रेड से लिखता है, किसी "
"अनुरोध के दौरान कभी नहीं। अगर डेटाबेस लॉक है (सफ़ाई, बैकअप, कोई और "
"प्रोग्राम), तो लेखन रुककर प्रतीक्षा करता है और फिर अपने आप चालू हो जाता है; "
"error.log में शुरुआत में एक पंक्ति (« écriture en base impossible ») और अंत "
"में एक पंक्ति (« rétablie ») आती है। 10,000 प्रतीक्षारत अवलोकनों के बाद आगे "
"वाले छोड़ दिए जाते हैं और गिने जाते हैं; अनुरोधों को हमेशा सेवा मिलती है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:210
msgid "Comment partager un incident avec MISP ou OpenCTI ?"
msgstr "किसी इंसिडेंट को MISP या OpenCTI के साथ कैसे साझा करें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:212
msgid ""
"Exportez-le au format misp ou stix (écran Incidents -> Exporter IoC, ou "
"`incidents export-ioc <id> --format stix,misp`). Dans MISP : Add Event -> "
"Populate from -> MISP JSON, puis le fichier .misp.json. Dans OpenCTI ou un "
"SIEM : importez le bundle .stix.json. Les fichiers restent sur votre "
"serveur, omega-serv n'envoie rien. Le marquage TLP se règle dans Active "
"Defense -> Réglages (amber par défaut). Seules les adresses IP sont "
"exportées ; l'adresse d'un attaquant reste une donnée personnelle : vérifiez"
" avant de partager."
msgstr ""
"उसे misp या stix फ़ॉर्मेट में एक्सपोर्ट करें (इंसिडेंट स्क्रीन -> IoC "
"एक्सपोर्ट करें, या `incidents export-ioc <id> --format stix,misp`)। MISP "
"में: Add Event -> Populate from -> MISP JSON, फिर .misp.json फ़ाइल। OpenCTI "
"या किसी SIEM में: .stix.json बंडल इम्पोर्ट करें। फ़ाइलें आपके सर्वर पर ही "
"रहती हैं, omega-serv कुछ नहीं भेजता। TLP चिह्न Active Defense -> सेटिंग्स "
"में बदला जाता है (डिफ़ॉल्ट amber)। केवल IP पते एक्सपोर्ट होते हैं; हमलावर का"
" पता भी व्यक्तिगत डेटा है: साझा करने से पहले जाँच लें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:223
msgid ""
"J'ai créé une règle WAF personnalisée mais elle ne se déclenche jamais - "
"pourquoi ?"
msgstr "मैंने एक कस्टम WAF नियम बनाया लेकिन वह कभी ट्रिगर नहीं होता - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:225
msgid ""
"Utilisez l'écran WAF - Règles personnalisées (pas 'Modules') pour CRÉER la "
"règle elle-même - il l'écrit dans custom.json ET référence automatiquement "
"ce pack. Ajouter seulement le pack custom.json comme référence depuis "
"'Modules' ne crée aucune règle si le fichier est encore vide. Utilisez "
"l'écran 'Tester une requête' pour vérifier qu'une règle se déclenche bien "
"avant de compter dessus en production."
msgstr ""
"नियम बनाने के लिए WAF - कस्टम नियम स्क्रीन का उपयोग करें ('मॉड्यूल' नहीं) - "
"यह नियम को custom.json में लिखती है और इस पैक को स्वचालित रूप से संदर्भित "
"करती है। 'मॉड्यूल' से केवल custom.json पैक को संदर्भ के रूप में जोड़ने से, "
"फ़ाइल अभी खाली होने पर, कोई नियम नहीं बनता। प्रोडक्शन में भरोसा करने से पहले"
" 'अनुरोध टेस्ट करें' स्क्रीन से जाँचें कि नियम वास्तव में ट्रिगर होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:234
msgid "Quelle classe d'attaque choisir pour un profil de leurre ?"
msgstr "डिकॉय प्रोफ़ाइल के लिए कौन सा हमला वर्ग चुनें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:236
msgid ""
"Les 8 classes possibles et ce qu'elles ciblent concrètement : scan (sondage "
"d'URLs/ports, scanners automatisés), credential_stuffing (essais massifs de "
"mots de passe sur un formulaire de login), sqli (tentative d'injection SQL),"
" xss (script injecté dans un paramètre), path_traversal (tentative de sortir"
" du dossier servi, ex : ../../etc/passwd), upload_probe (upload de fichier "
"suspect), api_probe (sondage d'endpoints /api/...), unknown (tout ce qui ne "
"correspond à aucune des catégories précédentes - un filet de sécurité "
"générique). Exemple : un profil nommé fake_admin avec les classes "
"scan,credential_stuffing attirera les scanners et les tentatives de "
"bruteforce de connexion vers une fausse page d'authentification. Plusieurs "
"classes peuvent être listées, séparées par des virgules."
msgstr ""
"8 संभावित वर्ग और वे वास्तव में किसे लक्षित करते हैं: scan (URL/पोर्ट की "
"जाँच, स्वचालित स्कैनर), credential_stuffing (लॉगिन फ़ॉर्म पर बड़े पैमाने पर "
"पासवर्ड प्रयास), sqli (SQL इंजेक्शन प्रयास), xss (पैरामीटर में इंजेक्ट की गई"
" स्क्रिप्ट), path_traversal (परोसे गए फ़ोल्डर से बाहर निकलने का प्रयास, "
"उदा.: ../../etc/passwd), upload_probe (संदिग्ध फ़ाइल अपलोड), api_probe "
"(/api/... endpoints की जाँच), unknown (जो कुछ भी पिछली किसी श्रेणी में नहीं "
"आता - सामान्य सुरक्षा जाल)। उदाहरण: scan,credential_stuffing वर्गों वाली "
"fake_admin नाम की प्रोफ़ाइल स्कैनरों और लॉगिन bruteforce प्रयासों को एक नकली"
" प्रमाणीकरण पेज की ओर ले जाएगी। कई वर्ग कॉमा से अलग करके सूचीबद्ध किए जा "
"सकते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:246
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:132
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:307
msgid ""
"Nouvelle classe (2.1) : command_injection (injection de commandes shell, ex "
": $(...), ; cat /etc/passwd). Les sondes WordPress (wp-login, xmlrpc.php) "
"sont classées scan."
msgstr ""
"नई श्रेणी (2.1): command_injection (शेल कमांड इंजेक्शन, जैसे $(...), ; cat "
"/etc/passwd)। WordPress जाँच (wp-login, xmlrpc.php) को scan में वर्गीकृत "
"किया जाता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:251
msgid "« Ajouter un profil de leurre » refuse le profil - que corriger ?"
msgstr "«डिकॉय प्रोफ़ाइल जोड़ें» प्रोफ़ाइल अस्वीकार करता है - क्या ठीक करें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:253
msgid ""
"Rien n'est enregistré tant que le profil est invalide. Le formulaire reste "
"ouvert, la raison s'affiche sous les champs et la saisie est conservée : "
"corrigez le champ indiqué, puis cliquez à nouveau sur Valider. Causes les "
"plus fréquentes : (1) Isolation = fixture avec un nom autre que fake_admin, "
"fake_cms, fake_api ou fake_secrets (en minuscules, sans espace) ; (2) classe"
" d'attaque mal écrite - valeurs exactes, séparées par des virgules : scan, "
"credential_stuffing, sqli, xss, path_traversal, upload_probe, api_probe, "
"command_injection, unknown ; (3) Isolation = proxy sans zone de leurre, ou "
"avec un nom de zone qui n'existe pas encore (créez d'abord la zone dans « "
"Zones de leurre ») ; (4) un autre réglage de l'écran est invalide (le "
"message le nomme). Le plus simple : Isolation fixture, l'un des 4 noms, zone"
" vide. Le formulaire « Ajouter une zone » fonctionne de la même façon."
msgstr ""
"जब तक प्रोफ़ाइल अमान्य है, कुछ भी सहेजा नहीं जाता। फ़ॉर्म खुला रहता है, कारण"
" फ़ील्ड के नीचे दिखता है और भरी गई जानकारी बनी रहती है: बताए गए फ़ील्ड को "
"ठीक करें, फिर दोबारा पुष्टि करें दबाएँ। सबसे आम कारण: (1) Isolation = "
"fixture के साथ ऐसा नाम जो fake_admin, fake_cms, fake_api या fake_secrets "
"नहीं है (छोटे अक्षरों में, बिना स्पेस); (2) हमले की श्रेणी गलत लिखी गई - "
"सटीक मान, कॉमा से अलग: scan, credential_stuffing, sqli, xss, path_traversal,"
" upload_probe, api_probe, command_injection, unknown; (3) Isolation = proxy "
"बिना डिकॉय ज़ोन के, या ऐसे ज़ोन नाम के साथ जो अभी मौजूद नहीं है (पहले «डिकॉय"
" ज़ोन» में ज़ोन बनाएँ); (4) स्क्रीन की कोई और सेटिंग अमान्य है (संदेश उसका "
"नाम बताता है)। सबसे आसान: Isolation fixture, 4 नामों में से एक, ज़ोन खाली। "
"«ज़ोन जोड़ें» फ़ॉर्म भी इसी तरह काम करता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:266
msgid ""
"Mon profil de leurre en isolation 'fixture' ne se déclenche jamais - "
"pourquoi ?"
msgstr ""
"'fixture' अलगाव वाली मेरी डिकॉय प्रोफ़ाइल कभी ट्रिगर नहीं होती - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:268
msgid ""
"Le NOM du profil doit correspondre EXACTEMENT à l'une des 4 fixtures "
"réellement implémentées : fake_admin, fake_cms, fake_api, fake_secrets. Tout"
" autre nom (même descriptif, ex : 'mon-leurre-perso') faisait auparavant que"
" le leurre ne se déclenchait jamais, sans aucune erreur visible - le trafic "
"suivait alors le comportement de secours (pass_through ou reject) comme si "
"aucun profil n'existait. L'écran Active Defense -> Réglages refuse désormais"
" d'enregistrer un tel nom et indique clairement le problème."
msgstr ""
"प्रोफ़ाइल का नाम वास्तव में लागू 4 fixtures में से किसी एक से ठीक-ठीक मेल "
"खाना चाहिए: fake_admin, fake_cms, fake_api, fake_secrets। पहले कोई भी अन्य "
"नाम (वर्णनात्मक भी, उदा.: 'mon-leurre-perso') डिकॉय को कभी ट्रिगर नहीं होने "
"देता था, बिना किसी दिखने वाली त्रुटि के - ट्रैफ़िक तब बैकअप व्यवहार "
"(pass_through या reject) का पालन करता था, मानो कोई प्रोफ़ाइल मौजूद ही न हो। "
"Active Defense -> सेटिंग्स स्क्रीन अब ऐसा नाम सेव करने से मना करती है और "
"समस्या स्पष्ट रूप से बताती है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:279
msgid ""
"J'ai créé une zone de leurre avec une adresse qui n'existe pas encore - que "
"se passe-t-il ?"
msgstr ""
"मैंने ऐसे पते के साथ डिकॉय ज़ोन बनाया जो अभी मौजूद नहीं है - क्या होता है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:281
msgid ""
"Rien de spécial à l'enregistrement : une zone de leurre (Niveau 2, isolation"
" 'proxy') est une simple cible réseau (host:port), jamais un dossier - "
"aucune création automatique, aucune vérification que l'adresse existe ou "
"répond au moment de la sauvegarde. La conséquence n'apparaît que lors d'une "
"VRAIE requête routée vers cette zone : si rien n'écoute à cette adresse, "
"l'attaquant reçoit simplement une erreur HTTP 502 Bad Gateway (la même "
"mécanique que le reverse proxy de production) - jamais de crash du serveur, "
"jamais de création silencieuse de quoi que ce soit."
msgstr ""
"सेव करते समय कुछ खास नहीं: डिकॉय ज़ोन (स्तर 2, 'proxy' अलगाव) केवल एक "
"नेटवर्क लक्ष्य (host:port) है, कभी फ़ोल्डर नहीं - सेव करते समय न कुछ "
"स्वचालित रूप से बनता है, न यह जाँचा जाता है कि पता मौजूद है या जवाब देता है।"
" परिणाम केवल तब दिखता है जब कोई वास्तविक अनुरोध इस ज़ोन की ओर भेजा जाता है: "
"यदि उस पते पर कुछ भी नहीं सुन रहा, तो हमलावर को बस HTTP 502 Bad Gateway "
"त्रुटि मिलती है (प्रोडक्शन रिवर्स प्रॉक्सी जैसा ही तंत्र) - सर्वर कभी क्रैश "
"नहीं होता, कुछ भी चुपचाप नहीं बनता।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:293
msgid ""
"Comment bloquer les chemins sensibles (.env, .git, sauvegardes, consoles "
"d'admin...) sans tout écrire à la main ?"
msgstr ""
"संवेदनशील पाथ (.env, .git, बैकअप, एडमिन कंसोल...) को सब कुछ हाथ से लिखे बिना"
" कैसे ब्लॉक करें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:295
msgid ""
"Active Sécurité -> Custom -> Ajouter -> 'CHARGER une liste de chemins "
"(fichier)', puis choisissez la référence livrée sensitive-paths-hostile (298"
" chemins sans usage légitime) et/ou sensitive-paths-probe (132 chemins de "
"sondage, parfois servis par un vrai site). Les réglages conseillés se "
"remplissent seuls ; gardez Observation au premier chargement. Rien n'est "
"actif avant le clic sur Charger."
msgstr ""
"एक्टिव सुरक्षा -> Custom -> जोड़ें -> 'पाथ सूची लोड करें (फ़ाइल)', फिर दी गई"
" संदर्भ सूची sensitive-paths-hostile (बिना किसी वैध उपयोग के 298 पाथ) और/या "
"sensitive-paths-probe (132 जाँच पाथ, कभी-कभी असली साइट द्वारा भी परोसे जाते "
"हैं) चुनें। अनुशंसित सेटिंग्स अपने आप भर जाती हैं; पहली बार लोड करते समय "
"निगरानी रखें। 'लोड करें' पर क्लिक करने से पहले कुछ भी सक्रिय नहीं होता।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:304
msgid "Quelle différence entre une règle personnalisée et une liste ?"
msgstr "कस्टम नियम और सूची में क्या अंतर है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:306
msgid ""
"Une règle détecte UN motif et vit dans custom.json. Une liste est un fichier"
" texte d'un chemin (ou mot-clé) par ligne, facile à maintenir à plusieurs "
"centaines d'entrées, avec ses exceptions '!/x', sa gravité et sa propre "
"récidive. Les deux apparaissent dans le même tableau de l'écran Custom, "
"colonne Type."
msgstr ""
"नियम एक पैटर्न पहचानता है और custom.json में रहता है। सूची एक टेक्स्ट फ़ाइल "
"है जिसमें प्रति पंक्ति एक पाथ (या कीवर्ड) होता है, सैकड़ों एंट्री पर भी बनाए"
" रखना आसान, अपने '!/x' अपवादों, अपनी गंभीरता और अपने दोहराव के साथ। दोनों "
"Custom स्क्रीन की एक ही तालिका में, प्रकार कॉलम में दिखते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:314
msgid ""
"J'ai chargé une liste en Observation - comment savoir ce qu'elle aurait "
"bloqué, puis l'activer ?"
msgstr ""
"मैंने एक सूची निगरानी में लोड की - कैसे जानूँ कि वह क्या ब्लॉक करती, फिर उसे"
" सक्रिय कैसे करूँ?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:316
msgid ""
"En Observation, chaque détection est écrite dans le journal d'alertes WAF, "
"sans aucun blocage ni ban. Lisez ces alertes quelques jours, utilisez "
"'Vérifier contre mes logs' dans l'éditeur pour repérer les lignes qui "
"toucheraient des requêtes légitimes (exception '!/chemin' en un clic), puis "
"Custom -> Modifier -> Gravité Élevé ou Moyen."
msgstr ""
"निगरानी में हर पहचान WAF अलर्ट लॉग में लिखी जाती है, बिना किसी ब्लॉक या बैन "
"के। कुछ दिन ये अलर्ट पढ़ें, एडिटर में 'मेरे लॉग से जाँचें' का उपयोग करके वे "
"पंक्तियाँ खोजें जो वैध अनुरोधों को प्रभावित करतीं (एक क्लिक में '!/पाथ' "
"अपवाद), फिर Custom -> बदलें -> गंभीरता उच्च या मध्यम।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:324
msgid ""
"Mes propres machines (Wi-Fi, Ethernet, Tailscale) risquent-elles d'être "
"bannies par la récidive ?"
msgstr ""
"क्या मेरी अपनी मशीनें (Wi-Fi, Ethernet, Tailscale) दोहराव के कारण बैन हो "
"सकती हैं?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:326
msgid ""
"Non : l'hôte local, le réseau Tailscale (100.64.0.0/10) et le réseau local "
"(192.168.x, 10.x, 172.16-31.x...) ne sont JAMAIS bannis automatiquement "
"(réglage options.waf.reputation.never_auto_block). Seule une adresse "
"publique peut l'être. Leurs requêtes vers un chemin dangereux restent "
"refusées (403) et journalisées, ce qui permet de tester le WAF. Derrière un "
"proxy local (tailscale serve, reverse proxy), l'exemption de 127.0.0.1 n'est"
" appliquée que si 'Proxy de confiance' est actif - sinon tout Internet "
"paraîtrait venir de 127.0.0.1."
msgstr ""
"नहीं: लोकल होस्ट, Tailscale नेटवर्क (100.64.0.0/10) और लोकल नेटवर्क "
"(192.168.x, 10.x, 172.16-31.x...) कभी स्वचालित रूप से बैन नहीं होते (सेटिंग "
"options.waf.reputation.never_auto_block)। केवल सार्वजनिक पता ही बैन हो सकता "
"है। खतरनाक पाथ पर उनके अनुरोध फिर भी अस्वीकृत (403) और लॉग होते हैं, जिससे "
"WAF की जाँच की जा सकती है। लोकल प्रॉक्सी के पीछे (tailscale serve, रिवर्स "
"प्रॉक्सी) 127.0.0.1 की छूट केवल तभी लागू होती है जब 'विश्वसनीय प्रॉक्सी' "
"सक्रिय हो - अन्यथा पूरा इंटरनेट 127.0.0.1 से आता दिखेगा।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:337
msgid ""
"Mettre mes adresses dans 'Proxy de confiance' évite-t-il qu'elles soient "
"bannies ?"
msgstr ""
"क्या अपने पते 'विश्वसनीय प्रॉक्सी' में डालने से वे बैन होने से बचते हैं?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:339
msgid ""
"Non. Les réseaux de confiance disent seulement QUI a le droit de transmettre"
" la vraie adresse du visiteur (en-tête X-Forwarded-For) - en pratique le "
"proxy place devant omega-serv (127.0.0.1 pour tailscale serve). Ils "
"n'exemptent de rien d'autre. Les réseaux à ne jamais bannir sont un réglage "
"distinct (never_auto_block). Une plage large comme 100.0.0.0/8 contient des "
"adresses publiques : préférez 100.64.0.0/10."
msgstr ""
"नहीं। विश्वसनीय नेटवर्क केवल यह बताते हैं कि आगंतुक का असली पता "
"(X-Forwarded-For हेडर) भेजने का अधिकार किसे है - व्यवहार में omega-serv के "
"आगे रखा प्रॉक्सी (tailscale serve के लिए 127.0.0.1)। वे किसी और चीज़ से छूट "
"नहीं देते। कभी बैन न होने वाले नेटवर्क एक अलग सेटिंग है (never_auto_block)। "
"100.0.0.0/8 जैसी बड़ी रेंज में सार्वजनिक पते होते हैं: 100.64.0.0/10 को "
"प्राथमिकता दें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:348
msgid "Une page lourde renvoie 429, puis mon IP est bannie - pourquoi ?"
msgstr "एक भारी पेज 429 लौटाता है, फिर मेरा IP बैन हो जाता है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:350
msgid ""
"Une page qui charge beaucoup de fichiers (une galerie d'images, par exemple)"
" dépasse la limite de débit globale du WAF (60 requêtes / 60 s par IP par "
"défaut) : le WAF répond 429, et trois rejets en 10 minutes suffisent à "
"omega-jail pour bannir une IP publique 12 h. Solution : Active Sécurité -> "
"Exclusions et débit, ajouter une règle pour le dossier concerné (ex. "
"/images/ à 600 / 60 s). Pour vos propres appareils (Tailscale, réseau "
"local), une règle IP/réseau avec « Source sûre » à oui évite tout "
"bannissement. Une exclusion d'inspection ne suffit pas : le rate limit "
"s'applique quand même."
msgstr ""
"बहुत सी फ़ाइलें लोड करने वाला पेज (जैसे इमेज गैलरी) WAF की वैश्विक दर सीमा "
"(डिफ़ॉल्ट प्रति IP 60 अनुरोध / 60 सेकंड) पार कर जाता है: WAF 429 लौटाता है, "
"और 10 मिनट में तीन अस्वीकृतियाँ omega-jail के लिए किसी सार्वजनिक IP को 12 "
"घंटे बैन करने को काफ़ी हैं। समाधान: एक्टिव सुरक्षा -> अपवाद और दर सीमा में "
"संबंधित फ़ोल्डर के लिए नियम जोड़ें (जैसे /images/ पर 600 / 60 सेकंड)। अपने "
"उपकरणों (Tailscale, लोकल नेटवर्क) के लिए « सुरक्षित स्रोत » को हाँ रखने वाला"
" IP/नेटवर्क नियम हर बैन से बचाता है। जाँच का अपवाद काफ़ी नहीं: rate limit "
"फिर भी लागू होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:361
msgid ""
"« Requêtes max par connexion keep-alive » et la limite de débit du WAF font-"
"ils double emploi ?"
msgstr ""
"क्या « प्रति keep-alive कनेक्शन अधिकतम अनुरोध » और WAF की दर सीमा एक ही काम "
"करते हैं?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:363
msgid ""
"Non, ils ne se chevauchent pas. « Requêtes max par connexion keep-alive » "
"(Résistance et limites, défaut 30) ferme seulement une connexion après N "
"requêtes : le navigateur en ouvre une nouvelle aussitôt, sans erreur ni "
"bannissement. La limite de débit du WAF compte les requêtes par IP sur "
"toutes ses connexions et répond 429 au-delà. Monter ou baisser l'un ne "
"change rien à l'autre : un 429 se règle toujours dans Exclusions et débit."
msgstr ""
"नहीं, ये आपस में नहीं टकराते। « प्रति keep-alive कनेक्शन अधिकतम अनुरोध » "
"(मज़बूती और सीमाएँ, डिफ़ॉल्ट 30) केवल N अनुरोधों के बाद कनेक्शन बंद करता है:"
" ब्राउज़र तुरंत नया खोल लेता है, बिना त्रुटि या बैन के। WAF की दर सीमा उस IP"
" के सभी कनेक्शनों पर अनुरोध गिनती है और सीमा से ऊपर 429 लौटाती है। एक को "
"बढ़ाने या घटाने से दूसरे पर कोई असर नहीं: 429 हमेशा अपवाद और दर सीमा में ही "
"ठीक होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:372
msgid "J'ai modifié une liste mais le serveur ne l'applique pas - pourquoi ?"
msgstr "मैंने एक सूची बदली लेकिन सर्वर उसे लागू नहीं करता - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:374
msgid ""
"Le message affiché après 'Enregistrer et appliquer' donne la raison : (1) la"
" liste n'est pas encore chargée dans le WAF (utilisez l'assistant -> "
"Charger) ; (2) la vérification a trouvé un problème (le serveur garde alors "
"ses règles actuelles, rien n'est rechargé à moitié) ; (3) le compte du "
"service ne peut pas lire le fichier ('Corriger les droits') ; (4) aucun "
"service actif - relancez le serveur lancé à la main."
msgstr ""
"'सेव करें और लागू करें' के बाद दिखाया गया संदेश कारण बताता है: (1) सूची अभी "
"WAF में लोड नहीं हुई है (विज़ार्ड -> लोड करें का उपयोग करें); (2) जाँच में "
"कोई समस्या मिली (तब सर्वर अपने वर्तमान नियम रखता है, आधा-अधूरा कुछ भी रीलोड "
"नहीं होता); (3) सर्विस अकाउंट फ़ाइल नहीं पढ़ सकता ('अनुमतियाँ ठीक करें'); "
"(4) कोई सक्रिय सर्विस नहीं - हाथ से चलाया गया सर्वर फिर से शुरू करें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:382
#: src/omega_serv/interfaces/tui/guide/content/faq.py:394
#: src/omega_serv/interfaces/tui/guide/content/faq.py:410
#: src/omega_serv/interfaces/tui/guide/content/faq.py:425
#: src/omega_serv/interfaces/tui/guide/content/faq.py:439
#: src/omega_serv/interfaces/tui/guide/content/faq.py:457
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:892
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:105
msgid "WAF - Magnet (import d'un WAF externe)"
msgstr "WAF - Magnet (बाहरी WAF इम्पोर्ट)"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:383
msgid ""
"J'ai activé le script magnet mais le serveur refuse de démarrer / l'écran "
"signale 'lupa' absent - pourquoi ?"
msgstr ""
"मैंने magnet स्क्रिप्ट सक्षम की लेकिन सर्वर शुरू होने से मना करता है / "
"स्क्रीन बताती है कि 'lupa' नहीं है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:385
msgid ""
"Le magnet est un extra OPTIONNEL, jamais installé par défaut : `pip install "
"-e \".[magnet]\"` (dépendance `lupa`, liaison Lua embarquée - aucun "
"interpréteur Lua système requis, une roue précompilée existe pour les "
"plateformes courantes). Son absence est signalée par le registre des "
"capacités (capacité `waf-magnet`, écran Capacités) avec la commande exacte, "
"et bloque `config check`/le démarrage si `options.waf.magnet.enabled` est "
"actif sans cette dépendance - jamais un échec silencieux."
msgstr ""
"magnet एक वैकल्पिक extra है, डिफ़ॉल्ट रूप से कभी इंस्टॉल नहीं होता: `pip "
"install -e \".[magnet]\"` (डिपेंडेंसी `lupa`, एम्बेडेड Lua बाइंडिंग - सिस्टम"
" Lua interpreter आवश्यक नहीं, सामान्य प्लेटफ़ॉर्म के लिए precompiled wheel "
"उपलब्ध है)। इसकी अनुपस्थिति क्षमता रजिस्टर (क्षमता `waf-magnet`, क्षमता "
"स्क्रीन) सटीक कमांड के साथ बताता है, और इस डिपेंडेंसी के बिना "
"`options.waf.magnet.enabled` सक्रिय होने पर `config check`/स्टार्ट को रोकता "
"है - कभी चुपचाप विफलता नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:396
msgid "Le but du magnet, c'est d'écrire un nouveau WAF en Lua ?"
msgstr "क्या magnet का उद्देश्य Lua में नया WAF लिखना है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:399
msgid ""
"Non - c'est l'inverse : importer un script WAF `mod_magnet` Lighttpd "
"EXISTANT, écrit à l'origine pour un autre site, SANS le réécrire. Le pont "
"`lighty.*` (infrastructure/waf/lua_waf_adapter.py) reproduit le modèle "
"d'exécution réel de Lighttpd (`lighty.env`, "
"`lighty.header`/`lighty.content`, convention de retour 0=continuer / code "
"HTTP=bloquer, runtime Lua persistant pour que les compteurs internes du "
"script - rate limiting, blocklist progressive - survivent entre requêtes) "
"plutôt qu'un contrat inventé par OMEGA-SERV. Le natif reste TOUJOURS actif "
"en parallèle : le magnet est un renfort additif, il ne peut jamais lever un "
"blocage déjà décidé par le natif."
msgstr ""
"नहीं - उल्टा: पहले से मौजूद Lighttpd `mod_magnet` WAF स्क्रिप्ट, जो मूल रूप "
"से किसी अन्य साइट के लिए लिखी गई थी, उसे दोबारा लिखे बिना इम्पोर्ट करना। "
"`lighty.*` ब्रिज (infrastructure/waf/lua_waf_adapter.py) Lighttpd का "
"वास्तविक निष्पादन मॉडल दोहराता है (`lighty.env`, "
"`lighty.header`/`lighty.content`, रिटर्न परंपरा 0=जारी रखें / HTTP "
"कोड=ब्लॉक, स्थायी Lua runtime ताकि स्क्रिप्ट के आंतरिक काउंटर - rate "
"limiting, क्रमिक ब्लॉकलिस्ट - अनुरोधों के बीच बने रहें), OMEGA-SERV द्वारा "
"गढ़ा गया कोई अनुबंध नहीं। मूल WAF हमेशा समानांतर में सक्रिय रहता है: magnet "
"एक अतिरिक्त सहायक है, यह मूल WAF द्वारा पहले से तय किए गए ब्लॉक को कभी हटा "
"नहीं सकता।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:411
msgid ""
"Comment savoir si un script magnet que j'importe est compatible AVANT de "
"l'activer en production ?"
msgstr ""
"प्रोडक्शन में सक्षम करने से पहले कैसे जानूँ कि मैं जो magnet स्क्रिप्ट "
"इम्पोर्ट कर रहा हूँ वह संगत है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:413
msgid ""
"Écran Active Sécurité -> WAF -> Magnet, bouton 'Vérifier la compatibilité' "
"(ou `omega-serv waf test` en CLI) - exécute RÉELLEMENT le script avec les "
"valeurs du formulaire en cours de saisie, pas seulement celles déjà "
"enregistrées. Deux contrôles combinés : un scan statique signale toute "
"référence `lighty.X` non supportée par ce pont (reste toujours `nil` côté "
"Lua - un script bien écrit dégrade via son propre repli `or`, un script qui "
"ne dégrade pas remonte une erreur réelle, capturée par le second contrôle) ;"
" un smoke test exécute le script pour de vrai sur une requête de test "
"bénigne. Les deux s'affichent comme avertissements explicites, jamais une "
"vérification cachée."
msgstr ""
"एक्टिव सुरक्षा -> WAF -> Magnet स्क्रीन, 'संगतता जाँचें' बटन (या CLI में "
"`omega-serv waf test`) - स्क्रिप्ट को वास्तव में फ़ॉर्म में अभी भरे जा रहे "
"मानों के साथ चलाता है, केवल सेव किए गए मानों के साथ नहीं। दो जाँचें एक साथ: "
"स्थैतिक स्कैन इस ब्रिज द्वारा असमर्थित हर `lighty.X` संदर्भ बताता है (Lua "
"में हमेशा `nil` रहता है - अच्छी तरह लिखी स्क्रिप्ट अपने `or` बैकअप से संभल "
"जाती है, जो नहीं संभलती वह वास्तविक त्रुटि देती है, जिसे दूसरी जाँच पकड़ती "
"है); smoke test स्क्रिप्ट को एक हानिरहित टेस्ट अनुरोध पर वास्तव में चलाता "
"है। दोनों स्पष्ट चेतावनियों के रूप में दिखती हैं, कभी छिपी जाँच नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:426
msgid ""
"J'ai activé un script magnet avec on_error='fail-closed' et maintenant du "
"trafic légitime se fait bloquer - pourquoi ?"
msgstr ""
"मैंने on_error='fail-closed' के साथ magnet स्क्रिप्ट सक्षम की और अब वैध "
"ट्रैफ़िक ब्लॉक हो रहा है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:428
msgid ""
"`fail-closed` bloque TOUTE requête qui déclenche une erreur du script "
"(incompatibilité, exception Lua, timeout) - une politique volontairement "
"stricte, mais dangereuse combinée à un script jamais vérifié au préalable : "
"une seule incompatibilité non détectée peut alors bloquer tout le trafic qui"
" l'atteint. Lancez 'Vérifier la compatibilité' (voir question précédente) "
"avant d'activer fail-closed en production - un avertissement explicite "
"s'affiche précisément quand ces deux conditions se combinent. En cas de "
"doute, repassez `on_error` à 'ignore' (le défaut) : le trafic continue "
"d'être traité par le natif seul si le magnet échoue."
msgstr ""
"`fail-closed` हर उस अनुरोध को ब्लॉक करता है जो स्क्रिप्ट में त्रुटि ट्रिगर "
"करता है (असंगति, Lua exception, timeout) - जानबूझकर सख्त नीति, लेकिन पहले "
"कभी न जाँची गई स्क्रिप्ट के साथ खतरनाक: एक भी अनदेखी असंगति उस तक पहुँचने "
"वाला सारा ट्रैफ़िक ब्लॉक कर सकती है। प्रोडक्शन में fail-closed सक्षम करने से"
" पहले 'संगतता जाँचें' चलाएँ (पिछला प्रश्न देखें) - ठीक तब एक स्पष्ट चेतावनी "
"दिखती है जब ये दोनों स्थितियाँ एक साथ होती हैं। संदेह होने पर `on_error` को "
"फिर से 'ignore' (डिफ़ॉल्ट) करें: magnet विफल होने पर ट्रैफ़िक केवल मूल WAF "
"द्वारा संसाधित होता रहता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:440
msgid ""
"Les logs/la blocklist de mon script magnet importe n'apparaissent jamais sur"
" le disque - pourquoi ?"
msgstr ""
"मेरी इम्पोर्ट की गई magnet स्क्रिप्ट के लॉग/ब्लॉकलिस्ट डिस्क पर कभी नहीं "
"दिखते - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:442
msgid ""
"Un script `mod_magnet` écrit typiquement ses logs/sa blocklist à des chemins"
" ABSOLUS en dur (ex. `/etc/blocklist.txt`, `/var/log/...`) propres à son "
"site d'origine - ces chemins n'ont aucune raison d'exister sur cette "
"machine. La dissociation se fait via `options.waf.magnet.paths` (écran "
"Magnet), injectés dans le script comme table Lua globale "
"`omega_magnet_paths` : seule une COPIE adaptée du script (les 5 lignes de "
"configuration modifiées pour lire cette table, avec repli sur le chemin en "
"dur d'origine si absente) en bénéficie - le script importe lui-même doit "
"être adapté une fois, manuellement (méthode générique, mais noms de chemins "
"propres à chaque script). `secure/waf/scripts/waf.lua` (chemin par défaut de"
" `options.waf.magnet.script`) est livre comme exemple minimal montrant cette"
" technique - un vrai script importe (qui porte forcément la logique propre à"
" SON site d'origine, jamais généralisable à l'avance) n'a jamais vocation à "
"être redistribué tel quel à d'autres installations."
msgstr ""
"`mod_magnet` स्क्रिप्ट आमतौर पर अपने लॉग/ब्लॉकलिस्ट को हार्डकोड किए गए "
"एब्सोल्यूट पाथ (उदा. `/etc/blocklist.txt`, `/var/log/...`) पर लिखती है जो "
"उसकी मूल साइट के लिए होते हैं - इस मशीन पर इन पाथ के मौजूद होने का कोई कारण "
"नहीं। अलगाव `options.waf.magnet.paths` (Magnet स्क्रीन) से होता है, जो "
"स्क्रिप्ट में वैश्विक Lua तालिका `omega_magnet_paths` के रूप में डाले जाते "
"हैं: केवल स्क्रिप्ट की अनुकूलित कॉपी (कॉन्फ़िगरेशन की 5 पंक्तियाँ इस तालिका "
"को पढ़ने के लिए बदली गईं, अनुपस्थित होने पर मूल हार्डकोड पाथ पर लौटती हैं) "
"ही इसका लाभ लेती है - इम्पोर्ट की गई स्क्रिप्ट को स्वयं एक बार हाथ से "
"अनुकूलित करना होगा (सामान्य तरीका, लेकिन पाथ नाम हर स्क्रिप्ट के अपने)। "
"`secure/waf/scripts/waf.lua` (`options.waf.magnet.script` का डिफ़ॉल्ट पाथ) "
"इस तकनीक को दिखाने वाले न्यूनतम उदाहरण के रूप में दिया गया है - वास्तव में "
"इम्पोर्ट की गई स्क्रिप्ट (जो अनिवार्य रूप से अपनी मूल साइट का तर्क रखती है, "
"पहले से सामान्यीकृत नहीं की जा सकती) कभी अन्य इंस्टॉलेशन में जस-की-तस वितरित"
" करने के लिए नहीं होती।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:458
msgid ""
"Mon script magnet écrit une page HTML personnalisée (lighty.content) en cas "
"de blocage - pourquoi je ne la vois jamais ?"
msgstr ""
"मेरी magnet स्क्रिप्ट ब्लॉक होने पर एक कस्टम HTML पेज (lighty.content) लिखती"
" है - मुझे वह कभी क्यों नहीं दिखता?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:460
msgid ""
"Choix délibéré, cohérent avec le reste du projet : le moteur WAF (natif ou "
"magnet) rend TOUJOURS une décision, jamais une page HTML - c'est le serveur "
"qui rend systématiquement sa propre page d'erreur générique. Les écritures "
"`lighty.header`/`lighty.content` d'un script importe sont acceptées (le "
"script ne plante jamais pour les avoir faites) mais jamais relues ni "
"renvoyées au visiteur."
msgstr ""
"जानबूझकर किया गया चुनाव, प्रोजेक्ट के बाकी हिस्से के अनुरूप: WAF इंजन (मूल "
"या magnet) हमेशा एक निर्णय लौटाता है, कभी HTML पेज नहीं - सर्वर ही हमेशा "
"अपना सामान्य त्रुटि पेज दिखाता है। इम्पोर्ट की गई स्क्रिप्ट के "
"`lighty.header`/`lighty.content` लेखन स्वीकार किए जाते हैं (इन्हें करने से "
"स्क्रिप्ट कभी क्रैश नहीं होती) लेकिन कभी वापस पढ़े या आगंतुक को भेजे नहीं "
"जाते।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:469
msgid ""
"Les boutons de log 'waf magnet (alertes/blocklist)' restent grises dans "
"l'écran Voir/Suivre - pourquoi ?"
msgstr ""
"देखें/फ़ॉलो करें स्क्रीन में 'waf magnet (अलर्ट/ब्लॉकलिस्ट)' लॉग बटन धूसर "
"रहते हैं - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:471
msgid ""
"Ces deux logs sont proposes d'office (même si le magnet n'est jamais "
"configuré), mais restent désactivés tant que `options.waf.magnet.enabled` "
"n'est pas réellement actif - évite un clic qui ne mènerait qu'à un message "
"d'erreur. Une fois actif, un clic fonctionne même si le fichier n'existe pas"
" encore (log vide, jamais une erreur - aucune alerte déclenchée pour "
"l'instant). Côté `lnav` (logs fusionnés), ces mêmes logs sont déjà cochables"
" sans cette restriction : un log absent y est simplement ignore au "
"lancement, sans bloquer les autres."
msgstr ""
"ये दोनों लॉग हमेशा दिखाए जाते हैं (भले magnet कभी कॉन्फ़िगर न किया गया हो), "
"लेकिन जब तक `options.waf.magnet.enabled` वास्तव में सक्रिय न हो, अक्षम रहते "
"हैं - ऐसे क्लिक से बचने के लिए जो केवल त्रुटि संदेश तक ले जाता। सक्रिय होने "
"के बाद, फ़ाइल अभी मौजूद न हो तब भी क्लिक काम करता है (खाली लॉग, कभी त्रुटि "
"नहीं - अभी तक कोई अलर्ट ट्रिगर नहीं हुआ)। `lnav` (मर्ज किए गए लॉग) की ओर ये "
"लॉग बिना इस प्रतिबंध के पहले से चुने जा सकते हैं: अनुपस्थित लॉग शुरू करते "
"समय बस अनदेखा हो जाता है, बाकियों को रोके बिना।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:481
#: src/omega_serv/interfaces/tui/guide/content/faq.py:495
#: src/omega_serv/interfaces/tui/guide/content/faq.py:508
#: src/omega_serv/interfaces/tui/guide/content/faq.py:523
msgid "Sécurité - CSP et en-têtes"
msgstr "सुरक्षा - CSP और हेडर"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:482
msgid ""
"J'ai ajouté une zone CSP pour un dossier, et maintenant ce dossier semble "
"avoir perdu d'autres protections - pourquoi ?"
msgstr ""
"मैंने एक फ़ोल्डर के लिए CSP ज़ोन जोड़ा, और अब लगता है कि उस फ़ोल्डर ने अन्य "
"सुरक्षाएँ खो दी हैं - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:484
msgid ""
"Une zone CSP REMPLACE ENTIÈREMENT la politique par défaut pour son préfixe -"
" jamais une fusion/un simple ajout. Une zone qui ne contient que `style-src "
"'self' 'unsafe-inline'` par exemple fait disparaître toutes les AUTRES "
"directives (`object-src`, `frame-ancestors`...) sous ce préfixe, qui "
"retombent alors sur le comportement par défaut du navigateur plutôt que sur "
"la politique globale stricte. L'assistant d'ajout de zone (écran Sécurité "
"générique -> Ajouter une zone) existe exactement pour éviter ce piège : "
"chaque directive y est pré-remplie avec sa valeur ACTUELLE (la politique "
"globale), à modifier uniquement là où c'est nécessaire."
msgstr ""
"CSP ज़ोन अपने प्रीफ़िक्स के लिए डिफ़ॉल्ट नीति को पूरी तरह बदल देता है - कभी "
"विलय या केवल जोड़ नहीं। उदाहरण के लिए केवल `style-src 'self' 'unsafe-"
"inline'` वाला ज़ोन इस प्रीफ़िक्स के नीचे बाकी सभी निर्देश (`object-src`, "
"`frame-ancestors`...) हटा देता है, जो तब सख्त वैश्विक नीति के बजाय ब्राउज़र "
"के डिफ़ॉल्ट व्यवहार पर लौट आते हैं। ज़ोन जोड़ने वाला विज़ार्ड (सामान्य "
"सुरक्षा स्क्रीन -> ज़ोन जोड़ें) ठीक इसी जाल से बचने के लिए है: हर निर्देश "
"उसके वर्तमान मान (वैश्विक नीति) से पहले से भरा होता है, केवल जहाँ आवश्यक हो "
"वहीं बदलें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:496
msgid ""
"Comment autoriser 'unsafe-inline' (ou une source moins stricte) uniquement "
"pour un dossier précis, sans affaiblir le reste du site ?"
msgstr ""
"बाकी साइट को कमज़ोर किए बिना केवल एक विशेष फ़ोल्डर के लिए 'unsafe-inline' "
"(या कम सख्त स्रोत) की अनुमति कैसे दें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:498
msgid ""
"Zones CSP (`security.csp_zones`, écran Sécurité générique) : une exception "
"EXPLICITE par préfixe de chemin, jamais une relâche globale. L'assistant "
"d'ajout détecte toute directive relâchée ('unsafe-inline'/'unsafe-"
"eval'/source générique '*') et exige une confirmation explicite "
"supplémentaire avant d'enregistrer. Cette zone reste ensuite TOUJOURS "
"visible dans `omega-serv audit security` (règles CSP-001/CSP-002, qui "
"scannent aussi les zones, pas seulement la politique globale) - même "
"délibérée, jamais silencieuse."
msgstr ""
"CSP ज़ोन (`security.csp_zones`, सामान्य सुरक्षा स्क्रीन): पाथ प्रीफ़िक्स के "
"अनुसार एक स्पष्ट अपवाद, कभी वैश्विक ढील नहीं। जोड़ने वाला विज़ार्ड हर ढीले "
"निर्देश ('unsafe-inline'/'unsafe-eval'/सामान्य स्रोत '*') को पहचानता है और "
"सेव करने से पहले एक अतिरिक्त स्पष्ट पुष्टि माँगता है। इसके बाद यह ज़ोन "
"`omega-serv audit security` में हमेशा दिखाई देता है (CSP-001/CSP-002 नियम, "
"जो केवल वैश्विक नीति नहीं बल्कि ज़ोन भी स्कैन करते हैं) - जानबूझकर किया गया "
"हो तब भी, कभी छिपा नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:509
msgid ""
"Pourquoi Cross-Origin-Embedder-Policy reste à 'unsafe-none' même en profil "
"hardened ?"
msgstr ""
"hardened प्रोफ़ाइल में भी Cross-Origin-Embedder-Policy 'unsafe-none' पर "
"क्यों रहता है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:511
msgid ""
"Choix délibéré, différent de `Cross-Origin-Opener-Policy`/`Cross-Origin-"
"Resource-Policy` (toujours `same-origin`, sans risque réel de casser un "
"site) : une valeur stricte (`require-corp`/`credentialless`) peut bloquer "
"des ressources cross-origin (polices, images, iframes tiers) propres au "
"contenu RÉELLEMENT servi, qu'un serveur générique ne connaît jamais à "
"l'avance - jamais un défaut imposé sans connaissance de ce contenu. Le "
"header reste néanmoins toujours ÉMIS explicitement, même à cette valeur "
"permissive (jamais absent de la réponse - un scanner externe distingue ainsi"
" 'non considéré' de 'permissif par choix'). Réglable via "
"`security.coep_mode` (écran Sécurité générique) si vous connaissez le "
"contenu servi et voulez l'isolation complète."
msgstr ""
"जानबूझकर किया गया चुनाव, `Cross-Origin-Opener-Policy`/`Cross-Origin-"
"Resource-Policy` से अलग (वे हमेशा `same-origin` हैं, किसी साइट को तोड़ने का "
"कोई वास्तविक जोखिम नहीं): सख्त मान (`require-corp`/`credentialless`) वास्तव "
"में परोसी जा रही सामग्री के cross-origin संसाधनों (फ़ॉन्ट, इमेज, तृतीय-पक्ष "
"iframe) को ब्लॉक कर सकता है, जिन्हें एक सामान्य सर्वर कभी पहले से नहीं जानता"
" - इस सामग्री को जाने बिना कभी डिफ़ॉल्ट रूप से थोपा नहीं जाता। फिर भी हेडर "
"हमेशा स्पष्ट रूप से भेजा जाता है, इस ढीले मान पर भी (रिस्पॉन्स में कभी "
"अनुपस्थित नहीं - इस तरह बाहरी स्कैनर 'विचार नहीं किया गया' और 'जानबूझकर "
"ढीला' में अंतर कर पाता है)। यदि आप परोसी जा रही सामग्री जानते हैं और पूरा "
"अलगाव चाहते हैं, तो `security.coep_mode` (सामान्य सुरक्षा स्क्रीन) से सेट "
"करें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:524
msgid ""
"Le listing de répertoire (directory listing) perd tout son style visuel "
"depuis que j'ai une CSP stricte - pourquoi ?"
msgstr ""
"सख्त CSP लगाने के बाद से directory listing की पूरी दृश्य शैली खो गई है - "
"क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:526
msgid ""
"Corrigé (2026-10-10) : le CSS du listing est désormais servi en fichier "
"EXTERNE réservé plutôt qu'inline dans le HTML - `style-src 'self'` "
"(politique par défaut) autorise déjà une feuille de style de même origine, "
"sans besoin d'aucune exception. Si ce problème persiste après mise à jour, "
"voir la question sur le redémarrage après mise à jour du code (catégorie "
"Redémarrage et rechargement) : un simple rechargement (SIGHUP) ne suffit "
"jamais à appliquer un changement de CODE, seul un redémarrage complet du "
"service le fait."
msgstr ""
"सुधारा गया (2026-10-10): listing का CSS अब HTML में inline के बजाय एक "
"आरक्षित बाहरी फ़ाइल के रूप में परोसा जाता है - `style-src 'self'` (डिफ़ॉल्ट "
"नीति) पहले से ही उसी origin की स्टाइलशीट की अनुमति देती है, किसी अपवाद की "
"ज़रूरत नहीं। यदि अपडेट के बाद भी यह समस्या बनी रहे, तो कोड अपडेट के बाद "
"रीस्टार्ट वाला प्रश्न देखें (श्रेणी रीस्टार्ट और रीलोड): कोड बदलाव लागू करने"
" के लिए साधारण रीलोड (SIGHUP) कभी पर्याप्त नहीं, केवल सर्विस का पूर्ण "
"रीस्टार्ट ही करता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:536
#: src/omega_serv/interfaces/tui/guide/content/faq.py:556
#: src/omega_serv/interfaces/tui/guide/content/faq.py:573
#: src/omega_serv/interfaces/tui/guide/content/faq.py:591
msgid "TLS et certificats"
msgstr "TLS और सर्टिफ़िकेट"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:537
msgid ""
"J'ai regenere/revoque le certificat TLS mais le serveur sert toujours "
"l'ancien - pourquoi ?"
msgstr ""
"मैंने TLS सर्टिफ़िकेट फिर से बनाया/रद्द किया लेकिन सर्वर अभी भी पुराना ही "
"परोसता है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:539
msgid ""
"Le contexte SSL n'est construit qu'UNE SEULE FOIS au démarrage du serveur, "
"jamais retouché par un simple rechargement. Régénérer ou révoquer un "
"certificat pendant que TLS est déjà actif nécessite TOUJOURS un redémarrage "
"complet pour que le changement soit réellement pris en compte, même si le "
"fichier sur disque a déjà changé."
msgstr ""
"SSL संदर्भ सर्वर शुरू होने पर केवल एक बार बनता है, साधारण रीलोड उसे कभी नहीं"
" छूता। TLS पहले से सक्रिय होने पर सर्टिफ़िकेट फिर से बनाने या रद्द करने के "
"लिए बदलाव को वास्तव में लागू करने हेतु हमेशा पूर्ण रीस्टार्ट आवश्यक है, भले "
"डिस्क पर फ़ाइल पहले ही बदल चुकी हो।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:546
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1221
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1238
msgid "Sauvegarde et restauration"
msgstr "बैकअप और रिस्टोर"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:547
msgid "Mes sauvegardes de configuration sont-elles chiffrées ?"
msgstr "क्या मेरे कॉन्फ़िगरेशन बैकअप एन्क्रिप्टेड हैं?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:549
msgid ""
"Non, jamais par défaut. Si vous incluez les zones d'authentification (hash "
"de mots de passe) ou les certificats (clés privées TLS), la sauvegarde "
"contient des secrets réels en clair - une confirmation explicite "
"supplémentaire est demandée avant de créer ce type de sauvegarde. Protégez "
"ces fichiers comme n'importe quel secret."
msgstr ""
"नहीं, डिफ़ॉल्ट रूप से कभी नहीं। यदि आप प्रमाणीकरण ज़ोन (पासवर्ड hash) या "
"सर्टिफ़िकेट (TLS private keys) शामिल करते हैं, तो बैकअप में वास्तविक गोपनीय "
"जानकारी सादे रूप में होती है - इस प्रकार का बैकअप बनाने से पहले एक अतिरिक्त "
"स्पष्ट पुष्टि माँगी जाती है। इन फ़ाइलों को किसी भी गोपनीय चीज़ की तरह "
"सुरक्षित रखें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:557
msgid ""
"Comment m'auto-héberger avec un vrai certificat public, de bout en bout "
"(schéma DDNS -> Certbot -> OMEGA-SERV) ?"
msgstr ""
"वास्तविक सार्वजनिक सर्टिफ़िकेट के साथ शुरू से अंत तक स्वयं-होस्ट कैसे करें "
"(DDNS -> Certbot -> OMEGA-SERV योजना)?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:559
msgid ""
"Le schéma complet : un service DDNS (Dynu ou équivalent) fait pointer un nom"
" de domaine public (ex. monserveur.dynu.com) vers votre IP, mise à jour "
"automatiquement par leur client à chaque changement - ENTIÈREMENT hors du "
"périmètre d'OMEGA-SERV, à installer et configurer vous-même. Vous devez "
"aussi rediriger les ports 80 et 443 de votre routeur/pare-feu vers cette "
"machine. Une fois cela fait : Assistant Let's Encrypt (Configuration "
"détaillée -> TLS) obtient le premier certificat (défi HTTP-01, webroot - "
"port 80 doit être joignable depuis Internet le temps de la demande), "
"l'importe et vous rappelle d'activer TLS (écran Activer/desactiver TLS) puis"
" de redémarrer. Ensuite, Renouvellement automatique (même sous-menu) "
"installe la planification (timer systemd ou crontab) qui renouvelle et "
"redémarre tout seul, sans plus jamais intervenir manuellement pour cette "
"partie."
msgstr ""
"पूरी योजना: एक DDNS सर्विस (Dynu या समकक्ष) एक सार्वजनिक डोमेन नाम (उदा. "
"monserveur.dynu.com) को आपके IP की ओर इंगित करती है, जिसे उनका क्लाइंट हर "
"बदलाव पर स्वचालित रूप से अपडेट करता है - यह पूरी तरह OMEGA-SERV के दायरे से "
"बाहर है, इसे स्वयं इंस्टॉल और कॉन्फ़िगर करें। आपको अपने राउटर/फ़ायरवॉल के "
"पोर्ट 80 और 443 को भी इस मशीन की ओर फ़ॉरवर्ड करना होगा। यह हो जाने के बाद: "
"Let's Encrypt विज़ार्ड (विस्तृत कॉन्फ़िगरेशन -> TLS) पहला सर्टिफ़िकेट "
"प्राप्त करता है (HTTP-01 challenge, webroot - अनुरोध के दौरान पोर्ट 80 "
"इंटरनेट से पहुँच योग्य होना चाहिए), उसे इम्पोर्ट करता है और आपको TLS सक्षम "
"करने (TLS सक्षम/अक्षम करें स्क्रीन) और फिर रीस्टार्ट करने की याद दिलाता है। "
"इसके बाद, स्वचालित नवीनीकरण (उसी उप-मेन्यू में) शेड्यूलिंग (systemd टाइमर या"
" crontab) इंस्टॉल करता है जो अपने आप नवीनीकरण और रीस्टार्ट करता है, इस "
"हिस्से के लिए फिर कभी हाथ से हस्तक्षेप नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:574
msgid ""
"OMEGA-SERV tourne dans un conteneur - comment obtenir un certificat Let's "
"Encrypt ?"
msgstr ""
"OMEGA-SERV एक कंटेनर में चलता है - Let's Encrypt सर्टिफ़िकेट कैसे प्राप्त "
"करें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:576
msgid ""
"N'exécutez PAS l'Assistant Let's Encrypt/le renouvellement automatique à "
"l'intérieur du conteneur qui sert déjà le trafic public. Exécutez-les sur "
"l'hôte (ou dans un conteneur/sidecar distinct dédié à l'administration) en "
"partageant avec le conteneur serveur : le même volume de webroot (Certbot y "
"dépose son défi, ce que le conteneur sert déjà via le port 80 qu'il expose),"
" et le même volume secure/certificates/ - le conteneur serveur peut monter "
"ce dernier en LECTURE SEULE, puisque l'import du certificat (écriture) se "
"fait toujours côté hote/sidecar, jamais depuis le conteneur servant le "
"trafic. Un redémarrage du conteneur serveur reste nécessaire après chaque "
"renouvellement (même règle que partout ailleurs : le contexte SSL n'est "
"jamais rechargé à chaud) - le hook de renouvellement redémarre le SERVICE "
"qu'il connaît (hote/sidecar), pensez à l'adapter si le conteneur serveur est"
" pilote séparément (ex. `docker restart`) plutôt que par un service "
"systemd/OpenRC/runit classique."
msgstr ""
"Let's Encrypt विज़ार्ड/स्वचालित नवीनीकरण को उस कंटेनर के अंदर न चलाएँ जो "
"पहले से सार्वजनिक ट्रैफ़िक परोस रहा है। उन्हें होस्ट पर चलाएँ (या प्रशासन के"
" लिए समर्पित अलग कंटेनर/sidecar में), सर्वर कंटेनर के साथ साझा करते हुए: वही"
" webroot volume (Certbot इसमें अपना challenge रखता है, जिसे कंटेनर अपने खुले"
" पोर्ट 80 से पहले से परोसता है), और वही secure/certificates/ volume - सर्वर "
"कंटेनर इसे केवल-पढ़ने (read-only) में माउंट कर सकता है, क्योंकि सर्टिफ़िकेट "
"इम्पोर्ट (लेखन) हमेशा होस्ट/sidecar की ओर होता है, ट्रैफ़िक परोसने वाले "
"कंटेनर से कभी नहीं। हर नवीनीकरण के बाद सर्वर कंटेनर का रीस्टार्ट आवश्यक रहता"
" है (हर जगह का वही नियम: SSL संदर्भ कभी हॉट रीलोड नहीं होता) - नवीनीकरण hook"
" उसी सर्विस को रीस्टार्ट करता है जिसे वह जानता है (होस्ट/sidecar), यदि सर्वर"
" कंटेनर अलग से नियंत्रित होता है (उदा. `docker restart`) न कि सामान्य "
"systemd/OpenRC/runit सर्विस से, तो इसे अनुकूलित करना याद रखें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:592
msgid "L'Assistant Let's Encrypt échoue (défi HTTP-01) - pourquoi ?"
msgstr "Let's Encrypt विज़ार्ड विफल होता है (HTTP-01 challenge) - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:594
msgid ""
"Les causes les plus fréquentes, dans l'ordre à vérifier : (1) le port 80 "
"n'est pas réellement joignable depuis Internet (redirection de port "
"manquante ou incorrecte sur le routeur/pare-feu, ou un autre service occupe "
"déjà ce port sur la machine), (2) le domaine ne pointe pas encore vers cette"
" IP (DNS/DDNS pas encore propagé - vérifiez avec `dig`/`nslookup` depuis une"
" machine externe), (3) en mode test (staging, coché par défaut) tout "
"fonctionne mais le certificat obtenu n'est jamais reconnu par les "
"navigateurs - c'est normal, décochez la case une fois le domaine et le "
"webroot vérifiés. Le message d'erreur affiché est directement celui renvoyé "
"par Certbot - il précise généralement laquelle de ces causes s'applique."
msgstr ""
"सबसे सामान्य कारण, जाँचने के क्रम में: (1) पोर्ट 80 वास्तव में इंटरनेट से "
"पहुँच योग्य नहीं है (राउटर/फ़ायरवॉल पर पोर्ट फ़ॉरवर्डिंग नहीं या गलत, या "
"मशीन पर कोई अन्य सर्विस पहले से यह पोर्ट उपयोग कर रही है), (2) डोमेन अभी इस "
"IP की ओर इंगित नहीं करता (DNS/DDNS अभी प्रसारित नहीं - किसी बाहरी मशीन से "
"`dig`/`nslookup` से जाँचें), (3) टेस्ट मोड में (staging, डिफ़ॉल्ट रूप से "
"चुना हुआ) सब काम करता है लेकिन प्राप्त सर्टिफ़िकेट ब्राउज़र कभी नहीं पहचानते"
" - यह सामान्य है, डोमेन और webroot की जाँच हो जाने पर बॉक्स अनचेक करें। "
"दिखाया गया त्रुटि संदेश सीधे Certbot द्वारा लौटाया गया होता है - वह आमतौर पर"
" बताता है कि इनमें से कौन सा कारण लागू होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:607
msgid "Comment bannir une adresse IP à la main, sans écrire de règle ?"
msgstr "बिना नियम लिखे किसी IP पते को हाथ से कैसे बैन करें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:610
msgid ""
"Active Sécurité -> INTERVENTION MANUELLE -> Bannir : une adresse, un motif, "
"une durée. Le ban est immédiat (page 451 sur tout le site, avant les "
"backends), sans droits root et sans lien avec la récidive RIPOSTE ; il se "
"lève dans Débannir. Statut des bans liste tous les bans avec leur origine et"
" les exporte (JSON, HTML, ou TXT importable tel quel dans omega-fire). Pour "
"un réseau, passez par WAF -> Modules -> Liste de blocage."
msgstr ""
"एक्टिव सुरक्षा -> मैनुअल हस्तक्षेप -> बैन करें: एक पता, एक कारण, एक अवधि। "
"बैन तुरंत लागू होता है (बैकएंड से पहले पूरी साइट पर 451 पेज), root अधिकारों "
"के बिना और RIPOSTE के दोहराव से कोई संबंध नहीं; इसे बैन हटाएँ में हटाया जाता"
" है। बैन स्थिति सभी बैन को उनके स्रोत के साथ दिखाती है और एक्सपोर्ट करती है "
"(JSON, HTML, या omega-fire में जैसा है वैसा इंपोर्ट होने वाला TXT)। नेटवर्क "
"के लिए WAF -> मॉड्यूल -> ब्लॉकलिस्ट का उपयोग करें।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:620
msgid "Quelle différence entre Active Defense et RIPOSTE ?"
msgstr "Active Defense और RIPOSTE में क्या अंतर है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:622
msgid ""
"Active Defense agit PENDANT la requête : il note chaque source selon ce "
"qu'elle fait maintenant (score, niveaux normal / suspicious / hostile / "
"contained) et réagit tout de suite (leurre, ralentissement, incident). "
"RIPOSTE agit DANS LA DURÉE : il se souvient des sources qui reviennent après"
" un silence (épisodes) et leur applique des bans de plus en plus longs "
"(paliers, par défaut 1 h, 6 h, 24 h, 7 j), avec une échéance, une levée "
"possible et une mémoire de récidive. RIPOSTE ne modifie jamais le score ni "
"les seuils d'Active Defense ; il peut seulement exiger un niveau Active "
"Defense minimal dans une politique."
msgstr ""
"Active Defense अनुरोध के दौरान काम करता है: हर स्रोत को उसके वर्तमान व्यवहार"
" से आँकता है (स्कोर, स्तर normal / suspicious / hostile / contained) और "
"तुरंत प्रतिक्रिया देता है (डिकॉय, धीमा करना, घटनाएँ)। RIPOSTE समय के साथ काम"
" करता है: चुप्पी के बाद लौटने वाले स्रोतों (एपिसोड) को याद रखता है और बढ़ती "
"अवधि के प्रतिबंध लगाता है (स्तर, डिफ़ॉल्ट 1 घंटा, 6 घंटे, 24 घंटे, 7 दिन), "
"समाप्ति, हटाने और पुनरावृत्ति स्मृति के साथ। RIPOSTE कभी Active Defense के "
"स्कोर या सीमाएँ नहीं बदलता; कोई नीति केवल न्यूनतम Active Defense स्तर की "
"माँग कर सकती है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:632
msgid "Pourquoi RIPOSTE a-t-il banni cette adresse ?"
msgstr "RIPOSTE ने यह पता क्यों प्रतिबंधित किया?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:634
msgid ""
"Écran Actions : le détail de l'action donne la politique, le palier, "
"l'événement d'origine et l'échéance. Écran Simuler, « Décisions récentes » :"
" chaque décision est expliquée ligne par ligne (politique retenue, nombre de"
" retours, exclusions vérifiées). En ligne de commande : « riposte actions "
"show <id> » et « riposte decisions list --ip <adresse> --explain ». Faux "
"positif : « Lever » avec « ne pas compter ce ban dans la récidive », et au "
"besoin « Lever et exempter cette source »."
msgstr ""
"कार्रवाइयाँ स्क्रीन: कार्रवाई का विवरण नीति, स्तर, मूल घटना और समाप्ति "
"दिखाता है। सिमुलेशन स्क्रीन पर 'हाल के निर्णय': हर निर्णय एक-एक पंक्ति में "
"समझाया गया है (चुनी गई नीति, वापसी की संख्या, जाँची गई छूटें)। कमांड लाइन: "
"'riposte actions show <id>' और 'riposte decisions list --ip <पता> "
"--explain'। गलत पहचान हो तो: 'इस प्रतिबंध को पुनरावृत्ति में न गिनें' के साथ"
" 'हटाएँ', और ज़रूरत हो तो 'हटाएँ और इस स्रोत को छूट दें'।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:643
msgid "J'ai levé un ban RIPOSTE mais l'adresse reste bloquée - pourquoi ?"
msgstr "मैंने RIPOSTE प्रतिबंध हटा दिया पर पता अब भी अवरुद्ध है - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:645
msgid ""
"Une politique « ban local + ban réseau » passe aussi le ban à fail2ban, par "
"les jails omega-jail <service>-riposte-1h/6h/24h/7d. omega-serv n'a pas les "
"droits de lever un ban fail2ban : « Lever » ne retire que le ban local "
"(blocklist du WAF). Levez le ban réseau dans omega-fire ou avec fail2ban-"
"client (la jail est indiquée dans le détail de l'action). Vérifiez aussi "
"qu'un ban du WAF ou un ban manuel ne couvre pas la même adresse : RIPOSTE "
"n'y touche jamais."
msgstr ""
"'स्थानीय प्रतिबंध + नेटवर्क प्रतिबंध' वाली नीति प्रतिबंध को omega-jail के "
"jail <service>-riposte-1h/6h/24h/7d के ज़रिए fail2ban को भी देती है। omega-"
"serv के पास fail2ban प्रतिबंध हटाने का अधिकार नहीं: 'हटाएँ' केवल स्थानीय "
"प्रतिबंध (WAF blocklist) हटाता है। नेटवर्क प्रतिबंध omega-fire या fail2ban-"
"client से हटाएँ (jail कार्रवाई के विवरण में दिखता है)। यह भी जाँचें कि कोई "
"WAF प्रतिबंध या मैन्युअल प्रतिबंध उसी पते को लक्ष्य नहीं कर रहा: RIPOSTE "
"उन्हें कभी नहीं छूता।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:654
msgid ""
"Les scénarios « Explorateur de leurres » et « Sonde upload / API » sont "
"refusés (profil de leurre inconnu) - que faire ?"
msgstr ""
"«डिकॉय खोजकर्ता» और «अपलोड / API जाँच» परिदृश्य अस्वीकार हो जाते हैं (अज्ञात"
" डिकॉय प्रोफ़ाइल) - क्या करें?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:656
msgid ""
"Ces deux scénarios ne bannissent pas : ils envoient la source vers un leurre"
" d'Active Defense, qui doit donc exister AVANT de charger le scénario - « "
"Explorateur de leurres » utilise le profil fake_admin, « Sonde upload / API "
"» le profil fake_api. (1) L'option active_defense doit être activée (menu "
"Options). (2) Dans Active Sécurité -> Réglages (bloc Active Defense) : « "
"Deception active » = oui, puis Enregistrer. (3) Toujours dans Réglages, « "
"Ajouter un profil » : Nom fake_admin (ou fake_api), Actif oui, Classes "
"d'attaque scan,credential_stuffing pour fake_admin ou api_probe,upload_probe"
" pour fake_api, Isolation fixture, Zone de leurre vide. (4) Revenez dans "
"RIPOSTE -> Politiques -> Ajouter -> Scénario prêt à charger : le scénario "
"est accepté. Les leurres ne fonctionnent qu'après un redémarrage complet. "
"Les trois autres scénarios bannissent et n'ont besoin d'aucun leurre."
msgstr ""
"ये दो परिदृश्य बैन नहीं करते: ये स्रोत को Active Defense के एक डिकॉय की ओर "
"भेजते हैं, इसलिए वह डिकॉय परिदृश्य लोड करने से पहले मौजूद होना चाहिए - "
"«डिकॉय खोजकर्ता» fake_admin प्रोफ़ाइल इस्तेमाल करता है, «अपलोड / API जाँच» "
"fake_api प्रोफ़ाइल। (1) active_defense विकल्प सक्रिय होना चाहिए (विकल्प "
"मेनू)। (2) एक्टिव सुरक्षा -> सेटिंग्स (Active Defense खंड) में: «Deception "
"सक्रिय» = हाँ, फिर सेव करें। (3) वहीं सेटिंग्स में, «प्रोफ़ाइल जोड़ें»: नाम "
"fake_admin (या fake_api), सक्रिय हाँ, हमले की श्रेणियाँ fake_admin के लिए "
"scan,credential_stuffing या fake_api के लिए api_probe,upload_probe, "
"Isolation fixture, डिकॉय ज़ोन खाली। (4) RIPOSTE -> नीतियाँ -> जोड़ें -> "
"तैयार परिदृश्य पर लौटें: परिदृश्य स्वीकार हो जाता है। डिकॉय पूरी तरह "
"रीस्टार्ट के बाद ही काम करते हैं। बाक़ी तीन परिदृश्य बैन करते हैं और उन्हें "
"किसी डिकॉय की ज़रूरत नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:669
msgid "RIPOSTE ne fait rien - pourquoi ?"
msgstr "RIPOSTE कुछ नहीं करता - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:671
msgid ""
"Dans l'ordre : (1) le module 'riposte' doit être activé dans Options, puis "
"le service REDÉMARRÉ complètement ; (2) le WAF doit être actif, sinon "
"RIPOSTE ne voit aucune attaque ; (3) au moins une politique doit être active"
" (« Enregistrer sans activer » la laisse en observation) ; (4) l'arrêt "
"d'urgence ne doit pas être actif (écran État : le bouton affiche « Reprendre"
" ») ; (5) la condition doit être atteinte : par exemple 3 épisodes en 7 "
"jours, un épisode étant séparé du précédent par au moins 1 h de silence. "
"Simuler avec la même situation montre la condition qui manque."
msgstr ""
"क्रम से जाँचें: (1) क्या विकल्पों में 'riposte' मॉड्यूल सक्रिय है और सेवा "
"पूरी तरह पुनःआरंभ हुई? (2) क्या WAF सक्रिय है? उसके बिना RIPOSTE को हमले "
"नहीं दिखते। (3) क्या कम से कम एक नीति सक्रिय है ('सक्रिय किए बिना सहेजें' "
"अवलोकन में रहती है)? (4) क्या आपातकालीन रोक सक्रिय तो नहीं (स्थिति स्क्रीन: "
"बटन 'फिर शुरू करें' दिखाता है)? (5) क्या शर्तें पूरी हुईं: जैसे 7 दिनों में "
"3 एपिसोड, हर एपिसोड के बीच कम से कम 1 घंटे की चुप्पी के साथ। वही स्थिति "
"सिमुलेट करने पर छूटी हुई शर्त पता चलती है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:681
msgid ""
"Une adresse bannie reçoit une page 451 : est-ce omega-serv ou fail2ban ?"
msgstr "प्रतिबंधित पते को 451 पेज मिलता है: यह omega-serv है या fail2ban?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:683
msgid ""
"C'est omega-serv. Une adresse présente dans la liste de blocage du WAF "
"(auto-ban du WAF, ban manuel ou ban local RIPOSTE) reçoit la page 451 « "
"Votre IP a été bannie » sur toutes ses requêtes, pendant toute la durée du "
"ban. Un 403 refuse seulement une requête (une règle touchée), sans bannir. "
"Un ban fail2ban agit sur le pare-feu : il ne renvoie jamais de page, la "
"connexion est coupée ou n'aboutit pas. Pour savoir qui a banni, regardez la "
"source du ban dans la liste de blocage (« auto » = auto-ban du WAF, « "
"riposte », « manual ») : WAF → Modules → Liste de blocage, ou « blocklist "
"list »."
msgstr ""
"यह omega-serv है। WAF की ब्लॉकलिस्ट में मौजूद पते (WAF का स्वचालित प्रतिबंध,"
" मैन्युअल प्रतिबंध या RIPOSTE का स्थानीय प्रतिबंध) को प्रतिबंध की पूरी अवधि "
"में अपने सभी अनुरोधों पर 451 पेज “आपका IP प्रतिबंधित कर दिया गया है” मिलता "
"है। 403 केवल एक अनुरोध को अस्वीकार करता है (कोई नियम लागू हुआ), प्रतिबंध "
"नहीं लगाता। fail2ban का प्रतिबंध फ़ायरवॉल पर काम करता है: वह कभी कोई पेज "
"नहीं लौटाता, कनेक्शन कट जाता है या बनता ही नहीं। किसने प्रतिबंध लगाया, यह "
"ब्लॉकलिस्ट में प्रतिबंध के स्रोत से पता चलता है (« auto » = WAF का स्वचालित "
"प्रतिबंध, « riposte », « manual »): WAF → मॉड्यूल → ब्लॉकलिस्ट, या « "
"blocklist list »।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:693
msgid "À quoi servent les jails omega-serv-riposte-1h, -6h, -24h et -7d ?"
msgstr "omega-serv-riposte-1h, -6h, -24h और -7d jail किस काम के हैं?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:695
msgid ""
"Ce sont les jails fail2ban du ban réseau de RIPOSTE, installés par omega-"
"jail (1.1.0 ou plus). Quand une politique « ban local + ban réseau » bannit,"
" omega-serv pose d'abord le ban local, puis écrit une ligne dans « "
"var/log/riposte-decisions.jsonl » ; fail2ban la lit et bannit l'adresse au "
"pare-feu. Les jails ont une durée fixe : chaque palier RIPOSTE va à la plus "
"longue qui ne le dépasse pas (un palier de 2 h va dans la jail de 1 h), et "
"l'interface l'indique. Chaque instance omega-serv a son propre jeu de jails,"
" préfixé par le nom de son service."
msgstr ""
"ये RIPOSTE के नेटवर्क प्रतिबंध के लिए fail2ban jail हैं, जिन्हें omega-jail "
"(1.1.0 या नया) स्थापित करता है। जब “स्थानीय प्रतिबंध + नेटवर्क प्रतिबंध” "
"नीति प्रतिबंध लगाती है, तो omega-serv पहले स्थानीय प्रतिबंध लगाता है, फिर « "
"var/log/riposte-decisions.jsonl » में एक पंक्ति लिखता है; fail2ban उसे पढ़कर"
" फ़ायरवॉल पर पते को प्रतिबंधित करता है। इन jail की अवधि निश्चित है: RIPOSTE "
"का हर स्तर उस सबसे लंबे jail में जाता है जो उससे अधिक न हो (2 घंटे का स्तर 1"
" घंटे के jail में), और इंटरफ़ेस यह दिखाता है। हर omega-serv इंस्टेंस के अपने"
" jail होते हैं, जिनके आगे उसकी सेवा का नाम लगा होता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:705
msgid ""
"J'ai mis à jour omega-jail, mais les jails RIPOSTE n'apparaissent ni dans "
"fail2ban ni dans omega-fire"
msgstr ""
"मैंने omega-jail अपडेट किया, पर RIPOSTE jail न fail2ban में दिखते हैं न "
"omega-fire में"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:707
msgid ""
"Mettre à jour omega-jail ne suffit pas à installer ses nouveaux jails. "
"Extrayez l'archive par-dessus le dossier existant, puis lancez « "
"./install.sh » : il liste les jails du catalogue pas encore installés et "
"propose de les installer (« sudo »). À défaut : « sudo ./omega-jail.sh "
"--apply ». Les jails RIPOSTE ne sont proposés que si le module RIPOSTE est "
"activé dans omega-serv (sinon « source non configurée »). Vérification : « "
"sudo fail2ban-client status ». omega-fire les affiche dès qu'ils sont "
"installés, sans rien à déclarer."
msgstr ""
"केवल omega-jail अपडेट करने से उसके नए jail स्थापित नहीं होते। आर्काइव को "
"मौजूदा फ़ोल्डर के ऊपर निकालें, फिर « ./install.sh » चलाएँ: यह कैटलॉग के अभी "
"तक स्थापित न हुए jail की सूची दिखाता है और उन्हें स्थापित करने का प्रस्ताव "
"देता है (« sudo »)। अन्यथा: « sudo ./omega-jail.sh --apply »। RIPOSTE jail "
"तभी प्रस्तावित होते हैं जब omega-serv में RIPOSTE मॉड्यूल सक्रिय हो (अन्यथा "
"“स्रोत कॉन्फ़िगर नहीं”)। जाँच: « sudo fail2ban-client status »। स्थापित होते"
" ही omega-fire उन्हें दिखाता है, कुछ घोषित करने की ज़रूरत नहीं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:717
msgid ""
"Derrière Tailscale Funnel ou un proxy local, le ban réseau sert-il à quelque"
" chose ?"
msgstr ""
"Tailscale Funnel या स्थानीय प्रॉक्सी के पीछे क्या नेटवर्क प्रतिबंध का कोई "
"फ़ायदा है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:719
msgid ""
"Pas le ban fail2ban seul : les connexions arrivent alors du proxy local "
"(tailscaled, 127.0.0.1), pas du visiteur, et le ban pare-feu ne le touche "
"pas. omega-jail (1.1.0 ou plus) le détecte et relaie alors chaque ban "
"fail2ban d'une adresse publique dans la liste de blocage d'omega-serv : "
"l'adresse reçoit la page 451, comme avec le script Magnet. Les jails RIPOSTE"
" ne sont pas relayés : RIPOSTE a déjà posé son ban local (451). Quand les "
"visiteurs se connectent directement au serveur, le ban pare-feu agit seul."
msgstr ""
"केवल fail2ban का प्रतिबंध नहीं: तब कनेक्शन आगंतुक से नहीं, बल्कि स्थानीय "
"प्रॉक्सी (tailscaled, 127.0.0.1) से आते हैं, और फ़ायरवॉल का प्रतिबंध आगंतुक "
"तक नहीं पहुँचता। omega-jail (1.1.0 या नया) इसे पहचानता है और तब किसी "
"सार्वजनिक पते के हर fail2ban प्रतिबंध को omega-serv की ब्लॉकलिस्ट में भेजता "
"है: पते को Magnet स्क्रिप्ट की तरह 451 पेज मिलता है। RIPOSTE jail आगे नहीं "
"भेजे जाते: RIPOSTE अपना स्थानीय प्रतिबंध (451) पहले ही लगा चुका है। जब "
"आगंतुक सीधे सर्वर से जुड़ते हैं, तब फ़ायरवॉल प्रतिबंध अकेले काम करता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:728
msgid ""
"La jail omega-serv-active-defense fait-elle double emploi avec RIPOSTE ?"
msgstr "क्या omega-serv-active-defense jail RIPOSTE के काम को दोहराता है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:730
msgid ""
"En partie. Cette jail d'omega-jail bannit au pare-feu pendant 24 h fixes "
"toute adresse classée hostile ou contained par Active Defense, sans tenir "
"compte des paliers RIPOSTE : une adresse peut donc être bannie au niveau "
"réseau plus tôt ou plus longtemps que le palier choisi. L'écran État de "
"RIPOSTE la signale. Gardez-la si vous voulez ce filet de sécurité ; retirez-"
"la (gestion des jails d'omega-fire) si seuls les paliers RIPOSTE doivent "
"compter."
msgstr ""
"आंशिक रूप से। omega-jail का यह jail Active Defense द्वारा hostile या "
"contained वर्गीकृत किसी भी पते को RIPOSTE के स्तरों की परवाह किए बिना "
"फ़ायरवॉल पर निश्चित 24 घंटे के लिए प्रतिबंधित करता है: इसलिए कोई पता नेटवर्क"
" स्तर पर चुने गए स्तर से पहले या अधिक समय तक प्रतिबंधित हो सकता है। RIPOSTE "
"की स्थिति स्क्रीन इसकी सूचना देती है। यह सुरक्षा जाल चाहिए तो इसे रखें; यदि "
"केवल RIPOSTE के स्तर गिने जाने चाहिए तो इसे हटाएँ (omega-fire का jail "
"प्रबंधन)।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:739
msgid "Mon attaque de test ne déclenche aucun ban RIPOSTE - pourquoi ?"
msgstr "मेरा परीक्षण हमला कोई RIPOSTE प्रतिबंध नहीं लगाता - क्यों?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:741
msgid ""
"Dans l'ordre : (1) la requête doit toucher une règle du WAF, ce qui donne un"
" 403 (par exemple « /?id=1 UNION SELECT 1 » ou « /.env ») ; une simple 404 "
"n'est pas une attaque ; (2) l'adresse ne doit pas être exemptée : hôte "
"local, Tailscale et réseau local ne sont jamais bannis, testez depuis une "
"adresse publique (4G) et, derrière un proxy, réglez le proxy de confiance ; "
"(3) la politique doit être remplie : nombre d'épisodes, classes d'attaque et"
" niveau Active Defense minimal (« aucun » pour un test) ; (4) une adresse "
"déjà bannie (page 451, souvent par l'auto-ban du WAF) n'est plus analysée : "
"RIPOSTE ignore les refus de la liste de blocage, levez d'abord ce ban. "
"Simuler la même situation montre ce qui manque."
msgstr ""
"क्रम से: (1) अनुरोध को WAF का कोई नियम छूना चाहिए, जिससे 403 मिले (जैसे « "
"/?id=1 UNION SELECT 1 » या « /.env »); साधारण 404 हमला नहीं है; (2) पता "
"छूट-प्राप्त नहीं होना चाहिए: स्थानीय होस्ट, Tailscale और स्थानीय नेटवर्क कभी"
" प्रतिबंधित नहीं होते, किसी सार्वजनिक पते (4G) से परीक्षण करें और प्रॉक्सी "
"के पीछे हों तो विश्वसनीय प्रॉक्सी सेट करें; (3) नीति की शर्तें पूरी होनी "
"चाहिए: एपिसोड की संख्या, हमले की श्रेणियाँ और न्यूनतम Active Defense स्तर "
"(परीक्षण के लिए “कोई नहीं”); (4) पहले से प्रतिबंधित पते (451 पेज, अक्सर WAF "
"के स्वचालित प्रतिबंध से) का अब विश्लेषण नहीं होता: RIPOSTE ब्लॉकलिस्ट के "
"अस्वीकारों को अनदेखा करता है, पहले वह प्रतिबंध हटाएँ। वही स्थिति सिम्युलेट "
"करने से पता चलता है कि क्या कमी है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:752
msgid ""
"Active Defense tient-il compte des bans posés par fail2ban ou omega-fire ?"
msgstr ""
"क्या Active Defense, fail2ban या omega-fire द्वारा लगाए गए प्रतिबंधों को "
"ध्यान में रखता है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:754
msgid ""
"Oui, quand omega-connect relie vos outils : omega-fire (ses bans manuels) et"
" omega-jail (action fail2ban de ses jails, et de ceux choisis avec « "
"--journal sshd ») publient chaque ban dans le journal des bans de la zone "
"omega-connect. Active Defense le relit toutes les 5 secondes, sans "
"redémarrage : une requête suspecte d'une adresse bannie ailleurs gagne 25 "
"points. Les jails RIPOSTE d'omega-serv sont ignorés (sinon une même attaque "
"serait comptée deux fois). Le service doit être dans le groupe omega-"
"synchro, ce que règle omega-connect."
msgstr ""
"हाँ, जब omega-connect आपके टूल जोड़ता है: omega-fire (उसके मैनुअल प्रतिबंध) "
"और omega-jail (उसके jail और « --journal sshd » से चुने गए jail का fail2ban "
"action) हर प्रतिबंध omega-connect ज़ोन के प्रतिबंध-जर्नल में प्रकाशित करते "
"हैं। Active Defense इसे बिना पुनः आरंभ हर 5 सेकंड में दोबारा पढ़ता है: कहीं "
"और प्रतिबंधित पते से आया संदिग्ध अनुरोध 25 अंक पाता है। omega-serv के "
"RIPOSTE jail अनदेखे किए जाते हैं (वरना एक ही हमला दो बार गिना जाता)। सेवा को"
" omega-synchro समूह में होना चाहिए, जिसे omega-connect सेट करता है।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:764
msgid "Pourquoi omega-fire n'affiche-t-il que les bans fail2ban ?"
msgstr "omega-fire केवल fail2ban के प्रतिबंध क्यों दिखाता है?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:766
msgid ""
"omega-fire lit fail2ban et le pare-feu. Les bans d'omega-serv (liste de "
"blocage du WAF, page 451 : auto-ban, ban manuel, ban local RIPOSTE) se "
"consultent pour l'instant dans omega-serv : WAF → Modules → Liste de "
"blocage, écran Actions de RIPOSTE, ou « blocklist list ». Les jails "
"installés par omega-jail, dont ceux de RIPOSTE, apparaissent bien dans "
"omega-fire."
msgstr ""
"omega-fire fail2ban और फ़ायरवॉल को पढ़ता है। omega-serv के प्रतिबंध (WAF की "
"ब्लॉकलिस्ट, 451 पेज: स्वचालित प्रतिबंध, मैन्युअल प्रतिबंध, RIPOSTE का "
"स्थानीय प्रतिबंध) अभी omega-serv में देखे जाते हैं: WAF → मॉड्यूल → "
"ब्लॉकलिस्ट, RIPOSTE की कार्रवाइयाँ स्क्रीन, या « blocklist list »। omega-"
"jail द्वारा स्थापित jail, RIPOSTE वाले भी, omega-fire में दिखते हैं।"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:773
#: src/omega_serv/interfaces/tui/guide/content/faq.py:799
#: src/omega_serv/interfaces/tui/guide/content/faq.py:817
