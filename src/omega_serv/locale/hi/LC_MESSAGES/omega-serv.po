#: src/omega_serv/domain/security/tls/validation.py:143
msgid "la clé privée TLS ne correspond pas au certificat configuré"
msgstr "TLS private key कॉन्फ़िगर किए गए सर्टिफ़िकेट से मेल नहीं खाती"

#: src/omega_serv/domain/security/tls/validation.py:173
msgid "la clé privée source est introuvable"
msgstr "स्रोत private key नहीं मिली"

#: src/omega_serv/domain/security/tls/validation.py:175
msgid "le certificat source est introuvable"
msgstr "स्रोत सर्टिफ़िकेट नहीं मिला"

#: src/omega_serv/domain/security/tls/validation.py:177
msgid "le fichier de chaîne intermédiaire indique est introuvable"
msgstr "बताई गई intermediate chain फ़ाइल नहीं मिली"

#: src/omega_serv/domain/security/tls/validation.py:179
