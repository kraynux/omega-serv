#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:320
msgid "Nombre d'échantillons lisses par moyenne glissante (entier >= 1)"
msgstr "चलती औसत में smoothed नमूनों की संख्या (पूर्णांक >= 1)"

#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:325
msgid ""
"Âge maximal d'un échantillon de charge avant d'être considéré périmé "
