msgid "Relie une instance avec son code d'appairage."
msgstr "पेयरिंग कोड से एक इंस्टेंस लिंक करता है।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:117
msgid "Code affiché par l'instance (comme K7QF-3M9X)."
msgstr "इंस्टेंस द्वारा दिखाया गया कोड (जैसे K7QF-3M9X)।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:120
msgid "Ajoute une sonde HTTP (backend qui n'est pas omega-serv)."
msgstr "एक HTTP जाँच जोड़ता है (ऐसा बैकएंड जो omega-serv नहीं है)।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:121
msgid "URL sondée (http://... ou https://...)."
msgstr "जाँचा जाने वाला URL (http://... या https://...)।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:124
msgid "Retire une instance suivie ou une sonde (identifiant de « list »)."
msgstr "ट्रैक किया गया इंस्टेंस या जाँच हटाता है (« list » से पहचानकर्ता)।"

#: src/omega_serv/interfaces/cli/admin_web_entry.py:126
