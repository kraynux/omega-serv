msgid "INSTALLER L'UNITÉ SYSTEMD"
msgstr "SYSTEMD यूनिट इंस्टॉल करें"

#: src/omega_serv/interfaces/tui/screens/service_screen.py:429
#, python-brace-format
msgid ""
"Service : {value}\n"
"Utilisateur/groupe dédiés : {DEFAULT_SYSTEM_USER}/{DEFAULT_SYSTEM_GROUP}\n"
"Une authentification (sudo) sera demandée pour l'écriture dans /etc/systemd/system/ et le rechargement de systemd. Continuer ?"
msgstr ""
"सर्विस: {value}\n"
"समर्पित उपयोगकर्ता/समूह: {DEFAULT_SYSTEM_USER}/{DEFAULT_SYSTEM_GROUP}\n"
"/etc/systemd/system/ में लिखने और systemd रीलोड करने के लिए प्रमाणीकरण (sudo) माँगा जाएगा। जारी रखें?"

#: src/omega_serv/interfaces/tui/screens/service_screen.py:438
msgid "DÉSINSTALLER L'UNITÉ SYSTEMD"
msgstr "SYSTEMD यूनिट अनइंस्टॉल करें"

#: src/omega_serv/interfaces/tui/screens/service_screen.py:439
msgid ""
"Retirer l'unité du service {value!r} ? Une authentification (sudo) sera "
