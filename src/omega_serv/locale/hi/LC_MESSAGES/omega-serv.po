msgstr "अमान्य मूल (छोटे अक्षर, अंक, . _ : -, अधिकतम 64 वर्ण): {origin!r}"

#: src/omega_serv/domain/security/waf/blocklist.py:67
msgid "origine réservée à omega-serv : {origin!r}"
msgstr "omega-serv के लिए आरक्षित मूल: {origin!r}"

#: src/omega_serv/domain/security/waf/blocklist.py:75
msgid "network invalide (attendu une IP ou un CIDR) : {network!r}"
msgstr "अमान्य network (IP या CIDR अपेक्षित): {network!r}"

#: src/omega_serv/domain/security/waf/blocklist.py:77
msgid "reason ne peut pas être vide"
msgstr "reason खाली नहीं हो सकता"

#: src/omega_serv/domain/security/waf/blocklist.py:79
