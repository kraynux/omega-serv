msgstr ""
"डायरेक्ट मोड में tls सक्रिय होने पर tls.certificate.private_key_path खाली "
"नहीं हो सकता"

#: src/omega_serv/domain/security/tls/validation.py:55
#: src/omega_serv/domain/security/tls/validation.py:72
#: src/omega_serv/domain/security/tls/validation.py:85
msgid "common_name (CN) ne peut pas être vide"
msgstr "common_name (CN) खाली नहीं हो सकता"

#: src/omega_serv/domain/security/tls/validation.py:57
#: src/omega_serv/domain/security/tls/validation.py:87
msgid ""
"au moins un SAN (DNS ou IP) est requis - le CN seul n'est plus suffisant "
"(doc TLS §6.2)"
msgstr ""
"कम से कम एक SAN (DNS या IP) आवश्यक है - अकेला CN अब पर्याप्त नहीं (TLS "
"दस्तावेज़ §6.2)"

#: src/omega_serv/domain/security/tls/validation.py:61
#: src/omega_serv/domain/security/tls/validation.py:78
#: src/omega_serv/domain/security/tls/validation.py:89
