msgstr "JavaScript के लिए अनुमत origins/तंत्र - 'unsafe-inline'/'unsafe-eval' सबसे जोखिम भरी ढील हैं।"

#: src/omega_serv/domain/security/csp.py:67
msgid "Origines autorisées pour les polices."
msgstr "फ़ॉन्ट के लिए अनुमत origins।"

#: src/omega_serv/domain/security/csp.py:68
msgid "Destinations autorisées pour fetch/XHR/WebSocket - restreint l'exfiltration de données."
msgstr "fetch/XHR/WebSocket के लिए अनुमत गंतव्य - डेटा बाहर भेजे जाने को सीमित करता है।"

#: src/omega_serv/domain/security/csp.py:69
msgid "Autorise <object>/<embed>/<applet> - 'none' recommandé (vecteur historique Flash/plugins)."
msgstr "<object>/<embed>/<applet> की अनुमति देता है - 'none' अनुशंसित (Flash/प्लगइन का पुराना हमला मार्ग)।"

