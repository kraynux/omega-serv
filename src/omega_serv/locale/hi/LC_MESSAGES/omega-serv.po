msgstr "अमान्य key_type: {key_type!r} (अपेक्षित: {value})"

#: src/omega_serv/domain/security/tls/validation.py:74
msgid "key_password est obligatoire pour une CA locale (doc TLS §7.2/§7.3)"
msgstr "लोकल CA के लिए key_password अनिवार्य है (TLS दस्तावेज़ §7.2/§7.3)"

#: src/omega_serv/domain/security/tls/validation.py:126
#, python-brace-format
msgid ""
"clé privée TLS lisible par le groupe ou les autres (mode {value}, attendu "
"0600 ou plus strict - doc TLS §4.1/§21)"
msgstr ""
"TLS private key समूह या अन्य द्वारा पढ़ने योग्य है (मोड {value}, अपेक्षित "
"0600 या अधिक सख्त - TLS दस्तावेज़ §4.1/§21)"

#: src/omega_serv/domain/security/tls/validation.py:131
#, python-brace-format
msgid "certificat TLS expiré depuis le {value}"
msgstr "TLS सर्टिफ़िकेट {value} से समाप्त हो चुका है"

#: src/omega_serv/domain/security/tls/validation.py:139
#, python-brace-format
