msgstr "कोई जारी कार्रवाई नहीं।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:121
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:125
msgid "Aucune action terminée."
msgstr "कोई समाप्त कार्रवाई नहीं।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:125
#: src/omega_serv/interfaces/cli/riposte_text.py:252
msgid "Arrêt d'urgence : ACTIF"
msgstr "आपातकालीन रोक: सक्रिय"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:147
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:137
#, python-brace-format
msgid "Créée le {when} (événement {event})"
msgstr "{when} को बनाई गई (घटना {event})"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:150
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:141
#, python-brace-format
msgid "Leurre {profile} pour : {subjects}"
msgstr "डिकॉय {profile} के लक्ष्य: {subjects}"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:153
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:144
#, python-brace-format
msgid "Terminée le {when} : {by}"
msgstr "{when} को समाप्त: {by}"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:158
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:149
msgid "Ne compte pas dans la récidive."
msgstr "पुनरावृत्ति में नहीं गिना जाता।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:192
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:82
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:243
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:285
#, python-brace-format
msgid "Politique inconnue : {id}"
msgstr "अज्ञात नीति: {id}"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:195
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:288
msgid "Configuration RIPOSTE invalide : "
msgstr "अमान्य RIPOSTE कॉन्फ़िगरेशन: "

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:197
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:290
#, python-brace-format
msgid "Politique {id} activée."
msgstr "नीति {id} सक्रिय की गई।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:197
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:245
#, python-brace-format
msgid "Politique {id} désactivée."
msgstr "नीति {id} निष्क्रिय की गई।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:207
msgid ""
"Les actions déjà en cours de cette politique vont jusqu'à leur échéance (« "
"--revoke » pour les lever)."
msgstr ""
"इस नीति की पहले से जारी कार्रवाइयाँ समाप्ति तक चलती रहेंगी (हटाने के लिए '--"
"revoke')।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:239
msgid ""
"Aucune exemption ajoutée (les exclusions de la configuration s'appliquent "
"toujours)."
msgstr "कोई जोड़ी गई छूट नहीं (कॉन्फ़िगरेशन की छूटें हमेशा लागू होती हैं)।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:241
#, python-brace-format
msgid "{network}  jusqu'au {until}  (action {action})"
msgstr "{network}  {until} तक  (कार्रवाई {action})"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:243
#: src/omega_serv/interfaces/tui/screens/riposte_settings_screen.py:136
msgid "retrait manuel"
msgstr "मैन्युअल रूप से हटाएँ"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:268
msgid ""
"Arrêt d'urgence ACTIF : aucune nouvelle action, même après un redémarrage, "
"jusqu'à « riposte resume »."
msgstr ""
"आपातकालीन रोक सक्रिय: 'riposte resume' तक कोई नई कार्रवाई नहीं, पुनःआरंभ के "
"बाद भी।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:271
msgid ""
"Les actions en cours vont jusqu'à leur échéance (« --revoke » pour les "
"lever)."
msgstr "जारी कार्रवाइयाँ समाप्ति तक चलती रहेंगी (हटाने के लिए '--revoke')।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:294
msgid "Identifiant de l'action (voir riposte actions list)."
msgstr "कार्रवाई का पहचानकर्ता (riposte actions list देखें)।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:295
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:236
msgid "Identifiant de la politique (voir riposte policies list)."
msgstr "नीति का पहचानकर्ता (riposte policies list देखें)।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:296
msgid "Bans et leurres posés par RIPOSTE."
msgstr "RIPOSTE द्वारा लगाए गए बैन और डिकॉय।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:297
msgid ""
"Une commande est exécutée par le processus RIPOSTE en moins d'une seconde, "
"ou à son prochain démarrage s'il est arrêté."
msgstr ""
"RIPOSTE प्रोसेस कमांड को एक सेकंड से कम में चलाता है, या रुका हो तो अगली बार"
" शुरू होने पर।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:299
msgid "Liste les actions en cours."
msgstr "चल रही कार्रवाइयों की सूची दिखाता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:300
msgid "Liste les actions terminées à la place."
msgstr "इसके बजाय समाप्त कार्रवाइयों की सूची दिखाता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:301
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:271
msgid "Seulement cette adresse."
msgstr "केवल यह पता।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:302
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:226
msgid "Nombre maximal de lignes (défaut : 50)."
msgstr "अधिकतम पंक्तियाँ (डिफ़ॉल्ट: 50)।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:304
msgid "Affiche le détail d'une action."
msgstr "किसी कार्रवाई का विवरण दिखाता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:307
msgid "Lève une action."
msgstr "एक कार्रवाई हटाता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:310
msgid ""
"Exempte aussi l'adresse : 24 h, 7 jours ou jusqu'à levée manuelle (forever)."
msgstr ""
"पते को छूट भी देता है: 24 घंटे, 7 दिन या हाथ से हटाए जाने तक (forever)।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:312
msgid "Ne compte pas cette action dans la récidive."
msgstr "इस कार्रवाई को दोहराव में नहीं गिनता।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:315
msgid "Ne compte pas une action dans la récidive, sans la lever."
msgstr "किसी कार्रवाई को हटाए बिना, उसे दोहराव में नहीं गिनता।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:319
msgid "Active une politique."
msgstr "एक नीति सक्रिय करता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:322
msgid "Désactive une politique."
msgstr "एक नीति निष्क्रिय करता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:324
msgid "Lève aussi ses actions en cours."
msgstr "उसकी चल रही कार्रवाइयाँ भी हटाता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:327
msgid "Efface la mémoire d'une source : ses récidives repartent de zéro."
msgstr ""
"किसी स्रोत की स्मृति मिटाता है: उसका दोहराव फिर से शून्य से गिना जाता है।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:328
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:241
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:265
msgid "Adresse de la source."
msgstr "स्रोत का पता।"

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:331
msgid "Adresses exemptées de RIPOSTE."
msgstr "RIPOSTE से छूट प्राप्त पते।"

