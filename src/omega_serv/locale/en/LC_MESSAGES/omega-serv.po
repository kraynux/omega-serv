msgstr "Confirm: public bind + self-signed certificate"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:142
msgid "Porte de confirmation explicite requise pour continuer si le serveur écoute publiquement avec un certificat auto-signé (jamais reconnu par les navigateurs)."
msgstr "Explicit confirmation gate required to continue if the server listens publicly with a self-signed certificate (never trusted by browsers)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:145
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:155
msgid "À cocher uniquement si cette combinaison est réellement voulue."
msgstr "Check only if this combination is really intended."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:146
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:156
msgid "Pris en compte au prochain clic sur Vérifier."
msgstr "Taken into account at the next click on Check."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:147
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:157
