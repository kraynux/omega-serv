msgstr "No additional input."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr "Refresh runs the scan again; exports write a timestamped file."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid "Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "No effect on the server or its configuration (read-only + export)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "Advisory/export only."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "Capability detail"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "Capability registry -> click on a row"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid "Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : statut, raison, détails techniques, date du dernier scan."
msgstr "Full detail of an already scanned capability (never a new scan): status, reason, technical details, date of the last scan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:190
