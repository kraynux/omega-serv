#: src/omega_serv/interfaces/tui/guide/content/routage.py:163
#: src/omega_serv/interfaces/tui/guide/content/routage.py:170
#: src/omega_serv/interfaces/tui/guide/content/routage.py:181
#: src/omega_serv/interfaces/tui/guide/content/routage.py:227
#: src/omega_serv/interfaces/tui/guide/content/routage.py:240
#: src/omega_serv/interfaces/tui/guide/content/routage.py:329
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:121
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:128
