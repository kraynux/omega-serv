#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:153
msgid "Aucun effet sans rechargement du service."
msgstr "Tidak ada efek tanpa muat ulang layanan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:415
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Extensions"
msgstr "Ekstensi"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:417
msgid "Restreint la règle aux chemins se terminant par l'une de ces extensions - vide signifie 'toutes', la règle s'applique alors à tout chemin sous ce préfixe."
msgstr "Membatasi aturan pada jalur yang berakhiran salah satu ekstensi ini - kosong berarti 'semua', aturan berlaku untuk setiap jalur di bawah prefiks ini."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:420
msgid "Liste séparée par des virgules, ex: .key, .pem. Vide par défaut (toutes)."
msgstr "Daftar dipisahkan koma, mis.: .key, .pem. Kosong secara bawaan (semua)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:426
msgid "L'option access_control doit être activée (écran Options) pour que ces règles soient réellement appliquées. Toutes les modifications se rechargent à chaud."
msgstr "Opsi access_control harus diaktifkan (layar Opsi) agar aturan ini benar-benar diterapkan. Semua perubahan dimuat ulang saat berjalan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:431
msgid "Le plus long préfixe correspondant gagne : une règle 'allow' plus spécifique lève le 'deny' d'un préfixe parent (ex: deny /private/, allow /private/.assets/). Une règle 'allow' explicite lève aussi les règles génériques dotfiles/motifs de l'écran Sécurité générique sur ce chemin précis."
msgstr "Prefiks terpanjang yang cocok menang: aturan 'allow' yang lebih spesifik mencabut 'deny' dari prefiks induk (mis.: deny /private/, allow /private/.assets/). Aturan 'allow' eksplisit juga mencabut aturan umum dotfile/pola dari layar Keamanan umum pada jalur tersebut."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:437
msgid "Pour bloquer une extension sensible PARTOUT sauf dans une zone : une règle deny sur '/' avec l'extension visée, puis une règle allow (sans extension) sur le préfixe à excepter - le préfixe le plus spécifique l'emporte."
msgstr "Untuk memblokir ekstensi sensitif DI MANA-MANA kecuali di satu zona: aturan deny pada '/' dengan ekstensi yang dituju, lalu aturan allow (tanpa ekstensi) pada prefiks yang dikecualikan - prefiks paling spesifik menang."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:12
msgid "Accueil -> Registre des capacités"
msgstr "Beranda -> Registri kapabilitas"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:13
msgid "Scan complet de l'environnement (port libre, openssl présent, PHP-FPM si FastCGI actif...), avec export."
msgstr "Pemindaian lengkap lingkungan (port bebas, openssl ada, PHP-FPM jika FastCGI aktif...), dengan ekspor."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:16
#: src/omega_serv/interfaces/tui/guide/content/logs.py:436
#: src/omega_serv/interfaces/tui/screens/capabilities_screen.py:52
#: src/omega_serv/interfaces/tui/screens/export_log_archives_screen.py:43
msgid "Thème d'export HTML"
msgstr "Tema ekspor HTML"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "Palet warna untuk ekspor HTML."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:438
msgid "5 thèmes disponibles."
msgstr "5 tema tersedia."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:439
msgid "Utilisé au clic sur Exporter HTML."
msgstr "Digunakan saat mengeklik Ekspor HTML."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/logs.py:282
#: src/omega_serv/interfaces/tui/guide/content/logs.py:440
msgid "Aucun effet sur le serveur."
msgstr "Tidak ada efek pada server."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "Segarkan / Ekspor JSON / Ekspor HTML"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "Menjalankan ulang pemindaian, atau mengekspor hasilnya."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:445
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:246
msgid "Aucune saisie supplémentaire."
msgstr "Tidak perlu isian tambahan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr "Segarkan menjalankan ulang pemindaian; ekspor menulis berkas bercap waktu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid "Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "Tidak ada efek pada server atau konfigurasinya (hanya baca + ekspor)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "Murni untuk melihat/ekspor."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "Detail kapabilitas"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "Registri kapabilitas -> klik pada baris"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid "Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : statut, raison, détails techniques, date du dernier scan."
msgstr "Detail lengkap kapabilitas yang sudah dipindai (tidak pernah pindai ulang): status, alasan, detail teknis, tanggal pemindaian terakhir."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:196
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:329
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:501
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:171
msgid "Purement consultatif."
msgstr "Murni untuk melihat."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "Beranda -> Profil"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid "Liste et décrit les 4 profils de base preconfigures (minimal/standard/hardened/development)."
msgstr "Menampilkan dan menjelaskan 4 profil dasar praset (minimal/standard/hardened/development)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:49
#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:39
msgid "Appliquer"
msgstr "Terapkan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "Membuka layar konfirmasi penerapan profil yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Sélectionner un profil active ce bouton."
msgstr "Memilih profil mengaktifkan tombol ini."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Ouvre ApplyProfileScreen."
msgstr "Membuka ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Aucun effet ici - voir la fiche d'ApplyProfileScreen."
msgstr "Tidak ada efek di sini - lihat lembar ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:56
msgid "Purement consultatif - aucune modification depuis cet écran lui-même."
msgstr "Murni untuk melihat - tidak ada perubahan dari layar ini sendiri."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "Terapkan profil"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Profils -> Appliquer"
msgstr "Profil -> Terapkan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid "Affiche TOUJOURS la différence complète avant toute confirmation, puis écrase la configuration active avec le profil choisi."
msgstr "SELALU menampilkan perbedaan lengkap sebelum konfirmasi apa pun, lalu menimpa konfigurasi aktif dengan profil yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Confirme et écrit le profil choisi."
msgstr "Mengonfirmasi dan menulis profil yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid "Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "Diff lengkap sudah ditampilkan di atas - periksa sebelum mengeklik."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid "Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr "Menimpa config/omega-serve.json dengan konfigurasi yang disusun dari profil."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:71
msgid "Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire ; sinon un simple rechargement suffit (automatique si un service actif existe)."
msgstr "Profil dapat mengubah pengaturan APA PUN sekaligus. Jika bind/port/listen_backlog/TLS berubah, MULAI ULANG PENUH diperlukan; jika tidak, muat ulang biasa cukup (otomatis jika ada layanan aktif)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:77
msgid "Des conflits ou erreurs de validation bloquants demandent une confirmation supplémentaire explicite pour forcer quand même."
msgstr "Konflik atau kesalahan validasi yang menghalangi meminta konfirmasi eksplisit tambahan untuk tetap memaksakan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid "Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste de la configuration active est conservé tel quel."
msgstr "Profil HANYA mengubah bidang yang ditentukannya secara eksplisit - sisa konfigurasi aktif tetap seperti semula."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Accueil -> Audit de sécurité"
msgstr "Beranda -> Audit keamanan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...) - mêmes règles que l'audit CLI."
msgstr "Pemeriksaan saran (layanan, rotasi log, mode WAF...) - aturan yang sama dengan audit CLI."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:52
msgid "Auditer"
msgstr "Audit"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:91
msgid "Relance explicitement l'audit."
msgstr "Menjalankan ulang audit secara eksplisit."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:92
msgid "Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "Tidak perlu isian - audit pertama sudah berjalan otomatis saat layar dibuka."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "Membaca ulang konfigurasi dan menghitung ulang semua aturan audit."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:221
msgid "Aucun effet sur le serveur (lecture seule) - notifie explicitement le résultat sur un clic explicite."
msgstr "Tidak ada efek pada server (hanya baca) - memberi tahu hasilnya secara eksplisit saat diklik."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "Murni untuk melihat - tidak pernah mengubah apa pun."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Accueil -> Sauvegarde de configuration"
msgstr "Beranda -> Cadangan konfigurasi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:104
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration - le fichier de configuration est toujours inclus, jamais chiffre par défaut."
msgstr "Membuat, melihat daftar, memulihkan, atau menghapus cadangan lengkap konfigurasi - berkas konfigurasi selalu disertakan, tidak pernah dienkripsi secara bawaan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:107
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:51
msgid "Tout sauvegarder (configuration complète)"
msgstr "Cadangkan semuanya (konfigurasi lengkap)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid "Coche toutes les cases : de quoi retrouver la configuration entière et ses modules."
msgstr "Mencentang semua kotak: semua yang diperlukan untuk memulihkan seluruh konfigurasi dan modulnya."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
msgid "Case à cocher ; les secrets (zones Auth, clés TLS) restent confirmés à la création."
msgstr "Kotak centang; rahasia (zona Auth, kunci TLS) tetap dikonfirmasi saat pembuatan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:110
#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
#: src/omega_serv/interfaces/tui/guide/content/divers.py:135
#: src/omega_serv/interfaces/tui/guide/content/divers.py:142
#: src/omega_serv/interfaces/tui/guide/content/divers.py:149
msgid "Pris en compte à la création."
msgstr "Diperhitungkan saat pembuatan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:111
msgid "Ce qui est désigné hors du dossier omega-serv (ex. un certificat dans /etc) n'est jamais archivé, et c'est indiqué après la création."
msgstr "Apa pun yang berada di luar folder omega-serv (mis. sertifikat di /etc) tidak pernah diarsipkan, dan hal ini diberitahukan setelah pembuatan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:115
msgid "RIPOSTE, pages d'erreur, préférences, bibliothèque des journaux"
msgstr "RIPOSTE, halaman galat, preferensi, pustaka log"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:116
msgid "Base RIPOSTE ; pages d'erreur personnalisées ; thème, langues et nom du service ; favoris, sources distantes et rotations planifiées des journaux."
msgstr "Basis data RIPOSTE; halaman galat kustom; tema, bahasa, dan nama layanan; favorit, sumber jarak jauh, dan rotasi log terjadwal."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
msgid "Cases à cocher. Les règles WAF comprennent aussi les listes de mots-clés et les scripts Magnet."
msgstr "Kotak centang. Aturan WAF juga mencakup daftar kata kunci dan skrip Magnet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:119
msgid "Pris en compte à la création ; les bases (Active Defense, RIPOSTE) sont copiées de façon cohérente, serveur en marche."
msgstr "Diperhitungkan saat pembuatan; basis data (Active Defense, RIPOSTE) disalin secara konsisten saat server berjalan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:121
msgid "Une sauvegarde qui contient une base n'est jamais restaurée sous un serveur actif : « Arrêter, restaurer, redémarrer » est proposé, et les bases actuelles sont mises de côté."
msgstr "Cadangan yang berisi basis data tidak pernah dipulihkan saat server aktif: ditawarkan « Hentikan, pulihkan, mulai ulang », dan basis data saat ini disisihkan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid "Inclure les règles WAF"
msgstr "Sertakan aturan WAF"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:126
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "Menambahkan aturan WAF dan daftar blokir ke cadangan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:127
#: src/omega_serv/interfaces/tui/guide/content/divers.py:148
msgid "Case à cocher."
msgstr "Kotak centang."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:129
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "Tidak ada efek langsung - hanya isi cadangan yang dibuat."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:132
msgid "Inclure les zones d'authentification"
msgstr "Sertakan zona autentikasi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:133
msgid "Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la sauvegarde."
msgstr "Menambahkan users.json/zones.json (RAHASIA NYATA: hash kata sandi) ke cadangan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:134
#: src/omega_serv/interfaces/tui/guide/content/divers.py:141
msgid "Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "Kotak centang - meminta konfirmasi eksplisit tambahan jika dicentang."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "Cadangan berisi rahasia nyata, tidak pernah dienkripsi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:139
msgid "Inclure les certificats"
msgstr "Sertakan sertifikat"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:140
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "Menambahkan sertifikat TLS, TERMASUK KUNCI PRIVAT, ke cadangan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "Cadangan berisi kunci privat nyata, tidak pernah dienkripsi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:146
msgid "Inclure Active Defense"
msgstr "Sertakan Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr "Menambahkan basis data ancaman/insiden Active Defense ke cadangan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:150
#: src/omega_serv/interfaces/tui/guide/content/divers.py:157
msgid "Aucun effet immédiat."
msgstr "Tidak ada efek langsung."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:153
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:62
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:80
msgid "Description"
msgstr "Deskripsi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:154
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "Catatan bebas yang dilampirkan pada cadangan, agar mudah ditemukan nanti."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid "Texte libre, optionnel."
msgstr "Teks bebas, opsional."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:156
msgid "Enregistrée avec la sauvegarde."
msgstr "Disimpan bersama cadangan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:160
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:72
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "Pulihkan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:161
msgid "Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX MÊMES EMPLACEMENTS."
msgstr "Menimpa berkas saat ini dengan berkas dari cadangan yang dipilih, DI LOKASI YANG SAMA."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:162
#: src/omega_serv/interfaces/tui/guide/content/divers.py:173
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "Pilih cadangan, lalu konfirmasi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:163
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "Penulisan nyata dan langsung pada berkas terkait."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:165
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration peut écraser n'importe quel fichier (configuration, certificats TLS...), et un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr "SELALU memerlukan MULAI ULANG PENUH demi kehati-hatian - pemulihan dapat menimpa berkas apa pun (konfigurasi, sertifikat TLS...), dan sertifikat yang sudah ada di memori tidak pernah dimuat ulang sendiri."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:171
#: src/omega_serv/interfaces/tui/guide/content/logs.py:88
#: src/omega_serv/interfaces/tui/guide/content/logs.py:139
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:69
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:52
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:57
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:65
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:74
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:92
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:51
#: src/omega_serv/interfaces/tui/screens/purge_log_archives_screen.py:38
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:55
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:77
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:162
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:60
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:54
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:70
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:62
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:93
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:195
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:97
msgid "Supprimer"
msgstr "Hapus"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:172
msgid "Supprime définitivement une sauvegarde (n'existe pas côté CLI, confort TUI uniquement)."
msgstr "Menghapus cadangan secara permanen (tidak ada di CLI, hanya kemudahan TUI)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:174
msgid "Suppression immédiate et définitive."
msgstr "Penghapusan langsung dan permanen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:175
msgid "Aucun effet sur le serveur - seulement sur les sauvegardes disponibles."
msgstr "Tidak ada efek pada server - hanya pada cadangan yang tersedia."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:178
msgid "Restaurer écrase directement les fichiers vises, sans filet - la seule protection est la confirmation demandée avant."
msgstr "Memulihkan langsung menimpa berkas yang dituju, tanpa jaring pengaman - satu-satunya perlindungan adalah konfirmasi yang diminta sebelumnya."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:183
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:107
msgid "Réglages de l'application"
msgstr "Pengaturan aplikasi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:184
msgid "Raccourci clavier 'o' (footer), depuis n'importe quel écran"
msgstr "Pintasan keyboard 'o' (footer), dari layar mana pun"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:186
msgid "PRÉFÉRENCES D'INTERFACE uniquement (thème, rendu, chemins d'export/captures) - PAS des réglages du serveur (ceux-là vivent dans Configuration détaillée)."
msgstr "HANYA PREFERENSI ANTARMUKA (tema, tampilan, jalur ekspor/tangkapan) - BUKAN pengaturan server (yang ada di Konfigurasi terperinci)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:192
msgid "Thème visuel de l'interface elle-même."
msgstr "Tema visual antarmuka itu sendiri."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:193
msgid "Un des thèmes disponibles."
msgstr "Salah satu tema yang tersedia."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:194
msgid "Appliqué immédiatement au changement."
msgstr "Langsung diterapkan saat diganti."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:195
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "Efek langsung, tidak perlu mulai ulang."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:198
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:207
msgid "Profil de rendu"
msgstr "Profil tampilan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:199
msgid "Force un profil de rendu Textual particulier plutôt que la détection automatique."
msgstr "Memaksa profil tampilan Textual tertentu, bukan deteksi otomatis."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:200
msgid "Automatique, ou un profil précis."
msgstr "Otomatis, atau profil tertentu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:201
msgid "Enregistre la préférence."
msgstr "Menyimpan preferensi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:202
msgid "Appliqué seulement AU PROCHAIN DÉMARRAGE de l'interface, jamais à chaud."
msgstr "Diterapkan hanya PADA PELUNCURAN BERIKUTNYA antarmuka, tidak pernah saat berjalan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:207
msgid "Langue de l'interface. Chaque langue est écrite dans sa propre langue, Français toujours en tête ; le libellé 'Langue / Language' n'est jamais traduit, pour être retrouvé même dans une langue qu'on ne lit pas. Une langue non encore validée porte la mention 'en test'."
msgstr "Bahasa antarmuka. Setiap bahasa ditulis dalam bahasanya sendiri, Français selalu di atas; label 'Langue / Language' tidak pernah diterjemahkan, agar tetap dapat ditemukan bahkan dalam bahasa yang tidak dapat dibaca. Bahasa yang belum divalidasi diberi keterangan 'sedang diuji'."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:212
msgid "Choisir une langue dans la liste, puis confirmer le redémarrage de l'interface."
msgstr "Pilih bahasa dari daftar, lalu konfirmasi mulai ulang antarmuka."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:214
msgid "Enregistre la langue puis redémarre L'INTERFACE (pas le service : le serveur continue de tourner). Un écran de confirmation affiche la langue et la phrase d'invite déjà traduite."
msgstr "Menyimpan bahasa lalu memulai ulang ANTARMUKA (bukan layanan: server tetap berjalan). Layar konfirmasi menampilkan bahasa dan kalimat ajakan yang sudah diterjemahkan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:218
msgid "Retour au français toujours possible : ce même réglage ; ou lancer une fois 'OMEGA_SERV_LANG=fr serv' ; ou retirer la clé 'language' de var/settings.json. Langue indisponible ou catalogue illisible : l'interface démarre en français avec un message. Les journaux du serveur (journalctl) restent toujours en français."
msgstr "Kembali ke bahasa Prancis selalu mungkin: pengaturan yang sama ini; atau jalankan sekali 'OMEGA_SERV_LANG=fr serv'; atau hapus kunci 'language' dari var/settings.json. Jika bahasa tidak tersedia atau katalog tidak terbaca: antarmuka dimulai dalam bahasa Prancis dengan sebuah pesan. Log server (journalctl) selalu dalam bahasa Prancis."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:225
msgid "Export / Captures d'écran (chemins)"
msgstr "Ekspor / Tangkapan layar (jalur)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:226
msgid "Répertoires où sont écrits les exports et les captures d'écran."
msgstr "Direktori tempat ekspor dan tangkapan layar ditulis."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:227
msgid "Chemin libre - vide revient au répertoire par défaut."
msgstr "Jalur bebas - kosong kembali ke direktori bawaan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:228
msgid "Enregistre à chaque changement de texte."
msgstr "Disimpan setiap kali teks berubah."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:229
msgid "Effet immédiat sur les prochains exports/captures."
msgstr "Efek langsung pada ekspor/tangkapan berikutnya."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:232
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:105
msgid "Langue des exports"
msgstr "Bahasa ekspor"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:234
msgid "Langue des exports HTML (registre des capacités, archives de logs, guide d'aide) et du rapport d'incident Markdown - un fichier qui se diffuse, pas forcément à quelqu'un qui lit la langue de l'interface. Les exports JSON et CSV n'ont pas de texte à traduire."
msgstr "Bahasa ekspor HTML (registri kapabilitas, arsip log, panduan bantuan) dan laporan insiden Markdown - berkas yang dibagikan, belum tentu kepada orang yang membaca bahasa antarmuka. Ekspor JSON dan CSV tidak memiliki teks untuk diterjemahkan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:238
msgid "« Comme l'interface » (défaut) ou une des langues de la liste."
msgstr "« Sama dengan antarmuka » (bawaan) atau salah satu bahasa dalam daftar."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:240
msgid "Enregistre immédiatement. Dans une autre langue que l'interface, chaque export est produit par un processus séparé lancé dans cette langue : quelques secondes, l'interface reste utilisable."
msgstr "Langsung disimpan. Dalam bahasa selain bahasa antarmuka, setiap ekspor dibuat oleh proses terpisah yang dijalankan dalam bahasa tersebut: beberapa detik, antarmuka tetap dapat digunakan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:245
msgid "Si ce processus échoue, l'export HTML n'est pas écrit (raison affichée) ; le rapport d'incident, lui, est quand même écrit dans la langue de l'interface, avec un avertissement."
msgstr "Jika proses itu gagal, ekspor HTML tidak ditulis (alasan ditampilkan); laporan insiden tetap ditulis dalam bahasa antarmuka, disertai peringatan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:250
msgid "Supprimer les exports / Supprimer les screenshots"
msgstr "Hapus ekspor / Hapus tangkapan layar"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:251
msgid "Vide complètement le répertoire concerne."
msgstr "Mengosongkan seluruh direktori terkait."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:252
msgid "Confirmation obligatoire."
msgstr "Konfirmasi wajib."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:253
msgid "Suppression immédiate et définitive de tous les fichiers du répertoire."
msgstr "Penghapusan langsung dan permanen semua berkas di direktori."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:254
msgid "Action irréversible."
msgstr "Tindakan tidak dapat dibatalkan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:257
msgid "Ne touche jamais config/omega-serve.json - réglages purement locaux à cette interface."
msgstr "Tidak pernah menyentuh config/omega-serve.json - pengaturan murni lokal untuk antarmuka ini."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:262
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:108
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:56
msgid "Contact et support"
msgstr "Kontak dan dukungan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:263
msgid "Guide d'aide (touche a) -> Contact et support"
msgstr "Panduan bantuan (tombol a) -> Kontak dan dukungan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:264
msgid "Payer un café au développeur, se déclarer utilisateur anonyme d'omega-serv, ou contacter le support. Les adresses sont toujours affichées en clair."
msgstr "Traktir pengembang kopi, daftarkan diri sebagai pengguna anonim omega-serv, atau hubungi dukungan. Alamat selalu ditampilkan lengkap."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:268
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:45
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:49
msgid "Payer un café"
msgstr "Traktir kopi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:269
msgid "Ouvre la page PayPal du développeur (https://paypal.me/kraynux)."
msgstr "Membuka halaman PayPal pengembang (https://paypal.me/kraynux)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:270
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:159
#: src/omega_serv/interfaces/tui/guide/content/tls.py:27
#: src/omega_serv/interfaces/tui/guide/content/tls.py:228
msgid "Aucune saisie."
msgstr "Tidak perlu isian."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:271
msgid "Ouvre l'adresse dans votre navigateur, même si l'interface tourne sous sudo."
msgstr "Membuka alamat di peramban Anda, meskipun antarmuka berjalan dengan sudo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:272
msgid "Sans session graphique (SSH, serveur), un message rappelle l'adresse à ouvrir vous-même."
msgstr "Tanpa sesi grafis (SSH, server), sebuah pesan mengingatkan alamat yang harus Anda buka sendiri."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:275
msgid "Se déclarer utilisateur (anonyme) / Modifier ma déclaration"
msgstr "Daftarkan saya sebagai pengguna (anonim) / Ubah pendaftaran saya"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:276
msgid "Ouvre le formulaire de déclaration anonyme."
msgstr "Membuka formulir pendaftaran anonim."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:277
msgid "Le libellé devient « Modifier ma déclaration » une fois déclaré."
msgstr "Label berubah menjadi “Ubah pendaftaran saya” setelah terdaftar."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:278
msgid "Ouvre le formulaire Se déclarer utilisateur (anonyme)."
msgstr "Membuka formulir Daftarkan saya sebagai pengguna (anonim)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:279
msgid "Aucun effet ici - voir la fiche du formulaire."
msgstr "Tidak ada efek di sini - lihat halaman formulir."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:282
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:59
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:108
msgid "Ne plus me déclarer"
msgstr "Jangan daftarkan saya lagi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:283
msgid "Retire la déclaration."
msgstr "Menarik pendaftaran."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:284
msgid "Actif seulement une fois déclaré ; une confirmation est demandée."
msgstr "Hanya aktif setelah terdaftar; konfirmasi diminta."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:285
msgid "Envoie un retrait : votre entrée est supprimée du compteur, puis la clé est effacée de cette installation et les envois quotidiens s'arrêtent."
msgstr "Mengirim penarikan: entri Anda dihapus dari penghitung, lalu kunci dihapus dari instalasi ini dan pengiriman harian berhenti."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:287
msgid "Réception injoignable : la clé est quand même effacée ; l'entrée disparaît seule (90 jours en envoi quotidien, 1 an en envoi unique)."
msgstr "Penerima tidak dapat dijangkau: kunci tetap dihapus; entri hilang dengan sendirinya (90 hari untuk pengiriman harian, 1 tahun untuk pengiriman sekali)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:291
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:61
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:65
msgid "Contacter le support"
msgstr "Hubungi dukungan"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:292
msgid "Ouvre le formulaire de contact du site (https://kraynux.snake-mackarel.ts.net/contact/). L'adresse kraynux@proton.me est aussi affichée."
msgstr "Membuka formulir kontak situs (https://kraynux.snake-mackarel.ts.net/contact/). Alamat kraynux@proton.me juga ditampilkan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:294
msgid "Aucune saisie : omega-serv n'envoie jamais de message lui-même."
msgstr "Tidak ada isian: omega-serv tidak pernah mengirim pesan sendiri."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:295
msgid "Ouvre l'adresse dans votre navigateur."
msgstr "Membuka alamat di peramban Anda."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:296
msgid "Sans session graphique, recopiez l'adresse affichée."
msgstr "Tanpa sesi grafis, salin alamat yang ditampilkan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:299
msgid "Rien n'est envoyé sans un clic explicite sur Envoyer (formulaire de déclaration) ou sur Ne plus me déclarer."
msgstr "Tidak ada yang dikirim tanpa klik eksplisit pada Kirim (formulir pendaftaran) atau Jangan daftarkan saya lagi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:305
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:109
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:51
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:57
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:80
msgid "Se déclarer utilisateur (anonyme)"
msgstr "Daftarkan saya sebagai pengguna (anonim)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:306
msgid "Contact et support -> Se déclarer utilisateur (anonyme)"
msgstr "Kontak dan dukungan -> Daftarkan saya sebagai pengguna (anonim)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:307
msgid "Déclaration volontaire et anonyme : elle compte les utilisateurs d'omega-serv et, si vous le souhaitez, leur continent ou leur pays. Rien n'est activé par défaut."
msgstr "Pendaftaran sukarela dan anonim: menghitung pengguna omega-serv dan, jika Anda mau, benua atau negara mereka. Tidak ada yang aktif secara bawaan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:311
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:85
msgid "Envoi"
msgstr "Pengiriman"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:312
msgid "Une seule fois, ou chaque jour."
msgstr "Sekali, atau setiap hari."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:313
msgid "Obligatoire, aucun choix présélectionné : Envoyer reste grisé tant qu'il n'est pas choisi."
msgstr "Wajib, tidak ada yang dipilih sebelumnya: Kirim tetap abu-abu sampai dipilih."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:314
msgid "Une seule fois : un envoi maintenant. Chaque jour : le service omega-serv renvoie le même message au plus une fois par 24 h, ce qui permet de compter les installations actives."
msgstr "Sekali: satu pengiriman sekarang. Setiap hari: layanan omega-serv mengirim ulang pesan yang sama paling banyak sekali setiap 24 jam, sehingga instalasi aktif dapat dihitung."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:316
msgid "L'envoi quotidien tourne dans un processus à part : il ne ralentit jamais le serveur, ni au démarrage ni à l'arrêt. DO_NOT_TRACK=1 dans l'environnement du service le désactive."
msgstr "Pengiriman harian berjalan di proses terpisah: tidak pernah memperlambat server, baik saat mulai maupun saat berhenti. DO_NOT_TRACK=1 di lingkungan layanan menonaktifkannya."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:320
msgid "Continent / Pays"
msgstr "Benua / Negara"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:321
msgid "Deux listes indépendantes, facultatives, chacune avec « Autre (non référencé) »."
msgstr "Dua daftar yang independen dan opsional, masing-masing dengan “Lainnya (tidak tercantum)”."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:322
msgid "Laisser « Non précisé » pour ne rien envoyer de ce champ."
msgstr "Biarkan “Tidak disebutkan” agar tidak mengirim apa pun untuk kolom ini."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:323
msgid "Ajoute le code choisi au message (EU, FR... ou autre)."
msgstr "Menambahkan kode yang dipilih ke pesan (EU, FR... atau autre)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:324
msgid "Ni ville, ni texte libre."
msgstr "Tanpa kota, tanpa teks bebas."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:327
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:102
msgid "Message envoyé"
msgstr "Pesan yang dikirim"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:328
msgid "Le message exact, mis à jour à chaque choix."
msgstr "Pesan yang persis, diperbarui pada setiap pilihan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:329
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:197
msgid "Lecture seule."
msgstr "Hanya-baca."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:330
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:45
msgid "Aucune."
msgstr "Tidak ada."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:331
msgid "Une clé tirée au hasard (32 caractères) est créée au premier envoi, sous var/lib/declaration/ ; elle ne dérive ni de la machine ni de vous."
msgstr "Sebuah kunci acak (32 karakter) dibuat pada pengiriman pertama, di var/lib/declaration/; kunci itu tidak diturunkan dari mesin maupun dari Anda."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:335
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:115
msgid "Envoyer"
msgstr "Kirim"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:336
msgid "Envoie la déclaration en HTTPS vers le site du développeur."
msgstr "Mengirim pendaftaran melalui HTTPS ke situs pengembang."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:337
msgid "5 secondes au plus ; l'écran ne se fige pas."
msgstr "Paling lama 5 detik; layar tidak pernah membeku."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:338
msgid "Succès : retour à Contact et support, état « déclaré »."
msgstr "Berhasil: kembali ke Kontak dan dukungan, status “terdaftar”."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:339
msgid "Réception injoignable : en « une seule fois », rien n'est enregistré ; en « chaque jour », l'accord est gardé et le service réessaie dans 24 h."
msgstr "Penerima tidak dapat dijangkau: dengan “sekali”, tidak ada yang dicatat; dengan “setiap hari”, persetujuan tetap disimpan dan layanan mencoba lagi dalam 24 jam."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:344
msgid "L'adresse IP n'est pas enregistrée dans les déclarations, mais comme pour toute visite d'un site, elle passe par les contrôles de sécurité et le journal technique du serveur de réception."
msgstr "Alamat IP tidak dicatat dalam pendaftaran, tetapi seperti setiap kunjungan ke sebuah situs, alamat itu melewati pemeriksaan keamanan dan log teknis server penerima."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:346
msgid "Ligne de commande : omega-serv declaration status | declare --mode unique|quotidien [--continent X] [--pays Y] --yes | withdraw."
msgstr "Baris perintah: omega-serv declaration status | declare --mode unique|quotidien [--continent X] [--pays Y] --yes | withdraw."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:12
#: src/omega_serv/interfaces/tui/guide/content/faq.py:28
#: src/omega_serv/interfaces/tui/guide/content/faq.py:40
#: src/omega_serv/interfaces/tui/guide/content/faq.py:52
#: src/omega_serv/interfaces/tui/guide/content/faq.py:72
msgid "Redémarrage et rechargement"
msgstr "Mulai ulang dan muat ulang"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:13
msgid "J'ai active/modifie une option, mais rien ne change sur le serveur - pourquoi ?"
msgstr "Saya mengaktifkan/mengubah opsi, tetapi tidak ada yang berubah di server - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:15
msgid "Le serveur tourne dans un PROCESSUS DÉJÀ LANCÉ, séparé de l'interface. Écrire un changement dans le fichier de configuration ne le fait jamais relire tout seul par ce processus : il faut soit le RECHARGER (SIGHUP, écran SERVICE -> Recharger - léger, aucune coupure de connexion), soit le REDÉMARRER COMPLÈTEMENT (coupe toutes les connexions en cours). La plupart des écrans de configuration détaillée déclenchent désormais ce rechargement automatiquement dès qu'un service systemd actif est détecté, et vous avertissent sinon. Quelques réglages (bind/port, listen_backlog, TLS, 1ere activation de fastcgi/reverse_proxy, active_defense) exigent toujours un redémarrage complet - jamais un simple rechargement - car ils touchent le socket d'écoute ou des composants construits une seule fois au démarrage."
msgstr "Server berjalan dalam PROSES YANG SUDAH DIJALANKAN, terpisah dari antarmuka. Menulis perubahan ke berkas konfigurasi tidak pernah membuat proses itu membacanya ulang sendiri: perlu MUAT ULANG (SIGHUP, layar SERVICE -> Muat ulang - ringan, tanpa memutus koneksi), atau MULAI ULANG PENUH (memutus semua koneksi yang sedang berlangsung). Sebagian besar layar konfigurasi terperinci kini memicu muat ulang ini secara otomatis begitu layanan systemd aktif terdeteksi, dan memperingatkan Anda jika tidak. Beberapa pengaturan (bind/port, listen_backlog, TLS, aktivasi pertama fastcgi/reverse_proxy, active_defense) selalu memerlukan mulai ulang penuh - bukan muat ulang biasa - karena menyentuh socket dengar atau komponen yang dibangun sekali saat start."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:29
msgid "Après une mise à jour d'omega-serv, mes nouveaux réglages ne s'appliquent pas alors que le service est « rechargé » - pourquoi ?"
msgstr "Setelah pembaruan omega-serv, pengaturan baru saya tidak berlaku padahal layanan sudah « dimuat ulang » - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:31
msgid "Un rechargement ne relit que la configuration, jamais le programme déjà chargé en mémoire. Si le service tournait déjà avant l'extraction de la mise à jour, il exécute toujours l'ancienne version, qui ignore les réglages apparus depuis. Redémarrez le service une fois après chaque mise à jour (écran SERVICE -> Redémarrer). L'interface le signale : notification à l'accueil, et avertissement après chaque rechargement, tant que le service n'a pas été redémarré (systemd et runit)."
msgstr "Muat ulang hanya membaca ulang konfigurasi, tidak pernah program yang sudah dimuat di memori. Jika layanan sudah berjalan sebelum pembaruan diekstrak, layanan masih menjalankan versi lama, yang mengabaikan pengaturan yang muncul sesudahnya. Mulai ulang layanan sekali setelah setiap pembaruan (layar SERVICE -> Mulai ulang). Antarmuka memberi tahu: notifikasi di beranda, dan peringatan setelah setiap muat ulang, selama layanan belum dimulai ulang (systemd dan runit)."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:41
msgid "Comment savoir si un changement précis a besoin d'un rechargement ou d'un redémarrage complet ?"
msgstr "Bagaimana mengetahui apakah sebuah perubahan perlu muat ulang atau mulai ulang penuh?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:43
msgid "La réaction exacte de chaque champ est indiquée dans sa fiche du guide (touche F1 depuis l'écran concerne). En règle générale : tout ce qui touche le socket d'écoute (adresse, port, listen_backlog), le contexte TLS, ou un composant construit une seule fois au démarrage (client FastCGI/reverse proxy à la première activation, Active Defense) exige un redémarrage complet. Tout le reste se recharge à chaud."
msgstr "Reaksi tepat setiap bidang tercantum di lembar panduannya (tombol F1 dari layar terkait). Secara umum: semua yang menyentuh socket dengar (alamat, port, listen_backlog), konteks TLS, atau komponen yang dibangun sekali saat start (klien FastCGI/reverse proxy pada aktivasi pertama, Active Defense) memerlukan mulai ulang penuh. Selebihnya dimuat ulang saat berjalan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:54
msgid "J'ai mis à jour le code d'OMEGA-SERV (nouvelle archive, correctif appliqué) mais le comportement ne change jamais, même après un rechargement (SIGHUP) - pourquoi ?"
msgstr "Saya memperbarui kode OMEGA-SERV (arsip baru, perbaikan diterapkan) tetapi perilakunya tidak pernah berubah, bahkan setelah muat ulang (SIGHUP) - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:58
msgid "Piège réel rencontré (2026-10-10, correctif du rendu du directory listing sous une CSP stricte) : le rechargement à chaud (SIGHUP, écran SERVICE -> Recharger) ne relit QUE certains éléments de CONFIGURATION (règles WAF, zones d'authentification) - il ne recharge JAMAIS le CODE Python lui-même, qui reste celui chargé en mémoire depuis le DERNIER DÉMARRAGE du processus, aussi anciens soient les fichiers sur disque. Après une mise à jour du code (nouvelle archive installée, correctif appliqué), un REDÉMARRAGE COMPLET est TOUJOURS nécessaire (`systemctl restart <service>`, ou écran SERVICE -> Arrêter puis Démarrer) - jamais un simple rechargement, même pour un changement qui semble léger. Vérifiez `systemctl status <service>` : une date de démarrage ('Active: active (running) since ...') plus ancienne que votre mise à jour confirme immédiatement ce diagnostic."
msgstr "Jebakan nyata yang pernah terjadi (2026-10-10, perbaikan tampilan directory listing di bawah CSP ketat): muat ulang saat berjalan (SIGHUP, layar SERVICE -> Muat ulang) HANYA membaca ulang sebagian KONFIGURASI (aturan WAF, zona autentikasi) - tidak pernah memuat ulang KODE Python itu sendiri, yang tetap kode yang dimuat ke memori sejak START TERAKHIR proses, betapapun lama berkas di disk. Setelah pembaruan kode (arsip baru dipasang, perbaikan diterapkan), MULAI ULANG PENUH SELALU diperlukan (`systemctl restart <service>`, atau layar SERVICE -> Hentikan lalu Mulai) - tidak pernah muat ulang biasa, bahkan untuk perubahan yang tampak kecil. Periksa `systemctl status <service>`: tanggal start ('Active: active (running) since ...') yang lebih lama dari pembaruan Anda langsung memastikan diagnosis ini."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:73
msgid "Le rechargement/redemarrage automatique ne s'est pas déclenché - pourquoi ?"
msgstr "Muat ulang/mulai ulang otomatis tidak terpicu - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:75
msgid "Le déclenchement automatique ne fonctionne que si un gestionnaire de service système (systemd/OpenRC/runit) est reconnu ET qu'un service est réellement ACTIF pour ce répertoire. Si vous faites tourner le serveur via l'assistant premier lancement (\"Lancer maintenant\", sans service installé), aucun rechargement automatique n'est possible - relancez manuellement, ou installez le service depuis l'écran SERVICE."
msgstr "Pemicuan otomatis hanya bekerja jika pengelola layanan sistem (systemd/OpenRC/runit) dikenali DAN sebuah layanan benar-benar AKTIF untuk direktori ini. Jika Anda menjalankan server melalui asisten peluncuran pertama (\"Jalankan sekarang\", tanpa layanan terpasang), muat ulang otomatis tidak mungkin - jalankan ulang secara manual, atau pasang layanan dari layar SERVICE."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:84
#: src/omega_serv/interfaces/tui/guide/content/faq.py:95
msgid "Service système"
msgstr "Layanan sistem"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:85
msgid "Juste après 'Installer l'unité', l'écran État & Ressources affiche 'Arrêté' alors que le service tourne - pourquoi ?"
msgstr "Tepat setelah 'Pasang unit', layar Status & Sumber Daya menampilkan 'Berhenti' padahal layanan berjalan - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:87
msgid "L'installation crée un compte système dédié et ajoute votre session au groupe correspondant, mais l'appartenance à un NOUVEAU groupe Unix ne s'applique jamais à une session déjà ouverte (même terminal déjà lancé avant l'installation). Déconnectez-vous puis reconnectez-vous UNE SEULE FOIS - l'écran affichera alors l'état réel. En attendant, vérifiez via l'écran SERVICE ou `systemctl status`."
msgstr "Pemasangan membuat akun sistem khusus dan menambahkan sesi Anda ke grup terkait, tetapi keanggotaan grup Unix BARU tidak pernah berlaku untuk sesi yang sudah terbuka (termasuk terminal yang dibuka sebelum pemasangan). Keluar lalu masuk ulang SATU KALI - layar akan menampilkan status sebenarnya. Sementara itu, periksa melalui layar SERVICE atau `systemctl status`."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:96
msgid "Le champ 'Nom du service' dans l'écran SERVICE ne correspond pas à ce que je pilote ailleurs - pourquoi ?"
msgstr "Bidang 'Nama layanan' di layar SERVICE tidak sesuai dengan yang saya kendalikan di tempat lain - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:98
msgid "Ce champ persiste une préférence d'interface, distincte de la configuration serveur. Si cette instance est enregistrée en multi-instance, le nom est FIGÉ (celui choisi à la création) - jamais improvisé ici. Une seule interface peut déjà piloter n'importe quelle unité installée en tapant simplement son nom exact, même celle d'une autre copie du projet."
msgstr "Bidang ini menyimpan preferensi antarmuka, terpisah dari konfigurasi server. Jika instans ini terdaftar dalam multi-instans, namanya DIKUNCI (yang dipilih saat pembuatan) - tidak pernah dibuat di sini. Satu antarmuka sudah dapat mengendalikan unit terpasang mana pun cukup dengan mengetik nama persisnya, bahkan unit dari salinan proyek lain."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:106
#: src/omega_serv/interfaces/tui/guide/content/faq.py:118
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:115
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:76
#: src/omega_serv/interfaces/tui/screens/home.py:84
msgid "Multi-instance"
msgstr "Multi-instans"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:107
msgid "Puis-je installer une seconde unité systemd qui pointe vers le même répertoire, sous un autre nom ?"
msgstr "Bisakah saya memasang unit systemd kedua yang menunjuk ke direktori yang sama, dengan nama lain?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:109
msgid "Non - deux garde-fous bloquent explicitement cette situation avant toute écriture : une unité différente pointant déjà vers ce répertoire (partagerait silencieusement var/, la configuration et le compte système dédié), et un nom déjà utilisé par une unité pointant vers un AUTRE répertoire (volerait ce nom, écrasant l'unité existante). Pour héberger plusieurs serveurs, utilisez Multi-instance : chaque instance a son propre répertoire, sa propre configuration et son propre compte système."
msgstr "Tidak - dua pengaman memblokir situasi ini secara eksplisit sebelum penulisan apa pun: unit lain yang sudah menunjuk ke direktori ini (akan diam-diam berbagi var/, konfigurasi, dan akun sistem khusus), dan nama yang sudah dipakai oleh unit yang menunjuk ke direktori LAIN (akan merebut nama itu, menimpa unit yang ada). Untuk meng-host beberapa server, gunakan Multi-instans: setiap instans memiliki direktori, konfigurasi, dan akun sistemnya sendiri."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:119
msgid "La création d'une nouvelle instance échoue à l'étape 4/6 (Installation des dépendances) - pourquoi ?"
msgstr "Pembuatan instans baru gagal di langkah 4/6 (Memasang dependensi) - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:121
msgid "Piège réel corrigé : si le message d'échec mentionne 'omega-lib' et 'No matching distribution found', c'était un bug de la création d'instance elle-même, pas une erreur de votre part - omega-lib n'est pas publiée sur PyPI, et l'ancienne version ne savait retrouver sa source réelle (vendorée ou depuis un clone de développement) que dans un seul des deux cas. Corrigé : la nouvelle instance réutilise désormais la même source qu'omega-lib déjà installée pour l'instance en cours, quelle que soit sa provenance. Si l'échec persiste malgré une version à jour, vérifiez que le réseau est disponible pour les AUTRES dépendances (`textual`, `pyte`, `jinja2`, `psutil`), qui viennent bien de PyPI."
msgstr "Jebakan nyata yang sudah diperbaiki: jika pesan kegagalan menyebut 'omega-lib' dan 'No matching distribution found', itu bug dari pembuatan instans sendiri, bukan kesalahan Anda - omega-lib tidak dipublikasikan di PyPI, dan versi lama hanya dapat menemukan sumber sebenarnya (vendored atau dari clone pengembangan) dalam salah satu dari dua kasus. Diperbaiki: instans baru kini memakai sumber yang sama dengan omega-lib yang sudah terpasang untuk instans saat ini, dari mana pun asalnya. Jika kegagalan berlanjut dengan versi terbaru, pastikan jaringan tersedia untuk dependensi LAIN (`textual`, `pyte`, `jinja2`, `psutil`), yang memang berasal dari PyPI."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:133
#: src/omega_serv/interfaces/tui/guide/content/faq.py:143
#: src/omega_serv/interfaces/tui/guide/content/faq.py:156
#: src/omega_serv/interfaces/tui/guide/content/faq.py:172
#: src/omega_serv/interfaces/tui/guide/content/faq.py:184
#: src/omega_serv/interfaces/tui/guide/content/faq.py:197
#: src/omega_serv/interfaces/tui/guide/content/faq.py:208
#: src/omega_serv/interfaces/tui/guide/content/faq.py:225
#: src/omega_serv/interfaces/tui/guide/content/faq.py:240
#: src/omega_serv/interfaces/tui/guide/content/faq.py:253
#: src/omega_serv/interfaces/tui/guide/content/faq.py:267
#: src/omega_serv/interfaces/tui/guide/content/faq.py:278
#: src/omega_serv/interfaces/tui/guide/content/faq.py:288
#: src/omega_serv/interfaces/tui/guide/content/faq.py:298
#: src/omega_serv/interfaces/tui/guide/content/faq.py:311
#: src/omega_serv/interfaces/tui/guide/content/faq.py:322
#: src/omega_serv/interfaces/tui/guide/content/faq.py:335
#: src/omega_serv/interfaces/tui/guide/content/faq.py:346
msgid "WAF/Active Defense"
msgstr "WAF/Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:134
msgid "Le WAF est actif mais ne bloque jamais rien - pourquoi ?"
msgstr "WAF aktif tetapi tidak pernah memblokir apa pun - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:136
msgid "Vérifiez d'abord l'écran WAF - État : si 'Packs de règles référencés' est à zéro, le WAF ne peut RIEN détecter même actif (piège réel déjà rencontré). Ajoutez au moins un pack depuis WAF - Modules. Vérifiez ensuite le mode : 'log-only' journalise sans jamais bloquer, seul 'block' bloque réellement."
msgstr "Periksa dulu layar WAF - Status: jika 'Paket aturan yang dirujuk' nol, WAF tidak dapat mendeteksi APA PUN meskipun aktif (jebakan nyata yang pernah terjadi). Tambahkan minimal satu paket dari WAF - Modul. Lalu periksa mode: 'log-only' mencatat tanpa pernah memblokir, hanya 'block' yang benar-benar memblokir."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:144
msgid "J'ai activé l'option 'active_defense' mais rien ne se passe jamais (aucune menace, aucun incident) - pourquoi ?"
msgstr "Saya mengaktifkan opsi 'active_defense' tetapi tidak pernah terjadi apa-apa (tidak ada ancaman, tidak ada insiden) - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:146
msgid "Activer l'option elle-même (menu Options) ne suffit PAS. Un second interrupteur, `war_mode.enabled`, vaut FALSE par défaut - activez-le depuis Active Defense -> Réglages -> 'Mode guerre actif'. Vérifiez la ligne 'Mode guerre' sur l'écran Active Defense - État : si elle affiche 'inactif', c'est la cause. Un REDÉMARRAGE COMPLET est ensuite nécessaire (active_defense n'est jamais rechargé à chaud). Une fois actif, tout devient automatique - le score de chaque source est alimenté par les décisions WAF déjà calculées à chaque requête, sans aucune action manuelle."
msgstr "Mengaktifkan opsinya saja (menu Opsi) TIDAK cukup. Sakelar kedua, `war_mode.enabled`, bernilai FALSE secara bawaan - aktifkan dari Active Defense -> Pengaturan -> 'Mode perang aktif'. Periksa baris 'Mode perang' di layar Active Defense - Status: jika menampilkan 'nonaktif', itulah penyebabnya. MULAI ULANG PENUH kemudian diperlukan (active_defense tidak pernah dimuat ulang saat berjalan). Setelah aktif, semuanya otomatis - skor setiap sumber diisi oleh keputusan WAF yang sudah dihitung pada setiap permintaan, tanpa tindakan manual apa pun."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:157
msgid "Active Defense en production : quelles limites connaître ?"
msgstr "Active Defense di produksi: batasan apa yang perlu diketahui?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:159
msgid "Mesuré sur une machine à 2 cœurs : aucun coût sans attaque. Face à des attaquants qui reviennent, le mode guerre les ralentit (environ 0,4 s par requête) et le serveur sert même plus vite les visiteurs légitimes. Face à un botnet qui change d'adresse à chaque requête, Active Defense coûte de 10 à 16 % de débit. La base est bornée : au plus 200 000 sources suivies (les sources « normal » les plus anciennes partent d'abord), journal d'audit purgé au-delà de 30 jours et de 200 000 lignes, historique d'un incident limité aux 100 premiers et aux 1 000 derniers éléments. La purge des états expirés est automatique (au plus toutes les 10 minutes) ; le fichier de la base ne rétrécit pas, SQLite réutilise la place libérée. Sauvegardez la base avec `config backup --include-active-defense`."
msgstr "Diukur pada mesin 2 inti: tanpa serangan tidak ada biaya. Terhadap penyerang yang kembali, mode perang memperlambat mereka (sekitar 0,4 detik per permintaan) dan server bahkan melayani pengunjung sah lebih cepat. Terhadap botnet yang berganti alamat di setiap permintaan, Active Defense memakan 10 hingga 16% throughput. Basis data dibatasi: paling banyak 200.000 sumber dilacak (sumber « normal » terlama dihapus lebih dulu), log audit dibersihkan setelah 30 hari dan 200.000 baris, riwayat sebuah insiden dibatasi 100 item pertama dan 1.000 item terakhir. Status kedaluwarsa dibersihkan otomatis (paling lama setiap 10 menit); berkas basis data tidak menyusut, SQLite memakai ulang ruang yang dibebaskan. Cadangkan basis data dengan `config backup --include-active-defense`."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:173
msgid "Une purge ou une sauvegarde pendant une attaque peut-elle bloquer le serveur ?"
msgstr "Apakah pembersihan atau pencadangan saat serangan dapat memblokir server?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:175
msgid "Non : le serveur écrit dans la base d'Active Defense depuis un fil d'arrière-plan, jamais pendant une requête. Si la base est verrouillée (purge, sauvegarde, autre programme), les écritures attendent puis reprennent seules ; error.log reçoit une ligne au début (« écriture en base impossible ») et une à la fin (« rétablie »). Au-delà de 10 000 observations en attente, les suivantes sont abandonnées et comptées ; les requêtes, elles, sont toujours servies."
msgstr "Tidak: server menulis ke basis data Active Defense dari thread latar belakang, tidak pernah saat memproses permintaan. Jika basis data terkunci (pembersihan, pencadangan, program lain), penulisan menunggu lalu berlanjut sendiri; error.log mendapat satu baris di awal (« écriture en base impossible ») dan satu di akhir (« rétablie »). Lewat dari 10.000 observasi yang menunggu, observasi berikutnya dibuang dan dihitung; permintaan selalu dilayani."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:185
msgid "Comment partager un incident avec MISP ou OpenCTI ?"
msgstr "Bagaimana membagikan insiden ke MISP atau OpenCTI?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:187
msgid "Exportez-le au format misp ou stix (écran Incidents -> Exporter IoC, ou `incidents export-ioc <id> --format stix,misp`). Dans MISP : Add Event -> Populate from -> MISP JSON, puis le fichier .misp.json. Dans OpenCTI ou un SIEM : importez le bundle .stix.json. Les fichiers restent sur votre serveur, omega-serv n'envoie rien. Le marquage TLP se règle dans Active Defense -> Réglages (amber par défaut). Seules les adresses IP sont exportées ; l'adresse d'un attaquant reste une donnée personnelle : vérifiez avant de partager."
msgstr "Ekspor dalam format misp atau stix (layar Insiden -> Ekspor IoC, atau `incidents export-ioc <id> --format stix,misp`). Di MISP: Add Event -> Populate from -> MISP JSON, lalu berkas .misp.json. Di OpenCTI atau SIEM: impor bundel .stix.json. Berkas tetap di server Anda, omega-serv tidak mengirim apa pun. Penanda TLP diatur di Active Defense -> Pengaturan (bawaan amber). Hanya alamat IP yang diekspor; alamat penyerang tetap merupakan data pribadi: periksa sebelum membagikan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:198
msgid "J'ai créé une règle WAF personnalisée mais elle ne se déclenche jamais - pourquoi ?"
msgstr "Saya membuat aturan WAF kustom tetapi tidak pernah terpicu - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:200
msgid "Utilisez l'écran WAF - Règles personnalisées (pas 'Modules') pour CRÉER la règle elle-même - il l'écrit dans custom.json ET référence automatiquement ce pack. Ajouter seulement le pack custom.json comme référence depuis 'Modules' ne crée aucune règle si le fichier est encore vide. Utilisez l'écran 'Tester une requête' pour vérifier qu'une règle se déclenche bien avant de compter dessus en production."
msgstr "Gunakan layar WAF - Aturan kustom (bukan 'Modul') untuk MEMBUAT aturannya - layar ini menulisnya ke custom.json DAN merujuk paket ini secara otomatis. Hanya menambahkan paket custom.json sebagai rujukan dari 'Modul' tidak membuat aturan apa pun jika berkasnya masih kosong. Gunakan layar 'Uji permintaan' untuk memastikan aturan benar-benar terpicu sebelum mengandalkannya di produksi."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:209
msgid "Quelle classe d'attaque choisir pour un profil de leurre ?"
msgstr "Kelas serangan mana yang dipilih untuk profil umpan?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:211
msgid "Les 8 classes possibles et ce qu'elles ciblent concrètement : scan (sondage d'URLs/ports, scanners automatisés), credential_stuffing (essais massifs de mots de passe sur un formulaire de login), sqli (tentative d'injection SQL), xss (script injecté dans un paramètre), path_traversal (tentative de sortir du dossier servi, ex : ../../etc/passwd), upload_probe (upload de fichier suspect), api_probe (sondage d'endpoints /api/...), unknown (tout ce qui ne correspond à aucune des catégories précédentes - un filet de sécurité générique). Exemple : un profil nommé fake_admin avec les classes scan,credential_stuffing attirera les scanners et les tentatives de bruteforce de connexion vers une fausse page d'authentification. Plusieurs classes peuvent être listées, séparées par des virgules."
msgstr "8 kelas yang mungkin dan sasaran nyatanya: scan (pemeriksaan URL/port, pemindai otomatis), credential_stuffing (percobaan kata sandi massal pada formulir login), sqli (percobaan injeksi SQL), xss (skrip yang disuntikkan ke parameter), path_traversal (percobaan keluar dari folder yang disajikan, mis.: ../../etc/passwd), upload_probe (unggahan berkas mencurigakan), api_probe (pemeriksaan endpoint /api/...), unknown (semua yang tidak cocok dengan kategori sebelumnya - jaring pengaman umum). Contoh: profil bernama fake_admin dengan kelas scan,credential_stuffing akan menarik pemindai dan percobaan bruteforce login ke halaman autentikasi palsu. Beberapa kelas dapat dicantumkan, dipisahkan koma."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:221
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:123
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:305
msgid "Nouvelle classe (2.1) : command_injection (injection de commandes shell, ex : $(...), ; cat /etc/passwd). Les sondes WordPress (wp-login, xmlrpc.php) sont classées scan."
msgstr "Kelas baru (2.1): command_injection (injeksi perintah shell, mis. $(...), ; cat /etc/passwd). Probe WordPress (wp-login, xmlrpc.php) diklasifikasikan sebagai scan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:226
msgid "« Ajouter un profil de leurre » refuse le profil - que corriger ?"
msgstr "“Tambah profil umpan” menolak profil - apa yang harus diperbaiki?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:228
msgid "Rien n'est enregistré tant que le profil est invalide. Le formulaire reste ouvert, la raison s'affiche sous les champs et la saisie est conservée : corrigez le champ indiqué, puis cliquez à nouveau sur Valider. Causes les plus fréquentes : (1) Isolation = fixture avec un nom autre que fake_admin, fake_cms, fake_api ou fake_secrets (en minuscules, sans espace) ; (2) classe d'attaque mal écrite - valeurs exactes, séparées par des virgules : scan, credential_stuffing, sqli, xss, path_traversal, upload_probe, api_probe, command_injection, unknown ; (3) Isolation = proxy sans zone de leurre, ou avec un nom de zone qui n'existe pas encore (créez d'abord la zone dans « Zones de leurre ») ; (4) un autre réglage de l'écran est invalide (le message le nomme). Le plus simple : Isolation fixture, l'un des 4 noms, zone vide. Le formulaire « Ajouter une zone » fonctionne de la même façon."
msgstr "Tidak ada yang disimpan selama profil tidak valid. Formulir tetap terbuka, alasannya ditampilkan di bawah kolom, dan isian Anda tetap tersimpan: perbaiki kolom yang disebutkan, lalu klik Konfirmasi lagi. Penyebab paling sering: (1) Isolation = fixture dengan nama selain fake_admin, fake_cms, fake_api, atau fake_secrets (huruf kecil, tanpa spasi); (2) kelas serangan salah tulis - nilai persis, dipisahkan koma: scan, credential_stuffing, sqli, xss, path_traversal, upload_probe, api_probe, command_injection, unknown; (3) Isolation = proxy tanpa zona umpan, atau dengan nama zona yang belum ada (buat dulu zonanya di “Zona umpan”); (4) pengaturan lain di layar tidak valid (pesan menyebutkannya). Paling mudah: Isolation fixture, salah satu dari 4 nama, zona kosong. Formulir “Tambah zona” bekerja dengan cara yang sama."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:241
msgid "Mon profil de leurre en isolation 'fixture' ne se déclenche jamais - pourquoi ?"
msgstr "Profil umpan saya dengan isolasi 'fixture' tidak pernah terpicu - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:243
msgid "Le NOM du profil doit correspondre EXACTEMENT à l'une des 4 fixtures réellement implémentées : fake_admin, fake_cms, fake_api, fake_secrets. Tout autre nom (même descriptif, ex : 'mon-leurre-perso') faisait auparavant que le leurre ne se déclenchait jamais, sans aucune erreur visible - le trafic suivait alors le comportement de secours (pass_through ou reject) comme si aucun profil n'existait. L'écran Active Defense -> Réglages refuse désormais d'enregistrer un tel nom et indique clairement le problème."
msgstr "NAMA profil harus sama PERSIS dengan salah satu dari 4 fixture yang benar-benar diimplementasikan: fake_admin, fake_cms, fake_api, fake_secrets. Nama lain apa pun (meskipun deskriptif, mis.: 'mon-leurre-perso') dulu membuat umpan tidak pernah terpicu, tanpa kesalahan yang terlihat - lalu lintas mengikuti perilaku cadangan (pass_through atau reject) seolah tidak ada profil. Layar Active Defense -> Pengaturan kini menolak menyimpan nama seperti itu dan menjelaskan masalahnya dengan jelas."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:254
msgid "J'ai créé une zone de leurre avec une adresse qui n'existe pas encore - que se passe-t-il ?"
msgstr "Saya membuat zona umpan dengan alamat yang belum ada - apa yang terjadi?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:256
msgid "Rien de spécial à l'enregistrement : une zone de leurre (Niveau 2, isolation 'proxy') est une simple cible réseau (host:port), jamais un dossier - aucune création automatique, aucune vérification que l'adresse existe ou répond au moment de la sauvegarde. La conséquence n'apparaît que lors d'une VRAIE requête routée vers cette zone : si rien n'écoute à cette adresse, l'attaquant reçoit simplement une erreur HTTP 502 Bad Gateway (la même mécanique que le reverse proxy de production) - jamais de crash du serveur, jamais de création silencieuse de quoi que ce soit."
msgstr "Tidak ada yang istimewa saat menyimpan: zona umpan (Level 2, isolasi 'proxy') hanyalah target jaringan (host:port), bukan folder - tidak ada pembuatan otomatis, tidak ada pemeriksaan apakah alamat itu ada atau merespons saat disimpan. Akibatnya baru terlihat saat ada permintaan NYATA yang diarahkan ke zona ini: jika tidak ada yang mendengar di alamat itu, penyerang hanya menerima kesalahan HTTP 502 Bad Gateway (mekanisme yang sama dengan reverse proxy produksi) - server tidak pernah crash, tidak pernah ada pembuatan diam-diam."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:268
msgid "Comment bloquer les chemins sensibles (.env, .git, sauvegardes, consoles d'admin...) sans tout écrire à la main ?"
msgstr "Bagaimana memblokir jalur sensitif (.env, .git, cadangan, konsol admin...) tanpa menulis semuanya sendiri?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:270
msgid "Active Sécurité -> Custom -> Ajouter -> 'CHARGER une liste de chemins (fichier)', puis choisissez la référence livrée sensitive-paths-hostile (298 chemins sans usage légitime) et/ou sensitive-paths-probe (132 chemins de sondage, parfois servis par un vrai site). Les réglages conseillés se remplissent seuls ; gardez Observation au premier chargement. Rien n'est actif avant le clic sur Charger."
msgstr "Keamanan Aktif -> Custom -> Tambah -> 'MUAT daftar jalur (berkas)', lalu pilih referensi bawaan sensitive-paths-hostile (298 jalur tanpa penggunaan sah) dan/atau sensitive-paths-probe (132 jalur pemeriksaan, kadang disajikan oleh situs nyata). Pengaturan yang disarankan terisi sendiri; gunakan Observasi pada pemuatan pertama. Tidak ada yang aktif sebelum mengeklik Muat."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:279
msgid "Quelle différence entre une règle personnalisée et une liste ?"
msgstr "Apa bedanya aturan kustom dan daftar?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:281
msgid "Une règle détecte UN motif et vit dans custom.json. Une liste est un fichier texte d'un chemin (ou mot-clé) par ligne, facile à maintenir à plusieurs centaines d'entrées, avec ses exceptions '!/x', sa gravité et sa propre récidive. Les deux apparaissent dans le même tableau de l'écran Custom, colonne Type."
msgstr "Aturan mendeteksi SATU pola dan disimpan di custom.json. Daftar adalah berkas teks berisi satu jalur (atau kata kunci) per baris, mudah dipelihara hingga ratusan entri, dengan pengecualian '!/x', tingkat keparahan, dan pelanggaran berulangnya sendiri. Keduanya muncul di tabel yang sama di layar Custom, kolom Jenis."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:289
msgid "J'ai chargé une liste en Observation - comment savoir ce qu'elle aurait bloqué, puis l'activer ?"
msgstr "Saya memuat daftar dalam mode Observasi - bagaimana mengetahui apa yang akan diblokirnya, lalu mengaktifkannya?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:291
msgid "En Observation, chaque détection est écrite dans le journal d'alertes WAF, sans aucun blocage ni ban. Lisez ces alertes quelques jours, utilisez 'Vérifier contre mes logs' dans l'éditeur pour repérer les lignes qui toucheraient des requêtes légitimes (exception '!/chemin' en un clic), puis Custom -> Modifier -> Gravité Élevé ou Moyen."
msgstr "Dalam Observasi, setiap deteksi ditulis ke log peringatan WAF, tanpa blokir atau ban. Baca peringatan ini beberapa hari, gunakan 'Cocokkan dengan log saya' di editor untuk menemukan baris yang akan mengenai permintaan sah (pengecualian '!/jalur' dalam satu klik), lalu Custom -> Ubah -> Tingkat keparahan Tinggi atau Sedang."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:299
msgid "Mes propres machines (Wi-Fi, Ethernet, Tailscale) risquent-elles d'être bannies par la récidive ?"
msgstr "Apakah mesin saya sendiri (Wi-Fi, Ethernet, Tailscale) berisiko diblokir karena pelanggaran berulang?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:301
msgid "Non : l'hôte local, le réseau Tailscale (100.64.0.0/10) et le réseau local (192.168.x, 10.x, 172.16-31.x...) ne sont JAMAIS bannis automatiquement (réglage options.waf.reputation.never_auto_block). Seule une adresse publique peut l'être. Leurs requêtes vers un chemin dangereux restent refusées (403) et journalisées, ce qui permet de tester le WAF. Derrière un proxy local (tailscale serve, reverse proxy), l'exemption de 127.0.0.1 n'est appliquée que si 'Proxy de confiance' est actif - sinon tout Internet paraîtrait venir de 127.0.0.1."
msgstr "Tidak: host lokal, jaringan Tailscale (100.64.0.0/10), dan jaringan lokal (192.168.x, 10.x, 172.16-31.x...) TIDAK PERNAH diblokir otomatis (pengaturan options.waf.reputation.never_auto_block). Hanya alamat publik yang bisa diblokir. Permintaan mereka ke jalur berbahaya tetap ditolak (403) dan dicatat, sehingga WAF dapat diuji. Di belakang proxy lokal (tailscale serve, reverse proxy), pengecualian 127.0.0.1 hanya diterapkan jika 'Proxy tepercaya' aktif - jika tidak, seluruh Internet akan tampak berasal dari 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:312
msgid "Mettre mes adresses dans 'Proxy de confiance' évite-t-il qu'elles soient bannies ?"
msgstr "Apakah memasukkan alamat saya ke 'Proxy tepercaya' mencegahnya diblokir?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:314
msgid "Non. Les réseaux de confiance disent seulement QUI a le droit de transmettre la vraie adresse du visiteur (en-tête X-Forwarded-For) - en pratique le proxy place devant omega-serv (127.0.0.1 pour tailscale serve). Ils n'exemptent de rien d'autre. Les réseaux à ne jamais bannir sont un réglage distinct (never_auto_block). Une plage large comme 100.0.0.0/8 contient des adresses publiques : préférez 100.64.0.0/10."
msgstr "Tidak. Jaringan tepercaya hanya menyatakan SIAPA yang berhak meneruskan alamat asli pengunjung (header X-Forwarded-For) - dalam praktiknya proxy yang ditempatkan di depan omega-serv (127.0.0.1 untuk tailscale serve). Jaringan itu tidak mengecualikan hal lain. Jaringan yang tidak boleh diblokir adalah pengaturan terpisah (never_auto_block). Rentang lebar seperti 100.0.0.0/8 berisi alamat publik: lebih baik gunakan 100.64.0.0/10."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:323
msgid "Une page lourde renvoie 429, puis mon IP est bannie - pourquoi ?"
msgstr "Halaman berat mengembalikan 429, lalu IP saya diblokir - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:325
msgid "Une page qui charge beaucoup de fichiers (une galerie d'images, par exemple) dépasse la limite de débit globale du WAF (60 requêtes / 60 s par IP par défaut) : le WAF répond 429, et trois rejets en 10 minutes suffisent à omega-jail pour bannir une IP publique 12 h. Solution : Active Sécurité -> Exclusions et débit, ajouter une règle pour le dossier concerné (ex. /images/ à 600 / 60 s). Pour vos propres appareils (Tailscale, réseau local), une règle IP/réseau avec « Source sûre » à oui évite tout bannissement. Une exclusion d'inspection ne suffit pas : le rate limit s'applique quand même."
msgstr "Halaman yang memuat banyak berkas (misalnya galeri gambar) melampaui batas laju global WAF (bawaan 60 permintaan / 60 dtk per IP): WAF menjawab 429, dan tiga penolakan dalam 10 menit cukup bagi omega-jail untuk memblokir IP publik selama 12 jam. Solusi: Keamanan Aktif -> Pengecualian dan batas laju, tambahkan aturan untuk folder terkait (mis. /images/ pada 600 / 60 dtk). Untuk perangkat Anda sendiri (Tailscale, jaringan lokal), aturan IP/jaringan dengan « Sumber aman » bernilai ya mencegah semua blokir. Pengecualian pemeriksaan tidak cukup: rate limit tetap berlaku."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:336
msgid "« Requêtes max par connexion keep-alive » et la limite de débit du WAF font-ils double emploi ?"
msgstr "Apakah « Permintaan maks per koneksi keep-alive » dan batas laju WAF tumpang tindih?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:338
msgid "Non, ils ne se chevauchent pas. « Requêtes max par connexion keep-alive » (Résistance et limites, défaut 30) ferme seulement une connexion après N requêtes : le navigateur en ouvre une nouvelle aussitôt, sans erreur ni bannissement. La limite de débit du WAF compte les requêtes par IP sur toutes ses connexions et répond 429 au-delà. Monter ou baisser l'un ne change rien à l'autre : un 429 se règle toujours dans Exclusions et débit."
msgstr "Tidak, keduanya tidak tumpang tindih. « Permintaan maks per koneksi keep-alive » (Ketahanan dan batas, bawaan 30) hanya menutup koneksi setelah N permintaan: peramban langsung membuka koneksi baru, tanpa galat atau blokir. Batas laju WAF menghitung permintaan per IP di semua koneksinya dan menjawab 429 bila melampaui batas. Menaikkan atau menurunkan yang satu tidak mengubah yang lain: 429 selalu diatasi di Pengecualian dan batas laju."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:347
msgid "J'ai modifié une liste mais le serveur ne l'applique pas - pourquoi ?"
msgstr "Saya mengubah daftar tetapi server tidak menerapkannya - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:349
msgid "Le message affiché après 'Enregistrer et appliquer' donne la raison : (1) la liste n'est pas encore chargée dans le WAF (utilisez l'assistant -> Charger) ; (2) la vérification a trouvé un problème (le serveur garde alors ses règles actuelles, rien n'est rechargé à moitié) ; (3) le compte du service ne peut pas lire le fichier ('Corriger les droits') ; (4) aucun service actif - relancez le serveur lancé à la main."
msgstr "Pesan yang ditampilkan setelah 'Simpan dan terapkan' memberi alasannya: (1) daftar belum dimuat ke WAF (gunakan asisten -> Muat); (2) pemeriksaan menemukan masalah (server mempertahankan aturan saat ini, tidak ada muat ulang setengah jalan); (3) akun layanan tidak dapat membaca berkas ('Benahi hak akses'); (4) tidak ada layanan aktif - jalankan ulang server yang dijalankan manual."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:357
#: src/omega_serv/interfaces/tui/guide/content/faq.py:369
#: src/omega_serv/interfaces/tui/guide/content/faq.py:385
#: src/omega_serv/interfaces/tui/guide/content/faq.py:400
#: src/omega_serv/interfaces/tui/guide/content/faq.py:414
#: src/omega_serv/interfaces/tui/guide/content/faq.py:432
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:853
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:99
msgid "WAF - Magnet (import d'un WAF externe)"
msgstr "WAF - Magnet (impor WAF eksternal)"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:358
msgid "J'ai activé le script magnet mais le serveur refuse de démarrer / l'écran signale 'lupa' absent - pourquoi ?"
msgstr "Saya mengaktifkan skrip magnet tetapi server menolak start / layar menyebut 'lupa' tidak ada - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:360
msgid "Le magnet est un extra OPTIONNEL, jamais installé par défaut : `pip install -e \".[magnet]\"` (dépendance `lupa`, liaison Lua embarquée - aucun interpréteur Lua système requis, une roue précompilée existe pour les plateformes courantes). Son absence est signalée par le registre des capacités (capacité `waf-magnet`, écran Capacités) avec la commande exacte, et bloque `config check`/le démarrage si `options.waf.magnet.enabled` est actif sans cette dépendance - jamais un échec silencieux."
msgstr "Magnet adalah ekstra OPSIONAL, tidak pernah dipasang secara bawaan: `pip install -e \".[magnet]\"` (dependensi `lupa`, binding Lua tertanam - tidak perlu interpreter Lua sistem, tersedia wheel terkompilasi untuk platform umum). Ketiadaannya dilaporkan oleh registri kapabilitas (kapabilitas `waf-magnet`, layar Kapabilitas) dengan perintah yang tepat, dan memblokir `config check`/start jika `options.waf.magnet.enabled` aktif tanpa dependensi ini - tidak pernah gagal diam-diam."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:371
msgid "Le but du magnet, c'est d'écrire un nouveau WAF en Lua ?"
msgstr "Tujuan magnet adalah menulis WAF baru dalam Lua?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:374
msgid "Non - c'est l'inverse : importer un script WAF `mod_magnet` Lighttpd EXISTANT, écrit à l'origine pour un autre site, SANS le réécrire. Le pont `lighty.*` (infrastructure/waf/lua_waf_adapter.py) reproduit le modèle d'exécution réel de Lighttpd (`lighty.env`, `lighty.header`/`lighty.content`, convention de retour 0=continuer / code HTTP=bloquer, runtime Lua persistant pour que les compteurs internes du script - rate limiting, blocklist progressive - survivent entre requêtes) plutôt qu'un contrat inventé par OMEGA-SERV. Le natif reste TOUJOURS actif en parallèle : le magnet est un renfort additif, il ne peut jamais lever un blocage déjà décidé par le natif."
msgstr "Tidak - justru sebaliknya: mengimpor skrip WAF `mod_magnet` Lighttpd yang SUDAH ADA, ditulis semula untuk situs lain, TANPA menulis ulang. Jembatan `lighty.*` (infrastructure/waf/lua_waf_adapter.py) meniru model eksekusi nyata Lighttpd (`lighty.env`, `lighty.header`/`lighty.content`, konvensi nilai kembali 0=lanjut / kode HTTP=blokir, runtime Lua persisten agar penghitung internal skrip - rate limiting, blocklist bertahap - bertahan antar permintaan) alih-alih kontrak buatan OMEGA-SERV. Native SELALU tetap aktif secara paralel: magnet adalah penguat tambahan, tidak pernah dapat mencabut blokir yang sudah diputuskan native."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:386
msgid "Comment savoir si un script magnet que j'importe est compatible AVANT de l'activer en production ?"
msgstr "Bagaimana mengetahui apakah skrip magnet yang saya impor kompatibel SEBELUM mengaktifkannya di produksi?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:388
msgid "Écran Active Sécurité -> WAF -> Magnet, bouton 'Vérifier la compatibilité' (ou `omega-serv waf test` en CLI) - exécute RÉELLEMENT le script avec les valeurs du formulaire en cours de saisie, pas seulement celles déjà enregistrées. Deux contrôles combinés : un scan statique signale toute référence `lighty.X` non supportée par ce pont (reste toujours `nil` côté Lua - un script bien écrit dégrade via son propre repli `or`, un script qui ne dégrade pas remonte une erreur réelle, capturée par le second contrôle) ; un smoke test exécute le script pour de vrai sur une requête de test bénigne. Les deux s'affichent comme avertissements explicites, jamais une vérification cachée."
msgstr "Layar Keamanan Aktif -> WAF -> Magnet, tombol 'Periksa kompatibilitas' (atau `omega-serv waf test` di CLI) - BENAR-BENAR menjalankan skrip dengan nilai formulir yang sedang diisi, bukan hanya yang sudah disimpan. Dua pemeriksaan digabung: pemindaian statis melaporkan setiap rujukan `lighty.X` yang tidak didukung jembatan ini (selalu `nil` di sisi Lua - skrip yang ditulis baik akan menurun melalui cadangan `or` miliknya, skrip yang tidak menurun memunculkan kesalahan nyata, yang ditangkap pemeriksaan kedua); smoke test menjalankan skrip sungguhan pada permintaan uji yang tidak berbahaya. Keduanya ditampilkan sebagai peringatan eksplisit, tidak pernah pemeriksaan tersembunyi."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:401
msgid "J'ai activé un script magnet avec on_error='fail-closed' et maintenant du trafic légitime se fait bloquer - pourquoi ?"
msgstr "Saya mengaktifkan skrip magnet dengan on_error='fail-closed' dan kini lalu lintas sah terblokir - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:403
msgid "`fail-closed` bloque TOUTE requête qui déclenche une erreur du script (incompatibilité, exception Lua, timeout) - une politique volontairement stricte, mais dangereuse combinée à un script jamais vérifié au préalable : une seule incompatibilité non détectée peut alors bloquer tout le trafic qui l'atteint. Lancez 'Vérifier la compatibilité' (voir question précédente) avant d'activer fail-closed en production - un avertissement explicite s'affiche précisément quand ces deux conditions se combinent. En cas de doute, repassez `on_error` à 'ignore' (le défaut) : le trafic continue d'être traité par le natif seul si le magnet échoue."
msgstr "`fail-closed` memblokir SETIAP permintaan yang memicu kesalahan skrip (ketidakcocokan, exception Lua, waktu habis) - kebijakan yang sengaja ketat, tetapi berbahaya jika digabung dengan skrip yang tidak pernah diperiksa sebelumnya: satu ketidakcocokan yang tidak terdeteksi bisa memblokir semua lalu lintas yang mengenainya. Jalankan 'Periksa kompatibilitas' (lihat pertanyaan sebelumnya) sebelum mengaktifkan fail-closed di produksi - peringatan eksplisit muncul tepat saat kedua kondisi ini bertemu. Jika ragu, kembalikan `on_error` ke 'ignore' (bawaan): lalu lintas tetap diproses oleh native saja jika magnet gagal."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:415
msgid "Les logs/la blocklist de mon script magnet importe n'apparaissent jamais sur le disque - pourquoi ?"
msgstr "Log/blocklist skrip magnet yang saya impor tidak pernah muncul di disk - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:417
msgid "Un script `mod_magnet` écrit typiquement ses logs/sa blocklist à des chemins ABSOLUS en dur (ex. `/etc/blocklist.txt`, `/var/log/...`) propres à son site d'origine - ces chemins n'ont aucune raison d'exister sur cette machine. La dissociation se fait via `options.waf.magnet.paths` (écran Magnet), injectés dans le script comme table Lua globale `omega_magnet_paths` : seule une COPIE adaptée du script (les 5 lignes de configuration modifiées pour lire cette table, avec repli sur le chemin en dur d'origine si absente) en bénéficie - le script importe lui-même doit être adapté une fois, manuellement (méthode générique, mais noms de chemins propres à chaque script). `secure/waf/scripts/waf.lua` (chemin par défaut de `options.waf.magnet.script`) est livre comme exemple minimal montrant cette technique - un vrai script importe (qui porte forcément la logique propre à SON site d'origine, jamais généralisable à l'avance) n'a jamais vocation à être redistribué tel quel à d'autres installations."
msgstr "Skrip `mod_magnet` biasanya menulis log/blocklist ke jalur ABSOLUT yang ditanam di kode (mis. `/etc/blocklist.txt`, `/var/log/...`) milik situs asalnya - jalur ini tidak punya alasan untuk ada di mesin ini. Pemisahan dilakukan melalui `options.waf.magnet.paths` (layar Magnet), yang disuntikkan ke skrip sebagai tabel Lua global `omega_magnet_paths`: hanya SALINAN skrip yang disesuaikan (5 baris konfigurasi diubah untuk membaca tabel ini, dengan cadangan ke jalur asli jika tidak ada) yang memanfaatkannya - skrip yang diimpor harus disesuaikan sekali secara manual (metode umum, tetapi nama jalur khas setiap skrip). `secure/waf/scripts/waf.lua` (jalur bawaan `options.waf.magnet.script`) disertakan sebagai contoh minimal yang menunjukkan teknik ini - skrip nyata yang diimpor (yang pasti membawa logika khas situs ASALNYA, tidak pernah dapat digeneralisasi sebelumnya) tidak dimaksudkan untuk didistribusikan apa adanya ke instalasi lain."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:433
msgid "Mon script magnet écrit une page HTML personnalisée (lighty.content) en cas de blocage - pourquoi je ne la vois jamais ?"
msgstr "Skrip magnet saya menulis halaman HTML kustom (lighty.content) saat memblokir - mengapa saya tidak pernah melihatnya?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:435
msgid "Choix délibéré, cohérent avec le reste du projet : le moteur WAF (natif ou magnet) rend TOUJOURS une décision, jamais une page HTML - c'est le serveur qui rend systématiquement sa propre page d'erreur générique. Les écritures `lighty.header`/`lighty.content` d'un script importe sont acceptées (le script ne plante jamais pour les avoir faites) mais jamais relues ni renvoyées au visiteur."
msgstr "Pilihan yang disengaja, konsisten dengan bagian lain proyek: mesin WAF (native atau magnet) SELALU mengembalikan keputusan, tidak pernah halaman HTML - server selalu menampilkan halaman kesalahan umumnya sendiri. Penulisan `lighty.header`/`lighty.content` oleh skrip impor diterima (skrip tidak pernah crash karenanya) tetapi tidak pernah dibaca ulang atau dikirim ke pengunjung."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:444
msgid "Les boutons de log 'waf magnet (alertes/blocklist)' restent grises dans l'écran Voir/Suivre - pourquoi ?"
msgstr "Tombol log 'waf magnet (peringatan/blocklist)' tetap abu-abu di layar Lihat/Ikuti - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:446
msgid "Ces deux logs sont proposes d'office (même si le magnet n'est jamais configuré), mais restent désactivés tant que `options.waf.magnet.enabled` n'est pas réellement actif - évite un clic qui ne mènerait qu'à un message d'erreur. Une fois actif, un clic fonctionne même si le fichier n'existe pas encore (log vide, jamais une erreur - aucune alerte déclenchée pour l'instant). Côté `lnav` (logs fusionnés), ces mêmes logs sont déjà cochables sans cette restriction : un log absent y est simplement ignore au lancement, sans bloquer les autres."
msgstr "Kedua log ini selalu ditawarkan (bahkan jika magnet tidak pernah dikonfigurasi), tetapi tetap nonaktif selama `options.waf.magnet.enabled` belum benar-benar aktif - menghindari klik yang hanya berujung pesan kesalahan. Setelah aktif, klik berfungsi bahkan jika berkas belum ada (log kosong, bukan kesalahan - belum ada peringatan yang terpicu). Di `lnav` (log gabungan), log yang sama sudah dapat dicentang tanpa batasan ini: log yang tidak ada hanya diabaikan saat start, tanpa memblokir yang lain."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:456
#: src/omega_serv/interfaces/tui/guide/content/faq.py:470
#: src/omega_serv/interfaces/tui/guide/content/faq.py:483
#: src/omega_serv/interfaces/tui/guide/content/faq.py:498
msgid "Sécurité - CSP et en-têtes"
msgstr "Keamanan - CSP dan header"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:457
msgid "J'ai ajouté une zone CSP pour un dossier, et maintenant ce dossier semble avoir perdu d'autres protections - pourquoi ?"
msgstr "Saya menambahkan zona CSP untuk sebuah folder, dan kini folder itu tampak kehilangan perlindungan lain - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:459
msgid "Une zone CSP REMPLACE ENTIÈREMENT la politique par défaut pour son préfixe - jamais une fusion/un simple ajout. Une zone qui ne contient que `style-src 'self' 'unsafe-inline'` par exemple fait disparaître toutes les AUTRES directives (`object-src`, `frame-ancestors`...) sous ce préfixe, qui retombent alors sur le comportement par défaut du navigateur plutôt que sur la politique globale stricte. L'assistant d'ajout de zone (écran Sécurité générique -> Ajouter une zone) existe exactement pour éviter ce piège : chaque directive y est pré-remplie avec sa valeur ACTUELLE (la politique globale), à modifier uniquement là où c'est nécessaire."
msgstr "Zona CSP MENGGANTIKAN SELURUH kebijakan bawaan untuk prefiksnya - tidak pernah menggabung/menambah. Zona yang hanya berisi `style-src 'self' 'unsafe-inline'` misalnya akan menghilangkan semua direktif LAIN (`object-src`, `frame-ancestors`...) di bawah prefiks ini, yang kemudian kembali ke perilaku bawaan browser, bukan kebijakan global yang ketat. Asisten penambahan zona (layar Keamanan umum -> Tambah zona) ada tepat untuk menghindari jebakan ini: setiap direktif diisi dengan nilai SAAT INI (kebijakan global), cukup diubah di bagian yang perlu."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:471
msgid "Comment autoriser 'unsafe-inline' (ou une source moins stricte) uniquement pour un dossier précis, sans affaiblir le reste du site ?"
msgstr "Bagaimana mengizinkan 'unsafe-inline' (atau sumber yang lebih longgar) hanya untuk folder tertentu, tanpa melemahkan bagian lain situs?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:473
msgid "Zones CSP (`security.csp_zones`, écran Sécurité générique) : une exception EXPLICITE par préfixe de chemin, jamais une relâche globale. L'assistant d'ajout détecte toute directive relâchée ('unsafe-inline'/'unsafe-eval'/source générique '*') et exige une confirmation explicite supplémentaire avant d'enregistrer. Cette zone reste ensuite TOUJOURS visible dans `omega-serv audit security` (règles CSP-001/CSP-002, qui scannent aussi les zones, pas seulement la politique globale) - même délibérée, jamais silencieuse."
msgstr "Zona CSP (`security.csp_zones`, layar Keamanan umum): pengecualian EKSPLISIT per prefiks jalur, tidak pernah pelonggaran global. Asisten penambahan mendeteksi setiap direktif yang dilonggarkan ('unsafe-inline'/'unsafe-eval'/sumber umum '*') dan mewajibkan konfirmasi eksplisit tambahan sebelum disimpan. Zona ini kemudian SELALU terlihat di `omega-serv audit security` (aturan CSP-001/CSP-002, yang juga memindai zona, bukan hanya kebijakan global) - meskipun disengaja, tidak pernah diam-diam."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:484
msgid "Pourquoi Cross-Origin-Embedder-Policy reste à 'unsafe-none' même en profil hardened ?"
msgstr "Mengapa Cross-Origin-Embedder-Policy tetap 'unsafe-none' bahkan pada profil hardened?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:486
msgid "Choix délibéré, différent de `Cross-Origin-Opener-Policy`/`Cross-Origin-Resource-Policy` (toujours `same-origin`, sans risque réel de casser un site) : une valeur stricte (`require-corp`/`credentialless`) peut bloquer des ressources cross-origin (polices, images, iframes tiers) propres au contenu RÉELLEMENT servi, qu'un serveur générique ne connaît jamais à l'avance - jamais un défaut imposé sans connaissance de ce contenu. Le header reste néanmoins toujours ÉMIS explicitement, même à cette valeur permissive (jamais absent de la réponse - un scanner externe distingue ainsi 'non considéré' de 'permissif par choix'). Réglable via `security.coep_mode` (écran Sécurité générique) si vous connaissez le contenu servi et voulez l'isolation complète."
msgstr "Pilihan yang disengaja, berbeda dari `Cross-Origin-Opener-Policy`/`Cross-Origin-Resource-Policy` (selalu `same-origin`, tanpa risiko nyata merusak situs): nilai ketat (`require-corp`/`credentialless`) dapat memblokir sumber daya cross-origin (font, gambar, iframe pihak ketiga) milik konten yang BENAR-BENAR disajikan, yang tidak pernah diketahui sebelumnya oleh server umum - tidak pernah dijadikan bawaan tanpa mengenal konten tersebut. Header tetap SELALU DIKIRIM secara eksplisit, bahkan dengan nilai longgar ini (tidak pernah absen dari respons - pemindai eksternal dapat membedakan 'tidak dipertimbangkan' dari 'longgar karena pilihan'). Dapat diatur melalui `security.coep_mode` (layar Keamanan umum) jika Anda mengenal konten yang disajikan dan menginginkan isolasi penuh."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:499
msgid "Le listing de répertoire (directory listing) perd tout son style visuel depuis que j'ai une CSP stricte - pourquoi ?"
msgstr "Directory listing kehilangan semua gayanya sejak saya memakai CSP ketat - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:501
msgid "Corrigé (2026-10-10) : le CSS du listing est désormais servi en fichier EXTERNE réservé plutôt qu'inline dans le HTML - `style-src 'self'` (politique par défaut) autorise déjà une feuille de style de même origine, sans besoin d'aucune exception. Si ce problème persiste après mise à jour, voir la question sur le redémarrage après mise à jour du code (catégorie Redémarrage et rechargement) : un simple rechargement (SIGHUP) ne suffit jamais à appliquer un changement de CODE, seul un redémarrage complet du service le fait."
msgstr "Sudah diperbaiki (2026-10-10): CSS listing kini disajikan sebagai berkas EKSTERNAL khusus, bukan inline di HTML - `style-src 'self'` (kebijakan bawaan) sudah mengizinkan stylesheet dari origin yang sama, tanpa perlu pengecualian apa pun. Jika masalah ini berlanjut setelah pembaruan, lihat pertanyaan tentang mulai ulang setelah pembaruan kode (kategori Mulai ulang dan muat ulang): muat ulang biasa (SIGHUP) tidak pernah cukup untuk menerapkan perubahan KODE, hanya mulai ulang penuh layanan yang bisa."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:511
#: src/omega_serv/interfaces/tui/guide/content/faq.py:531
#: src/omega_serv/interfaces/tui/guide/content/faq.py:548
#: src/omega_serv/interfaces/tui/guide/content/faq.py:566
msgid "TLS et certificats"
msgstr "TLS dan sertifikat"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:512
msgid "J'ai regenere/revoque le certificat TLS mais le serveur sert toujours l'ancien - pourquoi ?"
msgstr "Saya membuat ulang/mencabut sertifikat TLS tetapi server masih menyajikan yang lama - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:514
msgid "Le contexte SSL n'est construit qu'UNE SEULE FOIS au démarrage du serveur, jamais retouché par un simple rechargement. Régénérer ou révoquer un certificat pendant que TLS est déjà actif nécessite TOUJOURS un redémarrage complet pour que le changement soit réellement pris en compte, même si le fichier sur disque a déjà changé."
msgstr "Konteks SSL hanya dibangun SATU KALI saat server dimulai, tidak pernah disentuh oleh muat ulang biasa. Membuat ulang atau mencabut sertifikat saat TLS sudah aktif SELALU memerlukan mulai ulang penuh agar perubahan benar-benar berlaku, meskipun berkas di disk sudah berubah."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:521
msgid "Sauvegarde et restauration"
msgstr "Pencadangan dan pemulihan"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:522
msgid "Mes sauvegardes de configuration sont-elles chiffrées ?"
msgstr "Apakah cadangan konfigurasi saya dienkripsi?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:524
msgid "Non, jamais par défaut. Si vous incluez les zones d'authentification (hash de mots de passe) ou les certificats (clés privées TLS), la sauvegarde contient des secrets réels en clair - une confirmation explicite supplémentaire est demandée avant de créer ce type de sauvegarde. Protégez ces fichiers comme n'importe quel secret."
msgstr "Tidak, tidak pernah secara bawaan. Jika Anda menyertakan zona autentikasi (hash kata sandi) atau sertifikat (kunci privat TLS), cadangan berisi rahasia nyata dalam teks biasa - konfirmasi eksplisit tambahan diminta sebelum membuat cadangan jenis ini. Lindungi berkas ini seperti rahasia lainnya."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:532
msgid "Comment m'auto-héberger avec un vrai certificat public, de bout en bout (schéma DDNS -> Certbot -> OMEGA-SERV) ?"
msgstr "Bagaimana meng-host sendiri dengan sertifikat publik sungguhan, dari ujung ke ujung (skema DDNS -> Certbot -> OMEGA-SERV)?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:534
msgid "Le schéma complet : un service DDNS (Dynu ou équivalent) fait pointer un nom de domaine public (ex. monserveur.dynu.com) vers votre IP, mise à jour automatiquement par leur client à chaque changement - ENTIÈREMENT hors du périmètre d'OMEGA-SERV, à installer et configurer vous-même. Vous devez aussi rediriger les ports 80 et 443 de votre routeur/pare-feu vers cette machine. Une fois cela fait : Assistant Let's Encrypt (Configuration détaillée -> TLS) obtient le premier certificat (défi HTTP-01, webroot - port 80 doit être joignable depuis Internet le temps de la demande), l'importe et vous rappelle d'activer TLS (écran Activer/desactiver TLS) puis de redémarrer. Ensuite, Renouvellement automatique (même sous-menu) installe la planification (timer systemd ou crontab) qui renouvelle et redémarre tout seul, sans plus jamais intervenir manuellement pour cette partie."
msgstr "Skema lengkap: layanan DDNS (Dynu atau sejenisnya) mengarahkan nama domain publik (mis. monserveur.dynu.com) ke IP Anda, diperbarui otomatis oleh klien mereka setiap kali berubah - SEPENUHNYA di luar cakupan OMEGA-SERV, harus dipasang dan dikonfigurasi sendiri. Anda juga harus meneruskan port 80 dan 443 router/firewall ke mesin ini. Setelah itu: Asisten Let's Encrypt (Konfigurasi terperinci -> TLS) memperoleh sertifikat pertama (tantangan HTTP-01, webroot - port 80 harus dapat dijangkau dari Internet selama permintaan), mengimpornya, dan mengingatkan Anda untuk mengaktifkan TLS (layar Aktifkan/nonaktifkan TLS) lalu memulai ulang. Selanjutnya, Perpanjangan otomatis (submenu yang sama) memasang penjadwalan (timer systemd atau crontab) yang memperpanjang dan memulai ulang sendiri, tanpa perlu campur tangan manual lagi untuk bagian ini."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:549
msgid "OMEGA-SERV tourne dans un conteneur - comment obtenir un certificat Let's Encrypt ?"
msgstr "OMEGA-SERV berjalan dalam kontainer - bagaimana memperoleh sertifikat Let's Encrypt?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:551
msgid "N'exécutez PAS l'Assistant Let's Encrypt/le renouvellement automatique à l'intérieur du conteneur qui sert déjà le trafic public. Exécutez-les sur l'hôte (ou dans un conteneur/sidecar distinct dédié à l'administration) en partageant avec le conteneur serveur : le même volume de webroot (Certbot y dépose son défi, ce que le conteneur sert déjà via le port 80 qu'il expose), et le même volume secure/certificates/ - le conteneur serveur peut monter ce dernier en LECTURE SEULE, puisque l'import du certificat (écriture) se fait toujours côté hote/sidecar, jamais depuis le conteneur servant le trafic. Un redémarrage du conteneur serveur reste nécessaire après chaque renouvellement (même règle que partout ailleurs : le contexte SSL n'est jamais rechargé à chaud) - le hook de renouvellement redémarre le SERVICE qu'il connaît (hote/sidecar), pensez à l'adapter si le conteneur serveur est pilote séparément (ex. `docker restart`) plutôt que par un service systemd/OpenRC/runit classique."
msgstr "JANGAN jalankan Asisten Let's Encrypt/perpanjangan otomatis di dalam kontainer yang sudah menyajikan lalu lintas publik. Jalankan di host (atau di kontainer/sidecar terpisah khusus administrasi) dengan berbagi kepada kontainer server: volume webroot yang sama (Certbot meletakkan tantangannya di sana, yang sudah disajikan kontainer melalui port 80 yang diekspos), dan volume secure/certificates/ yang sama - kontainer server dapat memasang volume terakhir ini sebagai HANYA BACA, karena impor sertifikat (penulisan) selalu dilakukan di sisi host/sidecar, tidak pernah dari kontainer yang menyajikan lalu lintas. Mulai ulang kontainer server tetap diperlukan setelah setiap perpanjangan (aturan yang sama seperti di tempat lain: konteks SSL tidak pernah dimuat ulang saat berjalan) - hook perpanjangan memulai ulang LAYANAN yang dikenalnya (host/sidecar), ingat untuk menyesuaikannya jika kontainer server dikendalikan terpisah (mis. `docker restart`) dan bukan oleh layanan systemd/OpenRC/runit biasa."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:567
msgid "L'Assistant Let's Encrypt échoue (défi HTTP-01) - pourquoi ?"
msgstr "Asisten Let's Encrypt gagal (tantangan HTTP-01) - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:569
msgid "Les causes les plus fréquentes, dans l'ordre à vérifier : (1) le port 80 n'est pas réellement joignable depuis Internet (redirection de port manquante ou incorrecte sur le routeur/pare-feu, ou un autre service occupe déjà ce port sur la machine), (2) le domaine ne pointe pas encore vers cette IP (DNS/DDNS pas encore propagé - vérifiez avec `dig`/`nslookup` depuis une machine externe), (3) en mode test (staging, coché par défaut) tout fonctionne mais le certificat obtenu n'est jamais reconnu par les navigateurs - c'est normal, décochez la case une fois le domaine et le webroot vérifiés. Le message d'erreur affiché est directement celui renvoyé par Certbot - il précise généralement laquelle de ces causes s'applique."
msgstr "Penyebab paling umum, urut sesuai pemeriksaan: (1) port 80 sebenarnya tidak dapat dijangkau dari Internet (penerusan port tidak ada atau salah di router/firewall, atau layanan lain sudah memakai port ini di mesin), (2) domain belum mengarah ke IP ini (DNS/DDNS belum menyebar - periksa dengan `dig`/`nslookup` dari mesin luar), (3) dalam mode uji (staging, dicentang secara bawaan) semuanya berjalan tetapi sertifikat yang diperoleh tidak pernah dikenali browser - itu normal, hapus centang setelah domain dan webroot terverifikasi. Pesan kesalahan yang ditampilkan langsung berasal dari Certbot - biasanya menunjukkan penyebab mana yang berlaku."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:581
#: src/omega_serv/interfaces/tui/guide/content/faq.py:593
#: src/omega_serv/interfaces/tui/guide/content/faq.py:604
#: src/omega_serv/interfaces/tui/guide/content/faq.py:615
#: src/omega_serv/interfaces/tui/guide/content/faq.py:630
#: src/omega_serv/interfaces/tui/guide/content/faq.py:642
#: src/omega_serv/interfaces/tui/guide/content/faq.py:654
#: src/omega_serv/interfaces/tui/guide/content/faq.py:666
#: src/omega_serv/interfaces/tui/guide/content/faq.py:678
#: src/omega_serv/interfaces/tui/guide/content/faq.py:689
#: src/omega_serv/interfaces/tui/guide/content/faq.py:700
#: src/omega_serv/interfaces/tui/guide/content/faq.py:713
#: src/omega_serv/interfaces/tui/screens/active_defense_menu_screen.py:121
msgid "RIPOSTE"
msgstr "RIPOSTE"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:582
msgid "Quelle différence entre Active Defense et RIPOSTE ?"
msgstr "Apa bedanya Active Defense dan RIPOSTE?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:584
msgid "Active Defense agit PENDANT la requête : il note chaque source selon ce qu'elle fait maintenant (score, niveaux normal / suspicious / hostile / contained) et réagit tout de suite (leurre, ralentissement, incident). RIPOSTE agit DANS LA DURÉE : il se souvient des sources qui reviennent après un silence (épisodes) et leur applique des bans de plus en plus longs (paliers, par défaut 1 h, 6 h, 24 h, 7 j), avec une échéance, une levée possible et une mémoire de récidive. RIPOSTE ne modifie jamais le score ni les seuils d'Active Defense ; il peut seulement exiger un niveau Active Defense minimal dans une politique."
msgstr "Active Defense bertindak SELAMA permintaan: ia menilai setiap sumber berdasarkan apa yang dilakukannya sekarang (skor, tingkat normal / suspicious / hostile / contained) dan langsung bereaksi (umpan, perlambatan, insiden). RIPOSTE bertindak DARI WAKTU KE WAKTU: ia mengingat sumber yang kembali setelah masa tenang (episode) dan memberinya blokir yang makin lama (tingkat, bawaan 1 jam, 6 jam, 24 jam, 7 hari), dengan tenggat, kemungkinan pencabutan, dan ingatan residivis. RIPOSTE tidak pernah mengubah skor atau ambang Active Defense; ia hanya dapat mensyaratkan tingkat Active Defense minimum dalam kebijakan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:594
msgid "Pourquoi RIPOSTE a-t-il banni cette adresse ?"
msgstr "Mengapa RIPOSTE memblokir alamat ini?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:596
msgid "Écran Actions : le détail de l'action donne la politique, le palier, l'événement d'origine et l'échéance. Écran Simuler, « Décisions récentes » : chaque décision est expliquée ligne par ligne (politique retenue, nombre de retours, exclusions vérifiées). En ligne de commande : « riposte actions show <id> » et « riposte decisions list --ip <adresse> --explain ». Faux positif : « Lever » avec « ne pas compter ce ban dans la récidive », et au besoin « Lever et exempter cette source »."
msgstr "Layar Tindakan: detail tindakan memberikan kebijakan, tingkat, peristiwa asal, dan tenggat. Layar Simulasi, « Keputusan terbaru »: setiap keputusan dijelaskan baris demi baris (kebijakan terpilih, jumlah kembali, pengecualian yang diperiksa). Di baris perintah: « riposte actions show <id> » dan « riposte decisions list --ip <alamat> --explain ». Positif palsu: « Cabut » dengan « jangan hitung blokir ini sebagai residivis », dan bila perlu « Cabut dan kecualikan sumber ini »."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:605
msgid "J'ai levé un ban RIPOSTE mais l'adresse reste bloquée - pourquoi ?"
msgstr "Saya sudah mencabut blokir RIPOSTE tetapi alamatnya masih diblokir - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:607
msgid "Une politique « ban local + ban réseau » passe aussi le ban à fail2ban, par les jails omega-jail <service>-riposte-1h/6h/24h/7d. omega-serv n'a pas les droits de lever un ban fail2ban : « Lever » ne retire que le ban local (blocklist du WAF). Levez le ban réseau dans omega-fire ou avec fail2ban-client (la jail est indiquée dans le détail de l'action). Vérifiez aussi qu'un ban du WAF ou un ban manuel ne couvre pas la même adresse : RIPOSTE n'y touche jamais."
msgstr "Kebijakan « blokir lokal + blokir jaringan » juga meneruskan blokir ke fail2ban, melalui jail omega-jail <service>-riposte-1h/6h/24h/7d. omega-serv tidak berhak mencabut blokir fail2ban: « Cabut » hanya menghapus blokir lokal (blocklist WAF). Cabut blokir jaringan di omega-fire atau dengan fail2ban-client (jail tercantum di detail tindakan). Periksa juga bahwa blokir WAF atau blokir manual tidak mencakup alamat yang sama: RIPOSTE tidak pernah menyentuhnya."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:616
msgid "Les scénarios « Explorateur de leurres » et « Sonde upload / API » sont refusés (profil de leurre inconnu) - que faire ?"
msgstr "Skenario “Penjelajah umpan” dan “Probe upload / API” ditolak (profil umpan tidak dikenal) - apa yang harus dilakukan?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:618
msgid "Ces deux scénarios ne bannissent pas : ils envoient la source vers un leurre d'Active Defense, qui doit donc exister AVANT de charger le scénario - « Explorateur de leurres » utilise le profil fake_admin, « Sonde upload / API » le profil fake_api. (1) L'option active_defense doit être activée (menu Options). (2) Dans Active Sécurité -> Réglages (bloc Active Defense) : « Deception active » = oui, puis Enregistrer. (3) Toujours dans Réglages, « Ajouter un profil » : Nom fake_admin (ou fake_api), Actif oui, Classes d'attaque scan,credential_stuffing pour fake_admin ou api_probe,upload_probe pour fake_api, Isolation fixture, Zone de leurre vide. (4) Revenez dans RIPOSTE -> Politiques -> Ajouter -> Scénario prêt à charger : le scénario est accepté. Les leurres ne fonctionnent qu'après un redémarrage complet. Les trois autres scénarios bannissent et n'ont besoin d'aucun leurre."
msgstr "Kedua skenario ini tidak memblokir: keduanya mengirim sumber ke umpan Active Defense, yang karena itu harus ada SEBELUM skenario dimuat - “Penjelajah umpan” memakai profil fake_admin, “Probe upload / API” memakai profil fake_api. (1) Opsi active_defense harus diaktifkan (menu Opsi). (2) Di Keamanan Aktif -> Pengaturan (blok Active Defense): “Deception aktif” = ya, lalu Simpan. (3) Masih di Pengaturan, “Tambah profil”: Nama fake_admin (atau fake_api), Aktif ya, kelas serangan scan,credential_stuffing untuk fake_admin atau api_probe,upload_probe untuk fake_api, Isolation fixture, zona umpan kosong. (4) Kembali ke RIPOSTE -> Kebijakan -> Tambah -> Skenario siap muat: skenario diterima. Umpan baru berfungsi setelah mulai ulang penuh. Tiga skenario lainnya memblokir dan tidak memerlukan umpan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:631
msgid "RIPOSTE ne fait rien - pourquoi ?"
msgstr "RIPOSTE tidak melakukan apa-apa - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:633
msgid "Dans l'ordre : (1) le module 'riposte' doit être activé dans Options, puis le service REDÉMARRÉ complètement ; (2) le WAF doit être actif, sinon RIPOSTE ne voit aucune attaque ; (3) au moins une politique doit être active (« Enregistrer sans activer » la laisse en observation) ; (4) l'arrêt d'urgence ne doit pas être actif (écran État : le bouton affiche « Reprendre ») ; (5) la condition doit être atteinte : par exemple 3 épisodes en 7 jours, un épisode étant séparé du précédent par au moins 1 h de silence. Simuler avec la même situation montre la condition qui manque."
msgstr "Berurutan: (1) modul 'riposte' harus diaktifkan di Opsi, lalu layanan DIMULAI ULANG sepenuhnya; (2) WAF harus aktif, jika tidak RIPOSTE tidak melihat serangan apa pun; (3) setidaknya satu kebijakan harus aktif (« Simpan tanpa mengaktifkan » membiarkannya dalam pengamatan); (4) henti darurat tidak boleh aktif (layar Status: tombol menampilkan « Lanjutkan »); (5) syarat harus tercapai: misalnya 3 episode dalam 7 hari, tiap episode dipisahkan dari sebelumnya oleh setidaknya 1 jam masa tenang. Menyimulasikan situasi yang sama menunjukkan syarat yang kurang."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:643
msgid "Une adresse bannie reçoit une page 451 : est-ce omega-serv ou fail2ban ?"
msgstr "Alamat yang di-ban menerima halaman 451: apakah itu omega-serv atau fail2ban?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:645
msgid "C'est omega-serv. Une adresse présente dans la liste de blocage du WAF (auto-ban du WAF, ban manuel ou ban local RIPOSTE) reçoit la page 451 « Votre IP a été bannie » sur toutes ses requêtes, pendant toute la durée du ban. Un 403 refuse seulement une requête (une règle touchée), sans bannir. Un ban fail2ban agit sur le pare-feu : il ne renvoie jamais de page, la connexion est coupée ou n'aboutit pas. Pour savoir qui a banni, regardez la source du ban dans la liste de blocage (« auto » = auto-ban du WAF, « riposte », « manual ») : WAF → Modules → Liste de blocage, ou « blocklist list »."
msgstr "Itu omega-serv. Alamat yang ada di daftar blokir WAF (auto-ban WAF, ban manual, atau ban lokal RIPOSTE) menerima halaman 451 “IP Anda telah di-ban” untuk semua permintaannya, selama ban berlangsung. Kode 403 hanya menolak satu permintaan (sebuah aturan terpicu), tanpa mem-ban. Ban fail2ban bekerja di firewall: tidak pernah mengembalikan halaman, koneksi diputus atau tidak pernah tersambung. Untuk mengetahui siapa yang mem-ban, lihat sumber ban di daftar blokir (« auto » = auto-ban WAF, « riposte », « manual »): WAF → Modul → Daftar blokir, atau « blocklist list »."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:655
msgid "À quoi servent les jails omega-serv-riposte-1h, -6h, -24h et -7d ?"
msgstr "Untuk apa jail omega-serv-riposte-1h, -6h, -24h, dan -7d?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:657
msgid "Ce sont les jails fail2ban du ban réseau de RIPOSTE, installés par omega-jail (1.1.0 ou plus). Quand une politique « ban local + ban réseau » bannit, omega-serv pose d'abord le ban local, puis écrit une ligne dans « var/log/riposte-decisions.jsonl » ; fail2ban la lit et bannit l'adresse au pare-feu. Les jails ont une durée fixe : chaque palier RIPOSTE va à la plus longue qui ne le dépasse pas (un palier de 2 h va dans la jail de 1 h), et l'interface l'indique. Chaque instance omega-serv a son propre jeu de jails, préfixé par le nom de son service."
msgstr "Itu adalah jail fail2ban untuk ban jaringan RIPOSTE, dipasang oleh omega-jail (1.1.0 atau lebih baru). Saat kebijakan “ban lokal + ban jaringan” mem-ban, omega-serv lebih dulu memasang ban lokal, lalu menulis satu baris ke « var/log/riposte-decisions.jsonl »; fail2ban membacanya dan mem-ban alamat di firewall. Jail ini berdurasi tetap: setiap tingkat RIPOSTE masuk ke jail terlama yang tidak melebihinya (tingkat 2 jam masuk ke jail 1 jam), dan antarmuka menampilkannya. Setiap instans omega-serv memiliki set jail sendiri, diawali nama layanannya."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:667
msgid "J'ai mis à jour omega-jail, mais les jails RIPOSTE n'apparaissent ni dans fail2ban ni dans omega-fire"
msgstr "Saya memperbarui omega-jail, tetapi jail RIPOSTE tidak muncul di fail2ban maupun di omega-fire"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:669
msgid "Mettre à jour omega-jail ne suffit pas à installer ses nouveaux jails. Extrayez l'archive par-dessus le dossier existant, puis lancez « ./install.sh » : il liste les jails du catalogue pas encore installés et propose de les installer (« sudo »). À défaut : « sudo ./omega-jail.sh --apply ». Les jails RIPOSTE ne sont proposés que si le module RIPOSTE est activé dans omega-serv (sinon « source non configurée »). Vérification : « sudo fail2ban-client status ». omega-fire les affiche dès qu'ils sont installés, sans rien à déclarer."
msgstr "Memperbarui omega-jail saja tidak memasang jail barunya. Ekstrak arsip menimpa folder yang ada, lalu jalankan « ./install.sh »: ia mencantumkan jail katalog yang belum terpasang dan menawarkan untuk memasangnya (« sudo »). Jika tidak: « sudo ./omega-jail.sh --apply ». Jail RIPOSTE hanya ditawarkan jika modul RIPOSTE diaktifkan di omega-serv (jika tidak, “sumber belum dikonfigurasi”). Pemeriksaan: « sudo fail2ban-client status ». omega-fire menampilkannya begitu terpasang, tanpa perlu dideklarasikan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:679
msgid "Derrière Tailscale Funnel ou un proxy local, le ban réseau sert-il à quelque chose ?"
msgstr "Di balik Tailscale Funnel atau proxy lokal, apakah ban jaringan ada gunanya?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:681
msgid "Pas le ban fail2ban seul : les connexions arrivent alors du proxy local (tailscaled, 127.0.0.1), pas du visiteur, et le ban pare-feu ne le touche pas. omega-jail (1.1.0 ou plus) le détecte et relaie alors chaque ban fail2ban d'une adresse publique dans la liste de blocage d'omega-serv : l'adresse reçoit la page 451, comme avec le script Magnet. Les jails RIPOSTE ne sont pas relayés : RIPOSTE a déjà posé son ban local (451). Quand les visiteurs se connectent directement au serveur, le ban pare-feu agit seul."
msgstr "Bukan ban fail2ban saja: koneksi saat itu datang dari proxy lokal (tailscaled, 127.0.0.1), bukan dari pengunjung, dan ban firewall tidak mengenainya. omega-jail (1.1.0 atau lebih baru) mendeteksinya lalu meneruskan setiap ban fail2ban untuk alamat publik ke daftar blokir omega-serv: alamat menerima halaman 451, seperti dengan skrip Magnet. Jail RIPOSTE tidak diteruskan: RIPOSTE sudah memasang ban lokalnya (451). Saat pengunjung terhubung langsung ke server, ban firewall bekerja sendiri."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:690
msgid "La jail omega-serv-active-defense fait-elle double emploi avec RIPOSTE ?"
msgstr "Apakah jail omega-serv-active-defense tumpang tindih dengan RIPOSTE?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:692
msgid "En partie. Cette jail d'omega-jail bannit au pare-feu pendant 24 h fixes toute adresse classée hostile ou contained par Active Defense, sans tenir compte des paliers RIPOSTE : une adresse peut donc être bannie au niveau réseau plus tôt ou plus longtemps que le palier choisi. L'écran État de RIPOSTE la signale. Gardez-la si vous voulez ce filet de sécurité ; retirez-la (gestion des jails d'omega-fire) si seuls les paliers RIPOSTE doivent compter."
msgstr "Sebagian. Jail omega-jail ini mem-ban di firewall selama 24 jam tetap setiap alamat yang diklasifikasikan hostile atau contained oleh Active Defense, tanpa memperhatikan tingkat RIPOSTE: sebuah alamat bisa di-ban di tingkat jaringan lebih awal atau lebih lama dari tingkat yang dipilih. Layar Status RIPOSTE menandainya. Pertahankan jika Anda ingin jaring pengaman ini; hapus (pengelolaan jail omega-fire) jika hanya tingkat RIPOSTE yang boleh berlaku."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:701
msgid "Mon attaque de test ne déclenche aucun ban RIPOSTE - pourquoi ?"
msgstr "Serangan uji saya tidak memicu ban RIPOSTE apa pun - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:703
msgid "Dans l'ordre : (1) la requête doit toucher une règle du WAF, ce qui donne un 403 (par exemple « /?id=1 UNION SELECT 1 » ou « /.env ») ; une simple 404 n'est pas une attaque ; (2) l'adresse ne doit pas être exemptée : hôte local, Tailscale et réseau local ne sont jamais bannis, testez depuis une adresse publique (4G) et, derrière un proxy, réglez le proxy de confiance ; (3) la politique doit être remplie : nombre d'épisodes, classes d'attaque et niveau Active Defense minimal (« aucun » pour un test) ; (4) une adresse déjà bannie (page 451, souvent par l'auto-ban du WAF) n'est plus analysée : RIPOSTE ignore les refus de la liste de blocage, levez d'abord ce ban. Simuler la même situation montre ce qui manque."
msgstr "Berurutan: (1) permintaan harus memicu aturan WAF, yang menghasilkan 403 (misalnya « /?id=1 UNION SELECT 1 » atau « /.env »); 404 biasa bukan serangan; (2) alamat tidak boleh dikecualikan: host lokal, Tailscale, dan jaringan lokal tidak pernah di-ban, uji dari alamat publik (4G) dan, di balik proxy, atur proxy tepercaya; (3) kebijakan harus terpenuhi: jumlah episode, kelas serangan, dan tingkat Active Defense minimum (“tidak ada” untuk uji); (4) alamat yang sudah di-ban (halaman 451, sering karena auto-ban WAF) tidak lagi dianalisis: RIPOSTE mengabaikan penolakan daftar blokir, cabut ban itu terlebih dahulu. Menyimulasikan situasi yang sama menunjukkan apa yang kurang."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:714
msgid "Pourquoi omega-fire n'affiche-t-il que les bans fail2ban ?"
msgstr "Mengapa omega-fire hanya menampilkan ban fail2ban?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:716
msgid "omega-fire lit fail2ban et le pare-feu. Les bans d'omega-serv (liste de blocage du WAF, page 451 : auto-ban, ban manuel, ban local RIPOSTE) se consultent pour l'instant dans omega-serv : WAF → Modules → Liste de blocage, écran Actions de RIPOSTE, ou « blocklist list ». Les jails installés par omega-jail, dont ceux de RIPOSTE, apparaissent bien dans omega-fire."
msgstr "omega-fire membaca fail2ban dan firewall. Ban omega-serv (daftar blokir WAF, halaman 451: auto-ban, ban manual, ban lokal RIPOSTE) untuk saat ini dilihat di omega-serv: WAF → Modul → Daftar blokir, layar Tindakan RIPOSTE, atau « blocklist list ». Jail yang dipasang omega-jail, termasuk jail RIPOSTE, tetap muncul di omega-fire."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:723
#: src/omega_serv/interfaces/tui/guide/content/faq.py:746
#: src/omega_serv/interfaces/tui/guide/content/faq.py:764
#: src/omega_serv/interfaces/tui/guide/content/faq.py:776
#: src/omega_serv/interfaces/tui/guide/content/faq.py:786
msgid "Moteur HTTP et performances"
msgstr "Mesin HTTP dan kinerja"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:724
msgid "Moteur Python ou natif : qu'est-ce que ça change concrètement ?"
msgstr "Mesin Python atau native: apa bedanya dalam praktik?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:726
msgid "Ce qui ne change pas : les réponses, les journaux, la sécurité et les fonctions disponibles. Ce qui change, c'est qui traite les requêtes HTTP : l'interpréteur Python, ou un programme compilé qui utilise tous les cœurs. Avec le WAF, le moteur natif cherche lui-même les règles : une requête sur laquelle aucune règle ne correspond est servie sans passer par Python ; au moindre doute (correspondance, texte non ASCII, en-têtes ou corps à inspecter, source suivie par Active Defense, zone d'authentification), c'est Python qui décide, exactement comme avec le moteur Python. Si magnet est actif, toutes les requêtes passent par Python ; la limite de débit, elle, est comptée par le moteur natif, sans coût mesurable. Mesuré sur trois machines (comparatif des serveurs web, à lire pour le détail), le moteur natif sert les petites pages 10 à 27 fois plus vite que le moteur Python sans contrôle de sécurité, et 8 à 30 fois plus vite avec le WAF, qui ne lui retire que 5 à 22 % de son débit ; les fichiers de 100 Ko 3,5 à 10 fois plus vite ; les gros fichiers 1,3 à 2,7 fois plus vite. Le temps de réponse des requêtes les plus lentes est divisé par 5 à 15. En échange, il occupe environ 5 Mo de mémoire en plus, et environ 8 Mo de plus avec le WAF (règles chargées dans le natif). Le listing, les pages internes, le reverse proxy, FastCGI, l'envoi de fichiers et WebSocket sont confiés à Python : ces requêtes-là gardent la vitesse du moteur Python. Pour un petit site peu visité, les deux suffisent largement : même le moteur Python avec le WAF sert des dizaines de millions de requêtes par jour sur une machine modeste."
msgstr "Yang tidak berubah: respons, log, keamanan, dan fungsi yang tersedia. Yang berubah adalah siapa yang menangani permintaan HTTP: interpreter Python, atau program terkompilasi yang memakai semua inti. Dengan WAF, mesin native memeriksa sendiri aturan: permintaan yang tidak cocok dengan aturan apa pun dilayani tanpa melalui Python; pada keraguan sekecil apa pun (kecocokan, teks non-ASCII, header atau body yang perlu diperiksa, sumber yang diawasi Active Defense, zona autentikasi), Python yang memutuskan, persis seperti dengan mesin Python. Jika magnet aktif, semua permintaan melalui Python; sedangkan pembatasan laju dihitung oleh mesin native, tanpa biaya yang terukur. Diukur pada tiga mesin (perbandingan server web, baca untuk detailnya), mesin native menyajikan halaman kecil 10 hingga 27 kali lebih cepat daripada mesin Python tanpa pemeriksaan keamanan, dan 8 hingga 30 kali lebih cepat dengan WAF, yang hanya mengurangi 5 hingga 22 % throughput-nya; berkas 100 KB 3,5 hingga 10 kali lebih cepat; berkas besar 1,3 hingga 2,7 kali lebih cepat. Waktu respons permintaan paling lambat dibagi 5 hingga 15. Sebagai gantinya, ia memakai sekitar 5 MB memori lebih banyak, dan sekitar 8 MB lagi dengan WAF (aturan yang dimuat ke mesin native). Daftar direktori, halaman internal, reverse proxy, FastCGI, pengiriman berkas, dan WebSocket diserahkan ke Python: permintaan itu tetap secepat mesin Python. Untuk situs kecil yang jarang dikunjungi, keduanya lebih dari cukup: bahkan mesin Python dengan WAF melayani puluhan juta permintaan per hari di mesin sederhana."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:747
msgid "Combien de processus choisir ?"
msgstr "Berapa banyak proses yang harus dipilih?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:749
msgid "Ça dépend du moteur. Moteur Python : chaque processus sert les requêtes ; mesuré, 2 processus servent 1,6 à 2 fois plus que 1, et 4 environ 3,5 fois plus, jusqu'au nombre de cœurs physiques (le maximum proposé). Chaque processus occupe environ 10 à 20 Mo de mémoire de plus. Moteur natif : il utilise déjà tous les cœurs, les processus réglés sont ceux des contrôles de sécurité, qui ne reçoivent que les requêtes à vérifier (correspondance ou doute du WAF, sources suivies par Active Defense, authentification). Pour le trafic ordinaire, un 2e processus n'apporte donc rien : mesuré, le débit reste le même. Il sert quand toutes les requêtes passent par Python (magnet actif) et que la machine a au moins 4 cœurs physiques : 1,5 à 1,7 fois plus de requêtes. Sur 2 cœurs, il n'apporte que 5 à 12 %, le processeur étant déjà occupé : l'écran ne le propose donc qu'à partir de 4 cœurs. Au-delà de 2, le gain mesuré est de 4 %. L'écran Résistance et limites affiche le maximum de cette machine et ce qu'augmenter apporte ; le nombre réellement appliqué s'affiche dans État & Ressources."
msgstr "Tergantung mesinnya. Mesin Python: setiap proses melayani permintaan; diukur, 2 proses melayani 1,6 hingga 2 kali lebih banyak daripada 1, dan 4 sekitar 3,5 kali lebih banyak, hingga jumlah inti fisik (maksimum yang ditawarkan). Setiap proses memakai sekitar 10 hingga 20 MB memori lebih banyak. Mesin native: sudah memakai semua inti, proses yang diatur adalah proses pemeriksaan keamanan, yang hanya menerima permintaan yang perlu diperiksa (kecocokan atau keraguan WAF, sumber yang diawasi Active Defense, autentikasi). Jadi untuk lalu lintas biasa, proses ke-2 tidak memberi apa-apa: diukur, throughput tetap sama. Proses itu berguna ketika semua permintaan melalui Python (magnet aktif) dan mesin memiliki setidaknya 4 inti fisik: 1,5 hingga 1,7 kali lebih banyak permintaan. Pada 2 inti hanya memberi 5 hingga 12 %, karena prosesor sudah sibuk: karena itu layar hanya menawarkannya mulai dari 4 inti. Di atas 2, keuntungan yang diukur adalah 4 %. Layar Ketahanan dan batas menampilkan maksimum mesin ini dan apa yang diberikan oleh penambahan; jumlah yang benar-benar diterapkan ditampilkan di Status & Sumber Daya."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:765
msgid "Pourquoi le choix « Natif C++ » est-il grisé dans Configuration de base ?"
msgstr "Mengapa pilihan « Native C++ » berwarna abu-abu di Konfigurasi dasar?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:767
msgid "Parce qu'une cause empêche le moteur natif de tout servir : le binaire bin/omega-http-core est absent ou ne démarre pas sur cette machine (install.sh essaie alors de le recompiler), ou TLS est en mode direct alors que le reverse proxy, FastCGI ou l'envoi de fichiers est actif (ces routes demandent de confier la connexion au processus Python, impossible quand le natif chiffre lui-même). La liste des causes, et comment lever chacune, s'affiche sous le choix. Jamais de serveur à moitié natif : levez la cause, puis choisissez le natif."
msgstr "Karena ada penyebab yang menghalangi mesin native melayani semuanya: biner bin/omega-http-core tidak ada atau tidak bisa berjalan di mesin ini (install.sh lalu mencoba mengompilasinya ulang), atau TLS dalam mode langsung sementara reverse proxy, FastCGI, atau unggah berkas aktif (rute ini perlu menyerahkan koneksi ke proses Python, yang tidak mungkin jika native mengenkripsi sendiri). Daftar penyebab, dan cara menghilangkan masing-masing, ditampilkan di bawah pilihan. Tidak pernah ada server setengah native: hilangkan penyebabnya, lalu pilih native."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:777
msgid "Le moteur natif change-t-il mes journaux, fail2ban (omega-jail) ou RIPOSTE ?"
msgstr "Apakah mesin native mengubah log, fail2ban (omega-jail), atau RIPOSTE saya?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:779
msgid "Non. Le journal d'accès est écrit au même format, caractère pour caractère, et les journaux de sécurité (alertes WAF, événements Active Defense) sont écrits par le même code Python qu'avec le moteur Python. RIPOSTE, omega-jail et omega-fire lisent les mêmes lignes et ne voient aucune différence. Une adresse bannie l'est quel que soit le moteur."
msgstr "Tidak. Log akses ditulis dengan format yang sama, karakter demi karakter, dan log keamanan (peringatan WAF, peristiwa Active Defense) ditulis oleh kode Python yang sama seperti pada mesin Python. RIPOSTE, omega-jail, dan omega-fire membaca baris yang sama dan tidak melihat perbedaan. Alamat yang diblokir tetap diblokir apa pun mesinnya."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:787
msgid "J'ai choisi le moteur natif mais État & Ressources indique « Python » - pourquoi ?"
msgstr "Saya memilih mesin native tetapi Status & Sumber Daya menampilkan « Python » - mengapa?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:789
msgid "Le serveur n'a pas encore été redémarré (le moteur ne change qu'au redémarrage complet), ou le natif n'a pas pu démarrer : binaire absent ou refusé, ou fonction active qu'il ne sait pas servir. Dans ce cas le moteur Python sert tout, et la raison est affichée dans État & Ressources (section MOTEUR HTTP), dans le journal d'erreurs et par la commande « omega-serv engine status ». Rien n'est jamais servi à moitié par l'un et à moitié par l'autre."
msgstr "Server belum di-restart (mesin hanya berganti pada restart penuh), atau native tidak bisa berjalan: biner tidak ada atau ditolak, atau ada fungsi aktif yang tidak bisa dilayaninya. Dalam hal itu mesin Python melayani semuanya, dan alasannya ditampilkan di Status & Sumber Daya (bagian MESIN HTTP), di log kesalahan, dan oleh perintah « omega-serv engine status ». Tidak pernah ada yang dilayani setengah oleh satu mesin dan setengah oleh mesin lainnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:62
msgid "Gestion des logs (menu)"
msgstr "Pengelolaan log (menu)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:11
msgid "Accueil -> Gestion des logs"
msgstr "Beranda -> Pengelolaan log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:13
msgid "Sous-menu en 2 colonnes : BIBLIOTHÈQUE (consultation - Bibliotheque/Favoris/Voir les logs/Voir et traiter IP) et MAINTENANCE (rotation/archivage - inchangée depuis la Phase 6)."
msgstr "Submenu 2 kolom: PUSTAKA (melihat - Pustaka/Favorit/Lihat log/Lihat dan tangani IP) dan PEMELIHARAAN (rotasi/pengarsipan - tidak berubah sejak Fase 6)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:23
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:63
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:43
msgid "Bibliothèque"
msgstr "Pustaka"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:24
msgid "Accueil -> Gestion des logs -> Bibliothèque"
msgstr "Beranda -> Pengelolaan log -> Pustaka"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:26
msgid "Hub central référençant tous les logs à traiter (ceux d'Omega-Serv ou tout autre fichier de log de la machine) - alimentation MANUELLE (aucun scan automatique du système pour cette passe). Source commune de 'Voir les logs', 'Favoris' et 'Voir et traiter IP'."
msgstr "Pusat yang merujuk semua log yang akan ditangani (milik Omega-Serv atau berkas log lain di mesin) - diisi MANUAL (tidak ada pemindaian sistem otomatis untuk tahap ini). Sumber bersama untuk 'Lihat log', 'Favorit', dan 'Lihat dan tangani IP'."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:33
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:56
msgid "Chemin à ajouter manuellement"
msgstr "Jalur yang ditambahkan manual"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:34
msgid "Référence un fichier de log quelconque dans la Bibliothèque."
msgstr "Merujuk berkas log apa pun di Pustaka."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:35
msgid "Chemin absolu ou relatif au projet - le fichier n'a pas besoin d'exister déjà."
msgstr "Jalur absolut atau relatif terhadap proyek - berkas tidak harus sudah ada."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:36
msgid "Ajoute (ou remplace si déjà présent) une entrée."
msgstr "Menambahkan (atau mengganti jika sudah ada) entri."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:37
msgid "Aucun effet sur le serveur - l'état (existe/taille) est toujours recalculé à l'affichage."
msgstr "Tidak ada efek pada server - status (ada/ukuran) selalu dihitung ulang saat ditampilkan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:40
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:60
msgid "Ajouter les logs connus d'Omega-Serv"
msgstr "Tambahkan log Omega-Serv yang dikenal"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:41
msgid "Ajoute en un clic les logs propres à ce projet (access/error/waf-alerts, + magnet si actif)."
msgstr "Menambahkan dalam satu klik log milik proyek ini (access/error/waf-alerts, + magnet jika aktif)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:42
msgid "Aucune saisie requise."
msgstr "Tidak perlu isian."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:43
msgid "Ajoute (ou remplace) ces entrées dans la Bibliothèque."
msgstr "Menambahkan (atau mengganti) entri ini di Pustaka."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:44
msgid "Jamais un scan du reste du système - uniquement les quelques logs déjà connus de ce projet."
msgstr "Tidak pernah memindai bagian lain sistem - hanya beberapa log yang sudah dikenal proyek ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:47
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:66
msgid "Retirer la sélection"
msgstr "Lepas pilihan"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:48
msgid "Retire une entrée de la Bibliothèque (ne supprime jamais le fichier lui-même)."
msgstr "Melepas entri dari Pustaka (tidak pernah menghapus berkasnya sendiri)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:49
#: src/omega_serv/interfaces/tui/guide/content/logs.py:90
#: src/omega_serv/interfaces/tui/guide/content/logs.py:141
msgid "Sélectionner une ligne, confirmation obligatoire."
msgstr "Pilih baris, konfirmasi wajib."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:50
msgid "Retire l'entrée du fichier var/library.json."
msgstr "Melepas entri dari berkas var/library.json."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:51
msgid "Le fichier de log sur disque n'est jamais touché - seule la référence est retirée."
msgstr "Berkas log di disk tidak pernah disentuh - hanya rujukannya yang dilepas."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:54
msgid "Purement une liste de références - aucun effet sur les fichiers de log eux-mêmes."
msgstr "Murni daftar rujukan - tidak ada efek pada berkas log itu sendiri."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:57
msgid "L'état affiché (OK/SUSPECT/ABSENT) est toujours recalculé en lisant le disque réellement à chaque ouverture de cet écran, jamais une donnée figée au moment de l'ajout."
msgstr "Status yang ditampilkan (OK/SUSPECT/ABSENT) selalu dihitung ulang dengan benar-benar membaca disk setiap kali layar ini dibuka, tidak pernah data yang dibekukan saat penambahan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:66
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:65
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:44
msgid "Favoris"
msgstr "Favorit"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:67
msgid "Accueil -> Gestion des logs -> Favoris"
msgstr "Beranda -> Pengelolaan log -> Favorit"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:68
msgid "Combinaisons nommées (un ou plusieurs logs de la Bibliothèque + un viewer) pour un lancement direct."
msgstr "Kombinasi bernama (satu atau beberapa log dari Pustaka + sebuah viewer) untuk dibuka langsung."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:71
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:49
msgid "Lancer"
msgstr "Jalankan"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:72
msgid "Ouvre directement le favori sélectionné avec son viewer d'origine."
msgstr "Membuka langsung favorit yang dipilih dengan viewer aslinya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:73
msgid "Sélectionner une ligne dans la table des favoris."
msgstr "Pilih baris di tabel favorit."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:74
msgid "Ouvre l'écran du viewer correspondant (Simple/Classique/lnav)."
msgstr "Membuka layar viewer terkait (Sederhana/Klasik/lnav)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:75
#: src/omega_serv/interfaces/tui/guide/content/logs.py:221
#: src/omega_serv/interfaces/tui/guide/content/logs.py:253
#: src/omega_serv/interfaces/tui/guide/content/logs.py:271
msgid "Aucun effet sur le serveur (lecture seule)."
msgstr "Tidak ada efek pada server (hanya baca)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:78
msgid "Numéros + Nom du favori + Viewer + Enregistrer"
msgstr "Nomor + Nama favorit + Viewer + Simpan"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:79
msgid "Crée un nouveau favori à partir de logs choisis dans la Bibliothèque."
msgstr "Membuat favorit baru dari log yang dipilih di Pustaka."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:81
msgid "Numéros séparés par des virgules (ex: 1,3) - un seul log autorisé avec Simple/Classique, lnav uniquement au-delà d'un log."
msgstr "Nomor dipisahkan koma (mis.: 1,3) - hanya satu log yang diizinkan dengan Sederhana/Klasik, lnav hanya untuk lebih dari satu log."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:84
msgid "Enregistre le favori (remplace un favori existant du même nom)."
msgstr "Menyimpan favorit (mengganti favorit yang ada dengan nama yang sama)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:85
msgid "Refuse à la création si le viewer choisi est incompatible avec le nombre de logs - jamais tronqué silencieusement."
msgstr "Ditolak saat pembuatan jika viewer yang dipilih tidak cocok dengan jumlah log - tidak pernah dipotong diam-diam."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:89
msgid "Retire définitivement un favori."
msgstr "Melepas favorit secara permanen."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:91
msgid "Retire l'entrée du fichier var/favorites.json."
msgstr "Melepas entri dari berkas var/favorites.json."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:92
msgid "Ne touche jamais aux fichiers de log eux-mêmes ni à la Bibliothèque."
msgstr "Tidak pernah menyentuh berkas log itu sendiri maupun Pustaka."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:95
msgid "Purement des raccourcis - aucun effet sur les fichiers de log eux-mêmes."
msgstr "Murni pintasan - tidak ada efek pada berkas log itu sendiri."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:100
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:64
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:62
msgid "Sources distantes (SSH)"
msgstr "Sumber jarak jauh (SSH)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:101
msgid "Accueil -> Gestion des logs -> Bibliothèque -> Sources distantes (SSH)"
msgstr "Beranda -> Pengelolaan log -> Pustaka -> Sumber jarak jauh (SSH)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:103
msgid "Permet de récupérer, à la demande, UNE COPIE du log d'un serveur backend situé sur le même réseau local (derrière le reverse proxy) via scp, puis de l'ajouter automatiquement à la Bibliothèque - ce n'est jamais une consultation en direct du serveur distant, mais un instantané figé au moment du clic sur 'Récupérer maintenant' ; une nouvelle récupération remplace la copie précédente par une plus récente. Aucun scan réseau automatique, aucune connexion sans configuration explicite de votre part."
msgstr "Memungkinkan mengambil, sesuai permintaan, SATU SALINAN log dari server backend di jaringan lokal yang sama (di belakang reverse proxy) melalui scp, lalu menambahkannya otomatis ke Pustaka - ini tidak pernah melihat server jarak jauh secara langsung, melainkan cuplikan yang dibekukan saat mengeklik 'Ambil sekarang'; pengambilan baru mengganti salinan sebelumnya dengan yang lebih baru. Tidak ada pemindaian jaringan otomatis, tidak ada koneksi tanpa konfigurasi eksplisit dari Anda."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:112
msgid "Label / Hôte / Chemin distant"
msgstr "Label / Host / Jalur jarak jauh"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:113
msgid "Identifie la source : un nom de votre choix, l'adresse du serveur, et le chemin du fichier de log sur ce serveur."
msgstr "Mengidentifikasi sumber: nama pilihan Anda, alamat server, dan jalur berkas log di server tersebut."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:114
msgid "Tous les trois sont obligatoires. L'hôte peut être une adresse IP, un nom d'hôte, ou un alias déjà défini dans votre ~/.ssh/config."
msgstr "Ketiganya wajib. Host dapat berupa alamat IP, nama host, atau alias yang sudah ditentukan di ~/.ssh/config Anda."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:115
#: src/omega_serv/interfaces/tui/guide/content/logs.py:122
msgid "Pris en compte au clic sur Enregistrer."
msgstr "Diperhitungkan saat mengeklik Simpan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:116
msgid "Aucun effet réseau - purement une définition locale, tant que 'Récupérer maintenant' n'est pas utilisé."
msgstr "Tidak ada efek jaringan - murni definisi lokal, selama 'Ambil sekarang' tidak digunakan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:119
msgid "Utilisateur / Port / Chemin de la clé privée"
msgstr "Pengguna / Port / Jalur kunci privat"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:120
msgid "Optionnels - laissez vide pour utiliser les réglages par défaut de votre propre ssh (agent, ~/.ssh/config)."
msgstr "Opsional - biarkan kosong untuk memakai pengaturan bawaan ssh Anda sendiri (agent, ~/.ssh/config)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:121
msgid "Ne renseignez que ce qui diffère des réglages par défaut de votre configuration SSH habituelle."
msgstr "Isi hanya yang berbeda dari pengaturan bawaan konfigurasi SSH Anda yang biasa."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:123
msgid "Omega-Serv ne lit ni ne stocke JAMAIS le contenu d'une clé - uniquement son chemin, si vous en indiquez un."
msgstr "Omega-Serv TIDAK PERNAH membaca atau menyimpan isi kunci - hanya jalurnya, jika Anda menunjukkannya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:126
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:75
msgid "Récupérer maintenant"
msgstr "Ambil sekarang"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:127
msgid "Lance scp vers l'hôte de la source sélectionnée et ajoute le résultat à la Bibliothèque."
msgstr "Menjalankan scp ke host sumber yang dipilih dan menambahkan hasilnya ke Pustaka."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:128
msgid "Sélectionner une ligne dans la table active le bouton."
msgstr "Memilih baris di tabel mengaktifkan tombol."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:129
msgid "Tourne en arrière-plan (l'interface reste utilisable) ; un message indique le résultat."
msgstr "Berjalan di latar belakang (antarmuka tetap dapat dipakai); sebuah pesan menunjukkan hasilnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:131
msgid "Écrit un fichier dans var/log/remote/ (en écrasant une éventuelle copie précédente de la même source) et l'ajoute à la Bibliothèque (accès affiché comme 'ssh', colonne 'Modifié' = date de CETTE récupération, jamais celle du fichier distant) - en cas d'échec (hôte injoignable, scp absent, droits refuses), le message d'erreur du système est affiché tel quel, aucun fichier n'est ajouté."
msgstr "Menulis berkas ke var/log/remote/ (menimpa salinan sebelumnya dari sumber yang sama, jika ada) dan menambahkannya ke Pustaka (akses ditampilkan sebagai 'ssh', kolom 'Diubah' = tanggal pengambilan INI, bukan tanggal berkas jarak jauh) - jika gagal (host tidak terjangkau, scp tidak ada, hak ditolak), pesan kesalahan sistem ditampilkan apa adanya, tidak ada berkas yang ditambahkan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:140
msgid "Retire définitivement une source distante (ne supprime jamais un fichier déjà récupéré)."
msgstr "Melepas sumber jarak jauh secara permanen (tidak pernah menghapus berkas yang sudah diambil)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:142
msgid "Retire l'entrée du fichier var/remote-log-sources.json."
msgstr "Melepas entri dari berkas var/remote-log-sources.json."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:143
msgid "Un fichier déjà récupéré dans la Bibliothèque n'est pas retiré par cette action."
msgstr "Berkas yang sudah diambil di Pustaka tidak dilepas oleh tindakan ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:147
msgid "Aucune action réseau n'est jamais entreprise automatiquement - uniquement au clic explicite sur 'Récupérer maintenant'. Aucun mot de passe n'est jamais demandé ni stocké."
msgstr "Tidak ada tindakan jaringan yang pernah dilakukan otomatis - hanya saat mengeklik 'Ambil sekarang' secara eksplisit. Kata sandi tidak pernah diminta atau disimpan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:152
msgid "Aucune vérification de taille n'est faite avant ou pendant le transfert - un fichier distant très volumineux sera récupéré en intégralité."
msgstr "Tidak ada pemeriksaan ukuran sebelum atau selama transfer - berkas jarak jauh yang sangat besar akan diambil seluruhnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:156
msgid "Une adresse IPv6 écrite directement (sans alias ~/.ssh/config) n'est pas supportée par la syntaxe hôte:chemin de scp."
msgstr "Alamat IPv6 yang ditulis langsung (tanpa alias ~/.ssh/config) tidak didukung oleh sintaks host:jalur scp."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:164
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:66
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:45
msgid "Voir les logs"
msgstr "Lihat log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:165
msgid "Accueil -> Gestion des logs -> Voir les logs"
msgstr "Beranda -> Pengelolaan log -> Lihat log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:167
msgid "Choisit un ou plusieurs logs EXCLUSIVEMENT depuis la Bibliothèque (aucun import manuel ici), puis un viewer : Simple (tail en direct + stats génériques), Classique (lecture + suivi), lnav (fusion multi-logs)."
msgstr "Memilih satu atau beberapa log HANYA dari Pustaka (tidak ada impor manual di sini), lalu viewer: Sederhana (tail langsung + statistik umum), Klasik (baca + ikuti), lnav (gabungan beberapa log)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:173
msgid "Numéros (ex: 1,3)"
msgstr "Nomor (mis.: 1,3)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:174
msgid "Sélectionne un ou plusieurs logs de la Bibliothèque par leur numéro de ligne."
msgstr "Memilih satu atau beberapa log Pustaka berdasarkan nomor barisnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:175
msgid "Séparés par des virgules pour en sélectionner plusieurs."
msgstr "Dipisahkan koma untuk memilih beberapa."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:176
msgid "Détermine les logs ouverts par les 3 boutons de viewer."
msgstr "Menentukan log yang dibuka oleh 3 tombol viewer."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:180
msgid "Voir (simple) / Voir (classique) / Voir (lnav)"
msgstr "Lihat (sederhana) / Lihat (klasik) / Lihat (lnav)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:181
msgid "Ouvre les logs sélectionnés avec le viewer choisi."
msgstr "Membuka log yang dipilih dengan viewer yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:182
msgid "Simple et Classique exigent exactement UN log sélectionné ; lnav fonctionne avec un ou plusieurs."
msgstr "Sederhana dan Klasik mewajibkan tepat SATU log dipilih; lnav bekerja dengan satu atau beberapa."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:183
msgid "Ouvre l'écran du viewer correspondant."
msgstr "Membuka layar viewer terkait."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:184
msgid "Refus explicite si le viewer est incompatible avec le nombre de logs sélectionnés."
msgstr "Penolakan eksplisit jika viewer tidak cocok dengan jumlah log yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:187
msgid "Purement consultatif - la sélection de logs ici n'est jamais mémorisée (voir Favoris pour cela)."
msgstr "Murni untuk melihat - pilihan log di sini tidak pernah disimpan (lihat Favorit untuk itu)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:192
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:67
msgid "Voir les logs - Simple"
msgstr "Lihat log - Sederhana"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:193
msgid "Accueil -> Gestion des logs -> Voir les logs -> Voir (simple)"
msgstr "Beranda -> Pengelolaan log -> Lihat log -> Lihat (sederhana)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:195
msgid "Suit un log en direct avec un parseur GÉNÉRIQUE (fonctionne sur n'importe quel format - access log, auth.log, syslog...) et un petit tableau de statistiques (IPs uniques, taux d'erreur, répartition des codes HTTP si le format s'y prête)."
msgstr "Mengikuti log secara langsung dengan pengurai UMUM (bekerja pada format apa pun - access log, auth.log, syslog...) dan tabel statistik kecil (IP unik, tingkat kesalahan, sebaran kode HTTP jika formatnya memungkinkan)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:200
msgid "Purement consultatif, aucun effet sur le serveur."
msgstr "Murni untuk melihat, tidak ada efek pada server."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:203
msgid "La section 'STATUTS HTTP' n'apparaît que si au moins une ligne du tampon ressemble à un access log Combined/Common - jamais affichée pour un auth.log/syslog."
msgstr "Bagian 'STATUS HTTP' hanya muncul jika setidaknya satu baris buffer mirip access log Combined/Common - tidak pernah ditampilkan untuk auth.log/syslog."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:212
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:68
msgid "Voir les logs - Classique"
msgstr "Lihat log - Klasik"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:213
msgid "Accueil -> Gestion des logs -> Voir les logs -> Voir (classique)"
msgstr "Beranda -> Pengelolaan log -> Lihat log -> Lihat (klasik)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:214
msgid "Affiche les 200 dernières lignes d'un log choisi dans la Bibliothèque et peut suivre son évolution en direct."
msgstr "Menampilkan 200 baris terakhir log yang dipilih dari Pustaka dan dapat mengikuti perkembangannya secara langsung."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:217
#: src/omega_serv/interfaces/tui/screens/log_viewer_screen.py:52
#: src/omega_serv/interfaces/tui/screens/log_viewer_screen.py:111
msgid "Suivre en direct"
msgstr "Ikuti langsung"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:218
msgid "Rafraîchit l'affichage automatiquement toutes les secondes avec les nouvelles lignes."
msgstr "Menyegarkan tampilan otomatis setiap detik dengan baris baru."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:219
msgid "Bascule marche/arret."
msgstr "Sakelar hidup/mati."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:220
msgid "Demarre/arrete le suivi périodique."
msgstr "Memulai/menghentikan pengikutan berkala."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:224
msgid "Purement consultatif, aucun effet sur le serveur ou sa configuration."
msgstr "Murni untuk melihat, tidak ada efek pada server atau konfigurasinya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:227
msgid "Un fichier appartenant au compte système dédié du service peut rester illisible depuis une session qui n'a pas encore pris en compte son appartenance de groupe (mêmes causes que le piège déjà documenté pour SERVICE - reconnectez votre session)."
msgstr "Berkas milik akun sistem khusus layanan bisa tetap tidak terbaca dari sesi yang belum memperhitungkan keanggotaan grupnya (penyebab sama dengan jebakan yang sudah didokumentasikan untuk SERVICE - masuk ulang ke sesi Anda)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:236
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:69
#: src/omega_serv/interfaces/tui/screens/lnav_screen.py:52
msgid "Suivre les logs fusionnés (lnav)"
msgstr "Ikuti log gabungan (lnav)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:237
msgid "Accueil -> Gestion des logs -> Voir les logs -> Voir (lnav), ou directement en cas de sélection multiple"
msgstr "Beranda -> Pengelolaan log -> Lihat log -> Lihat (lnav), atau langsung jika memilih beberapa"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:238
msgid "Lance l'outil externe lnav sur un ou plusieurs logs fusionnés chronologiquement, dans un vrai terminal."
msgstr "Menjalankan alat eksternal lnav pada satu atau beberapa log yang digabung secara kronologis, di terminal sungguhan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:241
msgid "Cases à cocher (Access/Error/WAF alerts log/WAF magnet)"
msgstr "Kotak centang (Access/Error/WAF alerts log/WAF magnet)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:243
msgid "Choisit quels logs connus fusionner dans la même vue lnav - inclut d'office les 2 logs du script WAF complémentaire magnet (options.waf.magnet.paths, §7), même si le magnet n'est pas actif."
msgstr "Memilih log dikenal mana yang digabung dalam tampilan lnav yang sama - selalu menyertakan 2 log skrip WAF pelengkap magnet (options.waf.magnet.paths, §7), meskipun magnet tidak aktif."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:248
msgid "Une ou plusieurs cases, au moins un fichier existant requis. Un log coché mais absent (ex. magnet jamais activé) est simplement ignore au lancement, jamais bloquant pour les autres."
msgstr "Satu atau beberapa kotak, minimal satu berkas yang ada. Log yang dicentang tetapi tidak ada (mis. magnet tidak pernah diaktifkan) hanya diabaikan saat start, tidak pernah menghalangi yang lain."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:252
#: src/omega_serv/interfaces/tui/guide/content/logs.py:259
#: src/omega_serv/interfaces/tui/guide/content/logs.py:270
msgid "Pris en compte au clic sur Lancer lnav."
msgstr "Diperhitungkan saat mengeklik Jalankan lnav."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:256
msgid "Logs sélectionnés depuis la Bibliothèque (si ouvert via 'Voir les logs')"
msgstr "Log yang dipilih dari Pustaka (jika dibuka melalui 'Lihat log')"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:257
msgid "Pré-coche les logs choisis dans l'écran 'Voir les logs' - jamais ajouté aux épingles persistées."
msgstr "Mencentang terlebih dahulu log yang dipilih di layar 'Lihat log' - tidak pernah ditambahkan ke pin yang disimpan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:258
msgid "Décocher pour exclure un log de cette fusion ponctuelle."
msgstr "Hapus centang untuk mengecualikan log dari penggabungan kali ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:260
msgid "Une sélection ponctuelle depuis la Bibliothèque, contrairement à une épingle, ne survit pas à cet écran."
msgstr "Pilihan sesaat dari Pustaka, berbeda dengan pin, tidak bertahan setelah layar ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:263
msgid "Chemins épinglés (cases à cocher dynamiques)"
msgstr "Jalur yang disematkan (kotak centang dinamis)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:265
msgid "Chemins manuels ajoutés par 'Épingler ce chemin' - persistent entre sessions (contrairement au champ manuel ci-dessous), affiches comme des logs connus supplémentaires."
msgstr "Jalur manual yang ditambahkan dengan 'Sematkan jalur ini' - bertahan antar sesi (berbeda dengan bidang manual di bawah), ditampilkan sebagai log dikenal tambahan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:269
msgid "Une case par chemin épinglé - coché ou non, comme les logs connus."
msgstr "Satu kotak per jalur yang disematkan - dicentang atau tidak, seperti log yang dikenal."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:274
msgid "Chemin manuel + Épingler ce chemin"
msgstr "Jalur manual + Sematkan jalur ini"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:275
msgid "Saisit un chemin de log hors des logs connus, et le conserve pour les prochains lancements."
msgstr "Memasukkan jalur log di luar log yang dikenal, dan menyimpannya untuk peluncuran berikutnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:277
msgid "Chemin relatif au projet ou absolu. 'Épingler ce chemin' l'ajoute à la liste des épingles (ci-dessus) ET vide ce champ - sans epinglage, le chemin ne sert qu'une seule fois, pour ce lancement."
msgstr "Jalur relatif terhadap proyek atau absolut. 'Sematkan jalur ini' menambahkannya ke daftar pin (di atas) DAN mengosongkan bidang ini - tanpa disematkan, jalur hanya dipakai sekali, untuk peluncuran ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:281
msgid "Chemin non épinglé : pris en compte au clic sur Lancer lnav, pour cette fois seulement. Épinglé : persiste (voir settings.json) jusqu'à retrait explicite."
msgstr "Jalur tidak disematkan: diperhitungkan saat mengeklik Jalankan lnav, hanya kali ini. Disematkan: bertahan (lihat settings.json) sampai dilepas secara eksplisit."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:285
msgid "Retirer une épingle choisie"
msgstr "Lepas pin yang dipilih"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:286
msgid "Retire définitivement un chemin de la liste des épingles."
msgstr "Melepas jalur dari daftar pin secara permanen."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:287
msgid "Choisir le chemin dans la liste déroulante, puis cliquer sur le bouton."
msgstr "Pilih jalur di daftar tarik-turun, lalu klik tombolnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:288
msgid "Supprime l'épingle et sa case à cocher correspondante."
msgstr "Menghapus pin dan kotak centangnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:289
msgid "Aucun effet sur le serveur - n'affecte jamais le fichier de log lui-même, seulement la liste des raccourcis."
msgstr "Tidak ada efek pada server - tidak pernah memengaruhi berkas log itu sendiri, hanya daftar pintasan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:292
#: src/omega_serv/interfaces/tui/screens/lnav_screen.py:128
msgid "Lancer lnav"
msgstr "Jalankan lnav"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:293
msgid "Ouvre lnav en plein écran dans le terminal réel."
msgstr "Membuka lnav layar penuh di terminal sungguhan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:294
msgid "Nécessite au moins un fichier existant sélectionné."
msgstr "Memerlukan setidaknya satu berkas yang ada dipilih."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:295
msgid "Suspend l'interface et rend la main au terminal."
msgstr "Menangguhkan antarmuka dan menyerahkan kendali ke terminal."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:296
msgid "Aucun effet sur le serveur - quitter lnav (Ctrl-Q) revient à cet écran."
msgstr "Tidak ada efek pada server - keluar dari lnav (Ctrl-Q) kembali ke layar ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:301
msgid "Nécessite que l'outil lnav soit installé sur le système - indisponible sinon, message explicite."
msgstr "Memerlukan alat lnav terpasang di sistem - jika tidak, tidak tersedia dengan pesan eksplisit."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:307
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:70
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:46
msgid "Voir et traiter IP"
msgstr "Lihat dan tangani IP"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:308
msgid "Accueil -> Gestion des logs -> Voir et traiter IP"
msgstr "Beranda -> Pengelolaan log -> Lihat dan tangani IP"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:310
msgid "Liste les IP les plus actives parmi un ou plusieurs logs de la Bibliothèque (n'importe quel format, pas seulement l'access log), avec possibilité de retirer une IP des logs analyses."
msgstr "Menampilkan IP paling aktif di satu atau beberapa log Pustaka (format apa pun, bukan hanya access log), dengan kemungkinan melepas sebuah IP dari log yang dianalisis."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:316
msgid "Numéros (ex: 1,2)"
msgstr "Nomor (mis.: 1,2)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:317
msgid "Sélectionne un ou plusieurs logs de la Bibliothèque à analyser."
msgstr "Memilih satu atau beberapa log Pustaka untuk dianalisis."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:318
msgid "Séparés par des virgules pour en analyser plusieurs ensemble."
msgstr "Dipisahkan koma untuk menganalisis beberapa sekaligus."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:319
msgid "Détermine les logs lus par les boutons de période."
msgstr "Menentukan log yang dibaca oleh tombol periode."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:323
msgid "24 heures / 7 jours / 30 jours / Tout"
msgstr "24 jam / 7 hari / 30 hari / Semua"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:324
msgid "Choisit la période analysée."
msgstr "Memilih periode yang dianalisis."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:325
msgid "Un clic recalculé immédiatement la liste."
msgstr "Satu klik langsung menghitung ulang daftar."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:326
msgid "Relit et reanalyse les logs sélectionnés."
msgstr "Membaca dan menganalisis ulang log yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:330
#: src/omega_serv/interfaces/tui/screens/process_ip_screen.py:66
msgid "Retirer cette IP des logs analyses"
msgstr "Lepas IP ini dari log yang dianalisis"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:331
msgid "Supprime toutes les lignes contenant l'IP sélectionnée, dans TOUS les logs analyses."
msgstr "Menghapus semua baris yang berisi IP yang dipilih, di SEMUA log yang dianalisis."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:332
msgid "Sélectionner une ligne active le bouton, avec confirmation obligatoire."
msgstr "Memilih baris mengaktifkan tombol, dengan konfirmasi wajib."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:333
msgid "Réécrit chaque fichier de log concerne sans les lignes de cette IP."
msgstr "Menulis ulang setiap berkas log terkait tanpa baris IP ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:334
msgid "Modification DÉFINITIVE et immédiate des fichiers de log - action destructive."
msgstr "Perubahan PERMANEN dan langsung pada berkas log - tindakan destruktif."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:337
msgid "Le retrait d'IP modifie directement et irréversiblement les fichiers de log concernés."
msgstr "Pelepasan IP langsung dan tidak dapat dibatalkan mengubah berkas log terkait."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:339
msgid "La reconnaissance d'une IP dans une ligne ne dépend d'aucun format particulier - fonctionne identiquement quel que soit le type de log."
msgstr "Pengenalan IP dalam baris tidak bergantung pada format tertentu - bekerja sama untuk jenis log apa pun."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:345
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:71
msgid "Rotation / archivage des logs"
msgstr "Rotasi / pengarsipan log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:346
msgid "Accueil -> Gestion des logs -> Rotation / archivage des logs"
msgstr "Beranda -> Pengelolaan log -> Rotasi / pengarsipan log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:347
msgid "Quatre modes : rotation conditionnelle (seuil de taille), sauvegarde immédiate inconditionnelle, planifier une automatisation, gérer les automatisations existantes."
msgstr "Empat mode: rotasi bersyarat (ambang ukuran), cadangan langsung tanpa syarat, menjadwalkan otomatisasi, mengelola otomatisasi yang ada."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:350
#: src/omega_serv/interfaces/tui/screens/log_rotation_screen.py:67
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:85
#: src/omega_serv/interfaces/tui/screens/riposte_policy_form_screen.py:117
msgid "Action"
msgstr "Tindakan"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:351
msgid "Choisit le mode de cet écran."
msgstr "Memilih mode layar ini."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:353
msgid "'Tourner si nécessaire' (respecte le seuil de taille configuré), 'Sauvegarde maintenant' (inconditionnelle), 'Configurer une automatisation', 'Gérer les automatisations'."
msgstr "'Rotasi bila perlu' (mengikuti ambang ukuran yang dikonfigurasi), 'Cadangkan sekarang' (tanpa syarat), 'Konfigurasi otomatisasi', 'Kelola otomatisasi'."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:357
msgid "Change les champs affiches en dessous."
msgstr "Mengubah bidang yang ditampilkan di bawahnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:358
msgid "Aucun effet en lui-même, juste un changement d'affichage."
msgstr "Tidak ada efek dengan sendirinya, hanya perubahan tampilan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:361
#: src/omega_serv/interfaces/tui/screens/log_rotation_screen.py:70
msgid "Log cible"
msgstr "Log sasaran"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:362
msgid "Le fichier de log concerne par l'action."
msgstr "Berkas log yang terkena tindakan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:363
msgid "access, error ou waf_alerts."
msgstr "access, error atau waf_alerts."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:364
#: src/omega_serv/interfaces/tui/guide/content/logs.py:371
msgid "Utilisé par Valider."
msgstr "Digunakan oleh Konfirmasi."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:365
msgid "Archive réellement le fichier immédiatement (modes rotation/sauvegarde)."
msgstr "Benar-benar mengarsipkan berkas seketika (mode rotasi/cadangan)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:368
msgid "Fréquence (mode automatisation)"
msgstr "Frekuensi (mode otomatisasi)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:369
msgid "À quelle fréquence l'automatisation doit se déclencher."
msgstr "Seberapa sering otomatisasi harus berjalan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:370
msgid "Hebdomadaire, mensuelle, trimestrielle, semestrielle ou annuelle."
msgstr "Mingguan, bulanan, triwulanan, semesteran, atau tahunan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:372
msgid "Enregistre une automatisation - ne déclenche PAS une rotation immédiate."
msgstr "Menyimpan otomatisasi - TIDAK memicu rotasi langsung."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:375
msgid "Automatisations planifiées (mode gestion)"
msgstr "Otomatisasi terjadwal (mode kelola)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:376
msgid "Liste des automatisations déjà enregistrées."
msgstr "Daftar otomatisasi yang sudah disimpan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:377
msgid "Sélectionner une ligne active le bouton de suppression."
msgstr "Memilih baris mengaktifkan tombol hapus."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:378
msgid "Supprimer la sélection retire l'automatisation (avec confirmation)."
msgstr "Menghapus pilihan melepas otomatisasi (dengan konfirmasi)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:379
msgid "Suppression immédiate et définitive de l'automatisation choisie."
msgstr "Penghapusan langsung dan permanen otomatisasi yang dipilih."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:383
msgid "'Tourner si nécessaire' ne fait rien si logs.rotation.enabled est désactivé dans la configuration, ou si le fichier n'a pas atteint le seuil de taille configuré. 'Sauvegarde maintenant' archive TOUJOURS, quelle que soit la taille."
msgstr "'Rotasi bila perlu' tidak melakukan apa-apa jika logs.rotation.enabled dinonaktifkan di konfigurasi, atau jika berkas belum mencapai ambang ukuran yang dikonfigurasi. 'Cadangkan sekarang' SELALU mengarsipkan, berapa pun ukurannya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:389
msgid "Les archives sont écrites dans var/backups/logs/, un emplacement distinct de var/backups/ (réservé aux sauvegardes de configuration)."
msgstr "Arsip ditulis ke var/backups/logs/, lokasi yang terpisah dari var/backups/ (khusus untuk cadangan konfigurasi)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:397
msgid "Restaurer une archive de log"
msgstr "Pulihkan arsip log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:398
msgid "Accueil -> Gestion des logs -> Restaurer une archive de log"
msgstr "Beranda -> Pengelolaan log -> Pulihkan arsip log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:399
msgid "Extrait le contenu d'une archive de log déjà créée vers un répertoire de restauration."
msgstr "Mengekstrak isi arsip log yang sudah dibuat ke direktori pemulihan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:402
msgid "Table des archives + Restaurer"
msgstr "Tabel arsip + Pulihkan"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:403
msgid "Sélectionne une archive et l'extrait."
msgstr "Memilih arsip dan mengekstraknya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:404
msgid "Sélectionner une ligne active le bouton Restaurer."
msgstr "Memilih baris mengaktifkan tombol Pulihkan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:405
msgid "Extrait l'archive vers var/log/restored/<nom-archive>/."
msgstr "Mengekstrak arsip ke var/log/restored/<nama-arsip>/."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:406
msgid "Écriture réelle sur disque immédiate, aucun effet sur le serveur en cours."
msgstr "Penulisan nyata langsung ke disk, tidak ada efek pada server yang berjalan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:409
msgid "N'écrase jamais les logs actifs - extrait toujours vers un sous-répertoire dédié."
msgstr "Tidak pernah menimpa log aktif - selalu mengekstrak ke subdirektori khusus."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:414
msgid "Purger les archives de logs"
msgstr "Bersihkan arsip log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:415
msgid "Accueil -> Gestion des logs -> Purger les archives de logs"
msgstr "Beranda -> Pengelolaan log -> Bersihkan arsip log"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:416
msgid "Supprime définitivement une archive de log."
msgstr "Menghapus arsip log secara permanen."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:419
msgid "Table des archives + Supprimer"
msgstr "Tabel arsip + Hapus"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:420
msgid "Sélectionne une archive et la supprime."
msgstr "Memilih arsip dan menghapusnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:421
msgid "Sélectionner une ligne active le bouton Supprimer, avec confirmation obligatoire."
msgstr "Memilih baris mengaktifkan tombol Hapus, dengan konfirmasi wajib."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:422
msgid "Supprime le fichier d'archive."
msgstr "Menghapus berkas arsip."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:423
msgid "Suppression immédiate et DÉFINITIVE - action destructive, jamais réversible."
msgstr "Penghapusan langsung dan PERMANEN - tindakan destruktif, tidak pernah dapat dibatalkan."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:426
msgid "Action irréversible - aucune corbeille ni sauvegarde préalable automatique."
msgstr "Tindakan tidak dapat dibatalkan - tidak ada tempat sampah atau cadangan otomatis sebelumnya."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:431
msgid "Exporter Archives"
msgstr "Ekspor arsip"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:432
msgid "Accueil -> Gestion des logs -> Exporter Archives"
msgstr "Beranda -> Pengelolaan log -> Ekspor arsip"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:433
msgid "Exporte la liste des archives de logs (métadonnées, pas leur contenu) en JSON ou HTML."
msgstr "Mengekspor daftar arsip log (metadata, bukan isinya) dalam JSON atau HTML."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:437
msgid "Palette de couleurs utilisée pour l'export HTML."
msgstr "Palet warna yang dipakai untuk ekspor HTML."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:443
msgid "Exporter JSON / Exporter HTML"
msgstr "Ekspor JSON / Ekspor HTML"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:444
msgid "Génère le fichier d'export dans le répertoire d'export configuré."
msgstr "Membuat berkas ekspor di direktori ekspor yang dikonfigurasi."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:446
msgid "Écrit un fichier horodate (jamais d'écrasement silencieux d'un export précédent)."
msgstr "Menulis berkas bercap waktu (tidak pernah menimpa ekspor sebelumnya secara diam-diam)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:447
msgid "Écriture réelle sur disque immédiate, aucun effet sur le serveur."
msgstr "Penulisan nyata langsung ke disk, tidak ada efek pada server."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:450
msgid "Purement consultatif/export - aucun effet sur la configuration ou le serveur."
msgstr "Murni untuk melihat/ekspor - tidak ada efek pada konfigurasi atau server."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:452
msgid "Le répertoire d'export peut être changé dans l'écran Réglages de l'application (touche 'o')."
msgstr "Direktori ekspor dapat diubah di layar Pengaturan aplikasi (tombol 'o')."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:100
msgid "RIPOSTE - État"
msgstr "RIPOSTE - Status"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:11
msgid "Accueil -> Active Sécurité -> État (bloc RIPOSTE)"
msgstr "Beranda -> Keamanan aktif -> Status (blok RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:13
msgid "RIPOSTE agit DANS LA DURÉE : il se souvient des sources qui reviennent et leur applique des bans de plus en plus longs (paliers), alors qu'Active Defense agit PENDANT la requête selon le niveau de menace du moment. Cet écran montre le module (activé ou non, politiques actives), le processus RIPOSTE (actif, PID, dernier signe de vie, lignes lues), les actions en cours et l'arrêt d'urgence."
msgstr "RIPOSTE bertindak DARI WAKTU KE WAKTU: ia mengingat sumber yang kembali dan memberinya blokir yang makin lama (tingkat), sedangkan Active Defense bertindak SELAMA permintaan sesuai tingkat ancaman saat itu. Layar ini menampilkan modul (aktif atau tidak, kebijakan aktif), proses RIPOSTE (aktif, PID, tanda hidup terakhir, baris dibaca), tindakan yang berjalan, dan henti darurat."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:20
#: src/omega_serv/interfaces/tui/screens/riposte_status_screen.py:65
#: src/omega_serv/interfaces/tui/screens/riposte_status_screen.py:136
msgid "Arrêt d'urgence"
msgstr "Henti darurat"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:21
msgid "Coupe toute nouvelle action RIPOSTE, pour toutes les règles, même après un redémarrage."
msgstr "Menghentikan setiap tindakan RIPOSTE baru, untuk semua aturan, bahkan setelah mulai ulang."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:23
msgid "Choisir « Arrêter et lever les actions en cours » (bans retirés de la blocklist, leurres libérés tout de suite) ou « Arrêter seulement » (les actions vont jusqu'à leur échéance)."
msgstr "Pilih « Hentikan dan cabut tindakan yang sedang berjalan » (blokir dihapus dari blocklist, umpan langsung dilepas) atau « Hentikan saja » (tindakan berlangsung sampai tenggatnya)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:26
msgid "Effet immédiat, même si le processus RIPOSTE est arrêté (drapeau mémorisé dans sa base)."
msgstr "Berlaku segera, bahkan jika proses RIPOSTE berhenti (penanda disimpan di basis datanya)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:27
msgid "Le bouton devient « Reprendre » ; « Reprendre » relance les règles qui étaient actives."
msgstr "Tombol berubah menjadi « Lanjutkan »; « Lanjutkan » menjalankan kembali aturan yang sebelumnya aktif."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:31
msgid "L'arrêt ne touche jamais les bans automatiques du WAF, le mode guerre d'Active Defense, ni les bans réseau déjà passés à fail2ban (à lever dans omega-jail ou fail2ban)."
msgstr "Penghentian tidak pernah memengaruhi blokir otomatis WAF, mode perang Active Defense, atau blokir jaringan yang sudah diteruskan ke fail2ban (cabut di omega-jail atau fail2ban)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:35
msgid "Le module s'active dans le menu Options et demande un redémarrage complet du service."
msgstr "Modul diaktifkan di menu Opsi dan memerlukan mulai ulang penuh layanan."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:36
msgid "Sans WAF actif, RIPOSTE ne voit aucune attaque : l'écran l'indique."
msgstr "Tanpa WAF aktif, RIPOSTE tidak melihat serangan apa pun: layar menunjukkannya."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:37
msgid "Ban réseau : l'écran dit si les jails RIPOSTE de cette instance sont installées par omega-jail, et signale la jail omega-serv-active-defense (ban fixe de 24 h) qui écrase les paliers réseau."
msgstr "Blokir jaringan: layar menunjukkan apakah jail RIPOSTE instans ini sudah dipasang oleh omega-jail, dan menandai jail omega-serv-active-defense (blokir tetap 24 jam) yang menimpa tingkat jaringan."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:39
msgid "En ligne de commande : « riposte status », « riposte stop [--revoke] », « riposte resume »."
msgstr "Di baris perintah: « riposte status », « riposte stop [--revoke] », « riposte resume »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:45
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:101
msgid "RIPOSTE - Politiques"
msgstr "RIPOSTE - Kebijakan"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:46
msgid "Accueil -> Active Sécurité -> Politiques (bloc RIPOSTE)"
msgstr "Beranda -> Keamanan aktif -> Kebijakan (blok RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:48
msgid "Une politique dit QUAND agir (classes d'attaque, nombre de retours dans une fenêtre, niveau Active Defense, visites de leurre) et COMMENT (ban local, ban local + réseau, leurre). Une politique active agit automatiquement, sans validation action par action."
msgstr "Kebijakan menyatakan KAPAN bertindak (kelas serangan, jumlah kembali dalam satu jendela, tingkat Active Defense, kunjungan umpan) dan BAGAIMANA (blokir lokal, blokir lokal + jaringan, umpan). Kebijakan aktif bertindak otomatis, tanpa persetujuan per tindakan."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:54
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:524
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:107
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:65
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:48
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:53
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:90
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:58
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:51
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:158
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:56
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:85
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:50
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:68
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:58
