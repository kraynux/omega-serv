msgid "Vérifie un certificat : dates, correspondance avec la clé, droits de la clé. Code 1 s'il a expiré."
msgstr "Memeriksa sertifikat: tanggal, kecocokan dengan kunci, izin kunci. Kode 1 jika sudah kedaluwarsa."

#: src/omega_serv/interfaces/cli/main.py:2406
msgid "Affiche le détail d'un certificat (même rapport que verify)."
msgstr "Menampilkan detail sertifikat (laporan yang sama dengan verify)."

#: src/omega_serv/interfaces/cli/main.py:2410
msgid "Même rapport que verify, avec une alerte si l'expiration approche."
msgstr "Laporan yang sama dengan verify, dengan peringatan jika kedaluwarsa sudah dekat."

#: src/omega_serv/interfaces/cli/main.py:2413
msgid "Seuil d'alerte en jours (défaut : 30)."
msgstr "Ambang peringatan dalam hari (bawaan: 30)."

#: src/omega_serv/interfaces/cli/main.py:2417
msgid "Authentification HTTP Basic : utilisateurs et zones protégées."
msgstr "Autentikasi HTTP Basic: pengguna dan zona terlindungi."

