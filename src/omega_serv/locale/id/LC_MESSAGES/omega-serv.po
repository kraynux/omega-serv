msgstr "Benar-benar menulis sertifikat/kunci ke disk seketika."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:55
msgid "SAN DNS / SAN IP"
msgstr "SAN DNS / SAN IP"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:56
msgid "Noms DNS et adresses IP alternatifs couverts par le certificat."
msgstr "Nama DNS dan alamat IP alternatif yang dicakup sertifikat."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:57
msgid "Listes séparées par des virgules, optionnelles."
msgstr "Daftar dipisahkan koma, opsional."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:59
#: src/omega_serv/interfaces/tui/guide/content/tls.py:66
#: src/omega_serv/interfaces/tui/guide/content/tls.py:73
#: src/omega_serv/interfaces/tui/guide/content/tls.py:80
#: src/omega_serv/interfaces/tui/guide/content/tls.py:87
msgid "Écrit sur disque immédiatement."
msgstr "Ditulis ke disk seketika."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:62
msgid "Organisation / Unité / Ville / Région / Pays"
msgstr "Organisasi / Unit / Kota / Wilayah / Negara"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:63
