msgid "Aucune - purement navigation."
msgstr "Tidak ada - murni navigasi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "Konfigurasi dasar"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "Beranda -> Konfigurasi terperinci -> Konfigurasi dasar"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid "Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier explicite, moteur HTTP (Python ou natif C++)."
msgstr "Pengaturan dasar server: alamat dengar, port, nama server yang diumumkan, berkas indeks yang dicari di direktori tanpa nama berkas eksplisit, mesin HTTP (Python atau native C++)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse d'écoute (bind)"
msgstr "Alamat dengar (bind)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:34
msgid "Adresse IP sur laquelle le serveur accepte les connexions."
msgstr "Alamat IP tempat server menerima koneksi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:36
msgid "Une adresse IP valide - '127.0.0.1' (local uniquement) ou '0.0.0.0' (toutes les interfaces réseau). Valeur par défaut : 127.0.0.1."
msgstr "Alamat IP yang valid - '127.0.0.1' (lokal saja) atau '0.0.0.0' (semua antarmuka jaringan). Nilai bawaan: 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:39
msgid "Enregistre dans server.bind après validation structurelle de la configuration."
msgstr "Disimpan ke server.bind setelah validasi struktural konfigurasi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:41
msgid "Nécessite un REDÉMARRAGE COMPLET - le socket d'écoute n'est jamais retouché par un simple rechargement. Un bouton 'Redémarrer maintenant' est proposé après l'enregistrement si un service est détecté."
msgstr "Memerlukan MULAI ULANG PENUH - socket dengar tidak pernah disentuh oleh muat ulang biasa. Tombol 'Mulai ulang sekarang' ditawarkan setelah menyimpan jika layanan terdeteksi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:47
msgid "Port (port)"
msgstr "Port (port)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:48
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:80
msgid "Port TCP d'écoute."
msgstr "Port TCP untuk mendengar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:50
msgid "Un entier de port valide (1-65535 ; 0 signifie 'port libre choisi par le système', surtout utile pour des tests). Valeur par défaut : 8080."
msgstr "Bilangan bulat port yang valid (1-65535; 0 berarti 'port bebas dipilih sistem', terutama berguna untuk pengujian). Nilai bawaan: 8080."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:53
msgid "Enregistre dans server.port après validation."
msgstr "Disimpan ke server.port setelah validasi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:54
msgid "Nécessite un REDÉMARRAGE COMPLET, même raison que l'adresse d'écoute."
msgstr "Memerlukan MULAI ULANG PENUH, alasan yang sama seperti alamat dengar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:57
msgid "Nom de serveur (server_name)"
msgstr "Nama server (server_name)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:58
msgid "Nom de serveur utilisé en interne (transmis notamment à FastCGI)."
msgstr "Nama server yang dipakai secara internal (antara lain diteruskan ke FastCGI)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:59
msgid "Chaîne libre, optionnelle. Vide par défaut."
msgstr "Teks bebas, opsional. Kosong secara bawaan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:60
msgid "Enregistre dans server.server_name."
msgstr "Disimpan ke server.server_name."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:62
msgid "Se recharge à chaud (pas de redémarrage complet nécessaire) - mais reste sans effet tant qu'un rechargement du service en cours n'a pas eu lieu (automatique si un service actif existe, sinon à faire manuellement depuis l'écran SERVICE)."
msgstr "Dimuat ulang saat berjalan (tidak perlu mulai ulang penuh) - tetapi tidak berefek sampai layanan yang berjalan dimuat ulang (otomatis jika ada layanan aktif, jika tidak lakukan manual dari layar SERVICE)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:68
msgid "Fichiers d'index (index_files)"
msgstr "Berkas indeks (index_files)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:70
msgid "Noms de fichiers cherches, dans l'ordre, quand une URL pointe vers un répertoire sans fichier explicite."
msgstr "Nama berkas yang dicari, berurutan, saat URL menunjuk ke direktori tanpa berkas eksplisit."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:73
msgid "Liste séparée par des virgules. Valeur par défaut : index.html."
msgstr "Daftar dipisahkan koma. Nilai bawaan: index.html."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:74
msgid "Enregistre dans server.index_files."
msgstr "Disimpan ke server.index_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:75
msgid "Même réaction que le nom de serveur - rechargement nécessaire, jamais un redémarrage complet."
msgstr "Reaksi sama seperti nama server - perlu muat ulang, tidak pernah mulai ulang penuh."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:78
msgid "Moteur HTTP (engine)"
msgstr "Mesin HTTP (engine)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:80
msgid "Programme qui traite les requêtes HTTP. Python (par défaut) : l'interpréteur Python traite tout. Natif C++ (omega-http-core) : un programme compilé, qui utilise tous les cœurs, traite lui-même le contenu statique, les redirections, le cache et TLS ; il cherche lui-même les règles du WAF et sert seul une requête sur laquelle aucune ne correspond ; il confie au processus Python les autres contrôles de sécurité (requête suspecte ou douteuse, Active Defense, authentification), le listing, les pages internes et les routes applicatives (reverse proxy, FastCGI, envoi de fichiers). Dans les deux cas : mêmes réponses, mêmes journaux, même sécurité. Ce que le choix change, mesuré : FAQ, « Moteur Python ou natif : qu'est-ce que ça change concrètement ? »."
msgstr "Program yang menangani permintaan HTTP. Python (bawaan): interpreter Python menangani semuanya. Native C++ (omega-http-core): program terkompilasi yang memakai semua inti menangani sendiri konten statis, pengalihan, cache, dan TLS; ia memeriksa sendiri aturan WAF dan melayani sendiri permintaan yang tidak cocok dengan aturan mana pun; ia menyerahkan kepada proses Python pemeriksaan keamanan lainnya (permintaan mencurigakan atau meragukan, Active Defense, autentikasi), daftar direktori, halaman internal, dan rute aplikasi (reverse proxy, FastCGI, pengiriman berkas). Pada kedua kasus: respons sama, log sama, keamanan sama. Apa yang diubah oleh pilihan, diukur: FAQ, “Mesin Python atau native: apa bedanya dalam praktik?”."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:90
msgid "Python ou Natif C++. Le choix natif est GRISÉ tant qu'une cause l'empêche (binaire absent, TLS en mode direct avec reverse proxy, FastCGI ou envoi de fichiers) : la liste des causes, et comment lever chacune, s'affiche sous le choix. Lever d'abord la cause, puis revenir ici."
msgstr "Python atau Native C++. Pilihan native DIBUAT ABU-ABU selama ada penyebab yang menghalanginya (biner tidak ada, TLS langsung dengan reverse proxy, FastCGI, atau unggah berkas): daftar penyebab, dan cara menghilangkan masing-masing, ditampilkan di bawah pilihan. Hilangkan dulu penyebabnya, lalu kembali ke sini."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:94
msgid "Enregistre dans server.engine."
msgstr "Menyimpan ke server.engine."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:96
msgid "Nécessite un REDÉMARRAGE COMPLET - un rechargement qui changerait de moteur est refusé. Le moteur réellement utilisé est affiché dans État & Ressources (section MOTEUR HTTP, avec le tableau des connecteurs)."
msgstr "Memerlukan RESTART PENUH - muat ulang yang akan mengganti mesin ditolak. Mesin yang benar-benar dipakai ditampilkan di Status & Sumber Daya (bagian MESIN HTTP, dengan tabel konektor)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:103
msgid "bind/port et le moteur HTTP exigent toujours un redémarrage complet. server_name/index_files se rechargent à chaud mais nécessitent quand même un rechargement du service déjà lancé pour être pris en compte."
msgstr "bind/port dan mesin HTTP selalu memerlukan restart penuh. server_name/index_files dimuat ulang saat berjalan, tetapi layanan yang sudah berjalan tetap harus dimuat ulang agar berlaku."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:109
msgid "Changer bind/port pendant qu'un service systemd est déjà actif ne prend jamais effet tant qu'un redémarrage complet n'a pas eu lieu - toutes les connexions en cours sont alors coupées, contrairement à un simple rechargement."
msgstr "Mengubah bind/port saat layanan systemd sudah aktif tidak pernah berlaku sebelum mulai ulang penuh - semua koneksi yang sedang berlangsung akan terputus, berbeda dengan muat ulang biasa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:118
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:47
msgid "Résistance et limites"
msgstr "Ketahanan dan batas"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:119
msgid "Accueil -> Configuration détaillée -> Résistance et limites"
msgstr "Beranda -> Konfigurasi terperinci -> Ketahanan dan batas"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:121
msgid "Dix réglages numériques anti-abus : bornes de taille/nombre/delai appliquées à chaque connexion et requête."
msgstr "Sepuluh pengaturan angka anti-penyalahgunaan: batas ukuran/jumlah/waktu yang diterapkan pada setiap koneksi dan permintaan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:126
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:36
msgid "Connexions simultanées max (max_connections)"
msgstr "Koneksi serentak maks (max_connections)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:127
msgid "Nombre maximal de connexions ouvertes en même temps."
msgstr "Jumlah maksimum koneksi yang terbuka bersamaan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:128
msgid "Entier positif. Valeur par défaut : 256."
msgstr "Bilangan bulat positif. Nilai bawaan: 256."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:129
msgid "Enregistre dans server.max_connections."
msgstr "Disimpan ke server.max_connections."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:130
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:262
msgid "Se recharge à chaud (rechargement du service nécessaire, automatique si actif)."
msgstr "Dimuat ulang saat berjalan (perlu muat ulang layanan, otomatis jika aktif)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:133
msgid "Taille max de requête (max_request_size)"
msgstr "Ukuran permintaan maks (max_request_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:134
msgid "Taille maximale acceptée pour le corps d'une requête, en octets."
msgstr "Ukuran maksimum yang diterima untuk badan permintaan, dalam byte."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:135
msgid "Entier positif, en octets. Valeur par défaut : 10 485 760 (10 Mio)."
msgstr "Bilangan bulat positif, dalam byte. Nilai bawaan: 10 485 760 (10 MiB)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:136
msgid "Enregistre dans server.max_request_size."
msgstr "Disimpan ke server.max_request_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:137
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:147
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:154
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:161
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:168
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:175
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:188
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:208
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:272
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:279
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:301
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:326
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:333
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:340
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:347
msgid "Se recharge à chaud."
msgstr "Dimuat ulang saat berjalan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:140
msgid "Taille max des en-têtes (max_header_size)"
msgstr "Ukuran header maks (max_header_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:142
msgid "Taille cumulée maximale des en-têtes HTTP d'une requête, en octets - protection contre les en-têtes surdimensionnés (HTTP smuggling, saturation mémoire)."
msgstr "Ukuran total maksimum header HTTP sebuah permintaan, dalam byte - perlindungan dari header berukuran berlebihan (HTTP smuggling, memori penuh)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:145
msgid "Entier positif, en octets. Valeur par défaut : 16 384."
msgstr "Bilangan bulat positif, dalam byte. Nilai bawaan: 16 384."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:146
msgid "Enregistre dans server.max_header_size."
msgstr "Disimpan ke server.max_header_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:150
msgid "Taille max de la ligne de requête (max_request_line_size)"
msgstr "Ukuran baris permintaan maks (max_request_line_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:151
msgid "Taille maximale de la première ligne HTTP (méthode + chemin + version), en octets."
msgstr "Ukuran maksimum baris HTTP pertama (metode + jalur + versi), dalam byte."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:152
msgid "Entier positif, en octets. Valeur par défaut : 8 192."
msgstr "Bilangan bulat positif, dalam byte. Nilai bawaan: 8 192."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:153
msgid "Enregistre dans server.max_request_line_size."
msgstr "Disimpan ke server.max_request_line_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:157
msgid "Délai de lecture (read_timeout_seconds)"
msgstr "Batas waktu baca (read_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:158
msgid "Délai maximal, en secondes, pour recevoir une requête complète avant coupure."
msgstr "Waktu maksimum, dalam detik, untuk menerima permintaan lengkap sebelum diputus."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:159
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:206
msgid "Entier positif, en secondes. Valeur par défaut : 10."
msgstr "Bilangan bulat positif, dalam detik. Nilai bawaan: 10."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:160
msgid "Enregistre dans server.read_timeout_seconds."
msgstr "Disimpan ke server.read_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:164
msgid "Délai d'écriture (write_timeout_seconds)"
msgstr "Batas waktu tulis (write_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:165
msgid "Délai maximal, en secondes, pour envoyer la réponse avant coupure."
msgstr "Waktu maksimum, dalam detik, untuk mengirim respons sebelum diputus."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:166
msgid "Entier positif, en secondes. Valeur par défaut : 15."
msgstr "Bilangan bulat positif, dalam detik. Nilai bawaan: 15."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:167
msgid "Enregistre dans server.write_timeout_seconds."
msgstr "Disimpan ke server.write_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:171
msgid "Délai keep-alive (keepalive_timeout_seconds)"
msgstr "Batas waktu keep-alive (keepalive_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:172
msgid "Délai d'inactivité, en secondes, avant fermeture d'une connexion gardée ouverte."
msgstr "Waktu tidak aktif, dalam detik, sebelum koneksi yang dibiarkan terbuka ditutup."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:173
msgid "Entier positif, en secondes. Valeur par défaut : 5."
msgstr "Bilangan bulat positif, dalam detik. Nilai bawaan: 5."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:174
msgid "Enregistre dans server.keepalive_timeout_seconds."
msgstr "Disimpan ke server.keepalive_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:178
msgid "Requêtes max en keep-alive (max_keepalive_requests)"
msgstr "Permintaan maks per keep-alive (max_keepalive_requests)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:180
msgid "Nombre maximal de requêtes traitées sur une même connexion gardée ouverte. Une fois atteint, la connexion est simplement fermée et le navigateur en ouvre une nouvelle : aucune erreur, aucun bannissement. Sans rapport avec la limite de débit du WAF (Active Sécurité -> Exclusions et débit), qui compte les requêtes par IP toutes connexions confondues."
msgstr "Jumlah maksimum permintaan yang dilayani pada satu koneksi yang dibiarkan terbuka. Setelah tercapai, koneksi cukup ditutup dan peramban membuka koneksi baru: tanpa galat, tanpa blokir. Tidak berkaitan dengan batas laju WAF (Keamanan Aktif -> Pengecualian dan batas laju), yang menghitung permintaan per IP di semua koneksi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:186
msgid "Entier positif. Valeur par défaut : 30."
msgstr "Bilangan bulat positif. Nilai bawaan: 30."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:187
msgid "Enregistre dans server.max_keepalive_requests."
msgstr "Disimpan ke server.max_keepalive_requests."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:191
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:44
msgid "File d'attente d'écoute (listen_backlog)"
msgstr "Antrean dengar (listen_backlog)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:193
msgid "Taille de la file d'attente de connexions en attente d'acceptation par le système d'exploitation (paramètre backlog du socket d'écoute)."
msgstr "Ukuran antrean koneksi yang menunggu diterima oleh sistem operasi (parameter backlog socket dengar)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:196
msgid "Entier positif. Valeur par défaut : 128."
msgstr "Bilangan bulat positif. Nilai bawaan: 128."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:197
msgid "Enregistre dans server.listen_backlog."
msgstr "Disimpan ke server.listen_backlog."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:199
msgid "Nécessite un REDÉMARRAGE COMPLET - fixé au moment de la création du socket d'écoute, comme bind/port, jamais retouché par un simple rechargement."
msgstr "Memerlukan MULAI ULANG PENUH - ditetapkan saat socket dengar dibuat, seperti bind/port, tidak pernah disentuh oleh muat ulang biasa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:204
msgid "Délai de grâce à l'arrêt (shutdown_grace_period_seconds)"
msgstr "Masa tenggang saat berhenti (shutdown_grace_period_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:205
msgid "Délai, en secondes, laissé aux connexions actives pour se terminer lors d'un arrêt."
msgstr "Waktu, dalam detik, yang diberikan kepada koneksi aktif untuk selesai saat berhenti."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:207
msgid "Enregistre dans server.shutdown_grace_period_seconds."
msgstr "Disimpan ke server.shutdown_grace_period_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:211
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:62
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:178
msgid "Nombre de processus (workers)"
msgstr "Jumlah proses (workers)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:213
msgid "Avec le moteur Python : nombre de processus serveur qui se partagent le port ; un processus Python n'utilise qu'un cœur, plusieurs servent davantage de requêtes en parallèle. Avec le moteur natif (Configuration de base) : nombre de processus Python qui font les contrôles de sécurité, le natif utilisant déjà tous les cœurs. Les compteurs de sécurité (rate limit, récidive) sont partagés entre processus et restent exacts ; un script magnet garde ses propres compteurs dans chaque processus."
msgstr "Dengan mesin Python: jumlah proses server yang berbagi port; satu proses Python hanya memakai satu inti, beberapa proses melayani lebih banyak permintaan secara paralel. Dengan mesin native (Konfigurasi dasar): jumlah proses Python yang menjalankan pemeriksaan keamanan, karena mesin native sudah memakai semua inti. Penghitung keamanan (rate limit, residivisme) dibagi antarproses dan tetap tepat; skrip magnet menyimpan penghitungnya sendiri di setiap proses."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:221
msgid "Le maximum dépend du moteur et du processeur détecté, et s'affiche sous le champ avec ce qu'augmenter apporte sur cette machine : moteur Python, un processus par cœur physique ; moteur natif, 1, ou 2 à partir de 4 cœurs physiques (un 2e n'aide que si un contrôle de sécurité est actif). Une valeur au-delà du maximum est refusée. Ce que le choix change, mesuré : FAQ, « Combien de processus choisir ? »."
msgstr "Maksimum bergantung pada mesin dan prosesor yang terdeteksi, dan ditampilkan di bawah kolom bersama apa yang diberikan oleh penambahan di mesin ini: mesin Python, satu proses per inti fisik; mesin native, 1, atau 2 mulai dari 4 inti fisik (proses ke-2 hanya membantu jika ada pemeriksaan keamanan yang aktif). Nilai di atas maksimum ditolak. Apa yang diubah oleh pilihan, diukur: FAQ, “Berapa banyak proses yang harus dipilih?”."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:227
msgid "Enregistre dans server.workers."
msgstr "Disimpan di server.workers."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:229
msgid "Redémarrage complet nécessaire. Si la configuration est recopiée sur une machine plus petite, le serveur se limite au maximum de cette machine et l'écrit dans le journal et dans État & Ressources."
msgstr "Perlu mulai ulang penuh. Jika konfigurasi disalin ke mesin yang lebih kecil, server membatasi diri pada maksimum mesin itu dan mencatatnya di log dan di Status & Sumber Daya."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:236
msgid "Neuf champs sur onze se rechargent à chaud (rechargement du service nécessaire, automatique si actif). listen_backlog et le nombre de processus exigent un redémarrage complet."
msgstr "Sembilan dari sebelas kolom dimuat ulang langsung (perlu memuat ulang layanan, otomatis jika aktif). listen_backlog dan jumlah proses memerlukan mulai ulang penuh."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:241
msgid "Un listen_backlog trop bas sous forte charge fait échouer des connexions entrantes avant même qu'elles atteignent OMEGA-SERV (comportement du système d'exploitation) - ne descendre sous 128 qu'en connaissance de cause."
msgstr "listen_backlog yang terlalu rendah di bawah beban tinggi membuat koneksi masuk gagal bahkan sebelum mencapai OMEGA-SERV (perilaku sistem operasi) - turunkan di bawah 128 hanya jika memahami akibatnya."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:250
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:39
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:48
msgid "Sécurité générique"
msgstr "Keamanan umum"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:251
msgid "Accueil -> Configuration détaillée -> Sécurité générique"
msgstr "Beranda -> Konfigurasi terperinci -> Keamanan umum"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:253
msgid "Règles de sécurité génériques appliquées à toutes les requêtes : méthodes autorisées, fichiers cachés, en-têtes de sécurité, CSP, HSTS."
msgstr "Aturan keamanan umum yang diterapkan pada semua permintaan: metode yang diizinkan, berkas tersembunyi, header keamanan, CSP, HSTS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:258
msgid "Méthodes autorisées"
msgstr "Metode yang diizinkan"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:259
msgid "Liste blanche des méthodes HTTP acceptées - tout le reste est refusé par défaut."
msgstr "Daftar putih metode HTTP yang diterima - selebihnya ditolak secara bawaan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:260
msgid "Liste séparée par des virgules, ex: GET, HEAD. Valeur par défaut : GET, HEAD."
msgstr "Daftar dipisahkan koma, mis.: GET, HEAD. Nilai bawaan: GET, HEAD."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:261
msgid "Enregistre dans security.allowed_methods."
msgstr "Disimpan ke security.allowed_methods."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:265
#: src/omega_serv/interfaces/tui/screens/security_screen.py:58
msgid "Refuser les fichiers cachés (oui/non)"
msgstr "Tolak berkas tersembunyi (ya/tidak)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:267
msgid "Masque tout fichier ou dossier dont un segment de chemin commence par un point (dotfile) - à la fois en accès direct et dans le directory listing."
msgstr "Menyembunyikan setiap berkas atau folder yang salah satu segmen jalurnya diawali titik (dotfile) - baik saat diakses langsung maupun di directory listing."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:270
msgid "oui ou non (accepte aussi true/1/o/y). Valeur par défaut : oui."
msgstr "ya atau tidak (juga menerima true/1/o/y). Nilai bawaan: ya."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:271
msgid "Enregistre dans security.deny_hidden_files."
msgstr "Disimpan ke security.deny_hidden_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:275
msgid "Mode CSP"
msgstr "Mode CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:276
msgid "Mode d'application de la Content-Security-Policy envoyée dans les réponses."
msgstr "Mode penerapan Content-Security-Policy yang dikirim dalam respons."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:277
msgid "enforce (bloque) ou report-only (signale sans bloquer). Valeur par défaut : enforce."
msgstr "enforce (memblokir) atau report-only (melaporkan tanpa memblokir). Nilai bawaan: enforce."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:278
msgid "Enregistre dans security.csp_mode."
msgstr "Disimpan ke security.csp_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:282
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:284
msgid "Isolation cross-origin - 'require-corp'/'credentialless' peuvent bloquer des ressources cross-origin (polices, images, iframes tiers) que ce serveur générique ne connaît pas à l'avance, contrairement à COOP/CORP (toujours actifs, sans ce risque)."
msgstr "Isolasi cross-origin - 'require-corp'/'credentialless' dapat memblokir sumber daya cross-origin (font, gambar, iframe pihak ketiga) yang tidak diketahui sebelumnya oleh server umum ini, berbeda dengan COOP/CORP (selalu aktif, tanpa risiko ini)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:290
msgid "unsafe-none (permissif, par défaut partout y compris hardened), require-corp ou credentialless - à activer uniquement en connaissance du contenu réellement servi."
msgstr "unsafe-none (longgar, bawaan di mana pun termasuk hardened), require-corp atau credentialless - aktifkan hanya jika Anda mengenal konten yang benar-benar disajikan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:293
msgid "Enregistre dans security.coep_mode."
msgstr "Disimpan ke security.coep_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:294
msgid "Se recharge à chaud - toujours émis explicitement, même en unsafe-none (jamais un en-tête absent)."
msgstr "Dimuat ulang saat berjalan - selalu dikirim secara eksplisit, bahkan dengan unsafe-none (header tidak pernah absen)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:297
#: src/omega_serv/interfaces/tui/screens/security_screen.py:64
msgid "En-têtes de sécurité actifs (oui/non)"
msgstr "Header keamanan aktif (ya/tidak)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:298
msgid "Active l'envoi des en-têtes de sécurité standard (CSP, X-Content-Type-Options...)."
msgstr "Mengaktifkan pengiriman header keamanan standar (CSP, X-Content-Type-Options...)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:299
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:338
msgid "oui ou non. Valeur par défaut : oui."
msgstr "ya atau tidak. Nilai bawaan: ya."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:300
msgid "Enregistre dans security.security_headers_enabled."
msgstr "Disimpan ke security.security_headers_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:304
msgid "Zones CSP (Ajouter une zone / Retirer)"
msgstr "Zona CSP (Tambah zona / Lepas)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:306
msgid "Exceptions EXPLICITES à la CSP globale, par préfixe de chemin - ex. 'unsafe-inline' uniquement sous /un-dossier/ qui en a réellement besoin, sans jamais relâcher la CSP du reste du site."
msgstr "Pengecualian EKSPLISIT terhadap CSP global, per prefiks jalur - mis. 'unsafe-inline' hanya di bawah /sebuah-folder/ yang benar-benar membutuhkannya, tanpa melonggarkan CSP bagian lain situs."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:311
msgid "Préfixe (ex: /public-widgets/) + politique CSP COMPLÈTE pour ce préfixe (remplace entièrement le défaut pour ces chemins, jamais une fusion de directives)."
msgstr "Prefiks (mis.: /public-widgets/) + kebijakan CSP LENGKAP untuk prefiks ini (menggantikan seluruh bawaan untuk jalur ini, tidak pernah menggabungkan direktif)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:314
msgid "Enregistre immédiatement dans security.csp_zones, sans passer par Enregistrer."
msgstr "Langsung disimpan ke security.csp_zones, tanpa melalui Simpan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:316
msgid "Rechargement automatique immédiat si un service actif existe. Une exception comme 'unsafe-inline' reste TOUJOURS visible dans 'omega-serv audit security' (CSP-001/CSP-002), même délibérée - jamais silencieuse."
msgstr "Muat ulang otomatis segera jika ada layanan aktif. Pengecualian seperti 'unsafe-inline' SELALU tetap terlihat di 'omega-serv audit security' (CSP-001/CSP-002), meskipun disengaja - tidak pernah diam-diam."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:322
#: src/omega_serv/interfaces/tui/screens/security_screen.py:66
msgid "HSTS actif (oui/non)"
msgstr "HSTS aktif (ya/tidak)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:323
msgid "Active l'en-tête Strict-Transport-Security (force HTTPS pour les visites futures)."
msgstr "Mengaktifkan header Strict-Transport-Security (memaksa HTTPS untuk kunjungan berikutnya)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:324
msgid "oui ou non. Valeur par défaut : non. N'a de sens que si TLS est réellement actif."
msgstr "ya atau tidak. Nilai bawaan: tidak. Hanya bermakna jika TLS benar-benar aktif."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:325
msgid "Enregistre dans security.hsts_enabled."
msgstr "Disimpan ke security.hsts_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:329
msgid "HSTS max-age"
msgstr "HSTS max-age"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:330
msgid "Durée, en secondes, pendant laquelle un navigateur retient l'obligation HTTPS."
msgstr "Durasi, dalam detik, browser mengingat kewajiban HTTPS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:331
msgid "Entier positif, en secondes. Valeur par défaut : 31 536 000 (un an)."
msgstr "Bilangan bulat positif, dalam detik. Nilai bawaan: 31 536 000 (satu tahun)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:332
msgid "Enregistre dans security.hsts_max_age."
msgstr "Disimpan ke security.hsts_max_age."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:336
#: src/omega_serv/interfaces/tui/screens/security_screen.py:70
msgid "HSTS includeSubDomains (oui/non)"
msgstr "HSTS includeSubDomains (ya/tidak)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:337
msgid "Étend l'obligation HTTPS à tous les sous-domaines."
msgstr "Memperluas kewajiban HTTPS ke semua subdomain."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:339
msgid "Enregistre dans security.hsts_include_subdomains."
msgstr "Disimpan ke security.hsts_include_subdomains."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:343
#: src/omega_serv/interfaces/tui/screens/security_screen.py:72
msgid "HSTS preload (oui/non)"
msgstr "HSTS preload (ya/tidak)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:344
msgid "Signale l'éligibilité à la liste de prechargement HSTS des navigateurs."
msgstr "Menandakan kelayakan untuk daftar preload HSTS browser."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:345
#: src/omega_serv/interfaces/tui/guide/content/routage.py:31
msgid "oui ou non. Valeur par défaut : non."
msgstr "ya atau tidak. Nilai bawaan: tidak."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:346
msgid "Enregistre dans security.hsts_preload."
msgstr "Disimpan ke security.hsts_preload."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:350
msgid "Tous les champs de cet écran se rechargent à chaud - aucun n'exige de redémarrage complet."
msgstr "Semua bidang di layar ini dimuat ulang saat berjalan - tidak ada yang memerlukan mulai ulang penuh."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:353
msgid "Activer HSTS sans que TLS soit réellement actif n'a aucun effet utile - le navigateur ignore cet en-tête reçu en HTTP simple."
msgstr "Mengaktifkan HSTS tanpa TLS yang benar-benar aktif tidak berguna - browser mengabaikan header ini jika diterima lewat HTTP biasa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:361
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:40
msgid "Sécurité générique - Assistant zone CSP"
msgstr "Keamanan umum - Asisten zona CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:362
msgid "Sécurité générique -> Ajouter une zone"
msgstr "Keamanan umum -> Tambah zona"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:364
msgid "Construit la politique CSP d'une zone directive par directive, chacune pré-remplie avec sa valeur ACTUELLE (la politique globale) - une zone remplace ENTIÈREMENT la politique par défaut pour son préfixe, jamais un simple ajout, d'où le pré-remplissage pour éviter de perdre des directives sans le vouloir."
msgstr "Menyusun kebijakan CSP sebuah zona direktif demi direktif, masing-masing diisi dengan nilai SAAT INI (kebijakan global) - zona menggantikan SELURUH kebijakan bawaan untuk prefiksnya, bukan sekadar menambah, karena itu diisi lebih dulu agar direktif tidak hilang tanpa sengaja."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:371
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:83
#: src/omega_serv/interfaces/tui/screens/security_screen.py:98
msgid "Préfixe"
msgstr "Prefiks"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:372
msgid "Chemin URL auquel s'applique cette politique de remplacement."
msgstr "Jalur URL tempat kebijakan pengganti ini berlaku."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:373
msgid "Doit commencer par '/', ex: /public-widgets/."
msgstr "Harus diawali '/', mis.: /public-widgets/."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:374
msgid "Utilisé au clic sur Valider."
msgstr "Digunakan saat mengeklik Konfirmasi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:375
msgid "Aucun effet avant Valider."
msgstr "Tidak ada efek sebelum Konfirmasi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:378
msgid "Directives (une par ligne, ex. style-src, script-src...)"
msgstr "Direktif (satu per baris, mis. style-src, script-src...)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:379
msgid "Chaque champ contrôle une famille de ressources - l'indice sous chaque champ explique précisément laquelle."
msgstr "Setiap bidang mengendalikan satu keluarga sumber daya - petunjuk di bawah setiap bidang menjelaskan dengan tepat yang mana."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:380
msgid "Pré-rempli avec la valeur actuelle - modifier uniquement ce qui doit changer, vider pour omettre la directive dans la zone."
msgstr "Diisi dengan nilai saat ini - ubah hanya yang perlu berubah, kosongkan untuk menghilangkan direktif di zona."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:381
msgid "Reassemblees en une seule politique au clic sur Valider."
msgstr "Dirakit kembali menjadi satu kebijakan saat mengeklik Konfirmasi."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:382
msgid "Une valeur contenant unsafe-inline/unsafe-eval/'*' déclenche une confirmation explicite supplémentaire avant d'enregistrer."
msgstr "Nilai yang mengandung unsafe-inline/unsafe-eval/'*' memicu konfirmasi eksplisit tambahan sebelum disimpan."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:386
msgid "La zone créée reste visible dans 'omega-serv audit security' (CSP-001/CSP-002 scannent aussi les zones) si elle contient une relâche - jamais silencieuse, même délibérée."
msgstr "Zona yang dibuat tetap terlihat di 'omega-serv audit security' (CSP-001/CSP-002 juga memindai zona) jika berisi pelonggaran - tidak pernah diam-diam, meskipun disengaja."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:393
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:41
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:49
msgid "Contrôle d'accès"
msgstr "Kontrol akses"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:394
msgid "Accueil -> Configuration détaillée -> Contrôle d'accès"
msgstr "Beranda -> Konfigurasi terperinci -> Kontrol akses"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:396
msgid "CRUD de règles allow/deny par préfixe d'URL, avec filtre optionnel par extension - permet par exemple de bloquer des extensions sensibles partout SAUF dans une zone précise."
msgstr "CRUD aturan allow/deny per prefiks URL, dengan filter ekstensi opsional - misalnya untuk memblokir ekstensi sensitif di mana-mana KECUALI di zona tertentu."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:401
#: src/omega_serv/interfaces/tui/guide/content/routage.py:15
#: src/omega_serv/interfaces/tui/guide/content/routage.py:58
#: src/omega_serv/interfaces/tui/guide/content/routage.py:354
