msgstr "Hanya di memori pada tahap ini - lihat langkah 7 untuk penulisan nyata."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:79
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:58
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:128
