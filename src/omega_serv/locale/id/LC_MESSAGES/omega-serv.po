#: src/omega_serv/interfaces/cli/main.py:2477
msgid "TEXTE"
msgstr "TEKS"

#: src/omega_serv/interfaces/cli/main.py:2135
msgid "Texte libre enregistré avec la sauvegarde."
msgstr "Teks bebas yang disimpan bersama cadangan."

#: src/omega_serv/interfaces/cli/main.py:2137
msgid "Restaure une sauvegarde."
msgstr "Memulihkan cadangan."

#: src/omega_serv/interfaces/cli/main.py:2138
#: src/omega_serv/interfaces/cli/main.py:2147
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:98
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:101
msgid "ID"
msgstr "ID"

#: src/omega_serv/interfaces/cli/main.py:2139
#: src/omega_serv/interfaces/cli/main.py:2148
msgid "Identifiant de la sauvegarde (voir config list-backups)."
msgstr "Pengenal cadangan (lihat config list-backups)."

#: src/omega_serv/interfaces/cli/main.py:2141
msgid "Arrête le service, restaure, puis le redémarre (nécessaire si le service tourne)."
msgstr "Menghentikan layanan, memulihkan, lalu menjalankannya ulang (wajib jika layanan sedang berjalan)."

#: src/omega_serv/interfaces/cli/main.py:2143
msgid "En cas de conflit de port avec une autre instance : garder l'adresse, le port et le nom de service actuels."
msgstr "Jika terjadi konflik port dengan instans lain: pertahankan alamat, port, dan nama layanan saat ini."

#: src/omega_serv/interfaces/cli/main.py:2146
msgid "Copie une sauvegarde hors du dossier omega-serv, avec son empreinte .sha256."
msgstr "Menyalin cadangan ke luar folder omega-serv, beserta checksum .sha256-nya."

#: src/omega_serv/interfaces/cli/main.py:2149
msgid "DOSSIER"
msgstr "FOLDER"

#: src/omega_serv/interfaces/cli/main.py:2149
msgid "Dossier de destination."
msgstr "Folder tujuan."

#: src/omega_serv/interfaces/cli/main.py:2152
msgid "Ajoute à la liste une sauvegarde exportée, après vérification (empreinte, contenu)."
msgstr "Menambahkan cadangan yang diekspor ke daftar, setelah diperiksa (checksum, isi)."

#: src/omega_serv/interfaces/cli/main.py:2153
msgid "Archive .tar.gz, son .sha256 à côté."
msgstr "Arsip .tar.gz, dengan .sha256-nya di sebelahnya."

#: src/omega_serv/interfaces/cli/main.py:2155
msgid "Liste les sauvegardes."
msgstr "Menampilkan daftar cadangan."

#: src/omega_serv/interfaces/cli/main.py:2157
msgid "Profils de configuration prêts à l'emploi."
msgstr "Profil konfigurasi siap pakai."

#: src/omega_serv/interfaces/cli/main.py:2158
msgid "Liste les profils disponibles."
msgstr "Menampilkan daftar profil yang tersedia."

#: src/omega_serv/interfaces/cli/main.py:2159
msgid "Nom du profil (voir profile list)."
msgstr "Nama profil (lihat profile list)."

#: src/omega_serv/interfaces/cli/main.py:2160
msgid "Affiche un profil et les valeurs qu'il fixe."
msgstr "Menampilkan profil dan nilai yang ditetapkannya."

#: src/omega_serv/interfaces/cli/main.py:2164
msgid "Applique un profil à la configuration (modifications et conflits affichés d'abord)."
msgstr "Menerapkan profil ke konfigurasi (perubahan dan konflik ditampilkan lebih dulu)."

#: src/omega_serv/interfaces/cli/main.py:2167
msgid "Montre seulement ce qui changerait, sans rien écrire."
msgstr "Hanya menampilkan apa yang akan berubah, tanpa menulis apa pun."

#: src/omega_serv/interfaces/cli/main.py:2168
msgid "Applique malgré des problèmes bloquants."
msgstr "Menerapkan meski ada masalah yang menghalangi."

#: src/omega_serv/interfaces/cli/main.py:2172
msgid "Modules optionnels (waf, fastcgi, active_defense, riposte...)."
msgstr "Modul opsional (waf, fastcgi, active_defense, riposte...)."

#: src/omega_serv/interfaces/cli/main.py:2173
msgid "Liste les options et leur état."
msgstr "Menampilkan daftar opsi dan statusnya."

#: src/omega_serv/interfaces/cli/main.py:2174
msgid "Nom de l'option (voir option list)."
msgstr "Nama opsi (lihat option list)."

#: src/omega_serv/interfaces/cli/main.py:2175
msgid "Active une option."
msgstr "Mengaktifkan opsi."

#: src/omega_serv/interfaces/cli/main.py:2176
msgid "Première activation du WAF : tous les packs de secure/waf/rules/ sont ajoutés, en mode log-only."
msgstr "Aktivasi WAF pertama: semua paket di secure/waf/rules/ ditambahkan, dalam mode log-only."

#: src/omega_serv/interfaces/cli/main.py:2179
msgid "Désactive une option."
msgstr "Menonaktifkan opsi."

#: src/omega_serv/interfaces/cli/main.py:2184
msgid "Montre comment le serveur traiterait une requête (chemin, règles, statut, en-têtes), sans l'envoyer."
msgstr "Menunjukkan bagaimana server akan menangani permintaan (jalur, aturan, status, header), tanpa mengirimnya."

#: src/omega_serv/interfaces/cli/main.py:2186
#: src/omega_serv/interfaces/cli/main.py:2194
#: src/omega_serv/interfaces/cli/main.py:2235
#: src/omega_serv/interfaces/cli/main.py:2437
#: src/omega_serv/interfaces/cli/main.py:2447
msgid "CHEMIN"
msgstr "JALUR"

#: src/omega_serv/interfaces/cli/main.py:2187
msgid "Chemin demandé, par exemple /docs/index.html."
msgstr "Jalur yang diminta, misalnya /docs/index.html."

#: src/omega_serv/interfaces/cli/main.py:2190
msgid "Pare-feu applicatif (WAF)."
msgstr "Firewall aplikasi (WAF)."

#: src/omega_serv/interfaces/cli/main.py:2192
msgid "Soumet une requête fictive au WAF et affiche sa décision (règles, score, statut)."
msgstr "Mengirim permintaan fiktif ke WAF dan menampilkan keputusannya (aturan, skor, status)."

#: src/omega_serv/interfaces/cli/main.py:2194
msgid "Chemin de la requête."
msgstr "Jalur permintaan."

#: src/omega_serv/interfaces/cli/main.py:2195
msgid "Chaîne de requête, sans le « ? »."
msgstr "String kueri, tanpa “?”."

#: src/omega_serv/interfaces/cli/main.py:2196
msgid "Corps de la requête."
msgstr "Isi permintaan."

#: src/omega_serv/interfaces/cli/main.py:2198
msgid "Adresse du client simulé (défaut : 127.0.0.1)."
msgstr "Alamat klien simulasi (bawaan: 127.0.0.1)."

#: src/omega_serv/interfaces/cli/main.py:2201
msgid "Affiche les réseaux jamais bannis automatiquement (lu par omega-jail)."
msgstr "Menampilkan jaringan yang tidak pernah diblokir otomatis (dibaca oleh omega-jail)."

#: src/omega_serv/interfaces/cli/main.py:2204
msgid "Adresses bannies."
msgstr "Alamat yang diblokir."

#: src/omega_serv/interfaces/cli/main.py:2205
msgid "Affiche les bans : réseau, origine, expiration, motif."
msgstr "Menampilkan blokir: jaringan, asal, kedaluwarsa, alasan."

#: src/omega_serv/interfaces/cli/main.py:2207
msgid "text (défaut, traduit) ou json (pour les autres outils, jamais traduit)."
msgstr "text (bawaan, diterjemahkan) atau json (untuk alat lain, tidak pernah diterjemahkan)."

#: src/omega_serv/interfaces/cli/main.py:2209
msgid "Bannit une adresse ou un réseau."
msgstr "Memblokir alamat atau jaringan."

#: src/omega_serv/interfaces/cli/main.py:2210
#: src/omega_serv/interfaces/cli/main.py:2220
#: src/omega_serv/interfaces/cli/riposte_action_commands.py:334
msgid "RESEAU"
msgstr "JARINGAN"

#: src/omega_serv/interfaces/cli/main.py:2211
msgid "Adresse IP ou réseau CIDR, par exemple 203.0.113.7 ou 203.0.113.0/24."
msgstr "Alamat IP atau jaringan CIDR, misalnya 203.0.113.7 atau 203.0.113.0/24."

#: src/omega_serv/interfaces/cli/main.py:2212
msgid "Motif du ban."
msgstr "Alasan blokir."

#: src/omega_serv/interfaces/cli/main.py:2213
#: src/omega_serv/interfaces/cli/main.py:2485
msgid "SECONDES"
msgstr "DETIK"

#: src/omega_serv/interfaces/cli/main.py:2214
msgid "Durée du ban. Sans durée, le ban est permanent et demande --confirm-permanent."
msgstr "Durasi blokir. Tanpa durasi, blokir bersifat permanen dan memerlukan --confirm-permanent."

#: src/omega_serv/interfaces/cli/main.py:2215
msgid "Confirme un ban permanent."
msgstr "Mengonfirmasi blokir permanen."

#: src/omega_serv/interfaces/cli/main.py:2216
#: src/omega_serv/interfaces/cli/main.py:2222
msgid "OUTIL"
msgstr "ALAT"

#: src/omega_serv/interfaces/cli/main.py:2217
msgid "Outil qui pose le ban (ex. omega-fire) : lui seul pourra le lever avec --origin."
msgstr "Alat yang memasang blokir (mis. omega-fire): hanya alat itu yang dapat mencabutnya dengan --origin."

#: src/omega_serv/interfaces/cli/main.py:2219
msgid "Lève un ban."
msgstr "Mencabut blokir."

#: src/omega_serv/interfaces/cli/main.py:2221
msgid "Adresse ou réseau, tel qu'affiché par blocklist list."
msgstr "Alamat atau jaringan, seperti ditampilkan oleh blocklist list."

#: src/omega_serv/interfaces/cli/main.py:2223
msgid "Ne lève le ban que s'il a été posé avec cette origine."
msgstr "Hanya mencabut blokir jika dipasang dengan asal ini."

#: src/omega_serv/interfaces/cli/main.py:2227
msgid "Active Defense : état, simulation, purge (voir aussi threats, incidents, deception)."
msgstr "Active Defense: status, simulasi, pembersihan (lihat juga threats, incidents, deception)."

#: src/omega_serv/interfaces/cli/main.py:2230
msgid "Affiche l'état : mode, mode guerre, leurres, nombre de sources suivies."
msgstr "Menampilkan status: mode, mode perang, umpan, jumlah sumber yang dipantau."

#: src/omega_serv/interfaces/cli/main.py:2233
msgid "Montre la décision qu'Active Defense prendrait pour une source, sans rien écrire."
msgstr "Menunjukkan keputusan yang akan diambil Active Defense untuk sebuah sumber, tanpa menulis apa pun."

#: src/omega_serv/interfaces/cli/main.py:2234
msgid "Adresse de la source simulée."
msgstr "Alamat sumber simulasi."

#: src/omega_serv/interfaces/cli/main.py:2236
msgid "Chemin observé (défaut : /)."
msgstr "Jalur yang teramati (bawaan: /)."

#: src/omega_serv/interfaces/cli/main.py:2237
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:242
msgid "CLASSE"
msgstr "KELAS"

#: src/omega_serv/interfaces/cli/main.py:2238
msgid "Classe d'attaque (défaut : scan ; liste affichée si inconnue)."
msgstr "Kelas serangan (bawaan: scan; daftar ditampilkan jika tidak dikenal)."

#: src/omega_serv/interfaces/cli/main.py:2239
msgid "POINTS"
msgstr "POIN"

#: src/omega_serv/interfaces/cli/main.py:2240
msgid "Points ajoutés au score de menace (défaut : 10)."
msgstr "Poin yang ditambahkan ke skor ancaman (bawaan: 10)."

#: src/omega_serv/interfaces/cli/main.py:2243
msgid "Purge les menaces expirées, ferme les incidents redevenus calmes, supprime les incidents fermés depuis plus de 90 jours."
msgstr "Membersihkan ancaman kedaluwarsa, menutup insiden yang sudah tenang, menghapus insiden yang ditutup lebih dari 90 hari."

#: src/omega_serv/interfaces/cli/main.py:2246
msgid "Logs d'omega-serv."
msgstr "Log omega-serv."

#: src/omega_serv/interfaces/cli/main.py:2248
msgid "Fait tourner les logs dont l'automatisation (Rotate / archivage) est à échéance."
msgstr "Merotasi log yang otomatisasinya (Rotasi / pengarsipan) sudah jatuh tempo."

#: src/omega_serv/interfaces/cli/main.py:2249
msgid "Lancée chaque nuit par le timer systemd ou la ligne crontab installés par l'interface."
msgstr "Dijalankan setiap malam oleh timer systemd atau baris crontab yang dipasang oleh antarmuka."

#: src/omega_serv/interfaces/cli/main.py:2252
msgid "Moteur HTTP (Python ou natif)."
msgstr "Mesin HTTP (Python atau native)."

#: src/omega_serv/interfaces/cli/main.py:2254
msgid "Affiche le moteur demandé, celui qui tourne et la raison d'un éventuel repli."
msgstr "Menampilkan mesin yang diminta, yang sedang berjalan, dan alasan fallback jika ada."

#: src/omega_serv/interfaces/cli/main.py:2258
msgid "RIPOSTE : bans de plus en plus longs pour les récidivistes."
msgstr "RIPOSTE: blokir yang makin lama bagi pelanggar berulang."

#: src/omega_serv/interfaces/cli/main.py:2260
msgid "Lance le processus RIPOSTE au premier plan (normalement lancé par serve ; utile au diagnostic)."
