msgid "Vue d'ensemble en direct : état du serveur/service, flux du log d'accès, ressources système."
msgstr "Ringkasan langsung: status server/layanan, aliran log akses, sumber daya sistem."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:68
