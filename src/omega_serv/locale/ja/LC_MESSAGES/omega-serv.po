#: src/omega_serv/domain/security/waf/keyword_list.py:57
msgid ""
"# Syntaxe (une entrée par ligne, '#' = commentaire) :\n"
"#   /admin    -> /admin et /admin/xxx, jamais /administrator\n"
"#   /.git/    -> tout ce qui est sous /.git/\n"
"#   /*.bak    -> tout fichier dont le nom finit par .bak\n"
"#   !/api/v1  -> exception : ce chemin n'est jamais compte par cette liste\n"
"#               (prioritaire sur les entrées, quel que soit l'ordre des lignes)"
msgstr ""
"# 構文（1 行に 1 エントリ、'#' = コメント）：\n"
"#   /admin    -> /admin と /admin/xxx、/administrator は対象外\n"
"#   /.git/    -> /.git/ 配下のすべて\n"
"#   /*.bak    -> 名前が .bak で終わるすべてのファイル\n"
"#   !/api/v1  -> 例外：このパスはこのリストで一切カウントされない\n"
"#               （行の順序に関係なくエントリより優先）"

#: src/omega_serv/domain/security/waf/keyword_list.py:64
msgid ""
"# Liste de chemins personnelle (omega-serv)\n"
"#\n"
msgstr ""
"# 個人用パスリスト（omega-serv）\n"
"#\n"

#: src/omega_serv/domain/security/waf/keyword_list.py:66
msgid ""
"# Liste de mots-clefs personnelle (omega-serv)\n"
"# Un mot-clef par ligne, recherche n'importe où dans la partie choisie de la requête\n"
"# (casse ignorée). '#' = commentaire. Écrivez le texte tel quel, jamais une regex.\n"
msgstr ""
"# 個人用キーワードリスト（omega-serv）\n"
"# 1 行に 1 キーワード。リクエストの選択した部分のどこでも検索\n"
"# （大文字小文字を区別しない）。'#' = コメント。正規表現ではなく、そのままのテキストを書きます。\n"

#: src/omega_serv/domain/security/waf/keyword_list.py:148
msgid "doit commencer par '/' (ou '!/' pour une exception)"
msgstr "'/' で始まる必要があります（例外の場合は '!/'）"

#: src/omega_serv/domain/security/waf/keyword_list.py:150
msgid "ne doit pas contenir d'espace"
msgstr "空白を含めることはできません"

#: src/omega_serv/domain/security/waf/keyword_list.py:152
msgid ""
"le joker '*' n'est accepté que sous la forme '/*.extension' (ex: /*.bak)"
msgstr "ワイルドカード '*' は '/*.extension' の形でのみ使用できます（例：/*.bak）"

#: src/omega_serv/domain/security/waf/keyword_list.py:154
msgid "entrée vide : '/' seul matcherait tous les chemins"
msgstr "空のエントリ：'/' だけではすべてのパスに一致します"

#: src/omega_serv/domain/security/waf/keyword_list.py:187
#, python-brace-format
msgid "'{line}' : doublon de la ligne {value}"
msgstr "'{line}'：{value} 行目と重複"

#: src/omega_serv/domain/security/waf/keyword_list.py:200
