#: src/omega_serv/interfaces/tui/screens/riposte_policy_form_screen.py:93
msgid "Scanner récidiviste"
msgstr "再犯スキャナー"

#: src/omega_serv/domain/security/riposte/scenarios.py:32
msgid "Un site exposé qui voit revenir les mêmes robots d'exploration."
msgstr "同じクローラーが何度も戻ってくる公開サイト。"

#: src/omega_serv/domain/security/riposte/scenarios.py:33
msgid "Au 3e épisode de scan d'une même IP en 7 jours, ban local de plus en plus long (paliers : 1 h, 6 h, 24 h, 7 j)."
msgstr "同じ IP から 7 日以内に 3 回目のスキャンエピソードがあると、ますます長いローカル BAN(段階:1 時間、6 時間、24 時間、7 日)。"

#: src/omega_serv/domain/security/riposte/scenarios.py:35
msgid "Ne réagit jamais à un premier passage : le WAF et son ban automatique s'en chargent."
msgstr "最初の訪問には決して反応しません:WAF とその自動 BAN が対処します。"

#: src/omega_serv/domain/security/riposte/scenarios.py:43
#: src/omega_serv/domain/security/riposte/scenarios.py:49
msgid "Force brute"
msgstr "総当たり"

#: src/omega_serv/domain/security/riposte/scenarios.py:44
msgid "Un site avec une page de connexion ou une zone protégée."
msgstr "ログインページや保護エリアのあるサイト。"

#: src/omega_serv/domain/security/riposte/scenarios.py:45
msgid "Au 2e épisode d'essais d'identifiants d'une même IP en 24 h, ban local progressif."
msgstr "同じ IP から 24 時間以内に 2 回目の認証情報試行エピソードがあると、段階的なローカル BAN。"

#: src/omega_serv/domain/security/riposte/scenarios.py:46
msgid "Ne voit que ce que le WAF classe en essais d'identifiants : les erreurs 401 seules restent pour la jail omega-jail « auth-bruteforce »."
msgstr "WAF が認証情報の試行と分類したものだけを見ます:401 エラーだけのものは omega-jail の jail「auth-bruteforce」に任せます。"

#: src/omega_serv/domain/security/riposte/scenarios.py:55
#: src/omega_serv/domain/security/riposte/scenarios.py:60
msgid "Injections répétées"
msgstr "繰り返しインジェクション"

#: src/omega_serv/domain/security/riposte/scenarios.py:56
msgid "Tout site : une injection (SQL, XSS, commandes) ou une traversée de chemin n'est jamais un accident."
msgstr "どのサイトでも:インジェクション(SQL、XSS、コマンド)やパストラバーサルは決して偶然ではありません。"

#: src/omega_serv/domain/security/riposte/scenarios.py:57
msgid "Dès le 2e épisode d'injection d'une même IP en 24 h, ban local progressif."
msgstr "同じ IP から 24 時間以内の 2 回目のインジェクションエピソードから、段階的なローカル BAN。"

#: src/omega_serv/domain/security/riposte/scenarios.py:58
msgid "Pas de ban réseau par défaut : l'ajouter dans le formulaire si omega-jail est installé."
msgstr "既定ではネットワーク BAN なし:omega-jail がインストールされていればフォームで追加してください。"

#: src/omega_serv/domain/security/riposte/scenarios.py:66
#: src/omega_serv/domain/security/riposte/scenarios.py:71
msgid "Explorateur de leurres"
msgstr "デコイ探索者"

#: src/omega_serv/domain/security/riposte/scenarios.py:67
msgid "Un site qui utilise les leurres d'Active Defense."
msgstr "Active Defense のデコイを使っているサイト。"

#: src/omega_serv/domain/security/riposte/scenarios.py:68
msgid "Une IP qui a déjà visité 2 leurres pendant un épisode y reste 24 h."
msgstr "1 つのエピソード中にすでに 2 つのデコイを訪れた IP は、24 時間そこにとどまります。"

#: src/omega_serv/domain/security/riposte/scenarios.py:69
msgid "Ne bannit pas : la source continue de voir le leurre, pas le vrai site."
msgstr "BAN しません:送信元は本物のサイトではなくデコイを見続けます。"

#: src/omega_serv/domain/security/riposte/scenarios.py:78
#: src/omega_serv/domain/security/riposte/scenarios.py:83
msgid "Sonde upload / API"
msgstr "アップロード / API 調査"

#: src/omega_serv/domain/security/riposte/scenarios.py:79
msgid "Un site avec une API ou un envoi de fichiers."
msgstr "API やファイルアップロードのあるサイト。"

#: src/omega_serv/domain/security/riposte/scenarios.py:80
msgid "Une IP qui sonde l'envoi de fichiers ou l'API est envoyée 24 h vers le leurre « fake_api »."
msgstr "ファイルアップロードや API を探る IP は、24 時間「fake_api」デコイに送られます。"

#: src/omega_serv/domain/security/riposte/scenarios.py:81
msgid "Ne bannit pas ; exige le profil de leurre « fake_api » activé dans Active Defense."
msgstr "BAN しません。Active Defense で「fake_api」デコイプロファイルを有効にする必要があります。"

