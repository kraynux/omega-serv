#: src/omega_serv/interfaces/cli/main.py:2157
msgid "Profils de configuration prêts à l'emploi."
msgstr "すぐに使える設定プロファイル。"

#: src/omega_serv/interfaces/cli/main.py:2158
msgid "Liste les profils disponibles."
msgstr "利用可能なプロファイルの一覧を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2159
msgid "Nom du profil (voir profile list)."
msgstr "プロファイル名（profile list を参照）。"

#: src/omega_serv/interfaces/cli/main.py:2160
msgid "Affiche un profil et les valeurs qu'il fixe."
msgstr "プロファイルとそれが設定する値を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2164
msgid ""
"Applique un profil à la configuration (modifications et conflits affichés "
"d'abord)."
msgstr "プロファイルを設定に適用します（変更点と競合を先に表示）。"

#: src/omega_serv/interfaces/cli/main.py:2167
msgid "Montre seulement ce qui changerait, sans rien écrire."
msgstr "何も書き込まず、変更される内容だけを表示します。"

#: src/omega_serv/interfaces/cli/main.py:2168
msgid "Applique malgré des problèmes bloquants."
msgstr "ブロッキングの問題があっても適用します。"

#: src/omega_serv/interfaces/cli/main.py:2172
msgid "Modules optionnels (waf, fastcgi, active_defense, riposte...)."
msgstr "オプションモジュール（waf, fastcgi, active_defense, riposte...）。"

#: src/omega_serv/interfaces/cli/main.py:2173
msgid "Liste les options et leur état."
msgstr "オプションとその状態の一覧を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2174
msgid "Nom de l'option (voir option list)."
msgstr "オプション名（option list を参照）。"

#: src/omega_serv/interfaces/cli/main.py:2175
msgid "Active une option."
msgstr "オプションを有効にします。"

#: src/omega_serv/interfaces/cli/main.py:2176
msgid ""
"Première activation du WAF : tous les packs de secure/waf/rules/ sont "
"ajoutés, en mode log-only."
msgstr "WAF の初回有効化：secure/waf/rules/ のすべてのパックが log-only モードで追加されます。"

#: src/omega_serv/interfaces/cli/main.py:2179
msgid "Désactive une option."
msgstr "オプションを無効にします。"

#: src/omega_serv/interfaces/cli/main.py:2184
msgid ""
"Montre comment le serveur traiterait une requête (chemin, règles, statut, "
"en-têtes), sans l'envoyer."
msgstr "サーバーがリクエストをどう処理するか（パス、ルール、ステータス、ヘッダー）を、送信せずに表示します。"

#: src/omega_serv/interfaces/cli/main.py:2186
#: src/omega_serv/interfaces/cli/main.py:2194
#: src/omega_serv/interfaces/cli/main.py:2235
#: src/omega_serv/interfaces/cli/main.py:2437
#: src/omega_serv/interfaces/cli/main.py:2447
msgid "CHEMIN"
msgstr "パス"

#: src/omega_serv/interfaces/cli/main.py:2187
msgid "Chemin demandé, par exemple /docs/index.html."
msgstr "要求するパス。例：/docs/index.html。"

#: src/omega_serv/interfaces/cli/main.py:2190
msgid "Pare-feu applicatif (WAF)."
msgstr "アプリケーションファイアウォール（WAF）。"

#: src/omega_serv/interfaces/cli/main.py:2192
msgid ""
"Soumet une requête fictive au WAF et affiche sa décision (règles, score, "
"statut)."
msgstr "架空のリクエストを WAF に送り、その判定（ルール、スコア、ステータス）を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2194
msgid "Chemin de la requête."
msgstr "リクエストのパス。"

#: src/omega_serv/interfaces/cli/main.py:2195
msgid "Chaîne de requête, sans le « ? »."
msgstr "クエリ文字列（「?」は含めない）。"

#: src/omega_serv/interfaces/cli/main.py:2196
msgid "Corps de la requête."
msgstr "リクエストの本文。"

#: src/omega_serv/interfaces/cli/main.py:2198
msgid "Adresse du client simulé (défaut : 127.0.0.1)."
msgstr "模擬クライアントのアドレス（既定：127.0.0.1）。"

#: src/omega_serv/interfaces/cli/main.py:2201
msgid "Affiche les réseaux jamais bannis automatiquement (lu par omega-jail)."
msgstr "自動で BAN されることのないネットワークを表示します（omega-jail が読み取ります）。"

#: src/omega_serv/interfaces/cli/main.py:2204
msgid "Adresses bannies."
msgstr "BAN されたアドレス。"

#: src/omega_serv/interfaces/cli/main.py:2205
msgid "Affiche les bans : réseau, origine, expiration, motif."
msgstr "BAN を表示します：ネットワーク、発生元、期限、理由。"

#: src/omega_serv/interfaces/cli/main.py:2207
msgid ""
"text (défaut, traduit) ou json (pour les autres outils, jamais traduit)."
msgstr "text（既定、翻訳あり）または json（他のツール向け、翻訳なし）。"

#: src/omega_serv/interfaces/cli/main.py:2209
msgid "Bannit une adresse ou un réseau."
msgstr "アドレスまたはネットワークを BAN します。"

#: src/omega_serv/interfaces/cli/main.py:2210
#: src/omega_serv/interfaces/cli/main.py:2220
#: src/omega_serv/interfaces/cli/riposte_action_commands.py:334
msgid "RESEAU"
msgstr "ネットワーク"

#: src/omega_serv/interfaces/cli/main.py:2211
msgid "Adresse IP ou réseau CIDR, par exemple 203.0.113.7 ou 203.0.113.0/24."
msgstr "IP アドレスまたは CIDR ネットワーク。例：203.0.113.7 または 203.0.113.0/24。"

#: src/omega_serv/interfaces/cli/main.py:2212
msgid "Motif du ban."
msgstr "BAN の理由。"

#: src/omega_serv/interfaces/cli/main.py:2213
#: src/omega_serv/interfaces/cli/main.py:2485
msgid "SECONDES"
msgstr "秒"

#: src/omega_serv/interfaces/cli/main.py:2214
msgid ""
"Durée du ban. Sans durée, le ban est permanent et demande --confirm-"
"permanent."
msgstr "BAN の期間。期間がなければ BAN は永続となり、--confirm-permanent が必要です。"

#: src/omega_serv/interfaces/cli/main.py:2215
msgid "Confirme un ban permanent."
msgstr "永続 BAN を確定します。"

#: src/omega_serv/interfaces/cli/main.py:2216
#: src/omega_serv/interfaces/cli/main.py:2222
msgid "OUTIL"
msgstr "ツール"

#: src/omega_serv/interfaces/cli/main.py:2217
msgid ""
"Outil qui pose le ban (ex. omega-fire) : lui seul pourra le lever avec "
"--origin."
msgstr "BAN を設定するツール（例：omega-fire）：そのツールだけが --origin で解除できます。"

#: src/omega_serv/interfaces/cli/main.py:2219
msgid "Lève un ban."
msgstr "BAN を解除します。"

#: src/omega_serv/interfaces/cli/main.py:2221
msgid "Adresse ou réseau, tel qu'affiché par blocklist list."
msgstr "アドレスまたはネットワーク（blocklist list の表示どおり）。"

#: src/omega_serv/interfaces/cli/main.py:2223
msgid "Ne lève le ban que s'il a été posé avec cette origine."
msgstr "この起点で設定された BAN の場合のみ解除します。"

#: src/omega_serv/interfaces/cli/main.py:2227
msgid ""
"Active Defense : état, simulation, purge (voir aussi threats, incidents, "
"deception)."
msgstr "Active Defense：状態、シミュレーション、整理（threats、incidents、deception も参照）。"

#: src/omega_serv/interfaces/cli/main.py:2230
msgid ""
"Affiche l'état : mode, mode guerre, leurres, nombre de sources suivies."
msgstr "状態を表示します：モード、戦時モード、デコイ、追跡中のソース数。"

#: src/omega_serv/interfaces/cli/main.py:2233
msgid ""
"Montre la décision qu'Active Defense prendrait pour une source, sans rien "
"écrire."
msgstr "Active Defense があるソースに対して下す判定を、何も書き込まずに表示します。"

#: src/omega_serv/interfaces/cli/main.py:2234
msgid "Adresse de la source simulée."
msgstr "模擬ソースのアドレス。"

#: src/omega_serv/interfaces/cli/main.py:2236
msgid "Chemin observé (défaut : /)."
msgstr "観測されたパス（既定：/）。"

#: src/omega_serv/interfaces/cli/main.py:2237
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:242
msgid "CLASSE"
msgstr "クラス"

#: src/omega_serv/interfaces/cli/main.py:2238
msgid "Classe d'attaque (défaut : scan ; liste affichée si inconnue)."
msgstr "攻撃クラス（既定：scan；不明な場合は一覧を表示）。"

#: src/omega_serv/interfaces/cli/main.py:2239
msgid "POINTS"
msgstr "ポイント"

#: src/omega_serv/interfaces/cli/main.py:2240
msgid "Points ajoutés au score de menace (défaut : 10)."
msgstr "脅威スコアに加算するポイント（既定：10）。"

#: src/omega_serv/interfaces/cli/main.py:2243
msgid ""
"Purge les menaces expirées, ferme les incidents redevenus calmes, supprime "
"les incidents fermés depuis plus de 90 jours."
msgstr "期限切れの脅威を整理し、落ち着いたインシデントを閉じ、閉じてから 90 日を超えたインシデントを削除します。"

#: src/omega_serv/interfaces/cli/main.py:2246
msgid "Logs d'omega-serv."
msgstr "omega-serv のログ。"

#: src/omega_serv/interfaces/cli/main.py:2248
msgid ""
"Fait tourner les logs dont l'automatisation (Rotate / archivage) est à "
"échéance."
msgstr "自動化（ローテーション / アーカイブ）の期限に達したログをローテーションします。"

#: src/omega_serv/interfaces/cli/main.py:2249
msgid ""
"Lancée chaque nuit par le timer systemd ou la ligne crontab installés par "
"l'interface."
msgstr "インターフェースがインストールした systemd タイマーまたは crontab 行により毎晩起動されます。"

#: src/omega_serv/interfaces/cli/main.py:2252
msgid "Moteur HTTP (Python ou natif)."
msgstr "HTTP エンジン（Python またはネイティブ）。"

#: src/omega_serv/interfaces/cli/main.py:2254
msgid ""
"Affiche le moteur demandé, celui qui tourne et la raison d'un éventuel "
"repli."
msgstr "要求されたエンジン、稼働中のエンジン、フォールバックがあればその理由を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2258
msgid "RIPOSTE : bans de plus en plus longs pour les récidivistes."
msgstr "RIPOSTE：再犯者にはますます長い BAN を科します。"

#: src/omega_serv/interfaces/cli/main.py:2260
msgid ""
"Lance le processus RIPOSTE au premier plan (normalement lancé par serve ; "
"utile au diagnostic)."
msgstr "RIPOSTE プロセスをフォアグラウンドで実行します（通常は serve が起動；診断に便利）。"

#: src/omega_serv/interfaces/cli/main.py:2262
msgid "Affiche l'état de RIPOSTE (lecture seule)."
msgstr "RIPOSTE の状態を表示します（読み取り専用）。"

#: src/omega_serv/interfaces/cli/main.py:2267
msgid ""
"Administration web : tableau de bord dans le navigateur, sur son propre "
"port."
msgstr "Web 管理：ブラウザーで開くダッシュボード、専用のポートで提供。"

#: src/omega_serv/interfaces/cli/main.py:2269
msgid ""
"Lance le processus d'administration web au premier plan (normalement lancé "
"par serve ; utile au diagnostic)."
msgstr "Web 管理プロセスをフォアグラウンドで実行します（通常は serve が起動；診断に便利）。"

#: src/omega_serv/interfaces/cli/main.py:2276
msgid "Menaces suivies par Active Defense."
msgstr "Active Defense が追跡している脅威。"

#: src/omega_serv/interfaces/cli/main.py:2277
msgid "Liste les sources suivies avec leur score et leur niveau."
msgstr "追跡中のソースをスコアとレベル付きで一覧表示します。"

#: src/omega_serv/interfaces/cli/main.py:2279
msgid "Seulement ce niveau."
msgstr "このレベルのみ。"

#: src/omega_serv/interfaces/cli/main.py:2281
msgid "Affiche le détail d'une source suivie."
msgstr "追跡中のソースの詳細を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2282
#: src/omega_serv/interfaces/cli/main.py:2316
msgid "SOURCE"
msgstr "ソース"

#: src/omega_serv/interfaces/cli/main.py:2283
msgid "Identifiant de la source, tel qu'affiché par threats list."
msgstr "ソースの識別子（threats list の表示どおり）。"

#: src/omega_serv/interfaces/cli/main.py:2286
msgid "Incidents Active Defense."
msgstr "Active Defense のインシデント。"

#: src/omega_serv/interfaces/cli/main.py:2287
msgid "Identifiant de l'incident (voir incidents list)."
msgstr "インシデントの識別子（incidents list を参照）。"

#: src/omega_serv/interfaces/cli/main.py:2288
msgid "Liste les incidents."
msgstr "インシデントの一覧を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2290
msgid "Seulement les incidents ouverts (open) ou fermés (closed)."
msgstr "未解決（open）または解決済み（closed）のインシデントのみ。"

#: src/omega_serv/interfaces/cli/main.py:2291
msgid "HEURES"
msgstr "時間"

#: src/omega_serv/interfaces/cli/main.py:2292
msgid "Seulement les incidents des N dernières heures."
msgstr "直近 N 時間のインシデントのみ。"

#: src/omega_serv/interfaces/cli/main.py:2294
msgid "Affiche un incident et sa chronologie."
msgstr "インシデントとその時系列を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2298
msgid "Ferme un incident (et l'exporte si l'export automatique est activé)."
msgstr "インシデントを閉じます（自動エクスポートが有効ならエクスポートも行います）。"

#: src/omega_serv/interfaces/cli/main.py:2302
msgid "Exporte les indicateurs de compromission (IoC) d'un incident."
msgstr "インシデントの侵害指標（IoC）をエクスポートします。"

#: src/omega_serv/interfaces/cli/main.py:2304
msgid "FORMATS"
msgstr "形式"

#: src/omega_serv/interfaces/cli/main.py:2305
msgid ""
"Un ou plusieurs formats séparés par des virgules : json, csv, stix, misp "
"(défaut : json)."
msgstr "カンマ区切りの 1 つ以上の形式：json, csv, stix, misp（既定：json）。"

#: src/omega_serv/interfaces/cli/main.py:2308
msgid "Écrit le rapport Markdown d'un incident."
msgstr "インシデントの Markdown レポートを書き出します。"

#: src/omega_serv/interfaces/cli/main.py:2312
msgid "Leurres Active Defense."
msgstr "Active Defense のデコイ。"

#: src/omega_serv/interfaces/cli/main.py:2313
msgid "Liste les sources envoyées vers un leurre."
msgstr "デコイに送られたソースの一覧を表示します。"

#: src/omega_serv/interfaces/cli/main.py:2315
msgid "Libère une source de son leurre."
msgstr "ソースをデコイから解放します。"

#: src/omega_serv/interfaces/cli/main.py:2317
msgid "Identifiant de la source, tel qu'affiché par deception list."
msgstr "ソースの識別子（deception list の表示どおり）。"

#: src/omega_serv/interfaces/cli/main.py:2320
msgid "Certificats TLS (via OpenSSL)."
msgstr "TLS 証明書（OpenSSL 経由）。"

#: src/omega_serv/interfaces/cli/main.py:2326
msgid "Organisation (défaut : OMEGA-SERV)."
msgstr "組織（既定：OMEGA-SERV）。"

#: src/omega_serv/interfaces/cli/main.py:2327
msgid "Service ou département."
msgstr "部署または部門。"

#: src/omega_serv/interfaces/cli/main.py:2328
msgid "Ville."
msgstr "市区町村。"

#: src/omega_serv/interfaces/cli/main.py:2329
msgid "Région."
msgstr "都道府県または地域。"

#: src/omega_serv/interfaces/cli/main.py:2330
msgid "Pays, code à deux lettres (FR, BE...)."
msgstr "国、2 文字のコード（FR, BE...）。"

#: src/omega_serv/interfaces/cli/main.py:2334
msgid "Noms de domaine supplémentaires couverts par le certificat."
msgstr "証明書が対象とする追加のドメイン名。"

#: src/omega_serv/interfaces/cli/main.py:2336
msgid "Adresses IP couvertes par le certificat."
msgstr "証明書が対象とする IP アドレス。"

#: src/omega_serv/interfaces/cli/main.py:2338
msgid "Nom commun : le nom de domaine principal."
msgstr "コモンネーム：主なドメイン名。"

#: src/omega_serv/interfaces/cli/main.py:2340
msgid ""
"Génère un certificat auto-signé aux chemins de la configuration (l'ancien "
"est sauvegardé)."
msgstr "設定のパスに自己署名証明書を生成します（古い証明書はバックアップされます）。"

#: src/omega_serv/interfaces/cli/main.py:2343
#: src/omega_serv/interfaces/cli/main.py:2354
#: src/omega_serv/interfaces/cli/main.py:2378
#: src/omega_serv/interfaces/cli/main.py:2412
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:256
msgid "JOURS"
msgstr "日数"

#: src/omega_serv/interfaces/cli/main.py:2344
#: src/omega_serv/interfaces/cli/main.py:2379
msgid "Validité en jours (défaut : 365)."
msgstr "有効期間（日数、既定：365）。"

#: src/omega_serv/interfaces/cli/main.py:2346
#: src/omega_serv/interfaces/cli/main.py:2366
msgid "Type de clé (défaut : rsa2048)."
msgstr "鍵の種類（既定：rsa2048）。"

#: src/omega_serv/interfaces/cli/main.py:2347
#: src/omega_serv/interfaces/cli/main.py:2358
#: src/omega_serv/interfaces/cli/main.py:2376
#: src/omega_serv/interfaces/cli/main.py:2397
#: src/omega_serv/interfaces/cli/main.py:2424
#: src/omega_serv/interfaces/cli/main.py:2433
msgid "MOT-DE-PASSE"
msgstr "パスワード"

#: src/omega_serv/interfaces/cli/main.py:2348
msgid "Chiffre la clé privée avec ce mot de passe (facultatif)."
msgstr "このパスワードで秘密鍵を暗号化します（任意）。"

#: src/omega_serv/interfaces/cli/main.py:2352
msgid "Crée une autorité de certification locale dans secure/certificates/ca."
msgstr "secure/certificates/ca にローカル認証局を作成します。"

#: src/omega_serv/interfaces/cli/main.py:2353
msgid "Nom de l'autorité de certification."
msgstr "認証局の名前。"

#: src/omega_serv/interfaces/cli/main.py:2355
msgid "Validité en jours (défaut : 3650)."
msgstr "有効期間（日数、既定：3650）。"

#: src/omega_serv/interfaces/cli/main.py:2357
msgid "Type de clé (défaut : rsa4096)."
msgstr "鍵の種類（既定：rsa4096）。"

#: src/omega_serv/interfaces/cli/main.py:2359
msgid ""
"Mot de passe de la clé de CA ; sans cette option, il est demandé deux fois "
"au clavier (conseillé)."
msgstr "CA 鍵のパスワード。このオプションがなければキーボードから 2 回尋ねます（推奨）。"

#: src/omega_serv/interfaces/cli/main.py:2363
msgid ""
"Génère une clé et une demande de signature (CSR) à faire signer par une CA."
msgstr "CA に署名してもらう鍵と署名要求（CSR）を生成します。"

#: src/omega_serv/interfaces/cli/main.py:2367
msgid "Clé privée à créer."
msgstr "作成する秘密鍵。"

#: src/omega_serv/interfaces/cli/main.py:2368
msgid "Demande de signature à créer."
msgstr "作成する署名要求。"

#: src/omega_serv/interfaces/cli/main.py:2371
msgid "Mot de passe de la clé de CA (sinon demandé au clavier, conseillé)."
msgstr "CA 鍵のパスワード（指定しなければキーボードから尋ねます、推奨）。"

#: src/omega_serv/interfaces/cli/main.py:2372
msgid "Signe une demande de signature (CSR) avec une CA."
msgstr "CA で署名要求（CSR）に署名します。"

#: src/omega_serv/interfaces/cli/main.py:2373
msgid "Demande de signature à signer."
msgstr "署名する署名要求。"

#: src/omega_serv/interfaces/cli/main.py:2374
#: src/omega_serv/interfaces/cli/main.py:2395
msgid "Clé privée de la CA."
msgstr "CA の秘密鍵。"

#: src/omega_serv/interfaces/cli/main.py:2375
#: src/omega_serv/interfaces/cli/main.py:2396
msgid "Certificat de la CA."
msgstr "CA の証明書。"

#: src/omega_serv/interfaces/cli/main.py:2380
msgid "Certificat signé à écrire."
msgstr "書き出す署名済み証明書。"

#: src/omega_serv/interfaces/cli/main.py:2382
msgid "Écrit aussi la chaîne complète (certificat puis CA)."
msgstr "完全なチェーン（証明書、次に CA）も書き出します。"

#: src/omega_serv/interfaces/cli/main.py:2386
msgid ""
"Installe un certificat existant aux chemins de la configuration (Let's "
"Encrypt, CA d'entreprise...)."
msgstr "既存の証明書を設定のパスにインストールします（Let's Encrypt、企業の CA など）。"

#: src/omega_serv/interfaces/cli/main.py:2387
msgid "Clé privée."
msgstr "秘密鍵。"

#: src/omega_serv/interfaces/cli/main.py:2388
msgid "Certificat."
msgstr "証明書。"

#: src/omega_serv/interfaces/cli/main.py:2390
msgid "Chaîne des certificats intermédiaires (facultatif)."
msgstr "中間証明書のチェーン（任意）。"

#: src/omega_serv/interfaces/cli/main.py:2393
msgid "Révoque un certificat émis par une CA locale."
msgstr "ローカル CA が発行した証明書を失効させます。"

#: src/omega_serv/interfaces/cli/main.py:2394
msgid "Certificat à révoquer."
msgstr "失効させる証明書。"

#: src/omega_serv/interfaces/cli/main.py:2401
msgid "Certificat à lire (défaut : celui de la configuration)."
msgstr "読み取る証明書（既定：設定の証明書）。"

#: src/omega_serv/interfaces/cli/main.py:2403
msgid ""
"Vérifie un certificat : dates, correspondance avec la clé, droits de la clé."
" Code 1 s'il a expiré."
msgstr "証明書を検証します：日付、鍵との一致、鍵の権限。期限切れならコード 1。"

#: src/omega_serv/interfaces/cli/main.py:2406
