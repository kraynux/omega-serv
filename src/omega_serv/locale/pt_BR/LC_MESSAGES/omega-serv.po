msgid "Le préfixe de chemin auquel s'applique la règle."
msgstr "O prefixo de caminho ao qual a regra se aplica."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:406
msgid "Doit commencer par '/', ex: /private/. Le plus long préfixe correspondant gagne."
msgstr "Deve começar com '/', ex.: /private/. O prefixo correspondente mais longo vence."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:407
msgid "Ajoute/modifie une règle via Ajouter/Modifier."
msgstr "Adiciona/modifica uma regra via Adicionar/Editar."

