msgstr "Para controlar o servidor como serviço do sistema."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:55
msgid "Ouvre l'écran Service."
msgstr "Abre a tela Serviço."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:56
msgid "Voir sa propre fiche - certaines actions demandent une authentification (sudo)."
msgstr "Veja a ficha dela - algumas ações pedem autenticação (sudo)."

