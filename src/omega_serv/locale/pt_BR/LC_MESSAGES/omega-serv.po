msgstr "SOMENTE PREFERÊNCIAS DE INTERFACE (tema, renderização, caminhos de exportação/capturas) - NÃO são configurações do servidor (essas ficam em Configuração detalhada)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:174
msgid "Thème visuel de l'interface elle-même."
msgstr "Tema visual da própria interface."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:175
msgid "Un des thèmes disponibles."
msgstr "Um dos temas disponíveis."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:176
msgid "Appliqué immédiatement au changement."
msgstr "Aplicado imediatamente ao mudar."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:177
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "Efeito imediato, nenhuma reinicialização necessária."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:180
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:207
