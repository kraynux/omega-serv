msgstr "Een willekeurig IP. Standaardwaarde: 203.0.113.42."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:260
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:267
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:274
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:281
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:288
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:193
msgid "Utilisée au clic sur Simuler."
msgstr "Gebruikt bij klikken op Simuleren."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:261
msgid "Aucun effet réel - aucune écriture, aucun impact réseau."
msgstr "Geen echt effect - geen schrijfactie, geen netwerkimpact."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:264
msgid "Chemin simulé"
msgstr "Gesimuleerd pad"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:265
msgid "Chemin de la requête simulée."
msgstr "Pad van het gesimuleerde verzoek."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:266
msgid "Chaîne libre. Valeur par défaut : /wp-login.php."
msgstr "Vrije tekst. Standaardwaarde: /wp-login.php."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:268
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:275
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:282
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:289
msgid "Aucun effet réel."
msgstr "Geen echt effect."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:271
msgid "User-Agent"
msgstr "User-Agent"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:272
msgid "User-Agent simulé (participe au calcul de l'identifiant de source simulé)."
msgstr "Gesimuleerde User-Agent (telt mee bij het berekenen van de gesimuleerde bronidentificatie)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:273
msgid "Chaîne libre, optionnelle."
msgstr "Vrije tekst, optioneel."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:278
msgid "Classe d'attaque"
msgstr "Aanvalsklasse"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:279
msgid "Type d'attaque simulé."
msgstr "Gesimuleerd aanvalstype."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:280
msgid "Doit être une classe connue (ex: scan). Valeur par défaut : scan."
msgstr "Moet een bekende klasse zijn (bijv. scan). Standaardwaarde: scan."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:285
#: src/omega_serv/interfaces/tui/screens/threats_screen.py:44
msgid "Score"
msgstr "Score"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:286
