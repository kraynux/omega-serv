#: src/omega_serv/domain/security/waf/keyword_list.py:57
msgid ""
"# Syntaxe (une entrée par ligne, '#' = commentaire) :\n"
"#   /admin    -> /admin et /admin/xxx, jamais /administrator\n"
"#   /.git/    -> tout ce qui est sous /.git/\n"
"#   /*.bak    -> tout fichier dont le nom finit par .bak\n"
"#   !/api/v1  -> exception : ce chemin n'est jamais compte par cette liste\n"
"#               (prioritaire sur les entrées, quel que soit l'ordre des lignes)"
msgstr ""
"# Syntaxis (één regel per item, '#' = commentaar):\n"
"#   /admin    -> /admin en /admin/xxx, nooit /administrator\n"
"#   /.git/    -> alles onder /.git/\n"
"#   /*.bak    -> elk bestand waarvan de naam eindigt op .bak\n"
"#   !/api/v1  -> uitzondering: dit pad wordt nooit door deze lijst geteld\n"
"#               (gaat voor op de items, ongeacht de volgorde van de regels)"

#: src/omega_serv/domain/security/waf/keyword_list.py:64
