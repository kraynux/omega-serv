msgstr "Start -> Actieve beveiliging -> Simuleren"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:254
msgid "Simule une décision Active Defense (score, classe d'attaque) SANS aucun effet réel - dry-run complet."
msgstr "Simuleert een beslissing van Active Defense (score, aanvalsklasse) ZONDER enig echt effect - volledige dry-run."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:257
msgid "IP simulée"
msgstr "Gesimuleerd IP"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:258
msgid "Adresse IP source utilisée pour la simulation."
msgstr "Bron-IP-adres gebruikt voor de simulatie."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:259
