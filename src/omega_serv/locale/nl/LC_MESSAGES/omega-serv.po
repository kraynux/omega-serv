#: src/omega_serv/interfaces/cli/main.py:2329
#: src/omega_serv/interfaces/cli/main.py:2438
#: src/omega_serv/interfaces/cli/main.py:2477
msgid "TEXTE"
msgstr "TEKST"

#: src/omega_serv/interfaces/cli/main.py:2135
msgid "Texte libre enregistré avec la sauvegarde."
msgstr "Vrije tekst die bij de back-up wordt opgeslagen."

#: src/omega_serv/interfaces/cli/main.py:2137
msgid "Restaure une sauvegarde."
msgstr "Zet een back-up terug."

#: src/omega_serv/interfaces/cli/main.py:2138
#: src/omega_serv/interfaces/cli/main.py:2147
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:98
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:101
msgid "ID"
msgstr "ID"

#: src/omega_serv/interfaces/cli/main.py:2139
#: src/omega_serv/interfaces/cli/main.py:2148
msgid "Identifiant de la sauvegarde (voir config list-backups)."
msgstr "Kenmerk van de back-up (zie config list-backups)."

#: src/omega_serv/interfaces/cli/main.py:2141
msgid "Arrête le service, restaure, puis le redémarre (nécessaire si le service tourne)."
msgstr "Stopt de dienst, zet terug en start hem daarna opnieuw (nodig als de dienst draait)."

#: src/omega_serv/interfaces/cli/main.py:2143
msgid "En cas de conflit de port avec une autre instance : garder l'adresse, le port et le nom de service actuels."
msgstr "Bij een poortconflict met een andere instantie: het huidige adres, de huidige poort en de huidige dienstnaam behouden."

#: src/omega_serv/interfaces/cli/main.py:2146
msgid "Copie une sauvegarde hors du dossier omega-serv, avec son empreinte .sha256."
msgstr "Kopieert een back-up buiten de map van omega-serv, met de .sha256-vingerafdruk."

#: src/omega_serv/interfaces/cli/main.py:2149
msgid "DOSSIER"
msgstr "MAP"

#: src/omega_serv/interfaces/cli/main.py:2149
msgid "Dossier de destination."
msgstr "Doelmap."

#: src/omega_serv/interfaces/cli/main.py:2152
msgid "Ajoute à la liste une sauvegarde exportée, après vérification (empreinte, contenu)."
msgstr "Voegt een geëxporteerde back-up aan de lijst toe, na controle (vingerafdruk, inhoud)."

#: src/omega_serv/interfaces/cli/main.py:2153
msgid "Archive .tar.gz, son .sha256 à côté."
msgstr ".tar.gz-archief, met het .sha256-bestand ernaast."

#: src/omega_serv/interfaces/cli/main.py:2155
msgid "Liste les sauvegardes."
msgstr "Toont de lijst van back-ups."

#: src/omega_serv/interfaces/cli/main.py:2157
msgid "Profils de configuration prêts à l'emploi."
msgstr "Kant-en-klare configuratieprofielen."

#: src/omega_serv/interfaces/cli/main.py:2158
msgid "Liste les profils disponibles."
msgstr "Toont de lijst van beschikbare profielen."

#: src/omega_serv/interfaces/cli/main.py:2159
msgid "Nom du profil (voir profile list)."
msgstr "Naam van het profiel (zie profile list)."

#: src/omega_serv/interfaces/cli/main.py:2160
msgid "Affiche un profil et les valeurs qu'il fixe."
msgstr "Toont een profiel en de waarden die het instelt."

#: src/omega_serv/interfaces/cli/main.py:2164
msgid "Applique un profil à la configuration (modifications et conflits affichés d'abord)."
msgstr "Past een profiel toe op de configuratie (wijzigingen en conflicten worden eerst getoond)."

#: src/omega_serv/interfaces/cli/main.py:2167
msgid "Montre seulement ce qui changerait, sans rien écrire."
msgstr "Toont alleen wat er zou veranderen, zonder iets te schrijven."

#: src/omega_serv/interfaces/cli/main.py:2168
msgid "Applique malgré des problèmes bloquants."
msgstr "Past toe ondanks blokkerende problemen."

#: src/omega_serv/interfaces/cli/main.py:2172
msgid "Modules optionnels (waf, fastcgi, active_defense, riposte...)."
msgstr "Optionele modules (waf, fastcgi, active_defense, riposte...)."

#: src/omega_serv/interfaces/cli/main.py:2173
msgid "Liste les options et leur état."
msgstr "Toont de opties en hun status."

#: src/omega_serv/interfaces/cli/main.py:2174
msgid "Nom de l'option (voir option list)."
msgstr "Naam van de optie (zie option list)."

#: src/omega_serv/interfaces/cli/main.py:2175
msgid "Active une option."
msgstr "Schakelt een optie in."

#: src/omega_serv/interfaces/cli/main.py:2176
msgid "Première activation du WAF : tous les packs de secure/waf/rules/ sont ajoutés, en mode log-only."
msgstr "Eerste inschakeling van de WAF: alle pakketten uit secure/waf/rules/ worden toegevoegd, in de modus log-only."

#: src/omega_serv/interfaces/cli/main.py:2179
msgid "Désactive une option."
msgstr "Schakelt een optie uit."

#: src/omega_serv/interfaces/cli/main.py:2184
msgid "Montre comment le serveur traiterait une requête (chemin, règles, statut, en-têtes), sans l'envoyer."
msgstr "Toont hoe de server een verzoek zou behandelen (pad, regels, status, headers), zonder het te verzenden."

#: src/omega_serv/interfaces/cli/main.py:2186
#: src/omega_serv/interfaces/cli/main.py:2194
#: src/omega_serv/interfaces/cli/main.py:2235
#: src/omega_serv/interfaces/cli/main.py:2437
#: src/omega_serv/interfaces/cli/main.py:2447
msgid "CHEMIN"
msgstr "PAD"

#: src/omega_serv/interfaces/cli/main.py:2187
msgid "Chemin demandé, par exemple /docs/index.html."
msgstr "Gevraagd pad, bijvoorbeeld /docs/index.html."

#: src/omega_serv/interfaces/cli/main.py:2190
msgid "Pare-feu applicatif (WAF)."
msgstr "Applicatiefirewall (WAF)."

#: src/omega_serv/interfaces/cli/main.py:2192
msgid "Soumet une requête fictive au WAF et affiche sa décision (règles, score, statut)."
msgstr "Stuurt een fictief verzoek naar de WAF en toont zijn beslissing (regels, score, status)."

#: src/omega_serv/interfaces/cli/main.py:2194
msgid "Chemin de la requête."
msgstr "Pad van het verzoek."

#: src/omega_serv/interfaces/cli/main.py:2195
msgid "Chaîne de requête, sans le « ? »."
msgstr "Querystring, zonder het „?”."

#: src/omega_serv/interfaces/cli/main.py:2196
msgid "Corps de la requête."
msgstr "Body van het verzoek."

#: src/omega_serv/interfaces/cli/main.py:2198
msgid "Adresse du client simulé (défaut : 127.0.0.1)."
msgstr "Adres van de gesimuleerde client (standaard: 127.0.0.1)."

#: src/omega_serv/interfaces/cli/main.py:2201
msgid "Affiche les réseaux jamais bannis automatiquement (lu par omega-jail)."
msgstr "Toont de netwerken die nooit automatisch worden verbannen (gelezen door omega-jail)."

#: src/omega_serv/interfaces/cli/main.py:2204
msgid "Adresses bannies."
msgstr "Verbannen adressen."

#: src/omega_serv/interfaces/cli/main.py:2205
msgid "Affiche les bans : réseau, origine, expiration, motif."
msgstr "Toont de bans: netwerk, herkomst, vervaldatum, reden."

#: src/omega_serv/interfaces/cli/main.py:2207
msgid "text (défaut, traduit) ou json (pour les autres outils, jamais traduit)."
msgstr "text (standaard, vertaald) of json (voor andere hulpmiddelen, nooit vertaald)."

#: src/omega_serv/interfaces/cli/main.py:2209
msgid "Bannit une adresse ou un réseau."
msgstr "Verbant een adres of een netwerk."

#: src/omega_serv/interfaces/cli/main.py:2210
#: src/omega_serv/interfaces/cli/main.py:2220
#: src/omega_serv/interfaces/cli/riposte_action_commands.py:334
msgid "RESEAU"
msgstr "NETWERK"

#: src/omega_serv/interfaces/cli/main.py:2211
msgid "Adresse IP ou réseau CIDR, par exemple 203.0.113.7 ou 203.0.113.0/24."
msgstr "IP-adres of CIDR-netwerk, bijvoorbeeld 203.0.113.7 of 203.0.113.0/24."

#: src/omega_serv/interfaces/cli/main.py:2212
msgid "Motif du ban."
msgstr "Reden van de ban."

#: src/omega_serv/interfaces/cli/main.py:2213
#: src/omega_serv/interfaces/cli/main.py:2485
msgid "SECONDES"
msgstr "SECONDEN"

#: src/omega_serv/interfaces/cli/main.py:2214
msgid "Durée du ban. Sans durée, le ban est permanent et demande --confirm-permanent."
msgstr "Duur van de ban. Zonder duur is de ban permanent en vereist hij --confirm-permanent."

#: src/omega_serv/interfaces/cli/main.py:2215
msgid "Confirme un ban permanent."
msgstr "Bevestigt een permanente ban."

#: src/omega_serv/interfaces/cli/main.py:2216
#: src/omega_serv/interfaces/cli/main.py:2222
msgid "OUTIL"
msgstr "HULPMIDDEL"

#: src/omega_serv/interfaces/cli/main.py:2217
msgid "Outil qui pose le ban (ex. omega-fire) : lui seul pourra le lever avec --origin."
msgstr "Hulpmiddel dat de blokkering plaatst (bijv. omega-fire): alleen dat kan haar met --origin opheffen."

#: src/omega_serv/interfaces/cli/main.py:2219
msgid "Lève un ban."
msgstr "Heft een ban op."

#: src/omega_serv/interfaces/cli/main.py:2221
msgid "Adresse ou réseau, tel qu'affiché par blocklist list."
msgstr "Adres of netwerk, zoals getoond door blocklist list."

#: src/omega_serv/interfaces/cli/main.py:2223
msgid "Ne lève le ban que s'il a été posé avec cette origine."
msgstr "Heft de blokkering alleen op als ze met deze herkomst is geplaatst."

#: src/omega_serv/interfaces/cli/main.py:2227
msgid "Active Defense : état, simulation, purge (voir aussi threats, incidents, deception)."
msgstr "Active Defense: status, simulatie, opschoning (zie ook threats, incidents, deception)."

#: src/omega_serv/interfaces/cli/main.py:2230
msgid "Affiche l'état : mode, mode guerre, leurres, nombre de sources suivies."
msgstr "Toont de status: modus, oorlogsmodus, lokazen, aantal gevolgde bronnen."

#: src/omega_serv/interfaces/cli/main.py:2233
msgid "Montre la décision qu'Active Defense prendrait pour une source, sans rien écrire."
msgstr "Toont de beslissing die Active Defense voor een bron zou nemen, zonder iets te schrijven."

#: src/omega_serv/interfaces/cli/main.py:2234
msgid "Adresse de la source simulée."
msgstr "Adres van de gesimuleerde bron."

#: src/omega_serv/interfaces/cli/main.py:2236
msgid "Chemin observé (défaut : /)."
msgstr "Waargenomen pad (standaard: /)."

#: src/omega_serv/interfaces/cli/main.py:2237
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:242
msgid "CLASSE"
msgstr "KLASSE"

#: src/omega_serv/interfaces/cli/main.py:2238
msgid "Classe d'attaque (défaut : scan ; liste affichée si inconnue)."
msgstr "Aanvalsklasse (standaard: scan; lijst getoond indien onbekend)."

#: src/omega_serv/interfaces/cli/main.py:2239
msgid "POINTS"
msgstr "PUNTEN"

#: src/omega_serv/interfaces/cli/main.py:2240
msgid "Points ajoutés au score de menace (défaut : 10)."
msgstr "Punten die bij de dreigingsscore worden opgeteld (standaard: 10)."

#: src/omega_serv/interfaces/cli/main.py:2243
msgid "Purge les menaces expirées, ferme les incidents redevenus calmes, supprime les incidents fermés depuis plus de 90 jours."
msgstr "Schoont verlopen dreigingen op, sluit incidenten die weer rustig zijn, verwijdert incidenten die meer dan 90 dagen gesloten zijn."

#: src/omega_serv/interfaces/cli/main.py:2246
msgid "Logs d'omega-serv."
msgstr "Logs van omega-serv."

#: src/omega_serv/interfaces/cli/main.py:2248
msgid "Fait tourner les logs dont l'automatisation (Rotate / archivage) est à échéance."
msgstr "Roteert de logs waarvan de automatisering (Roteren / archiveren) aan de beurt is."

#: src/omega_serv/interfaces/cli/main.py:2249
msgid "Lancée chaque nuit par le timer systemd ou la ligne crontab installés par l'interface."
msgstr "Elke nacht gestart door de systemd-timer of de crontab-regel die de interface heeft geïnstalleerd."

#: src/omega_serv/interfaces/cli/main.py:2252
msgid "Moteur HTTP (Python ou natif)."
msgstr "HTTP-engine (Python of native)."

#: src/omega_serv/interfaces/cli/main.py:2254
msgid "Affiche le moteur demandé, celui qui tourne et la raison d'un éventuel repli."
msgstr "Toont de gevraagde engine, de draaiende en de reden van een eventuele terugval."

#: src/omega_serv/interfaces/cli/main.py:2258
msgid "RIPOSTE : bans de plus en plus longs pour les récidivistes."
msgstr "RIPOSTE: steeds langere bans voor herhaaldelijke overtreders."

#: src/omega_serv/interfaces/cli/main.py:2260
msgid "Lance le processus RIPOSTE au premier plan (normalement lancé par serve ; utile au diagnostic)."
msgstr "Start het RIPOSTE-proces op de voorgrond (normaal gestart door serve; handig voor diagnose)."

#: src/omega_serv/interfaces/cli/main.py:2262
msgid "Affiche l'état de RIPOSTE (lecture seule)."
msgstr "Toont de status van RIPOSTE (alleen lezen)."

#: src/omega_serv/interfaces/cli/main.py:2267
msgid "Administration web : tableau de bord dans le navigateur, sur son propre port."
msgstr "Webbeheer: dashboard in de browser, op een eigen poort."

#: src/omega_serv/interfaces/cli/main.py:2269
msgid "Lance le processus d'administration web au premier plan (normalement lancé par serve ; utile au diagnostic)."
msgstr "Start het webbeheerproces op de voorgrond (normaal gestart door serve; handig voor diagnose)."

#: src/omega_serv/interfaces/cli/main.py:2276
msgid "Menaces suivies par Active Defense."
msgstr "Dreigingen gevolgd door Active Defense."

#: src/omega_serv/interfaces/cli/main.py:2277
msgid "Liste les sources suivies avec leur score et leur niveau."
msgstr "Toont de gevolgde bronnen met hun score en niveau."

#: src/omega_serv/interfaces/cli/main.py:2279
msgid "Seulement ce niveau."
msgstr "Alleen dit niveau."

#: src/omega_serv/interfaces/cli/main.py:2281
msgid "Affiche le détail d'une source suivie."
msgstr "Toont de details van een gevolgde bron."

#: src/omega_serv/interfaces/cli/main.py:2282
#: src/omega_serv/interfaces/cli/main.py:2316
msgid "SOURCE"
msgstr "BRON"

#: src/omega_serv/interfaces/cli/main.py:2283
msgid "Identifiant de la source, tel qu'affiché par threats list."
msgstr "Kenmerk van de bron, zoals getoond door threats list."

#: src/omega_serv/interfaces/cli/main.py:2286
msgid "Incidents Active Defense."
msgstr "Incidenten van Active Defense."

#: src/omega_serv/interfaces/cli/main.py:2287
msgid "Identifiant de l'incident (voir incidents list)."
msgstr "Kenmerk van het incident (zie incidents list)."

#: src/omega_serv/interfaces/cli/main.py:2288
msgid "Liste les incidents."
msgstr "Toont de incidenten."

#: src/omega_serv/interfaces/cli/main.py:2290
msgid "Seulement les incidents ouverts (open) ou fermés (closed)."
msgstr "Alleen open (open) of gesloten (closed) incidenten."

#: src/omega_serv/interfaces/cli/main.py:2291
msgid "HEURES"
msgstr "UREN"

#: src/omega_serv/interfaces/cli/main.py:2292
msgid "Seulement les incidents des N dernières heures."
msgstr "Alleen de incidenten van de laatste N uur."

#: src/omega_serv/interfaces/cli/main.py:2294
msgid "Affiche un incident et sa chronologie."
msgstr "Toont een incident en zijn tijdlijn."

#: src/omega_serv/interfaces/cli/main.py:2298
msgid "Ferme un incident (et l'exporte si l'export automatique est activé)."
msgstr "Sluit een incident (en exporteert het als automatische export is ingeschakeld)."

#: src/omega_serv/interfaces/cli/main.py:2302
msgid "Exporte les indicateurs de compromission (IoC) d'un incident."
msgstr "Exporteert de indicatoren van compromittering (IoC) van een incident."

#: src/omega_serv/interfaces/cli/main.py:2304
msgid "FORMATS"
msgstr "FORMATEN"

#: src/omega_serv/interfaces/cli/main.py:2305
msgid "Un ou plusieurs formats séparés par des virgules : json, csv, stix, misp (défaut : json)."
msgstr "Eén of meer formaten gescheiden door komma's: json, csv, stix, misp (standaard: json)."

#: src/omega_serv/interfaces/cli/main.py:2308
msgid "Écrit le rapport Markdown d'un incident."
msgstr "Schrijft het Markdown-rapport van een incident."

#: src/omega_serv/interfaces/cli/main.py:2312
msgid "Leurres Active Defense."
msgstr "Lokazen van Active Defense."

#: src/omega_serv/interfaces/cli/main.py:2313
msgid "Liste les sources envoyées vers un leurre."
