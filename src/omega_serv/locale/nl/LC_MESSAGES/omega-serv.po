#: src/omega_serv/interfaces/cli/main.py:2512
msgid "FICHIER"
msgstr "BESTAND"

#: src/omega_serv/interfaces/cli/main.py:2073
msgid "Fichier de configuration (défaut : config/omega-serve.json de l'installation)."
msgstr "Configuratiebestand (standaard: config/omega-serve.json van de installatie)."

#: src/omega_serv/interfaces/cli/main.py:2076
msgid "Accepte un certificat auto-signé sur une adresse publique."
msgstr "Accepteert een zelfondertekend certificaat op een openbaar adres."

#: src/omega_serv/interfaces/cli/main.py:2077
msgid "Accepte des zones à mot de passe sans TLS (mots de passe lisibles sur le réseau)."
msgstr "Accepteert zones met wachtwoord zonder TLS (wachtwoorden leesbaar op het netwerk)."

#: src/omega_serv/interfaces/cli/main.py:2078
msgid "Méthode HTTP (défaut : GET)."
msgstr "HTTP-methode (standaard: GET)."

#: src/omega_serv/interfaces/cli/main.py:2081
msgid "Démarre le serveur au premier plan (c'est ce que lance le service système). Refuse de tourner en root."
msgstr "Start de server op de voorgrond (dit is wat de systeemdienst uitvoert). Weigert als root te draaien."

#: src/omega_serv/interfaces/cli/main.py:2087
msgid "Fichier de configuration : création, vérification, TLS, sauvegardes."
msgstr "Configuratiebestand: aanmaken, controleren, TLS, back-ups."

#: src/omega_serv/interfaces/cli/main.py:2088
msgid "Crée le fichier de configuration par défaut."
msgstr "Maakt het standaard configuratiebestand aan."

#: src/omega_serv/interfaces/cli/main.py:2089
msgid "Écrase le fichier existant."
msgstr "Overschrijft het bestaande bestand."

#: src/omega_serv/interfaces/cli/main.py:2092
msgid "Vérifie la configuration et l'environnement (chemins, droits, certificats) sans démarrer."
msgstr "Controleert de configuratie en de omgeving (paden, rechten, certificaten) zonder te starten."

#: src/omega_serv/interfaces/cli/main.py:2096
msgid "Affiche la configuration chargée, en JSON."
msgstr "Toont de geladen configuratie, in JSON."

#: src/omega_serv/interfaces/cli/main.py:2097
msgid "Active TLS dans la configuration."
msgstr "Schakelt TLS in de configuratie in."

#: src/omega_serv/interfaces/cli/main.py:2099
msgid "Certificat à utiliser (sinon celui déjà configuré)."
msgstr "Te gebruiken certificaat (anders het al geconfigureerde)."

#: src/omega_serv/interfaces/cli/main.py:2101
msgid "Clé privée à utiliser (sinon celle déjà configurée)."
msgstr "Te gebruiken privésleutel (anders de al geconfigureerde)."

#: src/omega_serv/interfaces/cli/main.py:2103
msgid "direct : omega-serv chiffre lui-même ; behind_proxy : derrière un reverse proxy (défaut : direct)."
msgstr "direct: omega-serv versleutelt zelf; behind_proxy: achter een reverse proxy (standaard: direct)."

#: src/omega_serv/interfaces/cli/main.py:2105
msgid "Désactive TLS dans la configuration."
msgstr "Schakelt TLS in de configuratie uit."

#: src/omega_serv/interfaces/cli/main.py:2108
msgid "Crée une sauvegarde : la configuration toujours, le reste selon les options --include-*."
msgstr "Maakt een back-up: altijd de configuratie, de rest volgens de opties --include-*."

#: src/omega_serv/interfaces/cli/main.py:2109
msgid "Ajoute les règles et listes du WAF."
msgstr "Voegt de regels en lijsten van de WAF toe."

#: src/omega_serv/interfaces/cli/main.py:2111
msgid "Ajoute les utilisateurs et les zones protégées (secrets : demande --confirm-secrets)."
msgstr "Voegt de gebruikers en beschermde zones toe (geheimen: vereist --confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:2113
msgid "Ajoute les certificats et les clés TLS (secrets : demande --confirm-secrets)."
msgstr "Voegt de TLS-certificaten en -sleutels toe (geheimen: vereist --confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:2115
msgid "Ajoute la base Active Defense."
msgstr "Voegt de database van Active Defense toe."

#: src/omega_serv/interfaces/cli/main.py:2117
msgid "Ajoute les pages d'erreur personnalisées."
msgstr "Voegt de aangepaste foutpagina's toe."

#: src/omega_serv/interfaces/cli/main.py:2119
msgid "Ajoute les préférences de l'interface."
msgstr "Voegt de voorkeuren van de interface toe."

#: src/omega_serv/interfaces/cli/main.py:2121
msgid "Ajoute la bibliothèque des journaux."
msgstr "Voegt de logbibliotheek toe."

#: src/omega_serv/interfaces/cli/main.py:2122
msgid "Ajoute la base RIPOSTE."
msgstr "Voegt de database van RIPOSTE toe."

#: src/omega_serv/interfaces/cli/main.py:2124
msgid "Ajoute le contenu du site (webroot) ; jamais compris dans --all, peut être long."
msgstr "Voegt de site-inhoud (webroot) toe; nooit inbegrepen in --all, kan lang duren."

#: src/omega_serv/interfaces/cli/main.py:2126
msgid "Ajoute les données des zones personnalisées (cible des alias, dossiers du listing, scripts FastCGI) ; jamais compris dans --all."
msgstr "Voegt de gegevens van de eigen zones toe (aliasdoelen, listingmappen, FastCGI-scripts); nooit inbegrepen in --all."

#: src/omega_serv/interfaces/cli/main.py:2129
msgid "Ajoute les rapports d'export (dossier des exports) ; jamais compris dans --all."
msgstr "Voegt de exportrapporten toe (exportmap); nooit inbegrepen in --all."

#: src/omega_serv/interfaces/cli/main.py:2131
msgid "Tout sauvegarder : toutes les options --include-* (secrets compris : demande --confirm-secrets)."
msgstr "Alles back-uppen: alle opties --include-* (geheimen inbegrepen: vereist --confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:2133
msgid "Confirme l'ajout de secrets non chiffrés (hash de mots de passe, clés privées)."
msgstr "Bevestigt het toevoegen van onversleutelde geheimen (wachtwoord-hashes, privésleutels)."

