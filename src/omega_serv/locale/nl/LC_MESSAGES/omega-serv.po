#: src/omega_serv/interfaces/cli/main.py:2195
#: src/omega_serv/interfaces/cli/main.py:2196
#: src/omega_serv/interfaces/cli/main.py:2212
#: src/omega_serv/interfaces/cli/main.py:2325
#: src/omega_serv/interfaces/cli/main.py:2327
