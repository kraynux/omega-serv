#: src/omega_serv/interfaces/tui/screens/export_log_archives_screen.py:43
msgid "Thème d'export HTML"
msgstr "Thema van de HTML-export"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "Kleurenpalet voor de HTML-export."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:438
msgid "5 thèmes disponibles."
msgstr "5 beschikbare thema's."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:439
msgid "Utilisé au clic sur Exporter HTML."
msgstr "Gebruikt bij klikken op HTML exporteren."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/logs.py:282
#: src/omega_serv/interfaces/tui/guide/content/logs.py:440
msgid "Aucun effet sur le serveur."
msgstr "Geen effect op de server."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "Vernieuwen / JSON exporteren / HTML exporteren"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "Start de scan opnieuw of exporteert het resultaat."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:445
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:222
msgid "Aucune saisie supplémentaire."
msgstr "Geen extra invoer."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr "Vernieuwen start de scan opnieuw; de exports schrijven een bestand met tijdstempel."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid "Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "Geen effect op de server of de configuratie (alleen-lezen + export)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "Alleen raadplegen/exporteren."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "Detail van een capaciteit"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "Capaciteitenregister -> klik op een regel"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid "Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : statut, raison, détails techniques, date du dernier scan."
msgstr "Volledig detail van een al gescande capaciteit (nooit een nieuwe scan): status, reden, technische details, datum van de laatste scan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:190
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:301
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:456
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:171
msgid "Purement consultatif."
msgstr "Alleen raadplegen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "Start -> Profielen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid "Liste et décrit les 4 profils de base preconfigures (minimal/standard/hardened/development)."
msgstr "Toont en beschrijft de 4 vooraf geconfigureerde basisprofielen (minimal/standard/hardened/development)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:49
#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:45
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:39
msgid "Appliquer"
msgstr "Toepassen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "Opent het bevestigingsscherm voor het toepassen van het geselecteerde profiel."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Sélectionner un profil active ce bouton."
msgstr "Het selecteren van een profiel activeert deze knop."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Ouvre ApplyProfileScreen."
msgstr "Opent ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Aucun effet ici - voir la fiche d'ApplyProfileScreen."
msgstr "Hier geen effect - zie de kaart van ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:56
msgid "Purement consultatif - aucune modification depuis cet écran lui-même."
msgstr "Alleen raadplegen - geen wijziging vanuit dit scherm zelf."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "Een profiel toepassen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Profils -> Appliquer"
msgstr "Profielen -> Toepassen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid "Affiche TOUJOURS la différence complète avant toute confirmation, puis écrase la configuration active avec le profil choisi."
msgstr "Toont ALTIJD het volledige verschil vóór elke bevestiging en overschrijft daarna de actieve configuratie met het gekozen profiel."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Confirme et écrit le profil choisi."
msgstr "Bevestigt en schrijft het gekozen profiel."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid "Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "De volledige diff wordt hierboven al getoond - controleer die vóór het klikken."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid "Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr "Overschrijft config/omega-serve.json met de uit het profiel samengestelde configuratie."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:71
msgid "Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire ; sinon un simple rechargement suffit (automatique si un service actif existe)."
msgstr "Een profiel kan ELKE instelling in één keer wijzigen. Als bind/port/listen_backlog/TLS wijzigen, is een VOLLEDIGE HERSTART nodig; anders volstaat een eenvoudige herlading (automatisch als er een actieve dienst is)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:77
msgid "Des conflits ou erreurs de validation bloquants demandent une confirmation supplémentaire explicite pour forcer quand même."
msgstr "Blokkerende conflicten of validatiefouten vragen om een extra uitdrukkelijke bevestiging om toch door te zetten."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid "Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste de la configuration active est conservé tel quel."
msgstr "Een profiel wijzigt ALLEEN de velden die het expliciet opgeeft - de rest van de actieve configuratie blijft ongewijzigd."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Accueil -> Audit de sécurité"
msgstr "Start -> Beveiligingsaudit"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...) - mêmes règles que l'audit CLI."
msgstr "Adviserende controles (dienst, logrotatie, WAF-modus...) - dezelfde regels als de CLI-audit."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:52
msgid "Auditer"
msgstr "Auditen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:91
msgid "Relance explicitement l'audit."
msgstr "Start de audit uitdrukkelijk opnieuw."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:92
msgid "Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "Geen invoer - bij het openen van het scherm wordt al automatisch een eerste audit uitgevoerd."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "Leest de configuratie opnieuw en herberekent alle auditregels."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:221
msgid "Aucun effet sur le serveur (lecture seule) - notifie explicitement le résultat sur un clic explicite."
msgstr "Geen effect op de server (alleen-lezen) - meldt het resultaat uitdrukkelijk na een uitdrukkelijke klik."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "Alleen raadplegen - wijzigt nooit iets."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Accueil -> Sauvegarde de configuration"
msgstr "Start -> Configuratieback-up"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:104
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration - le fichier de configuration est toujours inclus, jamais chiffre par défaut."
msgstr "Volledige back-ups van de configuratie maken, weergeven, herstellen of verwijderen - het configuratiebestand is altijd inbegrepen, standaard nooit versleuteld."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:107
msgid "Inclure les règles WAF"
msgstr "WAF-regels opnemen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "Voegt de WAF-regels en de blokkeerlijst toe aan de back-up."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
#: src/omega_serv/interfaces/tui/guide/content/divers.py:130
msgid "Case à cocher."
msgstr "Selectievakje."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:110
#: src/omega_serv/interfaces/tui/guide/content/divers.py:117
#: src/omega_serv/interfaces/tui/guide/content/divers.py:124
#: src/omega_serv/interfaces/tui/guide/content/divers.py:131
msgid "Pris en compte à la création."
msgstr "Meegenomen bij het aanmaken."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:111
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "Geen direct effect - alleen de inhoud van de gemaakte back-up."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:114
msgid "Inclure les zones d'authentification"
msgstr "Authenticatiezones opnemen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:115
msgid "Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la sauvegarde."
