msgid "Confirmer : bind public + certificat auto-signé"
msgstr "Confirmar: bind público + certificado autofirmado"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:142
msgid ""
"Porte de confirmation explicite requise pour continuer si le serveur écoute "
"publiquement avec un certificat auto-signé (jamais reconnu par les "
"navigateurs)."
msgstr ""
"Puerta de confirmación explícita necesaria para continuar si el servidor "
"escucha públicamente con un certificado autofirmado (nunca reconocido por "
"los navegadores)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:145
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:155
msgid "À cocher uniquement si cette combinaison est réellement voulue."
msgstr "Marcar solo si esta combinación es realmente la deseada."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:146
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:156
msgid "Pris en compte au prochain clic sur Vérifier."
msgstr "Se tiene en cuenta en el próximo clic en Comprobar."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:147
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:157
msgid ""
"Sans cette confirmation, le bouton Suivant reste désactivé si la situation "
"s'applique."
msgstr ""
"Sin esta confirmación, el botón Siguiente sigue desactivado si se da la "
"situación."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:150
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:37
msgid "Confirmer : authentification sans TLS"
msgstr "Confirmar: autenticación sin TLS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:152
msgid ""
"Porte de confirmation explicite requise pour continuer si l'authentification"
" est active sans TLS (identifiants transmis en clair)."
msgstr ""
"Puerta de confirmación explícita necesaria para continuar si la "
"autenticación está activa sin TLS (credenciales transmitidas en claro)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:160
msgid ""
"Rien n'est encore écrit sur disque à cette étape - seulement des "
"vérifications."
msgstr ""
"En este paso todavía no se escribe nada en disco - solo comprobaciones."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:165
msgid "Assistant premier lancement - 7/8 Résumé"
msgstr "Asistente de primer inicio - 7/8 Resumen"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:166
msgid "Assistant premier lancement -> étape 7/8"
msgstr "Asistente de primer inicio -> paso 7/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:168
msgid ""
"Affiche la différence complète entre les valeurs par défaut et la "
"configuration composée par l'assistant, puis écrit réellement le fichier de "
"configuration."
msgstr ""
"Muestra la diferencia completa entre los valores por defecto y la "
"configuración compuesta por el asistente, y luego escribe realmente el "
"archivo de configuración."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:173
#: src/omega_serv/interfaces/tui/screens/wizard_summary_screen.py:40
msgid "Écrire la configuration"
msgstr "Escribir la configuración"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:174
msgid "Confirme et écrit la configuration composée."
msgstr "Confirma y escribe la configuración compuesta."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:175
msgid "À vérifier attentivement le résumé affiché avant de cliquer."
msgstr "Revisar atentamente el resumen mostrado antes de hacer clic."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:176
msgid ""
"Écrit config/omega-serve.json (une sauvegarde de l'ancien fichier est faite "
"automatiquement s'il existait)."
msgstr ""
"Escribe config/omega-serve.json (se hace automáticamente una copia del "
"archivo anterior si existía)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:177
msgid ""
"C'EST LA PREMIÈRE ÉCRITURE RÉELLE de tout le parcours - ouvre ensuite "
"l'étape 8/8."
msgstr ""
"ES LA PRIMERA ESCRITURA REAL de todo el recorrido - abre luego el paso 8/8."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:180
msgid ""
"Écrase config/omega-serve.json (avec sauvegarde automatique du fichier "
"précédent s'il existait)."
msgstr ""
"Sobrescribe config/omega-serve.json (con copia automática del archivo "
"anterior si existía)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:185
msgid "Assistant premier lancement - 8/8 Service"
msgstr "Asistente de primer inicio - 8/8 Servicio"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:186
msgid "Assistant premier lancement -> étape 8/8"
msgstr "Asistente de primer inicio -> paso 8/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:187
msgid ""
"La configuration est écrite - propose de lancer le serveur, de l'installer "
"comme service, ou de terminer."
msgstr ""
"La configuración está escrita - propone iniciar el servidor, instalarlo como"
" servicio, o terminar."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:190
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:59
msgid "Lancer maintenant"
msgstr "Iniciar ahora"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:191
msgid "Lance réellement le serveur au premier plan, tout de suite."
msgstr "Inicia realmente el servidor en primer plano, enseguida."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:192
msgid "Pour un test immédiat sans installer de service système."
msgstr "Para una prueba inmediata sin instalar un servicio del sistema."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:193
msgid ""
"Rend la main au terminal réel et bloque jusqu'à Ctrl+C (ou arrêt du "
"service)."
msgstr ""
"Devuelve el control al terminal real y bloquea hasta Ctrl+C (o la detención "
"del servicio)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:194
msgid ""
"Le serveur écoute réellement le temps de cette action - revient à l'accueil "
"à l'arrêt."
msgstr ""
"El servidor escucha realmente mientras dura esta acción - vuelve al inicio "
"al detenerse."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:197
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:61
msgid "Installer le service"
msgstr "Instalar el servicio"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:198
msgid ""
"Ouvre l'écran SERVICE pour installer une unité systemd (démarrage "
"automatique)."
msgstr ""
"Abre la pantalla SERVICE para instalar una unidad systemd (arranque "
"automático)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:199
msgid "Pour un usage durable (le serveur redémarre avec la machine)."
msgstr "Para un uso duradero (el servidor se reinicia con la máquina)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:200
msgid "Ouvre l'écran SERVICE."
msgstr "Abre la pantalla SERVICE."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:201
msgid "Voir la fiche SERVICE - une authentification (sudo) sera demandée."
msgstr "Ver la ficha SERVICE - se pedirá una autenticación (sudo)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:204
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:63
msgid "Terminer"
msgstr "Terminar"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:205
msgid "Quitte l'assistant sans rien lancer."
msgstr "Sale del asistente sin lanzar nada."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:206
msgid "À choisir si vous comptez lancer le serveur plus tard manuellement."
msgstr "Elegir si piensa iniciar el servidor más tarde manualmente."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:207
msgid "Revient à l'accueil."
msgstr "Vuelve al inicio."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:208
msgid ""
"Le serveur ne tourne pas - `omega-serv.sh serve` (CLI) reste à lancer "
"manuellement."
msgstr ""
"El servidor no está en marcha - `omega-serv.sh serve` (CLI) queda por lanzar"
" manualmente."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:211
msgid ""
"La configuration est déjà écrite depuis l'étape précédente - cet écran ne "
"fait que décider comment démarrer."
msgstr ""
"La configuración ya está escrita desde el paso anterior - esta pantalla solo"
" decide cómo arrancar."

