"Tapez le mot recherche tel quel. Détecte ce mot dans les données envoyées "
"par un formulaire (méthode POST)."
msgstr ""
"Escriba la palabra buscada tal cual. Detecta esa palabra en los datos "
"enviados por un formulario (método POST)."

#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:70
msgid ""
"Tapez le nom de l'outil recherche tel quel. Exemple : 'sqlmap' - détecte les"
" requêtes envoyées par cet outil."
msgstr ""
"Escriba el nombre de la herramienta buscada tal cual. Ejemplo: 'sqlmap' - "
"detecta las peticiones enviadas por esa herramienta."

#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:74
