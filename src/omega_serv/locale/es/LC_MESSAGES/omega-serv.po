msgid "Accueil -> Configuration détaillée -> Vérifier la configuration"
msgstr "Inicio -> Configuración detallada -> Comprobar la configuración"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:212
msgid "Vérifie la configuration en deux couches : structurelle (déjà vérifiée au chargement) puis environnement réel (fichiers présents, permissions...)."
msgstr "Comprueba la configuración en dos capas: estructural (ya comprobada al cargar) y luego entorno real (archivos presentes, permisos...)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:217
#: src/omega_serv/interfaces/tui/screens/config_check_screen.py:43
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:40
msgid "Vérifier"
msgstr "Comprobar"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:218
msgid "Relance explicitement la vérification."
msgstr "Vuelve a lanzar explícitamente la comprobación."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:219
msgid "Aucune saisie - une première vérification a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "Ninguna entrada - ya se realiza una primera comprobación automáticamente al abrir la pantalla."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:220
msgid "Relit la configuration et l'environnement réel."
msgstr "Relee la configuración y el entorno real."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:45
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:53
msgid "FastCGI / PHP-FPM"
msgstr "FastCGI / PHP-FPM"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:11
msgid "Accueil -> Configuration détaillée -> FastCGI / PHP-FPM"
msgstr "Inicio -> Configuración detallada -> FastCGI / PHP-FPM"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:13
msgid "Un seul enregistrement (jamais une liste) : proxy vers un serveur PHP-FPM pour exécuter du PHP sous un préfixe d'URL donné."
msgstr "Un solo registro (nunca una lista): proxy hacia un servidor PHP-FPM para ejecutar PHP bajo un prefijo de URL dado."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:18
msgid "Préfixe URL (url_prefix)"
msgstr "Prefijo URL (url_prefix)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:19
msgid "Le préfixe d'URL sous lequel les requêtes sont relayées vers PHP-FPM."
msgstr "El prefijo de URL bajo el que las peticiones se reenvían a PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:20
msgid "Doit commencer par '/'. Valeur par défaut : /app/."
msgstr "Debe empezar por '/'. Valor por defecto: /app/."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:21
msgid "Enregistre au clic sur Enregistrer, après validation structurelle."
msgstr "Guarda al hacer clic en Guardar, tras la validación estructural."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:23
msgid "Si l'option fastcgi est déjà activé : rechargement suffit (automatique si un service actif existe). Sinon, sa PREMIÈRE activation exige un redémarrage complet."
msgstr "Si la opción fastcgi ya está activada: basta con una recarga (automática si existe un servicio activo). Si no, su PRIMERA activación exige un reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:28
msgid "Racine d'exécution (script_root)"
msgstr "Raíz de ejecución (script_root)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:29
msgid "Répertoire, relatif au projet, contenant les scripts PHP exécutables."
msgstr "Directorio, relativo al proyecto, que contiene los scripts PHP ejecutables."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:30
msgid "Chemin relatif - ne peut jamais être à l'intérieur du webroot (vérifié structurellement)."
msgstr "Ruta relativa - nunca puede estar dentro del webroot (comprobado estructuralmente)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:31
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:38
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:45
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:52
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:59
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:69
msgid "Enregistre avec le reste des champs."
msgstr "Guarda con el resto de los campos."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:32
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:39
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:46
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:53
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:60
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:70
msgid "Même réaction que url_prefix."
msgstr "Misma reacción que url_prefix."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:35
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:36
msgid "Socket PHP-FPM (socket_path)"
msgstr "Socket PHP-FPM (socket_path)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:36
msgid "Chemin du socket Unix utilisé pour communiquer avec PHP-FPM."
msgstr "Ruta del socket Unix usado para comunicarse con PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:37
msgid "Chemin relatif. Valeur par défaut : var/run/php-fpm.sock."
msgstr "Ruta relativa. Valor por defecto: var/run/php-fpm.sock."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:43
msgid "Délais réseau appliqués à la communication avec PHP-FPM."
msgstr "Tiempos de red aplicados a la comunicación con PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:44
msgid "Nombres en secondes. Valeurs par défaut : 5 (connexion), 30 (lecture)."
msgstr "Números en segundos. Valores por defecto: 5 (conexión), 30 (lectura)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:49
msgid "Extensions autorisées"
msgstr "Extensiones permitidas"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:50
msgid "Extensions de fichiers exécutées via PHP-FPM."
msgstr "Extensiones de archivo ejecutadas mediante PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:51
msgid "Liste séparée par des virgules. Valeur par défaut : .php."
msgstr "Lista separada por comas. Valor por defecto: .php."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:56
msgid "Fichiers d'index"
msgstr "Archivos de índice"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:57
msgid "Fichiers cherches quand une URL sous ce préfixe pointe vers un répertoire."
msgstr "Archivos buscados cuando una URL bajo este prefijo apunta a un directorio."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:58
msgid "Liste séparée par des virgules. Valeur par défaut : index.php."
msgstr "Lista separada por comas. Valor por defecto: index.php."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:63
msgid "Liste blanche de scripts"
msgstr "Lista blanca de scripts"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:65
msgid "Restreint les scripts réellement exécutables (chemins relatifs à script_root) - vide signifie 'tout fichier avec une extension autorisée sous script_root reste exécutable'."
msgstr "Restringe los scripts realmente ejecutables (rutas relativas a script_root) - vacío significa 'cualquier archivo con una extensión permitida bajo script_root sigue siendo ejecutable'."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:68
msgid "Liste séparée par des virgules, ex: index.php, api/router.php. Vide par défaut."
msgstr "Lista separada por comas, ej.: index.php, api/router.php. Vacío por defecto."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:74
msgid "La PREMIÈRE activation de l'option fastcgi (écran Options) exige un REDÉMARRAGE COMPLET (le client FastCGI n'est construit qu'au démarrage). Une fois déjà activé, modifier ces réglages ici ne demande plus qu'un simple rechargement."
msgstr "La PRIMERA activación de la opción fastcgi (pantalla Opciones) exige un REINICIO COMPLETO (el cliente FastCGI solo se construye al arrancar). Una vez activada, modificar estos ajustes aquí solo requiere una simple recarga."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:80
msgid "script_root ne peut structurellement jamais se trouver à l'intérieur du webroot - bloqué avant même l'enregistrement, pas seulement par 'Vérifier la configuration'."
msgstr "Estructuralmente, script_root nunca puede estar dentro del webroot - bloqueado incluso antes de guardar, no solo por 'Comprobar la configuración'."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:88
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:47
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:55
msgid "Authentification"
msgstr "Autenticación"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:89
msgid "Accueil -> Configuration détaillée -> Authentification"
msgstr "Inicio -> Configuración detallada -> Autenticación"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:91
msgid "Gestion des utilisateurs et des zones protégées par authentification HTTP. Les identifiants et zones sont stockés dans des fichiers SÉPARÉS (users.json/zones.json), jamais dans config/omega-serve.json."
msgstr "Gestión de los usuarios y de las zonas protegidas por autenticación HTTP. Las credenciales y las zonas se guardan en archivos SEPARADOS (users.json/zones.json), nunca en config/omega-serve.json."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:97
msgid "Table Utilisateurs"
msgstr "Tabla Usuarios"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:99
