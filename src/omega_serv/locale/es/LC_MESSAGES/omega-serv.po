#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:217
msgid "Aucun effet sans rechargement du service."
msgstr "Ningún efecto sin recarga del servicio."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:418
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:80
msgid "Extensions"
msgstr "Extensiones"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:420
msgid ""
"Restreint la règle aux chemins se terminant par l'une de ces extensions - "
"vide signifie 'toutes', la règle s'applique alors à tout chemin sous ce "
"préfixe."
msgstr ""
"Restringe la regla a las rutas que terminan con una de estas extensiones - "
"vacío significa 'todas', la regla se aplica entonces a cualquier ruta bajo "
"este prefijo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:423
msgid ""
"Liste séparée par des virgules, ex: .key, .pem. Vide par défaut (toutes)."
msgstr "Lista separada por comas, ej.: .key, .pem. Vacío por defecto (todas)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:429
msgid ""
"L'option access_control doit être activée (écran Options) pour que ces "
"règles soient réellement appliquées. Toutes les modifications se rechargent "
"à chaud."
msgstr ""
"La opción access_control debe estar activada (pantalla Opciones) para que "
"estas reglas se apliquen realmente. Todos los cambios se recargan en "
"caliente."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:434
msgid ""
"Le plus long préfixe correspondant gagne : une règle 'allow' plus spécifique"
" lève le 'deny' d'un préfixe parent (ex: deny /private/, allow "
"/private/.assets/). Une règle 'allow' explicite lève aussi les règles "
"génériques dotfiles/motifs de l'écran Sécurité générique sur ce chemin "
"précis."
msgstr ""
"Gana el prefijo coincidente más largo: una regla 'allow' más específica "
"levanta el 'deny' de un prefijo padre (ej.: deny /private/, allow "
"/private/.assets/). Una regla 'allow' explícita levanta también las reglas "
"genéricas de dotfiles/patrones de la pantalla Seguridad genérica en esa ruta"
" concreta."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:440
msgid ""
"Pour bloquer une extension sensible PARTOUT sauf dans une zone : une règle "
"deny sur '/' avec l'extension visée, puis une règle allow (sans extension) "
"sur le préfixe à excepter - le préfixe le plus spécifique l'emporte."
msgstr ""
"Para bloquear una extensión sensible EN TODAS PARTES salvo en una zona: una "
"regla deny en '/' con la extensión en cuestión, y luego una regla allow (sin"
" extensión) en el prefijo a exceptuar - el prefijo más específico prevalece."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:12
msgid "Accueil -> Registre des capacités"
msgstr "Inicio -> Registro de capacidades"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:13
msgid ""
"Scan complet de l'environnement (port libre, openssl présent, PHP-FPM si "
"FastCGI actif...), avec export."
msgstr ""
"Análisis completo del entorno (puerto libre, openssl presente, PHP-FPM si "
"FastCGI está activo...), con exportación."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:16
#: src/omega_serv/interfaces/tui/guide/content/logs.py:521
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1061
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:85
#: src/omega_serv/interfaces/tui/screens/capabilities_screen.py:53
