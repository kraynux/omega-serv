msgid ""
"Affiche la fiche de cette instance (fonctions actives, service, journaux "
"partagés), pour omega-connect."
msgstr ""
"Muestra la ficha de esta instancia (funciones activas, servicio, registros "
"compartidos), para omega-connect."

#: src/omega_serv/interfaces/cli/main.py:2529
msgid "Format de sortie : json seulement (non traduit, versionné)."
msgstr "Formato de salida: solo json (sin traducir, versionado)."

#: src/omega_serv/interfaces/cli/main.py:2532
msgid ""
"Donne (ou retire) au service de cette instance le groupe omega-synchro, pour"
" qu'il lise la zone neutre : complément systemd <service>.service.d/omega-"
"synchro.conf, l'unité n'est pas touchée. Demandé par omega-connect ; pris en"
" compte au prochain redémarrage du service."
msgstr ""
"Asigna (o quita) al servicio de esta instancia el grupo omega-synchro, para "
"que lea la zona neutra: complemento systemd <service>.service.d/omega-"
"synchro.conf, la unidad no se toca. Lo solicita omega-connect; se aplica en "
"el próximo reinicio del servicio."

#: src/omega_serv/interfaces/cli/main.py:2535
msgid "ACTION"
msgstr "ACCIÓN"

#: src/omega_serv/interfaces/cli/main.py:2536
