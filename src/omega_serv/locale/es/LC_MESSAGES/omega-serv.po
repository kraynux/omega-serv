#: src/omega_serv/interfaces/cli/main.py:2505
msgid ""
"Audite l'installation : configuration, droits, TLS, service. Code 1 si "
"critique, 2 si élevé, 3 si la configuration est illisible."
msgstr ""
"Audita la instalación: configuración, permisos, TLS, servicio. Código 1 si "
"crítico, 2 si alto, 3 si la configuración es ilegible."

#: src/omega_serv/interfaces/cli/main.py:2508
msgid "Format du rapport (défaut : text)."
msgstr "Formato del informe (por defecto: text)."

#: src/omega_serv/interfaces/cli/main.py:2510
msgid "N'affiche que ce niveau et les plus graves (défaut : info)."
msgstr "Solo muestra este nivel y los más graves (por defecto: info)."

#: src/omega_serv/interfaces/cli/main.py:2520
msgid ""
"Liens avec les autres outils omega (omega-connect) : jeton d'installation et"
" fiche de l'instance."
msgstr ""
"Enlaces con las demás herramientas omega (omega-connect): token de "
"instalación y ficha de la instancia."

#: src/omega_serv/interfaces/cli/main.py:2523
msgid ""
"Crée ou met à jour le jeton d'installation (var/omega-jeton.json) et "
"l'affiche en JSON."
msgstr ""
"Crea o actualiza el token de instalación (var/omega-jeton.json) y lo muestra"
" en JSON."

