#: src/omega_serv/interfaces/tui/guide/content/accueil.py:105
msgid ""
"Cet écran ne modifie jamais la configuration lui-même - uniquement de la "
"navigation."
msgstr ""
"Esta pantalla nunca modifica la configuración por sí misma - solo "
"navegación."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:108
msgid ""
"Pour quitter : Échap, q ou Ctrl+Q depuis cet écran, avec confirmation (il "
"n'y a plus de bouton Quitter dans le menu). Ailleurs, Échap revient "
"simplement en arrière."
msgstr ""
"Para salir: Esc, q o Ctrl+Q desde esta pantalla, con confirmación (ya no hay"
" botón Salir en el menú). En otras pantallas, Esc simplemente vuelve atrás."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:112
msgid ""
"Dans tous les écrans à liste ou à long formulaire, Retour et les boutons "
"principaux restent dans une barre fixe en bas, toujours visible : inutile de"
" dérouler la liste pour revenir ou enregistrer."
msgstr ""
"En todas las pantallas con lista o formulario largo, Volver y los botones "
"principales se quedan en una barra fija abajo, siempre visible: no hace "
"falta desplazar la lista para volver o guardar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:12
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
msgid "Configuration détaillée (menu)"
msgstr "Configuración detallada (menú)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:13
msgid "Accueil -> Configuration détaillée"
msgstr "Inicio -> Configuración detallada"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:15
msgid ""
"Sous-menu regroupant tous les écrans de configuration du serveur et des "
"options superposables, plus deux raccourcis (Voir options actives, Vérifier "
"la configuration)."
msgstr ""
"Submenú que agrupa todas las pantallas de configuración del servidor y de "
"las opciones superponibles, más dos atajos (Ver opciones activas, Comprobar "
"la configuración)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:18
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:23
#: src/omega_serv/interfaces/tui/guide/content/tls.py:15
msgid "Aucune - purement navigation."
msgstr "Ninguna - solo navegación."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "Configuración básica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "Inicio -> Configuración detallada -> Configuración básica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid ""
"Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur "
"annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier "
"explicite, moteur HTTP (Python ou natif C++)."
msgstr ""
"Ajustes fundamentales del servidor: dirección de escucha, puerto, nombre de "
"servidor anunciado, archivos de índice buscados en un directorio sin nombre "
"de archivo explícito, motor HTTP (Python o nativo C++)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse d'écoute (bind)"
msgstr "Dirección de escucha (bind)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:34
msgid "Adresse IP sur laquelle le serveur accepte les connexions."
msgstr "Dirección IP en la que el servidor acepta conexiones."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:36
msgid ""
"Une adresse IP valide - '127.0.0.1' (local uniquement) ou '0.0.0.0' (toutes "
"les interfaces réseau). Valeur par défaut : 127.0.0.1."
msgstr ""
"Una dirección IP válida - '127.0.0.1' (solo local) o '0.0.0.0' (todas las "
"interfaces de red). Valor por defecto: 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:39
msgid ""
"Enregistre dans server.bind après validation structurelle de la "
"configuration."
msgstr ""
"Guarda en server.bind tras la validación estructural de la configuración."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:41
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - le socket d'écoute n'est jamais retouché "
"par un simple rechargement. Un bouton 'Redémarrer maintenant' est proposé "
"après l'enregistrement si un service est détecté."
msgstr ""
"Requiere un REINICIO COMPLETO - el socket de escucha nunca se toca con una "
"simple recarga. Se ofrece un botón 'Reiniciar ahora' tras guardar si se "
"detecta un servicio."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:47
msgid "Port (port)"
msgstr "Puerto (port)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:48
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:80
msgid "Port TCP d'écoute."
msgstr "Puerto TCP de escucha."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:50
msgid ""
"Un entier de port valide (1-65535 ; 0 signifie 'port libre choisi par le "
"système', surtout utile pour des tests). Valeur par défaut : 8080."
msgstr ""
"Un entero de puerto válido (1-65535; 0 significa 'puerto libre elegido por "
"el sistema', útil sobre todo para pruebas). Valor por defecto: 8080."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:53
msgid "Enregistre dans server.port après validation."
msgstr "Guarda en server.port tras la validación."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:54
msgid "Nécessite un REDÉMARRAGE COMPLET, même raison que l'adresse d'écoute."
msgstr ""
"Requiere un REINICIO COMPLETO, por la misma razón que la dirección de "
"escucha."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:57
msgid "Nom de serveur (server_name)"
msgstr "Nombre de servidor (server_name)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:58
msgid "Nom de serveur utilisé en interne (transmis notamment à FastCGI)."
msgstr ""
"Nombre de servidor usado internamente (transmitido en particular a FastCGI)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:59
msgid "Chaîne libre, optionnelle. Vide par défaut."
msgstr "Texto libre, opcional. Vacío por defecto."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:60
msgid "Enregistre dans server.server_name."
msgstr "Guarda en server.server_name."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:62
msgid ""
"Se recharge à chaud (pas de redémarrage complet nécessaire) - mais reste "
"sans effet tant qu'un rechargement du service en cours n'a pas eu lieu "
"(automatique si un service actif existe, sinon à faire manuellement depuis "
"l'écran SERVICE)."
msgstr ""
"Se recarga en caliente (no hace falta un reinicio completo) - pero no tiene "
"efecto mientras no se recargue el servicio en curso (automático si existe un"
" servicio activo; si no, hay que hacerlo manualmente desde la pantalla "
"SERVICE)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:68
msgid "Fichiers d'index (index_files)"
msgstr "Archivos de índice (index_files)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:70
msgid ""
"Noms de fichiers cherches, dans l'ordre, quand une URL pointe vers un "
"répertoire sans fichier explicite."
msgstr ""
"Nombres de archivo buscados, en orden, cuando una URL apunta a un directorio"
" sin archivo explícito."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:73
msgid "Liste séparée par des virgules. Valeur par défaut : index.html."
msgstr "Lista separada por comas. Valor por defecto: index.html."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:74
msgid "Enregistre dans server.index_files."
msgstr "Guarda en server.index_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:75
msgid ""
"Même réaction que le nom de serveur - rechargement nécessaire, jamais un "
"redémarrage complet."
msgstr ""
"Misma reacción que el nombre de servidor - recarga necesaria, nunca un "
"reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:78
msgid "Moteur HTTP (engine)"
msgstr "Motor HTTP (engine)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:80
msgid ""
"Programme qui traite les requêtes HTTP. Python (par défaut) : l'interpréteur"
" Python traite tout. Natif C++ (omega-http-core) : un programme compilé, qui"
" utilise tous les cœurs, traite lui-même le contenu statique, les "
"redirections, le cache et TLS ; il cherche lui-même les règles du WAF et "
"sert seul une requête sur laquelle aucune ne correspond ; il confie au "
"processus Python les autres contrôles de sécurité (requête suspecte ou "
"douteuse, Active Defense, authentification), le listing, les pages internes "
"et les routes applicatives (FastCGI, envoi de fichiers, zones de reverse "
"proxy avec cache) ; il relaie lui-même les autres zones du reverse proxy, "
"WebSocket compris. Dans les deux cas : mêmes réponses, mêmes journaux, même "
"sécurité. Ce que le choix change, mesuré : FAQ, « Moteur Python ou natif : "
"qu'est-ce que ça change concrètement ? »."
msgstr ""
"Programa que procesa las peticiones HTTP. Python (por defecto): el "
"intérprete de Python procesa todo. Nativo C++ (omega-http-core): un programa"
" compilado, que usa todos los núcleos, procesa él mismo el contenido "
"estático, las redirecciones, la caché y TLS; busca él mismo las reglas del "
"WAF y sirve solo una petición a la que no corresponde ninguna; confía al "
"proceso Python los demás controles de seguridad (petición sospechosa o "
"dudosa, Active Defense, autenticación), el listado, las páginas internas y "
"las rutas de aplicación (FastCGI, envío de archivos, zonas de reverse proxy "
"con caché); reenvía él mismo las demás zonas del reverse proxy, WebSocket "
"incluido. En ambos casos: mismas respuestas, mismos registros, misma "
"seguridad. Lo que cambia la elección, medido: FAQ, «Motor Python o nativo: "
"¿qué cambia en la práctica?»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:92
msgid ""
"Python ou Natif C++. Le choix natif est GRISÉ tant qu'une cause l'empêche "
"(binaire absent, TLS en mode direct avec une zone de reverse proxy en cache,"
" FastCGI ou envoi de fichiers) : la liste des causes, et comment lever "
"chacune, s'affiche sous le choix. Lever d'abord la cause, puis revenir ici."
msgstr ""
"Python o Nativo C++. La opción nativa aparece ATENUADA mientras algo la "
"impida (binario ausente, TLS en modo directo con una zona de reverse proxy "
"con caché, FastCGI o envío de archivos): la lista de causas, y cómo eliminar"
" cada una, se muestra bajo la opción. Eliminar primero la causa y luego "
"volver aquí."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:97
msgid "Enregistre dans server.engine."
msgstr "Guarda en server.engine."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:99
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - un rechargement qui changerait de moteur "
"est refusé. Le moteur réellement utilisé est affiché dans État & Ressources "
"(section MOTEUR HTTP, avec le tableau des connecteurs)."
msgstr ""
"Requiere un REINICIO COMPLETO - se rechaza una recarga que cambiaría de "
"motor. El motor realmente usado se muestra en Estado y recursos (sección "
"MOTOR HTTP, con la tabla de conectores)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:106
msgid ""
"bind/port et le moteur HTTP exigent toujours un redémarrage complet. "
"server_name/index_files se rechargent à chaud mais nécessitent quand même un"
" rechargement du service déjà lancé pour être pris en compte."
msgstr ""
"bind/port y el motor HTTP siempre exigen un reinicio completo. "
"server_name/index_files se recargan en caliente pero necesitan de todos "
"modos una recarga del servicio ya iniciado para tenerse en cuenta."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:112
msgid ""
"Changer bind/port pendant qu'un service systemd est déjà actif ne prend "
"jamais effet tant qu'un redémarrage complet n'a pas eu lieu - toutes les "
"connexions en cours sont alors coupées, contrairement à un simple "
"rechargement."
msgstr ""
"Cambiar bind/port mientras un servicio systemd ya está activo nunca tiene "
"efecto hasta un reinicio completo - todas las conexiones en curso se cortan "
"entonces, a diferencia de una simple recarga."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:121
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:39
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:47
msgid "Résistance et limites"
msgstr "Resistencia y límites"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:122
msgid "Accueil -> Configuration détaillée -> Résistance et limites"
msgstr "Inicio -> Configuración detallada -> Resistencia y límites"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:124
msgid ""
"Dix réglages numériques anti-abus : bornes de taille/nombre/delai appliquées"
" à chaque connexion et requête."
msgstr ""
"Diez ajustes numéricos antiabuso: límites de tamaño/número/tiempo aplicados "
"a cada conexión y petición."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:129
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:36
msgid "Connexions simultanées max (max_connections)"
msgstr "Conexiones simultáneas máx. (max_connections)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:130
msgid "Nombre maximal de connexions ouvertes en même temps."
msgstr "Número máximo de conexiones abiertas a la vez."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:131
msgid "Entier positif. Valeur par défaut : 256."
msgstr "Entero positivo. Valor por defecto: 256."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:132
msgid "Enregistre dans server.max_connections."
msgstr "Guarda en server.max_connections."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:133
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:265
msgid ""
"Se recharge à chaud (rechargement du service nécessaire, automatique si "
"actif)."
msgstr ""
"Se recarga en caliente (recarga del servicio necesaria, automática si está "
"activo)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:136
msgid "Taille max de requête (max_request_size)"
msgstr "Tamaño máx. de petición (max_request_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:137
msgid "Taille maximale acceptée pour le corps d'une requête, en octets."
msgstr "Tamaño máximo aceptado para el cuerpo de una petición, en bytes."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:138
msgid "Entier positif, en octets. Valeur par défaut : 10 485 760 (10 Mio)."
msgstr "Entero positivo, en bytes. Valor por defecto: 10 485 760 (10 MiB)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:139
msgid "Enregistre dans server.max_request_size."
msgstr "Guarda en server.max_request_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:140
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:150
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:157
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:164
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:171
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:178
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:191
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:211
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:275
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:282
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:304
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:329
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:336
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:343
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:350
msgid "Se recharge à chaud."
msgstr "Se recarga en caliente."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:143
msgid "Taille max des en-têtes (max_header_size)"
msgstr "Tamaño máx. de cabeceras (max_header_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:145
msgid ""
"Taille cumulée maximale des en-têtes HTTP d'une requête, en octets - "
"protection contre les en-têtes surdimensionnés (HTTP smuggling, saturation "
"mémoire)."
msgstr ""
"Tamaño total máximo de las cabeceras HTTP de una petición, en bytes - "
"protección contra cabeceras sobredimensionadas (HTTP smuggling, saturación "
"de memoria)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:148
msgid "Entier positif, en octets. Valeur par défaut : 16 384."
msgstr "Entero positivo, en bytes. Valor por defecto: 16 384."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:149
msgid "Enregistre dans server.max_header_size."
msgstr "Guarda en server.max_header_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:153
msgid "Taille max de la ligne de requête (max_request_line_size)"
msgstr "Tamaño máx. de la línea de petición (max_request_line_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:154
msgid ""
"Taille maximale de la première ligne HTTP (méthode + chemin + version), en "
"octets."
msgstr ""
"Tamaño máximo de la primera línea HTTP (método + ruta + versión), en bytes."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:155
msgid "Entier positif, en octets. Valeur par défaut : 8 192."
msgstr "Entero positivo, en bytes. Valor por defecto: 8 192."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:156
msgid "Enregistre dans server.max_request_line_size."
msgstr "Guarda en server.max_request_line_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:160
msgid "Délai de lecture (read_timeout_seconds)"
msgstr "Tiempo de lectura (read_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:161
msgid ""
"Délai maximal, en secondes, pour recevoir une requête complète avant "
"coupure."
msgstr ""
"Tiempo máximo, en segundos, para recibir una petición completa antes del "
"corte."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:162
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:209
msgid "Entier positif, en secondes. Valeur par défaut : 10."
msgstr "Entero positivo, en segundos. Valor por defecto: 10."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:163
msgid "Enregistre dans server.read_timeout_seconds."
msgstr "Guarda en server.read_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:167
msgid "Délai d'écriture (write_timeout_seconds)"
msgstr "Tiempo de escritura (write_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:168
msgid "Délai maximal, en secondes, pour envoyer la réponse avant coupure."
msgstr "Tiempo máximo, en segundos, para enviar la respuesta antes del corte."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:169
msgid "Entier positif, en secondes. Valeur par défaut : 15."
msgstr "Entero positivo, en segundos. Valor por defecto: 15."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:170
msgid "Enregistre dans server.write_timeout_seconds."
msgstr "Guarda en server.write_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:174
msgid "Délai keep-alive (keepalive_timeout_seconds)"
msgstr "Tiempo keep-alive (keepalive_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:175
msgid ""
"Délai d'inactivité, en secondes, avant fermeture d'une connexion gardée "
"ouverte."
msgstr ""
"Tiempo de inactividad, en segundos, antes de cerrar una conexión mantenida "
"abierta."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:176
msgid "Entier positif, en secondes. Valeur par défaut : 5."
msgstr "Entero positivo, en segundos. Valor por defecto: 5."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:177
msgid "Enregistre dans server.keepalive_timeout_seconds."
msgstr "Guarda en server.keepalive_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:181
msgid "Requêtes max en keep-alive (max_keepalive_requests)"
msgstr "Peticiones máx. en keep-alive (max_keepalive_requests)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:183
msgid ""
"Nombre maximal de requêtes traitées sur une même connexion gardée ouverte. "
"Une fois atteint, la connexion est simplement fermée et le navigateur en "
"ouvre une nouvelle : aucune erreur, aucun bannissement. Sans rapport avec la"
" limite de débit du WAF (Active Sécurité -> Exclusions et débit), qui compte"
" les requêtes par IP toutes connexions confondues."
msgstr ""
"Número máximo de peticiones atendidas en una misma conexión mantenida "
"abierta. Una vez alcanzado, la conexión simplemente se cierra y el navegador"
" abre otra: ningún error, ningún baneo. Sin relación con el límite de tasa "
"del WAF (Seguridad activa -> Exclusiones y límite de tasa), que cuenta las "
"peticiones por IP en todas las conexiones."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:189
msgid "Entier positif. Valeur par défaut : 30."
msgstr "Entero positivo. Valor por defecto: 30."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:190
msgid "Enregistre dans server.max_keepalive_requests."
msgstr "Guarda en server.max_keepalive_requests."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:194
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:44
msgid "File d'attente d'écoute (listen_backlog)"
msgstr "Cola de escucha (listen_backlog)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:196
msgid ""
"Taille de la file d'attente de connexions en attente d'acceptation par le "
"système d'exploitation (paramètre backlog du socket d'écoute)."
msgstr ""
"Tamaño de la cola de conexiones pendientes de aceptación por el sistema "
"operativo (parámetro backlog del socket de escucha)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:199
msgid "Entier positif. Valeur par défaut : 128."
msgstr "Entero positivo. Valor por defecto: 128."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:200
msgid "Enregistre dans server.listen_backlog."
msgstr "Guarda en server.listen_backlog."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:202
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - fixé au moment de la création du socket "
"d'écoute, comme bind/port, jamais retouché par un simple rechargement."
msgstr ""
"Requiere un REINICIO COMPLETO - se fija al crear el socket de escucha, como "
"bind/port, nunca se toca con una simple recarga."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:207
msgid "Délai de grâce à l'arrêt (shutdown_grace_period_seconds)"
msgstr "Periodo de gracia al detener (shutdown_grace_period_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:208
msgid ""
"Délai, en secondes, laissé aux connexions actives pour se terminer lors d'un"
" arrêt."
msgstr ""
"Tiempo, en segundos, que se deja a las conexiones activas para terminar "
"durante una detención."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:210
msgid "Enregistre dans server.shutdown_grace_period_seconds."
msgstr "Guarda en server.shutdown_grace_period_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:214
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:62
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:178
msgid "Nombre de processus (workers)"
msgstr "Número de procesos (workers)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:216
msgid ""
"Avec le moteur Python : nombre de processus serveur qui se partagent le port"
" ; un processus Python n'utilise qu'un cœur, plusieurs servent davantage de "
"requêtes en parallèle. Avec le moteur natif (Configuration de base) : nombre"
" de processus Python qui font les contrôles de sécurité, le natif utilisant "
"déjà tous les cœurs. Les compteurs de sécurité (rate limit, récidive) sont "
"partagés entre processus et restent exacts ; un script magnet garde ses "
"propres compteurs dans chaque processus."
msgstr ""
"Con el motor Python: número de procesos de servidor que comparten el puerto;"
" un proceso Python solo usa un núcleo, varios atienden más peticiones en "
"paralelo. Con el motor nativo (Configuración básica): número de procesos "
"Python que hacen los controles de seguridad, ya que el nativo usa todos los "
"núcleos. Los contadores de seguridad (rate limit, reincidencia) se comparten"
" entre procesos y siguen siendo exactos; un script magnet conserva sus "
"propios contadores en cada proceso."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:224
msgid ""
"Le maximum dépend du moteur et du processeur détecté, et s'affiche sous le "
"champ avec ce qu'augmenter apporte sur cette machine : moteur Python, un "
"processus par cœur physique ; moteur natif, 1, ou 2 à partir de 4 cœurs "
"physiques (un 2e n'aide que si un contrôle de sécurité est actif). Une "
"valeur au-delà du maximum est refusée. Ce que le choix change, mesuré : FAQ,"
" « Combien de processus choisir ? »."
msgstr ""
"El máximo depende del motor y del procesador detectado, y se muestra bajo el"
" campo junto con lo que aporta aumentarlo en esta máquina: motor Python, un "
"proceso por núcleo físico; motor nativo, 1, o 2 a partir de 4 núcleos "
"físicos (un 2.º solo ayuda si hay un control de seguridad activo). Un valor "
"por encima del máximo se rechaza. Lo que cambia la elección, medido: FAQ, "
"«¿Cuántos procesos elegir?»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:230
msgid "Enregistre dans server.workers."
msgstr "Guarda en server.workers."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:232
msgid ""
"Redémarrage complet nécessaire. Si la configuration est recopiée sur une "
"machine plus petite, le serveur se limite au maximum de cette machine et "
"l'écrit dans le journal et dans État & Ressources."
msgstr ""
"Se necesita un reinicio completo. Si la configuración se copia a una máquina"
" más pequeña, el servidor se limita al máximo de esa máquina y lo indica en "
"el registro y en Estado y recursos."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:239
msgid ""
"Neuf champs sur onze se rechargent à chaud (rechargement du service "
"nécessaire, automatique si actif). listen_backlog et le nombre de processus "
"exigent un redémarrage complet."
msgstr ""
"Nueve campos de once se recargan en caliente (recarga del servicio "
"necesaria, automática si está activa). listen_backlog y el número de "
"procesos requieren un reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:244
msgid ""
"Un listen_backlog trop bas sous forte charge fait échouer des connexions "
"entrantes avant même qu'elles atteignent OMEGA-SERV (comportement du système"
" d'exploitation) - ne descendre sous 128 qu'en connaissance de cause."
msgstr ""
"Un listen_backlog demasiado bajo con mucha carga hace fallar conexiones "
"entrantes antes incluso de que lleguen a OMEGA-SERV (comportamiento del "
"sistema operativo) - no bajar de 128 salvo con conocimiento de causa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:253
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:40
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:48
msgid "Sécurité générique"
msgstr "Seguridad genérica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:254
msgid "Accueil -> Configuration détaillée -> Sécurité générique"
msgstr "Inicio -> Configuración detallada -> Seguridad genérica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:256
msgid ""
"Règles de sécurité génériques appliquées à toutes les requêtes : méthodes "
"autorisées, fichiers cachés, en-têtes de sécurité, CSP, HSTS."
msgstr ""
"Reglas de seguridad genéricas aplicadas a todas las peticiones: métodos "
"permitidos, archivos ocultos, cabeceras de seguridad, CSP, HSTS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:261
msgid "Méthodes autorisées"
msgstr "Métodos permitidos"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:262
msgid ""
"Liste blanche des méthodes HTTP acceptées - tout le reste est refusé par "
"défaut."
msgstr ""
"Lista blanca de métodos HTTP aceptados - todo lo demás se rechaza por "
"defecto."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:263
msgid ""
"Liste séparée par des virgules, ex: GET, HEAD. Valeur par défaut : GET, "
"HEAD."
msgstr ""
"Lista separada por comas, ej.: GET, HEAD. Valor por defecto: GET, HEAD."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:264
msgid "Enregistre dans security.allowed_methods."
msgstr "Guarda en security.allowed_methods."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:268
#: src/omega_serv/interfaces/tui/screens/security_screen.py:58
msgid "Refuser les fichiers cachés (oui/non)"
msgstr "Rechazar archivos ocultos (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:270
msgid ""
"Masque tout fichier ou dossier dont un segment de chemin commence par un "
"point (dotfile) - à la fois en accès direct et dans le directory listing."
msgstr ""
"Oculta cualquier archivo o carpeta con un segmento de ruta que empiece por "
"un punto (dotfile) - tanto en acceso directo como en el listado de "
"directorios."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:273
msgid "oui ou non (accepte aussi true/1/o/y). Valeur par défaut : oui."
msgstr "sí o no (acepta también si/true/1/y/oui). Valor por defecto: sí."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:274
msgid "Enregistre dans security.deny_hidden_files."
msgstr "Guarda en security.deny_hidden_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:278
msgid "Mode CSP"
msgstr "Modo CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:279
msgid ""
"Mode d'application de la Content-Security-Policy envoyée dans les réponses."
msgstr ""
"Modo de aplicación de la Content-Security-Policy enviada en las respuestas."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:280
msgid ""
"enforce (bloque) ou report-only (signale sans bloquer). Valeur par défaut : "
"enforce."
msgstr ""
"enforce (bloquea) o report-only (avisa sin bloquear). Valor por defecto: "
"enforce."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:281
msgid "Enregistre dans security.csp_mode."
msgstr "Guarda en security.csp_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:285
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:287
msgid ""
"Isolation cross-origin - 'require-corp'/'credentialless' peuvent bloquer des"
" ressources cross-origin (polices, images, iframes tiers) que ce serveur "
"générique ne connaît pas à l'avance, contrairement à COOP/CORP (toujours "
"actifs, sans ce risque)."
msgstr ""
"Aislamiento cross-origin - 'require-corp'/'credentialless' pueden bloquear "
"recursos cross-origin (fuentes, imágenes, iframes de terceros) que este "
"servidor genérico no conoce de antemano, a diferencia de COOP/CORP (siempre "
"activos, sin ese riesgo)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:293
msgid ""
"unsafe-none (permissif, par défaut partout y compris hardened), require-corp"
" ou credentialless - à activer uniquement en connaissance du contenu "
"réellement servi."
msgstr ""
"unsafe-none (permisivo, por defecto en todas partes incluido hardened), "
"require-corp o credentialless - activar solo conociendo el contenido "
"realmente servido."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:296
msgid "Enregistre dans security.coep_mode."
msgstr "Guarda en security.coep_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:297
msgid ""
"Se recharge à chaud - toujours émis explicitement, même en unsafe-none "
"(jamais un en-tête absent)."
msgstr ""
"Se recarga en caliente - siempre se envía explícitamente, incluso en unsafe-"
"none (nunca una cabecera ausente)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:300
#: src/omega_serv/interfaces/tui/screens/security_screen.py:64
msgid "En-têtes de sécurité actifs (oui/non)"
msgstr "Cabeceras de seguridad activas (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:301
msgid ""
"Active l'envoi des en-têtes de sécurité standard (CSP, X-Content-Type-"
"Options...)."
msgstr ""
"Activa el envío de las cabeceras de seguridad estándar (CSP, X-Content-Type-"
"Options...)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:302
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:341
msgid "oui ou non. Valeur par défaut : oui."
msgstr "sí o no. Valor por defecto: sí."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:303
msgid "Enregistre dans security.security_headers_enabled."
msgstr "Guarda en security.security_headers_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:307
msgid "Zones CSP (Ajouter une zone / Retirer)"
msgstr "Zonas CSP (Añadir una zona / Quitar)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:309
msgid ""
"Exceptions EXPLICITES à la CSP globale, par préfixe de chemin - ex. 'unsafe-"
"inline' uniquement sous /un-dossier/ qui en a réellement besoin, sans jamais"
" relâcher la CSP du reste du site."
msgstr ""
"Excepciones EXPLÍCITAS a la CSP global, por prefijo de ruta - ej. 'unsafe-"
"inline' solo bajo /una-carpeta/ que realmente lo necesita, sin relajar nunca"
" la CSP del resto del sitio."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:314
msgid ""
"Préfixe (ex: /public-widgets/) + politique CSP COMPLÈTE pour ce préfixe "
"(remplace entièrement le défaut pour ces chemins, jamais une fusion de "
"directives)."
msgstr ""
"Prefijo (ej.: /public-widgets/) + política CSP COMPLETA para ese prefijo "
"(sustituye por completo la de por defecto para esas rutas, nunca una fusión "
"de directivas)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:317
msgid ""
"Enregistre immédiatement dans security.csp_zones, sans passer par "
"Enregistrer."
msgstr "Guarda inmediatamente en security.csp_zones, sin pasar por Guardar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:319
msgid ""
"Rechargement automatique immédiat si un service actif existe. Une exception "
"comme 'unsafe-inline' reste TOUJOURS visible dans 'omega-serv audit "
"security' (CSP-001/CSP-002), même délibérée - jamais silencieuse."
msgstr ""
"Recarga automática inmediata si existe un servicio activo. Una excepción "
"como 'unsafe-inline' sigue SIEMPRE visible en 'omega-serv audit security' "
"(CSP-001/CSP-002), aunque sea deliberada - nunca silenciosa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:325
#: src/omega_serv/interfaces/tui/screens/security_screen.py:66
msgid "HSTS actif (oui/non)"
msgstr "HSTS activo (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:326
msgid ""
"Active l'en-tête Strict-Transport-Security (force HTTPS pour les visites "
"futures)."
msgstr ""
"Activa la cabecera Strict-Transport-Security (fuerza HTTPS en las visitas "
"futuras)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:327
msgid ""
"oui ou non. Valeur par défaut : non. N'a de sens que si TLS est réellement "
"actif."
msgstr ""
"sí o no. Valor por defecto: no. Solo tiene sentido si TLS está realmente "
"activo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:328
msgid "Enregistre dans security.hsts_enabled."
msgstr "Guarda en security.hsts_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:332
msgid "HSTS max-age"
msgstr "HSTS max-age"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:333
msgid ""
"Durée, en secondes, pendant laquelle un navigateur retient l'obligation "
"HTTPS."
msgstr ""
"Duración, en segundos, durante la cual un navegador recuerda la obligación "
"de HTTPS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:334
msgid "Entier positif, en secondes. Valeur par défaut : 31 536 000 (un an)."
msgstr "Entero positivo, en segundos. Valor por defecto: 31 536 000 (un año)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:335
msgid "Enregistre dans security.hsts_max_age."
msgstr "Guarda en security.hsts_max_age."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:339
#: src/omega_serv/interfaces/tui/screens/security_screen.py:70
msgid "HSTS includeSubDomains (oui/non)"
msgstr "HSTS includeSubDomains (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:340
msgid "Étend l'obligation HTTPS à tous les sous-domaines."
msgstr "Extiende la obligación de HTTPS a todos los subdominios."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:342
msgid "Enregistre dans security.hsts_include_subdomains."
msgstr "Guarda en security.hsts_include_subdomains."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:346
#: src/omega_serv/interfaces/tui/screens/security_screen.py:72
msgid "HSTS preload (oui/non)"
msgstr "HSTS preload (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:347
msgid ""
"Signale l'éligibilité à la liste de prechargement HSTS des navigateurs."
msgstr ""
"Indica la elegibilidad para la lista de precarga HSTS de los navegadores."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:348
#: src/omega_serv/interfaces/tui/guide/content/routage.py:31
msgid "oui ou non. Valeur par défaut : non."
msgstr "sí o no. Valor por defecto: no."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:349
msgid "Enregistre dans security.hsts_preload."
msgstr "Guarda en security.hsts_preload."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:353
msgid ""
"Tous les champs de cet écran se rechargent à chaud - aucun n'exige de "
"redémarrage complet."
msgstr ""
"Todos los campos de esta pantalla se recargan en caliente - ninguno exige un"
" reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:356
msgid ""
"Activer HSTS sans que TLS soit réellement actif n'a aucun effet utile - le "
"navigateur ignore cet en-tête reçu en HTTP simple."
msgstr ""
"Activar HSTS sin que TLS esté realmente activo no tiene ningún efecto útil -"
" el navegador ignora esta cabecera recibida en HTTP simple."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:364
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:41
msgid "Sécurité générique - Assistant zone CSP"
msgstr "Seguridad genérica - Asistente de zona CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:365
msgid "Sécurité générique -> Ajouter une zone"
msgstr "Seguridad genérica -> Añadir una zona"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:367
msgid ""
"Construit la politique CSP d'une zone directive par directive, chacune pré-"
"remplie avec sa valeur ACTUELLE (la politique globale) - une zone remplace "
"ENTIÈREMENT la politique par défaut pour son préfixe, jamais un simple "
"ajout, d'où le pré-remplissage pour éviter de perdre des directives sans le "
"vouloir."
msgstr ""
"Construye la política CSP de una zona directiva a directiva, cada una "
"rellenada con su valor ACTUAL (la política global) - una zona sustituye POR "
"COMPLETO la política por defecto para su prefijo, nunca una simple adición, "
"de ahí el relleno previo para no perder directivas sin querer."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:374
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:86
#: src/omega_serv/interfaces/tui/screens/security_screen.py:98
msgid "Préfixe"
msgstr "Prefijo"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:375
msgid "Chemin URL auquel s'applique cette politique de remplacement."
msgstr "Ruta URL a la que se aplica esta política de sustitución."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:376
msgid "Doit commencer par '/', ex: /public-widgets/."
msgstr "Debe empezar por '/', ej.: /public-widgets/."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:377
msgid "Utilisé au clic sur Valider."
msgstr "Se usa al hacer clic en Validar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:378
msgid "Aucun effet avant Valider."
msgstr "Ningún efecto antes de Validar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:381
msgid "Directives (une par ligne, ex. style-src, script-src...)"
msgstr "Directivas (una por línea, ej. style-src, script-src...)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:382
msgid ""
"Chaque champ contrôle une famille de ressources - l'indice sous chaque champ"
" explique précisément laquelle."
msgstr ""
"Cada campo controla una familia de recursos - la indicación bajo cada campo "
"explica exactamente cuál."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:383
msgid ""
"Pré-rempli avec la valeur actuelle - modifier uniquement ce qui doit "
"changer, vider pour omettre la directive dans la zone."
msgstr ""
"Rellenado con el valor actual - modificar solo lo que deba cambiar, vaciar "
"para omitir la directiva en la zona."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:384
msgid "Reassemblees en une seule politique au clic sur Valider."
msgstr "Reensambladas en una sola política al hacer clic en Validar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:385
msgid ""
"Une valeur contenant unsafe-inline/unsafe-eval/'*' déclenche une "
"confirmation explicite supplémentaire avant d'enregistrer."
msgstr ""
"Un valor que contenga unsafe-inline/unsafe-eval/'*' provoca una confirmación"
" explícita adicional antes de guardar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:389
msgid ""
"La zone créée reste visible dans 'omega-serv audit security' "
"(CSP-001/CSP-002 scannent aussi les zones) si elle contient une relâche - "
"jamais silencieuse, même délibérée."
msgstr ""
"La zona creada sigue visible en 'omega-serv audit security' (CSP-001/CSP-002"
" analizan también las zonas) si contiene una relajación - nunca silenciosa, "
"aunque sea deliberada."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:396
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:42
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:49
msgid "Contrôle d'accès"
msgstr "Control de acceso"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:397
msgid "Accueil -> Configuration détaillée -> Contrôle d'accès"
msgstr "Inicio -> Configuración detallada -> Control de acceso"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:399
msgid ""
"CRUD de règles allow/deny par préfixe d'URL, avec filtre optionnel par "
"extension - permet par exemple de bloquer des extensions sensibles partout "
"SAUF dans une zone précise."
msgstr ""
"CRUD de reglas allow/deny por prefijo de URL, con filtro opcional por "
"extensión - permite por ejemplo bloquear extensiones sensibles en todas "
"partes SALVO en una zona concreta."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:404
#: src/omega_serv/interfaces/tui/guide/content/routage.py:15
#: src/omega_serv/interfaces/tui/guide/content/routage.py:58
#: src/omega_serv/interfaces/tui/guide/content/routage.py:356
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:80
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:130
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:63
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:113
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:115
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:112
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:66
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:115
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:197
msgid "Préfixe URL"
msgstr "Prefijo URL"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:405
msgid "Le préfixe de chemin auquel s'applique la règle."
msgstr "El prefijo de ruta al que se aplica la regla."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:406
msgid ""
"Doit commencer par '/', ex: /private/. Le plus long préfixe correspondant "
"gagne."
msgstr ""
"Debe empezar por '/', ej.: /private/. Gana el prefijo coincidente más largo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:407
msgid "Ajoute/modifie une règle via Ajouter/Modifier."
msgstr "Añade/modifica una regla con Añadir/Modificar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:408
#: src/omega_serv/interfaces/tui/guide/content/routage.py:19
#: src/omega_serv/interfaces/tui/guide/content/routage.py:135
#: src/omega_serv/interfaces/tui/guide/content/routage.py:220
#: src/omega_serv/interfaces/tui/guide/content/routage.py:317
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:166
msgid "Aucun effet sans rechargement du service (automatique si actif)."
msgstr "Ningún efecto sin recarga del servicio (automática si está activo)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:411
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:80
msgid "Verdict"
msgstr "Veredicto"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:412
msgid "Ce que décide la règle pour les chemins qu'elle couvre."
msgstr "Lo que decide la regla para las rutas que cubre."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:413
msgid "allow ou deny."
msgstr "allow o deny."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:414
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:424
msgid "Ajoute/modifie une règle."
msgstr "Añade/modifica una regla."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:415
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:425
#: src/omega_serv/interfaces/tui/guide/content/routage.py:26
#: src/omega_serv/interfaces/tui/guide/content/routage.py:33
