msgstr "Configuración detallada (menú)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:13
msgid "Accueil -> Configuration détaillée"
msgstr "Inicio -> Configuración detallada"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:15
msgid "Sous-menu regroupant tous les écrans de configuration du serveur et des options superposables, plus deux raccourcis (Voir options actives, Vérifier la configuration)."
msgstr "Submenú que agrupa todas las pantallas de configuración del servidor y de las opciones superponibles, más dos atajos (Ver opciones activas, Comprobar la configuración)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:18
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:17
#: src/omega_serv/interfaces/tui/guide/content/tls.py:15
msgid "Aucune - purement navigation."
msgstr "Ninguna - solo navegación."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "Configuración básica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "Inicio -> Configuración detallada -> Configuración básica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid "Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier explicite."
msgstr "Ajustes fundamentales del servidor: dirección de escucha, puerto, nombre de servidor anunciado, archivos de índice buscados en un directorio sin nombre de archivo explícito."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:32
msgid "Adresse d'écoute (bind)"
msgstr "Dirección de escucha (bind)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse IP sur laquelle le serveur accepte les connexions."
msgstr "Dirección IP en la que el servidor acepta conexiones."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:35
msgid "Une adresse IP valide - '127.0.0.1' (local uniquement) ou '0.0.0.0' (toutes les interfaces réseau). Valeur par défaut : 127.0.0.1."
msgstr "Una dirección IP válida - '127.0.0.1' (solo local) o '0.0.0.0' (todas las interfaces de red). Valor por defecto: 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:38
msgid "Enregistre dans server.bind après validation structurelle de la configuration."
msgstr "Guarda en server.bind tras la validación estructural de la configuración."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:40
msgid "Nécessite un REDÉMARRAGE COMPLET - le socket d'écoute n'est jamais retouché par un simple rechargement. Un bouton 'Redémarrer maintenant' est proposé après l'enregistrement si un service est détecté."
msgstr "Requiere un REINICIO COMPLETO - el socket de escucha nunca se toca con una simple recarga. Se ofrece un botón 'Reiniciar ahora' tras guardar si se detecta un servicio."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:46
msgid "Port (port)"
msgstr "Puerto (port)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:47
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:80
msgid "Port TCP d'écoute."
msgstr "Puerto TCP de escucha."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:49
msgid "Un entier de port valide (1-65535 ; 0 signifie 'port libre choisi par le système', surtout utile pour des tests). Valeur par défaut : 8080."
msgstr "Un entero de puerto válido (1-65535; 0 significa 'puerto libre elegido por el sistema', útil sobre todo para pruebas). Valor por defecto: 8080."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:52
msgid "Enregistre dans server.port après validation."
msgstr "Guarda en server.port tras la validación."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:53
msgid "Nécessite un REDÉMARRAGE COMPLET, même raison que l'adresse d'écoute."
msgstr "Requiere un REINICIO COMPLETO, por la misma razón que la dirección de escucha."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:56
msgid "Nom de serveur (server_name)"
msgstr "Nombre de servidor (server_name)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:57
msgid "Nom de serveur utilisé en interne (transmis notamment à FastCGI)."
msgstr "Nombre de servidor usado internamente (transmitido en particular a FastCGI)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:58
msgid "Chaîne libre, optionnelle. Vide par défaut."
msgstr "Texto libre, opcional. Vacío por defecto."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:59
msgid "Enregistre dans server.server_name."
msgstr "Guarda en server.server_name."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:61
msgid "Se recharge à chaud (pas de redémarrage complet nécessaire) - mais reste sans effet tant qu'un rechargement du service en cours n'a pas eu lieu (automatique si un service actif existe, sinon à faire manuellement depuis l'écran SERVICE)."
msgstr "Se recarga en caliente (no hace falta un reinicio completo) - pero no tiene efecto mientras no se recargue el servicio en curso (automático si existe un servicio activo; si no, hay que hacerlo manualmente desde la pantalla SERVICE)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:67
msgid "Fichiers d'index (index_files)"
msgstr "Archivos de índice (index_files)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:69
msgid "Noms de fichiers cherches, dans l'ordre, quand une URL pointe vers un répertoire sans fichier explicite."
msgstr "Nombres de archivo buscados, en orden, cuando una URL apunta a un directorio sin archivo explícito."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:72
msgid "Liste séparée par des virgules. Valeur par défaut : index.html."
msgstr "Lista separada por comas. Valor por defecto: index.html."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:73
msgid "Enregistre dans server.index_files."
msgstr "Guarda en server.index_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:74
msgid "Même réaction que le nom de serveur - rechargement nécessaire, jamais un redémarrage complet."
msgstr "Misma reacción que el nombre de servidor - recarga necesaria, nunca un reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:78
msgid "bind/port exigent toujours un redémarrage complet. server_name/index_files se rechargent à chaud mais nécessitent quand même un rechargement du service déjà lancé pour être pris en compte."
msgstr "bind/port siempre exigen un reinicio completo. server_name/index_files se recargan en caliente pero necesitan de todos modos una recarga del servicio ya iniciado para tenerse en cuenta."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:84
msgid "Changer bind/port pendant qu'un service systemd est déjà actif ne prend jamais effet tant qu'un redémarrage complet n'a pas eu lieu - toutes les connexions en cours sont alors coupées, contrairement à un simple rechargement."
msgstr "Cambiar bind/port mientras un servicio systemd ya está activo nunca tiene efecto hasta un reinicio completo - todas las conexiones en curso se cortan entonces, a diferencia de una simple recarga."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:93
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:47
msgid "Résistance et limites"
msgstr "Resistencia y límites"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:94
msgid "Accueil -> Configuration détaillée -> Résistance et limites"
msgstr "Inicio -> Configuración detallada -> Resistencia y límites"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:96
msgid "Dix réglages numériques anti-abus : bornes de taille/nombre/delai appliquées à chaque connexion et requête."
msgstr "Diez ajustes numéricos antiabuso: límites de tamaño/número/tiempo aplicados a cada conexión y petición."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:101
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:30
msgid "Connexions simultanées max (max_connections)"
msgstr "Conexiones simultáneas máx. (max_connections)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:102
msgid "Nombre maximal de connexions ouvertes en même temps."
msgstr "Número máximo de conexiones abiertas a la vez."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:103
msgid "Entier positif. Valeur par défaut : 256."
msgstr "Entero positivo. Valor por defecto: 256."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:104
msgid "Enregistre dans server.max_connections."
msgstr "Guarda en server.max_connections."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:105
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:233
msgid "Se recharge à chaud (rechargement du service nécessaire, automatique si actif)."
msgstr "Se recarga en caliente (recarga del servicio necesaria, automática si está activo)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:108
msgid "Taille max de requête (max_request_size)"
msgstr "Tamaño máx. de petición (max_request_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:109
msgid "Taille maximale acceptée pour le corps d'une requête, en octets."
msgstr "Tamaño máximo aceptado para el cuerpo de una petición, en bytes."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:110
msgid "Entier positif, en octets. Valeur par défaut : 10 485 760 (10 Mio)."
msgstr "Entero positivo, en bytes. Valor por defecto: 10 485 760 (10 MiB)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:111
msgid "Enregistre dans server.max_request_size."
msgstr "Guarda en server.max_request_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:112
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:122
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:129
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:136
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:143
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:150
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:163
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:183
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:243
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:250
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:272
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:297
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:304
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:311
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:318
msgid "Se recharge à chaud."
msgstr "Se recarga en caliente."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:115
msgid "Taille max des en-têtes (max_header_size)"
msgstr "Tamaño máx. de cabeceras (max_header_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:117
msgid "Taille cumulée maximale des en-têtes HTTP d'une requête, en octets - protection contre les en-têtes surdimensionnés (HTTP smuggling, saturation mémoire)."
msgstr "Tamaño total máximo de las cabeceras HTTP de una petición, en bytes - protección contra cabeceras sobredimensionadas (HTTP smuggling, saturación de memoria)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:120
msgid "Entier positif, en octets. Valeur par défaut : 16 384."
msgstr "Entero positivo, en bytes. Valor por defecto: 16 384."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:121
msgid "Enregistre dans server.max_header_size."
msgstr "Guarda en server.max_header_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:125
msgid "Taille max de la ligne de requête (max_request_line_size)"
msgstr "Tamaño máx. de la línea de petición (max_request_line_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:126
msgid "Taille maximale de la première ligne HTTP (méthode + chemin + version), en octets."
msgstr "Tamaño máximo de la primera línea HTTP (método + ruta + versión), en bytes."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:127
msgid "Entier positif, en octets. Valeur par défaut : 8 192."
msgstr "Entero positivo, en bytes. Valor por defecto: 8 192."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:128
msgid "Enregistre dans server.max_request_line_size."
msgstr "Guarda en server.max_request_line_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:132
msgid "Délai de lecture (read_timeout_seconds)"
msgstr "Tiempo de lectura (read_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:133
msgid "Délai maximal, en secondes, pour recevoir une requête complète avant coupure."
msgstr "Tiempo máximo, en segundos, para recibir una petición completa antes del corte."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:134
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:181
msgid "Entier positif, en secondes. Valeur par défaut : 10."
msgstr "Entero positivo, en segundos. Valor por defecto: 10."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:135
msgid "Enregistre dans server.read_timeout_seconds."
msgstr "Guarda en server.read_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:139
msgid "Délai d'écriture (write_timeout_seconds)"
msgstr "Tiempo de escritura (write_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:140
msgid "Délai maximal, en secondes, pour envoyer la réponse avant coupure."
msgstr "Tiempo máximo, en segundos, para enviar la respuesta antes del corte."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:141
msgid "Entier positif, en secondes. Valeur par défaut : 15."
msgstr "Entero positivo, en segundos. Valor por defecto: 15."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:142
msgid "Enregistre dans server.write_timeout_seconds."
msgstr "Guarda en server.write_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:146
msgid "Délai keep-alive (keepalive_timeout_seconds)"
msgstr "Tiempo keep-alive (keepalive_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:147
msgid "Délai d'inactivité, en secondes, avant fermeture d'une connexion gardée ouverte."
msgstr "Tiempo de inactividad, en segundos, antes de cerrar una conexión mantenida abierta."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:148
msgid "Entier positif, en secondes. Valeur par défaut : 5."
msgstr "Entero positivo, en segundos. Valor por defecto: 5."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:149
msgid "Enregistre dans server.keepalive_timeout_seconds."
msgstr "Guarda en server.keepalive_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:153
msgid "Requêtes max en keep-alive (max_keepalive_requests)"
msgstr "Peticiones máx. en keep-alive (max_keepalive_requests)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:155
msgid "Nombre maximal de requêtes traitées sur une même connexion gardée ouverte. Une fois atteint, la connexion est simplement fermée et le navigateur en ouvre une nouvelle : aucune erreur, aucun bannissement. Sans rapport avec la limite de débit du WAF (Active Sécurité -> Exclusions et débit), qui compte les requêtes par IP toutes connexions confondues."
msgstr "Número máximo de peticiones atendidas en una misma conexión mantenida abierta. Una vez alcanzado, la conexión simplemente se cierra y el navegador abre otra: ningún error, ningún baneo. Sin relación con el límite de tasa del WAF (Seguridad activa -> Exclusiones y límite de tasa), que cuenta las peticiones por IP en todas las conexiones."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:161
msgid "Entier positif. Valeur par défaut : 30."
msgstr "Entero positivo. Valor por defecto: 30."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:162
msgid "Enregistre dans server.max_keepalive_requests."
msgstr "Guarda en server.max_keepalive_requests."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:166
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:38
msgid "File d'attente d'écoute (listen_backlog)"
msgstr "Cola de escucha (listen_backlog)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:168
msgid "Taille de la file d'attente de connexions en attente d'acceptation par le système d'exploitation (paramètre backlog du socket d'écoute)."
msgstr "Tamaño de la cola de conexiones pendientes de aceptación por el sistema operativo (parámetro backlog del socket de escucha)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:171
msgid "Entier positif. Valeur par défaut : 128."
msgstr "Entero positivo. Valor por defecto: 128."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:172
msgid "Enregistre dans server.listen_backlog."
msgstr "Guarda en server.listen_backlog."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:174
msgid "Nécessite un REDÉMARRAGE COMPLET - fixé au moment de la création du socket d'écoute, comme bind/port, jamais retouché par un simple rechargement."
msgstr "Requiere un REINICIO COMPLETO - se fija al crear el socket de escucha, como bind/port, nunca se toca con una simple recarga."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:179
msgid "Délai de grâce à l'arrêt (shutdown_grace_period_seconds)"
msgstr "Periodo de gracia al detener (shutdown_grace_period_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:180
msgid "Délai, en secondes, laissé aux connexions actives pour se terminer lors d'un arrêt."
msgstr "Tiempo, en segundos, que se deja a las conexiones activas para terminar durante una detención."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:182
msgid "Enregistre dans server.shutdown_grace_period_seconds."
msgstr "Guarda en server.shutdown_grace_period_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:186
msgid "Nombre de workers - mode boost (workers)"
msgstr "Número de workers - modo boost (workers)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:188
msgid "Nombre de processus serveur qui se partagent le port. Un processus Python n'utilise qu'un cœur : plusieurs workers servent davantage de requêtes en parallèle. Les compteurs de sécurité (rate limit, récidive) sont partagés entre workers et restent exacts ; un script magnet garde ses propres compteurs dans chaque worker."
msgstr "Número de procesos de servidor que comparten el puerto. Un proceso Python solo usa un núcleo: varios workers atienden más peticiones en paralelo. Los contadores de seguridad (rate limit, reincidencia) se comparten entre workers y siguen siendo exactos; un script magnet conserva sus propios contadores en cada worker."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:194
msgid "1 = un seul processus (par défaut, fonctionnement classique) ; 0 = automatique (un par cœur physique) ; sinon un nombre jusqu'aux CPU disponibles de cette machine, affichés sous le champ et dans le registre des capacités. Le nombre doit correspondre à la machine où omega-serv est installé : une valeur plus grande est refusée."
msgstr "1 = un solo proceso (por defecto, funcionamiento clásico); 0 = automático (uno por núcleo físico); si no, un número hasta las CPU disponibles de esta máquina, mostradas bajo el campo y en el registro de capacidades. El número debe corresponder a la máquina donde está instalado omega-serv: un valor mayor se rechaza."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:199
msgid "Enregistre dans server.workers."
msgstr "Guarda en server.workers."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:201
msgid "Redémarrage complet nécessaire. Si la configuration est recopiée sur une machine plus petite, le serveur se limite à ses CPU disponibles et l'écrit dans le journal."
msgstr "Reinicio completo necesario. Si la configuración se copia a una máquina más pequeña, el servidor se limita a sus CPU disponibles y lo anota en el registro."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:207
msgid "Neuf champs sur onze se rechargent à chaud (rechargement du service nécessaire, automatique si actif). listen_backlog et le nombre de workers exigent un redémarrage complet."
msgstr "Nueve campos de once se recargan en caliente (recarga del servicio necesaria, automática si está activo). listen_backlog y el número de workers exigen un reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:212
msgid "Un listen_backlog trop bas sous forte charge fait échouer des connexions entrantes avant même qu'elles atteignent OMEGA-SERV (comportement du système d'exploitation) - ne descendre sous 128 qu'en connaissance de cause."
msgstr "Un listen_backlog demasiado bajo con mucha carga hace fallar conexiones entrantes antes incluso de que lleguen a OMEGA-SERV (comportamiento del sistema operativo) - no bajar de 128 salvo con conocimiento de causa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:221
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:39
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:48
msgid "Sécurité générique"
msgstr "Seguridad genérica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:222
msgid "Accueil -> Configuration détaillée -> Sécurité générique"
msgstr "Inicio -> Configuración detallada -> Seguridad genérica"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:224
msgid "Règles de sécurité génériques appliquées à toutes les requêtes : méthodes autorisées, fichiers cachés, en-têtes de sécurité, CSP, HSTS."
msgstr "Reglas de seguridad genéricas aplicadas a todas las peticiones: métodos permitidos, archivos ocultos, cabeceras de seguridad, CSP, HSTS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:229
msgid "Méthodes autorisées"
msgstr "Métodos permitidos"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:230
msgid "Liste blanche des méthodes HTTP acceptées - tout le reste est refusé par défaut."
msgstr "Lista blanca de métodos HTTP aceptados - todo lo demás se rechaza por defecto."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:231
msgid "Liste séparée par des virgules, ex: GET, HEAD. Valeur par défaut : GET, HEAD."
msgstr "Lista separada por comas, ej.: GET, HEAD. Valor por defecto: GET, HEAD."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:232
msgid "Enregistre dans security.allowed_methods."
msgstr "Guarda en security.allowed_methods."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:236
#: src/omega_serv/interfaces/tui/screens/security_screen.py:58
msgid "Refuser les fichiers cachés (oui/non)"
msgstr "Rechazar archivos ocultos (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:238
msgid "Masque tout fichier ou dossier dont un segment de chemin commence par un point (dotfile) - à la fois en accès direct et dans le directory listing."
msgstr "Oculta cualquier archivo o carpeta con un segmento de ruta que empiece por un punto (dotfile) - tanto en acceso directo como en el listado de directorios."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:241
msgid "oui ou non (accepte aussi true/1/o/y). Valeur par défaut : oui."
msgstr "sí o no (acepta también si/true/1/y/oui). Valor por defecto: sí."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:242
msgid "Enregistre dans security.deny_hidden_files."
msgstr "Guarda en security.deny_hidden_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:246
msgid "Mode CSP"
msgstr "Modo CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:247
msgid "Mode d'application de la Content-Security-Policy envoyée dans les réponses."
msgstr "Modo de aplicación de la Content-Security-Policy enviada en las respuestas."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:248
msgid "enforce (bloque) ou report-only (signale sans bloquer). Valeur par défaut : enforce."
msgstr "enforce (bloquea) o report-only (avisa sin bloquear). Valor por defecto: enforce."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:249
msgid "Enregistre dans security.csp_mode."
msgstr "Guarda en security.csp_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:253
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:255
msgid "Isolation cross-origin - 'require-corp'/'credentialless' peuvent bloquer des ressources cross-origin (polices, images, iframes tiers) que ce serveur générique ne connaît pas à l'avance, contrairement à COOP/CORP (toujours actifs, sans ce risque)."
msgstr "Aislamiento cross-origin - 'require-corp'/'credentialless' pueden bloquear recursos cross-origin (fuentes, imágenes, iframes de terceros) que este servidor genérico no conoce de antemano, a diferencia de COOP/CORP (siempre activos, sin ese riesgo)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:261
msgid "unsafe-none (permissif, par défaut partout y compris hardened), require-corp ou credentialless - à activer uniquement en connaissance du contenu réellement servi."
msgstr "unsafe-none (permisivo, por defecto en todas partes incluido hardened), require-corp o credentialless - activar solo conociendo el contenido realmente servido."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:264
msgid "Enregistre dans security.coep_mode."
msgstr "Guarda en security.coep_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:265
msgid "Se recharge à chaud - toujours émis explicitement, même en unsafe-none (jamais un en-tête absent)."
msgstr "Se recarga en caliente - siempre se envía explícitamente, incluso en unsafe-none (nunca una cabecera ausente)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:268
#: src/omega_serv/interfaces/tui/screens/security_screen.py:64
msgid "En-têtes de sécurité actifs (oui/non)"
msgstr "Cabeceras de seguridad activas (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:269
msgid "Active l'envoi des en-têtes de sécurité standard (CSP, X-Content-Type-Options...)."
msgstr "Activa el envío de las cabeceras de seguridad estándar (CSP, X-Content-Type-Options...)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:270
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:309
msgid "oui ou non. Valeur par défaut : oui."
msgstr "sí o no. Valor por defecto: sí."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:271
msgid "Enregistre dans security.security_headers_enabled."
msgstr "Guarda en security.security_headers_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:275
msgid "Zones CSP (Ajouter une zone / Retirer)"
msgstr "Zonas CSP (Añadir una zona / Quitar)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:277
msgid "Exceptions EXPLICITES à la CSP globale, par préfixe de chemin - ex. 'unsafe-inline' uniquement sous /un-dossier/ qui en a réellement besoin, sans jamais relâcher la CSP du reste du site."
msgstr "Excepciones EXPLÍCITAS a la CSP global, por prefijo de ruta - ej. 'unsafe-inline' solo bajo /una-carpeta/ que realmente lo necesita, sin relajar nunca la CSP del resto del sitio."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:282
msgid "Préfixe (ex: /public-widgets/) + politique CSP COMPLÈTE pour ce préfixe (remplace entièrement le défaut pour ces chemins, jamais une fusion de directives)."
msgstr "Prefijo (ej.: /public-widgets/) + política CSP COMPLETA para ese prefijo (sustituye por completo la de por defecto para esas rutas, nunca una fusión de directivas)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:285
msgid "Enregistre immédiatement dans security.csp_zones, sans passer par Enregistrer."
msgstr "Guarda inmediatamente en security.csp_zones, sin pasar por Guardar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:287
msgid "Rechargement automatique immédiat si un service actif existe. Une exception comme 'unsafe-inline' reste TOUJOURS visible dans 'omega-serv audit security' (CSP-001/CSP-002), même délibérée - jamais silencieuse."
msgstr "Recarga automática inmediata si existe un servicio activo. Una excepción como 'unsafe-inline' sigue SIEMPRE visible en 'omega-serv audit security' (CSP-001/CSP-002), aunque sea deliberada - nunca silenciosa."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:293
#: src/omega_serv/interfaces/tui/screens/security_screen.py:66
msgid "HSTS actif (oui/non)"
msgstr "HSTS activo (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:294
msgid "Active l'en-tête Strict-Transport-Security (force HTTPS pour les visites futures)."
msgstr "Activa la cabecera Strict-Transport-Security (fuerza HTTPS en las visitas futuras)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:295
msgid "oui ou non. Valeur par défaut : non. N'a de sens que si TLS est réellement actif."
msgstr "sí o no. Valor por defecto: no. Solo tiene sentido si TLS está realmente activo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:296
msgid "Enregistre dans security.hsts_enabled."
msgstr "Guarda en security.hsts_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:300
msgid "HSTS max-age"
msgstr "HSTS max-age"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:301
msgid "Durée, en secondes, pendant laquelle un navigateur retient l'obligation HTTPS."
msgstr "Duración, en segundos, durante la cual un navegador recuerda la obligación de HTTPS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:302
msgid "Entier positif, en secondes. Valeur par défaut : 31 536 000 (un an)."
msgstr "Entero positivo, en segundos. Valor por defecto: 31 536 000 (un año)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:303
msgid "Enregistre dans security.hsts_max_age."
msgstr "Guarda en security.hsts_max_age."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:307
#: src/omega_serv/interfaces/tui/screens/security_screen.py:70
msgid "HSTS includeSubDomains (oui/non)"
msgstr "HSTS includeSubDomains (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:308
msgid "Étend l'obligation HTTPS à tous les sous-domaines."
msgstr "Extiende la obligación de HTTPS a todos los subdominios."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:310
msgid "Enregistre dans security.hsts_include_subdomains."
msgstr "Guarda en security.hsts_include_subdomains."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:314
#: src/omega_serv/interfaces/tui/screens/security_screen.py:72
msgid "HSTS preload (oui/non)"
msgstr "HSTS preload (sí/no)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:315
msgid "Signale l'éligibilité à la liste de prechargement HSTS des navigateurs."
msgstr "Indica la elegibilidad para la lista de precarga HSTS de los navegadores."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:316
#: src/omega_serv/interfaces/tui/guide/content/routage.py:31
msgid "oui ou non. Valeur par défaut : non."
msgstr "sí o no. Valor por defecto: no."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:317
msgid "Enregistre dans security.hsts_preload."
msgstr "Guarda en security.hsts_preload."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:321
msgid "Tous les champs de cet écran se rechargent à chaud - aucun n'exige de redémarrage complet."
msgstr "Todos los campos de esta pantalla se recargan en caliente - ninguno exige un reinicio completo."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:324
msgid "Activer HSTS sans que TLS soit réellement actif n'a aucun effet utile - le navigateur ignore cet en-tête reçu en HTTP simple."
msgstr "Activar HSTS sin que TLS esté realmente activo no tiene ningún efecto útil - el navegador ignora esta cabecera recibida en HTTP simple."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:332
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:40
msgid "Sécurité générique - Assistant zone CSP"
msgstr "Seguridad genérica - Asistente de zona CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:333
msgid "Sécurité générique -> Ajouter une zone"
msgstr "Seguridad genérica -> Añadir una zona"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:335
msgid "Construit la politique CSP d'une zone directive par directive, chacune pré-remplie avec sa valeur ACTUELLE (la politique globale) - une zone remplace ENTIÈREMENT la politique par défaut pour son préfixe, jamais un simple ajout, d'où le pré-remplissage pour éviter de perdre des directives sans le vouloir."
msgstr "Construye la política CSP de una zona directiva a directiva, cada una rellenada con su valor ACTUAL (la política global) - una zona sustituye POR COMPLETO la política por defecto para su prefijo, nunca una simple adición, de ahí el relleno previo para no perder directivas sin querer."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:342
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:83
#: src/omega_serv/interfaces/tui/screens/security_screen.py:98
msgid "Préfixe"
msgstr "Prefijo"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:343
msgid "Chemin URL auquel s'applique cette politique de remplacement."
msgstr "Ruta URL a la que se aplica esta política de sustitución."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:344
msgid "Doit commencer par '/', ex: /public-widgets/."
msgstr "Debe empezar por '/', ej.: /public-widgets/."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:345
msgid "Utilisé au clic sur Valider."
msgstr "Se usa al hacer clic en Validar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:346
msgid "Aucun effet avant Valider."
msgstr "Ningún efecto antes de Validar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:349
msgid "Directives (une par ligne, ex. style-src, script-src...)"
msgstr "Directivas (una por línea, ej. style-src, script-src...)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:350
msgid "Chaque champ contrôle une famille de ressources - l'indice sous chaque champ explique précisément laquelle."
msgstr "Cada campo controla una familia de recursos - la indicación bajo cada campo explica exactamente cuál."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:351
msgid "Pré-rempli avec la valeur actuelle - modifier uniquement ce qui doit changer, vider pour omettre la directive dans la zone."
msgstr "Rellenado con el valor actual - modificar solo lo que deba cambiar, vaciar para omitir la directiva en la zona."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:352
msgid "Reassemblees en une seule politique au clic sur Valider."
msgstr "Reensambladas en una sola política al hacer clic en Validar."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:353
msgid "Une valeur contenant unsafe-inline/unsafe-eval/'*' déclenche une confirmation explicite supplémentaire avant d'enregistrer."
msgstr "Un valor que contenga unsafe-inline/unsafe-eval/'*' provoca una confirmación explícita adicional antes de guardar."

