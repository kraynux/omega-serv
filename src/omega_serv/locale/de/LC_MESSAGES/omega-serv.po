#: src/omega_serv/domain/security/audit/rules.py:119
msgid "Réduire pour limiter l'impact d'un client lent (slowloris)."
msgstr ""
"Verringern, um die Auswirkung eines langsamen Clients (slowloris) zu "
"begrenzen."

#: src/omega_serv/domain/security/audit/rules.py:140
msgid "Zone d'upload sans restriction de type de fichier"
msgstr "Upload-Zone ohne Einschränkung des Dateityps"

#: src/omega_serv/domain/security/audit/rules.py:143
msgid ""
"Zone {url_prefix!r} accepte n'importe quel type de fichier (aucune "
"policy.allowed_extensions ni policy.allowed_content_types)."
msgstr ""
"Die Zone {url_prefix!r} akzeptiert jeden Dateityp (weder "
"policy.allowed_extensions noch policy.allowed_content_types)."

#: src/omega_serv/domain/security/audit/rules.py:146
msgid ""
"Restreindre policy.allowed_extensions et/ou policy.allowed_content_types à "
"la liste minimale nécessaire pour cette zone."
msgstr ""
"policy.allowed_extensions und/oder policy.allowed_content_types auf die "
"minimal nötige Liste für diese Zone beschränken."

#: src/omega_serv/domain/security/audit/rules.py:173
msgid "Vérification TLS upstream désactivée"
msgstr "TLS-Prüfung des Upstreams deaktiviert"

#: src/omega_serv/domain/security/audit/rules.py:176
msgid ""
"Zone {url_prefix!r} : verify_upstream_tls=False sur un upstream HTTPS - le "
"certificat présenté par le backend n'est jamais vérifié."
msgstr ""
"Zone {url_prefix!r}: verify_upstream_tls=False bei einem HTTPS-Upstream - "
"das vom Backend vorgelegte Zertifikat wird nie geprüft."

#: src/omega_serv/domain/security/audit/rules.py:179
msgid ""
"Activer verify_upstream_tls (défaut) sauf nécessité réelle et documentée "
"(backend interne en certificat auto-signé, réseau intermédiaire de "
"confiance)."
msgstr ""
"verify_upstream_tls aktivieren (Standard), außer bei echter und "
"dokumentierter Notwendigkeit (internes Backend mit selbstsigniertem "
"Zertifikat, vertrauenswürdiges Zwischennetz)."

#: src/omega_serv/domain/security/auth/zones.py:31
msgid "realm ne peut pas être vide"
msgstr "realm darf nicht leer sein"

#: src/omega_serv/domain/security/auth/zones.py:33
msgid ""
"la zone {path_prefix!r} n'a aucun allowed_users - personne ne pourrait "
"jamais y accéder"
msgstr ""
"die Zone {path_prefix!r} hat keine allowed_users - niemand könnte jemals "
"darauf zugreifen"

#: src/omega_serv/domain/security/csp.py:60
msgid ""
"Source par défaut pour tout type de contenu non couvert par une autre "
"directive ci-dessous."
msgstr ""
"Standardquelle für jeden Inhaltstyp, der von keiner anderen Direktive unten "
"abgedeckt wird."

#: src/omega_serv/domain/security/csp.py:61
msgid ""
"URL valides pour la balise <base> - restreindre à 'self' évite un "
"détournement de chemins relatifs."
msgstr ""
"Gültige URLs für das Tag <base> - die Beschränkung auf 'self' verhindert das"
" Umleiten relativer Pfade."

#: src/omega_serv/domain/security/csp.py:62
msgid ""
"Destination autorisée pour la soumission d'un formulaire - 'self' empêche "
"l'exfiltration vers un domaine externe."
msgstr ""
"Erlaubtes Ziel für das Absenden eines Formulars - 'self' verhindert die "
"Exfiltration zu einer externen Domain."

#: src/omega_serv/domain/security/csp.py:63
msgid ""
"Qui peut vous afficher dans une <iframe> - 'none' empêche le clickjacking."
msgstr ""
"Wer Sie in einem <iframe> anzeigen darf - 'none' verhindert Clickjacking."

#: src/omega_serv/domain/security/csp.py:64
msgid "Origines autorisées pour les images."
msgstr "Erlaubte Ursprünge für Bilder."

#: src/omega_serv/domain/security/csp.py:65
msgid ""
"Origines/mecanismes autorisés pour le CSS - 'unsafe-inline' autorise tout "
"style inline, y compris injecté."
msgstr ""
"Erlaubte Ursprünge/Mechanismen für CSS - 'unsafe-inline' erlaubt jeden "
"Inline-Stil, auch eingeschleusten."

#: src/omega_serv/domain/security/csp.py:66
msgid ""
"Origines/mecanismes autorisés pour le JavaScript - 'unsafe-inline'/'unsafe-"
"eval' sont les relâches les plus risquées."
msgstr ""
"Erlaubte Ursprünge/Mechanismen für JavaScript - 'unsafe-inline'/'unsafe-"
"eval' sind die riskantesten Lockerungen."

#: src/omega_serv/domain/security/csp.py:67
msgid "Origines autorisées pour les polices."
msgstr "Erlaubte Ursprünge für Schriftarten."

#: src/omega_serv/domain/security/csp.py:68
msgid ""
"Destinations autorisées pour fetch/XHR/WebSocket - restreint l'exfiltration "
"de données."
msgstr ""
"Erlaubte Ziele für fetch/XHR/WebSocket - begrenzt die Exfiltration von "
"Daten."

#: src/omega_serv/domain/security/csp.py:69
msgid ""
"Autorise <object>/<embed>/<applet> - 'none' recommandé (vecteur historique "
"Flash/plugins)."
msgstr ""
"Erlaubt <object>/<embed>/<applet> - 'none' empfohlen (historischer Vektor "
"Flash/Plugins)."

