#: src/omega_serv/interfaces/cli/riposte_action_commands.py:295
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:236
msgid "Identifiant de la politique (voir riposte policies list)."
msgstr "Kennung der Richtlinie (siehe riposte policies list)."

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:296
msgid "Bans et leurres posés par RIPOSTE."
msgstr "Von RIPOSTE gesetzte Sperren und Köder."

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:297
msgid ""
"Une commande est exécutée par le processus RIPOSTE en moins d'une seconde, "
"ou à son prochain démarrage s'il est arrêté."
msgstr ""
"Ein Befehl wird vom RIPOSTE-Prozess in weniger als einer Sekunde ausgeführt,"
" oder bei seinem nächsten Start, wenn er gestoppt ist."

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:299
msgid "Liste les actions en cours."
msgstr "Listet die laufenden Aktionen auf."

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:300
msgid "Liste les actions terminées à la place."
msgstr "Listet stattdessen die beendeten Aktionen auf."

#: src/omega_serv/interfaces/cli/riposte_action_commands.py:301
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:271
