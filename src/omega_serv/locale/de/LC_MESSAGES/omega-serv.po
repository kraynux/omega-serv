#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:176
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:183
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:201
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:210
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:217
msgid "Aucun effet sans rechargement du service."
msgstr "Keine Wirkung ohne Neuladen des Dienstes."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:418
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:80
msgid "Extensions"
msgstr "Erweiterungen"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:420
msgid ""
"Restreint la règle aux chemins se terminant par l'une de ces extensions - "
"vide signifie 'toutes', la règle s'applique alors à tout chemin sous ce "
"préfixe."
msgstr ""
"Beschränkt die Regel auf Pfade, die auf eine dieser Erweiterungen enden - "
"leer bedeutet 'alle', die Regel gilt dann für jeden Pfad unter diesem "
"Präfix."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:423
msgid ""
"Liste séparée par des virgules, ex: .key, .pem. Vide par défaut (toutes)."
msgstr "Kommagetrennte Liste, z. B.: .key, .pem. Standardmäßig leer (alle)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:429
msgid ""
"L'option access_control doit être activée (écran Options) pour que ces "
"règles soient réellement appliquées. Toutes les modifications se rechargent "
"à chaud."
msgstr ""
"Die Option access_control muss aktiviert sein (Bildschirm Optionen), damit "
"diese Regeln tatsächlich angewendet werden. Alle Änderungen werden im "
"laufenden Betrieb neu geladen."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:434
msgid ""
"Le plus long préfixe correspondant gagne : une règle 'allow' plus spécifique"
" lève le 'deny' d'un préfixe parent (ex: deny /private/, allow "
"/private/.assets/). Une règle 'allow' explicite lève aussi les règles "
"génériques dotfiles/motifs de l'écran Sécurité générique sur ce chemin "
"précis."
msgstr ""
"Das längste passende Präfix gewinnt: eine spezifischere 'allow'-Regel hebt "
"das 'deny' eines übergeordneten Präfixes auf (z. B. deny /private/, allow "
"/private/.assets/). Eine ausdrückliche 'allow'-Regel hebt auch die "
"allgemeinen Dotfile-/Musterregeln des Bildschirms Allgemeine Sicherheit für "
"genau diesen Pfad auf."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:440
msgid ""
"Pour bloquer une extension sensible PARTOUT sauf dans une zone : une règle "
"deny sur '/' avec l'extension visée, puis une règle allow (sans extension) "
"sur le préfixe à excepter - le préfixe le plus spécifique l'emporte."
msgstr ""
"Um eine sensible Erweiterung ÜBERALL außer in einer Zone zu blockieren: eine"
" deny-Regel auf '/' mit der betreffenden Erweiterung, dann eine allow-Regel "
"(ohne Erweiterung) auf das auszunehmende Präfix - das spezifischere Präfix "
"gewinnt."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:12
msgid "Accueil -> Registre des capacités"
msgstr "Start -> Fähigkeitsregister"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:13
msgid ""
"Scan complet de l'environnement (port libre, openssl présent, PHP-FPM si "
"FastCGI actif...), avec export."
msgstr ""
"Vollständige Prüfung der Umgebung (freier Port, openssl vorhanden, PHP-FPM "
"wenn FastCGI aktiv...), mit Export."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:16
#: src/omega_serv/interfaces/tui/guide/content/logs.py:521
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1061
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:85
#: src/omega_serv/interfaces/tui/screens/capabilities_screen.py:53
#: src/omega_serv/interfaces/tui/screens/export_log_archives_screen.py:43
#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:114
#: src/omega_serv/interfaces/tui/screens/log_stats_screen.py:107
msgid "Thème d'export HTML"
msgstr "Theme des HTML-Exports"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "Farbpalette für den HTML-Export."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:523
msgid "5 thèmes disponibles."
msgstr "5 verfügbare Themes."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:524
msgid "Utilisé au clic sur Exporter HTML."
msgstr "Beim Klick auf HTML exportieren verwendet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/divers.py:70
#: src/omega_serv/interfaces/tui/guide/content/divers.py:524
#: src/omega_serv/interfaces/tui/guide/content/logs.py:290
#: src/omega_serv/interfaces/tui/guide/content/logs.py:525
msgid "Aucun effet sur le serveur."
msgstr "Keine Wirkung auf den Server."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "Aktualisieren / JSON exportieren / HTML exportieren"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "Startet die Prüfung erneut oder exportiert ihr Ergebnis."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:530
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:255
msgid "Aucune saisie supplémentaire."
msgstr "Keine zusätzliche Eingabe."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr ""
"Aktualisieren startet die Prüfung erneut; die Exporte schreiben eine Datei "
"mit Zeitstempel."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid ""
"Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr ""
"Keine Wirkung auf den Server oder seine Konfiguration (nur lesend + Export)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "Rein zur Ansicht/zum Export."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "Detail einer Fähigkeit"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "Fähigkeitsregister -> Klick auf eine Zeile"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid ""
"Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : "
"statut, raison, détails techniques, date du dernier scan."
msgstr ""
"Vollständiges Detail einer bereits geprüften Fähigkeit (nie eine neue "
"Prüfung): Status, Grund, technische Details, Datum der letzten Prüfung."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:307
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:205
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:332
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:540
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:478
msgid "Purement consultatif."
msgstr "Rein zur Ansicht."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "Start -> Profile"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid ""
"Liste les 4 profils fournis (minimal/standard/hardened/development) et vos "
"profils personnalisés (colonne Type), avec leur libellé."
msgstr ""
"Listet die 4 mitgelieferten Profile (minimal/standard/hardened/development) "
"und Ihre eigenen Profile (Spalte Typ) mit ihrer Bezeichnung auf."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
#: src/omega_serv/interfaces/tui/guide/content/divers.py:123
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:42
msgid "Appliquer"
msgstr "Anwenden"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr ""
"Öffnet den Bestätigungsbildschirm für das Anwenden des ausgewählten Profils."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Sélectionner un profil active ce bouton."
msgstr "Die Auswahl eines Profils aktiviert diese Schaltfläche."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Ouvre ApplyProfileScreen."
msgstr "Öffnet ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:54
msgid ""
"Un profil personnalisé ne fixe que la sécurité et l'état des options : "
"adresse, port, TLS, chemins, journaux et réglages des options (zones, "
"listes) restent ceux de l'instance."
msgstr ""
"Ein eigenes Profil legt nur die Sicherheit und den Zustand der Optionen "
"fest: Adresse, Port, TLS, Pfade, Protokolle und Einstellungen der Optionen "
"(Zonen, Listen) bleiben die der Instanz."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:58
#: src/omega_serv/interfaces/tui/guide/content/divers.py:78
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:44
msgid "Créer un profil personnalisé"
msgstr "Eigenes Profil erstellen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:59
msgid ""
"Ouvre l'assistant. Si un profil personnalisé est sélectionné, l'assistant "
"repart de ses choix (un profil personnalisé ne se modifie pas : on en recrée"
" un)."
msgstr ""
"Öffnet den Assistenten. Ist ein eigenes Profil ausgewählt, geht der "
"Assistent von dessen Auswahl aus (ein eigenes Profil lässt sich nicht "
"bearbeiten: Man erstellt ein neues)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
msgid "Aucune limite de nombre : un seul profil est appliqué à la fois."
msgstr ""
"Keine Begrenzung der Anzahl: Es wird immer nur ein Profil gleichzeitig "
"angewendet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid ""
"Enregistre config/profiles/custom/<nom>.json ; la configuration n'est pas "
"touchée."
msgstr ""
"Speichert config/profiles/custom/<Name>.json; die Konfiguration wird nicht "
"angetastet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid ""
"Compris dans toute sauvegarde de configuration et repris lors d'une mise à "
"jour."
msgstr ""
"In jedem Konfigurations-Backup enthalten und bei einem Update übernommen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/guide/content/divers.py:297
