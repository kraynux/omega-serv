#: src/omega_serv/domain/security/waf/keyword_list.py:57
msgid ""
"# Syntaxe (une entrée par ligne, '#' = commentaire) :\n"
"#   /admin    -> /admin et /admin/xxx, jamais /administrator\n"
"#   /.git/    -> tout ce qui est sous /.git/\n"
"#   /*.bak    -> tout fichier dont le nom finit par .bak\n"
"#   !/api/v1  -> exception : ce chemin n'est jamais compte par cette liste\n"
"#               (prioritaire sur les entrées, quel que soit l'ordre des lignes)"
msgstr ""
"# ไวยากรณ์ (หนึ่งรายการต่อบรรทัด '#' = ความคิดเห็น):\n"
"#   /admin    -> /admin และ /admin/xxx ไม่รวม /administrator\n"
"#   /.git/    -> ทุกอย่างที่อยู่ใต้ /.git/\n"
"#   /*.bak    -> ทุกไฟล์ที่ชื่อลงท้ายด้วย .bak\n"
"#   !/api/v1  -> ข้อยกเว้น: รายการนี้จะไม่นับพาธนี้เลย\n"
"#               (มีผลเหนือรายการอื่น ไม่ว่าบรรทัดจะอยู่ลำดับใด)"

#: src/omega_serv/domain/security/waf/keyword_list.py:64
msgid ""
"# Liste de chemins personnelle (omega-serv)\n"
"#\n"
msgstr ""
"# รายการพาธส่วนตัว (omega-serv)\n"
"#\n"

#: src/omega_serv/domain/security/waf/keyword_list.py:66
msgid ""
"# Liste de mots-clefs personnelle (omega-serv)\n"
"# Un mot-clef par ligne, recherche n'importe où dans la partie choisie de la requête\n"
"# (casse ignorée). '#' = commentaire. Écrivez le texte tel quel, jamais une regex.\n"
msgstr ""
"# รายการคำสำคัญส่วนตัว (omega-serv)\n"
"# หนึ่งคำสำคัญต่อบรรทัด ค้นหาที่ใดก็ได้ในส่วนที่เลือกของคำขอ\n"
"# (ไม่สนตัวพิมพ์เล็ก/ใหญ่) '#' = ความคิดเห็น พิมพ์ข้อความตามจริง ห้ามใช้ regex\n"

