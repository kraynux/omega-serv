msgid "Purement consultatif."
msgstr "ดูข้อมูลเท่านั้น"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "หน้าหลัก -> โปรไฟล์"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid "Liste et décrit les 4 profils de base preconfigures (minimal/standard/hardened/development)."
msgstr "แสดงรายการและอธิบายโปรไฟล์ฐานที่ตั้งค่าไว้ล่วงหน้า 4 แบบ (minimal/standard/hardened/development)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:49
#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:45
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:39
msgid "Appliquer"
msgstr "ใช้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "เปิดหน้าจอยืนยันการใช้โปรไฟล์ที่เลือก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Sélectionner un profil active ce bouton."
msgstr "การเลือกโปรไฟล์จะเปิดใช้ปุ่มนี้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Ouvre ApplyProfileScreen."
msgstr "เปิด ApplyProfileScreen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Aucun effet ici - voir la fiche d'ApplyProfileScreen."
msgstr "ไม่มีผลที่นี่ - ดูหัวข้อของ ApplyProfileScreen"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:56
msgid "Purement consultatif - aucune modification depuis cet écran lui-même."
msgstr "ดูข้อมูลเท่านั้น - ไม่มีการแก้ไขใดจากหน้าจอนี้เอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "ใช้โปรไฟล์"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Profils -> Appliquer"
msgstr "โปรไฟล์ -> ใช้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid "Affiche TOUJOURS la différence complète avant toute confirmation, puis écrase la configuration active avec le profil choisi."
msgstr "แสดงความแตกต่างทั้งหมดเสมอก่อนการยืนยันใดๆ แล้วเขียนทับการตั้งค่าปัจจุบันด้วยโปรไฟล์ที่เลือก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Confirme et écrit le profil choisi."
msgstr "ยืนยันและเขียนโปรไฟล์ที่เลือก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid "Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "diff ทั้งหมดแสดงอยู่ด้านบนแล้ว - ตรวจสอบก่อนคลิก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid "Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr "เขียนทับ config/omega-serve.json ด้วยการตั้งค่าที่ประกอบจากโปรไฟล์"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:71
msgid "Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire ; sinon un simple rechargement suffit (automatique si un service actif existe)."
msgstr "โปรไฟล์สามารถเปลี่ยนการตั้งค่าใดก็ได้ในครั้งเดียว หาก bind/port/listen_backlog/TLS เปลี่ยน ต้องรีสตาร์ทเต็มรูปแบบ มิฉะนั้นการโหลดใหม่ธรรมดาก็เพียงพอ (อัตโนมัติหากมีบริการที่ทำงานอยู่)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:77
msgid "Des conflits ou erreurs de validation bloquants demandent une confirmation supplémentaire explicite pour forcer quand même."
msgstr "ความขัดแย้งหรือข้อผิดพลาดในการตรวจสอบที่เป็นอุปสรรคจะขอการยืนยันเพิ่มเติมอย่างชัดเจนเพื่อบังคับดำเนินการต่อ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid "Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste de la configuration active est conservé tel quel."
msgstr "โปรไฟล์แก้ไขเฉพาะฟิลด์ที่ระบุไว้อย่างชัดเจน - ส่วนที่เหลือของการตั้งค่าปัจจุบันยังคงเดิม"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Accueil -> Audit de sécurité"
msgstr "หน้าหลัก -> ตรวจสอบความปลอดภัย"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...) - mêmes règles que l'audit CLI."
msgstr "การตรวจสอบเชิงแนะนำ (บริการ การหมุนเวียนล็อก โหมด WAF...) - กฎเดียวกับการตรวจสอบผ่าน CLI"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:52
msgid "Auditer"
msgstr "ตรวจสอบ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:91
msgid "Relance explicitement l'audit."
msgstr "เรียกการตรวจสอบใหม่อย่างชัดเจน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:92
msgid "Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "ไม่ต้องป้อนข้อมูล - การตรวจสอบครั้งแรกเกิดขึ้นอัตโนมัติเมื่อเปิดหน้าจอแล้ว"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "อ่านการตั้งค่าใหม่และคำนวณกฎการตรวจสอบทั้งหมดใหม่"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:221
msgid "Aucun effet sur le serveur (lecture seule) - notifie explicitement le résultat sur un clic explicite."
msgstr "ไม่มีผลต่อเซิร์ฟเวอร์ (อ่านอย่างเดียว) - แจ้งผลอย่างชัดเจนเมื่อคลิก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "ดูข้อมูลเท่านั้น - ไม่แก้ไขสิ่งใดเลย"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Accueil -> Sauvegarde de configuration"
msgstr "หน้าหลัก -> สำรองข้อมูลการตั้งค่า"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:104
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration - le fichier de configuration est toujours inclus, jamais chiffre par défaut."
msgstr "สร้าง แสดงรายการ กู้คืน หรือลบข้อมูลสำรองการตั้งค่าแบบเต็ม - รวมไฟล์การตั้งค่าเสมอ ไม่เข้ารหัสโดยค่าเริ่มต้น"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:107
msgid "Inclure les règles WAF"
msgstr "รวมกฎ WAF"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "เพิ่มกฎ WAF และรายการบล็อกลงในข้อมูลสำรอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
#: src/omega_serv/interfaces/tui/guide/content/divers.py:130
msgid "Case à cocher."
msgstr "ช่องทำเครื่องหมาย"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:110
#: src/omega_serv/interfaces/tui/guide/content/divers.py:117
#: src/omega_serv/interfaces/tui/guide/content/divers.py:124
#: src/omega_serv/interfaces/tui/guide/content/divers.py:131
msgid "Pris en compte à la création."
msgstr "ใช้เมื่อสร้าง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:111
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "ไม่มีผลทันที - เป็นเพียงเนื้อหาของข้อมูลสำรองที่สร้าง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:114
msgid "Inclure les zones d'authentification"
msgstr "รวมโซนการยืนยันตัวตน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:115
msgid "Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la sauvegarde."
msgstr "เพิ่ม users.json/zones.json (ความลับจริง: hash ของรหัสผ่าน) ลงในข้อมูลสำรอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:116
#: src/omega_serv/interfaces/tui/guide/content/divers.py:123
msgid "Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "ช่องทำเครื่องหมาย - ขอการยืนยันเพิ่มเติมอย่างชัดเจนหากทำเครื่องหมาย"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "ข้อมูลสำรองมีความลับจริง ไม่เข้ารหัส"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:121
msgid "Inclure les certificats"
msgstr "รวมใบรับรอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:122
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "เพิ่มใบรับรอง TLS รวมถึงคีย์ส่วนตัว ลงในข้อมูลสำรอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "ข้อมูลสำรองมีคีย์ส่วนตัวจริง ไม่เข้ารหัส"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
msgid "Inclure Active Defense"
msgstr "รวม Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:129
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr "เพิ่มฐานข้อมูลภัยคุกคาม/เหตุการณ์ของ Active Defense ลงในข้อมูลสำรอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:132
#: src/omega_serv/interfaces/tui/guide/content/divers.py:139
msgid "Aucun effet immédiat."
msgstr "ไม่มีผลทันที"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:135
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:55
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:73
msgid "Description"
msgstr "คำอธิบาย"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "บันทึกอิสระที่แนบกับข้อมูลสำรอง เพื่อค้นหาภายหลัง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:137
msgid "Texte libre, optionnel."
msgstr "ข้อความอิสระ ไม่บังคับ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:138
msgid "Enregistrée avec la sauvegarde."
msgstr "บันทึกพร้อมข้อมูลสำรอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:142
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:65
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "กู้คืน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX MÊMES EMPLACEMENTS."
msgstr "เขียนทับไฟล์ปัจจุบันด้วยไฟล์จากข้อมูลสำรองที่เลือก ณ ตำแหน่งเดิม"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:144
#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "เลือกข้อมูลสำรอง แล้วยืนยัน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:145
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "เขียนไฟล์ที่เกี่ยวข้องจริงและทันที"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration peut écraser n'importe quel fichier (configuration, certificats TLS...), et un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr "ต้องรีสตาร์ทเต็มรูปแบบเสมอเพื่อความรอบคอบ - การกู้คืนอาจเขียนทับไฟล์ใดก็ได้ (การตั้งค่า ใบรับรอง TLS...) และใบรับรองที่อยู่ในหน่วยความจำแล้วจะไม่โหลดใหม่เอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:153
#: src/omega_serv/interfaces/tui/guide/content/logs.py:88
