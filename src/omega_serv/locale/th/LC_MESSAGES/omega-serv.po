msgid "Supprimer"
msgstr "ลบ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:154
msgid "Supprime définitivement une sauvegarde (n'existe pas côté CLI, confort TUI uniquement)."
msgstr "ลบข้อมูลสำรองอย่างถาวร (ไม่มีใน CLI เป็นความสะดวกของ TUI เท่านั้น)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:156
msgid "Suppression immédiate et définitive."
msgstr "ลบทันทีและถาวร"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:157
msgid "Aucun effet sur le serveur - seulement sur les sauvegardes disponibles."
msgstr "ไม่มีผลต่อเซิร์ฟเวอร์ - มีผลเฉพาะข้อมูลสำรองที่มีอยู่"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:160
msgid "Restaurer écrase directement les fichiers vises, sans filet - la seule protection est la confirmation demandée avant."
msgstr "การกู้คืนเขียนทับไฟล์เป้าหมายโดยตรง ไม่มีตาข่ายรองรับ - การป้องกันเดียวคือการยืนยันที่ขอไว้ก่อน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:165
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:100
msgid "Réglages de l'application"
msgstr "การตั้งค่าแอปพลิเคชัน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:166
msgid "Raccourci clavier 'o' (footer), depuis n'importe quel écran"
msgstr "ปุ่มลัด 'o' (footer) จากหน้าจอใดก็ได้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:168
msgid "PRÉFÉRENCES D'INTERFACE uniquement (thème, rendu, chemins d'export/captures) - PAS des réglages du serveur (ceux-là vivent dans Configuration détaillée)."
msgstr "การตั้งค่าอินเทอร์เฟซเท่านั้น (ธีม การแสดงผล พาธการส่งออก/ภาพหน้าจอ) - ไม่ใช่การตั้งค่าของเซิร์ฟเวอร์ (ซึ่งอยู่ในการตั้งค่าโดยละเอียด)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:174
msgid "Thème visuel de l'interface elle-même."
msgstr "ธีมภาพของอินเทอร์เฟซเอง"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:175
msgid "Un des thèmes disponibles."
msgstr "หนึ่งในธีมที่มีให้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:176
msgid "Appliqué immédiatement au changement."
msgstr "ใช้ทันทีเมื่อเปลี่ยน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:177
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "มีผลทันที ไม่ต้องรีสตาร์ท"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:180
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:203
msgid "Profil de rendu"
msgstr "โปรไฟล์การแสดงผล"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:181
msgid "Force un profil de rendu Textual particulier plutôt que la détection automatique."
msgstr "บังคับใช้โปรไฟล์การแสดงผล Textual ที่ระบุ แทนการตรวจหาอัตโนมัติ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:182
msgid "Automatique, ou un profil précis."
msgstr "อัตโนมัติ หรือโปรไฟล์ที่ระบุ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:183
msgid "Enregistre la préférence."
msgstr "บันทึกค่าที่เลือก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:184
msgid "Appliqué seulement AU PROCHAIN DÉMARRAGE de l'interface, jamais à chaud."
msgstr "มีผลเฉพาะเมื่อเริ่มอินเทอร์เฟซครั้งถัดไป ไม่มีผลขณะทำงาน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:189
msgid "Langue de l'interface. Chaque langue est écrite dans sa propre langue, Français toujours en tête ; le libellé 'Langue / Language' n'est jamais traduit, pour être retrouvé même dans une langue qu'on ne lit pas. Une langue non encore validée porte la mention 'en test'."
msgstr "ภาษาของอินเทอร์เฟซ แต่ละภาษาเขียนด้วยภาษาของตัวเอง ภาษาฝรั่งเศสอยู่บนสุดเสมอ ป้าย 'Langue / Language' ไม่ถูกแปล เพื่อให้หาเจอได้แม้ในภาษาที่อ่านไม่ออก ภาษาที่ยังไม่ผ่านการยืนยันจะมีคำกำกับ 'กำลังทดสอบ'"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:194
msgid "Choisir une langue dans la liste, puis confirmer le redémarrage de l'interface."
msgstr "เลือกภาษาจากรายการ แล้วยืนยันการรีสตาร์ทอินเทอร์เฟซ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:196
msgid "Enregistre la langue puis redémarre L'INTERFACE (pas le service : le serveur continue de tourner). Un écran de confirmation affiche la langue et la phrase d'invite déjà traduite."
msgstr "บันทึกภาษาแล้วรีสตาร์ทอินเทอร์เฟซ (ไม่ใช่บริการ: เซิร์ฟเวอร์ยังทำงานต่อ) หน้าจอยืนยันจะแสดงภาษาและข้อความแจ้งที่แปลแล้ว"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:200
msgid "Retour au français toujours possible : ce même réglage ; ou lancer une fois 'OMEGA_SERV_LANG=fr serv' ; ou retirer la clé 'language' de var/settings.json. Langue indisponible ou catalogue illisible : l'interface démarre en français avec un message. Les journaux du serveur (journalctl) restent toujours en français."
msgstr "กลับไปภาษาฝรั่งเศสได้เสมอ: ใช้การตั้งค่าเดียวกันนี้ หรือเรียก 'OMEGA_SERV_LANG=fr serv' หนึ่งครั้ง หรือนำคีย์ 'language' ออกจาก var/settings.json หากไม่มีภาษานั้นหรืออ่านแค็ตตาล็อกไม่ได้ อินเทอร์เฟซจะเริ่มเป็นภาษาฝรั่งเศสพร้อมข้อความแจ้ง ล็อกของเซิร์ฟเวอร์ (journalctl) เป็นภาษาฝรั่งเศสเสมอ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:207
msgid "Export / Captures d'écran (chemins)"
msgstr "ส่งออก / ภาพหน้าจอ (พาธ)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:208
msgid "Répertoires où sont écrits les exports et les captures d'écran."
msgstr "ไดเรกทอรีที่ใช้เขียนไฟล์ส่งออกและภาพหน้าจอ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:209
msgid "Chemin libre - vide revient au répertoire par défaut."
msgstr "พาธอิสระ - ว่างจะกลับไปใช้ไดเรกทอรีเริ่มต้น"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:210
msgid "Enregistre à chaque changement de texte."
msgstr "บันทึกทุกครั้งที่ข้อความเปลี่ยน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:211
msgid "Effet immédiat sur les prochains exports/captures."
msgstr "มีผลทันทีกับการส่งออก/ภาพหน้าจอครั้งถัดไป"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:214
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:101
msgid "Langue des exports"
msgstr "ภาษาของการส่งออก"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:216
msgid "Langue des exports HTML (registre des capacités, archives de logs, guide d'aide) et du rapport d'incident Markdown - un fichier qui se diffuse, pas forcément à quelqu'un qui lit la langue de l'interface. Les exports JSON et CSV n'ont pas de texte à traduire."
msgstr "ภาษาของการส่งออก HTML (ทะเบียนความสามารถ คลังเก็บ log คู่มือช่วยเหลือ) และรายงานเหตุการณ์ Markdown - ไฟล์ที่ถูกเผยแพร่ต่อ ไม่จำเป็นต้องถึงผู้ที่อ่านภาษาของอินเทอร์เฟซได้ การส่งออก JSON และ CSV ไม่มีข้อความให้แปล"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:220
msgid "« Comme l'interface » (défaut) ou une des langues de la liste."
msgstr "« เหมือนอินเทอร์เฟซ » (ค่าเริ่มต้น) หรือภาษาใดภาษาหนึ่งในรายการ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:222
msgid "Enregistre immédiatement. Dans une autre langue que l'interface, chaque export est produit par un processus séparé lancé dans cette langue : quelques secondes, l'interface reste utilisable."
msgstr "บันทึกทันที ถ้าเป็นภาษาอื่นที่ไม่ใช่ภาษาของอินเทอร์เฟซ การส่งออกแต่ละครั้งจะสร้างโดยโปรเซสแยกที่เริ่มในภาษานั้น: ใช้เวลาไม่กี่วินาที อินเทอร์เฟซยังใช้งานได้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:227
msgid "Si ce processus échoue, l'export HTML n'est pas écrit (raison affichée) ; le rapport d'incident, lui, est quand même écrit dans la langue de l'interface, avec un avertissement."
msgstr "ถ้าโปรเซสนั้นล้มเหลว จะไม่เขียนการส่งออก HTML (แสดงเหตุผล) ส่วนรายงานเหตุการณ์ยังคงถูกเขียนเป็นภาษาของอินเทอร์เฟซ พร้อมคำเตือน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:232
msgid "Supprimer les exports / Supprimer les screenshots"
msgstr "ลบไฟล์ส่งออก / ลบภาพหน้าจอ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:233
msgid "Vide complètement le répertoire concerne."
msgstr "ล้างไดเรกทอรีที่เกี่ยวข้องทั้งหมด"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:234
msgid "Confirmation obligatoire."
msgstr "ต้องยืนยัน"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:235
msgid "Suppression immédiate et définitive de tous les fichiers du répertoire."
msgstr "ลบไฟล์ทั้งหมดในไดเรกทอรีทันทีและถาวร"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:236
msgid "Action irréversible."
msgstr "การกระทำที่ย้อนกลับไม่ได้"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:239
msgid "Ne touche jamais config/omega-serve.json - réglages purement locaux à cette interface."
msgstr "ไม่แตะ config/omega-serve.json เลย - เป็นการตั้งค่าเฉพาะของอินเทอร์เฟซนี้"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:12
#: src/omega_serv/interfaces/tui/guide/content/faq.py:28
#: src/omega_serv/interfaces/tui/guide/content/faq.py:40
#: src/omega_serv/interfaces/tui/guide/content/faq.py:52
#: src/omega_serv/interfaces/tui/guide/content/faq.py:72
msgid "Redémarrage et rechargement"
msgstr "การรีสตาร์ทและการโหลดใหม่"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:13
msgid "J'ai active/modifie une option, mais rien ne change sur le serveur - pourquoi ?"
msgstr "ฉันเปิด/แก้ไขตัวเลือกแล้ว แต่ไม่มีอะไรเปลี่ยนบนเซิร์ฟเวอร์ - ทำไม?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:15
msgid "Le serveur tourne dans un PROCESSUS DÉJÀ LANCÉ, séparé de l'interface. Écrire un changement dans le fichier de configuration ne le fait jamais relire tout seul par ce processus : il faut soit le RECHARGER (SIGHUP, écran SERVICE -> Recharger - léger, aucune coupure de connexion), soit le REDÉMARRER COMPLÈTEMENT (coupe toutes les connexions en cours). La plupart des écrans de configuration détaillée déclenchent désormais ce rechargement automatiquement dès qu'un service systemd actif est détecté, et vous avertissent sinon. Quelques réglages (bind/port, listen_backlog, TLS, 1ere activation de fastcgi/reverse_proxy, active_defense) exigent toujours un redémarrage complet - jamais un simple rechargement - car ils touchent le socket d'écoute ou des composants construits une seule fois au démarrage."
msgstr "เซิร์ฟเวอร์ทำงานอยู่ในโปรเซสที่เริ่มไว้แล้ว ซึ่งแยกจากอินเทอร์เฟซ การเขียนการเปลี่ยนแปลงลงในไฟล์การตั้งค่าไม่ทำให้โปรเซสนั้นอ่านใหม่เอง ต้องโหลดใหม่ (SIGHUP หน้าจอ SERVICE -> โหลดใหม่ - เบา ไม่ตัดการเชื่อมต่อ) หรือรีสตาร์ทเต็มรูปแบบ (ตัดการเชื่อมต่อทั้งหมดที่ดำเนินอยู่) หน้าจอการตั้งค่าโดยละเอียดส่วนใหญ่จะโหลดใหม่อัตโนมัติเมื่อพบบริการ systemd ที่ทำงานอยู่ และจะเตือนคุณหากไม่พบ การตั้งค่าบางรายการ (bind/port, listen_backlog, TLS, การเปิด fastcgi/reverse_proxy ครั้งแรก, active_defense) ต้องรีสตาร์ทเต็มรูปแบบเสมอ - ไม่ใช่แค่โหลดใหม่ - เพราะเกี่ยวกับ socket ที่รับฟังหรือส่วนประกอบที่สร้างเพียงครั้งเดียวตอนเริ่มต้น"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:29
msgid "Après une mise à jour d'omega-serv, mes nouveaux réglages ne s'appliquent pas alors que le service est « rechargé » - pourquoi ?"
msgstr "หลังอัปเดต omega-serv การตั้งค่าใหม่ไม่มีผลแม้บริการจะ « โหลดใหม่ » แล้ว - เพราะอะไร?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:31
msgid "Un rechargement ne relit que la configuration, jamais le programme déjà chargé en mémoire. Si le service tournait déjà avant l'extraction de la mise à jour, il exécute toujours l'ancienne version, qui ignore les réglages apparus depuis. Redémarrez le service une fois après chaque mise à jour (écran SERVICE -> Redémarrer). L'interface le signale : notification à l'accueil, et avertissement après chaque rechargement, tant que le service n'a pas été redémarré (systemd et runit)."
msgstr "การโหลดใหม่อ่านเฉพาะการตั้งค่าซ้ำ ไม่เคยอ่านโปรแกรมที่โหลดอยู่ในหน่วยความจำแล้วซ้ำ หากบริการทำงานอยู่ก่อนแตกไฟล์อัปเดต ก็ยังรันเวอร์ชันเก่าที่ไม่รู้จักการตั้งค่าที่เพิ่มมาภายหลัง ให้รีสตาร์ทบริการหนึ่งครั้งหลังการอัปเดตแต่ละครั้ง (หน้าจอ SERVICE -> รีสตาร์ท) อินเทอร์เฟซจะแจ้งให้ทราบ: การแจ้งเตือนที่หน้าหลัก และคำเตือนหลังการโหลดใหม่แต่ละครั้ง จนกว่าจะรีสตาร์ทบริการ (systemd และ runit)"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:41
msgid "Comment savoir si un changement précis a besoin d'un rechargement ou d'un redémarrage complet ?"
msgstr "จะรู้ได้อย่างไรว่าการเปลี่ยนแปลงหนึ่งต้องโหลดใหม่หรือรีสตาร์ทเต็มรูปแบบ?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:43
msgid "La réaction exacte de chaque champ est indiquée dans sa fiche du guide (touche F1 depuis l'écran concerne). En règle générale : tout ce qui touche le socket d'écoute (adresse, port, listen_backlog), le contexte TLS, ou un composant construit une seule fois au démarrage (client FastCGI/reverse proxy à la première activation, Active Defense) exige un redémarrage complet. Tout le reste se recharge à chaud."
msgstr "ผลที่แน่นอนของแต่ละฟิลด์ระบุไว้ในหัวข้อของคู่มือ (ปุ่ม F1 จากหน้าจอนั้น) โดยทั่วไป: ทุกอย่างที่เกี่ยวกับ socket ที่รับฟัง (ที่อยู่ พอร์ต listen_backlog) บริบท TLS หรือส่วนประกอบที่สร้างเพียงครั้งเดียวตอนเริ่มต้น (ไคลเอนต์ FastCGI/reverse proxy เมื่อเปิดครั้งแรก, Active Defense) ต้องรีสตาร์ทเต็มรูปแบบ ที่เหลือทั้งหมดโหลดใหม่ได้ขณะทำงาน"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:54
msgid "J'ai mis à jour le code d'OMEGA-SERV (nouvelle archive, correctif appliqué) mais le comportement ne change jamais, même après un rechargement (SIGHUP) - pourquoi ?"
msgstr "ฉันอัปเดตโค้ดของ OMEGA-SERV แล้ว (ไฟล์เก็บถาวรใหม่ ใช้แพตช์แล้ว) แต่พฤติกรรมไม่เปลี่ยนเลย แม้หลังโหลดใหม่ (SIGHUP) - ทำไม?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:58
msgid "Piège réel rencontré (2026-10-10, correctif du rendu du directory listing sous une CSP stricte) : le rechargement à chaud (SIGHUP, écran SERVICE -> Recharger) ne relit QUE certains éléments de CONFIGURATION (règles WAF, zones d'authentification) - il ne recharge JAMAIS le CODE Python lui-même, qui reste celui chargé en mémoire depuis le DERNIER DÉMARRAGE du processus, aussi anciens soient les fichiers sur disque. Après une mise à jour du code (nouvelle archive installée, correctif appliqué), un REDÉMARRAGE COMPLET est TOUJOURS nécessaire (`systemctl restart <service>`, ou écran SERVICE -> Arrêter puis Démarrer) - jamais un simple rechargement, même pour un changement qui semble léger. Vérifiez `systemctl status <service>` : une date de démarrage ('Active: active (running) since ...') plus ancienne que votre mise à jour confirme immédiatement ce diagnostic."
msgstr "กับดักที่เจอจริง (2026-10-10 การแก้ไขการแสดงผล directory listing ภายใต้ CSP ที่เข้มงวด): การโหลดใหม่ขณะทำงาน (SIGHUP หน้าจอ SERVICE -> โหลดใหม่) อ่านเฉพาะบางส่วนของการตั้งค่า (กฎ WAF โซนการยืนยันตัวตน) - ไม่เคยโหลดโค้ด Python ใหม่ ซึ่งยังเป็นโค้ดที่โหลดไว้ในหน่วยความจำตั้งแต่โปรเซสเริ่มครั้งล่าสุด ไม่ว่าไฟล์บนดิสก์จะใหม่แค่ไหน หลังอัปเดตโค้ด (ติดตั้งไฟล์เก็บถาวรใหม่ ใช้แพตช์) ต้องรีสตาร์ทเต็มรูปแบบเสมอ (`systemctl restart <service>` หรือหน้าจอ SERVICE -> หยุด แล้วเริ่ม) - ไม่ใช่แค่โหลดใหม่ แม้การเปลี่ยนแปลงจะดูเล็กน้อย ตรวจสอบ `systemctl status <service>`: หากวันที่เริ่ม ('Active: active (running) since ...') เก่ากว่าการอัปเดตของคุณ ก็ยืนยันการวินิจฉัยนี้ได้ทันที"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:73
msgid "Le rechargement/redemarrage automatique ne s'est pas déclenché - pourquoi ?"
msgstr "การโหลดใหม่/รีสตาร์ทอัตโนมัติไม่ทำงาน - ทำไม?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:75
msgid "Le déclenchement automatique ne fonctionne que si un gestionnaire de service système (systemd/OpenRC/runit) est reconnu ET qu'un service est réellement ACTIF pour ce répertoire. Si vous faites tourner le serveur via l'assistant premier lancement (\"Lancer maintenant\", sans service installé), aucun rechargement automatique n'est possible - relancez manuellement, ou installez le service depuis l'écran SERVICE."
msgstr "การเรียกใช้อัตโนมัติทำงานเฉพาะเมื่อตรวจพบตัวจัดการบริการระบบ (systemd/OpenRC/runit) และมีบริการที่ทำงานอยู่จริงสำหรับไดเรกทอรีนี้ หากคุณเรียกใช้เซิร์ฟเวอร์ผ่านตัวช่วยตั้งค่าครั้งแรก (\"เรียกใช้ทันที\" โดยไม่ได้ติดตั้งบริการ) จะโหลดใหม่อัตโนมัติไม่ได้ - เริ่มใหม่ด้วยตนเอง หรือติดตั้งบริการจากหน้าจอ SERVICE"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:84
#: src/omega_serv/interfaces/tui/guide/content/faq.py:95
msgid "Service système"
msgstr "บริการระบบ"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:85
msgid "Juste après 'Installer l'unité', l'écran État & Ressources affiche 'Arrêté' alors que le service tourne - pourquoi ?"
msgstr "ทันทีหลัง 'ติดตั้งยูนิต' หน้าจอสถานะและทรัพยากรแสดง 'หยุด' ทั้งที่บริการทำงานอยู่ - ทำไม?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:87
msgid "L'installation crée un compte système dédié et ajoute votre session au groupe correspondant, mais l'appartenance à un NOUVEAU groupe Unix ne s'applique jamais à une session déjà ouverte (même terminal déjà lancé avant l'installation). Déconnectez-vous puis reconnectez-vous UNE SEULE FOIS - l'écran affichera alors l'état réel. En attendant, vérifiez via l'écran SERVICE ou `systemctl status`."
msgstr "การติดตั้งจะสร้างบัญชีระบบเฉพาะและเพิ่มเซสชันของคุณเข้ากลุ่มที่เกี่ยวข้อง แต่การเป็นสมาชิกกลุ่ม Unix ใหม่จะไม่มีผลกับเซสชันที่เปิดอยู่แล้ว (รวมถึงเทอร์มินัลที่เปิดก่อนการติดตั้ง) ออกจากระบบแล้วเข้าสู่ระบบใหม่เพียงครั้งเดียว - หน้าจอจะแสดงสถานะจริง ระหว่างนี้ให้ตรวจสอบผ่านหน้าจอ SERVICE หรือ `systemctl status`"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:96
msgid "Le champ 'Nom du service' dans l'écran SERVICE ne correspond pas à ce que je pilote ailleurs - pourquoi ?"
msgstr "ฟิลด์ 'ชื่อบริการ' ในหน้าจอ SERVICE ไม่ตรงกับสิ่งที่ฉันควบคุมที่อื่น - ทำไม?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:98
msgid "Ce champ persiste une préférence d'interface, distincte de la configuration serveur. Si cette instance est enregistrée en multi-instance, le nom est FIGÉ (celui choisi à la création) - jamais improvisé ici. Une seule interface peut déjà piloter n'importe quelle unité installée en tapant simplement son nom exact, même celle d'une autre copie du projet."
msgstr "ฟิลด์นี้เก็บค่าที่ตั้งไว้ของอินเทอร์เฟซ ซึ่งแยกจากการตั้งค่าเซิร์ฟเวอร์ หากอินสแตนซ์นี้ลงทะเบียนในโหมดหลายอินสแตนซ์ ชื่อจะถูกตรึงไว้ (ชื่อที่เลือกตอนสร้าง) - ไม่ได้กำหนดขึ้นที่นี่ อินเทอร์เฟซเดียวสามารถควบคุมยูนิตใดก็ได้ที่ติดตั้งไว้ เพียงพิมพ์ชื่อที่ถูกต้อง แม้จะเป็นยูนิตของสำเนาโปรเจกต์อื่น"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:106
#: src/omega_serv/interfaces/tui/guide/content/faq.py:118
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:115
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:76
#: src/omega_serv/interfaces/tui/screens/home.py:84
msgid "Multi-instance"
msgstr "หลายอินสแตนซ์"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:107
msgid "Puis-je installer une seconde unité systemd qui pointe vers le même répertoire, sous un autre nom ?"
msgstr "ฉันติดตั้งยูนิต systemd ตัวที่สองที่ชี้ไปยังไดเรกทอรีเดียวกันภายใต้ชื่ออื่นได้หรือไม่?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:109
msgid "Non - deux garde-fous bloquent explicitement cette situation avant toute écriture : une unité différente pointant déjà vers ce répertoire (partagerait silencieusement var/, la configuration et le compte système dédié), et un nom déjà utilisé par une unité pointant vers un AUTRE répertoire (volerait ce nom, écrasant l'unité existante). Pour héberger plusieurs serveurs, utilisez Multi-instance : chaque instance a son propre répertoire, sa propre configuration et son propre compte système."
msgstr "ไม่ได้ - มีกลไกป้องกันสองชั้นที่บล็อกสถานการณ์นี้อย่างชัดเจนก่อนการเขียนใดๆ: ยูนิตอื่นที่ชี้ไปยังไดเรกทอรีนี้อยู่แล้ว (จะใช้ var/ การตั้งค่า และบัญชีระบบเฉพาะร่วมกันโดยไม่รู้ตัว) และชื่อที่ถูกใช้โดยยูนิตที่ชี้ไปยังไดเรกทอรีอื่น (จะแย่งชื่อนั้นและเขียนทับยูนิตที่มีอยู่) หากต้องการโฮสต์หลายเซิร์ฟเวอร์ ให้ใช้หลายอินสแตนซ์: แต่ละอินสแตนซ์มีไดเรกทอรี การตั้งค่า และบัญชีระบบของตัวเอง"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:119
msgid "La création d'une nouvelle instance échoue à l'étape 4/6 (Installation des dépendances) - pourquoi ?"
msgstr "การสร้างอินสแตนซ์ใหม่ล้มเหลวที่ขั้นตอน 4/6 (การติดตั้ง dependency) - ทำไม?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:121
msgid "Piège réel corrigé : si le message d'échec mentionne 'omega-lib' et 'No matching distribution found', c'était un bug de la création d'instance elle-même, pas une erreur de votre part - omega-lib n'est pas publiée sur PyPI, et l'ancienne version ne savait retrouver sa source réelle (vendorée ou depuis un clone de développement) que dans un seul des deux cas. Corrigé : la nouvelle instance réutilise désormais la même source qu'omega-lib déjà installée pour l'instance en cours, quelle que soit sa provenance. Si l'échec persiste malgré une version à jour, vérifiez que le réseau est disponible pour les AUTRES dépendances (`textual`, `pyte`, `jinja2`, `psutil`), qui viennent bien de PyPI."
msgstr "กับดักจริงที่แก้ไขแล้ว: หากข้อความความล้มเหลวกล่าวถึง 'omega-lib' และ 'No matching distribution found' นั่นเป็นบั๊กของการสร้างอินสแตนซ์เอง ไม่ใช่ความผิดพลาดของคุณ - omega-lib ไม่ได้เผยแพร่บน PyPI และเวอร์ชันเก่าหาแหล่งที่มาจริง (vendored หรือจากโคลนสำหรับพัฒนา) ได้เพียงกรณีเดียวจากสองกรณี แก้ไขแล้ว: อินสแตนซ์ใหม่ใช้แหล่งเดียวกับ omega-lib ที่ติดตั้งไว้แล้วสำหรับอินสแตนซ์ปัจจุบัน ไม่ว่าจะมาจากที่ใด หากยังล้มเหลวแม้ใช้เวอร์ชันล่าสุด ให้ตรวจสอบว่าเครือข่ายใช้งานได้สำหรับ dependency อื่นๆ (`textual`, `pyte`, `jinja2`, `psutil`) ซึ่งมาจาก PyPI จริง"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:133
#: src/omega_serv/interfaces/tui/guide/content/faq.py:143
#: src/omega_serv/interfaces/tui/guide/content/faq.py:156
