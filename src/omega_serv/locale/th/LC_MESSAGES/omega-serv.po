msgstr "อัลกอริทึมและขนาดของคีย์ส่วนตัวที่สร้าง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:102
msgid "Valeurs valides indiquées dans le sous-titre. Valeur par défaut : rsa2048."
msgstr "ค่าที่ใช้ได้ระบุในคำบรรยาย ค่าเริ่มต้น: rsa2048"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:107
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:59
msgid "Mot de passe de clé (optionnel)"
msgstr "รหัสผ่านคีย์ (ไม่บังคับ)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:108
msgid "Passphrase protégeant la clé privée générée."
msgstr "passphrase ที่ป้องกันคีย์ส่วนตัวที่สร้าง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:109
msgid "Chaîne libre, optionnelle - saisie masquée."
msgstr "ข้อความอิสระ ไม่บังคับ - ซ่อนขณะพิมพ์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:115
msgid "Génère réellement des fichiers sur disque des le clic sur Générer. Si TLS est DÉJÀ actif, le serveur en cours d'exécution continue de servir l'ANCIEN certificat jusqu'à un REDÉMARRAGE COMPLET, même si le fichier a changé (le contexte SSL n'est construit qu'une seule fois au démarrage)."
msgstr "สร้างไฟล์บนดิสก์จริงทันทีที่คลิกสร้าง หาก TLS ทำงานอยู่แล้ว เซิร์ฟเวอร์ที่ทำงานอยู่จะยังใช้ใบรับรองเก่าจนกว่าจะรีสตาร์ทเต็มรูปแบบ แม้ไฟล์จะเปลี่ยนแล้ว (บริบท SSL สร้างเพียงครั้งเดียวตอนเริ่มต้น)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:124
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:59
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:32
msgid "Assistant CA locale"
msgstr "ตัวช่วย CA ภายในเครื่อง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:125
msgid "Configuration détaillée -> TLS -> Assistant CA locale"
msgstr "การตั้งค่าโดยละเอียด -> TLS -> ตัวช่วย CA ภายในเครื่อง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:127
msgid "Enchaîne trois étapes indépendantes : générer une autorité de certification locale, générer une demande de signature (CSR) pour ce serveur, signer cette CSR avec la CA - permet d'obtenir un certificat reconnu par les clients ayant importe la CA, sans passer par une autorité publique."
msgstr "ทำสามขั้นตอนอิสระต่อกัน: สร้างผู้ออกใบรับรองภายในเครื่อง สร้างคำขอลงนาม (CSR) สำหรับเซิร์ฟเวอร์นี้ ลงนาม CSR นี้ด้วย CA - ทำให้ได้ใบรับรองที่ไคลเอนต์ซึ่งนำเข้า CA แล้วยอมรับ โดยไม่ต้องผ่านผู้ออกใบรับรองสาธารณะ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:134
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:86
msgid "1. Générer la CA"
msgstr "1. สร้าง CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:135
msgid "Crée l'autorité de certification locale (clé + certificat racine)."
msgstr "สร้างผู้ออกใบรับรองภายในเครื่อง (คีย์ + ใบรับรองราก)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:136
msgid "CN, organisation, validité (défaut 3650 jours), type de clé, passphrase OBLIGATOIRE (saisie deux fois)."
msgstr "CN องค์กร อายุการใช้งาน (ค่าเริ่มต้น 3650 วัน) ประเภทคีย์ passphrase ที่จำเป็น (ป้อนสองครั้ง)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:137
msgid "Écrit root-ca.key/root-ca.pem/serial.txt/index.txt sous secure/certificates/ca/."
msgstr "เขียน root-ca.key/root-ca.pem/serial.txt/index.txt ใต้ secure/certificates/ca/"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:138
msgid "Écrit réellement sur disque immédiatement. À faire une seule fois."
msgstr "เขียนลงดิสก์จริงทันที ทำเพียงครั้งเดียว"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:141
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:88
msgid "2. Générer la CSR"
msgstr "2. สร้าง CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:142
msgid "Crée une demande de signature de certificat pour CE serveur."
msgstr "สร้างคำขอลงนามใบรับรองสำหรับเซิร์ฟเวอร์นี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:143
msgid "CN, SAN DNS/IP, identité, type de clé - pas de passphrase ici."
msgstr "CN, SAN DNS/IP ข้อมูลตัวตน ประเภทคีย์ - ไม่มี passphrase ที่นี่"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:144
msgid "Écrit le fichier .csr à côté de la clé privée du serveur."
msgstr "เขียนไฟล์ .csr ไว้ข้างคีย์ส่วนตัวของเซิร์ฟเวอร์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:145
msgid "Écrit réellement sur disque immédiatement."
msgstr "เขียนลงดิสก์จริงทันที"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:148
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:90
msgid "3. Signer la CSR"
msgstr "3. ลงนาม CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:149
msgid "Signe la CSR générée à l'étape 2 avec la CA de l'étape 1, produit le certificat final."
msgstr "ลงนาม CSR ที่สร้างในขั้นตอนที่ 2 ด้วย CA จากขั้นตอนที่ 1 ได้ใบรับรองสุดท้าย"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:150
msgid "Chemin de la CSR (pré-rempli), passphrase de la CA (resaisie), validité en jours (défaut 365)."
msgstr "พาธของ CSR (กรอกไว้) passphrase ของ CA (ป้อนใหม่) อายุการใช้งานเป็นวัน (ค่าเริ่มต้น 365)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:151
msgid "Écrit le certificat signé (et la chaîne complète) sur disque."
msgstr "เขียนใบรับรองที่ลงนามแล้ว (และ chain เต็ม) ลงดิสก์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:153
msgid "Écrit réellement sur disque immédiatement. Si TLS est DÉJÀ actif, un REDÉMARRAGE COMPLET reste nécessaire pour que le serveur serve ce nouveau certificat (le contexte SSL en mémoire ne se recharge jamais tout seul)."
msgstr "เขียนลงดิสก์จริงทันที หาก TLS ทำงานอยู่แล้ว ยังต้องรีสตาร์ทเต็มรูปแบบเพื่อให้เซิร์ฟเวอร์ใช้ใบรับรองใหม่นี้ (บริบท SSL ในหน่วยความจำไม่โหลดใหม่เอง)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:160
msgid "Le certificat racine de la CA (root-ca.pem) doit être importe manuellement dans le magasin de confiance de chaque client pour que le certificat final soit reconnu - rappelé dans le journal de l'assistant après chaque étape réussie."
msgstr "ใบรับรองรากของ CA (root-ca.pem) ต้องนำเข้าด้วยมือไปยังที่เก็บใบรับรองที่เชื่อถือของไคลเอนต์แต่ละเครื่อง เพื่อให้ใบรับรองสุดท้ายได้รับการยอมรับ - มีการเตือนในบันทึกของตัวช่วยหลังแต่ละขั้นตอนที่สำเร็จ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:166
msgid "La passphrase de la CA n'est jamais conservée en mémoire entre les étapes - elle est resaisie explicitement à l'étape 3."
msgstr "passphrase ของ CA ไม่ถูกเก็บในหน่วยความจำระหว่างขั้นตอน - ต้องป้อนใหม่อย่างชัดเจนในขั้นตอนที่ 3"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:174
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:60
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:33
msgid "Assistant Let's Encrypt (Certbot)"
msgstr "ตัวช่วย Let's Encrypt (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:175
msgid "Configuration détaillée -> TLS -> Assistant Let's Encrypt (Certbot)"
msgstr "การตั้งค่าโดยละเอียด -> TLS -> ตัวช่วย Let's Encrypt (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:177
msgid "Obtient un certificat public reconnu par les navigateurs via Certbot (défi HTTP-01, mode webroot) - jamais --standalone (le port 80 est déjà occupé par OMEGA-SERV) et jamais /etc/letsencrypt/ (tout est écrit sous secure/certificates/letsencrypt/ du projet, entièrement non-privilégié). Importe automatiquement le certificat obtenu et installe un script de renouvellement (voir Renouvellement automatique (Certbot))."
msgstr "ขอใบรับรองสาธารณะที่เบราว์เซอร์ยอมรับผ่าน Certbot (challenge HTTP-01 โหมด webroot) - ไม่ใช้ --standalone (พอร์ต 80 ถูก OMEGA-SERV ใช้อยู่แล้ว) และไม่ใช้ /etc/letsencrypt/ (ทุกอย่างเขียนใต้ secure/certificates/letsencrypt/ ของโปรเจกต์ ไม่ต้องใช้สิทธิ์พิเศษเลย) นำเข้าใบรับรองที่ได้โดยอัตโนมัติและติดตั้งสคริปต์ต่ออายุ (ดูการต่ออายุอัตโนมัติ (Certbot))"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:185
msgid "Domaine"
msgstr "โดเมน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:186
msgid "Nom de domaine public déjà pointé vers ce serveur (obligatoire)."
msgstr "ชื่อโดเมนสาธารณะที่ชี้มายังเซิร์ฟเวอร์นี้แล้ว (จำเป็น)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:187
msgid "Ex : monserveur.dynu.com - un DDNS (Dynu ou équivalent) reste à configurer par vous-même, hors de cet assistant."
msgstr "เช่น monserveur.dynu.com - DDNS (Dynu หรือเทียบเท่า) ต้องตั้งค่าเองนอกตัวช่วยนี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:188
msgid "Utilisé pour la demande Certbot et le défi HTTP-01."
msgstr "ใช้สำหรับคำขอ Certbot และ challenge HTTP-01"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:189
msgid "Aucun effet avant confirmation - le résumé préalable rappelle le domaine et le mode choisis."
msgstr "ไม่มีผลก่อนยืนยัน - สรุปก่อนหน้าจะทวนโดเมนและโหมดที่เลือก"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:192
msgid "Email"
msgstr "อีเมล"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:193
msgid "Adresse utilisée par Let's Encrypt pour les alertes d'expiration (optionnelle)."
msgstr "ที่อยู่ที่ Let's Encrypt ใช้ส่งการแจ้งเตือนเรื่องวันหมดอายุ (ไม่บังคับ)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:194
msgid "Chaîne libre. Vide : Certbot s'enregistre sans email (--register-unsafely-without-email)."
msgstr "ข้อความอิสระ ว่าง: Certbot ลงทะเบียนโดยไม่มีอีเมล (--register-unsafely-without-email)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:195
msgid "Transmis à Certbot à la demande."
msgstr "ส่งให้ Certbot ตอนขอใบรับรอง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:196
msgid "Aucun effet avant confirmation."
msgstr "ไม่มีผลก่อนยืนยัน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:199
msgid "Mode test (staging)"
msgstr "โหมดทดสอบ (staging)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:200
msgid "Utilise l'environnement de test de Let's Encrypt plutôt que la production."
msgstr "ใช้สภาพแวดล้อมทดสอบของ Let's Encrypt แทน production"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:201
msgid "Case à cocher, COCHÉE PAR DÉFAUT - certificat non reconnu par les navigateurs mais jamais soumis aux limites de taux réelles."
msgstr "ช่องทำเครื่องหมาย เลือกไว้โดยค่าเริ่มต้น - ใบรับรองที่เบราว์เซอร์ไม่ยอมรับ แต่ไม่อยู่ภายใต้ขีดจำกัดอัตราจริง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:202
msgid "Transmis à Certbot (--staging) si coché."
msgstr "ส่งให้ Certbot (--staging) หากเลือก"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:203
msgid "À décocher seulement une fois le domaine/webroot vérifiés fonctionnels en mode test."
msgstr "ยกเลิกการเลือกเมื่อยืนยันแล้วว่าโดเมน/webroot ทำงานได้ในโหมดทดสอบ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:206
#: src/omega_serv/interfaces/tui/screens/lets_encrypt_screen.py:70
msgid "Obtenir le certificat"
msgstr "ขอใบรับรอง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:207
msgid "Lance la demande après un résumé et une confirmation explicite."
msgstr "เริ่มการขอหลังสรุปและการยืนยันอย่างชัดเจน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:208
msgid "Aucune saisie - déclenche l'appel réseau réel à Let's Encrypt."
msgstr "ไม่ต้องป้อนข้อมูล - เรียกเครือข่ายไปยัง Let's Encrypt จริง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:209
msgid "Exécute Certbot puis importe le certificat obtenu (déporté dans un thread de travail, l'interface reste réactive)."
msgstr "เรียกใช้ Certbot แล้วนำเข้าใบรับรองที่ได้ (ทำงานใน thread แยก อินเทอร์เฟซยังตอบสนอง)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:211
msgid "Écrit réellement sur disque en cas de succès. Si TLS est DÉJÀ actif, le serveur en cours d'exécution continue de servir l'ANCIEN certificat jusqu'à un REDÉMARRAGE COMPLET."
msgstr "เขียนลงดิสก์จริงหากสำเร็จ หาก TLS ทำงานอยู่แล้ว เซิร์ฟเวอร์ที่ทำงานอยู่จะยังใช้ใบรับรองเก่าจนกว่าจะรีสตาร์ทเต็มรูปแบบ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:218
msgid "Le port 80 doit rester accessible depuis Internet le temps du défi HTTP-01 (webroot) - échoue sinon (pare-feu, redirection de port non faite sur le routeur, DNS/DDNS pas encore propagé). Soumis aux limites de taux réelles de Let's Encrypt en mode production (jamais en mode test)."
msgstr "พอร์ต 80 ต้องเข้าถึงได้จากอินเทอร์เน็ตตลอด challenge HTTP-01 (webroot) - มิฉะนั้นจะล้มเหลว (ไฟร์วอลล์ ยังไม่ได้ส่งต่อพอร์ตบนเราเตอร์ DNS/DDNS ยังไม่กระจาย) อยู่ภายใต้ขีดจำกัดอัตราจริงของ Let's Encrypt ในโหมด production (ไม่ใช่ในโหมดทดสอบ)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:225
msgid "Le DDNS (Dynu ou équivalent) et la redirection de port restent ENTIÈREMENT à votre charge - cet assistant ne configure jamais rien en dehors de ce serveur."
msgstr "DDNS (Dynu หรือเทียบเท่า) และการส่งต่อพอร์ตเป็นความรับผิดชอบของคุณทั้งหมด - ตัวช่วยนี้ไม่ตั้งค่าสิ่งใดนอกเซิร์ฟเวอร์นี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:229
msgid "Si OMEGA-SERV tourne dans un conteneur : exécutez cet assistant HORS du conteneur qui sert le trafic (sur l'hôte, ou un conteneur/sidecar distinct partageant le même volume secure/ et le même webroot) - jamais Certbot à l'intérieur du conteneur servant déjà le trafic public, voir la FAQ."
msgstr "หาก OMEGA-SERV ทำงานในคอนเทนเนอร์: เรียกใช้ตัวช่วยนี้นอกคอนเทนเนอร์ที่ให้บริการทราฟฟิก (บนโฮสต์ หรือคอนเทนเนอร์/sidecar แยกที่แชร์ volume secure/ และ webroot เดียวกัน) - ห้ามรัน Certbot ภายในคอนเทนเนอร์ที่ให้บริการทราฟฟิกสาธารณะอยู่ ดูคำถามพบบ่อย"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:239
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:61
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:34
msgid "Renouvellement automatique (Certbot)"
msgstr "การต่ออายุอัตโนมัติ (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:240
msgid "Configuration détaillée -> TLS -> Renouvellement automatique (Certbot)"
msgstr "การตั้งค่าโดยละเอียด -> TLS -> การต่ออายุอัตโนมัติ (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:242
msgid "Planifie le renouvellement automatique des certificats Certbot déjà obtenus (Assistant Let's Encrypt) - s'adapte au gestionnaire de service réellement détecté pour CETTE instance : timer systemd installé depuis l'interface, sinon une ligne crontab si possible, sinon des instructions manuelles affichées sans rien écrire. Jamais un mécanisme global partagé entre plusieurs instances multi-instance."
msgstr "ตั้งเวลาการต่ออายุอัตโนมัติของใบรับรอง Certbot ที่ได้มาแล้ว (ตัวช่วย Let's Encrypt) - ปรับตามตัวจัดการบริการที่ตรวจพบจริงสำหรับอินสแตนซ์นี้: timer systemd ที่ติดตั้งจากอินเทอร์เฟซ หรือบรรทัด crontab หากทำได้ หรือแสดงคำแนะนำให้ทำด้วยมือโดยไม่เขียนอะไร ไม่ใช่กลไกส่วนกลางที่ใช้ร่วมกันระหว่างหลายอินสแตนซ์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:250
#: src/omega_serv/interfaces/tui/screens/renewal_schedule_screen.py:51
msgid "Configurer maintenant"
msgstr "ตั้งค่าเดี๋ยวนี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:251
msgid "Installe (ou réinstalle) le mécanisme de renouvellement adapté à ce système."
msgstr "ติดตั้ง (หรือติดตั้งใหม่) กลไกการต่ออายุที่เหมาะกับระบบนี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:254
msgid "systemd : écrit et active un timer (sudo ponctuel, même mécanisme que l'écran SERVICE). OpenRC/runit/aucun gestionnaire reconnu : ajoute une ligne à votre crontab utilisateur si `crontab` est disponible, sinon affiche la ligne à ajouter vous-même."
msgstr "systemd: เขียนและเปิดใช้ timer (sudo ชั่วคราว กลไกเดียวกับหน้าจอ SERVICE) OpenRC/runit/ไม่พบตัวจัดการ: เพิ่มบรรทัดใน crontab ของผู้ใช้หากมี `crontab` มิฉะนั้นจะแสดงบรรทัดให้คุณเพิ่มเอง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:259
msgid "Reconfigurer ne dupliqué jamais l'entrée (idempotent) - remplace toujours l'entrée précédente de CETTE instance."
msgstr "การตั้งค่าใหม่ไม่ทำให้รายการซ้ำ (idempotent) - แทนที่รายการก่อนหน้าของอินสแตนซ์นี้เสมอ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:263
msgid "Une fois installé, le renouvellement tourne deux fois par jour sans aucune intervention - le script de hook (Assistant Let's Encrypt) réimporte automatiquement chaque certificat renouvelé puis redémarre le service."
msgstr "เมื่อติดตั้งแล้ว การต่ออายุจะทำงานวันละสองครั้งโดยไม่ต้องทำอะไร - สคริปต์ hook (ตัวช่วย Let's Encrypt) จะนำเข้าใบรับรองที่ต่ออายุแต่ละใบใหม่โดยอัตโนมัติแล้วรีสตาร์ทบริการ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:269
msgid "Sur certaines distributions (dont Arch/Manjaro), le paquet Certbot n'installe AUCUN timer par défaut, contrairement à Debian/Ubuntu - vérifiez toujours le statut affiché ici plutôt que de supposer qu'un mécanisme existe déjà."
msgstr "ในบางดิสทริบิวชัน (รวมถึง Arch/Manjaro) แพ็กเกจ Certbot ไม่ติดตั้ง timer ใดเลยโดยค่าเริ่มต้น ต่างจาก Debian/Ubuntu - ตรวจสอบสถานะที่แสดงที่นี่เสมอ แทนที่จะคิดว่ามีกลไกอยู่แล้ว"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:274
msgid "Ne concerne QUE les certificats gérés par Certbot (secure/certificates/letsencrypt/) - un certificat auto-signé ou signé par la CA locale n'a pas besoin (et ne bénéficie pas) de ce renouvellement."
msgstr "เกี่ยวข้องเฉพาะใบรับรองที่ Certbot จัดการ (secure/certificates/letsencrypt/) - ใบรับรองแบบลงนามเองหรือที่ลงนามโดย CA ภายในเครื่องไม่ต้องการ (และไม่ได้ประโยชน์จาก) การต่ออายุนี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:283
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:62
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:35
msgid "Révoquer un certificat"
msgstr "เพิกถอนใบรับรอง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:284
msgid "Configuration détaillée -> TLS -> Révoquer un certificat"
msgstr "การตั้งค่าโดยละเอียด -> TLS -> เพิกถอนใบรับรอง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:285
msgid "Marque un certificat comme révoqué dans le registre de la CA (index.txt) - action irréversible pour ce certificat."
msgstr "ทำเครื่องหมายใบรับรองว่าเพิกถอนแล้วในทะเบียนของ CA (index.txt) - การกระทำที่ย้อนกลับไม่ได้สำหรับใบรับรองนี้"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:288
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:40
msgid "Certificat à révoquer"
msgstr "ใบรับรองที่จะเพิกถอน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:289
msgid "Chemin du certificat à marquer comme révoqué."
msgstr "พาธของใบรับรองที่จะทำเครื่องหมายว่าเพิกถอน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:290
msgid "Chemin relatif au projet."
msgstr "พาธสัมพัทธ์กับโปรเจกต์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:291
#: src/omega_serv/interfaces/tui/guide/content/tls.py:298
#: src/omega_serv/interfaces/tui/guide/content/tls.py:305
msgid "Utilisé à la confirmation."
msgstr "ใช้ตอนยืนยัน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:292
msgid "Modifie index.txt immédiatement après confirmation."
msgstr "แก้ไข index.txt ทันทีหลังยืนยัน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:295
msgid "Clé / Certificat de la CA"
msgstr "คีย์ / ใบรับรองของ CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:296
msgid "Identité de l'autorité de certification qui a signé le certificat visé."
msgstr "ตัวตนของผู้ออกใบรับรองที่ลงนามใบรับรองเป้าหมาย"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:297
msgid "Chemins pré-remplis vers secure/certificates/ca/."
msgstr "พาธที่กรอกไว้ล่วงหน้าไปยัง secure/certificates/ca/"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:299
#: src/omega_serv/interfaces/tui/guide/content/tls.py:306
msgid "Modifie index.txt immédiatement."
msgstr "แก้ไข index.txt ทันที"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:302
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:154
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:52
msgid "Passphrase de la clé CA"
msgstr "Passphrase ของคีย์ CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:303
msgid "Nécessaire pour prouver l'autorité sur la CA avant de révoquer."
msgstr "จำเป็นเพื่อพิสูจน์อำนาจเหนือ CA ก่อนเพิกถอน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:304
msgid "Saisie masquée."
msgstr "ซ่อนขณะพิมพ์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:310
msgid "Demande une confirmation explicite (action irréversible pour ce certificat). Si le certificat révoqué est celui ACTUELLEMENT utilisé par un serveur TLS déjà actif, un REDÉMARRAGE COMPLET est nécessaire, sinon il continue d'être présenté aux clients malgré sa révocation."
msgstr "ขอการยืนยันอย่างชัดเจน (การกระทำที่ย้อนกลับไม่ได้สำหรับใบรับรองนี้) หากใบรับรองที่เพิกถอนเป็นใบที่เซิร์ฟเวอร์ TLS ที่ทำงานอยู่ใช้อยู่ ต้องรีสตาร์ทเต็มรูปแบบ มิฉะนั้นจะยังถูกแสดงต่อไคลเอนต์แม้ถูกเพิกถอน"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:317
msgid "Pas de distribution CRL complète en V1 - la révocation reste locale (index.txt), jamais publiée vers les clients automatiquement."
msgstr "ไม่มีการแจกจ่าย CRL แบบเต็มใน V1 - การเพิกถอนเป็นแบบภายในเครื่อง (index.txt) ไม่ถูกเผยแพร่ไปยังไคลเอนต์โดยอัตโนมัติ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:325
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:63
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:36
msgid "Activer / désactiver TLS"
msgstr "เปิด / ปิด TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:326
msgid "Configuration détaillée -> TLS -> Activer / désactiver TLS"
msgstr "การตั้งค่าโดยละเอียด -> TLS -> เปิด / ปิด TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:327
msgid "Active ou désactive TLS, et choisit son mode (direct ou derrière un proxy qui termine déjà le TLS)."
msgstr "เปิดหรือปิด TLS และเลือกโหมด (โดยตรง หรืออยู่หลังพร็อกซีที่จัดการ TLS อยู่แล้ว)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:331
msgid "Comment TLS est géré par ce serveur."
msgstr "วิธีที่เซิร์ฟเวอร์นี้จัดการ TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:333
msgid "direct (ce serveur termine TLS lui-même, via ssl.SSLContext local) ou behind_proxy (TLS déjà terminé en amont, ce serveur reste en HTTP simple)."
msgstr "direct (เซิร์ฟเวอร์นี้จัดการ TLS เอง ผ่าน ssl.SSLContext ภายในเครื่อง) หรือ behind_proxy (TLS จัดการแล้วที่ต้นทาง เซิร์ฟเวอร์นี้ใช้ HTTP ธรรมดา)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:336
msgid "Enregistre au clic sur Activer TLS."
msgstr "บันทึกเมื่อคลิกเปิด TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:337
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET, jamais un simple rechargement."
msgstr "ต้องรีสตาร์ทเต็มรูปแบบเสมอ ไม่ใช่แค่โหลดใหม่"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:340
msgid "Chemin du certificat / de la clé privée"
msgstr "พาธของใบรับรอง / คีย์ส่วนตัว"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:341
msgid "Fichiers utilisés si le mode est 'direct'. Optionnels : conservent la valeur actuelle si vides."
msgstr "ไฟล์ที่ใช้หากโหมดเป็น 'direct' ไม่บังคับ: คงค่าปัจจุบันหากว่าง"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:342
msgid "Chemins relatifs au projet."
msgstr "พาธสัมพัทธ์กับโปรเจกต์"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:344
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET."
msgstr "ต้องรีสตาร์ทเต็มรูปแบบเสมอ"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:348
msgid "Le contexte SSL n'est construit qu'une seule fois au démarrage - activer, désactiver, ou changer le mode TLS exige SYSTÉMATIQUEMENT un redémarrage complet, que ce soit pour l'activation ou la désactivation."
msgstr "บริบท SSL สร้างเพียงครั้งเดียวตอนเริ่มต้น - การเปิด ปิด หรือเปลี่ยนโหมด TLS ต้องรีสตาร์ทเต็มรูปแบบทุกครั้ง ทั้งการเปิดและการปิด"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:354
msgid "À ne pas confondre avec le réglage 'reverse_proxy' (Configuration détaillée -> Reverse Proxy) : ici, 'behind_proxy' signifie qu'OMEGA-SERV est DERRIÈRE un proxy TLS externe, l'inverse d'agir soi-même comme proxy."
msgstr "อย่าสับสนกับการตั้งค่า 'reverse_proxy' (การตั้งค่าโดยละเอียด -> Reverse Proxy): ที่นี่ 'behind_proxy' หมายความว่า OMEGA-SERV อยู่หลังพร็อกซี TLS ภายนอก ตรงข้ามกับการทำหน้าที่เป็นพร็อกซีเอง"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:10
