#: src/omega_serv/interfaces/tui/screens/home.py:89
msgid "Active Sécurité"
msgstr "Активная безопасность"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:75
msgid ""
"Regroupe, dans l'ordre d'une attaque : WAF (protéger), Active Defense "
"(détecter), RIPOSTE (riposter dans la durée) et, dessous, INTERVENTION "
"MANUELLE (bannir ou débannir une adresse IP à la main)."
msgstr ""
"Объединяет в порядке атаки: WAF (защитить), Active Defense (обнаружить), "
"RIPOSTE (ответить во времени) и ниже — РУЧНОЕ ВМЕШАТЕЛЬСТВО (забанить или "
"разбанить IP-адрес вручную)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:77
msgid "À utiliser pour la sécurité active du serveur."
msgstr "Для активной защиты сервера."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:78
msgid "Ouvre le menu Active Sécurité."
msgstr "Открывает меню Активная безопасность."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:82
#: src/omega_serv/interfaces/tui/guide/content/divers.py:85
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:83
#: src/omega_serv/interfaces/tui/screens/home.py:86
msgid "Audit de sécurité"
msgstr "Аудит безопасности"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:83
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...)."
msgstr "Рекомендательные проверки (служба, ротация журналов, режим WAF...)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:84
msgid "À lancer ponctuellement pour un avis global."
msgstr "Запускается время от времени для общей оценки."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:85
msgid "Ouvre l'écran d'audit."
msgstr "Открывает экран аудита."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:89
#: src/omega_serv/interfaces/tui/guide/content/divers.py:102
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:84
#: src/omega_serv/interfaces/tui/screens/home.py:88
msgid "Sauvegarde de configuration"
msgstr "Резервное копирование"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:90
msgid ""
"Créer, lister, restaurer ou supprimer des sauvegardes complètes de la "
"configuration."
msgstr ""
"Создание, просмотр, восстановление и удаление полных резервных копий "
"конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:91
msgid ""
"À utiliser avant un changement risque, ou pour migrer une configuration."
msgstr "Перед рискованным изменением или для переноса конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:92
msgid "Ouvre l'écran de sauvegarde."
msgstr "Открывает экран резервного копирования."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:93
msgid ""
"Restaurer ÉCRASE directement les fichiers vises - voir sa propre fiche."
msgstr ""
"Восстановление напрямую ПЕРЕЗАПИСЫВАЕТ затронутые файлы - см. его "
"собственную карточку."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:96
msgid ""
"Cet écran ne modifie jamais la configuration lui-même - uniquement de la "
"navigation."
msgstr "Этот экран никогда сам не изменяет конфигурацию - только навигация."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:99
msgid ""
"Appuyer sur Échap depuis cet écran demande une confirmation de sortie de "
"l'application (contrairement aux autres écrans, où Échap revient simplement "
"en arrière)."
msgstr ""
"Нажатие Esc на этом экране запрашивает подтверждение выхода из приложения (в"
" отличие от других экранов, где Esc просто возвращает назад)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:12
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
msgid "Configuration détaillée (menu)"
msgstr "Подробная настройка (меню)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:13
msgid "Accueil -> Configuration détaillée"
msgstr "Главная -> Подробная настройка"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:15
msgid ""
"Sous-menu regroupant tous les écrans de configuration du serveur et des "
"options superposables, plus deux raccourcis (Voir options actives, Vérifier "
"la configuration)."
msgstr ""
"Подменю со всеми экранами настройки сервера и подключаемых параметров, плюс "
"два ярлыка (Активные параметры, Проверить конфигурацию)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:18
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:19
#: src/omega_serv/interfaces/tui/guide/content/tls.py:15
msgid "Aucune - purement navigation."
msgstr "Нет - только навигация."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:24
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:37
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:46
msgid "Configuration de base"
msgstr "Базовая настройка"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:25
msgid "Accueil -> Configuration détaillée -> Configuration de base"
msgstr "Главная -> Подробная настройка -> Базовая настройка"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:27
msgid ""
"Réglages fondamentaux du serveur : adresse d'écoute, port, nom de serveur "
"annoncé, fichiers d'index cherches dans un répertoire sans nom de fichier "
"explicite, moteur HTTP (Python ou natif C++)."
msgstr ""
"Основные настройки сервера: адрес прослушивания, порт, объявляемое имя "
"сервера, индексные файлы, которые ищутся в каталоге без явного имени файла, "
"HTTP-движок (Python или нативный C++)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:33
msgid "Adresse d'écoute (bind)"
msgstr "Адрес прослушивания (bind)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:34
msgid "Adresse IP sur laquelle le serveur accepte les connexions."
msgstr "IP-адрес, на котором сервер принимает соединения."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:36
msgid ""
"Une adresse IP valide - '127.0.0.1' (local uniquement) ou '0.0.0.0' (toutes "
"les interfaces réseau). Valeur par défaut : 127.0.0.1."
msgstr ""
"Допустимый IP-адрес - '127.0.0.1' (только локально) или '0.0.0.0' (все "
"сетевые интерфейсы). Значение по умолчанию: 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:39
msgid ""
"Enregistre dans server.bind après validation structurelle de la "
"configuration."
msgstr "Записывает в server.bind после структурной проверки конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:41
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - le socket d'écoute n'est jamais retouché "
"par un simple rechargement. Un bouton 'Redémarrer maintenant' est proposé "
"après l'enregistrement si un service est détecté."
msgstr ""
"Требует ПОЛНОГО ПЕРЕЗАПУСКА - слушающий сокет никогда не затрагивается "
"простой перезагрузкой. После сохранения предлагается кнопка 'Перезапустить "
"сейчас', если обнаружена служба."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:47
msgid "Port (port)"
msgstr "Порт (port)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:48
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:80
msgid "Port TCP d'écoute."
msgstr "TCP-порт прослушивания."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:50
msgid ""
"Un entier de port valide (1-65535 ; 0 signifie 'port libre choisi par le "
"système', surtout utile pour des tests). Valeur par défaut : 8080."
msgstr ""
"Допустимое целое число порта (1-65535; 0 означает 'свободный порт, выбранный"
" системой', полезно в основном для тестов). Значение по умолчанию: 8080."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:53
msgid "Enregistre dans server.port après validation."
msgstr "Записывает в server.port после проверки."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:54
msgid "Nécessite un REDÉMARRAGE COMPLET, même raison que l'adresse d'écoute."
msgstr ""
"Требует ПОЛНОГО ПЕРЕЗАПУСКА по той же причине, что и адрес прослушивания."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:57
msgid "Nom de serveur (server_name)"
msgstr "Имя сервера (server_name)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:58
msgid "Nom de serveur utilisé en interne (transmis notamment à FastCGI)."
msgstr "Имя сервера, используемое внутри (в частности передаётся FastCGI)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:59
msgid "Chaîne libre, optionnelle. Vide par défaut."
msgstr "Произвольная строка, необязательно. По умолчанию пусто."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:60
msgid "Enregistre dans server.server_name."
msgstr "Записывает в server.server_name."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:62
msgid ""
"Se recharge à chaud (pas de redémarrage complet nécessaire) - mais reste "
"sans effet tant qu'un rechargement du service en cours n'a pas eu lieu "
"(automatique si un service actif existe, sinon à faire manuellement depuis "
"l'écran SERVICE)."
msgstr ""
"Перезагружается на лету (полный перезапуск не нужен) - но не действует, пока"
" работающая служба не перезагружена (автоматически, если есть активная "
"служба, иначе вручную на экране СЛУЖБА)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:68
msgid "Fichiers d'index (index_files)"
msgstr "Индексные файлы (index_files)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:70
msgid ""
"Noms de fichiers cherches, dans l'ordre, quand une URL pointe vers un "
"répertoire sans fichier explicite."
msgstr ""
"Имена файлов, ищущиеся по порядку, когда URL указывает на каталог без явного"
" файла."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:73
msgid "Liste séparée par des virgules. Valeur par défaut : index.html."
msgstr "Список через запятую. Значение по умолчанию: index.html."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:74
msgid "Enregistre dans server.index_files."
msgstr "Записывает в server.index_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:75
msgid ""
"Même réaction que le nom de serveur - rechargement nécessaire, jamais un "
"redémarrage complet."
msgstr ""
"Та же реакция, что и у имени сервера - нужна перезагрузка, никогда не полный"
" перезапуск."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:78
msgid "Moteur HTTP (engine)"
msgstr "HTTP-движок (engine)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:80
msgid ""
"Programme qui traite les requêtes HTTP. Python (par défaut) : l'interpréteur"
" Python traite tout. Natif C++ (omega-http-core) : un programme compilé, qui"
" utilise tous les cœurs, traite lui-même le contenu statique, les "
"redirections, le cache et TLS ; il cherche lui-même les règles du WAF et "
"sert seul une requête sur laquelle aucune ne correspond ; il confie au "
"processus Python les autres contrôles de sécurité (requête suspecte ou "
"douteuse, Active Defense, authentification), le listing, les pages internes "
"et les routes applicatives (reverse proxy, FastCGI, envoi de fichiers). Dans"
" les deux cas : mêmes réponses, mêmes journaux, même sécurité. Ce que le "
"choix change, mesuré : FAQ, « Moteur Python ou natif : qu'est-ce que ça "
"change concrètement ? »."
msgstr ""
"Программа, которая обрабатывает HTTP-запросы. Python (по умолчанию): всё "
"обрабатывает интерпретатор Python. Нативный C++ (omega-http-core): "
"скомпилированная программа, использующая все ядра, сама обрабатывает "
"статическое содержимое, перенаправления, кэш и TLS; она сама проверяет "
"правила WAF и сама обслуживает запрос, которому не соответствует ни одно из "
"них; процессу Python она передаёт остальные проверки безопасности "
"(подозрительный или сомнительный запрос, Active Defense, аутентификация), "
"листинг каталогов, внутренние страницы и прикладные маршруты (обратный "
"прокси, FastCGI, загрузка файлов). В обоих случаях: те же ответы, те же "
"журналы, та же безопасность. Что меняет выбор, по измерениям: FAQ, «Движок "
"Python или нативный: что это меняет на практике?»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:90
msgid ""
"Python ou Natif C++. Le choix natif est GRISÉ tant qu'une cause l'empêche "
"(binaire absent, TLS en mode direct avec reverse proxy, FastCGI ou envoi de "
"fichiers) : la liste des causes, et comment lever chacune, s'affiche sous le"
" choix. Lever d'abord la cause, puis revenir ici."
msgstr ""
"Python или Нативный C++. Нативный вариант СЕРЫЙ, пока ему что-то мешает (нет"
" бинарного файла, прямой TLS с reverse proxy, FastCGI или загрузкой файлов):"
" список причин и способ устранить каждую показаны под выбором. Сначала "
"устраните причину, затем вернитесь сюда."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:94
msgid "Enregistre dans server.engine."
msgstr "Сохраняет в server.engine."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:96
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - un rechargement qui changerait de moteur "
"est refusé. Le moteur réellement utilisé est affiché dans État & Ressources "
"(section MOTEUR HTTP, avec le tableau des connecteurs)."
msgstr ""
"Требуется ПОЛНЫЙ ПЕРЕЗАПУСК - перезагрузка, меняющая движок, отклоняется. "
"Фактически используемый движок показан в Состояние и ресурсы (раздел HTTP-"
"ДВИЖОК, с таблицей коннекторов)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:103
msgid ""
"bind/port et le moteur HTTP exigent toujours un redémarrage complet. "
"server_name/index_files se rechargent à chaud mais nécessitent quand même un"
" rechargement du service déjà lancé pour être pris en compte."
msgstr ""
"bind/port и HTTP-движок всегда требуют полного перезапуска. "
"server_name/index_files перезагружаются на лету, но всё равно требуют "
"перезагрузки уже запущенной службы, чтобы вступить в силу."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:109
msgid ""
"Changer bind/port pendant qu'un service systemd est déjà actif ne prend "
"jamais effet tant qu'un redémarrage complet n'a pas eu lieu - toutes les "
"connexions en cours sont alors coupées, contrairement à un simple "
"rechargement."
msgstr ""
"Изменение bind/port при уже активной службе systemd не вступает в силу до "
"полного перезапуска - при этом все текущие соединения обрываются, в отличие "
"от простой перезагрузки."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:118
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:38
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:47
msgid "Résistance et limites"
msgstr "Устойчивость и лимиты"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:119
msgid "Accueil -> Configuration détaillée -> Résistance et limites"
msgstr "Главная -> Подробная настройка -> Устойчивость и лимиты"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:121
msgid ""
"Dix réglages numériques anti-abus : bornes de taille/nombre/delai appliquées"
" à chaque connexion et requête."
msgstr ""
"Десять числовых настроек против злоупотреблений: ограничения "
"размера/количества/времени для каждого соединения и запроса."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:126
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:36
msgid "Connexions simultanées max (max_connections)"
msgstr "Макс. одновременных соединений (max_connections)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:127
msgid "Nombre maximal de connexions ouvertes en même temps."
msgstr "Максимальное число одновременно открытых соединений."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:128
msgid "Entier positif. Valeur par défaut : 256."
msgstr "Положительное целое. Значение по умолчанию: 256."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:129
msgid "Enregistre dans server.max_connections."
msgstr "Записывает в server.max_connections."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:130
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:262
msgid ""
"Se recharge à chaud (rechargement du service nécessaire, automatique si "
"actif)."
msgstr ""
"Перезагружается на лету (нужна перезагрузка службы, автоматически, если она "
"активна)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:133
msgid "Taille max de requête (max_request_size)"
msgstr "Макс. размер запроса (max_request_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:134
msgid "Taille maximale acceptée pour le corps d'une requête, en octets."
msgstr "Максимальный допустимый размер тела запроса в байтах."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:135
msgid "Entier positif, en octets. Valeur par défaut : 10 485 760 (10 Mio)."
msgstr ""
"Положительное целое, в байтах. Значение по умолчанию: 10 485 760 (10 МиБ)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:136
msgid "Enregistre dans server.max_request_size."
msgstr "Записывает в server.max_request_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:137
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:147
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:154
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:161
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:168
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:175
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:188
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:208
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:272
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:279
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:301
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:326
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:333
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:340
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:347
msgid "Se recharge à chaud."
msgstr "Перезагружается на лету."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:140
msgid "Taille max des en-têtes (max_header_size)"
msgstr "Макс. размер заголовков (max_header_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:142
msgid ""
"Taille cumulée maximale des en-têtes HTTP d'une requête, en octets - "
"protection contre les en-têtes surdimensionnés (HTTP smuggling, saturation "
"mémoire)."
msgstr ""
"Максимальный суммарный размер HTTP-заголовков запроса в байтах - защита от "
"слишком больших заголовков (HTTP smuggling, исчерпание памяти)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:145
msgid "Entier positif, en octets. Valeur par défaut : 16 384."
msgstr "Положительное целое, в байтах. Значение по умолчанию: 16 384."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:146
msgid "Enregistre dans server.max_header_size."
msgstr "Записывает в server.max_header_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:150
msgid "Taille max de la ligne de requête (max_request_line_size)"
msgstr "Макс. размер строки запроса (max_request_line_size)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:151
msgid ""
"Taille maximale de la première ligne HTTP (méthode + chemin + version), en "
"octets."
msgstr ""
"Максимальный размер первой строки HTTP (метод + путь + версия) в байтах."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:152
msgid "Entier positif, en octets. Valeur par défaut : 8 192."
msgstr "Положительное целое, в байтах. Значение по умолчанию: 8 192."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:153
msgid "Enregistre dans server.max_request_line_size."
msgstr "Записывает в server.max_request_line_size."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:157
msgid "Délai de lecture (read_timeout_seconds)"
msgstr "Тайм-аут чтения (read_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:158
msgid ""
"Délai maximal, en secondes, pour recevoir une requête complète avant "
"coupure."
msgstr "Максимальное время в секундах на получение полного запроса до обрыва."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:159
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:206
msgid "Entier positif, en secondes. Valeur par défaut : 10."
msgstr "Положительное целое, в секундах. Значение по умолчанию: 10."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:160
msgid "Enregistre dans server.read_timeout_seconds."
msgstr "Записывает в server.read_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:164
msgid "Délai d'écriture (write_timeout_seconds)"
msgstr "Тайм-аут записи (write_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:165
msgid "Délai maximal, en secondes, pour envoyer la réponse avant coupure."
msgstr "Максимальное время в секундах на отправку ответа до обрыва."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:166
msgid "Entier positif, en secondes. Valeur par défaut : 15."
msgstr "Положительное целое, в секундах. Значение по умолчанию: 15."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:167
msgid "Enregistre dans server.write_timeout_seconds."
msgstr "Записывает в server.write_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:171
msgid "Délai keep-alive (keepalive_timeout_seconds)"
msgstr "Тайм-аут keep-alive (keepalive_timeout_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:172
msgid ""
"Délai d'inactivité, en secondes, avant fermeture d'une connexion gardée "
"ouverte."
msgstr "Время бездействия в секундах до закрытия удерживаемого соединения."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:173
msgid "Entier positif, en secondes. Valeur par défaut : 5."
msgstr "Положительное целое, в секундах. Значение по умолчанию: 5."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:174
msgid "Enregistre dans server.keepalive_timeout_seconds."
msgstr "Записывает в server.keepalive_timeout_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:178
msgid "Requêtes max en keep-alive (max_keepalive_requests)"
msgstr "Макс. запросов в keep-alive (max_keepalive_requests)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:180
msgid ""
"Nombre maximal de requêtes traitées sur une même connexion gardée ouverte. "
"Une fois atteint, la connexion est simplement fermée et le navigateur en "
"ouvre une nouvelle : aucune erreur, aucun bannissement. Sans rapport avec la"
" limite de débit du WAF (Active Sécurité -> Exclusions et débit), qui compte"
" les requêtes par IP toutes connexions confondues."
msgstr ""
"Максимальное число запросов на одном удерживаемом соединении. По достижении "
"соединение просто закрывается, и браузер открывает новое: никакой ошибки, "
"никакого бана. Не связано с лимитом запросов WAF (Активная безопасность -> "
"Исключения и лимит запросов), который считает запросы с IP по всем "
"соединениям."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:186
msgid "Entier positif. Valeur par défaut : 30."
msgstr "Положительное целое. Значение по умолчанию: 30."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:187
msgid "Enregistre dans server.max_keepalive_requests."
msgstr "Записывает в server.max_keepalive_requests."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:191
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:44
msgid "File d'attente d'écoute (listen_backlog)"
msgstr "Очередь прослушивания (listen_backlog)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:193
msgid ""
"Taille de la file d'attente de connexions en attente d'acceptation par le "
"système d'exploitation (paramètre backlog du socket d'écoute)."
msgstr ""
"Размер очереди соединений, ожидающих принятия операционной системой "
"(параметр backlog слушающего сокета)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:196
msgid "Entier positif. Valeur par défaut : 128."
msgstr "Положительное целое. Значение по умолчанию: 128."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:197
msgid "Enregistre dans server.listen_backlog."
msgstr "Записывает в server.listen_backlog."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:199
msgid ""
"Nécessite un REDÉMARRAGE COMPLET - fixé au moment de la création du socket "
"d'écoute, comme bind/port, jamais retouché par un simple rechargement."
msgstr ""
"Требует ПОЛНОГО ПЕРЕЗАПУСКА - задаётся при создании слушающего сокета, как "
"bind/port, и никогда не затрагивается простой перезагрузкой."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:204
msgid "Délai de grâce à l'arrêt (shutdown_grace_period_seconds)"
msgstr "Время на завершение при остановке (shutdown_grace_period_seconds)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:205
msgid ""
"Délai, en secondes, laissé aux connexions actives pour se terminer lors d'un"
" arrêt."
msgstr ""
"Время в секундах, даваемое активным соединениям на завершение при остановке."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:207
msgid "Enregistre dans server.shutdown_grace_period_seconds."
msgstr "Записывает в server.shutdown_grace_period_seconds."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:211
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:62
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:178
msgid "Nombre de processus (workers)"
msgstr "Число процессов (workers)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:213
msgid ""
"Avec le moteur Python : nombre de processus serveur qui se partagent le port"
" ; un processus Python n'utilise qu'un cœur, plusieurs servent davantage de "
"requêtes en parallèle. Avec le moteur natif (Configuration de base) : nombre"
" de processus Python qui font les contrôles de sécurité, le natif utilisant "
"déjà tous les cœurs. Les compteurs de sécurité (rate limit, récidive) sont "
"partagés entre processus et restent exacts ; un script magnet garde ses "
"propres compteurs dans chaque processus."
msgstr ""
"С движком Python: число серверных процессов, разделяющих порт; процесс "
"Python использует только одно ядро, несколько процессов обслуживают больше "
"запросов параллельно. С нативным движком (Базовая настройка): число "
"процессов Python, выполняющих проверки безопасности, так как нативный движок"
" уже использует все ядра. Счётчики безопасности (rate limit, рецидив) общие "
"для процессов и остаются точными; скрипт magnet хранит собственные счётчики "
"в каждом процессе."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:221
msgid ""
"Le maximum dépend du moteur et du processeur détecté, et s'affiche sous le "
"champ avec ce qu'augmenter apporte sur cette machine : moteur Python, un "
"processus par cœur physique ; moteur natif, 1, ou 2 à partir de 4 cœurs "
"physiques (un 2e n'aide que si un contrôle de sécurité est actif). Une "
"valeur au-delà du maximum est refusée. Ce que le choix change, mesuré : FAQ,"
" « Combien de processus choisir ? »."
msgstr ""
"Максимум зависит от движка и обнаруженного процессора и показан под полем "
"вместе с тем, что даёт увеличение на этой машине: движок Python — один "
"процесс на физическое ядро; нативный движок — 1 или 2 начиная с 4 физических"
" ядер (2-й помогает, только если включена проверка безопасности). Значение "
"выше максимума отклоняется. Что меняет выбор, по измерениям: FAQ, «Сколько "
"процессов выбрать?»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:227
msgid "Enregistre dans server.workers."
msgstr "Сохраняет в server.workers."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:229
msgid ""
"Redémarrage complet nécessaire. Si la configuration est recopiée sur une "
"machine plus petite, le serveur se limite au maximum de cette machine et "
"l'écrit dans le journal et dans État & Ressources."
msgstr ""
"Требуется полный перезапуск. Если конфигурация скопирована на машину "
"поменьше, сервер ограничивается максимумом этой машины и пишет об этом в "
"журнал и в «Состояние и ресурсы»."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:236
msgid ""
"Neuf champs sur onze se rechargent à chaud (rechargement du service "
"nécessaire, automatique si actif). listen_backlog et le nombre de processus "
"exigent un redémarrage complet."
msgstr ""
"Девять полей из одиннадцати применяются на лету (нужна перезагрузка службы, "
"автоматическая, если включена). listen_backlog и число процессов требуют "
"полного перезапуска."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:241
msgid ""
"Un listen_backlog trop bas sous forte charge fait échouer des connexions "
"entrantes avant même qu'elles atteignent OMEGA-SERV (comportement du système"
" d'exploitation) - ne descendre sous 128 qu'en connaissance de cause."
msgstr ""
"Слишком маленький listen_backlog под высокой нагрузкой приводит к отказу "
"входящих соединений ещё до того, как они достигнут OMEGA-SERV (поведение "
"операционной системы) - опускайтесь ниже 128 только осознанно."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:250
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:39
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:48
msgid "Sécurité générique"
msgstr "Общая безопасность"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:251
msgid "Accueil -> Configuration détaillée -> Sécurité générique"
msgstr "Главная -> Подробная настройка -> Общая безопасность"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:253
msgid ""
"Règles de sécurité génériques appliquées à toutes les requêtes : méthodes "
"autorisées, fichiers cachés, en-têtes de sécurité, CSP, HSTS."
msgstr ""
"Общие правила безопасности, применяемые ко всем запросам: разрешённые "
"методы, скрытые файлы, заголовки безопасности, CSP, HSTS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:258
msgid "Méthodes autorisées"
msgstr "Разрешённые методы"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:259
msgid ""
"Liste blanche des méthodes HTTP acceptées - tout le reste est refusé par "
"défaut."
msgstr ""
"Белый список принимаемых методов HTTP - всё остальное по умолчанию "
"отклоняется."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:260
msgid ""
"Liste séparée par des virgules, ex: GET, HEAD. Valeur par défaut : GET, "
"HEAD."
msgstr ""
"Список через запятую, напр.: GET, HEAD. Значение по умолчанию: GET, HEAD."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:261
msgid "Enregistre dans security.allowed_methods."
msgstr "Записывает в security.allowed_methods."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:265
#: src/omega_serv/interfaces/tui/screens/security_screen.py:58
msgid "Refuser les fichiers cachés (oui/non)"
msgstr "Запрещать скрытые файлы (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:267
msgid ""
"Masque tout fichier ou dossier dont un segment de chemin commence par un "
"point (dotfile) - à la fois en accès direct et dans le directory listing."
msgstr ""
"Скрывает любой файл или каталог, сегмент пути которого начинается с точки "
"(dotfile) - как при прямом доступе, так и в листинге каталогов."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:270
msgid "oui ou non (accepte aussi true/1/o/y). Valeur par défaut : oui."
msgstr ""
"да или нет (также принимаются yes/true/1/y/oui). Значение по умолчанию: да."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:271
msgid "Enregistre dans security.deny_hidden_files."
msgstr "Записывает в security.deny_hidden_files."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:275
msgid "Mode CSP"
msgstr "Режим CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:276
msgid ""
"Mode d'application de la Content-Security-Policy envoyée dans les réponses."
msgstr "Режим применения Content-Security-Policy, отправляемой в ответах."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:277
msgid ""
"enforce (bloque) ou report-only (signale sans bloquer). Valeur par défaut : "
"enforce."
msgstr ""
"enforce (блокирует) или report-only (сообщает без блокировки). Значение по "
"умолчанию: enforce."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:278
msgid "Enregistre dans security.csp_mode."
msgstr "Записывает в security.csp_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:282
msgid "Cross-Origin-Embedder-Policy"
msgstr "Cross-Origin-Embedder-Policy"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:284
msgid ""
"Isolation cross-origin - 'require-corp'/'credentialless' peuvent bloquer des"
" ressources cross-origin (polices, images, iframes tiers) que ce serveur "
"générique ne connaît pas à l'avance, contrairement à COOP/CORP (toujours "
"actifs, sans ce risque)."
msgstr ""
"Изоляция cross-origin - 'require-corp'/'credentialless' могут блокировать "
"cross-origin ресурсы (шрифты, изображения, сторонние iframe), о которых этот"
" универсальный сервер не знает заранее, в отличие от COOP/CORP (всегда "
"включены, без такого риска)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:290
msgid ""
"unsafe-none (permissif, par défaut partout y compris hardened), require-corp"
" ou credentialless - à activer uniquement en connaissance du contenu "
"réellement servi."
msgstr ""
"unsafe-none (разрешительно, по умолчанию везде, включая hardened), require-"
"corp или credentialless - включайте только зная реально отдаваемое "
"содержимое."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:293
msgid "Enregistre dans security.coep_mode."
msgstr "Записывает в security.coep_mode."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:294
msgid ""
"Se recharge à chaud - toujours émis explicitement, même en unsafe-none "
"(jamais un en-tête absent)."
msgstr ""
"Перезагружается на лету - всегда отправляется явно, даже при unsafe-none "
"(заголовок никогда не отсутствует)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:297
#: src/omega_serv/interfaces/tui/screens/security_screen.py:64
msgid "En-têtes de sécurité actifs (oui/non)"
msgstr "Заголовки безопасности включены (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:298
msgid ""
"Active l'envoi des en-têtes de sécurité standard (CSP, X-Content-Type-"
"Options...)."
msgstr ""
"Включает отправку стандартных заголовков безопасности (CSP, X-Content-Type-"
"Options...)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:299
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:338
msgid "oui ou non. Valeur par défaut : oui."
msgstr "да или нет. Значение по умолчанию: да."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:300
msgid "Enregistre dans security.security_headers_enabled."
msgstr "Записывает в security.security_headers_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:304
msgid "Zones CSP (Ajouter une zone / Retirer)"
msgstr "Зоны CSP (Добавить зону / Убрать)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:306
msgid ""
"Exceptions EXPLICITES à la CSP globale, par préfixe de chemin - ex. 'unsafe-"
"inline' uniquement sous /un-dossier/ qui en a réellement besoin, sans jamais"
" relâcher la CSP du reste du site."
msgstr ""
"ЯВНЫЕ исключения из глобальной CSP по префиксу пути - напр. 'unsafe-inline' "
"только в /какой-то-каталог/, которому это действительно нужно, никогда не "
"ослабляя CSP остального сайта."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:311
msgid ""
"Préfixe (ex: /public-widgets/) + politique CSP COMPLÈTE pour ce préfixe "
"(remplace entièrement le défaut pour ces chemins, jamais une fusion de "
"directives)."
msgstr ""
"Префикс (напр.: /public-widgets/) + ПОЛНАЯ политика CSP для этого префикса "
"(полностью заменяет политику по умолчанию для этих путей, никогда не "
"объединяет директивы)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:314
msgid ""
"Enregistre immédiatement dans security.csp_zones, sans passer par "
"Enregistrer."
msgstr "Записывает сразу в security.csp_zones, без кнопки Сохранить."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:316
msgid ""
"Rechargement automatique immédiat si un service actif existe. Une exception "
"comme 'unsafe-inline' reste TOUJOURS visible dans 'omega-serv audit "
"security' (CSP-001/CSP-002), même délibérée - jamais silencieuse."
msgstr ""
"Немедленная автоматическая перезагрузка, если есть активная служба. "
"Исключение вроде 'unsafe-inline' ВСЕГДА остаётся видимым в 'omega-serv audit"
" security' (CSP-001/CSP-002), даже если оно намеренное - никогда не скрыто."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:322
#: src/omega_serv/interfaces/tui/screens/security_screen.py:66
msgid "HSTS actif (oui/non)"
msgstr "HSTS включён (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:323
msgid ""
"Active l'en-tête Strict-Transport-Security (force HTTPS pour les visites "
"futures)."
msgstr ""
"Включает заголовок Strict-Transport-Security (требует HTTPS для будущих "
"посещений)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:324
msgid ""
"oui ou non. Valeur par défaut : non. N'a de sens que si TLS est réellement "
"actif."
msgstr ""
"да или нет. Значение по умолчанию: нет. Имеет смысл, только если TLS "
"действительно включён."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:325
msgid "Enregistre dans security.hsts_enabled."
msgstr "Записывает в security.hsts_enabled."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:329
msgid "HSTS max-age"
msgstr "HSTS max-age"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:330
msgid ""
"Durée, en secondes, pendant laquelle un navigateur retient l'obligation "
"HTTPS."
msgstr "Время в секундах, в течение которого браузер помнит требование HTTPS."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:331
msgid "Entier positif, en secondes. Valeur par défaut : 31 536 000 (un an)."
msgstr ""
"Положительное целое, в секундах. Значение по умолчанию: 31 536 000 (один "
"год)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:332
msgid "Enregistre dans security.hsts_max_age."
msgstr "Записывает в security.hsts_max_age."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:336
#: src/omega_serv/interfaces/tui/screens/security_screen.py:70
msgid "HSTS includeSubDomains (oui/non)"
msgstr "HSTS includeSubDomains (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:337
msgid "Étend l'obligation HTTPS à tous les sous-domaines."
msgstr "Распространяет требование HTTPS на все поддомены."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:339
msgid "Enregistre dans security.hsts_include_subdomains."
msgstr "Записывает в security.hsts_include_subdomains."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:343
#: src/omega_serv/interfaces/tui/screens/security_screen.py:72
msgid "HSTS preload (oui/non)"
msgstr "HSTS preload (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:344
msgid ""
"Signale l'éligibilité à la liste de prechargement HSTS des navigateurs."
msgstr ""
"Сообщает о пригодности для списка предварительной загрузки HSTS в браузерах."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:345
#: src/omega_serv/interfaces/tui/guide/content/routage.py:31
msgid "oui ou non. Valeur par défaut : non."
msgstr "да или нет. Значение по умолчанию: нет."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:346
msgid "Enregistre dans security.hsts_preload."
msgstr "Записывает в security.hsts_preload."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:350
msgid ""
"Tous les champs de cet écran se rechargent à chaud - aucun n'exige de "
"redémarrage complet."
msgstr ""
"Все поля этого экрана перезагружаются на лету - ни одно не требует полного "
"перезапуска."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:353
msgid ""
"Activer HSTS sans que TLS soit réellement actif n'a aucun effet utile - le "
"navigateur ignore cet en-tête reçu en HTTP simple."
msgstr ""
"Включение HSTS без реально включённого TLS ничего не даёт - браузер "
"игнорирует этот заголовок, полученный по обычному HTTP."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:361
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:40
msgid "Sécurité générique - Assistant zone CSP"
msgstr "Общая безопасность - Мастер зоны CSP"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:362
msgid "Sécurité générique -> Ajouter une zone"
msgstr "Общая безопасность -> Добавить зону"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:364
msgid ""
"Construit la politique CSP d'une zone directive par directive, chacune pré-"
"remplie avec sa valeur ACTUELLE (la politique globale) - une zone remplace "
"ENTIÈREMENT la politique par défaut pour son préfixe, jamais un simple "
"ajout, d'où le pré-remplissage pour éviter de perdre des directives sans le "
"vouloir."
msgstr ""
"Строит политику CSP зоны директива за директивой, каждая заполнена своим "
"ТЕКУЩИМ значением (глобальная политика) - зона ПОЛНОСТЬЮ заменяет политику "
"по умолчанию для своего префикса, а не просто дополняет её, отсюда "
"предварительное заполнение, чтобы не потерять директивы по неосторожности."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:371
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:83
#: src/omega_serv/interfaces/tui/screens/security_screen.py:98
msgid "Préfixe"
msgstr "Префикс"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:372
msgid "Chemin URL auquel s'applique cette politique de remplacement."
msgstr "Путь URL, к которому применяется эта заменяющая политика."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:373
msgid "Doit commencer par '/', ex: /public-widgets/."
msgstr "Должен начинаться с '/', напр.: /public-widgets/."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:374
msgid "Utilisé au clic sur Valider."
msgstr "Используется при нажатии Подтвердить."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:375
msgid "Aucun effet avant Valider."
msgstr "Без эффекта до Подтвердить."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:378
msgid "Directives (une par ligne, ex. style-src, script-src...)"
msgstr "Директивы (по одной на строку, напр. style-src, script-src...)"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:379
msgid ""
"Chaque champ contrôle une famille de ressources - l'indice sous chaque champ"
" explique précisément laquelle."
msgstr ""
"Каждое поле управляет семейством ресурсов - подсказка под каждым полем точно"
" объясняет, каким."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:380
msgid ""
"Pré-rempli avec la valeur actuelle - modifier uniquement ce qui doit "
"changer, vider pour omettre la directive dans la zone."
msgstr ""
"Заполнено текущим значением - меняйте только то, что нужно, очистите поле, "
"чтобы опустить директиву в зоне."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:381
msgid "Reassemblees en une seule politique au clic sur Valider."
msgstr "Собираются в одну политику при нажатии Подтвердить."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:382
msgid ""
"Une valeur contenant unsafe-inline/unsafe-eval/'*' déclenche une "
"confirmation explicite supplémentaire avant d'enregistrer."
msgstr ""
"Значение с unsafe-inline/unsafe-eval/'*' вызывает дополнительное явное "
"подтверждение перед сохранением."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:386
msgid ""
"La zone créée reste visible dans 'omega-serv audit security' "
"(CSP-001/CSP-002 scannent aussi les zones) si elle contient une relâche - "
"jamais silencieuse, même délibérée."
msgstr ""
"Созданная зона остаётся видимой в 'omega-serv audit security' "
"(CSP-001/CSP-002 проверяют и зоны), если содержит послабление - никогда не "
"скрыто, даже если оно намеренное."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:393
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:41
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:49
msgid "Contrôle d'accès"
msgstr "Контроль доступа"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:394
msgid "Accueil -> Configuration détaillée -> Contrôle d'accès"
msgstr "Главная -> Подробная настройка -> Контроль доступа"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:396
msgid ""
"CRUD de règles allow/deny par préfixe d'URL, avec filtre optionnel par "
"extension - permet par exemple de bloquer des extensions sensibles partout "
"SAUF dans une zone précise."
msgstr ""
"CRUD правил allow/deny по префиксу URL с необязательным фильтром по "
"расширению - например, чтобы блокировать конфиденциальные расширения везде, "
"КРОМЕ одной конкретной зоны."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:401
#: src/omega_serv/interfaces/tui/guide/content/routage.py:15
#: src/omega_serv/interfaces/tui/guide/content/routage.py:58
#: src/omega_serv/interfaces/tui/guide/content/routage.py:354
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:127
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:60
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:110
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:81
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:63
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:112
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:172
msgid "Préfixe URL"
msgstr "Префикс URL"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:402
msgid "Le préfixe de chemin auquel s'applique la règle."
msgstr "Префикс пути, к которому применяется правило."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:403
msgid ""
"Doit commencer par '/', ex: /private/. Le plus long préfixe correspondant "
"gagne."
msgstr ""
"Должен начинаться с '/', напр.: /private/. Побеждает самый длинный "
"совпадающий префикс."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:404
msgid "Ajoute/modifie une règle via Ajouter/Modifier."
msgstr "Добавляет/изменяет правило кнопками Добавить/Изменить."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:405
#: src/omega_serv/interfaces/tui/guide/content/routage.py:19
#: src/omega_serv/interfaces/tui/guide/content/routage.py:135
#: src/omega_serv/interfaces/tui/guide/content/routage.py:220
#: src/omega_serv/interfaces/tui/guide/content/routage.py:317
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:111
msgid "Aucun effet sans rechargement du service (automatique si actif)."
msgstr ""
"Без эффекта без перезагрузки службы (автоматически, если она активна)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:408
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Verdict"
msgstr "Вердикт"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:409
msgid "Ce que décide la règle pour les chemins qu'elle couvre."
msgstr "Что решает правило для охватываемых им путей."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:410
msgid "allow ou deny."
msgstr "allow или deny."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:411
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:421
msgid "Ajoute/modifie une règle."
msgstr "Добавляет/изменяет правило."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:412
#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:422
#: src/omega_serv/interfaces/tui/guide/content/routage.py:26
#: src/omega_serv/interfaces/tui/guide/content/routage.py:33
#: src/omega_serv/interfaces/tui/guide/content/routage.py:62
#: src/omega_serv/interfaces/tui/guide/content/routage.py:69
#: src/omega_serv/interfaces/tui/guide/content/routage.py:76
#: src/omega_serv/interfaces/tui/guide/content/routage.py:99
#: src/omega_serv/interfaces/tui/guide/content/routage.py:106
#: src/omega_serv/interfaces/tui/guide/content/routage.py:142
#: src/omega_serv/interfaces/tui/guide/content/routage.py:156
#: src/omega_serv/interfaces/tui/guide/content/routage.py:163
#: src/omega_serv/interfaces/tui/guide/content/routage.py:170
#: src/omega_serv/interfaces/tui/guide/content/routage.py:181
#: src/omega_serv/interfaces/tui/guide/content/routage.py:227
#: src/omega_serv/interfaces/tui/guide/content/routage.py:240
#: src/omega_serv/interfaces/tui/guide/content/routage.py:329
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:121
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:128
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:146
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:153
msgid "Aucun effet sans rechargement du service."
msgstr "Без эффекта без перезагрузки службы."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:415
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:77
msgid "Extensions"
msgstr "Расширения"

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:417
msgid ""
"Restreint la règle aux chemins se terminant par l'une de ces extensions - "
"vide signifie 'toutes', la règle s'applique alors à tout chemin sous ce "
"préfixe."
msgstr ""
"Ограничивает правило путями, оканчивающимися одним из этих расширений - "
"пусто означает 'все', и тогда правило применяется к любому пути под этим "
"префиксом."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:420
msgid ""
"Liste séparée par des virgules, ex: .key, .pem. Vide par défaut (toutes)."
msgstr "Список через запятую, напр.: .key, .pem. По умолчанию пусто (все)."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:426
msgid ""
"L'option access_control doit être activée (écran Options) pour que ces "
"règles soient réellement appliquées. Toutes les modifications se rechargent "
"à chaud."
msgstr ""
"Чтобы эти правила реально применялись, параметр access_control должен быть "
"включён (экран Параметры). Все изменения перезагружаются на лету."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:431
msgid ""
"Le plus long préfixe correspondant gagne : une règle 'allow' plus spécifique"
" lève le 'deny' d'un préfixe parent (ex: deny /private/, allow "
"/private/.assets/). Une règle 'allow' explicite lève aussi les règles "
"génériques dotfiles/motifs de l'écran Sécurité générique sur ce chemin "
"précis."
msgstr ""
"Побеждает самый длинный совпадающий префикс: более конкретное правило "
"'allow' снимает 'deny' родительского префикса (напр.: deny /private/, allow "
"/private/.assets/). Явное правило 'allow' также снимает общие правила "
"dotfiles/шаблонов экрана Общая безопасность для этого конкретного пути."

#: src/omega_serv/interfaces/tui/guide/content/configuration_base.py:437
msgid ""
"Pour bloquer une extension sensible PARTOUT sauf dans une zone : une règle "
"deny sur '/' avec l'extension visée, puis une règle allow (sans extension) "
"sur le préfixe à excepter - le préfixe le plus spécifique l'emporte."
msgstr ""
"Чтобы блокировать конфиденциальное расширение ВЕЗДЕ, кроме одной зоны: "
"правило deny на '/' с нужным расширением, затем правило allow (без "
"расширения) на исключаемый префикс - побеждает самый конкретный префикс."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:12
msgid "Accueil -> Registre des capacités"
msgstr "Главная -> Реестр возможностей"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:13
msgid ""
"Scan complet de l'environnement (port libre, openssl présent, PHP-FPM si "
"FastCGI actif...), avec export."
msgstr ""
"Полное сканирование окружения (свободный порт, наличие openssl, PHP-FPM при "
"активном FastCGI...) с экспортом."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:16
#: src/omega_serv/interfaces/tui/guide/content/logs.py:511
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1023
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:85
#: src/omega_serv/interfaces/tui/screens/capabilities_screen.py:52
#: src/omega_serv/interfaces/tui/screens/export_log_archives_screen.py:43
#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:114
#: src/omega_serv/interfaces/tui/screens/log_stats_screen.py:107
msgid "Thème d'export HTML"
msgstr "Тема экспорта HTML"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:17
msgid "Palette de couleurs pour l'export HTML."
msgstr "Цветовая палитра для экспорта HTML."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:18
#: src/omega_serv/interfaces/tui/guide/content/logs.py:513
msgid "5 thèmes disponibles."
msgstr "Доступно 5 тем."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:19
#: src/omega_serv/interfaces/tui/guide/content/logs.py:514
msgid "Utilisé au clic sur Exporter HTML."
msgstr "Используется при нажатии Экспорт HTML."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:20
#: src/omega_serv/interfaces/tui/guide/content/logs.py:282
#: src/omega_serv/interfaces/tui/guide/content/logs.py:515
msgid "Aucun effet sur le serveur."
msgstr "Без эффекта на сервер."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:23
msgid "Rafraîchir / Exporter JSON / Exporter HTML"
msgstr "Обновить / Экспорт JSON / Экспорт HTML"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:24
msgid "Relance le scan, ou exporte son résultat."
msgstr "Повторно запускает сканирование или экспортирует его результат."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:25
#: src/omega_serv/interfaces/tui/guide/content/logs.py:520
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:247
msgid "Aucune saisie supplémentaire."
msgstr "Дополнительного ввода нет."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:26
msgid "Rafraîchir relance le scan ; les exports écrivent un fichier horodate."
msgstr ""
"Обновить повторно запускает сканирование; экспорт записывает файл с меткой "
"времени."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid ""
"Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "Без эффекта на сервер и его конфигурацию (только чтение + экспорт)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
msgid "Purement consultatif/export."
msgstr "Только просмотр/экспорт."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:35
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
msgid "Détail d'une capacité"
msgstr "Подробности возможности"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:36
msgid "Registre des capacités -> clic sur une ligne"
msgstr "Реестр возможностей -> щелчок по строке"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:37
msgid ""
"Détail complet d'une capacité déjà scannee (jamais un nouveau scan) : "
"statut, raison, détails techniques, date du dernier scan."
msgstr ""
"Полные сведения об уже просканированной возможности (никогда не новое "
"сканирование): статус, причина, технические подробности, дата последнего "
"сканирования."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:39
#: src/omega_serv/interfaces/tui/guide/content/logs.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:197
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:330
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:502
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:171
msgid "Purement consultatif."
msgstr "Только просмотр."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "Главная -> Профили"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid ""
"Liste et décrit les 4 profils de base preconfigures "
"(minimal/standard/hardened/development)."
msgstr ""
"Перечисляет и описывает 4 предустановленных базовых профиля "
"(minimal/standard/hardened/development)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:49
#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:39
msgid "Appliquer"
msgstr "Применить"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "Открывает экран подтверждения применения выбранного профиля."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Sélectionner un profil active ce bouton."
msgstr "Выбор профиля активирует эту кнопку."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Ouvre ApplyProfileScreen."
msgstr "Открывает ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Aucun effet ici - voir la fiche d'ApplyProfileScreen."
msgstr "Здесь без эффекта - см. карточку ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:56
msgid "Purement consultatif - aucune modification depuis cet écran lui-même."
msgstr "Только просмотр - с этого экрана ничего не изменяется."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "Применить профиль"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Profils -> Appliquer"
msgstr "Профили -> Применить"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid ""
"Affiche TOUJOURS la différence complète avant toute confirmation, puis "
"écrase la configuration active avec le profil choisi."
msgstr ""
"ВСЕГДА показывает полную разницу перед любым подтверждением, затем "
"перезаписывает активную конфигурацию выбранным профилем."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Confirme et écrit le profil choisi."
msgstr "Подтверждает и записывает выбранный профиль."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid ""
"Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "Полный diff уже показан выше - проверьте его перед нажатием."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid ""
"Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr ""
"Перезаписывает config/omega-serve.json конфигурацией, составленной из "
"профиля."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:71
msgid ""
"Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si "
"bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire"
" ; sinon un simple rechargement suffit (automatique si un service actif "
"existe)."
msgstr ""
"Профиль может изменить ЛЮБУЮ настройку сразу. Если меняются "
"bind/port/listen_backlog/TLS, нужен ПОЛНЫЙ ПЕРЕЗАПУСК; иначе достаточно "
"простой перезагрузки (автоматически, если есть активная служба)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:77
msgid ""
"Des conflits ou erreurs de validation bloquants demandent une confirmation "
"supplémentaire explicite pour forcer quand même."
msgstr ""
"Блокирующие конфликты или ошибки проверки требуют дополнительного явного "
"подтверждения, чтобы всё же применить."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid ""
"Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste "
"de la configuration active est conservé tel quel."
msgstr ""
"Профиль изменяет ТОЛЬКО явно указанные в нём поля - остальная активная "
"конфигурация сохраняется как есть."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Accueil -> Audit de sécurité"
msgstr "Главная -> Аудит безопасности"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid ""
"Vérifications consultatives (service, rotation des logs, mode WAF...) - "
"mêmes règles que l'audit CLI."
msgstr ""
"Рекомендательные проверки (служба, ротация журналов, режим WAF...) - те же "
"правила, что и аудит в CLI."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:52
msgid "Auditer"
msgstr "Аудит"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:91
msgid "Relance explicitement l'audit."
msgstr "Явно запускает аудит повторно."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:92
msgid ""
"Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture "
"de l'écran."
msgstr ""
"Ввода нет - первый аудит уже выполняется автоматически при открытии экрана."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "Перечитывает конфигурацию и заново вычисляет все правила аудита."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:221
msgid ""
"Aucun effet sur le serveur (lecture seule) - notifie explicitement le "
"résultat sur un clic explicite."
msgstr ""
"Без эффекта на сервер (только чтение) - явно сообщает результат после явного"
" щелчка."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "Только просмотр - никогда ничего не изменяет."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Accueil -> Sauvegarde de configuration"
msgstr "Главная -> Резервное копирование"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:104
msgid ""
"Créer, lister, restaurer ou supprimer des sauvegardes complètes de la "
"configuration - le fichier de configuration est toujours inclus, jamais "
"chiffre par défaut."
msgstr ""
"Создание, просмотр, восстановление и удаление полных резервных копий "
"конфигурации - файл конфигурации всегда включается, по умолчанию никогда не "
"шифруется."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:107
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:51
msgid "Tout sauvegarder (configuration complète)"
msgstr "Сохранить всё (полная конфигурация)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid ""
"Coche toutes les cases : de quoi retrouver la configuration entière et ses "
"modules."
msgstr ""
"Отмечает все флажки: всё, чтобы восстановить конфигурацию целиком вместе с "
"модулями."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
msgid ""
"Case à cocher ; les secrets (zones Auth, clés TLS) restent confirmés à la "
"création."
msgstr ""
"Флажок; секреты (зоны Auth, ключи TLS) по-прежнему подтверждаются при "
"создании."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:110
#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
#: src/omega_serv/interfaces/tui/guide/content/divers.py:135
#: src/omega_serv/interfaces/tui/guide/content/divers.py:142
#: src/omega_serv/interfaces/tui/guide/content/divers.py:149
msgid "Pris en compte à la création."
msgstr "Учитывается при создании."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:111
msgid ""
"Ce qui est désigné hors du dossier omega-serv (ex. un certificat dans /etc) "
"n'est jamais archivé, et c'est indiqué après la création."
msgstr ""
"То, что находится вне папки omega-serv (например, сертификат в /etc), "
"никогда не архивируется, и об этом сообщается после создания."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:115
msgid "RIPOSTE, pages d'erreur, préférences, bibliothèque des journaux"
msgstr "RIPOSTE, страницы ошибок, настройки интерфейса, библиотека журналов"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:116
msgid ""
"Base RIPOSTE ; pages d'erreur personnalisées ; thème, langues et nom du "
"service ; favoris, sources distantes et rotations planifiées des journaux."
msgstr ""
"База RIPOSTE; собственные страницы ошибок; тема, языки и имя службы; "
"избранное, удалённые источники и запланированные ротации журналов."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
msgid ""
"Cases à cocher. Les règles WAF comprennent aussi les listes de mots-clés et "
"les scripts Magnet."
msgstr ""
"Флажки. Правила WAF включают также списки ключевых слов и скрипты Magnet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:119
msgid ""
"Pris en compte à la création ; les bases (Active Defense, RIPOSTE) sont "
"copiées de façon cohérente, serveur en marche."
msgstr ""
"Учитывается при создании; базы (Active Defense, RIPOSTE) копируются "
"согласованно при работающем сервере."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:121
msgid ""
"Une sauvegarde qui contient une base n'est jamais restaurée sous un serveur "
"actif : « Arrêter, restaurer, redémarrer » est proposé, et les bases "
"actuelles sont mises de côté."
msgstr ""
"Копия с базой никогда не восстанавливается при работающем сервере: "
"предлагается « Остановить, восстановить, перезапустить », а текущие базы "
"откладываются в сторону."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid "Inclure les règles WAF"
msgstr "Включить правила WAF"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:126
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "Добавляет в резервную копию правила WAF и список блокировки."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:127
#: src/omega_serv/interfaces/tui/guide/content/divers.py:148
msgid "Case à cocher."
msgstr "Флажок."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:129
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "Без немедленного эффекта - только содержимое создаваемой копии."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:132
msgid "Inclure les zones d'authentification"
msgstr "Включить зоны аутентификации"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:133
msgid ""
"Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la "
"sauvegarde."
msgstr ""
"Добавляет в резервную копию users.json/zones.json (НАСТОЯЩИЕ СЕКРЕТЫ: хеши "
"паролей)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:134
#: src/omega_serv/interfaces/tui/guide/content/divers.py:141
msgid ""
"Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "Флажок - при установке требует дополнительного явного подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "Копия содержит настоящие секреты, никогда не зашифрованные."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:139
msgid "Inclure les certificats"
msgstr "Включить сертификаты"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:140
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "Добавляет в резервную копию сертификаты TLS, ВКЛЮЧАЯ ЗАКРЫТЫЕ КЛЮЧИ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "Копия содержит настоящие закрытые ключи, никогда не зашифрованные."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:146
msgid "Inclure Active Defense"
msgstr "Включить Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr "Добавляет в резервную копию базу угроз/инцидентов Active Defense."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:150
#: src/omega_serv/interfaces/tui/guide/content/divers.py:157
msgid "Aucun effet immédiat."
msgstr "Без немедленного эффекта."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:153
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:62
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:80
msgid "Description"
msgstr "Описание"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:154
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "Произвольная заметка к резервной копии, чтобы найти её позже."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid "Texte libre, optionnel."
msgstr "Произвольный текст, необязательно."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:156
msgid "Enregistrée avec la sauvegarde."
msgstr "Сохраняется вместе с копией."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:160
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:72
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "Восстановить"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:161
msgid ""
"Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX "
"MÊMES EMPLACEMENTS."
msgstr ""
"Перезаписывает текущие файлы файлами выбранной копии, В ТЕХ ЖЕ МЕСТАХ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:162
#: src/omega_serv/interfaces/tui/guide/content/divers.py:173
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "Выберите копию, затем подтвердите."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:163
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "Реальная и немедленная запись затронутых файлов."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:165
msgid ""
"Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration "
"peut écraser n'importe quel fichier (configuration, certificats TLS...), et "
"un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr ""
"ВСЕГДА требует ПОЛНОГО ПЕРЕЗАПУСКА из предосторожности - восстановление "
"может перезаписать любой файл (конфигурацию, сертификаты TLS...), а "
"сертификат, уже загруженный в память, никогда не перезагружается сам."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:171
#: src/omega_serv/interfaces/tui/guide/content/logs.py:88
#: src/omega_serv/interfaces/tui/guide/content/logs.py:139
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:69
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:52
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:57
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:65
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:74
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:92
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:51
#: src/omega_serv/interfaces/tui/screens/purge_log_archives_screen.py:38
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:55
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:77
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:162
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:60
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:54
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:70
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:62
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:93
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:195
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:97
msgid "Supprimer"
msgstr "Удалить"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:172
msgid ""
"Supprime définitivement une sauvegarde (n'existe pas côté CLI, confort TUI "
"uniquement)."
msgstr ""
"Безвозвратно удаляет резервную копию (в CLI нет, только удобство TUI)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:174
msgid "Suppression immédiate et définitive."
msgstr "Немедленное и безвозвратное удаление."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:175
msgid ""
"Aucun effet sur le serveur - seulement sur les sauvegardes disponibles."
msgstr "Без эффекта на сервер - только на доступные копии."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:178
msgid ""
"Restaurer écrase directement les fichiers vises, sans filet - la seule "
"protection est la confirmation demandée avant."
msgstr ""
"Восстановление напрямую перезаписывает затронутые файлы, без страховки - "
"единственная защита - это запрашиваемое заранее подтверждение."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:183
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:112
msgid "Réglages de l'application"
msgstr "Настройки приложения"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:184
msgid "Raccourci clavier 'o' (footer), depuis n'importe quel écran"
msgstr "Клавиша 'o' (нижняя панель), с любого экрана"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:186
msgid ""
"PRÉFÉRENCES D'INTERFACE uniquement (thème, rendu, chemins d'export/captures)"
" - PAS des réglages du serveur (ceux-là vivent dans Configuration "
"détaillée)."
msgstr ""
"ТОЛЬКО НАСТРОЙКИ ИНТЕРФЕЙСА (тема, отображение, пути экспорта/снимков) - НЕ "
"настройки сервера (они находятся в Подробной настройке)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:192
msgid "Thème visuel de l'interface elle-même."
msgstr "Визуальная тема самого интерфейса."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:193
msgid "Un des thèmes disponibles."
msgstr "Одна из доступных тем."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:194
msgid "Appliqué immédiatement au changement."
msgstr "Применяется сразу при изменении."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:195
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "Немедленный эффект, перезапуск не нужен."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:198
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:207
msgid "Profil de rendu"
msgstr "Режим отображения"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:199
msgid ""
"Force un profil de rendu Textual particulier plutôt que la détection "
"automatique."
msgstr ""
"Принудительно задаёт определённый режим отображения Textual вместо "
"автоопределения."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:200
msgid "Automatique, ou un profil précis."
msgstr "Автоматически или конкретный режим."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:201
msgid "Enregistre la préférence."
msgstr "Сохраняет предпочтение."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:202
msgid ""
"Appliqué seulement AU PROCHAIN DÉMARRAGE de l'interface, jamais à chaud."
msgstr "Применяется только ПРИ СЛЕДУЮЩЕМ ЗАПУСКЕ интерфейса, никогда на лету."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:207
msgid ""
"Langue de l'interface. Chaque langue est écrite dans sa propre langue, "
"Français toujours en tête ; le libellé 'Langue / Language' n'est jamais "
"traduit, pour être retrouvé même dans une langue qu'on ne lit pas. Une "
"langue non encore validée porte la mention 'en test'."
msgstr ""
"Язык интерфейса. Каждый язык записан на нём самом, французский всегда "
"первый; подпись 'Langue / Language' никогда не переводится, чтобы её можно "
"было найти даже на незнакомом языке. Ещё не утверждённый язык помечается "
"'тестируется'."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:212
msgid ""
"Choisir une langue dans la liste, puis confirmer le redémarrage de "
"l'interface."
msgstr "Выберите язык в списке, затем подтвердите перезапуск интерфейса."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:214
msgid ""
"Enregistre la langue puis redémarre L'INTERFACE (pas le service : le serveur"
" continue de tourner). Un écran de confirmation affiche la langue et la "
"phrase d'invite déjà traduite."
msgstr ""
"Сохраняет язык, затем перезапускает ИНТЕРФЕЙС (не службу: сервер продолжает "
"работать). Экран подтверждения показывает язык и уже переведённую фразу-"
"приглашение."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:218
msgid ""
"Retour au français toujours possible : ce même réglage ; ou lancer une fois "
"'OMEGA_SERV_LANG=fr serv' ; ou retirer la clé 'language' de "
"var/settings.json. Langue indisponible ou catalogue illisible : l'interface "
"démarre en français avec un message. Les journaux du serveur (journalctl) "
"restent toujours en français."
msgstr ""
"Вернуться к французскому можно всегда: этой же настройкой; или один раз "
"запустив 'OMEGA_SERV_LANG=fr serv'; или удалив ключ 'language' из "
"var/settings.json. Если язык недоступен или каталог нечитаем, интерфейс "
"запускается на французском с сообщением. Журналы сервера (journalctl) всегда"
" остаются на французском."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:225
msgid "Export / Captures d'écran (chemins)"
msgstr "Экспорт / Снимки экрана (пути)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:226
msgid "Répertoires où sont écrits les exports et les captures d'écran."
msgstr "Каталоги, куда записываются экспорты и снимки экрана."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:227
msgid "Chemin libre - vide revient au répertoire par défaut."
msgstr "Произвольный путь - пусто означает каталог по умолчанию."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:228
msgid "Enregistre à chaque changement de texte."
msgstr "Сохраняет при каждом изменении текста."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:229
msgid "Effet immédiat sur les prochains exports/captures."
msgstr "Немедленный эффект на следующие экспорты/снимки."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:232
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:105
msgid "Langue des exports"
msgstr "Язык экспорта"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:234
msgid ""
"Langue des exports HTML (registre des capacités, archives de logs, guide "
"d'aide) et du rapport d'incident Markdown - un fichier qui se diffuse, pas "
"forcément à quelqu'un qui lit la langue de l'interface. Les exports JSON et "
"CSV n'ont pas de texte à traduire."
msgstr ""
"Язык экспорта HTML (реестр возможностей, архивы логов, справочное "
"руководство) и отчёта об инциденте в Markdown - файла, который передают "
"другим, не обязательно тем, кто читает язык интерфейса. В экспорте JSON и "
"CSV нет текста для перевода."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:238
msgid "« Comme l'interface » (défaut) ou une des langues de la liste."
msgstr "« Как интерфейс » (по умолчанию) или один из языков списка."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:240
msgid ""
"Enregistre immédiatement. Dans une autre langue que l'interface, chaque "
"export est produit par un processus séparé lancé dans cette langue : "
"quelques secondes, l'interface reste utilisable."
msgstr ""
"Сохраняется сразу. Если язык отличается от языка интерфейса, каждый экспорт "
"создаёт отдельный процесс, запущенный на этом языке: несколько секунд, "
"интерфейс остаётся доступным."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:245
msgid ""
"Si ce processus échoue, l'export HTML n'est pas écrit (raison affichée) ; le"
" rapport d'incident, lui, est quand même écrit dans la langue de "
"l'interface, avec un avertissement."
msgstr ""
"Если этот процесс завершится с ошибкой, экспорт HTML не записывается "
"(причина показывается); отчёт об инциденте всё равно записывается на языке "
"интерфейса, с предупреждением."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:250
msgid "Supprimer les exports / Supprimer les screenshots"
msgstr "Удалить экспорты / Удалить снимки"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:251
msgid "Vide complètement le répertoire concerne."
msgstr "Полностью очищает соответствующий каталог."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:252
msgid "Confirmation obligatoire."
msgstr "Подтверждение обязательно."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:253
msgid ""
"Suppression immédiate et définitive de tous les fichiers du répertoire."
msgstr "Немедленное и безвозвратное удаление всех файлов каталога."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:254
msgid "Action irréversible."
msgstr "Необратимое действие."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:257
msgid ""
"Ne touche jamais config/omega-serve.json - réglages purement locaux à cette "
"interface."
msgstr ""
"Никогда не затрагивает config/omega-serve.json - настройки исключительно "
"локальны для этого интерфейса."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:262
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:113
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:56
msgid "Contact et support"
msgstr "Контакты и поддержка"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:263
msgid "Guide d'aide (touche a) -> Contact et support"
msgstr "Справочник (клавиша a) -> Контакты и поддержка"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:264
msgid ""
"Payer un café au développeur, se déclarer utilisateur anonyme d'omega-serv, "
"contacter le support, ou vérifier si une nouvelle version est publiée. Les "
"adresses sont toujours affichées en clair."
msgstr ""
"Угостить разработчика кофе, зарегистрироваться как анонимный пользователь "
"omega-serv, связаться с поддержкой или проверить, опубликована ли новая "
"версия. Адреса всегда показаны полностью."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:269
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:49
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:53
msgid "Payer un café"
msgstr "Угостить кофе"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:270
msgid "Ouvre la page PayPal du développeur (https://paypal.me/kraynux)."
msgstr "Открывает страницу PayPal разработчика (https://paypal.me/kraynux)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:271
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:159
#: src/omega_serv/interfaces/tui/guide/content/tls.py:27
#: src/omega_serv/interfaces/tui/guide/content/tls.py:228
msgid "Aucune saisie."
msgstr "Ввода нет."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:272
msgid ""
"Ouvre l'adresse dans votre navigateur, même si l'interface tourne sous sudo."
msgstr ""
"Открывает адрес в вашем браузере, даже если интерфейс запущен через sudo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:273
msgid ""
"Sans session graphique (SSH, serveur), un message rappelle l'adresse à "
"ouvrir vous-même."
msgstr ""
"Без графического сеанса (SSH, сервер) сообщение напоминает адрес, который "
"нужно открыть самостоятельно."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:276
msgid "Se déclarer utilisateur (anonyme) / Modifier ma déclaration"
msgstr ""
"Зарегистрироваться как пользователь (анонимно) / Изменить мою регистрацию"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:277
msgid "Ouvre le formulaire de déclaration anonyme."
msgstr "Открывает форму анонимной регистрации."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:278
msgid "Le libellé devient « Modifier ma déclaration » une fois déclaré."
msgstr "После регистрации надпись меняется на «Изменить мою регистрацию»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:279
msgid "Ouvre le formulaire Se déclarer utilisateur (anonyme)."
msgstr "Открывает форму «Зарегистрироваться как пользователь (анонимно)»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:280
msgid "Aucun effet ici - voir la fiche du formulaire."
msgstr "Здесь ничего не происходит - см. карточку формы."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:283
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:63
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:128
msgid "Ne plus me déclarer"
msgstr "Больше не регистрировать меня"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:284
msgid "Retire la déclaration."
msgstr "Отзывает регистрацию."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:285
msgid "Actif seulement une fois déclaré ; une confirmation est demandée."
msgstr "Доступно только после регистрации; запрашивается подтверждение."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:286
msgid ""
"Envoie un retrait : votre entrée est supprimée du compteur, puis la clé est "
"effacée de cette installation et les envois quotidiens s'arrêtent."
msgstr ""
"Отправляет отзыв: ваша запись удаляется из счётчика, затем ключ стирается с "
"этой установки, и ежедневная отправка прекращается."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:288
msgid ""
"Réception injoignable : la clé est quand même effacée ; l'entrée disparaît "
"seule (90 jours en envoi quotidien, 1 an en envoi unique)."
msgstr ""
"Приёмник недоступен: ключ всё равно стирается; запись исчезнет сама (90 дней"
" при ежедневной отправке, 1 год при однократной)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:292
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:65
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:69
msgid "Contacter le support"
msgstr "Связаться с поддержкой"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:293
msgid ""
"Ouvre le formulaire de contact du site (https://kraynux.snake-"
"mackarel.ts.net/contact/). L'adresse kraynux@proton.me est aussi affichée."
msgstr ""
"Открывает форму обратной связи сайта (https://kraynux.snake-"
"mackarel.ts.net/contact/). Также показан адрес kraynux@proton.me."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:295
msgid "Aucune saisie : omega-serv n'envoie jamais de message lui-même."
msgstr ""
"Ничего вводить не нужно: omega-serv никогда сам не отправляет сообщений."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:296
msgid "Ouvre l'adresse dans votre navigateur."
msgstr "Открывает адрес в вашем браузере."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:297
msgid "Sans session graphique, recopiez l'adresse affichée."
msgstr "Без графического сеанса скопируйте показанный адрес."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:300
msgid "Vérifier les mises à jour / Voir les nouveautés"
msgstr "Проверить обновления / Что нового"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:301
msgid ""
"Compare la version installée (aussi affichée dans la barre de titre) à la "
"liste des versions publiées sur le site (download/sha.txt)."
msgstr ""
"Сравнивает установленную версию (она также показана в строке заголовка) со "
"списком версий, опубликованных на сайте (download/sha.txt)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:303
msgid ""
"Seulement sur votre clic : aucune vérification automatique, rien n'est "
"envoyé. Même vérification en ligne de commande : omega-serv version --check."
msgstr ""
"Только по вашему нажатию: автоматической проверки нет, ничего не "
"отправляется. Та же проверка в командной строке: omega-serv version --check."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:305
msgid ""
"Affiche « à jour », la nouvelle version avec l'adresse de son archive, ou "
"une version en cours plus récente que la dernière publiée."
msgstr ""
"Показывает «актуально», новую версию с адресом её архива или текущую версию,"
" более новую, чем последняя опубликованная."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:307
msgid ""
"Si une version plus récente existe, « Voir les nouveautés » ouvre son résumé"
" dans votre navigateur. Rien n'est installé : la mise à jour se fait comme "
"décrit dans le README."
msgstr ""
"Если существует более новая версия, «Что нового» открывает её описание в "
"браузере. Ничего не устанавливается: обновление выполняется так, как описано"
" в README."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:311
msgid ""
"Rien n'est envoyé sans un clic explicite sur Envoyer (formulaire de "
"déclaration) ou sur Ne plus me déclarer."
msgstr ""
"Ничего не отправляется без явного нажатия «Отправить» (форма регистрации) "
"или «Больше не регистрировать меня»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:317
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:114
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:55
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:61
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:96
msgid "Se déclarer utilisateur (anonyme)"
msgstr "Зарегистрироваться как пользователь (анонимно)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:318
msgid "Contact et support -> Se déclarer utilisateur (anonyme)"
msgstr ""
"Контакты и поддержка -> Зарегистрироваться как пользователь (анонимно)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:319
msgid ""
"Déclaration volontaire et anonyme : elle compte les utilisateurs d'omega-"
"serv et, si vous le souhaitez, leur continent ou leur pays. Rien n'est "
"activé par défaut."
msgstr ""
"Добровольная анонимная регистрация: она считает пользователей omega-serv и, "
"по вашему желанию, их континент или страну. По умолчанию ничего не включено."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:323
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:85
msgid "Envoi"
msgstr "Отправка"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:324
msgid "Une seule fois, ou chaque jour."
msgstr "Один раз или каждый день."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:325
msgid ""
"Obligatoire, aucun choix présélectionné : Envoyer reste grisé tant qu'il "
"n'est pas choisi."
msgstr ""
"Обязательно, ничего не выбрано заранее: «Отправить» остаётся неактивной, "
"пока не сделан выбор."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:326
msgid ""
"Une seule fois : un envoi maintenant. Chaque jour : le service omega-serv "
"renvoie le même message au plus une fois par 24 h, ce qui permet de compter "
"les installations actives."
msgstr ""
"Один раз: одна отправка сейчас. Каждый день: служба omega-serv повторно "
"отправляет то же сообщение не чаще раза в 24 ч, что позволяет считать "
"активные установки."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:328
msgid ""
"L'envoi quotidien tourne dans un processus à part : il ne ralentit jamais le"
" serveur, ni au démarrage ni à l'arrêt. DO_NOT_TRACK=1 dans l'environnement "
"du service le désactive."
msgstr ""
"Ежедневная отправка работает в отдельном процессе: она никогда не замедляет "
"сервер ни при запуске, ни при остановке. DO_NOT_TRACK=1 в окружении службы "
"её отключает."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:332
msgid "Continent / Pays"
msgstr "Континент / Страна"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:333
msgid ""
"Deux listes indépendantes, facultatives, chacune avec « Autre (non "
"référencé) »."
msgstr ""
"Два независимых необязательных списка, в каждом есть «Другое (нет в "
"списке)»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:334
msgid "Laisser « Non précisé » pour ne rien envoyer de ce champ."
msgstr "Оставьте «Не указан», чтобы ничего не отправлять из этого поля."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:335
msgid "Ajoute le code choisi au message (EU, FR... ou autre)."
msgstr "Добавляет выбранный код в сообщение (EU, FR... или autre)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:336
msgid "Ni ville, ni texte libre."
msgstr "Ни города, ни произвольного текста."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:339
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:102
msgid "Message envoyé"
msgstr "Отправляемое сообщение"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:340
msgid "Le message exact, mis à jour à chaque choix."
msgstr "Точное сообщение, обновляется при каждом выборе."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:341
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:197
msgid "Lecture seule."
msgstr "Только чтение."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:342
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:45
msgid "Aucune."
msgstr "Нет."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:343
msgid ""
"Une clé tirée au hasard (32 caractères) est créée au premier envoi, sous "
"var/lib/declaration/ ; elle ne dérive ni de la machine ni de vous."
msgstr ""
"При первой отправке в var/lib/declaration/ создаётся случайный ключ (32 "
"символа); он не выводится ни из машины, ни из ваших данных."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:347
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:115
msgid "Envoyer"
msgstr "Отправить"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:348
msgid "Envoie la déclaration en HTTPS vers le site du développeur."
msgstr "Отправляет регистрацию по HTTPS на сайт разработчика."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:349
msgid "5 secondes au plus ; l'écran ne se fige pas."
msgstr "Не более 5 секунд; экран никогда не зависает."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:350
msgid "Succès : retour à Contact et support, état « déclaré »."
msgstr "Успех: возврат к «Контакты и поддержка», статус «зарегистрирован»."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:351
msgid ""
"Réception injoignable : en « une seule fois », rien n'est enregistré ; en « "
"chaque jour », l'accord est gardé et le service réessaie dans 24 h."
msgstr ""
"Приёмник недоступен: при «один раз» ничего не сохраняется; при «каждый день»"
" согласие сохраняется, и служба повторит попытку через 24 ч."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:356
msgid ""
"L'adresse IP n'est pas enregistrée dans les déclarations, mais comme pour "
"toute visite d'un site, elle passe par les contrôles de sécurité et le "
"journal technique du serveur de réception."
msgstr ""
"IP-адрес не сохраняется в регистрациях, но, как и при любом посещении сайта,"
" он проходит через проверки безопасности и технический журнал принимающего "
"сервера."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:358
msgid ""
"Ligne de commande : omega-serv declaration status | declare --mode "
"unique|quotidien [--continent X] [--pays Y] --yes | withdraw."
msgstr ""
"Командная строка: omega-serv declaration status | declare --mode "
"unique|quotidien [--continent X] [--pays Y] --yes | withdraw."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:12
#: src/omega_serv/interfaces/tui/guide/content/faq.py:28
#: src/omega_serv/interfaces/tui/guide/content/faq.py:40
#: src/omega_serv/interfaces/tui/guide/content/faq.py:52
#: src/omega_serv/interfaces/tui/guide/content/faq.py:72
msgid "Redémarrage et rechargement"
msgstr "Перезапуск и перезагрузка"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:13
msgid ""
"J'ai active/modifie une option, mais rien ne change sur le serveur - "
"pourquoi ?"
msgstr ""
"Я включил/изменил параметр, но на сервере ничего не меняется - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:15
msgid ""
"Le serveur tourne dans un PROCESSUS DÉJÀ LANCÉ, séparé de l'interface. "
"Écrire un changement dans le fichier de configuration ne le fait jamais "
"relire tout seul par ce processus : il faut soit le RECHARGER (SIGHUP, écran"
" SERVICE -> Recharger - léger, aucune coupure de connexion), soit le "
"REDÉMARRER COMPLÈTEMENT (coupe toutes les connexions en cours). La plupart "
"des écrans de configuration détaillée déclenchent désormais ce rechargement "
"automatiquement dès qu'un service systemd actif est détecté, et vous "
"avertissent sinon. Quelques réglages (bind/port, listen_backlog, TLS, 1ere "
"activation de fastcgi/reverse_proxy, active_defense) exigent toujours un "
"redémarrage complet - jamais un simple rechargement - car ils touchent le "
"socket d'écoute ou des composants construits une seule fois au démarrage."
msgstr ""
"Сервер работает в УЖЕ ЗАПУЩЕННОМ ПРОЦЕССЕ, отдельном от интерфейса. Запись "
"изменения в файл конфигурации никогда не заставляет этот процесс перечитать "
"его сам: нужно либо ПЕРЕЗАГРУЗИТЬ его (SIGHUP, экран СЛУЖБА -> Перезагрузить"
" - легко, без обрыва соединений), либо ПОЛНОСТЬЮ ПЕРЕЗАПУСТИТЬ (обрывает все"
" текущие соединения). Большинство экранов подробной настройки теперь "
"запускают эту перезагрузку автоматически, как только обнаружена активная "
"служба systemd, а иначе предупреждают вас. Некоторые настройки (bind/port, "
"listen_backlog, TLS, первое включение fastcgi/reverse_proxy, active_defense)"
" всегда требуют полного перезапуска - никогда не простой перезагрузки, - "
"потому что затрагивают слушающий сокет или компоненты, создаваемые только "
"один раз при запуске."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:29
msgid ""
"Après une mise à jour d'omega-serv, mes nouveaux réglages ne s'appliquent "
"pas alors que le service est « rechargé » - pourquoi ?"
msgstr ""
"После обновления omega-serv мои новые настройки не применяются, хотя служба "
"« перезагружена » - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:31
msgid ""
"Un rechargement ne relit que la configuration, jamais le programme déjà "
"chargé en mémoire. Si le service tournait déjà avant l'extraction de la mise"
" à jour, il exécute toujours l'ancienne version, qui ignore les réglages "
"apparus depuis. Redémarrez le service une fois après chaque mise à jour "
"(écran SERVICE -> Redémarrer). L'interface le signale : notification à "
"l'accueil, et avertissement après chaque rechargement, tant que le service "
"n'a pas été redémarré (systemd et runit)."
msgstr ""
"Перезагрузка перечитывает только конфигурацию, но никогда не программу, уже "
"загруженную в память. Если служба работала ещё до распаковки обновления, она"
" по-прежнему выполняет старую версию, которая игнорирует появившиеся с тех "
"пор настройки. Перезапускайте службу один раз после каждого обновления "
"(экран СЛУЖБА -> Перезапустить). Интерфейс сообщает об этом: уведомление на "
"главном экране и предупреждение после каждой перезагрузки, пока служба не "
"будет перезапущена (systemd и runit)."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:41
msgid ""
"Comment savoir si un changement précis a besoin d'un rechargement ou d'un "
"redémarrage complet ?"
msgstr ""
"Как узнать, нужна ли для конкретного изменения перезагрузка или полный "
"перезапуск?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:43
msgid ""
"La réaction exacte de chaque champ est indiquée dans sa fiche du guide "
"(touche F1 depuis l'écran concerne). En règle générale : tout ce qui touche "
"le socket d'écoute (adresse, port, listen_backlog), le contexte TLS, ou un "
"composant construit une seule fois au démarrage (client FastCGI/reverse "
"proxy à la première activation, Active Defense) exige un redémarrage "
"complet. Tout le reste se recharge à chaud."
msgstr ""
"Точная реакция каждого поля указана в его карточке справочника (клавиша F1 "
"на соответствующем экране). Общее правило: всё, что затрагивает слушающий "
"сокет (адрес, порт, listen_backlog), контекст TLS или компонент, создаваемый"
" один раз при запуске (клиент FastCGI/обратного прокси при первом включении,"
" Active Defense), требует полного перезапуска. Всё остальное перезагружается"
" на лету."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:54
msgid ""
"J'ai mis à jour le code d'OMEGA-SERV (nouvelle archive, correctif appliqué) "
"mais le comportement ne change jamais, même après un rechargement (SIGHUP) -"
" pourquoi ?"
msgstr ""
"Я обновил код OMEGA-SERV (новый архив, применено исправление), но поведение "
"не меняется даже после перезагрузки (SIGHUP) - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:58
msgid ""
"Piège réel rencontré (2026-10-10, correctif du rendu du directory listing "
"sous une CSP stricte) : le rechargement à chaud (SIGHUP, écran SERVICE -> "
"Recharger) ne relit QUE certains éléments de CONFIGURATION (règles WAF, "
"zones d'authentification) - il ne recharge JAMAIS le CODE Python lui-même, "
"qui reste celui chargé en mémoire depuis le DERNIER DÉMARRAGE du processus, "
"aussi anciens soient les fichiers sur disque. Après une mise à jour du code "
"(nouvelle archive installée, correctif appliqué), un REDÉMARRAGE COMPLET est"
" TOUJOURS nécessaire (`systemctl restart <service>`, ou écran SERVICE -> "
"Arrêter puis Démarrer) - jamais un simple rechargement, même pour un "
"changement qui semble léger. Vérifiez `systemctl status <service>` : une "
"date de démarrage ('Active: active (running) since ...') plus ancienne que "
"votre mise à jour confirme immédiatement ce diagnostic."
msgstr ""
"Реальная ловушка (2026-10-10, исправление отображения листинга каталогов при"
" строгой CSP): перезагрузка на лету (SIGHUP, экран СЛУЖБА -> Перезагрузить) "
"перечитывает ТОЛЬКО некоторые элементы КОНФИГУРАЦИИ (правила WAF, зоны "
"аутентификации) - она НИКОГДА не перезагружает сам КОД Python, который "
"остаётся загруженным в память с ПОСЛЕДНЕГО ЗАПУСКА процесса, какими бы "
"старыми ни были файлы на диске. После обновления кода (установлен новый "
"архив, применено исправление) ВСЕГДА нужен ПОЛНЫЙ ПЕРЕЗАПУСК (`systemctl "
"restart <служба>` или экран СЛУЖБА -> Остановить, затем Запустить) - никогда"
" не простая перезагрузка, даже если изменение кажется небольшим. Проверьте "
"`systemctl status <служба>`: дата запуска ('Active: active (running) since "
"...') раньше вашего обновления сразу подтверждает этот диагноз."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:73
msgid ""
"Le rechargement/redemarrage automatique ne s'est pas déclenché - pourquoi ?"
msgstr "Автоматическая перезагрузка/перезапуск не сработали - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:75
msgid ""
"Le déclenchement automatique ne fonctionne que si un gestionnaire de service"
" système (systemd/OpenRC/runit) est reconnu ET qu'un service est réellement "
"ACTIF pour ce répertoire. Si vous faites tourner le serveur via l'assistant "
"premier lancement (\"Lancer maintenant\", sans service installé), aucun "
"rechargement automatique n'est possible - relancez manuellement, ou "
"installez le service depuis l'écran SERVICE."
msgstr ""
"Автоматический запуск работает, только если распознан системный менеджер "
"служб (systemd/OpenRC/runit) И для этого каталога действительно АКТИВНА "
"служба. Если вы запускаете сервер через мастер первого запуска (\"Запустить "
"сейчас\", без установленной службы), автоматическая перезагрузка невозможна "
"- перезапустите вручную или установите службу на экране СЛУЖБА."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:84
#: src/omega_serv/interfaces/tui/guide/content/faq.py:95
msgid "Service système"
msgstr "Системная служба"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:85
msgid ""
"Juste après 'Installer l'unité', l'écran État & Ressources affiche 'Arrêté' "
"alors que le service tourne - pourquoi ?"
msgstr ""
"Сразу после 'Установить юнит' экран Состояние и ресурсы показывает "
"'Остановлена', хотя служба работает - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:87
msgid ""
"L'installation crée un compte système dédié et ajoute votre session au "
"groupe correspondant, mais l'appartenance à un NOUVEAU groupe Unix ne "
"s'applique jamais à une session déjà ouverte (même terminal déjà lancé avant"
" l'installation). Déconnectez-vous puis reconnectez-vous UNE SEULE FOIS - "
"l'écran affichera alors l'état réel. En attendant, vérifiez via l'écran "
"SERVICE ou `systemctl status`."
msgstr ""
"Установка создаёт выделенную системную учётную запись и добавляет ваш сеанс "
"в соответствующую группу, но членство в НОВОЙ группе Unix никогда не "
"применяется к уже открытому сеансу (даже к терминалу, запущенному до "
"установки). Выйдите из системы и войдите снова ОДИН РАЗ - тогда экран "
"покажет реальное состояние. Пока что проверяйте через экран СЛУЖБА или "
"`systemctl status`."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:96
msgid ""
"Le champ 'Nom du service' dans l'écran SERVICE ne correspond pas à ce que je"
" pilote ailleurs - pourquoi ?"
msgstr ""
"Поле 'Имя службы' на экране СЛУЖБА не соответствует тому, чем я управляю в "
"другом месте - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:98
msgid ""
"Ce champ persiste une préférence d'interface, distincte de la configuration "
"serveur. Si cette instance est enregistrée en multi-instance, le nom est "
"FIGÉ (celui choisi à la création) - jamais improvisé ici. Une seule "
"interface peut déjà piloter n'importe quelle unité installée en tapant "
"simplement son nom exact, même celle d'une autre copie du projet."
msgstr ""
"Это поле хранит настройку интерфейса, отдельную от конфигурации сервера. "
"Если этот экземпляр зарегистрирован в режиме нескольких экземпляров, имя "
"ЗАФИКСИРОВАНО (выбрано при создании) - здесь его никогда не придумывают. "
"Один интерфейс уже может управлять любым установленным юнитом, достаточно "
"ввести его точное имя, даже если это юнит другой копии проекта."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:106
#: src/omega_serv/interfaces/tui/guide/content/faq.py:118
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:115
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:78
#: src/omega_serv/interfaces/tui/screens/home.py:84
msgid "Multi-instance"
msgstr "Несколько экземпляров"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:107
msgid ""
"Puis-je installer une seconde unité systemd qui pointe vers le même "
"répertoire, sous un autre nom ?"
msgstr ""
"Можно ли установить второй юнит systemd, указывающий на тот же каталог, под "
"другим именем?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:109
msgid ""
"Non - deux garde-fous bloquent explicitement cette situation avant toute "
"écriture : une unité différente pointant déjà vers ce répertoire "
"(partagerait silencieusement var/, la configuration et le compte système "
"dédié), et un nom déjà utilisé par une unité pointant vers un AUTRE "
"répertoire (volerait ce nom, écrasant l'unité existante). Pour héberger "
"plusieurs serveurs, utilisez Multi-instance : chaque instance a son propre "
"répertoire, sa propre configuration et son propre compte système."
msgstr ""
"Нет - две защиты явно блокируют эту ситуацию до любой записи: другой юнит, "
"уже указывающий на этот каталог (он незаметно делил бы var/, конфигурацию и "
"выделенную системную учётную запись), и имя, уже используемое юнитом, "
"который указывает на ДРУГОЙ каталог (оно было бы перехвачено с перезаписью "
"существующего юнита). Для размещения нескольких серверов используйте "
"Несколько экземпляров: у каждого экземпляра свой каталог, своя конфигурация "
"и своя системная учётная запись."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:119
msgid ""
"La création d'une nouvelle instance échoue à l'étape 4/6 (Installation des "
"dépendances) - pourquoi ?"
msgstr ""
"Создание нового экземпляра завершается ошибкой на шаге 4/6 (Установка "
"зависимостей) - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:121
msgid ""
"Piège réel corrigé : si le message d'échec mentionne 'omega-lib' et 'No "
"matching distribution found', c'était un bug de la création d'instance elle-"
"même, pas une erreur de votre part - omega-lib n'est pas publiée sur PyPI, "
"et l'ancienne version ne savait retrouver sa source réelle (vendorée ou "
"depuis un clone de développement) que dans un seul des deux cas. Corrigé : "
"la nouvelle instance réutilise désormais la même source qu'omega-lib déjà "
"installée pour l'instance en cours, quelle que soit sa provenance. Si "
"l'échec persiste malgré une version à jour, vérifiez que le réseau est "
"disponible pour les AUTRES dépendances (`textual`, `pyte`, `jinja2`, "
"`psutil`), qui viennent bien de PyPI."
msgstr ""
"Исправленная реальная ловушка: если сообщение об ошибке упоминает 'omega-"
"lib' и 'No matching distribution found', это была ошибка самого создания "
"экземпляров, а не ваша - omega-lib не опубликована в PyPI, и старая версия "
"умела находить её реальный источник (встроенный или из клона для разработки)"
" только в одном из двух случаев. Исправлено: новый экземпляр теперь "
"использует тот же источник, что и omega-lib, уже установленная для текущего "
"экземпляра, откуда бы она ни была. Если ошибка сохраняется при актуальной "
"версии, проверьте доступность сети для ОСТАЛЬНЫХ зависимостей (`textual`, "
"`pyte`, `jinja2`, `psutil`), которые действительно берутся из PyPI."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:133
#: src/omega_serv/interfaces/tui/guide/content/faq.py:143
#: src/omega_serv/interfaces/tui/guide/content/faq.py:156
#: src/omega_serv/interfaces/tui/guide/content/faq.py:172
#: src/omega_serv/interfaces/tui/guide/content/faq.py:184
#: src/omega_serv/interfaces/tui/guide/content/faq.py:197
#: src/omega_serv/interfaces/tui/guide/content/faq.py:208
#: src/omega_serv/interfaces/tui/guide/content/faq.py:225
#: src/omega_serv/interfaces/tui/guide/content/faq.py:240
#: src/omega_serv/interfaces/tui/guide/content/faq.py:253
#: src/omega_serv/interfaces/tui/guide/content/faq.py:267
#: src/omega_serv/interfaces/tui/guide/content/faq.py:278
#: src/omega_serv/interfaces/tui/guide/content/faq.py:288
#: src/omega_serv/interfaces/tui/guide/content/faq.py:298
#: src/omega_serv/interfaces/tui/guide/content/faq.py:311
#: src/omega_serv/interfaces/tui/guide/content/faq.py:322
#: src/omega_serv/interfaces/tui/guide/content/faq.py:335
#: src/omega_serv/interfaces/tui/guide/content/faq.py:346
#: src/omega_serv/interfaces/tui/guide/content/faq.py:581
msgid "WAF/Active Defense"
msgstr "WAF/Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:134
msgid "Le WAF est actif mais ne bloque jamais rien - pourquoi ?"
msgstr "WAF включён, но ничего не блокирует - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:136
msgid ""
"Vérifiez d'abord l'écran WAF - État : si 'Packs de règles référencés' est à "
"zéro, le WAF ne peut RIEN détecter même actif (piège réel déjà rencontré). "
"Ajoutez au moins un pack depuis WAF - Modules. Vérifiez ensuite le mode : "
"'log-only' journalise sans jamais bloquer, seul 'block' bloque réellement."
msgstr ""
"Сначала проверьте экран WAF - Состояние: если 'Подключённые пакеты правил' "
"равно нулю, WAF не может обнаружить НИЧЕГО даже во включённом состоянии "
"(реальная ловушка, уже встречавшаяся). Добавьте хотя бы один пакет в WAF - "
"Модули. Затем проверьте режим: 'log-only' записывает в журнал, никогда не "
"блокируя, реально блокирует только 'block'."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:144
msgid ""
"J'ai activé l'option 'active_defense' mais rien ne se passe jamais (aucune "
"menace, aucun incident) - pourquoi ?"
msgstr ""
"Я включил параметр 'active_defense', но ничего не происходит (ни угроз, ни "
"инцидентов) - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:146
msgid ""
"Activer l'option elle-même (menu Options) ne suffit PAS. Un second "
"interrupteur, `war_mode.enabled`, vaut FALSE par défaut - activez-le depuis "
"Active Defense -> Réglages -> 'Mode guerre actif'. Vérifiez la ligne 'Mode "
"guerre' sur l'écran Active Defense - État : si elle affiche 'inactif', c'est"
" la cause. Un REDÉMARRAGE COMPLET est ensuite nécessaire (active_defense "
"n'est jamais rechargé à chaud). Une fois actif, tout devient automatique - "
"le score de chaque source est alimenté par les décisions WAF déjà calculées "
"à chaque requête, sans aucune action manuelle."
msgstr ""
"Включения самого параметра (меню Параметры) НЕДОСТАТОЧНО. Второй "
"переключатель, `war_mode.enabled`, по умолчанию равен FALSE - включите его в"
" Active Defense -> Настройки -> 'Боевой режим включён'. Проверьте строку "
"'Боевой режим' на экране Active Defense - Состояние: если там 'неактивен', "
"причина в этом. Затем нужен ПОЛНЫЙ ПЕРЕЗАПУСК (active_defense никогда не "
"перезагружается на лету). После включения всё становится автоматическим - "
"балл каждого источника пополняется уже вычисленными для каждого запроса "
"решениями WAF, без ручных действий."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:157
msgid "Active Defense en production : quelles limites connaître ?"
msgstr "Active Defense в продакшене: какие ограничения нужно знать?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:159
msgid ""
"Mesuré sur une machine à 2 cœurs : aucun coût sans attaque. Face à des "
"attaquants qui reviennent, le mode guerre les ralentit (environ 0,4 s par "
"requête) et le serveur sert même plus vite les visiteurs légitimes. Face à "
"un botnet qui change d'adresse à chaque requête, Active Defense coûte de 10 "
"à 16 % de débit. La base est bornée : au plus 200 000 sources suivies (les "
"sources « normal » les plus anciennes partent d'abord), journal d'audit "
"purgé au-delà de 30 jours et de 200 000 lignes, historique d'un incident "
"limité aux 100 premiers et aux 1 000 derniers éléments. La purge des états "
"expirés est automatique (au plus toutes les 10 minutes) ; le fichier de la "
"base ne rétrécit pas, SQLite réutilise la place libérée. Sauvegardez la base"
" avec `config backup --include-active-defense`."
msgstr ""
"Измерено на машине с 2 ядрами: без атаки затрат нет. Против возвращающихся "
"атакующих боевой режим их замедляет (около 0,4 с на запрос), и сервер даже "
"быстрее обслуживает обычных посетителей. Против ботнета, меняющего адрес при"
" каждом запросе, Active Defense стоит от 10 до 16 % пропускной способности. "
"База ограничена: не более 200 000 отслеживаемых источников (сначала "
"удаляются самые старые источники « normal »), журнал аудита очищается после "
"30 дней и 200 000 строк, история инцидента ограничена первыми 100 и "
"последними 1 000 элементами. Истёкшие состояния очищаются автоматически (не "
"реже чем раз в 10 минут); файл базы не уменьшается, SQLite повторно "
"использует освободившееся место. Делайте резервную копию базы командой "
"`config backup --include-active-defense`."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:173
msgid ""
"Une purge ou une sauvegarde pendant une attaque peut-elle bloquer le serveur"
" ?"
msgstr ""
"Может ли очистка или резервное копирование во время атаки заблокировать "
"сервер?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:175
msgid ""
"Non : le serveur écrit dans la base d'Active Defense depuis un fil "
"d'arrière-plan, jamais pendant une requête. Si la base est verrouillée "
"(purge, sauvegarde, autre programme), les écritures attendent puis "
"reprennent seules ; error.log reçoit une ligne au début (« écriture en base "
"impossible ») et une à la fin (« rétablie »). Au-delà de 10 000 observations"
" en attente, les suivantes sont abandonnées et comptées ; les requêtes, "
"elles, sont toujours servies."
msgstr ""
"Нет: сервер пишет в базу Active Defense из фонового потока, никогда во время"
" запроса. Если база заблокирована (очистка, резервное копирование, другая "
"программа), записи ждут, а затем возобновляются сами; в error.log появляется"
" строка в начале (« écriture en base impossible ») и строка в конце (« "
"rétablie »). Сверх 10 000 ожидающих наблюдений следующие отбрасываются и "
"подсчитываются; запросы обслуживаются всегда."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:185
msgid "Comment partager un incident avec MISP ou OpenCTI ?"
msgstr "Как поделиться инцидентом с MISP или OpenCTI?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:187
msgid ""
"Exportez-le au format misp ou stix (écran Incidents -> Exporter IoC, ou "
"`incidents export-ioc <id> --format stix,misp`). Dans MISP : Add Event -> "
"Populate from -> MISP JSON, puis le fichier .misp.json. Dans OpenCTI ou un "
"SIEM : importez le bundle .stix.json. Les fichiers restent sur votre "
"serveur, omega-serv n'envoie rien. Le marquage TLP se règle dans Active "
"Defense -> Réglages (amber par défaut). Seules les adresses IP sont "
"exportées ; l'adresse d'un attaquant reste une donnée personnelle : vérifiez"
" avant de partager."
msgstr ""
"Экспортируйте его в формате misp или stix (экран Инциденты -> Экспорт IoC "
"или `incidents export-ioc <id> --format stix,misp`). В MISP: Add Event -> "
"Populate from -> MISP JSON, затем файл .misp.json. В OpenCTI или SIEM: "
"импортируйте пакет .stix.json. Файлы остаются на вашем сервере, omega-serv "
"ничего не отправляет. Метка TLP задаётся в Active Defense -> Настройки (по "
"умолчанию amber). Экспортируются только IP-адреса; адрес атакующего остаётся"
" персональными данными: проверьте перед отправкой."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:198
msgid ""
"J'ai créé une règle WAF personnalisée mais elle ne se déclenche jamais - "
"pourquoi ?"
msgstr ""
"Я создал собственное правило WAF, но оно никогда не срабатывает - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:200
msgid ""
"Utilisez l'écran WAF - Règles personnalisées (pas 'Modules') pour CRÉER la "
"règle elle-même - il l'écrit dans custom.json ET référence automatiquement "
"ce pack. Ajouter seulement le pack custom.json comme référence depuis "
"'Modules' ne crée aucune règle si le fichier est encore vide. Utilisez "
"l'écran 'Tester une requête' pour vérifier qu'une règle se déclenche bien "
"avant de compter dessus en production."
msgstr ""
"Используйте экран WAF - Свои правила (а не 'Модули'), чтобы СОЗДАТЬ само "
"правило - он записывает его в custom.json И автоматически подключает этот "
"пакет. Одно лишь подключение пакета custom.json в 'Модули' не создаёт "
"никакого правила, если файл ещё пуст. Используйте экран 'Проверка запроса', "
"чтобы убедиться, что правило срабатывает, прежде чем полагаться на него в "
"рабочей среде."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:209
msgid "Quelle classe d'attaque choisir pour un profil de leurre ?"
msgstr "Какой класс атаки выбрать для профиля приманки?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:211
msgid ""
"Les 8 classes possibles et ce qu'elles ciblent concrètement : scan (sondage "
"d'URLs/ports, scanners automatisés), credential_stuffing (essais massifs de "
"mots de passe sur un formulaire de login), sqli (tentative d'injection SQL),"
" xss (script injecté dans un paramètre), path_traversal (tentative de sortir"
" du dossier servi, ex : ../../etc/passwd), upload_probe (upload de fichier "
"suspect), api_probe (sondage d'endpoints /api/...), unknown (tout ce qui ne "
"correspond à aucune des catégories précédentes - un filet de sécurité "
"générique). Exemple : un profil nommé fake_admin avec les classes "
"scan,credential_stuffing attirera les scanners et les tentatives de "
"bruteforce de connexion vers une fausse page d'authentification. Plusieurs "
"classes peuvent être listées, séparées par des virgules."
msgstr ""
"8 возможных классов и то, на что они конкретно нацелены: scan (зондирование "
"URL/портов, автоматические сканеры), credential_stuffing (массовый перебор "
"паролей в форме входа), sqli (попытка SQL-инъекции), xss (скрипт, внедрённый"
" в параметр), path_traversal (попытка выйти за пределы обслуживаемого "
"каталога, напр.: ../../etc/passwd), upload_probe (загрузка подозрительного "
"файла), api_probe (зондирование эндпоинтов /api/...), unknown (всё, что не "
"подходит ни под одну из предыдущих категорий - общая страховочная сеть). "
"Пример: профиль fake_admin с классами scan,credential_stuffing направит "
"сканеры и попытки перебора входа на поддельную страницу аутентификации. "
"Можно указать несколько классов через запятую."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:221
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:124
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:305
msgid ""
"Nouvelle classe (2.1) : command_injection (injection de commandes shell, ex "
": $(...), ; cat /etc/passwd). Les sondes WordPress (wp-login, xmlrpc.php) "
"sont classées scan."
msgstr ""
"Новый класс (2.1): command_injection (внедрение команд оболочки, например "
"$(...), ; cat /etc/passwd). Зонды WordPress (wp-login, xmlrpc.php) относятся"
" к scan."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:226
msgid "« Ajouter un profil de leurre » refuse le profil - que corriger ?"
msgstr "«Добавить профиль ловушки» отклоняет профиль - что исправить?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:228
msgid ""
"Rien n'est enregistré tant que le profil est invalide. Le formulaire reste "
"ouvert, la raison s'affiche sous les champs et la saisie est conservée : "
"corrigez le champ indiqué, puis cliquez à nouveau sur Valider. Causes les "
"plus fréquentes : (1) Isolation = fixture avec un nom autre que fake_admin, "
"fake_cms, fake_api ou fake_secrets (en minuscules, sans espace) ; (2) classe"
" d'attaque mal écrite - valeurs exactes, séparées par des virgules : scan, "
"credential_stuffing, sqli, xss, path_traversal, upload_probe, api_probe, "
"command_injection, unknown ; (3) Isolation = proxy sans zone de leurre, ou "
"avec un nom de zone qui n'existe pas encore (créez d'abord la zone dans « "
"Zones de leurre ») ; (4) un autre réglage de l'écran est invalide (le "
"message le nomme). Le plus simple : Isolation fixture, l'un des 4 noms, zone"
" vide. Le formulaire « Ajouter une zone » fonctionne de la même façon."
msgstr ""
"Пока профиль некорректен, ничего не сохраняется. Форма остаётся открытой, "
"причина показывается под полями, а введённые данные сохраняются: исправьте "
"указанное поле и снова нажмите «Подтвердить». Самые частые причины: (1) "
"Isolation = fixture с именем, отличным от fake_admin, fake_cms, fake_api или"
" fake_secrets (строчными буквами, без пробелов); (2) класс атаки написан с "
"ошибкой - точные значения через запятую: scan, credential_stuffing, sqli, "
"xss, path_traversal, upload_probe, api_probe, command_injection, unknown; "
"(3) Isolation = proxy без зоны приманок или с именем зоны, которой ещё нет "
"(сначала создайте зону в «Зоны приманок»); (4) другая настройка экрана "
"недопустима (сообщение её называет). Проще всего: Isolation fixture, одно из"
" 4 имён, пустая зона. Форма «Добавить зону» работает так же."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:241
msgid ""
"Mon profil de leurre en isolation 'fixture' ne se déclenche jamais - "
"pourquoi ?"
msgstr ""
"Мой профиль приманки с изоляцией 'fixture' никогда не срабатывает - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:243
msgid ""
"Le NOM du profil doit correspondre EXACTEMENT à l'une des 4 fixtures "
"réellement implémentées : fake_admin, fake_cms, fake_api, fake_secrets. Tout"
" autre nom (même descriptif, ex : 'mon-leurre-perso') faisait auparavant que"
" le leurre ne se déclenchait jamais, sans aucune erreur visible - le trafic "
"suivait alors le comportement de secours (pass_through ou reject) comme si "
"aucun profil n'existait. L'écran Active Defense -> Réglages refuse désormais"
" d'enregistrer un tel nom et indique clairement le problème."
msgstr ""
"ИМЯ профиля должно ТОЧНО совпадать с одной из 4 реально реализованных "
"fixture: fake_admin, fake_cms, fake_api, fake_secrets. Любое другое имя "
"(даже описательное, напр.: 'моя-приманка') раньше приводило к тому, что "
"приманка никогда не срабатывала, без какой-либо видимой ошибки - трафик "
"тогда шёл по резервному поведению (pass_through или reject), как будто "
"профиля не существует. Экран Active Defense -> Настройки теперь отказывается"
" сохранять такое имя и чётко указывает на проблему."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:254
msgid ""
"J'ai créé une zone de leurre avec une adresse qui n'existe pas encore - que "
"se passe-t-il ?"
msgstr ""
"Я создал зону приманки с адресом, которого ещё не существует - что "
"произойдёт?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:256
msgid ""
"Rien de spécial à l'enregistrement : une zone de leurre (Niveau 2, isolation"
" 'proxy') est une simple cible réseau (host:port), jamais un dossier - "
"aucune création automatique, aucune vérification que l'adresse existe ou "
"répond au moment de la sauvegarde. La conséquence n'apparaît que lors d'une "
"VRAIE requête routée vers cette zone : si rien n'écoute à cette adresse, "
"l'attaquant reçoit simplement une erreur HTTP 502 Bad Gateway (la même "
"mécanique que le reverse proxy de production) - jamais de crash du serveur, "
"jamais de création silencieuse de quoi que ce soit."
msgstr ""
"При сохранении ничего особенного: зона приманки (Уровень 2, изоляция "
"'proxy') - это просто сетевая цель (host:port), а не каталог - ничего не "
"создаётся автоматически, при сохранении не проверяется, существует ли адрес "
"и отвечает ли он. Последствия проявляются только при НАСТОЯЩЕМ запросе, "
"направленном в эту зону: если по этому адресу ничего не слушает, атакующий "
"просто получает ошибку HTTP 502 Bad Gateway (тот же механизм, что и у "
"рабочего обратного прокси) - никогда не падение сервера и никогда не скрытое"
" создание чего-либо."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:268
msgid ""
"Comment bloquer les chemins sensibles (.env, .git, sauvegardes, consoles "
"d'admin...) sans tout écrire à la main ?"
msgstr ""
"Как блокировать конфиденциальные пути (.env, .git, резервные копии, консоли "
"администрирования...), не прописывая всё вручную?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:270
msgid ""
"Active Sécurité -> Custom -> Ajouter -> 'CHARGER une liste de chemins "
"(fichier)', puis choisissez la référence livrée sensitive-paths-hostile (298"
" chemins sans usage légitime) et/ou sensitive-paths-probe (132 chemins de "
"sondage, parfois servis par un vrai site). Les réglages conseillés se "
"remplissent seuls ; gardez Observation au premier chargement. Rien n'est "
"actif avant le clic sur Charger."
msgstr ""
"Активная безопасность -> Custom -> Добавить -> 'ЗАГРУЗИТЬ список путей "
"(файл)', затем выберите поставляемый эталон sensitive-paths-hostile (298 "
"путей без легитимного использования) и/или sensitive-paths-probe (132 пути "
"зондирования, иногда отдаваемые настоящим сайтом). Рекомендуемые настройки "
"заполняются сами; при первой загрузке оставьте Наблюдение. До нажатия "
"Загрузить ничего не активно."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:279
msgid "Quelle différence entre une règle personnalisée et une liste ?"
msgstr "Чем собственное правило отличается от списка?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:281
msgid ""
"Une règle détecte UN motif et vit dans custom.json. Une liste est un fichier"
" texte d'un chemin (ou mot-clé) par ligne, facile à maintenir à plusieurs "
"centaines d'entrées, avec ses exceptions '!/x', sa gravité et sa propre "
"récidive. Les deux apparaissent dans le même tableau de l'écran Custom, "
"colonne Type."
msgstr ""
"Правило обнаруживает ОДИН шаблон и хранится в custom.json. Список - это "
"текстовый файл с одним путём (или ключевым словом) на строку, который легко "
"поддерживать даже при нескольких сотнях записей, со своими исключениями "
"'!/x', своей серьёзностью и собственным учётом повторных нарушений. Оба "
"отображаются в одной таблице экрана Custom, столбец Тип."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:289
msgid ""
"J'ai chargé une liste en Observation - comment savoir ce qu'elle aurait "
"bloqué, puis l'activer ?"
msgstr ""
"Я загрузил список в режиме Наблюдение - как узнать, что он заблокировал бы, "
"и затем включить его?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:291
msgid ""
"En Observation, chaque détection est écrite dans le journal d'alertes WAF, "
"sans aucun blocage ni ban. Lisez ces alertes quelques jours, utilisez "
"'Vérifier contre mes logs' dans l'éditeur pour repérer les lignes qui "
"toucheraient des requêtes légitimes (exception '!/chemin' en un clic), puis "
"Custom -> Modifier -> Gravité Élevé ou Moyen."
msgstr ""
"В режиме Наблюдение каждое обнаружение записывается в журнал оповещений WAF,"
" без блокировок и банов. Читайте эти оповещения несколько дней, используйте "
"'Сверить с журналами' в редакторе, чтобы найти строки, которые задели бы "
"легитимные запросы (исключение '!/путь' одним щелчком), затем Custom -> "
"Изменить -> Серьёзность Высокая или Средняя."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:299
msgid ""
"Mes propres machines (Wi-Fi, Ethernet, Tailscale) risquent-elles d'être "
"bannies par la récidive ?"
msgstr ""
"Могут ли мои собственные машины (Wi-Fi, Ethernet, Tailscale) быть забанены "
"за повторные нарушения?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:301
msgid ""
"Non : l'hôte local, le réseau Tailscale (100.64.0.0/10) et le réseau local "
"(192.168.x, 10.x, 172.16-31.x...) ne sont JAMAIS bannis automatiquement "
"(réglage options.waf.reputation.never_auto_block). Seule une adresse "
"publique peut l'être. Leurs requêtes vers un chemin dangereux restent "
"refusées (403) et journalisées, ce qui permet de tester le WAF. Derrière un "
"proxy local (tailscale serve, reverse proxy), l'exemption de 127.0.0.1 n'est"
" appliquée que si 'Proxy de confiance' est actif - sinon tout Internet "
"paraîtrait venir de 127.0.0.1."
msgstr ""
"Нет: локальный хост, сеть Tailscale (100.64.0.0/10) и локальная сеть "
"(192.168.x, 10.x, 172.16-31.x...) НИКОГДА не банятся автоматически "
"(настройка options.waf.reputation.never_auto_block). Забанен может быть "
"только публичный адрес. Их запросы к опасному пути по-прежнему отклоняются "
"(403) и записываются в журнал, что позволяет проверять WAF. За локальным "
"прокси (tailscale serve, обратный прокси) исключение для 127.0.0.1 "
"применяется, только если включён 'Доверенный прокси' - иначе весь Интернет "
"выглядел бы как пришедший с 127.0.0.1."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:312
msgid ""
"Mettre mes adresses dans 'Proxy de confiance' évite-t-il qu'elles soient "
"bannies ?"
msgstr "Защищает ли добавление моих адресов в 'Доверенный прокси' от бана?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:314
msgid ""
"Non. Les réseaux de confiance disent seulement QUI a le droit de transmettre"
" la vraie adresse du visiteur (en-tête X-Forwarded-For) - en pratique le "
"proxy place devant omega-serv (127.0.0.1 pour tailscale serve). Ils "
"n'exemptent de rien d'autre. Les réseaux à ne jamais bannir sont un réglage "
"distinct (never_auto_block). Une plage large comme 100.0.0.0/8 contient des "
"adresses publiques : préférez 100.64.0.0/10."
msgstr ""
"Нет. Доверенные сети определяют только, КТО вправе передавать настоящий "
"адрес посетителя (заголовок X-Forwarded-For) - на практике это прокси перед "
"omega-serv (127.0.0.1 для tailscale serve). Ни от чего другого они не "
"освобождают. Сети, которые никогда нельзя банить, - это отдельная настройка "
"(never_auto_block). Широкий диапазон вроде 100.0.0.0/8 содержит публичные "
"адреса: лучше 100.64.0.0/10."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:323
msgid "Une page lourde renvoie 429, puis mon IP est bannie - pourquoi ?"
msgstr "Тяжёлая страница возвращает 429, а затем мой IP банится - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:325
msgid ""
"Une page qui charge beaucoup de fichiers (une galerie d'images, par exemple)"
" dépasse la limite de débit globale du WAF (60 requêtes / 60 s par IP par "
"défaut) : le WAF répond 429, et trois rejets en 10 minutes suffisent à "
"omega-jail pour bannir une IP publique 12 h. Solution : Active Sécurité -> "
"Exclusions et débit, ajouter une règle pour le dossier concerné (ex. "
"/images/ à 600 / 60 s). Pour vos propres appareils (Tailscale, réseau "
"local), une règle IP/réseau avec « Source sûre » à oui évite tout "
"bannissement. Une exclusion d'inspection ne suffit pas : le rate limit "
"s'applique quand même."
msgstr ""
"Страница, загружающая много файлов (например, галерея изображений), "
"превышает глобальный лимит запросов WAF (по умолчанию 60 запросов / 60 с с "
"одного IP): WAF отвечает 429, а трёх отказов за 10 минут достаточно, чтобы "
"omega-jail забанил публичный IP на 12 ч. Решение: Активная безопасность -> "
"Исключения и лимит запросов, добавить правило для нужной папки (например, "
"/images/ с 600 / 60 с). Для своих устройств (Tailscale, локальная сеть) "
"правило IP/сети с « Надёжный источник » = да исключает любой бан. Исключения"
" из проверки недостаточно: rate limit всё равно действует."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:336
msgid ""
"« Requêtes max par connexion keep-alive » et la limite de débit du WAF font-"
"ils double emploi ?"
msgstr ""
"Пересекаются ли « Макс. запросов на keep-alive соединение » и лимит запросов"
" WAF?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:338
msgid ""
"Non, ils ne se chevauchent pas. « Requêtes max par connexion keep-alive » "
"(Résistance et limites, défaut 30) ferme seulement une connexion après N "
"requêtes : le navigateur en ouvre une nouvelle aussitôt, sans erreur ni "
"bannissement. La limite de débit du WAF compte les requêtes par IP sur "
"toutes ses connexions et répond 429 au-delà. Monter ou baisser l'un ne "
"change rien à l'autre : un 429 se règle toujours dans Exclusions et débit."
msgstr ""
"Нет, они не пересекаются. « Макс. запросов на keep-alive соединение » "
"(Устойчивость и лимиты, по умолчанию 30) лишь закрывает соединение после N "
"запросов: браузер сразу открывает новое, без ошибки и без бана. Лимит "
"запросов WAF считает запросы с IP по всем его соединениям и сверх лимита "
"отвечает 429. Изменение одного ничего не меняет в другом: 429 всегда "
"устраняется в разделе Исключения и лимит запросов."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:347
msgid "J'ai modifié une liste mais le serveur ne l'applique pas - pourquoi ?"
msgstr "Я изменил список, но сервер его не применяет - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:349
msgid ""
"Le message affiché après 'Enregistrer et appliquer' donne la raison : (1) la"
" liste n'est pas encore chargée dans le WAF (utilisez l'assistant -> "
"Charger) ; (2) la vérification a trouvé un problème (le serveur garde alors "
"ses règles actuelles, rien n'est rechargé à moitié) ; (3) le compte du "
"service ne peut pas lire le fichier ('Corriger les droits') ; (4) aucun "
"service actif - relancez le serveur lancé à la main."
msgstr ""
"Сообщение после 'Сохранить и применить' называет причину: (1) список ещё не "
"загружен в WAF (используйте мастер -> Загрузить); (2) проверка нашла "
"проблему (сервер тогда сохраняет текущие правила, ничего не перезагружается "
"наполовину); (3) учётная запись службы не может прочитать файл ('Исправить "
"права'); (4) нет активной службы - перезапустите сервер, запущенный вручную."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:357
#: src/omega_serv/interfaces/tui/guide/content/faq.py:369
#: src/omega_serv/interfaces/tui/guide/content/faq.py:385
#: src/omega_serv/interfaces/tui/guide/content/faq.py:400
#: src/omega_serv/interfaces/tui/guide/content/faq.py:414
#: src/omega_serv/interfaces/tui/guide/content/faq.py:432
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:854
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:95
msgid "WAF - Magnet (import d'un WAF externe)"
msgstr "WAF - Magnet (импорт внешнего WAF)"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:358
msgid ""
"J'ai activé le script magnet mais le serveur refuse de démarrer / l'écran "
"signale 'lupa' absent - pourquoi ?"
msgstr ""
"Я включил скрипт magnet, но сервер не запускается / экран сообщает об "
"отсутствии 'lupa' - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:360
msgid ""
"Le magnet est un extra OPTIONNEL, jamais installé par défaut : `pip install "
"-e \".[magnet]\"` (dépendance `lupa`, liaison Lua embarquée - aucun "
"interpréteur Lua système requis, une roue précompilée existe pour les "
"plateformes courantes). Son absence est signalée par le registre des "
"capacités (capacité `waf-magnet`, écran Capacités) avec la commande exacte, "
"et bloque `config check`/le démarrage si `options.waf.magnet.enabled` est "
"actif sans cette dépendance - jamais un échec silencieux."
msgstr ""
"Magnet - НЕОБЯЗАТЕЛЬНОЕ дополнение, по умолчанию никогда не устанавливается:"
" `pip install -e \".[magnet]\"` (зависимость `lupa`, встроенная привязка Lua"
" - системный интерпретатор Lua не нужен, для распространённых платформ есть "
"готовый wheel). Его отсутствие отмечается реестром возможностей (возможность"
" `waf-magnet`, экран Возможности) с точной командой и блокирует `config "
"check`/запуск, если `options.waf.magnet.enabled` включён без этой "
"зависимости - никогда не скрытый сбой."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:371
msgid "Le but du magnet, c'est d'écrire un nouveau WAF en Lua ?"
msgstr "Цель magnet - написать новый WAF на Lua?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:374
msgid ""
"Non - c'est l'inverse : importer un script WAF `mod_magnet` Lighttpd "
"EXISTANT, écrit à l'origine pour un autre site, SANS le réécrire. Le pont "
"`lighty.*` (infrastructure/waf/lua_waf_adapter.py) reproduit le modèle "
"d'exécution réel de Lighttpd (`lighty.env`, "
"`lighty.header`/`lighty.content`, convention de retour 0=continuer / code "
"HTTP=bloquer, runtime Lua persistant pour que les compteurs internes du "
"script - rate limiting, blocklist progressive - survivent entre requêtes) "
"plutôt qu'un contrat inventé par OMEGA-SERV. Le natif reste TOUJOURS actif "
"en parallèle : le magnet est un renfort additif, il ne peut jamais lever un "
"blocage déjà décidé par le natif."
msgstr ""
"Нет - наоборот: импортировать СУЩЕСТВУЮЩИЙ WAF-скрипт `mod_magnet` для "
"Lighttpd, изначально написанный для другого сайта, БЕЗ переписывания. Мост "
"`lighty.*` (infrastructure/waf/lua_waf_adapter.py) воспроизводит реальную "
"модель выполнения Lighttpd (`lighty.env`, `lighty.header`/`lighty.content`, "
"соглашение о возврате 0=продолжить / код HTTP=заблокировать, постоянная "
"среда Lua, чтобы внутренние счётчики скрипта - ограничение частоты, "
"прогрессивный blocklist - сохранялись между запросами), а не контракт, "
"придуманный OMEGA-SERV. Встроенный WAF ВСЕГДА остаётся активным параллельно:"
" magnet - дополнительное усиление, он никогда не может снять блокировку, уже"
" принятую встроенным WAF."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:386
msgid ""
"Comment savoir si un script magnet que j'importe est compatible AVANT de "
"l'activer en production ?"
msgstr ""
"Как узнать, совместим ли импортируемый скрипт magnet, ДО включения в рабочей"
" среде?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:388
msgid ""
"Écran Active Sécurité -> WAF -> Magnet, bouton 'Vérifier la compatibilité' "
"(ou `omega-serv waf test` en CLI) - exécute RÉELLEMENT le script avec les "
"valeurs du formulaire en cours de saisie, pas seulement celles déjà "
"enregistrées. Deux contrôles combinés : un scan statique signale toute "
"référence `lighty.X` non supportée par ce pont (reste toujours `nil` côté "
"Lua - un script bien écrit dégrade via son propre repli `or`, un script qui "
"ne dégrade pas remonte une erreur réelle, capturée par le second contrôle) ;"
" un smoke test exécute le script pour de vrai sur une requête de test "
"bénigne. Les deux s'affichent comme avertissements explicites, jamais une "
"vérification cachée."
msgstr ""
"Экран Активная безопасность -> WAF -> Magnet, кнопка 'Проверить "
"совместимость' (или `omega-serv waf test` в CLI) - ДЕЙСТВИТЕЛЬНО выполняет "
"скрипт со значениями формы, которая сейчас редактируется, а не только с уже "
"сохранёнными. Две совмещённые проверки: статический анализ сообщает о любой "
"ссылке `lighty.X`, не поддерживаемой этим мостом (на стороне Lua всегда "
"`nil` - хорошо написанный скрипт деградирует через собственный запасной "
"вариант `or`, а скрипт без такой деградации вызывает реальную ошибку, "
"которую ловит вторая проверка); дымовой тест реально выполняет скрипт на "
"безобидном тестовом запросе. Обе выводятся как явные предупреждения, никогда"
" не скрытая проверка."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:401
msgid ""
"J'ai activé un script magnet avec on_error='fail-closed' et maintenant du "
"trafic légitime se fait bloquer - pourquoi ?"
msgstr ""
"Я включил скрипт magnet с on_error='fail-closed', и теперь блокируется "
"легитимный трафик - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:403
msgid ""
"`fail-closed` bloque TOUTE requête qui déclenche une erreur du script "
"(incompatibilité, exception Lua, timeout) - une politique volontairement "
"stricte, mais dangereuse combinée à un script jamais vérifié au préalable : "
"une seule incompatibilité non détectée peut alors bloquer tout le trafic qui"
" l'atteint. Lancez 'Vérifier la compatibilité' (voir question précédente) "
"avant d'activer fail-closed en production - un avertissement explicite "
"s'affiche précisément quand ces deux conditions se combinent. En cas de "
"doute, repassez `on_error` à 'ignore' (le défaut) : le trafic continue "
"d'être traité par le natif seul si le magnet échoue."
msgstr ""
"`fail-closed` блокирует ЛЮБОЙ запрос, вызывающий ошибку скрипта "
"(несовместимость, исключение Lua, тайм-аут) - намеренно строгая политика, но"
" опасная в сочетании со скриптом, который не проверяли заранее: одна "
"необнаруженная несовместимость может заблокировать весь затронутый ею "
"трафик. Запустите 'Проверить совместимость' (см. предыдущий вопрос) перед "
"включением fail-closed в рабочей среде - явное предупреждение показывается "
"именно при сочетании этих двух условий. В случае сомнений верните `on_error`"
" в 'ignore' (по умолчанию): если magnet даёт сбой, трафик продолжает "
"обрабатываться одним встроенным WAF."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:415
msgid ""
"Les logs/la blocklist de mon script magnet importe n'apparaissent jamais sur"
" le disque - pourquoi ?"
msgstr ""
"Журналы/blocklist моего импортированного скрипта magnet никогда не "
"появляются на диске - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:417
msgid ""
"Un script `mod_magnet` écrit typiquement ses logs/sa blocklist à des chemins"
" ABSOLUS en dur (ex. `/etc/blocklist.txt`, `/var/log/...`) propres à son "
"site d'origine - ces chemins n'ont aucune raison d'exister sur cette "
"machine. La dissociation se fait via `options.waf.magnet.paths` (écran "
"Magnet), injectés dans le script comme table Lua globale "
"`omega_magnet_paths` : seule une COPIE adaptée du script (les 5 lignes de "
"configuration modifiées pour lire cette table, avec repli sur le chemin en "
"dur d'origine si absente) en bénéficie - le script importe lui-même doit "
"être adapté une fois, manuellement (méthode générique, mais noms de chemins "
"propres à chaque script). `secure/waf/scripts/waf.lua` (chemin par défaut de"
" `options.waf.magnet.script`) est livre comme exemple minimal montrant cette"
" technique - un vrai script importe (qui porte forcément la logique propre à"
" SON site d'origine, jamais généralisable à l'avance) n'a jamais vocation à "
"être redistribué tel quel à d'autres installations."
msgstr ""
"Скрипт `mod_magnet` обычно пишет свои журналы/blocklist по жёстко заданным "
"АБСОЛЮТНЫМ путям (напр. `/etc/blocklist.txt`, `/var/log/...`), характерным "
"для исходного сайта - эти пути вовсе не обязаны существовать на этой машине."
" Развязка выполняется через `options.waf.magnet.paths` (экран Magnet), "
"которые внедряются в скрипт как глобальная таблица Lua `omega_magnet_paths`:"
" этим пользуется только адаптированная КОПИЯ скрипта (5 строк настроек "
"изменены для чтения этой таблицы, с откатом на исходный жёсткий путь при её "
"отсутствии) - сам импортируемый скрипт нужно адаптировать один раз вручную "
"(метод общий, но имена путей свои для каждого скрипта). "
"`secure/waf/scripts/waf.lua` (путь по умолчанию для "
"`options.waf.magnet.script`) поставляется как минимальный пример этой "
"техники - настоящий импортируемый скрипт (который обязательно несёт логику "
"СВОЕГО исходного сайта, заранее не обобщаемую) никогда не предназначен для "
"распространения как есть на другие установки."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:433
msgid ""
"Mon script magnet écrit une page HTML personnalisée (lighty.content) en cas "
"de blocage - pourquoi je ne la vois jamais ?"
msgstr ""
"Мой скрипт magnet при блокировке пишет собственную HTML-страницу "
"(lighty.content) - почему я её никогда не вижу?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:435
msgid ""
"Choix délibéré, cohérent avec le reste du projet : le moteur WAF (natif ou "
"magnet) rend TOUJOURS une décision, jamais une page HTML - c'est le serveur "
"qui rend systématiquement sa propre page d'erreur générique. Les écritures "
"`lighty.header`/`lighty.content` d'un script importe sont acceptées (le "
"script ne plante jamais pour les avoir faites) mais jamais relues ni "
"renvoyées au visiteur."
msgstr ""
"Намеренный выбор, согласованный с остальным проектом: движок WAF (встроенный"
" или magnet) ВСЕГДА возвращает решение, а не HTML-страницу - сервер всегда "
"сам показывает свою общую страницу ошибки. Записи "
"`lighty.header`/`lighty.content` импортированного скрипта принимаются "
"(скрипт никогда не падает из-за них), но никогда не перечитываются и не "
"отправляются посетителю."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:444
msgid ""
"Les boutons de log 'waf magnet (alertes/blocklist)' restent grises dans "
"l'écran Voir/Suivre - pourquoi ?"
msgstr ""
"Кнопки журналов 'waf magnet (оповещения/blocklist)' остаются серыми на "
"экране Просмотр/Отслеживание - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:446
msgid ""
"Ces deux logs sont proposes d'office (même si le magnet n'est jamais "
"configuré), mais restent désactivés tant que `options.waf.magnet.enabled` "
"n'est pas réellement actif - évite un clic qui ne mènerait qu'à un message "
"d'erreur. Une fois actif, un clic fonctionne même si le fichier n'existe pas"
" encore (log vide, jamais une erreur - aucune alerte déclenchée pour "
"l'instant). Côté `lnav` (logs fusionnés), ces mêmes logs sont déjà cochables"
" sans cette restriction : un log absent y est simplement ignore au "
"lancement, sans bloquer les autres."
msgstr ""
"Эти два журнала предлагаются всегда (даже если magnet ни разу не "
"настраивали), но остаются неактивными, пока `options.waf.magnet.enabled` не "
"включён на самом деле - это избавляет от щелчка, ведущего лишь к сообщению "
"об ошибке. После включения щелчок работает, даже если файла ещё нет (пустой "
"журнал, никогда не ошибка - пока не было ни одного оповещения). В `lnav` "
"(объединённые журналы) эти же журналы можно отметить и без такого "
"ограничения: отсутствующий журнал просто игнорируется при запуске, не мешая "
"остальным."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:456
#: src/omega_serv/interfaces/tui/guide/content/faq.py:470
#: src/omega_serv/interfaces/tui/guide/content/faq.py:483
#: src/omega_serv/interfaces/tui/guide/content/faq.py:498
msgid "Sécurité - CSP et en-têtes"
msgstr "Безопасность - CSP и заголовки"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:457
msgid ""
"J'ai ajouté une zone CSP pour un dossier, et maintenant ce dossier semble "
"avoir perdu d'autres protections - pourquoi ?"
msgstr ""
"Я добавил зону CSP для каталога, и теперь этот каталог, похоже, потерял "
"другие защиты - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:459
msgid ""
"Une zone CSP REMPLACE ENTIÈREMENT la politique par défaut pour son préfixe -"
" jamais une fusion/un simple ajout. Une zone qui ne contient que `style-src "
"'self' 'unsafe-inline'` par exemple fait disparaître toutes les AUTRES "
"directives (`object-src`, `frame-ancestors`...) sous ce préfixe, qui "
"retombent alors sur le comportement par défaut du navigateur plutôt que sur "
"la politique globale stricte. L'assistant d'ajout de zone (écran Sécurité "
"générique -> Ajouter une zone) existe exactement pour éviter ce piège : "
"chaque directive y est pré-remplie avec sa valeur ACTUELLE (la politique "
"globale), à modifier uniquement là où c'est nécessaire."
msgstr ""
"Зона CSP ПОЛНОСТЬЮ ЗАМЕНЯЕТ политику по умолчанию для своего префикса - "
"никогда не объединение и не простое дополнение. Например, зона, содержащая "
"только `style-src 'self' 'unsafe-inline'`, убирает все ОСТАЛЬНЫЕ директивы "
"(`object-src`, `frame-ancestors`...) под этим префиксом, и для них действует"
" поведение браузера по умолчанию вместо строгой глобальной политики. Мастер "
"добавления зоны (экран Общая безопасность -> Добавить зону) существует "
"именно для того, чтобы избежать этой ловушки: каждая директива заполнена "
"своим ТЕКУЩИМ значением (глобальная политика), менять нужно только то, что "
"необходимо."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:471
msgid ""
"Comment autoriser 'unsafe-inline' (ou une source moins stricte) uniquement "
"pour un dossier précis, sans affaiblir le reste du site ?"
msgstr ""
"Как разрешить 'unsafe-inline' (или менее строгий источник) только для "
"конкретного каталога, не ослабляя остальной сайт?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:473
msgid ""
"Zones CSP (`security.csp_zones`, écran Sécurité générique) : une exception "
"EXPLICITE par préfixe de chemin, jamais une relâche globale. L'assistant "
"d'ajout détecte toute directive relâchée ('unsafe-inline'/'unsafe-"
"eval'/source générique '*') et exige une confirmation explicite "
"supplémentaire avant d'enregistrer. Cette zone reste ensuite TOUJOURS "
"visible dans `omega-serv audit security` (règles CSP-001/CSP-002, qui "
"scannent aussi les zones, pas seulement la politique globale) - même "
"délibérée, jamais silencieuse."
msgstr ""
"Зоны CSP (`security.csp_zones`, экран Общая безопасность): ЯВНОЕ исключение "
"по префиксу пути, никогда не глобальное послабление. Мастер добавления "
"обнаруживает любую ослабленную директиву ('unsafe-inline'/'unsafe-"
"eval'/общий источник '*') и требует дополнительного явного подтверждения "
"перед сохранением. Затем эта зона ВСЕГДА остаётся видимой в `omega-serv "
"audit security` (правила CSP-001/CSP-002, которые проверяют и зоны, а не "
"только глобальную политику) - даже намеренная, никогда не скрыта."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:484
msgid ""
"Pourquoi Cross-Origin-Embedder-Policy reste à 'unsafe-none' même en profil "
"hardened ?"
msgstr ""
"Почему Cross-Origin-Embedder-Policy остаётся 'unsafe-none' даже в профиле "
"hardened?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:486
msgid ""
"Choix délibéré, différent de `Cross-Origin-Opener-Policy`/`Cross-Origin-"
"Resource-Policy` (toujours `same-origin`, sans risque réel de casser un "
"site) : une valeur stricte (`require-corp`/`credentialless`) peut bloquer "
"des ressources cross-origin (polices, images, iframes tiers) propres au "
"contenu RÉELLEMENT servi, qu'un serveur générique ne connaît jamais à "
"l'avance - jamais un défaut imposé sans connaissance de ce contenu. Le "
"header reste néanmoins toujours ÉMIS explicitement, même à cette valeur "
"permissive (jamais absent de la réponse - un scanner externe distingue ainsi"
" 'non considéré' de 'permissif par choix'). Réglable via "
"`security.coep_mode` (écran Sécurité générique) si vous connaissez le "
"contenu servi et voulez l'isolation complète."
msgstr ""
"Намеренный выбор, в отличие от `Cross-Origin-Opener-Policy`/`Cross-Origin-"
"Resource-Policy` (всегда `same-origin`, без реального риска сломать сайт): "
"строгое значение (`require-corp`/`credentialless`) может блокировать cross-"
"origin ресурсы (шрифты, изображения, сторонние iframe), присущие РЕАЛЬНО "
"отдаваемому содержимому, о котором универсальный сервер заранее никогда не "
"знает, - никогда не навязываемое значение по умолчанию без знания этого "
"содержимого. Тем не менее заголовок всегда ОТПРАВЛЯЕТСЯ явно, даже с этим "
"разрешительным значением (никогда не отсутствует в ответе - так внешний "
"сканер отличает 'не рассматривалось' от 'разрешительно по выбору'). "
"Настраивается через `security.coep_mode` (экран Общая безопасность), если вы"
" знаете отдаваемое содержимое и хотите полной изоляции."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:499
msgid ""
"Le listing de répertoire (directory listing) perd tout son style visuel "
"depuis que j'ai une CSP stricte - pourquoi ?"
msgstr ""
"Листинг каталогов (directory listing) теряет всё оформление с тех пор, как у"
" меня строгая CSP - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:501
msgid ""
"Corrigé (2026-10-10) : le CSS du listing est désormais servi en fichier "
"EXTERNE réservé plutôt qu'inline dans le HTML - `style-src 'self'` "
"(politique par défaut) autorise déjà une feuille de style de même origine, "
"sans besoin d'aucune exception. Si ce problème persiste après mise à jour, "
"voir la question sur le redémarrage après mise à jour du code (catégorie "
"Redémarrage et rechargement) : un simple rechargement (SIGHUP) ne suffit "
"jamais à appliquer un changement de CODE, seul un redémarrage complet du "
"service le fait."
msgstr ""
"Исправлено (2026-10-10): CSS листинга теперь отдаётся как зарезервированный "
"ВНЕШНИЙ файл, а не встраивается в HTML - `style-src 'self'` (политика по "
"умолчанию) уже разрешает таблицу стилей из того же источника, без каких-либо"
" исключений. Если проблема сохраняется после обновления, см. вопрос о "
"перезапуске после обновления кода (категория Перезапуск и перезагрузка): "
"простой перезагрузки (SIGHUP) никогда не достаточно, чтобы применить "
"изменение КОДА, это делает только полный перезапуск службы."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:511
#: src/omega_serv/interfaces/tui/guide/content/faq.py:531
#: src/omega_serv/interfaces/tui/guide/content/faq.py:548
#: src/omega_serv/interfaces/tui/guide/content/faq.py:566
msgid "TLS et certificats"
msgstr "TLS и сертификаты"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:512
msgid ""
"J'ai regenere/revoque le certificat TLS mais le serveur sert toujours "
"l'ancien - pourquoi ?"
msgstr ""
"Я перевыпустил/отозвал сертификат TLS, но сервер по-прежнему отдаёт старый -"
" почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:514
msgid ""
"Le contexte SSL n'est construit qu'UNE SEULE FOIS au démarrage du serveur, "
"jamais retouché par un simple rechargement. Régénérer ou révoquer un "
"certificat pendant que TLS est déjà actif nécessite TOUJOURS un redémarrage "
"complet pour que le changement soit réellement pris en compte, même si le "
"fichier sur disque a déjà changé."
msgstr ""
"Контекст SSL создаётся только ОДИН РАЗ при запуске сервера и никогда не "
"затрагивается простой перезагрузкой. Перевыпуск или отзыв сертификата при "
"уже включённом TLS ВСЕГДА требует полного перезапуска, чтобы изменение "
"действительно вступило в силу, даже если файл на диске уже изменился."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:521
msgid "Sauvegarde et restauration"
msgstr "Резервное копирование и восстановление"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:522
msgid "Mes sauvegardes de configuration sont-elles chiffrées ?"
msgstr "Шифруются ли мои резервные копии конфигурации?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:524
msgid ""
"Non, jamais par défaut. Si vous incluez les zones d'authentification (hash "
"de mots de passe) ou les certificats (clés privées TLS), la sauvegarde "
"contient des secrets réels en clair - une confirmation explicite "
"supplémentaire est demandée avant de créer ce type de sauvegarde. Protégez "
"ces fichiers comme n'importe quel secret."
msgstr ""
"Нет, по умолчанию никогда. Если вы включаете зоны аутентификации (хеши "
"паролей) или сертификаты (закрытые ключи TLS), копия содержит настоящие "
"секреты в открытом виде - перед созданием такой копии запрашивается "
"дополнительное явное подтверждение. Защищайте эти файлы как любые секреты."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:532
msgid ""
"Comment m'auto-héberger avec un vrai certificat public, de bout en bout "
"(schéma DDNS -> Certbot -> OMEGA-SERV) ?"
msgstr ""
"Как разместить сайт у себя с настоящим публичным сертификатом, от начала до "
"конца (схема DDNS -> Certbot -> OMEGA-SERV)?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:534
msgid ""
"Le schéma complet : un service DDNS (Dynu ou équivalent) fait pointer un nom"
" de domaine public (ex. monserveur.dynu.com) vers votre IP, mise à jour "
"automatiquement par leur client à chaque changement - ENTIÈREMENT hors du "
"périmètre d'OMEGA-SERV, à installer et configurer vous-même. Vous devez "
"aussi rediriger les ports 80 et 443 de votre routeur/pare-feu vers cette "
"machine. Une fois cela fait : Assistant Let's Encrypt (Configuration "
"détaillée -> TLS) obtient le premier certificat (défi HTTP-01, webroot - "
"port 80 doit être joignable depuis Internet le temps de la demande), "
"l'importe et vous rappelle d'activer TLS (écran Activer/desactiver TLS) puis"
" de redémarrer. Ensuite, Renouvellement automatique (même sous-menu) "
"installe la planification (timer systemd ou crontab) qui renouvelle et "
"redémarre tout seul, sans plus jamais intervenir manuellement pour cette "
"partie."
msgstr ""
"Полная схема: служба DDNS (Dynu или аналог) направляет публичное доменное "
"имя (напр. myserver.dynu.com) на ваш IP и автоматически обновляет его своим "
"клиентом при каждом изменении - это ПОЛНОСТЬЮ вне области OMEGA-SERV, "
"устанавливается и настраивается вами. Также нужно перенаправить порты 80 и "
"443 вашего маршрутизатора/межсетевого экрана на эту машину. После этого: "
"Мастер Let's Encrypt (Подробная настройка -> TLS) получает первый сертификат"
" (проверка HTTP-01, webroot - порт 80 должен быть доступен из Интернета на "
"время запроса), импортирует его и напоминает включить TLS (экран "
"Включить/отключить TLS), а затем перезапустить. Далее Автоматическое "
"продление (то же подменю) устанавливает планирование (таймер systemd или "
"crontab), которое продлевает и перезапускает само, без какого-либо ручного "
"вмешательства в этой части."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:549
msgid ""
"OMEGA-SERV tourne dans un conteneur - comment obtenir un certificat Let's "
"Encrypt ?"
msgstr ""
"OMEGA-SERV работает в контейнере - как получить сертификат Let's Encrypt?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:551
msgid ""
"N'exécutez PAS l'Assistant Let's Encrypt/le renouvellement automatique à "
"l'intérieur du conteneur qui sert déjà le trafic public. Exécutez-les sur "
"l'hôte (ou dans un conteneur/sidecar distinct dédié à l'administration) en "
"partageant avec le conteneur serveur : le même volume de webroot (Certbot y "
"dépose son défi, ce que le conteneur sert déjà via le port 80 qu'il expose),"
" et le même volume secure/certificates/ - le conteneur serveur peut monter "
"ce dernier en LECTURE SEULE, puisque l'import du certificat (écriture) se "
"fait toujours côté hote/sidecar, jamais depuis le conteneur servant le "
"trafic. Un redémarrage du conteneur serveur reste nécessaire après chaque "
"renouvellement (même règle que partout ailleurs : le contexte SSL n'est "
"jamais rechargé à chaud) - le hook de renouvellement redémarre le SERVICE "
"qu'il connaît (hote/sidecar), pensez à l'adapter si le conteneur serveur est"
" pilote séparément (ex. `docker restart`) plutôt que par un service "
"systemd/OpenRC/runit classique."
msgstr ""
"НЕ запускайте Мастер Let's Encrypt/автоматическое продление внутри "
"контейнера, который уже обслуживает публичный трафик. Запускайте их на хосте"
" (или в отдельном контейнере/sidecar для администрирования), разделяя с "
"контейнером-сервером: тот же том webroot (Certbot кладёт туда свою проверку,"
" которую контейнер уже отдаёт через открытый им порт 80) и тот же том "
"secure/certificates/ - контейнер-сервер может монтировать последний ТОЛЬКО "
"ДЛЯ ЧТЕНИЯ, поскольку импорт сертификата (запись) всегда выполняется на "
"стороне хоста/sidecar, а не из контейнера, обслуживающего трафик. После "
"каждого продления всё равно нужен перезапуск контейнера-сервера (то же "
"правило, что и везде: контекст SSL никогда не перезагружается на лету) - "
"hook продления перезапускает известную ему СЛУЖБУ (хост/sidecar), не "
"забудьте адаптировать его, если контейнер-сервер управляется отдельно (напр."
" `docker restart`), а не обычной службой systemd/OpenRC/runit."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:567
msgid "L'Assistant Let's Encrypt échoue (défi HTTP-01) - pourquoi ?"
msgstr "Мастер Let's Encrypt завершается ошибкой (проверка HTTP-01) - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:569
msgid ""
"Les causes les plus fréquentes, dans l'ordre à vérifier : (1) le port 80 "
"n'est pas réellement joignable depuis Internet (redirection de port "
"manquante ou incorrecte sur le routeur/pare-feu, ou un autre service occupe "
"déjà ce port sur la machine), (2) le domaine ne pointe pas encore vers cette"
" IP (DNS/DDNS pas encore propagé - vérifiez avec `dig`/`nslookup` depuis une"
" machine externe), (3) en mode test (staging, coché par défaut) tout "
"fonctionne mais le certificat obtenu n'est jamais reconnu par les "
"navigateurs - c'est normal, décochez la case une fois le domaine et le "
"webroot vérifiés. Le message d'erreur affiché est directement celui renvoyé "
"par Certbot - il précise généralement laquelle de ces causes s'applique."
msgstr ""
"Самые частые причины в порядке проверки: (1) порт 80 на самом деле "
"недоступен из Интернета (перенаправление порта на маршрутизаторе/межсетевом "
"экране отсутствует или неверно, либо этот порт на машине уже занят другой "
"службой), (2) домен ещё не указывает на этот IP (DNS/DDNS ещё не "
"распространился - проверьте `dig`/`nslookup` с внешней машины), (3) в "
"тестовом режиме (staging, отмечен по умолчанию) всё работает, но полученный "
"сертификат никогда не признаётся браузерами - это нормально, снимите флажок,"
" когда домен и webroot проверены. Показанное сообщение об ошибке - это "
"непосредственно ответ Certbot, обычно в нём указано, какая из этих причин "
"имеет место."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:582
msgid "Comment bannir une adresse IP à la main, sans écrire de règle ?"
msgstr "Как забанить IP-адрес вручную, не создавая правило?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:585
msgid ""
"Active Sécurité -> INTERVENTION MANUELLE -> Bannir : une adresse, un motif, "
"une durée. Le ban est immédiat (page 451 sur tout le site, avant les "
"backends), sans droits root et sans lien avec la récidive RIPOSTE ; il se "
"lève dans Débannir. Statut des bans liste tous les bans avec leur origine et"
" les exporte (JSON, HTML, ou TXT importable tel quel dans omega-fire). Pour "
"un réseau, passez par WAF -> Modules -> Liste de blocage."
msgstr ""
"Активная безопасность -> РУЧНОЕ ВМЕШАТЕЛЬСТВО -> Забанить: адрес, причина, "
"длительность. Бан действует сразу (страница 451 на всём сайте, до бэкендов),"
" без прав root и без связи с повторными нарушениями RIPOSTE; снимается в "
"разделе «Разбанить». «Статус банов» показывает все баны с их источником и "
"экспортирует их (JSON, HTML или TXT, импортируемый как есть в omega-fire). "
"Для сети: WAF -> Модули -> Список блокировки."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:594
#: src/omega_serv/interfaces/tui/guide/content/faq.py:606
#: src/omega_serv/interfaces/tui/guide/content/faq.py:617
#: src/omega_serv/interfaces/tui/guide/content/faq.py:628
#: src/omega_serv/interfaces/tui/guide/content/faq.py:643
#: src/omega_serv/interfaces/tui/guide/content/faq.py:655
#: src/omega_serv/interfaces/tui/guide/content/faq.py:667
#: src/omega_serv/interfaces/tui/guide/content/faq.py:679
#: src/omega_serv/interfaces/tui/guide/content/faq.py:691
#: src/omega_serv/interfaces/tui/guide/content/faq.py:702
#: src/omega_serv/interfaces/tui/guide/content/faq.py:713
#: src/omega_serv/interfaces/tui/guide/content/faq.py:726
#: src/omega_serv/interfaces/tui/screens/active_defense_menu_screen.py:134
msgid "RIPOSTE"
msgstr "RIPOSTE"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:595
msgid "Quelle différence entre Active Defense et RIPOSTE ?"
msgstr "Чем Active Defense отличается от RIPOSTE?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:597
msgid ""
"Active Defense agit PENDANT la requête : il note chaque source selon ce "
"qu'elle fait maintenant (score, niveaux normal / suspicious / hostile / "
"contained) et réagit tout de suite (leurre, ralentissement, incident). "
"RIPOSTE agit DANS LA DURÉE : il se souvient des sources qui reviennent après"
" un silence (épisodes) et leur applique des bans de plus en plus longs "
"(paliers, par défaut 1 h, 6 h, 24 h, 7 j), avec une échéance, une levée "
"possible et une mémoire de récidive. RIPOSTE ne modifie jamais le score ni "
"les seuils d'Active Defense ; il peut seulement exiger un niveau Active "
"Defense minimal dans une politique."
msgstr ""
"Active Defense действует ВО ВРЕМЯ запроса: оценивает каждый источник по "
"тому, что он делает сейчас (оценка, уровни normal / suspicious / hostile / "
"contained), и реагирует сразу (ловушка, замедление, инцидент). RIPOSTE "
"действует ВО ВРЕМЕНИ: запоминает источники, возвращающиеся после затишья "
"(эпизоды), и применяет к ним всё более долгие баны (ступени, по умолчанию 1 "
"ч, 6 ч, 24 ч, 7 дн) со сроком, возможностью снятия и памятью рецидивов. "
"RIPOSTE никогда не меняет оценку и пороги Active Defense; он может лишь "
"потребовать в политике минимальный уровень Active Defense."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:607
msgid "Pourquoi RIPOSTE a-t-il banni cette adresse ?"
msgstr "Почему RIPOSTE забанил этот адрес?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:609
msgid ""
"Écran Actions : le détail de l'action donne la politique, le palier, "
"l'événement d'origine et l'échéance. Écran Simuler, « Décisions récentes » :"
" chaque décision est expliquée ligne par ligne (politique retenue, nombre de"
" retours, exclusions vérifiées). En ligne de commande : « riposte actions "
"show <id> » et « riposte decisions list --ip <adresse> --explain ». Faux "
"positif : « Lever » avec « ne pas compter ce ban dans la récidive », et au "
"besoin « Lever et exempter cette source »."
msgstr ""
"Экран Действия: в подробностях действия указаны политика, ступень, исходное "
"событие и срок. Экран Симуляция, « Последние решения »: каждое решение "
"объяснено построчно (выбранная политика, число возвращений, проверенные "
"исключения). В командной строке: « riposte actions show <id> » и « riposte "
"decisions list --ip <адрес> --explain ». Ложное срабатывание: « Снять » с « "
"не учитывать этот бан в рецидиве », при необходимости « Снять и исключить "
"этот источник »."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:618
msgid "J'ai levé un ban RIPOSTE mais l'adresse reste bloquée - pourquoi ?"
msgstr "Я снял бан RIPOSTE, но адрес по-прежнему заблокирован - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:620
msgid ""
"Une politique « ban local + ban réseau » passe aussi le ban à fail2ban, par "
"les jails omega-jail <service>-riposte-1h/6h/24h/7d. omega-serv n'a pas les "
"droits de lever un ban fail2ban : « Lever » ne retire que le ban local "
"(blocklist du WAF). Levez le ban réseau dans omega-fire ou avec fail2ban-"
"client (la jail est indiquée dans le détail de l'action). Vérifiez aussi "
"qu'un ban du WAF ou un ban manuel ne couvre pas la même adresse : RIPOSTE "
"n'y touche jamais."
msgstr ""
"Политика « локальный бан + сетевой бан » передаёт бан и fail2ban через jail "
"omega-jail <service>-riposte-1h/6h/24h/7d. У omega-serv нет прав снимать бан"
" fail2ban: « Снять » убирает только локальный бан (blocklist WAF). Снимите "
"сетевой бан в omega-fire или через fail2ban-client (jail указан в "
"подробностях действия). Проверьте также, не покрывает ли тот же адрес бан "
"WAF или ручной бан: RIPOSTE их никогда не трогает."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:629
msgid ""
"Les scénarios « Explorateur de leurres » et « Sonde upload / API » sont "
"refusés (profil de leurre inconnu) - que faire ?"
msgstr ""
"Сценарии «Исследователь ловушек» и «Зонд загрузки / API» отклоняются "
"(неизвестный профиль ловушки) - что делать?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:631
msgid ""
"Ces deux scénarios ne bannissent pas : ils envoient la source vers un leurre"
" d'Active Defense, qui doit donc exister AVANT de charger le scénario - « "
"Explorateur de leurres » utilise le profil fake_admin, « Sonde upload / API "
"» le profil fake_api. (1) L'option active_defense doit être activée (menu "
"Options). (2) Dans Active Sécurité -> Réglages (bloc Active Defense) : « "
"Deception active » = oui, puis Enregistrer. (3) Toujours dans Réglages, « "
"Ajouter un profil » : Nom fake_admin (ou fake_api), Actif oui, Classes "
"d'attaque scan,credential_stuffing pour fake_admin ou api_probe,upload_probe"
" pour fake_api, Isolation fixture, Zone de leurre vide. (4) Revenez dans "
"RIPOSTE -> Politiques -> Ajouter -> Scénario prêt à charger : le scénario "
"est accepté. Les leurres ne fonctionnent qu'après un redémarrage complet. "
"Les trois autres scénarios bannissent et n'ont besoin d'aucun leurre."
msgstr ""
"Эти два сценария не банят: они направляют источник в ловушку Active Defense,"
" которая поэтому должна существовать ДО загрузки сценария - «Исследователь "
"ловушек» использует профиль fake_admin, «Зонд загрузки / API» - профиль "
"fake_api. (1) Опция active_defense должна быть включена (меню «Параметры»). "
"(2) В «Активная безопасность» -> «Настройки» (блок Active Defense): "
"«Deception включено» = да, затем «Сохранить». (3) Там же, в «Настройках», "
"«Добавить профиль»: имя fake_admin (или fake_api), «Включён» да, классы атак"
" scan,credential_stuffing для fake_admin или api_probe,upload_probe для "
"fake_api, Isolation fixture, зона приманок пустая. (4) Вернитесь в RIPOSTE "
"-> «Политики» -> «Добавить» -> «Готовый сценарий»: сценарий принимается. "
"Ловушки работают только после полного перезапуска. Остальные три сценария "
"банят и не нуждаются в ловушке."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:644
msgid "RIPOSTE ne fait rien - pourquoi ?"
msgstr "RIPOSTE ничего не делает - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:646
msgid ""
"Dans l'ordre : (1) le module 'riposte' doit être activé dans Options, puis "
"le service REDÉMARRÉ complètement ; (2) le WAF doit être actif, sinon "
"RIPOSTE ne voit aucune attaque ; (3) au moins une politique doit être active"
" (« Enregistrer sans activer » la laisse en observation) ; (4) l'arrêt "
"d'urgence ne doit pas être actif (écran État : le bouton affiche « Reprendre"
" ») ; (5) la condition doit être atteinte : par exemple 3 épisodes en 7 "
"jours, un épisode étant séparé du précédent par au moins 1 h de silence. "
"Simuler avec la même situation montre la condition qui manque."
msgstr ""
"По порядку: (1) модуль 'riposte' должен быть включён в Опциях, а служба "
"затем ПОЛНОСТЬЮ перезапущена; (2) WAF должен быть активен, иначе RIPOSTE не "
"видит ни одной атаки; (3) хотя бы одна политика должна быть активна (« "
"Сохранить без включения » оставляет её в наблюдении); (4) аварийная "
"остановка не должна быть активна (экран Состояние: кнопка показывает « "
"Возобновить »); (5) условие должно быть достигнуто: например, 3 эпизода за 7"
" дней, каждый отделён от предыдущего затишьем не менее 1 ч. Симуляция той же"
" ситуации покажет недостающее условие."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:656
msgid ""
"Une adresse bannie reçoit une page 451 : est-ce omega-serv ou fail2ban ?"
msgstr ""
"Заблокированный адрес получает страницу 451: это omega-serv или fail2ban?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:658
msgid ""
"C'est omega-serv. Une adresse présente dans la liste de blocage du WAF "
"(auto-ban du WAF, ban manuel ou ban local RIPOSTE) reçoit la page 451 « "
"Votre IP a été bannie » sur toutes ses requêtes, pendant toute la durée du "
"ban. Un 403 refuse seulement une requête (une règle touchée), sans bannir. "
"Un ban fail2ban agit sur le pare-feu : il ne renvoie jamais de page, la "
"connexion est coupée ou n'aboutit pas. Pour savoir qui a banni, regardez la "
"source du ban dans la liste de blocage (« auto » = auto-ban du WAF, « "
"riposte », « manual ») : WAF → Modules → Liste de blocage, ou « blocklist "
"list »."
msgstr ""
"Это omega-serv. Адрес из списка блокировки WAF (автобан WAF, ручной бан или "
"локальный бан RIPOSTE) получает страницу 451 «Ваш IP заблокирован» на все "
"свои запросы в течение всего бана. Код 403 лишь отклоняет один запрос "
"(сработало правило), не блокируя адрес. Бан fail2ban действует в межсетевом "
"экране: он никогда не возвращает страницу, соединение обрывается или не "
"устанавливается. Кто заблокировал, видно по источнику бана в списке "
"блокировки (« auto » = автобан WAF, « riposte », « manual »): WAF → Модули →"
" Список блокировки или « blocklist list »."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:668
msgid "À quoi servent les jails omega-serv-riposte-1h, -6h, -24h et -7d ?"
msgstr "Зачем нужны jail'ы omega-serv-riposte-1h, -6h, -24h и -7d?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:670
msgid ""
"Ce sont les jails fail2ban du ban réseau de RIPOSTE, installés par omega-"
"jail (1.1.0 ou plus). Quand une politique « ban local + ban réseau » bannit,"
" omega-serv pose d'abord le ban local, puis écrit une ligne dans « "
"var/log/riposte-decisions.jsonl » ; fail2ban la lit et bannit l'adresse au "
"pare-feu. Les jails ont une durée fixe : chaque palier RIPOSTE va à la plus "
"longue qui ne le dépasse pas (un palier de 2 h va dans la jail de 1 h), et "
"l'interface l'indique. Chaque instance omega-serv a son propre jeu de jails,"
" préfixé par le nom de son service."
msgstr ""
"Это jail'ы fail2ban для сетевого бана RIPOSTE, устанавливаемые omega-jail "
"(1.1.0 или новее). Когда политика «локальный бан + сетевой бан» блокирует "
"адрес, omega-serv сначала ставит локальный бан, затем пишет строку в « "
"var/log/riposte-decisions.jsonl »; fail2ban читает её и блокирует адрес в "
"межсетевом экране. У jail'ов фиксированная длительность: каждая ступень "
"RIPOSTE уходит в самый длинный jail, не превышающий её (ступень 2 ч уходит в"
" jail на 1 ч), и интерфейс это показывает. У каждого экземпляра omega-serv "
"свой набор jail'ов с именем его службы в качестве префикса."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:680
msgid ""
"J'ai mis à jour omega-jail, mais les jails RIPOSTE n'apparaissent ni dans "
"fail2ban ni dans omega-fire"
msgstr ""
"Я обновил omega-jail, но jail'ы RIPOSTE не появляются ни в fail2ban, ни в "
"omega-fire"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:682
msgid ""
"Mettre à jour omega-jail ne suffit pas à installer ses nouveaux jails. "
"Extrayez l'archive par-dessus le dossier existant, puis lancez « "
"./install.sh » : il liste les jails du catalogue pas encore installés et "
"propose de les installer (« sudo »). À défaut : « sudo ./omega-jail.sh "
"--apply ». Les jails RIPOSTE ne sont proposés que si le module RIPOSTE est "
"activé dans omega-serv (sinon « source non configurée »). Vérification : « "
"sudo fail2ban-client status ». omega-fire les affiche dès qu'ils sont "
"installés, sans rien à déclarer."
msgstr ""
"Одного обновления omega-jail недостаточно, чтобы установить новые jail'ы. "
"Распакуйте архив поверх существующей папки и запустите « ./install.sh »: он "
"выведет ещё не установленные jail'ы каталога и предложит их установить (« "
"sudo »). Иначе: « sudo ./omega-jail.sh --apply ». Jail'ы RIPOSTE "
"предлагаются, только если модуль RIPOSTE включён в omega-serv (иначе "
"«источник не настроен»). Проверка: « sudo fail2ban-client status ». omega-"
"fire показывает их сразу после установки, ничего объявлять не нужно."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:692
msgid ""
"Derrière Tailscale Funnel ou un proxy local, le ban réseau sert-il à quelque"
" chose ?"
msgstr ""
"За Tailscale Funnel или локальным прокси есть ли смысл в сетевом бане?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:694
msgid ""
"Pas le ban fail2ban seul : les connexions arrivent alors du proxy local "
"(tailscaled, 127.0.0.1), pas du visiteur, et le ban pare-feu ne le touche "
"pas. omega-jail (1.1.0 ou plus) le détecte et relaie alors chaque ban "
"fail2ban d'une adresse publique dans la liste de blocage d'omega-serv : "
"l'adresse reçoit la page 451, comme avec le script Magnet. Les jails RIPOSTE"
" ne sont pas relayés : RIPOSTE a déjà posé son ban local (451). Quand les "
"visiteurs se connectent directement au serveur, le ban pare-feu agit seul."
msgstr ""
"Не один бан fail2ban: соединения тогда приходят от локального прокси "
"(tailscaled, 127.0.0.1), а не от посетителя, и бан в межсетевом экране его "
"не затрагивает. omega-jail (1.1.0 или новее) это обнаруживает и передаёт "
"тогда каждый бан fail2ban публичного адреса в список блокировки omega-serv: "
"адрес получает страницу 451, как со скриптом Magnet. Jail'ы RIPOSTE не "
"передаются: RIPOSTE уже поставил свой локальный бан (451). Когда посетители "
"подключаются к серверу напрямую, бан в межсетевом экране действует сам."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:703
msgid ""
"La jail omega-serv-active-defense fait-elle double emploi avec RIPOSTE ?"
msgstr "Дублирует ли jail omega-serv-active-defense работу RIPOSTE?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:705
msgid ""
"En partie. Cette jail d'omega-jail bannit au pare-feu pendant 24 h fixes "
"toute adresse classée hostile ou contained par Active Defense, sans tenir "
"compte des paliers RIPOSTE : une adresse peut donc être bannie au niveau "
"réseau plus tôt ou plus longtemps que le palier choisi. L'écran État de "
"RIPOSTE la signale. Gardez-la si vous voulez ce filet de sécurité ; retirez-"
"la (gestion des jails d'omega-fire) si seuls les paliers RIPOSTE doivent "
"compter."
msgstr ""
"Частично. Этот jail из omega-jail блокирует в межсетевом экране на "
"фиксированные 24 ч любой адрес, отнесённый Active Defense к hostile или "
"contained, без учёта ступеней RIPOSTE: адрес может быть заблокирован на "
"сетевом уровне раньше или дольше выбранной ступени. Экран «Состояние» "
"RIPOSTE на это указывает. Оставьте его, если нужна такая страховка; удалите "
"его (управление jail'ами в omega-fire), если должны учитываться только "
"ступени RIPOSTE."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:714
msgid "Mon attaque de test ne déclenche aucun ban RIPOSTE - pourquoi ?"
msgstr "Моя тестовая атака не вызывает бан RIPOSTE - почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:716
msgid ""
"Dans l'ordre : (1) la requête doit toucher une règle du WAF, ce qui donne un"
" 403 (par exemple « /?id=1 UNION SELECT 1 » ou « /.env ») ; une simple 404 "
"n'est pas une attaque ; (2) l'adresse ne doit pas être exemptée : hôte "
"local, Tailscale et réseau local ne sont jamais bannis, testez depuis une "
"adresse publique (4G) et, derrière un proxy, réglez le proxy de confiance ; "
"(3) la politique doit être remplie : nombre d'épisodes, classes d'attaque et"
" niveau Active Defense minimal (« aucun » pour un test) ; (4) une adresse "
"déjà bannie (page 451, souvent par l'auto-ban du WAF) n'est plus analysée : "
"RIPOSTE ignore les refus de la liste de blocage, levez d'abord ce ban. "
"Simuler la même situation montre ce qui manque."
msgstr ""
"По порядку: (1) запрос должен сработать на правило WAF, что даёт 403 "
"(например, « /?id=1 UNION SELECT 1 » или « /.env »); обычный 404 - не атака;"
" (2) адрес не должен быть исключён: локальный хост, Tailscale и локальная "
"сеть никогда не блокируются, проверяйте с публичного адреса (4G), а за "
"прокси настройте доверенный прокси; (3) условия политики должны выполняться:"
" число эпизодов, классы атак и минимальный уровень Active Defense («нет» для"
" теста); (4) уже заблокированный адрес (страница 451, часто из-за автобана "
"WAF) больше не анализируется: RIPOSTE игнорирует отказы списка блокировки, "
"сначала снимите этот бан. Имитация той же ситуации покажет, чего не хватает."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:727
msgid "Pourquoi omega-fire n'affiche-t-il que les bans fail2ban ?"
msgstr "Почему omega-fire показывает только баны fail2ban?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:729
msgid ""
"omega-fire lit fail2ban et le pare-feu. Les bans d'omega-serv (liste de "
"blocage du WAF, page 451 : auto-ban, ban manuel, ban local RIPOSTE) se "
"consultent pour l'instant dans omega-serv : WAF → Modules → Liste de "
"blocage, écran Actions de RIPOSTE, ou « blocklist list ». Les jails "
"installés par omega-jail, dont ceux de RIPOSTE, apparaissent bien dans "
"omega-fire."
msgstr ""
"omega-fire читает fail2ban и межсетевой экран. Баны omega-serv (список "
"блокировки WAF, страница 451: автобан, ручной бан, локальный бан RIPOSTE) "
"пока просматриваются в omega-serv: WAF → Модули → Список блокировки, экран "
"«Действия» RIPOSTE или « blocklist list ». Jail'ы, установленные omega-jail,"
" в том числе jail'ы RIPOSTE, в omega-fire отображаются."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:736
#: src/omega_serv/interfaces/tui/guide/content/faq.py:759
#: src/omega_serv/interfaces/tui/guide/content/faq.py:777
#: src/omega_serv/interfaces/tui/guide/content/faq.py:789
#: src/omega_serv/interfaces/tui/guide/content/faq.py:799
msgid "Moteur HTTP et performances"
msgstr "HTTP-движок и производительность"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:737
msgid "Moteur Python ou natif : qu'est-ce que ça change concrètement ?"
msgstr "Движок Python или нативный: что это меняет на практике?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:739
msgid ""
"Ce qui ne change pas : les réponses, les journaux, la sécurité et les "
"fonctions disponibles. Ce qui change, c'est qui traite les requêtes HTTP : "
"l'interpréteur Python, ou un programme compilé qui utilise tous les cœurs. "
"Avec le WAF, le moteur natif cherche lui-même les règles : une requête sur "
"laquelle aucune règle ne correspond est servie sans passer par Python ; au "
"moindre doute (correspondance, texte non ASCII, en-têtes ou corps à "
"inspecter, source suivie par Active Defense, zone d'authentification), c'est"
" Python qui décide, exactement comme avec le moteur Python. Si magnet est "
"actif, toutes les requêtes passent par Python ; la limite de débit, elle, "
"est comptée par le moteur natif, sans coût mesurable. Mesuré sur trois "
"machines (comparatif des serveurs web, à lire pour le détail), le moteur "
"natif sert les petites pages 10 à 27 fois plus vite que le moteur Python "
"sans contrôle de sécurité, et 8 à 30 fois plus vite avec le WAF, qui ne lui "
"retire que 5 à 22 % de son débit ; les fichiers de 100 Ko 3,5 à 10 fois plus"
" vite ; les gros fichiers 1,3 à 2,7 fois plus vite. Le temps de réponse des "
"requêtes les plus lentes est divisé par 5 à 15. En échange, il occupe "
"environ 5 Mo de mémoire en plus, et environ 8 Mo de plus avec le WAF (règles"
" chargées dans le natif). Le listing, les pages internes, le reverse proxy, "
"FastCGI, l'envoi de fichiers et WebSocket sont confiés à Python : ces "
"requêtes-là gardent la vitesse du moteur Python. Pour un petit site peu "
"visité, les deux suffisent largement : même le moteur Python avec le WAF "
"sert des dizaines de millions de requêtes par jour sur une machine modeste."
msgstr ""
"Что не меняется: ответы, журналы, безопасность и доступные функции. Меняется"
" то, кто обрабатывает HTTP-запросы: интерпретатор Python или "
"скомпилированная программа, использующая все ядра. С WAF нативный движок сам"
" проверяет правила: запрос, которому не соответствует ни одно правило, "
"обслуживается без участия Python; при малейшем сомнении (совпадение, текст "
"не в ASCII, заголовки или тело для проверки, источник под наблюдением Active"
" Defense, зона аутентификации) решает Python, точно так же, как с движком "
"Python. Если включён magnet, все запросы проходят через Python; ограничение "
"частоты же считает нативный движок, без измеримых затрат. По измерениям на "
"трёх машинах (сравнение веб-серверов, подробности там) нативный движок "
"отдаёт маленькие страницы в 10–27 раз быстрее движка Python без проверок "
"безопасности и в 8–30 раз быстрее с WAF, который отнимает у него лишь 5–22 %"
" пропускной способности; файлы по 100 КБ — в 3,5–10 раз быстрее; большие "
"файлы — в 1,3–2,7 раза быстрее. Время ответа самых медленных запросов "
"сокращается в 5–15 раз. Взамен он занимает примерно на 5 МБ памяти больше, а"
" с WAF — ещё примерно на 8 МБ (правила, загруженные в нативный движок). "
"Листинг каталогов, внутренние страницы, обратный прокси, FastCGI, загрузка "
"файлов и WebSocket передаются Python: эти запросы сохраняют скорость движка "
"Python. Для небольшого сайта с малой посещаемостью обоих более чем "
"достаточно: даже движок Python с WAF обслуживает десятки миллионов запросов "
"в сутки на скромной машине."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:760
msgid "Combien de processus choisir ?"
msgstr "Сколько процессов выбрать?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:762
msgid ""
"Ça dépend du moteur. Moteur Python : chaque processus sert les requêtes ; "
"mesuré, 2 processus servent 1,6 à 2 fois plus que 1, et 4 environ 3,5 fois "
"plus, jusqu'au nombre de cœurs physiques (le maximum proposé). Chaque "
"processus occupe environ 10 à 20 Mo de mémoire de plus. Moteur natif : il "
"utilise déjà tous les cœurs, les processus réglés sont ceux des contrôles de"
" sécurité, qui ne reçoivent que les requêtes à vérifier (correspondance ou "
"doute du WAF, sources suivies par Active Defense, authentification). Pour le"
" trafic ordinaire, un 2e processus n'apporte donc rien : mesuré, le débit "
"reste le même. Il sert quand toutes les requêtes passent par Python (magnet "
"actif) et que la machine a au moins 4 cœurs physiques : 1,5 à 1,7 fois plus "
"de requêtes. Sur 2 cœurs, il n'apporte que 5 à 12 %, le processeur étant "
"déjà occupé : l'écran ne le propose donc qu'à partir de 4 cœurs. Au-delà de "
"2, le gain mesuré est de 4 %. L'écran Résistance et limites affiche le "
"maximum de cette machine et ce qu'augmenter apporte ; le nombre réellement "
"appliqué s'affiche dans État & Ressources."
msgstr ""
"Это зависит от движка. Движок Python: каждый процесс обслуживает запросы; по"
" измерениям 2 процесса обслуживают в 1,6–2 раза больше, чем 1, а 4 — "
"примерно в 3,5 раза больше, вплоть до числа физических ядер (предлагаемый "
"максимум). Каждый процесс занимает примерно на 10–20 МБ памяти больше. "
"Нативный движок: он уже использует все ядра, настраиваемые процессы — это "
"процессы проверок безопасности, которые получают только запросы, требующие "
"проверки (совпадение или сомнение WAF, источники под наблюдением Active "
"Defense, аутентификация). Для обычного трафика 2-й процесс поэтому ничего не"
" даёт: по измерениям пропускная способность не меняется. Он помогает, когда "
"все запросы проходят через Python (включён magnet) и у машины не менее 4 "
"физических ядер: в 1,5–1,7 раза больше запросов. На 2 ядрах он даёт лишь "
"5–12 %, так как процессор уже занят: поэтому экран предлагает его только "
"начиная с 4 ядер. Свыше 2 измеренный выигрыш — 4 %. Экран «Устойчивость и "
"лимиты» показывает максимум этой машины и что даёт увеличение; реально "
"применённое число показано в «Состояние и ресурсы»."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:778
msgid ""
"Pourquoi le choix « Natif C++ » est-il grisé dans Configuration de base ?"
msgstr "Почему вариант « Нативный C++ » серый в Базовой настройке?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:780
msgid ""
"Parce qu'une cause empêche le moteur natif de tout servir : le binaire "
"bin/omega-http-core est absent ou ne démarre pas sur cette machine "
"(install.sh essaie alors de le recompiler), ou TLS est en mode direct alors "
"que le reverse proxy, FastCGI ou l'envoi de fichiers est actif (ces routes "
"demandent de confier la connexion au processus Python, impossible quand le "
"natif chiffre lui-même). La liste des causes, et comment lever chacune, "
"s'affiche sous le choix. Jamais de serveur à moitié natif : levez la cause, "
"puis choisissez le natif."
msgstr ""
"Потому что что-то мешает нативному движку обслуживать всё: бинарный файл "
"bin/omega-http-core отсутствует или не запускается на этой машине (тогда "
"install.sh пытается его перекомпилировать), либо TLS в прямом режиме, а "
"reverse proxy, FastCGI или загрузка файлов включены (этим маршрутам нужно "
"передать соединение процессу Python, что невозможно, когда нативный движок "
"шифрует сам). Список причин и способ устранить каждую показаны под выбором. "
"Никогда не бывает наполовину нативного сервера: устраните причину, затем "
"выберите нативный движок."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:790
msgid ""
"Le moteur natif change-t-il mes journaux, fail2ban (omega-jail) ou RIPOSTE ?"
msgstr ""
"Меняет ли нативный движок мои журналы, fail2ban (omega-jail) или RIPOSTE?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:792
msgid ""
"Non. Le journal d'accès est écrit au même format, caractère pour caractère, "
"et les journaux de sécurité (alertes WAF, événements Active Defense) sont "
"écrits par le même code Python qu'avec le moteur Python. RIPOSTE, omega-jail"
" et omega-fire lisent les mêmes lignes et ne voient aucune différence. Une "
"adresse bannie l'est quel que soit le moteur."
msgstr ""
"Нет. Журнал доступа пишется в том же формате, символ в символ, а журналы "
"безопасности (оповещения WAF, события Active Defense) пишет тот же код "
"Python, что и с движком Python. RIPOSTE, omega-jail и omega-fire читают те "
"же строки и не видят разницы. Заблокированный адрес остаётся заблокированным"
" при любом движке."

#: src/omega_serv/interfaces/tui/guide/content/faq.py:800
msgid ""
"J'ai choisi le moteur natif mais État & Ressources indique « Python » - "
"pourquoi ?"
msgstr ""
"Я выбрал нативный движок, но Состояние и ресурсы показывает « Python » - "
"почему?"

#: src/omega_serv/interfaces/tui/guide/content/faq.py:802
msgid ""
"Le serveur n'a pas encore été redémarré (le moteur ne change qu'au "
"redémarrage complet), ou le natif n'a pas pu démarrer : binaire absent ou "
"refusé, ou fonction active qu'il ne sait pas servir. Dans ce cas le moteur "
"Python sert tout, et la raison est affichée dans État & Ressources (section "
"MOTEUR HTTP), dans le journal d'erreurs et par la commande « omega-serv "
"engine status ». Rien n'est jamais servi à moitié par l'un et à moitié par "
"l'autre."
msgstr ""
"Сервер ещё не перезапущен (движок меняется только при полном перезапуске), "
"или нативный движок не смог запуститься: бинарный файл отсутствует или "
"отклонён, либо включена функция, которую он не умеет обслуживать. В этом "
"случае всё обслуживает движок Python, а причина показана в Состояние и "
"ресурсы (раздел HTTP-ДВИЖОК), в журнале ошибок и командой « omega-serv "
"engine status ». Ничто никогда не обслуживается наполовину одним и "
"наполовину другим движком."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:62
msgid "Gestion des logs (menu)"
msgstr "Управление журналами (меню)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:11
msgid "Accueil -> Gestion des logs"
msgstr "Главная -> Управление журналами"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:13
msgid ""
"Sous-menu en 2 colonnes de 5 boutons : BIBLIOTHÈQUE (consultation - "
"Bibliothèque, Favoris, Voir les logs, Voir et traiter IP, Statistiques) et "
"MAINTENANCE (Rotate / archivage, Restaurer une archive, Purger les archives,"
" Exporter, Santé des logs)."
msgstr ""
"Подменю в 2 столбца по 5 кнопок: БИБЛИОТЕКА (просмотр - Библиотека, "
"Избранное, Просмотр журналов, IP-адреса, Статистика) и ОБСЛУЖИВАНИЕ (Ротация"
" / архивирование, Восстановить архив, Очистить архивы, Экспорт, Состояние "
"журналов)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:24
msgid "Accueil -> Gestion des logs -> Bibliothèque"
msgstr "Главная -> Управление журналами -> Библиотека"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:26
msgid ""
"Hub central référençant tous les logs à traiter (ceux d'Omega-Serv ou tout "
"autre fichier de log de la machine) - alimentation MANUELLE (aucun scan "
"automatique du système pour cette passe). Source commune de 'Voir les logs',"
" 'Favoris' et 'Voir et traiter IP'."
msgstr ""
"Центральное место, где перечислены все журналы для обработки (журналы Omega-"
"Serv или любой другой файл журнала на машине) - заполнение ВРУЧНУЮ (на этом "
"этапе система автоматически не сканируется). Общий источник для 'Просмотр "
"журналов', 'Избранное' и 'IP-адреса'."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:33
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:56
msgid "Chemin à ajouter manuellement"
msgstr "Путь для ручного добавления"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:34
msgid "Référence un fichier de log quelconque dans la Bibliothèque."
msgstr "Добавляет любой файл журнала в Библиотеку."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:35
msgid ""
"Chemin absolu ou relatif au projet - le fichier n'a pas besoin d'exister "
"déjà."
msgstr ""
"Абсолютный путь или относительно проекта - файл может ещё не существовать."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:36
msgid "Ajoute (ou remplace si déjà présent) une entrée."
msgstr "Добавляет (или заменяет, если уже есть) запись."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:37
msgid ""
"Aucun effet sur le serveur - l'état (existe/taille) est toujours recalculé à"
" l'affichage."
msgstr ""
"Без эффекта на сервер - состояние (существует/размер) всегда пересчитывается"
" при отображении."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:40
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:60
msgid "Ajouter les logs connus d'Omega-Serv"
msgstr "Добавить известные журналы Omega-Serv"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:41
msgid ""
"Ajoute en un clic les logs propres à ce projet (access/error/waf-alerts, + "
"magnet si actif)."
msgstr ""
"Добавляет одним щелчком собственные журналы этого проекта (access/error/waf-"
"alerts, + magnet, если включён)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:42
msgid "Aucune saisie requise."
msgstr "Ввод не требуется."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:43
msgid "Ajoute (ou remplace) ces entrées dans la Bibliothèque."
msgstr "Добавляет (или заменяет) эти записи в Библиотеке."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:44
msgid ""
"Jamais un scan du reste du système - uniquement les quelques logs déjà "
"connus de ce projet."
msgstr ""
"Никогда не сканирует остальную систему - только несколько журналов, уже "
"известных этому проекту."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:47
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:66
msgid "Retirer la sélection"
msgstr "Убрать выбранное"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:48
msgid ""
"Retire une entrée de la Bibliothèque (ne supprime jamais le fichier lui-"
"même)."
msgstr "Убирает запись из Библиотеки (сам файл никогда не удаляется)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:49
#: src/omega_serv/interfaces/tui/guide/content/logs.py:90
#: src/omega_serv/interfaces/tui/guide/content/logs.py:141
msgid "Sélectionner une ligne, confirmation obligatoire."
msgstr "Выберите строку, подтверждение обязательно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:50
msgid "Retire l'entrée du fichier var/library.json."
msgstr "Убирает запись из файла var/library.json."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:51
msgid ""
"Le fichier de log sur disque n'est jamais touché - seule la référence est "
"retirée."
msgstr ""
"Файл журнала на диске никогда не затрагивается - убирается только ссылка."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:54
msgid ""
"Purement une liste de références - aucun effet sur les fichiers de log eux-"
"mêmes."
msgstr "Только список ссылок - без эффекта на сами файлы журналов."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:57
msgid ""
"L'état affiché (OK/SUSPECT/ABSENT) est toujours recalculé en lisant le "
"disque réellement à chaque ouverture de cet écran, jamais une donnée figée "
"au moment de l'ajout."
msgstr ""
"Отображаемое состояние (OK/ПОДОЗРИТЕЛЬНО/ОТСУТСТВУЕТ) всегда пересчитывается"
" реальным чтением диска при каждом открытии этого экрана, а не берётся из "
"данных на момент добавления."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:66
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:65
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:40
msgid "Favoris"
msgstr "Избранное"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:67
msgid "Accueil -> Gestion des logs -> Favoris"
msgstr "Главная -> Управление журналами -> Избранное"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:68
msgid ""
"Combinaisons nommées (un ou plusieurs logs de la Bibliothèque + un viewer) "
"pour un lancement direct."
msgstr ""
"Именованные сочетания (один или несколько журналов Библиотеки + просмотрщик)"
" для прямого запуска."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:71
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:49
msgid "Lancer"
msgstr "Запустить"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:72
msgid "Ouvre directement le favori sélectionné avec son viewer d'origine."
msgstr "Напрямую открывает выбранное избранное в его исходном просмотрщике."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:73
msgid "Sélectionner une ligne dans la table des favoris."
msgstr "Выберите строку в таблице избранного."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:74
msgid "Ouvre l'écran du viewer correspondant (Simple/Classique/lnav)."
msgstr ""
"Открывает экран соответствующего просмотрщика (Простой/Классический/lnav)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:75
#: src/omega_serv/interfaces/tui/guide/content/logs.py:221
#: src/omega_serv/interfaces/tui/guide/content/logs.py:253
#: src/omega_serv/interfaces/tui/guide/content/logs.py:271
msgid "Aucun effet sur le serveur (lecture seule)."
msgstr "Без эффекта на сервер (только чтение)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:78
msgid "Numéros + Nom du favori + Viewer + Enregistrer"
msgstr "Номера + Имя избранного + Просмотрщик + Сохранить"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:79
msgid "Crée un nouveau favori à partir de logs choisis dans la Bibliothèque."
msgstr "Создаёт новое избранное из журналов, выбранных в Библиотеке."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:81
msgid ""
"Numéros séparés par des virgules (ex: 1,3) - un seul log autorisé avec "
"Simple/Classique, lnav uniquement au-delà d'un log."
msgstr ""
"Номера через запятую (напр.: 1,3) - с Простым/Классическим разрешён только "
"один журнал, lnav - только если журналов больше одного."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:84
msgid "Enregistre le favori (remplace un favori existant du même nom)."
msgstr "Сохраняет избранное (заменяет существующее с тем же именем)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:85
msgid ""
"Refuse à la création si le viewer choisi est incompatible avec le nombre de "
"logs - jamais tronqué silencieusement."
msgstr ""
"Отклоняется при создании, если выбранный просмотрщик несовместим с числом "
"журналов - никогда не обрезается незаметно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:89
msgid "Retire définitivement un favori."
msgstr "Безвозвратно удаляет избранное."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:91
msgid "Retire l'entrée du fichier var/favorites.json."
msgstr "Убирает запись из файла var/favorites.json."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:92
msgid "Ne touche jamais aux fichiers de log eux-mêmes ni à la Bibliothèque."
msgstr "Никогда не затрагивает сами файлы журналов и Библиотеку."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:95
msgid ""
"Purement des raccourcis - aucun effet sur les fichiers de log eux-mêmes."
msgstr "Только ярлыки - без эффекта на сами файлы журналов."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:100
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:64
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:62
msgid "Sources distantes (SSH)"
msgstr "Удалённые источники (SSH)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:101
msgid "Accueil -> Gestion des logs -> Bibliothèque -> Sources distantes (SSH)"
msgstr ""
"Главная -> Управление журналами -> Библиотека -> Удалённые источники (SSH)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:103
msgid ""
"Permet de récupérer, à la demande, UNE COPIE du log d'un serveur backend "
"situé sur le même réseau local (derrière le reverse proxy) via scp, puis de "
"l'ajouter automatiquement à la Bibliothèque - ce n'est jamais une "
"consultation en direct du serveur distant, mais un instantané figé au moment"
" du clic sur 'Récupérer maintenant' ; une nouvelle récupération remplace la "
"copie précédente par une plus récente. Aucun scan réseau automatique, aucune"
" connexion sans configuration explicite de votre part."
msgstr ""
"Позволяет по запросу получить КОПИЮ журнала бэкенд-сервера в той же "
"локальной сети (за обратным прокси) через scp и автоматически добавить её в "
"Библиотеку - это никогда не просмотр удалённого сервера в реальном времени, "
"а снимок на момент нажатия 'Получить сейчас'; новое получение заменяет "
"предыдущую копию более свежей. Никакого автоматического сканирования сети, "
"никаких подключений без вашей явной настройки."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:112
msgid "Label / Hôte / Chemin distant"
msgstr "Метка / Хост / Удалённый путь"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:113
msgid ""
"Identifie la source : un nom de votre choix, l'adresse du serveur, et le "
"chemin du fichier de log sur ce serveur."
msgstr ""
"Идентифицирует источник: имя на ваш выбор, адрес сервера и путь к файлу "
"журнала на этом сервере."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:114
msgid ""
"Tous les trois sont obligatoires. L'hôte peut être une adresse IP, un nom "
"d'hôte, ou un alias déjà défini dans votre ~/.ssh/config."
msgstr ""
"Все три обязательны. Хост может быть IP-адресом, именем хоста или "
"псевдонимом, уже заданным в вашем ~/.ssh/config."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:115
#: src/omega_serv/interfaces/tui/guide/content/logs.py:122
msgid "Pris en compte au clic sur Enregistrer."
msgstr "Учитывается при нажатии Сохранить."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:116
msgid ""
"Aucun effet réseau - purement une définition locale, tant que 'Récupérer "
"maintenant' n'est pas utilisé."
msgstr ""
"Без сетевого эффекта - только локальное определение, пока не используется "
"'Получить сейчас'."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:119
msgid "Utilisateur / Port / Chemin de la clé privée"
msgstr "Пользователь / Порт / Путь к закрытому ключу"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:120
msgid ""
"Optionnels - laissez vide pour utiliser les réglages par défaut de votre "
"propre ssh (agent, ~/.ssh/config)."
msgstr ""
"Необязательно - оставьте пустым, чтобы использовать настройки по умолчанию "
"вашего ssh (агент, ~/.ssh/config)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:121
msgid ""
"Ne renseignez que ce qui diffère des réglages par défaut de votre "
"configuration SSH habituelle."
msgstr ""
"Указывайте только то, что отличается от настроек по умолчанию вашей обычной "
"конфигурации SSH."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:123
msgid ""
"Omega-Serv ne lit ni ne stocke JAMAIS le contenu d'une clé - uniquement son "
"chemin, si vous en indiquez un."
msgstr ""
"Omega-Serv НИКОГДА не читает и не хранит содержимое ключа - только его путь,"
" если вы его указали."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:126
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:75
msgid "Récupérer maintenant"
msgstr "Получить сейчас"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:127
msgid ""
"Lance scp vers l'hôte de la source sélectionnée et ajoute le résultat à la "
"Bibliothèque."
msgstr ""
"Запускает scp к хосту выбранного источника и добавляет результат в "
"Библиотеку."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:128
msgid "Sélectionner une ligne dans la table active le bouton."
msgstr "Выбор строки в таблице активирует кнопку."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:129
msgid ""
"Tourne en arrière-plan (l'interface reste utilisable) ; un message indique "
"le résultat."
msgstr ""
"Выполняется в фоне (интерфейсом можно пользоваться); результат показывается "
"сообщением."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:131
msgid ""
"Écrit un fichier dans var/log/remote/ (en écrasant une éventuelle copie "
"précédente de la même source) et l'ajoute à la Bibliothèque (accès affiché "
"comme 'ssh', colonne 'Modifié' = date de CETTE récupération, jamais celle du"
" fichier distant) - en cas d'échec (hôte injoignable, scp absent, droits "
"refuses), le message d'erreur du système est affiché tel quel, aucun fichier"
" n'est ajouté."
msgstr ""
"Записывает файл в var/log/remote/ (перезаписывая возможную предыдущую копию "
"того же источника) и добавляет его в Библиотеку (доступ отображается как "
"'ssh', столбец 'Изменён' = дата ЭТОГО получения, а не удалённого файла) - "
"при ошибке (хост недоступен, нет scp, доступ запрещён) сообщение системы "
"показывается как есть, файл не добавляется."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:140
msgid ""
"Retire définitivement une source distante (ne supprime jamais un fichier "
"déjà récupéré)."
msgstr ""
"Безвозвратно удаляет удалённый источник (уже полученный файл никогда не "
"удаляется)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:142
msgid "Retire l'entrée du fichier var/remote-log-sources.json."
msgstr "Убирает запись из файла var/remote-log-sources.json."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:143
msgid ""
"Un fichier déjà récupéré dans la Bibliothèque n'est pas retiré par cette "
"action."
msgstr "Файл, уже полученный в Библиотеку, этим действием не убирается."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:147
msgid ""
"Aucune action réseau n'est jamais entreprise automatiquement - uniquement au"
" clic explicite sur 'Récupérer maintenant'. Aucun mot de passe n'est jamais "
"demandé ni stocké."
msgstr ""
"Никакие сетевые действия никогда не выполняются автоматически - только по "
"явному нажатию 'Получить сейчас'. Пароль никогда не запрашивается и не "
"хранится."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:152
msgid ""
"Aucune vérification de taille n'est faite avant ou pendant le transfert - un"
" fichier distant très volumineux sera récupéré en intégralité."
msgstr ""
"Размер не проверяется ни до, ни во время передачи - очень большой удалённый "
"файл будет получен целиком."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:156
msgid ""
"Une adresse IPv6 écrite directement (sans alias ~/.ssh/config) n'est pas "
"supportée par la syntaxe hôte:chemin de scp."
msgstr ""
"Адрес IPv6, указанный напрямую (без псевдонима в ~/.ssh/config), не "
"поддерживается синтаксисом хост:путь у scp."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:164
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:66
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:41
msgid "Voir les logs"
msgstr "Просмотр журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:165
msgid "Accueil -> Gestion des logs -> Voir les logs"
msgstr "Главная -> Управление журналами -> Просмотр журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:167
msgid ""
"Choisit un ou plusieurs logs EXCLUSIVEMENT depuis la Bibliothèque (aucun "
"import manuel ici), puis un viewer : Simple (tail en direct + stats "
"génériques), Classique (lecture + suivi), lnav (fusion multi-logs)."
msgstr ""
"Выбирает один или несколько журналов ТОЛЬКО из Библиотеки (здесь нет ручного"
" импорта), затем просмотрщик: Простой (tail в реальном времени + общая "
"статистика), Классический (чтение + отслеживание), lnav (объединение "
"нескольких журналов)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:173
msgid "Numéros (ex: 1,3)"
msgstr "Номера (напр.: 1,3)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:174
msgid ""
"Sélectionne un ou plusieurs logs de la Bibliothèque par leur numéro de "
"ligne."
msgstr "Выбирает один или несколько журналов Библиотеки по номеру строки."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:175
msgid "Séparés par des virgules pour en sélectionner plusieurs."
msgstr "Через запятую, чтобы выбрать несколько."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:176
msgid "Détermine les logs ouverts par les 3 boutons de viewer."
msgstr "Определяет журналы, открываемые 3 кнопками просмотрщиков."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:180
msgid "Voir (simple) / Voir (classique) / Voir (lnav)"
msgstr "Просмотр (простой) / Просмотр (классический) / Просмотр (lnav)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:181
msgid "Ouvre les logs sélectionnés avec le viewer choisi."
msgstr "Открывает выбранные журналы в выбранном просмотрщике."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:182
msgid ""
"Simple et Classique exigent exactement UN log sélectionné ; lnav fonctionne "
"avec un ou plusieurs."
msgstr ""
"Простой и Классический требуют ровно ОДИН выбранный журнал; lnav работает с "
"одним или несколькими."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:183
msgid "Ouvre l'écran du viewer correspondant."
msgstr "Открывает экран соответствующего просмотрщика."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:184
msgid ""
"Refus explicite si le viewer est incompatible avec le nombre de logs "
"sélectionnés."
msgstr ""
"Явный отказ, если просмотрщик несовместим с числом выбранных журналов."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:187
msgid ""
"Purement consultatif - la sélection de logs ici n'est jamais mémorisée (voir"
" Favoris pour cela)."
msgstr ""
"Только просмотр - выбор журналов здесь никогда не запоминается (для этого "
"см. Избранное)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:192
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:67
msgid "Voir les logs - Simple"
msgstr "Просмотр журналов - Простой"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:193
msgid "Accueil -> Gestion des logs -> Voir les logs -> Voir (simple)"
msgstr ""
"Главная -> Управление журналами -> Просмотр журналов -> Просмотр (простой)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:195
msgid ""
"Suit un log en direct avec un parseur GÉNÉRIQUE (fonctionne sur n'importe "
"quel format - access log, auth.log, syslog...) et un petit tableau de "
"statistiques (IPs uniques, taux d'erreur, répartition des codes HTTP si le "
"format s'y prête)."
msgstr ""
"Отслеживает журнал в реальном времени универсальным парсером (работает с "
"любым форматом - access log, auth.log, syslog...) и небольшой таблицей "
"статистики (уникальные IP, доля ошибок, распределение кодов HTTP, если "
"формат позволяет)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:200
msgid "Purement consultatif, aucun effet sur le serveur."
msgstr "Только просмотр, без эффекта на сервер."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:203
msgid ""
"La section 'STATUTS HTTP' n'apparaît que si au moins une ligne du tampon "
"ressemble à un access log Combined/Common - jamais affichée pour un "
"auth.log/syslog."
msgstr ""
"Раздел 'СТАТУСЫ HTTP' появляется, только если хотя бы одна строка буфера "
"похожа на access log Combined/Common - для auth.log/syslog никогда не "
"показывается."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:212
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:68
msgid "Voir les logs - Classique"
msgstr "Просмотр журналов - Классический"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:213
msgid "Accueil -> Gestion des logs -> Voir les logs -> Voir (classique)"
msgstr ""
"Главная -> Управление журналами -> Просмотр журналов -> Просмотр "
"(классический)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:214
msgid ""
"Affiche les 200 dernières lignes d'un log choisi dans la Bibliothèque et "
"peut suivre son évolution en direct."
msgstr ""
"Показывает последние 200 строк журнала, выбранного в Библиотеке, и может "
"отслеживать его изменения в реальном времени."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:217
#: src/omega_serv/interfaces/tui/screens/log_viewer_screen.py:52
#: src/omega_serv/interfaces/tui/screens/log_viewer_screen.py:111
msgid "Suivre en direct"
msgstr "Отслеживать"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:218
msgid ""
"Rafraîchit l'affichage automatiquement toutes les secondes avec les "
"nouvelles lignes."
msgstr "Автоматически обновляет отображение каждую секунду новыми строками."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:219
msgid "Bascule marche/arret."
msgstr "Переключатель вкл/выкл."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:220
msgid "Demarre/arrete le suivi périodique."
msgstr "Запускает/останавливает периодическое отслеживание."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:224
msgid "Purement consultatif, aucun effet sur le serveur ou sa configuration."
msgstr "Только просмотр, без эффекта на сервер и его конфигурацию."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:227
msgid ""
"Un fichier appartenant au compte système dédié du service peut rester "
"illisible depuis une session qui n'a pas encore pris en compte son "
"appartenance de groupe (mêmes causes que le piège déjà documenté pour "
"SERVICE - reconnectez votre session)."
msgstr ""
"Файл, принадлежащий выделенной системной учётной записи службы, может "
"оставаться нечитаемым из сеанса, который ещё не учёл членство в группе (те "
"же причины, что и в уже описанной ловушке для СЛУЖБЫ - войдите в систему "
"заново)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:236
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:69
#: src/omega_serv/interfaces/tui/screens/lnav_screen.py:52
msgid "Suivre les logs fusionnés (lnav)"
msgstr "Объединённые журналы (lnav)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:237
msgid ""
"Accueil -> Gestion des logs -> Voir les logs -> Voir (lnav), ou directement "
"en cas de sélection multiple"
msgstr ""
"Главная -> Управление журналами -> Просмотр журналов -> Просмотр (lnav), или"
" напрямую при множественном выборе"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:238
msgid ""
"Lance l'outil externe lnav sur un ou plusieurs logs fusionnés "
"chronologiquement, dans un vrai terminal."
msgstr ""
"Запускает внешний инструмент lnav для одного или нескольких журналов, "
"объединённых по времени, в настоящем терминале."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:241
msgid "Cases à cocher (Access/Error/WAF alerts log/WAF magnet)"
msgstr "Флажки (Access/Error/WAF alerts log/WAF magnet)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:243
msgid ""
"Choisit quels logs connus fusionner dans la même vue lnav - inclut d'office "
"les 2 logs du script WAF complémentaire magnet (options.waf.magnet.paths, "
"§7), même si le magnet n'est pas actif."
msgstr ""
"Выбирает, какие известные журналы объединить в одном представлении lnav - "
"всегда включает 2 журнала дополнительного WAF-скрипта magnet "
"(options.waf.magnet.paths, §7), даже если magnet не включён."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:248
msgid ""
"Une ou plusieurs cases, au moins un fichier existant requis. Un log coché "
"mais absent (ex. magnet jamais activé) est simplement ignore au lancement, "
"jamais bloquant pour les autres."
msgstr ""
"Один или несколько флажков, нужен хотя бы один существующий файл. "
"Отмеченный, но отсутствующий журнал (напр. magnet никогда не включался) "
"просто игнорируется при запуске и не мешает остальным."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:252
#: src/omega_serv/interfaces/tui/guide/content/logs.py:259
#: src/omega_serv/interfaces/tui/guide/content/logs.py:270
msgid "Pris en compte au clic sur Lancer lnav."
msgstr "Учитывается при нажатии Запустить lnav."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:256
msgid ""
"Logs sélectionnés depuis la Bibliothèque (si ouvert via 'Voir les logs')"
msgstr ""
"Журналы, выбранные в Библиотеке (если открыто через 'Просмотр журналов')"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:257
msgid ""
"Pré-coche les logs choisis dans l'écran 'Voir les logs' - jamais ajouté aux "
"épingles persistées."
msgstr ""
"Заранее отмечает журналы, выбранные на экране 'Просмотр журналов' - никогда "
"не добавляются к сохранённым закреплениям."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:258
msgid "Décocher pour exclure un log de cette fusion ponctuelle."
msgstr ""
"Снимите отметку, чтобы исключить журнал из этого разового объединения."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:260
msgid ""
"Une sélection ponctuelle depuis la Bibliothèque, contrairement à une "
"épingle, ne survit pas à cet écran."
msgstr ""
"Разовый выбор из Библиотеки, в отличие от закрепления, не сохраняется после "
"этого экрана."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:263
msgid "Chemins épinglés (cases à cocher dynamiques)"
msgstr "Закреплённые пути (динамические флажки)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:265
msgid ""
"Chemins manuels ajoutés par 'Épingler ce chemin' - persistent entre sessions"
" (contrairement au champ manuel ci-dessous), affiches comme des logs connus "
"supplémentaires."
msgstr ""
"Ручные пути, добавленные кнопкой 'Закрепить путь' - сохраняются между "
"сеансами (в отличие от ручного поля ниже) и отображаются как дополнительные "
"известные журналы."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:269
msgid "Une case par chemin épinglé - coché ou non, comme les logs connus."
msgstr ""
"По одному флажку на закреплённый путь - отмеченный или нет, как известные "
"журналы."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:274
msgid "Chemin manuel + Épingler ce chemin"
msgstr "Ручной путь + Закрепить путь"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:275
msgid ""
"Saisit un chemin de log hors des logs connus, et le conserve pour les "
"prochains lancements."
msgstr ""
"Вводит путь к журналу вне известных журналов и сохраняет его для следующих "
"запусков."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:277
msgid ""
"Chemin relatif au projet ou absolu. 'Épingler ce chemin' l'ajoute à la liste"
" des épingles (ci-dessus) ET vide ce champ - sans epinglage, le chemin ne "
"sert qu'une seule fois, pour ce lancement."
msgstr ""
"Путь относительно проекта или абсолютный. 'Закрепить путь' добавляет его в "
"список закреплений (выше) И очищает это поле - без закрепления путь "
"используется только один раз, для этого запуска."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:281
msgid ""
"Chemin non épinglé : pris en compte au clic sur Lancer lnav, pour cette fois"
" seulement. Épinglé : persiste (voir settings.json) jusqu'à retrait "
"explicite."
msgstr ""
"Незакреплённый путь: учитывается при нажатии Запустить lnav, только в этот "
"раз. Закреплённый: сохраняется (см. settings.json) до явного удаления."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:285
msgid "Retirer une épingle choisie"
msgstr "Убрать выбранное закрепление"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:286
msgid "Retire définitivement un chemin de la liste des épingles."
msgstr "Безвозвратно убирает путь из списка закреплений."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:287
msgid ""
"Choisir le chemin dans la liste déroulante, puis cliquer sur le bouton."
msgstr "Выберите путь в раскрывающемся списке, затем нажмите кнопку."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:288
msgid "Supprime l'épingle et sa case à cocher correspondante."
msgstr "Удаляет закрепление и соответствующий ему флажок."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:289
msgid ""
"Aucun effet sur le serveur - n'affecte jamais le fichier de log lui-même, "
"seulement la liste des raccourcis."
msgstr ""
"Без эффекта на сервер - никогда не затрагивает сам файл журнала, только "
"список ярлыков."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:292
#: src/omega_serv/interfaces/tui/screens/lnav_screen.py:128
msgid "Lancer lnav"
msgstr "Запустить lnav"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:293
msgid "Ouvre lnav en plein écran dans le terminal réel."
msgstr "Открывает lnav на весь экран в настоящем терминале."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:294
msgid "Nécessite au moins un fichier existant sélectionné."
msgstr "Требуется хотя бы один выбранный существующий файл."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:295
msgid "Suspend l'interface et rend la main au terminal."
msgstr "Приостанавливает интерфейс и передаёт управление терминалу."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:296
msgid ""
"Aucun effet sur le serveur - quitter lnav (Ctrl-Q) revient à cet écran."
msgstr ""
"Без эффекта на сервер - выход из lnav (Ctrl-Q) возвращает на этот экран."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:301
msgid ""
"Nécessite que l'outil lnav soit installé sur le système - indisponible "
"sinon, message explicite."
msgstr ""
"Требует установленного в системе инструмента lnav - иначе недоступно, с "
"явным сообщением."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:307
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:70
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:42
msgid "Voir et traiter IP"
msgstr "IP-адреса"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:308
msgid "Accueil -> Gestion des logs -> Voir et traiter IP"
msgstr "Главная -> Управление журналами -> IP-адреса"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:310
msgid ""
"Liste les IP les plus actives parmi un ou plusieurs logs de la Bibliothèque "
"(n'importe quel format, pas seulement l'access log), avec possibilité de "
"retirer une IP des logs analyses."
msgstr ""
"Показывает самые активные IP в одном или нескольких журналах Библиотеки "
"(любой формат, не только access log), с возможностью убрать IP из "
"анализируемых журналов."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:316
#: src/omega_serv/interfaces/tui/guide/content/logs.py:369
msgid "Numéros (ex: 1,2)"
msgstr "Номера (напр.: 1,2)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:317
#: src/omega_serv/interfaces/tui/guide/content/logs.py:370
msgid "Sélectionne un ou plusieurs logs de la Bibliothèque à analyser."
msgstr "Выбирает один или несколько журналов Библиотеки для анализа."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:318
msgid "Séparés par des virgules pour en analyser plusieurs ensemble."
msgstr "Через запятую, чтобы анализировать несколько вместе."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:319
#: src/omega_serv/interfaces/tui/guide/content/logs.py:372
msgid "Détermine les logs lus par les boutons de période."
msgstr "Определяет журналы, читаемые кнопками периода."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:323
#: src/omega_serv/interfaces/tui/guide/content/logs.py:376
msgid "24h / 7j / 30j / Tout (fichier entier)"
msgstr "24ч / 7д / 30д / Всё (весь файл)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:324
msgid "Choisit la période analysée."
msgstr "Выбирает анализируемый период."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:325
msgid ""
"24h, 7j et 30j lisent depuis la fin du fichier (rapide) ; « Tout » lit le "
"fichier entier, de quelques secondes à plusieurs minutes pour un gros log. "
"La taille et le nombre de lignes estimé de la sélection s'affichent avant le"
" clic."
msgstr ""
"24ч, 7д и 30д читают с конца файла (быстро); «Всё» читает весь файл — для "
"большого журнала это занимает от нескольких секунд до нескольких минут. "
"Размер и примерное число строк выбранного отображаются до нажатия."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:328
msgid ""
"Relit et analyse les logs sélectionnés en arrière-plan, sur plusieurs cœurs "
"pour un gros fichier : une roue, des messages, le temps écoulé et une barre "
"de progression montrent que le calcul avance. Les boutons de période restent"
" grisés jusqu'à la fin."
msgstr ""
"Перечитывает и анализирует выбранные журналы в фоне, для большого файла — на"
" нескольких ядрах: индикатор вращения, сообщения, прошедшее время и полоса "
"прогресса показывают, что расчёт идёт. Кнопки периодов остаются неактивными "
"до конца."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:331
msgid ""
"Aucun effet (lecture seule). Échap arrête l'analyse : il faudra la relancer."
msgstr ""
"Без последствий (только чтение). Esc прерывает анализ: его придётся "
"запустить заново."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:334
msgid "IP à rechercher / Rechercher cette IP"
msgstr "Искомый IP / Найти этот IP"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:335
msgid ""
"Cherche une IP précise dans les logs sélectionnés, sans attendre qu'elle "
"apparaisse dans le top."
msgstr ""
"Ищет конкретный IP в выбранных журналах, не дожидаясь его появления в топе."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:337
msgid ""
"Saisissez l'adresse (IPv4 ou IPv6, ex: 203.0.113.42), puis le bouton ou "
"Entrée. Le fichier entier est lu, en arrière-plan."
msgstr ""
"Введите адрес (IPv4 или IPv6, напр.: 203.0.113.42), затем кнопка или Enter. "
"Весь файл читается в фоне."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:339
msgid ""
"Compte les lignes de cette IP dans chaque log : le total et le détail par "
"log s'affichent au-dessus du tableau. Ce sont exactement les lignes que le "
"retrait supprimerait."
msgstr ""
"Считает строки этого IP в каждом журнале: итог и разбивка по журналам "
"выводятся над таблицей. Это ровно те строки, которые удалило бы удаление IP."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:341
msgid ""
"Aucun effet (lecture seule). Si l'IP est présente, elle est déjà "
"sélectionnée : « Retirer cette IP » est actif ; après le retrait, l'IP est "
"recomptée."
msgstr ""
"Без последствий (только чтение). Если IP найден, он уже выбран: «Убрать этот"
" IP» активна; после удаления IP пересчитывается."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:345
#: src/omega_serv/interfaces/tui/screens/process_ip_screen.py:104
msgid "Retirer cette IP des logs analyses"
msgstr "Убрать этот IP из анализируемых журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:346
msgid ""
"Supprime toutes les lignes contenant l'IP sélectionnée, dans TOUS les logs "
"analyses."
msgstr ""
"Удаляет все строки, содержащие выбранный IP, во ВСЕХ анализируемых журналах."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:347
msgid ""
"Sélectionner une ligne active le bouton, avec confirmation obligatoire."
msgstr "Выбор строки активирует кнопку, подтверждение обязательно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:348
msgid "Réécrit chaque fichier de log concerne sans les lignes de cette IP."
msgstr "Перезаписывает каждый затронутый файл журнала без строк этого IP."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:349
msgid ""
"Modification DÉFINITIVE et immédiate des fichiers de log - action "
"destructive."
msgstr ""
"БЕЗВОЗВРАТНОЕ и немедленное изменение файлов журналов - разрушительное "
"действие."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:352
msgid ""
"Le retrait d'IP modifie directement et irréversiblement les fichiers de log "
"concernés."
msgstr "Удаление IP напрямую и необратимо изменяет затронутые файлы журналов."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:354
msgid ""
"La reconnaissance d'une IP dans une ligne ne dépend d'aucun format "
"particulier - fonctionne identiquement quel que soit le type de log."
msgstr ""
"Распознавание IP в строке не зависит от конкретного формата - работает "
"одинаково для любого типа журнала."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:355
#: src/omega_serv/interfaces/tui/guide/content/logs.py:396
msgid ""
"Un log illisible par votre compte (par exemple /var/log/auth.log) : votre "
"mot de passe sudo est demandé, puis le log est lu avec sudo. Refus : le "
"chemin en cause est affiché."
msgstr ""
"Журнал, недоступный для чтения вашей учётной записи (например, "
"/var/log/auth.log): запрашивается ваш пароль sudo, затем журнал читается "
"через sudo. При отказе показывается проблемный путь."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:362
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:71
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:43
msgid "Statistiques"
msgstr "Статистика"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:363
msgid "Accueil -> Gestion des logs -> Statistiques"
msgstr "Главная -> Управление журналами -> Статистика"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:364
msgid ""
"Rapport de statistiques d'un ou plusieurs logs de la Bibliothèque, quel que "
"soit leur format : synthèse, statuts HTTP en jauges, top IP, chemins "
"demandés et en 404, répartition horaire et tendance par jour. Même écran "
"qu'omega-log."
msgstr ""
"Статистический отчёт по одному или нескольким журналам из Библиотеки, в "
"любом формате: сводка, HTTP-статусы в виде шкал, топ IP, запрошенные пути и "
"пути с 404, распределение по часам и тренд по дням. Тот же экран, что и в "
"omega-log."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:371
msgid ""
"Séparés par des virgules ; sans saisie, la ligne surlignée est utilisée."
msgstr "Через запятую; без ввода используется выделенная строка."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:377
msgid "Choisit la période et lance le calcul."
msgstr "Выбирает период и запускает расчёт."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:378
msgid ""
"Même fonctionnement que dans Voir et traiter IP : indicateur d'attente, "
"barre de progression, un seul calcul à la fois."
msgstr ""
"Работает так же, как в IP-адреса: индикатор ожидания, полоса прогресса, "
"только один расчёт одновременно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:380
msgid "Calcule le rapport en arrière-plan et l'affiche sous les boutons."
msgstr "Рассчитывает отчёт в фоне и показывает его под кнопками."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:384
#: src/omega_serv/interfaces/tui/guide/content/logs.py:518
msgid "Exporter JSON / Exporter HTML"
msgstr "Экспорт JSON / Экспорт HTML"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:385
msgid "Enregistre le dernier rapport calculé dans le répertoire d'export."
msgstr "Сохраняет последний рассчитанный отчёт в каталог экспорта."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:386
msgid ""
"Calculez d'abord une période ; choisissez le thème avant l'export HTML."
msgstr "Сначала рассчитайте период; выберите тему перед экспортом HTML."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:387
msgid ""
"JSON : les données brutes. HTML : le rapport complet avec cartes, "
"histogramme et jauges, dans la langue des exports (Options)."
msgstr ""
"JSON: исходные данные. HTML: полный отчёт с карточками, гистограммой и "
"шкалами, на языке экспорта (Параметры)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:389
#: src/omega_serv/interfaces/tui/guide/content/logs.py:581
msgid "Écriture d'un fichier horodaté, aucun effet sur le serveur."
msgstr "Запись файла с отметкой времени, без влияния на сервер."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:392
msgid "Purement consultatif - les logs ne sont jamais modifiés."
msgstr "Только для информации - журналы никогда не изменяются."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:394
msgid ""
"Les heures du log sont lues telles qu'elles sont écrites (fuseau ignoré) : "
"la répartition horaire suit l'horloge du programme qui a écrit le log."
msgstr ""
"Время в журнале читается так, как записано (часовой пояс игнорируется): "
"распределение по часам следует часам программы, записавшей журнал."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:403
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:72
msgid "Rotation / archivage des logs"
msgstr "Ротация / архивирование журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:404
msgid "Accueil -> Gestion des logs -> Rotation / archivage des logs"
msgstr "Главная -> Управление журналами -> Ротация / архивирование журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:405
msgid ""
"Quatre modes : rotation conditionnelle (seuil de taille), sauvegarde "
"immédiate inconditionnelle, planifier une automatisation, gérer les "
"automatisations existantes."
msgstr ""
"Четыре режима: условная ротация (порог размера), немедленное безусловное "
"резервирование, планирование автоматизации, управление существующими "
"автоматизациями."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:408
#: src/omega_serv/interfaces/tui/screens/log_rotation_screen.py:87
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:85
#: src/omega_serv/interfaces/tui/screens/riposte_policy_form_screen.py:117
msgid "Action"
msgstr "Действие"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:409
msgid "Choisit le mode de cet écran."
msgstr "Выбирает режим этого экрана."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:411
msgid ""
"'Tourner si nécessaire' (respecte le seuil de taille configuré), 'Sauvegarde"
" maintenant' (inconditionnelle), 'Configurer une automatisation', 'Gérer les"
" automatisations'."
msgstr ""
"'Ротация при необходимости' (учитывает настроенный порог размера), "
"'Резервная копия сейчас' (безусловно), 'Настроить автоматизацию', 'Управлять"
" автоматизациями'."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:415
msgid "Change les champs affiches en dessous."
msgstr "Меняет поля, показанные ниже."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:416
msgid "Aucun effet en lui-même, juste un changement d'affichage."
msgstr "Сам по себе без эффекта, только меняет отображение."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:419
#: src/omega_serv/interfaces/tui/screens/log_rotation_screen.py:90
msgid "Log cible"
msgstr "Целевой журнал"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:420
msgid "Le fichier de log concerne par l'action."
msgstr "Файл журнала, к которому относится действие."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:421
msgid "access, error ou waf_alerts."
msgstr "access, error или waf_alerts."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:422
#: src/omega_serv/interfaces/tui/guide/content/logs.py:429
msgid "Utilisé par Valider."
msgstr "Используется кнопкой Подтвердить."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:423
msgid ""
"Archive réellement le fichier immédiatement (modes rotation/sauvegarde)."
msgstr "Реально архивирует файл немедленно (режимы ротации/резервирования)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:426
msgid "Fréquence (mode automatisation)"
msgstr "Частота (режим автоматизации)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:427
msgid "À quelle fréquence l'automatisation doit se déclencher."
msgstr "Как часто должна срабатывать автоматизация."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:428
msgid "Hebdomadaire, mensuelle, trimestrielle, semestrielle ou annuelle."
msgstr "Еженедельно, ежемесячно, ежеквартально, раз в полгода или ежегодно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:430
msgid ""
"Enregistre une automatisation, sans rotation immédiate. La première installe"
" la tâche planifiée qui l'exécute chaque nuit : timer systemd (mot de passe "
"sudo demandé), sinon ligne de votre crontab (OpenRC, runit, aucun "
"gestionnaire), sinon la ligne à ajouter vous-même est affichée."
msgstr ""
"Сохраняет автоматизацию без немедленной ротации. Первая устанавливает "
"запланированную задачу, которая выполняет её каждую ночь: таймер systemd "
"(запрашивается пароль sudo), иначе строку в вашем crontab (OpenRC, runit, "
"без менеджера служб), иначе показывается строка, которую нужно добавить "
"самостоятельно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:436
msgid "Automatisations planifiées (mode gestion)"
msgstr "Запланированные автоматизации (режим управления)"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:437
msgid ""
"Liste des automatisations, avec leur dernière et leur prochaine exécution, "
"et l'état de la tâche planifiée au-dessus."
msgstr ""
"Список автоматизаций с их последним и следующим запуском, а над ним "
"состояние запланированной задачи."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:439
msgid "Sélectionner une ligne active le bouton de suppression."
msgstr "Выбор строки активирует кнопку удаления."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:440
msgid ""
"Supprimer la sélection retire l'automatisation (avec confirmation). La "
"dernière retirée retire aussi la tâche planifiée."
msgstr ""
"Удалить выбранное удаляет автоматизацию (с подтверждением). Удаление "
"последней удаляет и запланированную задачу."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:442
msgid "Suppression immédiate et définitive de l'automatisation choisie."
msgstr "Немедленное и безвозвратное удаление выбранной автоматизации."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:445
#: src/omega_serv/interfaces/tui/screens/log_rotation_screen.py:109
msgid "Réinstaller l'exécution"
msgstr "Переустановить запуск"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:446
msgid ""
"Réinstalle la tâche planifiée si elle a disparu (timer désactivé, crontab "
"vidée)."
msgstr ""
"Заново устанавливает запланированную задачу, если она пропала (таймер "
"отключён, crontab очищен)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:447
msgid "Visible en mode gestion ; l'état affiché dit si c'est nécessaire."
msgstr ""
"Видна в режиме управления; показанное состояние говорит, нужно ли это."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:448
msgid "Même installation qu'à la première automatisation."
msgstr "Та же установка, что и при первой автоматизации."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:449
msgid "Les automatisations s'exécutent de nouveau chaque nuit."
msgstr "Автоматизации снова выполняются каждую ночь."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:453
msgid ""
"'Tourner si nécessaire' ne fait rien si logs.rotation.enabled est désactivé "
"dans la configuration, ou si le fichier n'a pas atteint le seuil de taille "
"configuré. 'Sauvegarde maintenant' archive TOUJOURS, quelle que soit la "
"taille."
msgstr ""
"'Ротация при необходимости' ничего не делает, если logs.rotation.enabled "
"отключён в конфигурации или файл не достиг настроенного порога размера. "
"'Резервная копия сейчас' архивирует ВСЕГДА, независимо от размера."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:459
msgid ""
"Les archives sont écrites dans var/backups/logs/, un emplacement distinct de"
" var/backups/ (réservé aux sauvegardes de configuration)."
msgstr ""
"Архивы записываются в var/backups/logs/ - отдельно от var/backups/ "
"(зарезервировано для резервных копий конфигурации)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:462
msgid ""
"Chaque nuit, la tâche planifiée lance « omega-serv logs run-automations » "
"sous votre compte, jamais root : chaque log dont l'échéance est passée est "
"archivé comme avec « Sauvegarde maintenant ». Un échec est retenté la nuit "
"suivante."
msgstr ""
"Каждую ночь запланированная задача запускает « omega-serv logs run-"
"automations » от вашей учётной записи, никогда от root: каждый журнал с "
"истёкшим сроком архивируется так же, как кнопкой « Резервная копия сейчас »."
" Неудача повторяется следующей ночью."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:465
msgid ""
"Sans systemd, la ligne crontab ne rattrape pas une nuit où la machine était "
"éteinte : l'échéance part la première nuit où elle est allumée. Santé des "
"logs signale une automatisation en retard."
msgstr ""
"Без systemd строка crontab не навёрстывает ночь, когда машина была "
"выключена: просроченный запуск выполняется в первую ночь, когда она "
"включена. Состояние журналов сообщает о просроченной автоматизации."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:472
msgid "Restaurer une archive de log"
msgstr "Восстановить архив журнала"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:473
msgid "Accueil -> Gestion des logs -> Restaurer une archive de log"
msgstr "Главная -> Управление журналами -> Восстановить архив журнала"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:474
msgid ""
"Extrait le contenu d'une archive de log déjà créée vers un répertoire de "
"restauration."
msgstr ""
"Извлекает содержимое уже созданного архива журнала в каталог восстановления."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:477
msgid "Table des archives + Restaurer"
msgstr "Таблица архивов + Восстановить"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:478
msgid "Sélectionne une archive et l'extrait."
msgstr "Выбирает архив и извлекает его."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:479
msgid "Sélectionner une ligne active le bouton Restaurer."
msgstr "Выбор строки активирует кнопку Восстановить."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:480
msgid "Extrait l'archive vers var/log/restored/<nom-archive>/."
msgstr "Извлекает архив в var/log/restored/<имя-архива>/."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:481
msgid ""
"Écriture réelle sur disque immédiate, aucun effet sur le serveur en cours."
msgstr ""
"Реальная немедленная запись на диск, без эффекта на работающий сервер."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:484
msgid ""
"N'écrase jamais les logs actifs - extrait toujours vers un sous-répertoire "
"dédié."
msgstr ""
"Никогда не перезаписывает активные журналы - всегда извлекает в отдельный "
"подкаталог."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:489
msgid "Purger les archives de logs"
msgstr "Очистить архивы журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:490
msgid "Accueil -> Gestion des logs -> Purger les archives de logs"
msgstr "Главная -> Управление журналами -> Очистить архивы журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:491
msgid "Supprime définitivement une archive de log."
msgstr "Безвозвратно удаляет архив журнала."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:494
msgid "Table des archives + Supprimer"
msgstr "Таблица архивов + Удалить"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:495
msgid "Sélectionne une archive et la supprime."
msgstr "Выбирает архив и удаляет его."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:496
msgid ""
"Sélectionner une ligne active le bouton Supprimer, avec confirmation "
"obligatoire."
msgstr "Выбор строки активирует кнопку Удалить, подтверждение обязательно."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:497
msgid "Supprime le fichier d'archive."
msgstr "Удаляет файл архива."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:498
msgid ""
"Suppression immédiate et DÉFINITIVE - action destructive, jamais réversible."
msgstr ""
"Немедленное и БЕЗВОЗВРАТНОЕ удаление - разрушительное действие, никогда не "
"обратимое."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:501
msgid ""
"Action irréversible - aucune corbeille ni sauvegarde préalable automatique."
msgstr ""
"Необратимое действие - нет ни корзины, ни автоматической предварительной "
"копии."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:506
msgid "Exporter Archives"
msgstr "Экспорт архивов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:507
msgid "Accueil -> Gestion des logs -> Exporter Archives"
msgstr "Главная -> Управление журналами -> Экспорт архивов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:508
msgid ""
"Exporte la liste des archives de logs (métadonnées, pas leur contenu) en "
"JSON ou HTML."
msgstr ""
"Экспортирует список архивов журналов (метаданные, не содержимое) в JSON или "
"HTML."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:512
msgid "Palette de couleurs utilisée pour l'export HTML."
msgstr "Цветовая палитра для экспорта HTML."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:519
msgid "Génère le fichier d'export dans le répertoire d'export configuré."
msgstr "Создаёт файл экспорта в настроенном каталоге экспорта."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:521
msgid ""
"Écrit un fichier horodate (jamais d'écrasement silencieux d'un export "
"précédent)."
msgstr ""
"Записывает файл с меткой времени (никогда незаметно не перезаписывает "
"предыдущий экспорт)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:522
msgid "Écriture réelle sur disque immédiate, aucun effet sur le serveur."
msgstr "Реальная немедленная запись на диск, без эффекта на сервер."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:525
msgid ""
"Purement consultatif/export - aucun effet sur la configuration ou le "
"serveur."
msgstr "Только просмотр/экспорт - без эффекта на конфигурацию и сервер."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:527
msgid ""
"Le répertoire d'export peut être changé dans l'écran Réglages de "
"l'application (touche 'o')."
msgstr ""
"Каталог экспорта можно изменить на экране Настройки приложения (клавиша "
"'o')."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:534
msgid "Accueil -> Gestion des logs -> Santé des logs"
msgstr "Главная -> Управление журналами -> Состояние журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:535
msgid ""
"Contrôle en lecture seule des logs d'omega-serv et de ceux de la "
"Bibliothèque, du disque qui les porte et des archives. Chaque log reçoit un "
"niveau : OK, Info, Attention ou Problème."
msgstr ""
"Проверка только для чтения журналов omega-serv и журналов из Библиотеки, "
"диска, на котором они находятся, и архивов. Каждый журнал получает уровень: "
"OK, Инфо, Предупреждение или Проблема."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:539
msgid "Tableau des logs"
msgstr "Таблица журналов"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:540
msgid ""
"Une ligne par log : état (niveau), chemin, taille, dernière écriture et "
"constat le plus grave."
msgstr ""
"Одна строка на журнал: состояние (уровень), путь, размер, последняя запись и"
" самый серьёзный вывод."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:542
msgid ""
"Surlignez une ligne pour voir sous le tableau tous ses constats et, pour "
"chacun, ce que vous pouvez faire (commande ou écran à ouvrir)."
msgstr ""
"Выделите строку, чтобы увидеть под таблицей все её выводы и для каждого — "
"что можно сделать (команда или экран, который нужно открыть)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:544
msgid ""
"Contrôles : fichier absent ou lien cassé, droits (lecture par votre compte, "
"écriture par le compte du service, écriture par tout le monde), log muet "
"depuis plus de 7 jours, fichier vide, dates non reconnues ou dans le futur, "
"octets nuls (log abîmé), seuil de rotation dépassé, gros log sans règle "
"logrotate, doublon dans la Bibliothèque."
msgstr ""
"Проверки: файл отсутствует или ссылка битая, права (чтение вашей учётной "
"записью, запись учётной записью службы, запись для всех), журнал молчит "
"более 7 дней, пустой файл, нераспознанные или будущие даты, нулевые байты "
"(повреждённый журнал), превышен порог ротации, большой журнал без правила "
"logrotate, дубликат в Библиотеке."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:548
msgid "Aucun effet : seuls le début et la fin de chaque log sont lus."
msgstr "Без последствий: читаются только начало и конец каждого журнала."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:551
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:789
#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:104
#: src/omega_serv/interfaces/tui/screens/path_list_editor_screen.py:132
msgid "Corriger les droits"
msgstr "Исправить права"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:552
msgid ""
"Rend un log d'omega-serv de nouveau inscriptible par le compte du service."
msgstr ""
"Снова делает журнал omega-serv доступным для записи учётной записи службы."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:553
msgid ""
"Actif seulement si vous êtes propriétaire du fichier et que le compte du "
"service est dans son groupe. Confirmation obligatoire."
msgstr ""
"Доступно, только если вы владелец файла и учётная запись службы входит в его"
" группу. Требуется подтверждение."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:555
msgid ""
"Ajoute le droit d'écriture du groupe (par exemple 644 → 664), jamais avec "
"sudo, jamais pour tout le monde."
msgstr ""
"Добавляет право записи для группы (например, 644 → 664), никогда через sudo,"
" никогда для всех."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:557
msgid "Le service peut de nouveau écrire ses lignes ; l'analyse est relancée."
msgstr "Служба снова может записывать свои строки; анализ запускается заново."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:560
#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:106
msgid "Corriger avec sudo"
msgstr "Исправить через sudo"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:561
msgid ""
"Corrige les droits quand « Corriger les droits » ne suffit pas (fichier à "
"root, groupe étranger au service) ou qu'un log est inscriptible par tout le "
"monde."
msgstr ""
"Исправляет права, когда « Исправить права » недостаточно (файл принадлежит "
"root, группа не относится к службе) или журнал доступен для записи всем."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:563
msgid ""
"La commande exacte est montrée avant ; votre mot de passe sudo est demandé "
"ensuite."
msgstr ""
"Точная команда показывается заранее; затем запрашивается ваш пароль sudo."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:564
msgid ""
"chgrp vers le compte du service puis chmod g+w, ou chmod o-w : jamais chown,"
" jamais récursif, un seul fichier."
msgstr ""
"chgrp на учётную запись службы, затем chmod g+w, или chmod o-w: никогда "
"chown, никогда рекурсивно, только один файл."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:566
msgid "Droits corrigés ; l'analyse est relancée."
msgstr "Права исправлены; анализ запущен заново."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:569
#: src/omega_serv/interfaces/tui/screens/log_health_screen.py:102
msgid "Analyser avec sudo"
msgstr "Анализ через sudo"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:570
msgid "Complète l'analyse des logs illisibles par votre compte."
msgstr ""
"Дополняет анализ журналов, недоступных для чтения вашей учётной записи."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:571
msgid ""
"Actif seulement si au moins un log est illisible ; mot de passe sudo "
"demandé."
msgstr ""
"Активна, только если хотя бы один журнал недоступен для чтения; "
"запрашивается пароль sudo."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:572
msgid ""
"Lit avec sudo le début et la fin de ces logs : dates, format, octets nuls."
msgstr ""
"Читает через sudo начало и конец этих журналов: даты, формат, нулевые байты."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:573
msgid ""
"Le constat « illisible par votre compte » reste affiché : il est toujours "
"vrai."
msgstr ""
"Вывод « недоступен для чтения вашей учётной записи » остаётся на экране: он "
"по-прежнему верен."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:576
msgid "Exporter JSON / Exporter HTML / Exporter TXT"
msgstr "Экспорт JSON / Экспорт HTML / Экспорт TXT"

#: src/omega_serv/interfaces/tui/guide/content/logs.py:577
msgid "Enregistre le rapport dans le répertoire d'export."
msgstr "Сохраняет отчёт в каталог экспорта."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:578
msgid "Choisissez le thème avant l'export HTML."
msgstr "Выберите тему перед экспортом HTML."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:579
msgid ""
"JSON : les codes et valeurs (données). HTML et TXT : le rapport lisible, "
"avec les conseils, dans la langue des exports (Options)."
msgstr ""
"JSON: коды и значения (данные). HTML и TXT: читаемый отчёт с советами, на "
"языке экспорта (Параметры)."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:584
msgid ""
"Lecture seule, sauf « Corriger les droits » et « Corriger avec sudo », après"
" confirmation."
msgstr ""
"Только чтение, кроме « Исправить права » и « Исправить через sudo », после "
"подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:586
msgid ""
"La croissance par jour est estimée d'après la première et la dernière date "
"du log : elle sert à prévoir dans combien de jours le disque sera plein."
msgstr ""
"Рост в день оценивается по первой и последней дате журнала: по нему "
"прогнозируется, через сколько дней диск заполнится."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:588
msgid ""
"Au-delà du seuil de rotation, utilisez Rotate / archivage : sauvegarde "
"immédiate, ou automatisation planifiée exécutée chaque nuit."
msgstr ""
"При превышении порога ротации используйте Ротация / архивирование: "
"немедленное резервное копирование или запланированная автоматизация, "
"выполняемая каждую ночь."

#: src/omega_serv/interfaces/tui/guide/content/logs.py:590
msgid ""
"Section AUTOMATISATIONS : signale une automatisation de rotation en échec ou"
" en retard de plus de 2 jours, et des automatisations sans tâche planifiée "
"pour les exécuter."
msgstr ""
"Раздел АВТОМАТИЗАЦИИ: сообщает об автоматизации ротации, завершившейся "
"ошибкой или просроченной более чем на 2 дня, а также об автоматизациях без "
"запланированной задачи для их выполнения."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:102
msgid "RIPOSTE - État"
msgstr "RIPOSTE - Состояние"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:11
msgid "Accueil -> Active Sécurité -> État (bloc RIPOSTE)"
msgstr "Главная -> Активная безопасность -> Состояние (блок RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:13
msgid ""
"RIPOSTE agit DANS LA DURÉE : il se souvient des sources qui reviennent et "
"leur applique des bans de plus en plus longs (paliers), alors qu'Active "
"Defense agit PENDANT la requête selon le niveau de menace du moment. Cet "
"écran montre le module (activé ou non, politiques actives), le processus "
"RIPOSTE (actif, PID, dernier signe de vie, lignes lues), les actions en "
"cours et l'arrêt d'urgence."
msgstr ""
"RIPOSTE действует ВО ВРЕМЕНИ: запоминает возвращающиеся источники и "
"применяет к ним всё более долгие баны (ступени), тогда как Active Defense "
"действует ВО ВРЕМЯ запроса по текущему уровню угрозы. Этот экран показывает "
"модуль (включён или нет, активные политики), процесс RIPOSTE (активен, PID, "
"последний признак жизни, прочитанные строки), текущие действия и аварийную "
"остановку."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:20
#: src/omega_serv/interfaces/tui/screens/riposte_status_screen.py:65
#: src/omega_serv/interfaces/tui/screens/riposte_status_screen.py:136
msgid "Arrêt d'urgence"
msgstr "Аварийная остановка"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:21
msgid ""
"Coupe toute nouvelle action RIPOSTE, pour toutes les règles, même après un "
"redémarrage."
msgstr ""
"Прекращает любые новые действия RIPOSTE, для всех правил, даже после "
"перезапуска."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:23
msgid ""
"Choisir « Arrêter et lever les actions en cours » (bans retirés de la "
"blocklist, leurres libérés tout de suite) ou « Arrêter seulement » (les "
"actions vont jusqu'à leur échéance)."
msgstr ""
"Выберите « Остановить и снять текущие действия » (баны убраны из blocklist, "
"ловушки сразу освобождены) или « Только остановить » (действия идут до "
"своего срока)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:26
msgid ""
"Effet immédiat, même si le processus RIPOSTE est arrêté (drapeau mémorisé "
"dans sa base)."
msgstr ""
"Действует сразу, даже если процесс RIPOSTE остановлен (флаг сохранён в его "
"базе)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:27
msgid ""
"Le bouton devient « Reprendre » ; « Reprendre » relance les règles qui "
"étaient actives."
msgstr ""
"Кнопка меняется на « Возобновить »; « Возобновить » снова запускает правила,"
" которые были активны."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:31
msgid ""
"L'arrêt ne touche jamais les bans automatiques du WAF, le mode guerre "
"d'Active Defense, ni les bans réseau déjà passés à fail2ban (à lever dans "
"omega-jail ou fail2ban)."
msgstr ""
"Остановка никогда не затрагивает автоматические баны WAF, режим войны Active"
" Defense и сетевые баны, уже переданные fail2ban (снимайте их в omega-jail "
"или fail2ban)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:35
msgid ""
"Le module s'active dans le menu Options et demande un redémarrage complet du"
" service."
msgstr "Модуль включается в меню Опции и требует полного перезапуска службы."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:36
msgid "Sans WAF actif, RIPOSTE ne voit aucune attaque : l'écran l'indique."
msgstr ""
"Без активного WAF RIPOSTE не видит ни одной атаки: экран об этом сообщает."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:37
msgid ""
"Ban réseau : l'écran dit si les jails RIPOSTE de cette instance sont "
"installées par omega-jail, et signale la jail omega-serv-active-defense (ban"
" fixe de 24 h) qui écrase les paliers réseau."
msgstr ""
"Сетевой бан: экран сообщает, установлены ли omega-jail jail RIPOSTE этого "
"экземпляра, и указывает на jail omega-serv-active-defense (фиксированный бан"
" на 24 ч), который перекрывает сетевые ступени."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:39
msgid ""
"En ligne de commande : « riposte status », « riposte stop [--revoke] », « "
"riposte resume »."
msgstr ""
"В командной строке: « riposte status », « riposte stop [--revoke] », « "
"riposte resume »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:45
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:103
msgid "RIPOSTE - Politiques"
msgstr "RIPOSTE - Политики"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:46
msgid "Accueil -> Active Sécurité -> Politiques (bloc RIPOSTE)"
msgstr "Главная -> Активная безопасность -> Политики (блок RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:48
msgid ""
"Une politique dit QUAND agir (classes d'attaque, nombre de retours dans une "
"fenêtre, niveau Active Defense, visites de leurre) et COMMENT (ban local, "
"ban local + réseau, leurre). Une politique active agit automatiquement, sans"
" validation action par action."
msgstr ""
"Политика определяет, КОГДА действовать (классы атак, число возвращений в "
"окне, уровень Active Defense, визиты в ловушки) и КАК (локальный бан, "
"локальный + сетевой бан, ловушка). Активная политика действует "
"автоматически, без подтверждения каждого действия."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:54
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:525
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:107
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:65
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:48
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:53
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:90
#: src/omega_serv/interfaces/tui/screens/log_library_screen.py:58
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:51
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:158
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:56
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:85
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:50
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:68
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:58
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:85
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:179
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:270
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:95
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:102
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:113
#: src/omega_serv/interfaces/tui/screens/waf_rule_pack_picker_screen.py:67
msgid "Ajouter"
msgstr "Добавить"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:55
msgid ""
"Trois points de départ : un scénario prêt à charger, la copie d'une "
"politique, ou Custom."
msgstr "Три отправные точки: готовый сценарий, копия политики или Custom."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:56
msgid ""
"Le formulaire s'ouvre pré-rempli ; tout reste modifiable avant "
"l'enregistrement."
msgstr "Форма открывается уже заполненной; до сохранения всё можно изменить."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:57
msgid "Rien n'est écrit avant « Enregistrer » dans le formulaire."
msgstr "До « Сохранить » в форме ничего не записывается."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:58
msgid ""
"La politique apparaît dans le tableau, active ou non selon le choix fait à "
"l'enregistrement."
msgstr ""
"Политика появляется в таблице, активной или нет — в зависимости от выбора "
"при сохранении."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:61
msgid "Activer / Désactiver"
msgstr "Включить / Отключить"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:62
msgid "Arrêt d'une seule règle (les autres continuent)."
msgstr "Останавливает одно правило (остальные продолжают работать)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:64
msgid ""
"Désactiver propose de lever ses actions en cours ou de les laisser aller à "
"leur échéance. Activer mesure d'abord la règle et montre l'effet avant de "
"confirmer."
msgstr ""
"Отключение предлагает снять текущие действия или дать им дойти до срока. "
"Включение сначала измеряет правило и показывает эффект до подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:67
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:119
msgid "Écrit la configuration puis demande au processus RIPOSTE de la relire."
msgstr "Записывает конфигурацию, затем просит процесс RIPOSTE перечитать её."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:68
msgid "La règle reste listée, avec ses réglages, même désactivée."
msgstr "Правило остаётся в списке со своими настройками, даже отключённое."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:71
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:91
#: src/omega_serv/interfaces/tui/screens/security_screen.py:92
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:195
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:89
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:106
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:117
msgid "Retirer"
msgstr "Убрать"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:72
msgid "Supprime la politique de la configuration."
msgstr "Удаляет политику из конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:73
msgid "Confirmation demandée."
msgstr "Требуется подтверждение."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:74
msgid "Ses actions passées restent dans l'historique sous son nom."
msgstr "Её прошлые действия остаются в истории под её именем."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:75
msgid ""
"Ses actions en cours vont jusqu'à leur échéance (les lever dans Actions)."
msgstr "Её текущие действия идут до своего срока (снимите их в Действиях)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:78
msgid ""
"Une modification est prise en compte par le processus RIPOSTE en moins d'une"
" seconde."
msgstr "Процесс RIPOSTE учитывает изменение менее чем за секунду."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:80
msgid ""
"Le détail d'une politique « ban local + réseau » indique quelle jail reçoit "
"chaque palier."
msgstr ""
"Подробности политики « локальный + сетевой бан » показывают, какой jail "
"получает каждую ступень."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:81
msgid ""
"En ligne de commande : « riposte policies list|show|enable|disable "
"[--revoke] », « riposte scenarios »."
msgstr ""
"В командной строке: « riposte policies list|show|enable|disable [--revoke] "
"», « riposte scenarios »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:82
msgid ""
"Les scénarios « Explorateur de leurres » et « Sonde upload / API » exigent "
"le profil de leurre fake_admin ou fake_api dans Active Defense -> Réglages "
"(option active_defense activée) ; sinon ils sont refusés (« profil de leurre"
" inconnu »). Marche à suivre : FAQ, rubrique RIPOSTE."
msgstr ""
"Сценарии «Исследователь ловушек» и «Зонд загрузки / API» требуют профиль "
"ловушки fake_admin или fake_api в Active Defense -> «Настройки» (опция "
"active_defense включена); иначе они отклоняются («неизвестный профиль "
"ловушки»). Порядок действий: FAQ, раздел RIPOSTE."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:90
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:104
msgid "RIPOSTE - Formulaire de politique"
msgstr "RIPOSTE - Форма политики"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:91
msgid "Accueil -> Active Sécurité -> Politiques -> Ajouter ou Modifier"
msgstr "Главная -> Активная безопасность -> Политики -> Добавить или Изменить"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:92
msgid ""
"Chaque champ montre sa valeur réelle, un exemple en grisé quand il est vide,"
" et une ligne d'explication."
msgstr ""
"Каждое поле показывает реальное значение, серый пример, если оно пустое, и "
"строку пояснения."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:95
msgid "Déclencheur"
msgstr "Условие"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:96
msgid ""
"Classes d'attaque (vide = toutes), nombre d'épisodes (retours) dans une "
"fenêtre, niveau Active Defense minimal, visites de leurre."
msgstr ""
"Классы атак (пусто = все), число эпизодов (возвращений) в окне, минимальный "
"уровень Active Defense, визиты в ловушки."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:97
msgid ""
"Un retour = un nouvel épisode d'attaque après un silence (réglable dans "
"Réglages)."
msgstr ""
"Возвращение = новый эпизод атаки после затишья (настраивается в Настройках)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:98
msgid "Vérifié à l'enregistrement : rien n'est écrit si un champ est refusé."
msgstr ""
"Проверяется при сохранении: ничего не записывается, если поле отклонено."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:99
msgid "Le message d'erreur nomme le champ fautif."
msgstr "Сообщение об ошибке называет ошибочное поле."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:102
#: src/omega_serv/interfaces/tui/screens/riposte_policies_screen.py:99
msgid "Réponse"
msgstr "Ответ"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:103
msgid ""
"Ban local (blocklist du WAF), ban local + ban réseau (jails omega-jail), ou "
"leurre Active Defense."
msgstr ""
"Локальный бан (blocklist WAF), локальный бан + сетевой бан (jail omega-jail)"
" или ловушка Active Defense."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:104
msgid ""
"Paliers : vide = paliers globaux ; durées en s, m, h ou d (ex. 1h, 6h, 1d, "
"7d)."
msgstr ""
"Ступени: пусто = глобальные ступени; длительности в s, m, h или d (например,"
" 1h, 6h, 1d, 7d)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:105
msgid ""
"Au-delà de 7 jours ou dès le niveau « suspicious » : confirmation « moins "
"prudent que la norme »."
msgstr ""
"Свыше 7 дней или начиная с уровня « suspicious »: подтверждение « менее "
"осторожно, чем норма »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:106
msgid "Le choix confirmé est mémorisé dans la politique."
msgstr "Подтверждённый выбор сохраняется в политике."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:109
#: src/omega_serv/interfaces/tui/screens/riposte_policy_form_screen.py:146
msgid "Mesurer"
msgstr "Измерить"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:110
msgid ""
"Rejoue la politique sur les journaux des 7 derniers jours, sans rien "
"appliquer."
msgstr ""
"Прогоняет политику по журналам за последние 7 дней, ничего не применяя."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:111
msgid ""
"Sur bouton seulement ; le résultat dit la période réellement couverte par "
"les journaux."
msgstr ""
"Только по кнопке; результат сообщает реально охваченный журналами период."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:112
msgid "Calcul hors de l'interface (elle reste utilisable)."
msgstr "Расчёт вне интерфейса (им можно продолжать пользоваться)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:113
msgid "Le résultat est repris dans la confirmation finale."
msgstr "Результат повторяется в итоговом подтверждении."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:116
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:177
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:71
#: src/omega_serv/interfaces/tui/screens/error_pages_screen.py:81
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:70
#: src/omega_serv/interfaces/tui/screens/limits_screen.py:69
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:63
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:87
#: src/omega_serv/interfaces/tui/screens/riposte_policy_form_screen.py:148
#: src/omega_serv/interfaces/tui/screens/riposte_settings_screen.py:91
#: src/omega_serv/interfaces/tui/screens/security_screen.py:76
#: src/omega_serv/interfaces/tui/screens/waf_keyword_list_settings_screen.py:63
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:89
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:80
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:91
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:133
msgid "Enregistrer"
msgstr "Сохранить"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:117
msgid "Confirmation finale : Activer, Enregistrer sans activer, ou Annuler."
msgstr "Итоговое подтверждение: Включить, Сохранить без включения или Отмена."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:118
msgid ""
"« Enregistrer sans activer » permet d'observer d'abord (Mesurer, Simuler)."
msgstr ""
"« Сохранить без включения » позволяет сначала понаблюдать (Измерить, "
"Симуляция)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:120
msgid "Retour à l'écran Politiques."
msgstr "Возврат к экрану Политики."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:123
msgid ""
"Une politique activée agit automatiquement dès le prochain événement "
"correspondant."
msgstr ""
"Включённая политика действует автоматически, начиная со следующего "
"подходящего события."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:125
msgid ""
"Ban réseau : les jails ont des durées fixes (1 h, 6 h, 24 h, 7 j) ; chaque "
"palier va à la plus longue qui ne le dépasse pas (un palier de 2 h va à la "
"jail de 1 h). La confirmation l'affiche."
msgstr ""
"Сетевой бан: у jail фиксированные сроки (1 ч, 6 ч, 24 ч, 7 дн); каждая "
"ступень уходит в самый длинный, не превышающий её (ступень 2 ч уходит в jail"
" на 1 ч). Подтверждение это показывает."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:127
msgid ""
"En ligne de commande : « riposte measure <id>|scenario:<id> [--days N] »."
msgstr ""
"В командной строке: « riposte measure <id>|scenario:<id> [--days N] »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:133
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:105
msgid "RIPOSTE - Actions"
msgstr "RIPOSTE - Действия"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:134
msgid "Accueil -> Active Sécurité -> Actions (bloc RIPOSTE)"
msgstr "Главная -> Активная безопасность -> Действия (блок RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:136
msgid ""
"Le registre des actions : en cours, ou terminées (échéance, levée par "
"l'utilisateur, règle désactivée, arrêt d'urgence, retirée hors RIPOSTE, non "
"appliquée). Rien ne disparaît."
msgstr ""
"Реестр действий: текущих или завершённых (срок, снято пользователем, правило"
" отключено, аварийная остановка, удалено вне RIPOSTE, не применено). Ничего "
"не исчезает."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:141
#: src/omega_serv/interfaces/tui/screens/manual_unban_screen.py:57
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:73
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:184
msgid "Lever"
msgstr "Снять"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:142
msgid "Retire ce ban de la blocklist ou libère ce leurre, tout de suite."
msgstr "Сразу убирает этот бан из blocklist или освобождает эту ловушку."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:144
msgid ""
"« Lever et exempter cette source » évite qu'elle soit bannie de nouveau (24 "
"h, 7 j ou toujours) ; la case « ne pas compter ce ban dans la récidive » "
"corrige un faux positif."
msgstr ""
"« Снять и исключить этот источник » не даёт забанить его снова (24 ч, 7 дн "
"или навсегда); флажок « не учитывать этот бан в рецидиве » исправляет ложное"
" срабатывание."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:147
msgid ""
"Exécuté par le processus RIPOSTE en moins d'une seconde ; s'il est arrêté, à"
" son prochain démarrage."
msgstr ""
"Выполняется процессом RIPOSTE менее чем за секунду; если он остановлен — при"
" его следующем запуске."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:148
msgid "L'action passe dans « terminées »."
msgstr "Действие переходит в « завершённые »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:151
#: src/omega_serv/interfaces/tui/screens/riposte_actions_screen.py:75
msgid "Ne compte pas dans la récidive"
msgstr "Не учитывается в рецидиве"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:152
msgid ""
"L'action reste dans l'historique mais ne fait plus monter le palier suivant."
msgstr "Действие остаётся в истории, но больше не повышает следующую ступень."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:153
msgid "Pour un faux positif découvert après coup."
msgstr "Для ложного срабатывания, обнаруженного позже."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:154
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:176
msgid "Exécuté par le processus RIPOSTE."
msgstr "Выполняется процессом RIPOSTE."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:155
msgid "Le détail de l'action l'indique."
msgstr "Это видно в подробностях действия."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:158
msgid ""
"Une levée ne retire que le ban local : un ban réseau reste dans fail2ban "
"jusqu'à son terme."
msgstr ""
"Снятие убирает только локальный бан: сетевой бан остаётся в fail2ban до "
"своего окончания."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:160
msgid ""
"Une action retirée à la main de la blocklist est vue par RIPOSTE "
"(vérification toutes les 60 s)."
msgstr ""
"Действие, вручную удалённое из blocklist, замечается RIPOSTE (проверка "
"каждые 60 с)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:161
msgid ""
"En ligne de commande : « riposte actions list [--finished]|show|revoke "
"[--exempt 24h|7d|forever] [--not-recidive]|not-recidive », « riposte "
"exemptions list|remove »."
msgstr ""
"В командной строке: « riposte actions list [--finished]|show|revoke "
"[--exempt 24h|7d|forever] [--not-recidive]|not-recidive », « riposte "
"exemptions list|remove »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:168
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:106
msgid "RIPOSTE - Récidives"
msgstr "RIPOSTE - Рецидивы"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:169
msgid "Accueil -> Active Sécurité -> Récidives (bloc RIPOSTE)"
msgstr "Главная -> Активная безопасность -> Рецидивы (блок RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:170
msgid ""
"Les sources suivies : épisodes, actions, palier suivant, chronologie "
"(épisodes, classes d'attaque, actions)."
msgstr ""
"Отслеживаемые источники: эпизоды, действия, следующая ступень, хронология "
"(эпизоды, классы атак, действия)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:173
#: src/omega_serv/interfaces/tui/screens/riposte_recidives_screen.py:62
msgid "Oublier cette source"
msgstr "Забыть этот источник"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:174
msgid "Efface la mémoire de RIPOSTE sur cette adresse (données personnelles)."
msgstr "Стирает память RIPOSTE об этом адресе (персональные данные)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:175
msgid "Refusé tant qu'une action est en cours contre elle : la lever d'abord."
msgstr "Отказ, пока против него идёт действие: сначала снимите его."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:177
msgid "Son prochain retour est traité comme une première fois."
msgstr "Его следующее возвращение считается первым."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:180
msgid ""
"Sans action, l'historique est effacé de lui-même après la durée de "
"conservation (Réglages)."
msgstr ""
"Без действий история стирается сама по истечении срока хранения (Настройки)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:181
msgid ""
"En ligne de commande : « riposte sources list|show|forget », « riposte "
"decisions list »."
msgstr ""
"В командной строке: « riposte sources list|show|forget », « riposte "
"decisions list »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:186
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:107
msgid "RIPOSTE - Simuler"
msgstr "RIPOSTE - Симуляция"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:187
msgid "Accueil -> Active Sécurité -> Simuler (bloc RIPOSTE)"
msgstr "Главная -> Активная безопасность -> Симуляция (блок RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:189
msgid ""
"Décision expliquée pour une situation saisie, avec la configuration réelle :"
" politique retenue, exclusions vérifiées, action, durée, ou raison du refus."
" Rien n'est appliqué ni écrit."
msgstr ""
"Объяснённое решение для введённой ситуации с реальной конфигурацией: "
"выбранная политика, проверенные исключения, действие, длительность или "
"причина отказа. Ничего не применяется и не записывается."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:194
msgid "Décisions récentes"
msgstr "Последние решения"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:195
msgid "Les dernières décisions du processus RIPOSTE."
msgstr "Последние решения процесса RIPOSTE."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:196
msgid "Sélectionner une ligne pour lire son explication."
msgstr "Выберите строку, чтобы прочитать её объяснение."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:198
msgid "L'explication s'affiche sous le tableau."
msgstr "Объяснение появляется под таблицей."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:201
#: src/omega_serv/interfaces/tui/guide/content/tls.py:32
msgid "Aucune - purement consultatif."
msgstr "Нет - только просмотр."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:202
msgid ""
"En ligne de commande : « riposte simulate --ip IP [--class C] [--level L] "
"[--returns N] »."
msgstr ""
"В командной строке: « riposte simulate --ip IP [--class C] [--level L] "
"[--returns N] »."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:207
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:108
msgid "RIPOSTE - Réglages"
msgstr "RIPOSTE - Настройки"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:208
msgid "Accueil -> Active Sécurité -> Réglages (bloc RIPOSTE)"
msgstr "Главная -> Активная безопасность -> Настройки (блок RIPOSTE)"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:210
msgid ""
"Paliers de durée (défaut 1 h, 6 h, 24 h, 7 j), fenêtre de récidive (30 j), "
"silence entre deux épisodes (1 h), conservation de l'historique (90 j), "
"plafond de bans simultanés (100), exemptions."
msgstr ""
"Ступени длительности (по умолчанию 1 ч, 6 ч, 24 ч, 7 дн), окно рецидива (30 "
"дн), затишье между двумя эпизодами (1 ч), хранение истории (90 дн), лимит "
"одновременных банов (100), исключения."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:215
msgid "Exemptions"
msgstr "Исключения"

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:216
msgid ""
"Réseaux contre lesquels RIPOSTE n'agit jamais, en plus des exclusions du WAF"
" (lecture seule ici)."
msgstr ""
"Сети, против которых RIPOSTE никогда не действует, помимо исключений WAF "
"(здесь только для чтения)."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:217
msgid ""
"Celles ajoutées par « Lever et exempter » sont listées à part et retirables."
msgstr ""
"Добавленные через « Снять и исключить » показаны отдельно и могут быть "
"удалены."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:218
msgid "Vérifié avant toute écriture."
msgstr "Проверяется перед любой записью."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:219
msgid "Le processus RIPOSTE relit la configuration."
msgstr "Процесс RIPOSTE перечитывает конфигурацию."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:222
msgid ""
"Les nouveaux réglages s'appliquent aux décisions suivantes, jamais aux "
"actions déjà en cours."
msgstr ""
"Новые настройки применяются к следующим решениям, никогда — к уже идущим "
"действиям."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:224
msgid ""
"Au-delà de 7 jours, les paliers globaux sont refusés ; seule une politique "
"peut le demander, avec confirmation."
msgstr ""
"Свыше 7 дней глобальные ступени отклоняются; только политика может этого "
"потребовать, с подтверждением."

#: src/omega_serv/interfaces/tui/guide/content/riposte.py:225
msgid ""
"Le module lui-même s'active dans Options (redémarrage complet), jamais par "
"un profil."
msgstr ""
"Сам модуль включается в Опциях (полный перезапуск), никогда — через профиль."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:42
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:50
msgid "Alias"
msgstr "Псевдонимы"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:11
msgid "Accueil -> Configuration détaillée -> Alias"
msgstr "Главная -> Подробная настройка -> Псевдонимы"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:12
msgid ""
"CRUD d'alias : sert un préfixe d'URL depuis un chemin cible, y compris hors "
"du webroot."
msgstr ""
"CRUD псевдонимов: отдаёт префикс URL из целевого пути, в том числе вне "
"webroot."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:16
msgid "Le préfixe d'URL à rediriger vers un autre emplacement disque."
msgstr "Префикс URL, перенаправляемый в другое место на диске."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:17
msgid "Doit commencer par '/', ex: /media/."
msgstr "Должен начинаться с '/', напр.: /media/."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:18
#: src/omega_serv/interfaces/tui/guide/content/routage.py:25
#: src/omega_serv/interfaces/tui/guide/content/routage.py:32
msgid "Ajoute/modifie un alias."
msgstr "Добавляет/изменяет псевдоним."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:22
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:111
msgid "Chemin cible"
msgstr "Целевой путь"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:23
msgid "L'emplacement disque réellement servi pour ce préfixe."
msgstr "Место на диске, реально отдаваемое для этого префикса."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:24
msgid ""
"Chemin relatif au projet, ex: webroot/media, ou un chemin hors webroot."
msgstr ""
"Путь относительно проекта, напр.: webroot/media, или путь вне webroot."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:29
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:97
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:112
msgid "Autoriser hors webroot (oui/non)"
msgstr "Разрешить вне webroot (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:30
msgid "Autorise explicitement une cible située en dehors du webroot habituel."
msgstr "Явно разрешает цель, расположенную вне обычного webroot."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:37
msgid ""
"L'option aliases doit être activée (écran Options) pour que ces alias soient"
" réellement appliqués. Toutes les modifications se rechargent à chaud."
msgstr ""
"Чтобы эти псевдонимы реально применялись, параметр aliases должен быть "
"включён (экран Параметры). Все изменения перезагружаются на лету."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:42
msgid ""
"Directory listing et Cache se configurent par ZONE (préfixe d'URL), jamais "
"par dossier cible : un alias '/media/' pointant sur 'webroot/photos/' a "
"besoin de sa PROPRE zone '/media/' sur ces écrans - une zone déjà créée pour"
" '/photos/' (le nom du dossier réel) ne s'applique jamais à l'alias, même si"
" les deux mènent au même contenu sur le disque."
msgstr ""
"Листинг каталогов и Кэш настраиваются по ЗОНЕ (префиксу URL), а не по "
"целевому каталогу: псевдониму '/media/', указывающему на 'webroot/photos/', "
"нужна СВОЯ зона '/media/' на этих экранах - зона, уже созданная для "
"'/photos/' (имя реального каталога), никогда не применяется к псевдониму, "
"даже если оба ведут к одному содержимому на диске."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:53
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:43
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:51
msgid "Redirections"
msgstr "Перенаправления"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:54
msgid "Accueil -> Configuration détaillée -> Redirections"
msgstr "Главная -> Подробная настройка -> Перенаправления"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:55
msgid "CRUD de redirections HTTP (réponse 3xx avec en-tête Location)."
msgstr "CRUD HTTP-перенаправлений (ответ 3xx с заголовком Location)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:59
msgid "Le préfixe d'URL qui déclenche la redirection."
msgstr "Префикс URL, вызывающий перенаправление."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:60
#: src/omega_serv/interfaces/tui/guide/content/routage.py:97
msgid "Doit commencer par '/', ex: /old/."
msgstr "Должен начинаться с '/', напр.: /old/."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:61
#: src/omega_serv/interfaces/tui/guide/content/routage.py:68
#: src/omega_serv/interfaces/tui/guide/content/routage.py:75
msgid "Ajoute/modifie une redirection."
msgstr "Добавляет/изменяет перенаправление."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:65
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:63
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:113
msgid "Destination"
msgstr "Назначение"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:66
msgid "L'URL ou le chemin envoyé dans l'en-tête Location de la réponse."
msgstr "URL или путь, отправляемый в заголовке Location ответа."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:67
msgid "Chaîne libre, ex: /new/."
msgstr "Произвольная строка, напр.: /new/."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:72
#: src/omega_serv/interfaces/tui/screens/log_simple_viewer_screen.py:89
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:63
msgid "Code"
msgstr "Код"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:73
msgid "Le code de statut HTTP de redirection utilisé."
msgstr "Используемый код статуса HTTP-перенаправления."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:74
msgid "301, 302, 307 ou 308. Valeur par défaut : 302."
msgstr "301, 302, 307 или 308. Значение по умолчанию: 302."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:80
msgid ""
"L'option redirects doit être activée (écran Options). Toutes les "
"modifications se rechargent à chaud."
msgstr ""
"Параметр redirects должен быть включён (экран Параметры). Все изменения "
"перезагружаются на лету."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:87
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:44
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:52
msgid "Rewrites"
msgstr "Переписывания"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:88
msgid "Accueil -> Configuration détaillée -> Rewrites"
msgstr "Главная -> Подробная настройка -> Переписывания"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:90
msgid ""
"CRUD de réécritures d'URL internes - remplace un préfixe par un autre AVANT "
"le traitement de la requête, sans jamais renvoyer de redirection au client "
"(invisible côté navigateur)."
msgstr ""
"CRUD внутренних переписываний URL - заменяет один префикс другим ДО "
"обработки запроса, никогда не отправляя клиенту перенаправление (незаметно "
"для браузера)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:95
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:68
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:116
msgid "Préfixe recherche"
msgstr "Искомый префикс"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:96
msgid "Le préfixe d'URL à reconnaître."
msgstr "Распознаваемый префикс URL."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:98
#: src/omega_serv/interfaces/tui/guide/content/routage.py:105
msgid "Ajoute/modifie un rewrite."
msgstr "Добавляет/изменяет переписывание."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:102
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:68
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:117
msgid "Préfixe remplacement"
msgstr "Префикс замены"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:103
msgid "Le préfixe qui remplace le préfixe recherche."
msgstr "Префикс, заменяющий искомый префикс."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:104
msgid "Chaîne non vide, ex: /new/."
msgstr "Непустая строка, напр.: /new/."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:110
msgid ""
"L'option rewrites doit être activée (écran Options). Toutes les "
"modifications se rechargent à chaud."
msgstr ""
"Параметр rewrites должен быть включён (экран Параметры). Все изменения "
"перезагружаются на лету."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:115
msgid ""
"Distinct d'une redirection : le client ne voit jamais l'URL rewritee, "
"contrairement à une redirection qui change l'URL affichée dans le "
"navigateur."
msgstr ""
"В отличие от перенаправления: клиент никогда не видит переписанный URL, "
"тогда как перенаправление меняет URL в адресной строке браузера."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:123
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:46
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:54
msgid "Directory listing"
msgstr "Листинг каталогов"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:124
msgid "Accueil -> Configuration détaillée -> Directory listing"
msgstr "Главная -> Подробная настройка -> Листинг каталогов"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:126
msgid ""
"Deux sections sur le même écran : réglages d'affichage (thème CSS, "
"header/readme) et CRUD des zones où le listing de répertoire est actif."
msgstr ""
"Два раздела на одном экране: настройки отображения (тема CSS, header/readme)"
" и CRUD зон, где включён листинг каталогов."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:131
#: src/omega_serv/interfaces/tui/screens/dirlisting_screen.py:60
msgid "Thème du CSS de base"
msgstr "Тема базового CSS"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:132
msgid ""
"Palette de couleurs utilisée pour le CSS généré automatiquement du listing."
msgstr "Цветовая палитра автоматически генерируемого CSS листинга."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:133
msgid ""
"5 thèmes disponibles (dont 'omega-base'). Valeur par défaut : omega-base."
msgstr ""
"Доступно 5 тем (включая 'omega-base'). Значение по умолчанию: omega-base."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:134
msgid "Enregistre au clic sur 'Enregistrer les réglages'."
msgstr "Сохраняет при нажатии 'Сохранить настройки'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:138
msgid "CSS externe"
msgstr "Внешний CSS"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:139
msgid ""
"URL optionnelle d'une feuille de style chargée EN PLUS du CSS de base "
"(jamais à la place)."
msgstr ""
"Необязательный URL таблицы стилей, загружаемой В ДОПОЛНЕНИЕ к базовому CSS "
"(никогда вместо него)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:140
msgid "Une URL/chemin, ex: /.assets/css/folder.css. Vide par défaut."
msgstr "URL/путь, напр.: /.assets/css/folder.css. По умолчанию пусто."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:141
#: src/omega_serv/interfaces/tui/guide/content/routage.py:148
#: src/omega_serv/interfaces/tui/guide/content/routage.py:155
#: src/omega_serv/interfaces/tui/guide/content/routage.py:162
#: src/omega_serv/interfaces/tui/guide/content/routage.py:169
msgid "Enregistre avec les réglages."
msgstr "Сохраняет вместе с настройками."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:145
msgid "Afficher un fichier HEADER (oui/non) + nom du fichier"
msgstr "Показывать файл HEADER (да/нет) + имя файла"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:146
msgid ""
"Affiche le contenu d'un fichier texte en haut du listing, s'il existe dans "
"le répertoire liste."
msgstr ""
"Показывает содержимое текстового файла вверху листинга, если он есть в "
"перечисляемом каталоге."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:147
msgid "oui/non ; nom de fichier par défaut : HEADER.txt."
msgstr "да/нет; имя файла по умолчанию: HEADER.txt."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:149
msgid ""
"Aucun effet sans rechargement - absence du fichier sur disque : ignore "
"silencieusement, jamais une erreur."
msgstr ""
"Без эффекта без перезагрузки - если файла на диске нет, он молча "
"игнорируется, никогда не ошибка."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:152
msgid "Encoder le contenu HEADER (oui/non)"
msgstr "Экранировать содержимое HEADER (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:153
msgid ""
"Si oui, échappe le contenu comme texte pur ; si non, l'insère tel quel (HTML"
" autorisé)."
msgstr ""
"Если да, экранирует содержимое как простой текст; если нет, вставляет как "
"есть (HTML разрешён)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:154
msgid "oui/non. Valeur par défaut : non (HTML tel quel)."
msgstr "да/нет. Значение по умолчанию: нет (HTML как есть)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:159
msgid "Masquer le fichier HEADER dans la liste (oui/non)"
msgstr "Скрывать файл HEADER в списке (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:160
msgid ""
"Retire ce fichier de la liste des entrées affichées (pour ne pas le voir "
"apparaître deux fois)."
msgstr ""
"Убирает этот файл из списка отображаемых записей (чтобы он не появлялся "
"дважды)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:161
msgid "oui/non. Valeur par défaut : oui."
msgstr "да/нет. Значение по умолчанию: да."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:166
msgid "README (mêmes 4 réglages que HEADER, affiché en bas du listing)"
msgstr "README (те же 4 настройки, что у HEADER, показывается внизу листинга)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:167
msgid ""
"Équivalent de HEADER, affiché après la liste des fichiers plutôt qu'avant."
msgstr "Аналог HEADER, показывается после списка файлов, а не перед ним."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:168
msgid "oui/non ; nom de fichier par défaut : README.txt."
msgstr "да/нет; имя файла по умолчанию: README.txt."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:173
msgid "Zones (table)"
msgstr "Зоны (таблица)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:175
msgid ""
"Préfixes d'URL où le listing de répertoire est proposé quand aucun index "
"n'existe. Un préfixe est une URL TELLE QUE LE NAVIGATEUR LA VOIT, jamais un "
"chemin ou un nom de dossier réel sur le disque."
msgstr ""
"Префиксы URL, где предлагается листинг каталога, если индексного файла нет. "
"Префикс - это URL В ТОМ ВИДЕ, КАК ЕГО ВИДИТ БРАУЗЕР, никогда не путь и не "
"имя реального каталога на диске."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:179
msgid "Un préfixe par ligne, doit commencer par '/'."
msgstr "Один префикс на строку, должен начинаться с '/'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:180
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:142
msgid "Ajouter/Supprimer une zone."
msgstr "Добавить/Удалить зону."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:185
msgid ""
"L'option dirlisting doit être activée (écran Options) pour que le listing "
"apparaisse réellement. Toutes les modifications (réglages et zones) se "
"rechargent à chaud."
msgstr ""
"Чтобы листинг реально появлялся, параметр dirlisting должен быть включён "
"(экран Параметры). Все изменения (настройки и зоны) перезагружаются на лету."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:190
msgid ""
"Les fichiers/dossiers commençant par un point restent masques du listing par"
" la règle générique 'deny_hidden_files' (écran Sécurité générique), "
"indépendamment des réglages de cet écran."
msgstr ""
"Файлы/каталоги, начинающиеся с точки, остаются скрытыми из листинга общим "
"правилом 'deny_hidden_files' (экран Общая безопасность), независимо от "
"настроек этого экрана."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:195
msgid ""
"Servir un MÊME dossier par deux URLs différentes (ex: directement en "
"'/mondossier/' ET via un alias '/autre-nom/' pointant sur ce même dossier, "
"écran Alias) exige DEUX zones ici, une par URL - le listing ne 'suit' jamais"
" le dossier réel, seulement le préfixe d'URL exact tapé par le visiteur. "
"Ajouter uniquement '/mondossier/' n'active jamais le listing sur '/autre-"
"nom/', même si les deux mènent au même contenu sur le disque."
msgstr ""
"Отдача ОДНОГО И ТОГО ЖЕ каталога по двум разным URL (напр. напрямую как "
"'/mydir/' И через псевдоним '/other-name/', указывающий на тот же каталог, "
"экран Псевдонимы) требует здесь ДВУХ зон, по одной на URL - листинг никогда "
"не 'следует' за реальным каталогом, только за точным префиксом URL, "
"набранным посетителем. Добавление только '/mydir/' никогда не включает "
"листинг для '/other-name/', даже если оба ведут к одному содержимому на "
"диске."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:207
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:48
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:56
msgid "Cache"
msgstr "Кэш"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:208
msgid "Accueil -> Configuration détaillée -> Cache"
msgstr "Главная -> Подробная настройка -> Кэш"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:209
msgid ""
"Valeur Cache-Control par défaut, plus des règles spécifiques par zone d'URL "
"et par extension de fichier."
msgstr ""
"Значение Cache-Control по умолчанию, плюс отдельные правила по зоне URL и по"
" расширению файла."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:212
msgid "Valeur par défaut (Cache-Control)"
msgstr "Значение по умолчанию (Cache-Control)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:213
msgid ""
"En-tête Cache-Control envoyé quand aucune règle de zone/extension ne "
"s'applique."
msgstr ""
"Заголовок Cache-Control, отправляемый, когда не применяется ни одно правило "
"зоны/расширения."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:215
msgid ""
"Directives usuelles combinables par virgule : no-cache, no-store, must-"
"revalidate, private, public, max-age=<secondes>, immutable. Valeur par "
"défaut : 'no-cache, must-revalidate'."
msgstr ""
"Обычные директивы, объединяемые через запятую: no-cache, no-store, must-"
"revalidate, private, public, max-age=<секунды>, immutable. Значение по "
"умолчанию: 'no-cache, must-revalidate'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:219
msgid "Enregistrée au clic sur 'Enregistrer la valeur par défaut'."
msgstr "Сохраняется при нажатии 'Сохранить значение по умолчанию'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:223
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:55
msgid "Règles par zone"
msgstr "Правила по зонам"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:224
msgid "Cache-Control spécifique pour un préfixe d'URL donné."
msgstr "Отдельный Cache-Control для заданного префикса URL."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:225
msgid "Un préfixe (ex: /static/) + une valeur Cache-Control."
msgstr "Префикс (напр.: /static/) + значение Cache-Control."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:226
msgid "Ajouter/Supprimer une règle de zone."
msgstr "Добавить/Удалить правило зоны."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:230
#: src/omega_serv/interfaces/tui/screens/cache_screen.py:63
msgid "Règles par extension"
msgstr "Правила по расширениям"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:232
msgid ""
"Cache-Control spécifique pour une extension de fichier donnée. Règles "
"fournies par défaut tant qu'aucune n'est modifiée : images et médias max-"
"age=86400 (1 jour), polices max-age=604800 (7 jours), CSS et JS max-age=3600"
" (1 heure) - une page riche en images n'est plus redemandée à chaque visite."
" Toute modification enregistre votre propre liste, qui remplace celle-ci."
msgstr ""
"Отдельный Cache-Control для заданного расширения файла. Правила по "
"умолчанию, пока ни одно не изменено: изображения и медиа max-age=86400 (1 "
"день), шрифты max-age=604800 (7 дней), CSS и JS max-age=3600 (1 час) - "
"страница с множеством изображений больше не запрашивается заново при каждом "
"посещении. Любое изменение сохраняет собственный список, который заменяет "
"этот."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:238
msgid ""
"Une extension (ex: .css, doit commencer par un point) + une valeur Cache-"
"Control."
msgstr ""
"Расширение (напр.: .css, должно начинаться с точки) + значение Cache-"
"Control."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:239
msgid "Ajouter/Supprimer une règle d'extension."
msgstr "Добавить/Удалить правило расширения."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:244
msgid ""
"L'option cache doit être activée (écran Options). Toutes les modifications "
"se rechargent à chaud. Indépendamment de cette option, chaque fichier "
"statique porte un ETag et une date de modification : un rechargement ne "
"retélécharge que ce qui a changé (réponse 304), et un téléchargement "
"interrompu ou une vidéo peut reprendre en cours de fichier (Range)."
msgstr ""
"Параметр cache должен быть включён (экран Параметры). Все изменения "
"перезагружаются на лету. Независимо от этого параметра каждый статический "
"файл имеет ETag и дату изменения: перезагрузка заново скачивает только "
"изменившееся (ответ 304), а прерванная загрузка или видео могут продолжиться"
" с середины файла (Range)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:254
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:49
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:57
msgid "Pages d'erreur"
msgstr "Страницы ошибок"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:255
msgid "Accueil -> Configuration détaillée -> Pages d'erreur"
msgstr "Главная -> Подробная настройка -> Страницы ошибок"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:257
msgid ""
"Des pages HTML par défaut sont TOUJOURS servies pour toute réponse d'erreur "
"(404, 403, 500...), même sans rien configurer ici. Cet écran ne contrôle que"
" la SURCHARGE personnalisée optionnelle."
msgstr ""
"Для любого ответа с ошибкой (404, 403, 500...) ВСЕГДА отдаются HTML-страницы"
" по умолчанию, даже если здесь ничего не настроено. Этот экран управляет "
"только необязательной собственной ЗАМЕНОЙ."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:263
#: src/omega_serv/interfaces/tui/screens/error_pages_screen.py:63
msgid "Langue des pages visiteurs (pages d'erreur et listing de dossier)"
msgstr "Язык страниц для посетителей (страницы ошибок и список каталога)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:264
msgid ""
"Langue des pages d'erreur et du listing de dossier vus par les visiteurs du "
"site - jamais celle de votre interface."
msgstr ""
"Язык страниц ошибок и списка каталога, которые видят посетители сайта, - "
"никогда не язык вашего интерфейса."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:265
msgid "Une langue de la liste. Valeur par défaut : Français."
msgstr "Язык из списка. Значение по умолчанию: Français."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:266
msgid "Enregistrée dès le choix dans la liste."
msgstr "Сохраняется сразу после выбора в списке."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:268
msgid ""
"Nécessite un REDÉMARRAGE COMPLET du serveur (proposé aussitôt si un service "
"est détecté) - un simple rechargement ne change pas la langue des pages."
msgstr ""
"Требуется ПОЛНЫЙ ПЕРЕЗАПУСК сервера (предлагается сразу, если обнаружена "
"служба) - простая перезагрузка не меняет язык страниц."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:273
msgid "Répertoire de surcharge"
msgstr "Каталог замены"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:274
msgid ""
"Répertoire contenant des fichiers <statut>.html qui remplacent la page par "
"défaut."
msgstr "Каталог с файлами <статус>.html, заменяющими страницу по умолчанию."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:275
msgid "Chemin relatif au projet. Valeur par défaut : webroot/.errors."
msgstr "Путь относительно проекта. Значение по умолчанию: webroot/.errors."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:276
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:349
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:422
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:463
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:867
msgid "Enregistre au clic sur Enregistrer."
msgstr "Сохраняет при нажатии Сохранить."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:278
msgid ""
"Si l'option error_pages est déjà activée : rechargement du service "
"nécessaire (automatique si actif). Si l'option est désactivée : AUCUN EFFET "
"tant qu'elle n'est pas activée depuis Options - un rechargement seul ne "
"suffit pas."
msgstr ""
"Если параметр error_pages уже включён: нужна перезагрузка службы "
"(автоматически, если она активна). Если параметр отключён: НИКАКОГО ЭФФЕКТА,"
" пока он не включён в Параметрах - одной перезагрузки недостаточно."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:285
msgid ""
"Le tableau des statuts gérés indique 'Personnalisée: Oui' dès qu'un fichier "
"<statut>.html existe réellement dans le répertoire configuré, même si "
"l'option error_pages reste désactivée - à ne pas confondre avec 'appliqué "
"réellement'."
msgstr ""
"Таблица обрабатываемых статусов показывает 'Своя: Да', как только файл "
"<статус>.html реально есть в настроенном каталоге, даже если параметр "
"error_pages остаётся отключённым - не путайте с 'реально применяется'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:291
msgid ""
"Cas réel déjà rencontré : un fichier 404.html correctement place n'avait "
"aucun effet car l'option 'error_pages' n'était pas activée séparément dans "
"Options - l'écran l'indique désormais explicitement."
msgstr ""
"Реальный случай: правильно размещённый файл 404.html не действовал, потому "
"что параметр 'error_pages' не был отдельно включён в Параметрах - теперь "
"экран сообщает об этом явно."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:300
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:50
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:58
msgid "Proxies de confiance"
msgstr "Доверенные прокси"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:301
msgid "Accueil -> Configuration détaillée -> Proxies de confiance"
msgstr "Главная -> Подробная настройка -> Доверенные прокси"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:303
msgid ""
"Déclare les réseaux CIDR considérés comme des proxys de confiance (pour lire"
" la vraie IP cliente derrière eux) et l'ordre de préférence des en-têtes "
"X-Forwarded-*."
msgstr ""
"Объявляет сети CIDR, считающиеся доверенными прокси (чтобы узнавать "
"настоящий IP клиента за ними), и порядок предпочтения заголовков "
"X-Forwarded-*."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:308
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:56
msgid "Réseaux de confiance (CIDR)"
msgstr "Доверенные сети (CIDR)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:309
msgid "Réseaux dont l'adresse source est considérée comme un proxy légitime."
msgstr "Сети, исходный адрес которых считается легитимным прокси."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:311
msgid ""
"Notation CIDR, ex: 127.0.0.1/32 pour tailscale serve ou un reverse proxy "
"local. Uniquement le proxy placé devant omega-serv, jamais vos propres "
"appareils : une adresse mise ici n'est pas exemptée de bannissement (réglage"
" never_auto_block). Vérifié réellement au moment de l'ajout."
msgstr ""
"Нотация CIDR, например 127.0.0.1/32 для tailscale serve или локального "
"reverse proxy. Только прокси перед omega-serv, никогда ваши собственные "
"устройства: адрес, указанный здесь, не освобождается от бана (настройка "
"never_auto_block). Проверяется по-настоящему при добавлении."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:316
msgid "Ajouter/Supprimer un réseau."
msgstr "Добавить/Удалить сеть."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:320
msgid "En-têtes préférés (ordre)"
msgstr "Предпочтительные заголовки (порядок)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:321
msgid ""
"Ordre de préférence des en-têtes utilisés pour retrouver l'IP cliente "
"réelle."
msgstr ""
"Порядок предпочтения заголовков, по которым определяется настоящий IP "
"клиента."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:323
msgid ""
"Liste séparée par des virgules, essayée dans l'ordre : X-Forwarded-For "
"(tailscale serve, nginx, Caddy, Apache), Forwarded (RFC 7239), X-Real-IP. Ne"
" peut pas être vide : pour ne lire aucun en-tête, désactiver l'option "
"trusted_proxy. Un nom d'en-tête invalide est refusé."
msgstr ""
"Список через запятую, проверяется по порядку: X-Forwarded-For (tailscale "
"serve, nginx, Caddy, Apache), Forwarded (RFC 7239), X-Real-IP. Не может быть"
" пустым: чтобы не читать никакой заголовок, отключите опцию trusted_proxy. "
"Недопустимое имя заголовка отклоняется."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:328
msgid "Enregistre au clic sur 'Enregistrer les en-têtes'."
msgstr "Сохраняет при нажатии 'Сохранить заголовки'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:333
msgid ""
"L'option trusted_proxy doit être activée (écran Options). Toutes les "
"modifications se rechargent à chaud."
msgstr ""
"Параметр trusted_proxy должен быть включён (экран Параметры). Все изменения "
"перезагружаются на лету."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:338
msgid ""
"Ne jamais faire confiance à X-Forwarded-For sans restreindre les réseaux "
"sources - n'importe quel client pourrait sinon usurper une IP arbitraire."
msgstr ""
"Никогда не доверяйте X-Forwarded-For без ограничения исходных сетей - иначе "
"любой клиент сможет подставить произвольный IP."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:346
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:51
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:59
msgid "Reverse Proxy"
msgstr "Обратный прокси"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:347
msgid "Accueil -> Configuration détaillée -> Reverse Proxy"
msgstr "Главная -> Подробная настройка -> Обратный прокси"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:349
msgid ""
"CRUD de zones de relais sortant : OMEGA-SERV agit lui-même comme reverse "
"proxy vers un ou plusieurs backends (répartition de charge round-robin, TLS "
"amont optionnel, WebSocket)."
msgstr ""
"CRUD зон исходящей ретрансляции: OMEGA-SERV сам работает как обратный прокси"
" к одному или нескольким бэкендам (балансировка round-robin, необязательный "
"TLS к upstream, WebSocket)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:355
msgid "Le préfixe d'URL relayé vers les upstreams."
msgstr "Префикс URL, ретранслируемый на upstream."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:356
msgid "Doit commencer par '/', ex: /api/."
msgstr "Должен начинаться с '/', напр.: /api/."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:357
#: src/omega_serv/interfaces/tui/guide/content/routage.py:364
#: src/omega_serv/interfaces/tui/guide/content/routage.py:371
#: src/omega_serv/interfaces/tui/guide/content/routage.py:378
#: src/omega_serv/interfaces/tui/guide/content/routage.py:385
#: src/omega_serv/interfaces/tui/guide/content/routage.py:392
msgid "Ajoute/modifie une zone."
msgstr "Добавляет/изменяет зону."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:358
msgid ""
"Aucun effet sans rechargement (une fois l'option déjà activé une première "
"fois)."
msgstr ""
"Без эффекта без перезагрузки (после того как параметр уже был включён в "
"первый раз)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:361
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:188
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:172
msgid "Upstreams"
msgstr "Upstream"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:362
msgid ""
"Backends vers lesquels la requête est relayée, en round-robin si plusieurs."
msgstr ""
"Бэкенды, на которые ретранслируется запрос, по очереди (round-robin), если "
"их несколько."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:363
msgid ""
"Liste 'host:port' séparée par des virgules, préfixe 'https://' optionnel par"
" upstream."
msgstr ""
"Список 'host:port' через запятую, необязательный префикс 'https://' для "
"каждого upstream."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:365
#: src/omega_serv/interfaces/tui/guide/content/routage.py:372
#: src/omega_serv/interfaces/tui/guide/content/routage.py:379
#: src/omega_serv/interfaces/tui/guide/content/routage.py:386
#: src/omega_serv/interfaces/tui/guide/content/routage.py:393
msgid "Aucun effet sans rechargement."
msgstr "Без эффекта без перезагрузки."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:368
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:42
msgid "Délai de connexion / Délai de lecture"
msgstr "Тайм-аут подключения / Тайм-аут чтения"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:369
msgid ""
"Délais réseau appliqués à la connexion vers l'upstream et à la lecture de sa"
" réponse."
msgstr "Сетевые тайм-ауты для подключения к upstream и чтения его ответа."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:370
msgid "Nombres en secondes."
msgstr "Числа в секундах."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:375
msgid "Préserver le Host du client (oui/non)"
msgstr "Сохранять Host клиента (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:376
msgid ""
"Transmet l'en-tête Host original du client à l'upstream plutôt que le sien."
msgstr ""
"Передаёт upstream исходный заголовок Host клиента вместо собственного."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:377
msgid "oui/non."
msgstr "да/нет."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:382
msgid "Vérifier le certificat des upstreams HTTPS (oui/non)"
msgstr "Проверять сертификат upstream по HTTPS (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:383
msgid "Vérifie ou non le certificat TLS présenté par un upstream HTTPS."
msgstr "Проверять ли сертификат TLS, предъявляемый upstream по HTTPS."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:384
msgid ""
"oui/non. DANGEREUX si non (attaque MITM possible) - défaut sur, jamais "
"désactivé silencieusement."
msgstr ""
"да/нет. ОПАСНО при нет (возможна атака MITM) - безопасное значение по "
"умолчанию, никогда не отключается незаметно."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:389
msgid "Autoriser Upgrade: websocket (oui/non)"
msgstr "Разрешить Upgrade: websocket (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:390
msgid "Autorise la mise à niveau WebSocket sur cette zone."
msgstr "Разрешает переход на WebSocket в этой зоне."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:391
msgid ""
"oui/non. Une fois le tube établi, un seul upstream reste figé pour sa durée "
"de vie."
msgstr ""
"да/нет. После установки туннеля на всё время его жизни закрепляется один "
"upstream."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:397
msgid ""
"La PREMIÈRE activation de l'option reverse_proxy exige un REDÉMARRAGE "
"COMPLET (le client HTTP n'est construit qu'au démarrage). Une fois déjà "
"activé, modifier les zones ici ne demande plus qu'un simple rechargement. Le"
" bouton 'État en direct' (zone sélectionnée) ouvre un écran séparé pour "
"consulter/forcer l'état de santé de chaque backend du serveur RÉELLEMENT en "
"cours d'exécution - voir sa fiche dédiée."
msgstr ""
"ПЕРВОЕ включение параметра reverse_proxy требует ПОЛНОГО ПЕРЕЗАПУСКА (HTTP-"
"клиент создаётся только при запуске). После того как он уже включён, "
"изменение зон здесь требует лишь простой перезагрузки. Кнопка 'Состояние в "
"реальном времени' (выбранная зона) открывает отдельный экран для "
"просмотра/принудительного задания состояния каждого бэкенда РЕАЛЬНО "
"работающего сервера - см. его отдельную карточку."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:405
msgid ""
"À ne jamais confondre avec le réglage TLS 'mode = behind_proxy' (OMEGA-SERV "
"DERRIÈRE un proxy) - ici, c'est OMEGA-SERV qui EST le proxy vers d'autres "
"backends."
msgstr ""
"Никогда не путайте с настройкой TLS 'mode = behind_proxy' (OMEGA-SERV ЗА "
"прокси) - здесь OMEGA-SERV сам ЯВЛЯЕТСЯ прокси к другим бэкендам."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:413
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:53
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:60
msgid "Cache du reverse proxy"
msgstr "Кэш обратного прокси"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:414
msgid "Accueil -> Configuration détaillée -> Cache du reverse proxy"
msgstr "Главная -> Подробная настройка -> Кэш обратного прокси"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:416
msgid ""
"Supervision et purge du cache des réponses proxiées (DISTINCT du cache "
"fichiers statiques, écran 'Cache') : nombre d'entrées et taille occupée sur "
"disque, lus directement dans var/cache/reverse_proxy/, que le serveur soit "
"démarré ou non, plus un ratio hits/miss EN DIRECT (interroge le serveur "
"réellement en cours d'exécution via /.omega-serv-admin/cache-stats - affiche"
" 'indisponible' si le serveur est éteint ou injoignable, sans jamais bloquer"
" le reste de l'écran)."
msgstr ""
"Наблюдение и очистка кэша проксируемых ответов (ОТДЕЛЬНО от кэша статических"
" файлов, экран 'Кэш'): число записей и занятый размер на диске, читаемые "
"прямо из var/cache/reverse_proxy/, запущен сервер или нет, плюс соотношение "
"hits/miss В РЕАЛЬНОМ ВРЕМЕНИ (опрашивает реально работающий сервер через "
"/.omega-serv-admin/cache-stats - показывает 'недоступно', если сервер "
"выключен или недоступен, никогда не блокируя остальной экран)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:425
msgid "Plafond (Mo)"
msgstr "Лимит (МБ)"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:426
msgid ""
"Taille maximale occupée sur disque par le cache avant éviction des entrées "
"les plus anciennes."
msgstr "Максимальный размер кэша на диске до вытеснения самых старых записей."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:427
msgid "Nombre entier >= 1, en megaoctets."
msgstr "Целое число >= 1, в мегабайтах."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:428
msgid "Modifier le plafond."
msgstr "Изменить лимит."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:429
msgid ""
"Enregistre dans la configuration ; s'applique à la prochaine écriture en "
"cache (éviction immédiate non déclenchée par ce seul changement)."
msgstr ""
"Записывает в конфигурацию; применяется при следующей записи в кэш (само это "
"изменение не вызывает немедленного вытеснения)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:432
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_cache_screen.py:74
msgid "Purger une zone"
msgstr "Очистить зону"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:433
msgid "Supprime toutes les entrées de cache pour un préfixe de zone donné."
msgstr "Удаляет все записи кэша для заданного префикса зоны."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:434
msgid "Saisir le préfixe exact de la zone, ex: /api/."
msgstr "Введите точный префикс зоны, напр.: /api/."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:435
#: src/omega_serv/interfaces/tui/guide/content/routage.py:442
msgid "Confirme puis purge."
msgstr "Подтверждает, затем очищает."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:436
msgid ""
"Entrées supprimées du disque immédiatement, y compris si le serveur tourne "
"(il relira à froid)."
msgstr ""
"Записи немедленно удаляются с диска, даже если сервер работает (он "
"перечитает их заново)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:439
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_cache_screen.py:76
msgid "Purger tout"
msgstr "Очистить всё"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:440
msgid "Supprime toutes les entrées de cache, toutes zones confondues."
msgstr "Удаляет все записи кэша во всех зонах."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:441
msgid "Action destructive, confirmation demandée."
msgstr "Разрушительное действие, запрашивается подтверждение."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:443
msgid "Cache entièrement vide immédiatement."
msgstr "Кэш немедленно полностью очищен."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:447
msgid ""
"Activation/parametres du cache (active, TTL, respect des en-têtes Cache-"
"Control de l'upstream, autorisation Set-Cookie) se configurent sur l'écran "
"Reverse Proxy, zone par zone - cet écran-ci ne fait que superviser et purger"
" ce qui existe déjà sur disque."
msgstr ""
"Включение/параметры кэша (включён, TTL, соблюдение заголовков Cache-Control "
"от upstream, разрешение Set-Cookie) настраиваются на экране Обратный прокси,"
" по зонам - этот экран только наблюдает и очищает то, что уже есть на диске."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:453
msgid ""
"Le ratio hits/miss est cumulé EN MÉMOIRE depuis le dernier démarrage COMPLET"
" du serveur (jamais persiste) - un simple rechargement (SIGHUP) ne le remet "
"jamais à zéro. Nécessite trusted_proxy actif avec 127.0.0.1 dans ses réseaux"
" de confiance, sinon affiche 'indisponible'. Le diagnostic PAR REQUÊTE reste"
" l'en-tête de réponse X-Omega-Cache (HIT/MISS/BYPASS), visible via les "
"outils du navigateur ou 'curl -I'."
msgstr ""
"Соотношение hits/miss накапливается В ПАМЯТИ с последнего ПОЛНОГО запуска "
"сервера (никогда не сохраняется) - простая перезагрузка (SIGHUP) никогда его"
" не сбрасывает. Требуется включённый trusted_proxy с 127.0.0.1 в доверенных "
"сетях, иначе показывается 'недоступно'. Диагностикой ДЛЯ КАЖДОГО ЗАПРОСА "
"остаётся заголовок ответа X-Omega-Cache (HIT/MISS/BYPASS), видимый в "
"инструментах браузера или через 'curl -I'."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:464
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:52
msgid "État en direct des backends"
msgstr "Состояние бэкендов в реальном времени"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:465
msgid ""
"Accueil -> Configuration détaillée -> Reverse Proxy -> sélectionner une zone"
" -> État en direct"
msgstr ""
"Главная -> Подробная настройка -> Обратный прокси -> выбрать зону -> "
"Состояние в реальном времени"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:467
msgid ""
"Interroge le serveur RÉELLEMENT en cours d'exécution (jamais la "
"configuration sur disque) pour afficher l'état actuel de chaque backend "
"d'une zone (up/down/draining/maintenance) et permettre de forcer DRAINING ou"
" MAINTENANCE à chaud, via la route /.omega-serv-admin/health - un vrai appel"
" HTTP local, jamais une modification en mémoire de cet écran (qui ne tourne "
"pas dans le processus serveur)."
msgstr ""
"Опрашивает РЕАЛЬНО работающий сервер (никогда не конфигурацию на диске), "
"чтобы показать текущее состояние каждого бэкенда зоны "
"(up/down/draining/maintenance) и позволить принудительно задать DRAINING или"
" MAINTENANCE на лету через маршрут /.omega-serv-admin/health - настоящий "
"локальный HTTP-вызов, а не изменение в памяти со стороны этого экрана "
"(который работает не в процессе сервера)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:475
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_upstream_status_screen.py:61
msgid "Mettre en DRAINING"
msgstr "Перевести в DRAINING"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:476
msgid ""
"Exclut le backend sélectionné des NOUVEAUX choix sans le marquer en panne."
msgstr ""
"Исключает выбранный бэкенд из НОВЫХ выборов, не помечая его как отказавший."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:477
#: src/omega_serv/interfaces/tui/guide/content/routage.py:484
#: src/omega_serv/interfaces/tui/guide/content/routage.py:491
msgid "Sélectionner une ligne puis cliquer."
msgstr "Выберите строку, затем нажмите."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:478
#: src/omega_serv/interfaces/tui/guide/content/routage.py:485
#: src/omega_serv/interfaces/tui/guide/content/routage.py:492
msgid "Appel HTTP immédiat vers le serveur en cours."
msgstr "Немедленный HTTP-вызов к работающему серверу."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:479
#: src/omega_serv/interfaces/tui/guide/content/routage.py:486
msgid ""
"Statut visible immédiatement après actualisation ; jamais écrit dans la "
"configuration."
msgstr ""
"Статус виден сразу после обновления; никогда не записывается в конфигурацию."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:482
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_upstream_status_screen.py:63
msgid "Mettre en MAINTENANCE"
msgstr "Перевести в MAINTENANCE"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:483
msgid ""
"Même exclusion que DRAINING, intention opérateur distincte (intervention "
"planifiée)."
msgstr ""
"То же исключение, что DRAINING, но иное намерение оператора (плановые "
"работы)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:489
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_upstream_status_screen.py:66
msgid "Revenir à l'automatique"
msgstr "Вернуть автоматический режим"

#: src/omega_serv/interfaces/tui/guide/content/routage.py:490
msgid ""
"Annule DRAINING/MAINTENANCE - l'état redevient dérivé de la santé réelle "
"observée (up/down)."
msgstr ""
"Отменяет DRAINING/MAINTENANCE - состояние снова определяется фактически "
"наблюдаемым здоровьем (up/down)."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:494
msgid ""
"Ne force jamais 'up' aveuglément : un backend réellement en panne pendant la"
" maintenance reste 'down' une fois celle-ci levée."
msgstr ""
"Никогда не задаёт 'up' вслепую: бэкенд, реально отказавший во время "
"обслуживания, остаётся 'down' после его окончания."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:500
msgid ""
"DRAINING/MAINTENANCE restent ÉPHÉMÈRES : jamais écrits dans la "
"configuration, jamais persistés - seul un REDÉMARRAGE COMPLET du serveur les"
" efface (un simple rechargement SIGHUP les conserve). 'DOWN' reste toujours "
"dérivé automatiquement de la santé observée, jamais affecté par cet écran."
msgstr ""
"DRAINING/MAINTENANCE остаются ВРЕМЕННЫМИ: никогда не записываются в "
"конфигурацию и не сохраняются - сбрасываются только ПОЛНЫМ ПЕРЕЗАПУСКОМ "
"сервера (простая перезагрузка SIGHUP их сохраняет). 'DOWN' всегда "
"определяется автоматически по наблюдаемому здоровью и этим экраном не "
"затрагивается."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:507
msgid ""
"Nécessite trusted_proxy actif avec 127.0.0.1 dans ses réseaux de confiance -"
" sinon l'écran affiche 'serveur injoignable', jamais une erreur bloquante."
msgstr ""
"Требуется включённый trusted_proxy с 127.0.0.1 в доверенных сетях - иначе "
"экран показывает 'сервер недоступен', никогда не блокирующую ошибку."

#: src/omega_serv/interfaces/tui/guide/content/routage.py:511
msgid ""
"Un serveur éteint rend cet écran entièrement indisponible (contrairement aux"
" statistiques disque du cache, lisibles à froid) : il interroge "
"exclusivement le PROCESSUS en cours, jamais la configuration sur disque."
msgstr ""
"При выключенном сервере этот экран полностью недоступен (в отличие от "
"дисковой статистики кэша, читаемой без запуска): он опрашивает исключительно"
" работающий ПРОЦЕСС, никогда не конфигурацию на диске."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:85
msgid "Active Sécurité (menu)"
msgstr "Активная безопасность (меню)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:11
msgid "Accueil -> Active Sécurité"
msgstr "Главная -> Активная безопасность"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:13
msgid ""
"Regroupe trois blocs, dans l'ordre d'une attaque : WAF (protéger : mode, "
"packs, blocklist, limitations), Active Defense (détecter : menaces, "
"incidents, leurres, pendant la requête) et RIPOSTE (riposter dans la durée :"
" bans de plus en plus longs pour les sources qui reviennent). En dessous, "
"INTERVENTION MANUELLE : bannir ou débannir une adresse IP à la main, sans "
"condition, et voir le statut de tous les bans."
msgstr ""
"Объединяет три блока в порядке атаки: WAF (защитить: режим, пакеты, "
"blocklist, ограничения), Active Defense (обнаружить: угрозы, инциденты, "
"ловушки, во время запроса) и RIPOSTE (ответить во времени: всё более долгие "
"баны для возвращающихся источников). Ниже — РУЧНОЕ ВМЕШАТЕЛЬСТВО: забанить "
"или разбанить IP-адрес вручную, без условий, и посмотреть статус всех банов."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:22
msgid ""
"Si un avertissement de groupe système apparaît en haut de cet écran, "
"reconnectez votre session avant d'utiliser les sous-écrans - sinon ils "
"resteront en erreur d'accès."
msgstr ""
"Если вверху этого экрана появляется предупреждение о системной группе, "
"войдите в систему заново, прежде чем пользоваться подэкранами - иначе они "
"будут выдавать ошибку доступа."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:26
msgid ""
"Activer l'option 'active_defense' (menu Options) ne suffit PAS à lui seul - "
"voir la fiche 'Active Defense - État' et la FAQ 'Active Defense ne détecte "
"jamais rien'."
msgstr ""
"Одного включения параметра 'active_defense' (меню Параметры) НЕДОСТАТОЧНО - "
"см. карточку 'Active Defense - Состояние' и FAQ 'Active Defense ничего не "
"обнаруживает'."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:34
msgid "Active Defense - État"
msgstr "Active Defense - Состояние"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:35
msgid "Accueil -> Active Sécurité -> État (bloc Active Defense)"
msgstr "Главная -> Активная безопасность -> Состояние (блок Active Defense)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:36
msgid ""
"Vue d'ensemble en lecture seule : mode, état du mode guerre, état de la "
"deception, nombre de sources suivies."
msgstr ""
"Обзор только для чтения: режим, состояние боевого режима, состояние "
"deception, число отслеживаемых источников."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:39
msgid ""
"Purement consultatif - mais la ligne 'Mode guerre' affichée ici est le seul "
"endroit où vérifier le VRAI interrupteur qui déclenche quoi que ce soit "
"(voir points de vigilance)."
msgstr ""
"Только просмотр - но строка 'Боевой режим' здесь - единственное место, где "
"можно проверить НАСТОЯЩИЙ переключатель, который вообще что-либо запускает "
"(см. на что обратить внимание)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:43
msgid ""
"L'activation de l'option active_defense se fait dans le menu Options, jamais"
" ici."
msgstr "Параметр active_defense включается в меню Параметры, никогда здесь."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:45
msgid ""
"PIÈGE RÉEL VÉRIFIÉ DANS LE CODE : activer l'option 'active_defense' seule ne"
" déclenche RIEN. Un second interrupteur, `war_mode.enabled` (Active Defense "
"- Réglages), vaut FALSE par défaut. Tant qu'il reste à false, les écrans "
"Menaces/Incidents/Leurres restent fonctionnels mais ne se peuplent jamais, "
"même avec un trafic hostile réel."
msgstr ""
"РЕАЛЬНАЯ ЛОВУШКА, ПРОВЕРЕННАЯ В КОДЕ: одно лишь включение параметра "
"'active_defense' НИЧЕГО не запускает. Второй переключатель, "
"`war_mode.enabled` (Active Defense - Настройки), по умолчанию равен FALSE. "
"Пока он false, экраны Угрозы/Инциденты/Приманки работают, но никогда не "
"заполняются, даже при реальном враждебном трафике."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:52
msgid ""
"Une fois `war_mode.enabled=true`, tout devient automatique et déterministe, "
"sans aucune intervention manuelle : chaque décision WAF déjà calculée "
"alimente un score cumulé par source (IP + User-Agent hache, avec "
"décroissance dans le temps), qui franchit des seuils configurables "
"(normal/suspicious/hostile/contained) déclenchant des actions automatiques "
"(redirection vers un leurre, journalisation enrichie, ralentissement, "
"création d'incident)."
msgstr ""
"После `war_mode.enabled=true` всё становится автоматическим и "
"детерминированным, без какого-либо ручного вмешательства: каждое уже "
"вычисленное решение WAF пополняет накопительный балл источника (IP + хеш "
"User-Agent, с затуханием во времени), который пересекает настраиваемые "
"пороги (normal/suspicious/hostile/contained), запускающие автоматические "
"действия (перенаправление на приманку, расширенное журналирование, "
"замедление, создание инцидента)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:64
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:97
msgid "Active Defense - Réglages"
msgstr "Active Defense - Настройки"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:65
msgid "Accueil -> Active Sécurité -> Réglages (bloc Active Defense)"
msgstr "Главная -> Активная безопасность -> Настройки (блок Active Defense)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:67
msgid ""
"Configure l'intégralité d'Active Defense (mode guerre, deception/leurres, "
"IoC, stockage, journalisation) - AUCUNE édition manuelle de config/omega-"
"serve.json n'est plus nécessaire pour ces réglages."
msgstr ""
"Настраивает весь Active Defense (боевой режим, deception/приманки, IoC, "
"хранение, журналирование) - ручное редактирование config/omega-serve.json "
"для этих настроек больше НЕ нужно."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:73
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:346
#: src/omega_serv/interfaces/tui/guide/content/tls.py:306
msgid "Mode"
msgstr "Режим"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:74
msgid "Mode global d'Active Defense."
msgstr "Общий режим Active Defense."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:75
msgid "monitor (observe uniquement) ou enforce. Valeur par défaut : monitor."
msgstr ""
"monitor (только наблюдение) или enforce. Значение по умолчанию: monitor."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:76
msgid "Enregistre au clic sur Enregistrer, après validation."
msgstr "Сохраняет при нажатии Сохранить, после проверки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:77
msgid ""
"REDÉMARRAGE COMPLET toujours nécessaire - active_defense n'est jamais "
"rechargé à chaud."
msgstr ""
"Всегда нужен ПОЛНЫЙ ПЕРЕЗАПУСК - active_defense никогда не перезагружается "
"на лету."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:80
msgid "Mode guerre actif (war_mode.enabled)"
msgstr "Боевой режим включён (war_mode.enabled)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:81
msgid ""
"LE VRAI INTERRUPTEUR qui déclenche l'observation et les actions "
"automatiques."
msgstr ""
"НАСТОЯЩИЙ ПЕРЕКЛЮЧАТЕЛЬ, запускающий наблюдение и автоматические действия."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:82
msgid ""
"oui/non. Valeur par défaut : non - RIEN ne se déclenche tant qu'il reste à "
"'non'."
msgstr ""
"да/нет. Значение по умолчанию: нет - НИЧЕГО не срабатывает, пока стоит "
"'нет'."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:83
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:102
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:149
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:156
msgid "Enregistre avec le reste des réglages généraux."
msgstr "Сохраняет вместе с остальными общими настройками."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:84
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:96
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:103
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:127
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:143
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:150
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:157
msgid "REDÉMARRAGE COMPLET toujours nécessaire."
msgstr "Всегда нужен ПОЛНЫЙ ПЕРЕЗАПУСК."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:87
msgid ""
"Portée / Actions autorisées / Seuils / Ralentissement / Limite de requêtes"
msgstr "Область / Разрешённые действия / Пороги / Замедление / Лимит запросов"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:88
msgid ""
"Réglages fins du mode guerre : à qui s'appliquent les actions, lesquelles, à"
" quel score, et leurs paramètres."
msgstr ""
"Тонкая настройка боевого режима: к кому применяются действия, какие именно, "
"при каком балле и с какими параметрами."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:90
msgid ""
"Portée : source/instance. Actions : liste parmi observe, enrich_log, delay, "
"rate_limit, redirect_to_decoy, create_incident, export_ioc. Seuils : 4 "
"entiers croissants (suspect <= hostile <= incident, confine >= hostile). "
"Ralentissement et limite de requêtes : bornes en millisecondes/secondes."
msgstr ""
"Область: source/instance. Действия: список из observe, enrich_log, delay, "
"rate_limit, redirect_to_decoy, create_incident, export_ioc. Пороги: 4 "
"возрастающих целых (suspicious <= hostile <= incident, contained >= "
"hostile). Замедление и лимит запросов: границы в миллисекундах/секундах."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:95
msgid ""
"Valides par les mêmes règles que le domaine "
"(`validate_active_defense_config`) avant tout enregistrement."
msgstr ""
"Проверяются теми же правилами, что и домен "
"(`validate_active_defense_config`), перед любым сохранением."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:99
msgid ""
"Deception (actif, comportement par défaut, durée de vie d'une affectation)"
msgstr ""
"Deception (включено, поведение по умолчанию, срок действия назначения)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:100
msgid ""
"Active ou non le routage vers des leurres, et ce qui se passe si aucun "
"profil ne correspond à l'attaque."
msgstr ""
"Включает ли маршрутизацию на приманки и что происходит, если ни один профиль"
" не соответствует атаке."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:101
msgid ""
"actif : oui/non. Comportement : pass_through (laisse passer) ou reject."
msgstr "включено: да/нет. Поведение: pass_through (пропускает) или reject."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:106
msgid "Profils de leurre (table)"
msgstr "Профили приманок (таблица)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:107
msgid ""
"Associe une classe d'attaque à un niveau d'isolation - le premier profil "
"actif qui correspond est utilisé."
msgstr ""
"Сопоставляет класс атаки с уровнем изоляции - используется первый подходящий"
" активный профиль."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:109
msgid ""
"Nom : si Isolation = fixture, DOIT être exactement fake_admin, fake_cms, "
"fake_api ou fake_secrets (les 4 seules fixtures réellement implémentées) - "
"tout autre nom fait que le leurre ne se déclenche JAMAIS, sans aucune erreur"
" visible (bloqué désormais à l'enregistrement par "
"validate_active_defense_config). Libre si Isolation = proxy. Classes "
"d'attaque visées (séparées par virgules) : scan (sondage d'URLs/ports), "
"credential_stuffing (essais massifs de mots de passe), sqli (injection SQL),"
" xss (script injecté), path_traversal (ex : ../../etc/passwd), upload_probe "
"(upload de fichier suspect), api_probe (sondage d'endpoints /api/...), "
"unknown (tout le reste, filet de sécurité). Exemple concret : un profil "
"fake_admin avec scan,credential_stuffing intercepte les scanners et les "
"tentatives de bruteforce de login. Isolation : fixture (simulation interne, "
"rapide, sans risque) ou proxy (redirigé vers un vrai serveur isolé que vous "
"faites tourner, voir Zones de leurre ci-dessous). Zone de leurre associée : "
"requise si Isolation = proxy, doit correspondre à un nom de la table Zones "
"de leurre."
msgstr ""
"Имя: если Изоляция = fixture, ДОЛЖНО быть ровно fake_admin, fake_cms, "
"fake_api или fake_secrets (единственные 4 реально реализованные fixture) - "
"при любом другом имени приманка НИКОГДА не сработает, без видимой ошибки "
"(теперь блокируется при сохранении через validate_active_defense_config). "
"Свободно при Изоляция = proxy. Целевые классы атак (через запятую): scan "
"(зондирование URL/портов), credential_stuffing (массовый перебор паролей), "
"sqli (SQL-инъекция), xss (внедрённый скрипт), path_traversal (напр.: "
"../../etc/passwd), upload_probe (загрузка подозрительного файла), api_probe "
"(зондирование эндпоинтов /api/...), unknown (всё остальное, страховочная "
"сеть). Конкретный пример: профиль fake_admin с scan,credential_stuffing "
"перехватывает сканеры и попытки перебора входа. Изоляция: fixture "
"(внутренняя имитация, быстрая, без риска) или proxy (перенаправление на "
"настоящий изолированный сервер, который запускаете вы, см. Зоны приманок "
"ниже). Связанная зона приманки: обязательна при Изоляция = proxy, должна "
"совпадать с именем из таблицы Зоны приманок."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:126
msgid "Ajouter/Supprimer un profil."
msgstr "Добавить/Удалить профиль."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:130
msgid "Zones de leurre (table, Niveau 2)"
msgstr "Зоны приманок (таблица, Уровень 2)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:131
msgid ""
"Backends réellement isolés vers lesquels un profil 'proxy' peut rediriger - "
"jamais confondues avec les zones de reverse_proxy de production."
msgstr ""
"Реально изолированные бэкенды, на которые может перенаправлять профиль "
"'proxy' - никогда не смешиваются с рабочими зонами reverse_proxy."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:133
msgid ""
"Nom : un simple identifiant (pas une URL, pas un dossier) référence depuis "
"un profil de leurre en Isolation = proxy. Upstreams (host:port, séparés par "
"virgules) : adresse(s) d'un serveur DÉJÀ EN COURS D'EXÉCUTION que vous "
"contrôlez - rien n'est créé automatiquement ici, aucun dossier n'est généré,"
" et l'enregistrement n'exige PAS que la zone existe déjà ou réponde. Exemple"
" : 127.0.0.1:9001. Si au moment d'une vraie requête rien n'écoute à cette "
"adresse, l'attaquant reçoit simplement une erreur HTTP 502 Bad Gateway - "
"jamais de crash, jamais de création silencieuse."
msgstr ""
"Имя: простой идентификатор (не URL и не каталог), на который ссылается "
"профиль приманки с Изоляция = proxy. Upstream (host:port через запятую): "
"адрес(а) УЖЕ РАБОТАЮЩЕГО сервера, которым вы управляете - здесь ничего не "
"создаётся автоматически, никакой каталог не генерируется, и сохранение НЕ "
"требует, чтобы зона уже существовала или отвечала. Пример: 127.0.0.1:9001. "
"Если в момент настоящего запроса по этому адресу ничего не слушает, "
"атакующий просто получает ошибку HTTP 502 Bad Gateway - никогда не падение и"
" никогда не скрытое создание."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:146
msgid "IoC (export d'indicateurs de compromission)"
msgstr "IoC (экспорт индикаторов компрометации)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:147
msgid ""
"Contrôle l'export automatique d'indicateurs à la fermeture d'un incident."
msgstr ""
"Управляет автоматическим экспортом индикаторов при закрытии инцидента."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:148
msgid ""
"Formats : json, csv, markdown, stix (bundle STIX 2.1) et misp (événement "
"MISP à importer par son interface) - fichiers locaux, jamais envoyés. "
"Marquage TLP des exports STIX et MISP : amber par défaut (white, green, "
"amber, red). Politique de partage : local_only ou manual_export."
msgstr ""
"Форматы: json, csv, markdown, stix (пакет STIX 2.1) и misp (событие MISP для"
" импорта через его интерфейс) — локальные файлы, никогда не отправляются. "
"Метка TLP для экспорта STIX и MISP: по умолчанию amber (white, green, amber,"
" red). Политика обмена: local_only или manual_export."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:153
msgid "Stockage et journalisation"
msgstr "Хранение и журналирование"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:154
msgid ""
"Emplacement de la base de données, du répertoire d'export, et paramètres de "
"capture enrichie (corps de requête, champs masques)."
msgstr ""
"Расположение базы данных, каталога экспорта и параметры расширенного захвата"
" (тело запроса, маскируемые поля)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:155
msgid ""
"Chemins relatifs au projet ; capture du corps de requête désactivée par "
"défaut (données potentiellement sensibles)."
msgstr ""
"Пути относительно проекта; захват тела запроса по умолчанию отключён "
"(потенциально конфиденциальные данные)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:161
msgid ""
"TOUT changement ici exige un redémarrage complet, sans aucune exception - "
"active_defense n'est jamais rechargé à chaud, contrairement à la plupart des"
" autres options."
msgstr ""
"ЛЮБОЕ изменение здесь требует полного перезапуска, без исключений - "
"active_defense никогда не перезагружается на лету, в отличие от большинства "
"других параметров."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:166
msgid ""
"Sans activer 'war_mode.enabled' ICI, activer seulement l'option "
"'active_defense' (menu Options) ne sert à rien - voir la FAQ dédiée."
msgstr ""
"Без включения 'war_mode.enabled' ЗДЕСЬ одно лишь включение параметра "
"'active_defense' (меню Параметры) бесполезно - см. соответствующий FAQ."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:170
msgid ""
"Un profil de leurre en Isolation = fixture dont le nom n'est pas exactement "
"fake_admin, fake_cms, fake_api ou fake_secrets ne se déclenchera JAMAIS - "
"l'enregistrement le refuse désormais avec un message explicite."
msgstr ""
"Профиль приманки с Изоляция = fixture, имя которого не ровно fake_admin, "
"fake_cms, fake_api или fake_secrets, НИКОГДА не сработает - теперь "
"сохранение отклоняет его с явным сообщением."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:175
msgid ""
"Un profil refusé n'est pas enregistré : le formulaire se referme et la "
"raison s'affiche EN HAUT de cet écran - remontez pour la lire, puis "
"ressaisissez le profil (causes fréquentes : FAQ)."
msgstr ""
"Отклонённый профиль не сохраняется: форма закрывается, а причина "
"показывается ВВЕРХУ этого экрана - прокрутите вверх, чтобы её прочитать, "
"затем введите профиль заново (частые причины: FAQ)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:179
msgid ""
"Une zone de leurre n'est jamais créée automatiquement et son existence n'est"
" pas vérifiée à l'enregistrement - si rien n'écoute à l'adresse indiquée, "
"l'attaquant reçoit une erreur 502 au moment de la requête, pas avant."
msgstr ""
"Зона приманки никогда не создаётся автоматически, и её существование не "
"проверяется при сохранении - если по указанному адресу ничего не слушает, "
"атакующий получает ошибку 502 в момент запроса, не раньше."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:188
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:98
msgid "Active Defense - Menaces"
msgstr "Active Defense - Угрозы"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:189
msgid "Accueil -> Active Sécurité -> Menaces"
msgstr "Главная -> Активная безопасность -> Угрозы"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:190
msgid ""
"Liste toutes les sources actuellement suivies par Active Defense, avec leur "
"score et niveau de menace."
msgstr ""
"Показывает все источники, отслеживаемые сейчас Active Defense, с их баллом и"
" уровнем угрозы."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:193
msgid "Table des menaces"
msgstr "Таблица угроз"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:194
msgid ""
"Une ligne par source suivie (IP, score, niveau, dernière mise à jour, "
"expiration)."
msgstr ""
"Одна строка на отслеживаемый источник (IP, балл, уровень, последнее "
"обновление, истечение)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:195
msgid "Sélectionner une ligne affiche son détail complet."
msgstr "Выбор строки показывает полные сведения."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:196
msgid "Aucune action mutante sur cet écran."
msgstr "На этом экране нет изменяющих действий."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:200
msgid "Aucune modification possible depuis cet écran."
msgstr "С этого экрана ничего изменить нельзя."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:205
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:99
msgid "Active Defense - Incidents"
msgstr "Active Defense - Инциденты"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:206
msgid "Accueil -> Active Sécurité -> Incidents"
msgstr "Главная -> Активная безопасность -> Инциденты"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:207
msgid ""
"Liste les incidents de sécurité ouverts/fermes, permet de les fermer et "
"d'exporter des indicateurs de compromission (IoC)."
msgstr ""
"Показывает открытые/закрытые инциденты безопасности, позволяет закрывать их "
"и экспортировать индикаторы компрометации (IoC)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:210
msgid "Ouverts / Fermés / Tous"
msgstr "Открытые / Закрытые / Все"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:211
msgid "Filtre de la liste, avec le nombre d'incidents de chaque sorte."
msgstr "Фильтр списка с числом инцидентов каждого вида."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:212
msgid ""
"« Ouverts » est affiché par défaut ; un incident fermé quitte cette vue et "
"reste consultable et exportable dans « Fermés »."
msgstr ""
"По умолчанию показываются « Открытые »; закрытый инцидент уходит из этого "
"вида и остаётся доступным для просмотра и экспорта в « Закрытых »."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:214
msgid "Change seulement l'affichage."
msgstr "Меняет только отображение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:215
msgid ""
"Les incidents fermés depuis plus de 90 jours sont supprimés automatiquement,"
" avec leur historique (jamais un incident ouvert) ; les exports et rapports "
"déjà écrits restent."
msgstr ""
"Инциденты, закрытые более 90 дней назад, удаляются автоматически вместе с "
"историей (никогда открытый инцидент); уже записанные экспорты и отчёты "
"сохраняются."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:219
#: src/omega_serv/interfaces/tui/screens/incidents_screen.py:64
msgid "Purger maintenant"
msgstr "Очистить сейчас"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:220
msgid ""
"Fait tout de suite ce que le serveur fait seul régulièrement : ferme les "
"incidents dont la menace est effacée, supprime les incidents fermés depuis "
"plus de 90 jours et les états de menace expirés."
msgstr ""
"Сразу делает то, что сервер регулярно делает сам: закрывает инциденты, "
"угроза которых исчезла, удаляет инциденты, закрытые более 90 дней назад, и "
"истёкшие состояния угроз."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:223
msgid ""
"Bouton, avec confirmation ; même action que la commande « active-defense "
"purge »."
msgstr ""
"Кнопка с подтверждением; то же действие, что команда « active-defense purge "
"»."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:224
msgid "Un incident fermé quitte la vue « Ouverts » ; un bilan s'affiche."
msgstr "Закрытый инцидент уходит из вида « Открытые »; показывается итог."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:225
msgid ""
"L'export automatique à la fermeture (activé par défaut) s'applique aussi à "
"ces incidents."
msgstr ""
"Автоматический экспорт при закрытии (включён по умолчанию) применяется и к "
"этим инцидентам."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:228
#: src/omega_serv/interfaces/tui/screens/incidents_screen.py:69
msgid "Fermer l'incident"
msgstr "Закрыть инцидент"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:229
msgid "Marque un incident comme fermé."
msgstr "Помечает инцидент как закрытый."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:230
msgid "Sélectionner un incident, puis confirmer."
msgstr "Выберите инцидент, затем подтвердите."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:231
msgid "Ferme l'incident immédiatement."
msgstr "Немедленно закрывает инцидент."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:233
msgid ""
"Peut déclencher un export IoC/rapport AUTOMATIQUE si "
"ioc.auto_export_on_close est activé dans la configuration d'Active Defense."
msgstr ""
"Может запустить АВТОМАТИЧЕСКИЙ экспорт IoC/отчёта, если в конфигурации "
"Active Defense включён ioc.auto_export_on_close."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:238
#: src/omega_serv/interfaces/tui/screens/incidents_screen.py:71
msgid "Exporter IoC"
msgstr "Экспорт IoC"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:239
msgid "Exporte les indicateurs de compromission de l'incident sélectionné."
msgstr "Экспортирует индикаторы компрометации выбранного инцидента."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:240
msgid ""
"Format : json, csv, stix (bundle STIX 2.1) ou misp (événement MISP à "
"importer par son interface)."
msgstr ""
"Формат: json, csv, stix (пакет STIX 2.1) или misp (событие MISP для импорта "
"через его интерфейс)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:241
msgid "Écrit un fichier dans le répertoire d'export configuré."
msgstr "Записывает файл в настроенный каталог экспорта."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:242
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:249
msgid "Écriture réelle sur disque immédiate."
msgstr "Реальная немедленная запись на диск."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:245
#: src/omega_serv/interfaces/tui/screens/incidents_screen.py:73
msgid "Générer rapport"
msgstr "Создать отчёт"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:246
msgid "Génère un rapport Markdown complet de l'incident sélectionné."
msgstr "Создаёт полный отчёт Markdown по выбранному инциденту."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:248
msgid "Écrit un fichier Markdown dans le répertoire d'export configuré."
msgstr "Записывает файл Markdown в настроенный каталог экспорта."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:252
msgid ""
"Purement consultatif sauf fermeture d'incident (irréversible) et exports "
"(écriture disque)."
msgstr ""
"Только просмотр, кроме закрытия инцидента (необратимо) и экспорта (запись на"
" диск)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:257
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:100
msgid "Active Defense - Leurres"
msgstr "Active Defense - Приманки"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:258
msgid "Accueil -> Active Sécurité -> Deception"
msgstr "Главная -> Активная безопасность -> Deception"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:259
msgid ""
"Liste les affectations actives (et expirées non libérées) vers les leurres "
"de deception, permet de les libérer."
msgstr ""
"Показывает активные (и истёкшие, но не снятые) назначения на приманки "
"deception, позволяет их снимать."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:262
#: src/omega_serv/interfaces/tui/screens/deception_screen.py:41
msgid "Libérer"
msgstr "Снять"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:263
msgid "Retire l'affectation d'une source vers son leurre."
msgstr "Снимает назначение источника на его приманку."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:264
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:575
msgid "Sélectionner une ligne, puis confirmer."
msgstr "Выберите строку, затем подтвердите."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:265
msgid "Libère immédiatement l'affectation."
msgstr "Немедленно снимает назначение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:266
msgid ""
"Effet immédiat - la source n'est plus redirigée vers le leurre à la "
"prochaine requête."
msgstr ""
"Немедленный эффект - при следующем запросе источник больше не "
"перенаправляется на приманку."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:270
msgid ""
"Les affectations expirées mais jamais libérées restent visibles avec l'état "
"'expirée' - distinct d'une libération manuelle."
msgstr ""
"Истёкшие, но так и не снятые назначения остаются видимыми с состоянием "
"'истекло' - в отличие от ручного снятия."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:277
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:101
msgid "Active Defense - Simuler"
msgstr "Active Defense - Имитация"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:278
msgid "Accueil -> Active Sécurité -> Simuler"
msgstr "Главная -> Активная безопасность -> Имитация"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:279
msgid ""
"Simule une décision Active Defense (score, classe d'attaque) SANS aucun "
"effet réel - dry-run complet."
msgstr ""
"Имитирует решение Active Defense (балл, класс атаки) БЕЗ какого-либо "
"реального эффекта - полный пробный прогон."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:282
msgid "IP simulée"
msgstr "Имитируемый IP"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:283
msgid "Adresse IP source utilisée pour la simulation."
msgstr "Исходный IP-адрес, используемый для имитации."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:284
msgid "Une IP quelconque. Valeur par défaut : 203.0.113.42."
msgstr "Любой IP. Значение по умолчанию: 203.0.113.42."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:285
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:292
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:299
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:306
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:313
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:193
msgid "Utilisée au clic sur Simuler."
msgstr "Используется при нажатии Имитировать."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:286
msgid "Aucun effet réel - aucune écriture, aucun impact réseau."
msgstr "Никакого реального эффекта - ни записи, ни сетевого воздействия."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:289
msgid "Chemin simulé"
msgstr "Имитируемый путь"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:290
msgid "Chemin de la requête simulée."
msgstr "Путь имитируемого запроса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:291
msgid "Chaîne libre. Valeur par défaut : /wp-login.php."
msgstr "Произвольная строка. Значение по умолчанию: /wp-login.php."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:293
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:300
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:307
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:314
msgid "Aucun effet réel."
msgstr "Никакого реального эффекта."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:296
msgid "User-Agent"
msgstr "User-Agent"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:297
msgid ""
"User-Agent simulé (participe au calcul de l'identifiant de source simulé)."
msgstr ""
"Имитируемый User-Agent (участвует в вычислении имитируемого идентификатора "
"источника)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:298
msgid "Chaîne libre, optionnelle."
msgstr "Произвольная строка, необязательно."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:303
#: src/omega_serv/interfaces/tui/screens/riposte_simulate_screen.py:55
msgid "Classe d'attaque"
msgstr "Класс атаки"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:304
msgid "Type d'attaque simulé."
msgstr "Имитируемый тип атаки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:305
msgid "Doit être une classe connue (ex: scan). Valeur par défaut : scan."
msgstr ""
"Должен быть известным классом (напр.: scan). Значение по умолчанию: scan."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:310
#: src/omega_serv/interfaces/tui/screens/threats_screen.py:44
msgid "Score"
msgstr "Балл"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:311
msgid "Delta de score appliqué à la simulation."
msgstr "Изменение балла, применяемое при имитации."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:312
msgid "Entier. Valeur par défaut : 10."
msgstr "Целое. Значение по умолчанию: 10."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:317
msgid ""
"Aucune - dry-run complet, jamais d'écriture (aucun "
"repository.save()/create() appelé)."
msgstr ""
"Нет - полный пробный прогон, никогда не запись (не вызывается ни "
"repository.save(), ни create())."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:322
msgid "WAF - État"
msgstr "WAF - Состояние"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:323
msgid "Accueil -> Active Sécurité -> État (bloc WAF)"
msgstr "Главная -> Активная безопасность -> Состояние (блок WAF)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:325
msgid ""
"Vue d'ensemble en lecture seule : mode, comportement en cas d'erreur "
"interne, packs de règles référencés, taille de la blocklist. Avec le moteur "
"natif, aussi : combien de règles il évalue lui-même, s'il sert seul les "
"requêtes sans correspondance (sinon pourquoi), et le contrôle 1/N."
msgstr ""
"Обзор только для чтения: режим, поведение при внутренней ошибке, "
"подключённые пакеты правил, размер blocklist. С нативным движком также: "
"сколько правил он проверяет сам, обслуживает ли он сам запросы без "
"совпадений (если нет, то почему) и контроль 1/N."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:333
msgid ""
"Si aucun pack de règles n'est référence, le WAF ne peut RIEN détecter même "
"actif - l'écran l'indique explicitement, corrige un vrai trou signalé par "
"l'utilisateur."
msgstr ""
"Если ни один пакет правил не подключён, WAF не может обнаружить НИЧЕГО даже "
"во включённом состоянии - экран явно сообщает об этом, устраняя реальный "
"пробел, на который указал пользователь."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:341
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:87
msgid "WAF - Modules"
msgstr "WAF - Модули"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:342
msgid "Accueil -> Active Sécurité -> Modules (bloc WAF)"
msgstr "Главная -> Активная безопасность -> Модули (блок WAF)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:343
msgid ""
"Trois sections : mode/comportement d'erreur, gestion des packs de règles "
"actifs, gestion de la liste de blocage."
msgstr ""
"Три раздела: режим/поведение при ошибке, управление активными пакетами "
"правил, управление списком блокировки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:347
msgid "Comportement du WAF face à une requête jugée malveillante."
msgstr "Поведение WAF в отношении запроса, признанного вредоносным."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:348
msgid "log-only (journalise sans bloquer) ou block (bloque réellement)."
msgstr ""
"log-only (записывает в журнал без блокировки) или block (реально блокирует)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:350
msgid ""
"Rechargement AUTOMATIQUE déclenché des l'enregistrement si un service actif "
"existe."
msgstr ""
"АВТОМАТИЧЕСКАЯ перезагрузка сразу при сохранении, если есть активная служба."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:353
msgid "Comportement en cas d'erreur interne"
msgstr "Поведение при внутренней ошибке"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:354
msgid ""
"Que faire si le moteur WAF rencontre une erreur inattendue en analysant une "
"requête."
msgstr ""
"Что делать, если движок WAF столкнётся с непредвиденной ошибкой при анализе "
"запроса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:355
msgid "fail-open (laisse passer) ou fail-closed (bloque par prudence)."
msgstr ""
"fail-open (пропускает) или fail-closed (блокирует из предосторожности)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:356
#: src/omega_serv/interfaces/tui/guide/content/tls.py:319
msgid "Enregistre avec le mode."
msgstr "Сохраняет вместе с режимом."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:357
msgid "Rechargement automatique."
msgstr "Автоматическая перезагрузка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:360
msgid "Contrôle du moteur natif (native_check_every)"
msgstr "Контроль нативного движка (native_check_every)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:362
msgid ""
"Avec le moteur natif, une requête sur laquelle aucune règle ne correspond "
"est servie sans passer par Python. Ce réglage en soumet quand même une sur N"
" à Python, pour vérifier que les deux donnent le même verdict."
msgstr ""
"С нативным движком запрос, которому не соответствует ни одно правило, "
"обслуживается без участия Python. Этот параметр всё же передаёт Python один "
"такой запрос из N, чтобы проверить, что оба выносят одинаковый вердикт."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:367
msgid ""
"Entier de 0 à 1000000. 0 (par défaut) = jamais ; 1000 = une requête propre "
"sur mille, un coût négligeable. Sans effet avec le moteur Python."
msgstr ""
"Целое число от 0 до 1000000. 0 (по умолчанию) = никогда; 1000 = один чистый "
"запрос из тысячи, ничтожные затраты. Не действует с движком Python."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:370
msgid "Enregistre dans options.waf.native_check_every, avec le mode."
msgstr "Сохраняет в options.waf.native_check_every вместе с режимом."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:372
msgid ""
"Rechargement automatique. La requête contrôlée reçoit le verdict de Python ;"
" un désaccord est écrit dans le journal d'erreurs."
msgstr ""
"Автоматическая перезагрузка. Проверяемый запрос получает вердикт Python; "
"расхождение записывается в журнал ошибок."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:377
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:82
msgid "Packs de règles (rule_paths)"
msgstr "Пакеты правил (rule_paths)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:378
msgid ""
"Fichiers de règles réellement charges par le WAF - sans au moins un pack, "
"rien n'est détecté."
msgstr ""
"Файлы правил, реально загружаемые WAF - без хотя бы одного пакета ничего не "
"обнаруживается."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:379
msgid ""
"Ajouter ouvre un sélecteur des packs présents sous secure/waf/rules/ non "
"déjà référencés."
msgstr ""
"Добавить открывает выбор пакетов из secure/waf/rules/, ещё не подключённых."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:380
msgid "Ajoute/retire une référence de pack."
msgstr "Подключает/отключает пакет."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:381
msgid ""
"Rechargement automatique déclenché immédiatement (recompile les règles en "
"mémoire)."
msgstr ""
"Немедленная автоматическая перезагрузка (перекомпилирует правила в памяти)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:384
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:91
msgid "Liste de blocage"
msgstr "Список блокировки"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:386
msgid ""
"IP/reseaux bannis, avec motif et expiration optionnelle. Fichier par défaut "
": var/lib/waf/blocklist.json (sous var/, le seul dossier où le service "
"systemd peut écrire ses auto-bans). Un ancien secure/waf/blocklist.json est "
"repris une fois au démarrage et laissé en place comme sauvegarde."
msgstr ""
"Забаненные IP/сети с причиной и необязательным сроком. Файл по умолчанию: "
"var/lib/waf/blocklist.json (в var/ - единственном каталоге, куда служба "
"systemd может записывать свои автобаны). Старый secure/waf/blocklist.json "
"один раз подхватывается при запуске и остаётся на месте как резервная копия."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:391
msgid ""
"Réseau (CIDR), motif, durée en secondes (vide = permanent, confirmation "
"requise dans ce cas)."
msgstr ""
"Сеть (CIDR), причина, срок в секундах (пусто = постоянно, в этом случае "
"требуется подтверждение)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:392
msgid "Ajoute/retire une entrée."
msgstr "Добавляет/удаляет запись."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:394
msgid ""
"EFFET IMMÉDIAT, sans rechargement nécessaire - la blocklist est relue depuis"
" le disque à CHAQUE requête, jamais mise en cache en mémoire (contrairement "
"au mode et aux packs de règles)."
msgstr ""
"НЕМЕДЛЕННЫЙ ЭФФЕКТ, перезагрузка не нужна - blocklist перечитывается с диска"
" при КАЖДОМ запросе и никогда не кэшируется в памяти (в отличие от режима и "
"пакетов правил)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:401
msgid ""
"Mode/comportement d'erreur/packs de règles nécessitent un rechargement pour "
"s'appliquer (automatique si un service actif existe). La liste de blocage, "
"elle, s'applique instantanément sans aucune action supplémentaire."
msgstr ""
"Режим/поведение при ошибке/пакеты правил требуют перезагрузки для применения"
" (автоматически, если есть активная служба). Список блокировки же "
"применяется мгновенно, без каких-либо дополнительных действий."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:409
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:88
msgid "WAF - Limitations (exclusions et débit)"
msgstr "WAF - Ограничения (исключения и лимит частоты)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:410
msgid "Accueil -> Active Sécurité -> Limitations (bloc WAF)"
msgstr "Главная -> Активная безопасность -> Ограничения (блок WAF)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:412
msgid ""
"Règle la limite de débit (rate limit) du WAF natif : la limite globale, des "
"règles par dossier et des règles par IP/réseau, ainsi que les exclusions "
"d'inspection. Sert surtout aux pages lourdes (une galerie d'images, par "
"exemple) qui dépassent la limite globale et reçoivent une erreur 429."
msgstr ""
"Настраивает лимит запросов (rate limit) встроенного WAF: глобальный лимит, "
"правила для папок и правила для IP/сетей, а также исключения из проверки. "
"Нужен прежде всего для тяжёлых страниц (например, галереи изображений), "
"которые превышают глобальный лимит и получают ошибку 429."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:419
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:83
msgid "Limite globale"
msgstr "Глобальный лимит"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:420
msgid ""
"Nombre de requêtes autorisées par IP et par fenêtre, pour tout ce qui n'a "
"pas de règle spécifique."
msgstr ""
"Число запросов, разрешённых с одного IP за окно, для всего, у чего нет "
"своего правила."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:421
msgid "Rate limit actif (oui/non), nombre de requêtes, fenêtre en secondes."
msgstr "Rate limit включён (да/нет), число запросов, окно в секундах."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:423
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:868
msgid "Rechargement automatique déclenché si un service actif existe."
msgstr "Автоматическая перезагрузка, если есть активная служба."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:426
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:93
msgid "Règles par dossier"
msgstr "Правила для папок"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:428
msgid ""
"Une règle REMPLACE la limite globale pour ce dossier et a son propre "
"compteur : les requêtes sur ce dossier ne consomment plus la limite globale."
" 0 = illimité. Si plusieurs dossiers correspondent, le plus long gagne. "
"/images couvre /images/a.png mais jamais /images2."
msgstr ""
"Правило ЗАМЕНЯЕТ глобальный лимит для этой папки и имеет свой счётчик: "
"запросы к этой папке больше не расходуют глобальный лимит. 0 = без "
"ограничений. Если подходят несколько папок, побеждает самая длинная. /images"
" покрывает /images/a.png, но никогда /images2."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:433
msgid ""
"Ajouter / Modifier : dossier, requêtes par fenêtre, fenêtre en secondes. "
"Sélectionner une ligne pour la modifier ou la retirer."
msgstr ""
"Добавить / Изменить: папка, запросы за окно, окно в секундах. Выберите "
"строку, чтобы изменить или убрать её."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:434
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:452
msgid "Enregistré dès la validation du formulaire."
msgstr "Сохраняется сразу после подтверждения формы."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:436
msgid ""
"Rechargement automatique. Une IP publique qui dépasse une règle de dossier "
"est toujours journalisée comme un blocage, donc bannissable par omega-jail."
msgstr ""
"Автоматическая перезагрузка. Публичный IP, превысивший правило папки, по-"
"прежнему записывается как блокировка, поэтому omega-jail может забанить его."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:441
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:108
msgid "Règles par IP / réseau"
msgstr "Правила для IP / сетей"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:443
msgid ""
"Même principe pour une IP ou un réseau (ex. le réseau Tailscale "
"100.64.0.0/10). Une règle de dossier passe avant une règle IP/réseau ; entre"
" deux réseaux, le plus précis gagne."
msgstr ""
"Тот же принцип для IP или сети (например, сеть Tailscale 100.64.0.0/10). "
"Правило папки идёт раньше правила IP/сети; из двух сетей побеждает более "
"точная."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:448
msgid ""
"IP ou réseau (CIDR), requêtes, fenêtre, Source sûre (oui/non). Une source "
"sûre qui dépasse la limite reçoit toujours le 429, mais la ligne est "
"journalisée « throttle » : jamais bannissable."
msgstr ""
"IP или сеть (CIDR), запросы, окно, Надёжный источник (да/нет). Надёжный "
"источник, превысивший лимит, всё равно получает 429, но строка записывается "
"как « throttle »: бан невозможен."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:454
msgid ""
"Les réseaux never_auto_block (affichés au-dessus du tableau) sont toujours "
"sûrs d'office. Sans proxy de confiance actif, une règle couvrant "
"127.0.0.1/::1 est ignorée."
msgstr ""
"Сети never_auto_block (показаны над таблицей) всегда надёжны по умолчанию. "
"Без активного доверенного прокси правило, охватывающее 127.0.0.1/::1, "
"игнорируется."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:460
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:119
msgid "Exclusions d'inspection"
msgstr "Исключения из проверки"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:461
msgid ""
"Dossiers et extensions jamais inspectés par le WAF natif ni par magnet, et "
"dossiers dont seul le corps n'est pas inspecté."
msgstr ""
"Папки и расширения, которые никогда не проверяются ни встроенным WAF, ни "
"magnet, и папки, у которых не проверяется только тело запроса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:462
msgid "Valeurs séparées par des virgules ; un dossier commence par « / »."
msgstr "Значения через запятую; папка начинается с « / »."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:464
msgid ""
"Le rate limit s'applique toujours à ces chemins : une exclusion ne règle "
"jamais un 429."
msgstr ""
"Rate limit по-прежнему действует на этих путях: исключение никогда не "
"устраняет 429."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:467
msgid ""
"Une règle de débit ne désactive jamais l'inspection : une attaque sur un "
"dossier à débit élevé reste détectée et bloquée."
msgstr ""
"Правило лимита никогда не отключает проверку: атака на папку с высоким "
"лимитом по-прежнему обнаруживается и блокируется."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:470
msgid ""
"Un dossier en illimité (0) ne protège plus contre un robot qui le martèle "
"depuis une IP publique : préférer une valeur haute (ex. 600 / 60 s) à "
"l'illimité."
msgstr ""
"Папка без ограничений (0) больше не защищает от бота, который долбит её с "
"публичного IP: лучше высокое значение (например, 600 / 60 с), чем без "
"ограничений."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:474
msgid ""
"Sans rapport avec « Requêtes max par connexion keep-alive » (Configuration "
"détaillée -> Résistance et limites) : ce réglage ferme seulement une "
"connexion après N requêtes, le navigateur en rouvre une aussitôt. Il ne "
"renvoie jamais 429 et ne compte rien par IP : c'est la limite de débit, ici,"
" qui produit le 429."
msgstr ""
"Не связано с « Макс. запросов на keep-alive соединение » (Подробная "
"настройка -> Устойчивость и лимиты): этот параметр лишь закрывает соединение"
" после N запросов, и браузер сразу открывает новое. Он никогда не возвращает"
" 429 и ничего не считает по IP: здесь 429 выдаёт именно лимит запросов."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:480
msgid ""
"Script magnet : son propre rate limit (429) ne compte jamais comme une "
"détection, donc ne mène jamais à l'auto-ban. Sur une requête couverte par "
"une règle de dossier ou d'IP/réseau ci-dessus, c'est cette règle qui fait "
"foi : le 429 de magnet est ignoré (ses signatures d'attaque restent "
"appliquées)."
msgstr ""
"Скрипт magnet: его собственный rate limit (429) никогда не считается "
"обнаружением и поэтому никогда не ведёт к автобану. Для запроса, "
"подпадающего под правило папки или IP/сети выше, действует это правило: 429 "
"от magnet игнорируется (его сигнатуры атак продолжают применяться)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:490
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:89
msgid "WAF - Tester une requête"
msgstr "WAF - Проверка запроса"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:491
msgid "Accueil -> Active Sécurité -> Tester (bloc WAF)"
msgstr "Главная -> Активная безопасность -> Тест (блок WAF)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:492
msgid ""
"Teste une requête simulée contre les règles WAF ACTUELLEMENT ENREGISTRÉES "
"(pas nécessairement celles réellement chargées par un serveur déjà lancé), "
"sans requête réseau."
msgstr ""
"Проверяет имитируемый запрос по ТЕКУЩИМ СОХРАНЁННЫМ правилам WAF (не "
"обязательно тем, что реально загружены уже запущенным сервером), без "
"сетевого запроса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:495
msgid "Méthode / Chemin / Query / Body / IP distante"
msgstr "Метод / Путь / Query / Body / Удалённый IP"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:496
msgid "Composants de la requête HTTP simulée."
msgstr "Составные части имитируемого HTTP-запроса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:497
msgid "Valeurs libres - méthode et chemin pré-remplis (GET, /)."
msgstr "Произвольные значения - метод и путь заполнены заранее (GET, /)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:498
msgid "Utilisés au clic sur Tester."
msgstr "Используются при нажатии Тест."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:499
msgid "Aucun effet réel, aucune requête réseau."
msgstr "Никакого реального эффекта, никакого сетевого запроса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:505
msgid ""
"Reconstruit le moteur WAF à partir de la configuration SAUVEGARDÉE sur "
"disque à chaque test - si un serveur déjà lancé n'a pas encore été rechargé "
"après un changement de règles, ce test peut refléter un comportement "
"différent de ce que ce serveur applique réellement pour l'instant."
msgstr ""
"При каждой проверке пересобирает движок WAF из конфигурации, СОХРАНЁННОЙ на "
"диске - если уже запущенный сервер ещё не перезагружен после изменения "
"правил, эта проверка может показать поведение, отличное от того, что этот "
"сервер реально применяет сейчас."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:515
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:90
msgid "WAF - Règles et listes personnalisées"
msgstr "WAF - Свои правила и списки"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:516
msgid "Accueil -> Active Sécurité -> Custom (bloc WAF)"
msgstr "Главная -> Активная безопасность -> Custom (блок WAF)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:518
msgid ""
"Un seul tableau pour les RÈGLES (écrites dans secure/waf/rules/custom.json, "
"pack référence automatiquement) et les LISTES (fichiers texte de "
"secure/waf/rules/keywords/, chargées explicitement par l'assistant). La "
"colonne Type fait la différence : une liste n'est pas une règle de "
"custom.json."
msgstr ""
"Одна таблица для ПРАВИЛ (записываются в secure/waf/rules/custom.json, пакет "
"подключается автоматически) и СПИСКОВ (текстовые файлы в "
"secure/waf/rules/keywords/, загружаемые явно через мастер). Различие "
"показывает столбец Тип: список не является правилом из custom.json."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:526
msgid ""
"Ouvre l'assistant : une règle simple, ou CHARGER une liste (voir sa fiche)."
msgstr ""
"Открывает мастер: простое правило или ЗАГРУЗКА списка (см. его карточку)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:527
msgid "Clic, puis suivre l'assistant."
msgstr "Щелчок, затем следуйте мастеру."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:528
msgid ""
"Règle : écrite dans custom.json. Liste : ajoutée à "
"options.waf.rules.keyword_lists."
msgstr ""
"Правило: записывается в custom.json. Список: добавляется в "
"options.waf.rules.keyword_lists."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:529
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:713
msgid ""
"Rechargement automatique déclenché immédiatement si un service actif existe."
msgstr "Немедленная автоматическая перезагрузка, если есть активная служба."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:532
msgid "Colonne Détail (listes)"
msgstr "Столбец Подробно (списки)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:533
msgid "Nombre d'entrées du fichier, ou un avertissement."
msgstr "Число записей файла или предупреждение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:535
msgid ""
"'fichier absent', 'illisible par le service' ou 'emplacement refusé' : la "
"liste n'est pas chargeable telle quelle - ouvrez-la avec Éditer la liste."
msgstr ""
"'файл отсутствует', 'не читается службой' или 'расположение отклонено': "
"список нельзя загрузить как есть - откройте его через Редактировать список."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:538
msgid "Recalculé à chaque affichage du tableau."
msgstr "Пересчитывается при каждом отображении таблицы."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:539
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:546
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:617
msgid "Aucun effet en lui-même."
msgstr "Сам по себе без эффекта."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:542
msgid "Colonne Gravité (listes)"
msgstr "Столбец Серьёзность (списки)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:543
msgid ""
"Observation, Faible, Moyen, Élevé ou Critique, suivie de la récidive propre "
"à la liste."
msgstr ""
"Наблюдение, Низкая, Средняя, Высокая или Критическая, затем собственный учёт"
" повторных нарушений списка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:544
msgid "Ex. 'Élevé, 2 en 10 min -> ban 24 h'."
msgstr "Напр. 'Высокая, 2 за 10 мин -> бан 24 ч'."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:545
msgid "Se change avec Modifier."
msgstr "Меняется кнопкой Изменить."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:549
msgid "Modifier (listes)"
msgstr "Изменить (списки)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:550
msgid ""
"Change gravité, récidive, zone de recherche et nom affiché d'une liste déjà "
"chargée."
msgstr ""
"Меняет серьёзность, учёт повторных нарушений, зону поиска и отображаемое имя"
" уже загруженного списка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:551
msgid "Sélectionner une ligne Liste, puis Modifier."
msgstr "Выберите строку Список, затем Изменить."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:553
msgid ""
"Vérifie la nouvelle configuration comme au chargement : rendre bloquante une"
" liste qui toucherait une route du site est refusé avec la raison."
msgstr ""
"Проверяет новую конфигурацию как при загрузке: сделать блокирующим список, "
"который задел бы маршрут сайта, не получится - с указанием причины."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:556
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:570
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:577
msgid "Rechargement automatique déclenché immédiatement."
msgstr "Немедленная автоматическая перезагрузка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:559
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:89
msgid "Éditer la liste"
msgstr "Редактировать список"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:560
msgid "Ouvre l'éditeur intégré sur le fichier de la liste (voir sa fiche)."
msgstr "Открывает файл списка во встроенном редакторе (см. его карточку)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:561
msgid "Sélectionner une ligne Liste, puis Éditer la liste."
msgstr "Выберите строку Список, затем Редактировать список."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:562
msgid "Aucune écriture tant que l'éditeur n'a pas enregistré."
msgstr "Ничего не записывается, пока редактор не сохранил."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:563
msgid "Le tableau est rafraîchi à la fermeture de l'éditeur."
msgstr "Таблица обновляется при закрытии редактора."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:566
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:91
msgid "Activer/Desactiver"
msgstr "Включить/Отключить"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:567
msgid "Bascule une règle ou une liste sans la supprimer."
msgstr "Включает или отключает правило или список, не удаляя его."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:568
msgid "Sélectionner une ligne, puis cliquer."
msgstr "Выберите строку, затем нажмите."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:569
msgid ""
"Règle : champ enabled de custom.json. Liste : champ enabled de "
"keyword_lists."
msgstr ""
"Правило: поле enabled в custom.json. Список: поле enabled в keyword_lists."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:573
msgid "Supprimer / Retirer"
msgstr "Удалить / Убрать"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:574
msgid "Supprimer une règle, ou Retirer une liste du WAF."
msgstr "Удалить правило или Убрать список из WAF."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:576
msgid ""
"Règle : retirée de custom.json. Liste : retirée de la configuration, FICHIER"
" CONSERVÉ."
msgstr ""
"Правило: удаляется из custom.json. Список: убирается из конфигурации, ФАЙЛ "
"СОХРАНЯЕТСЯ."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:581
msgid ""
"Une règle ou une liste refusée par la validation est refusée ICI de la même "
"façon qu'elle le serait au chargement réel - jamais une double logique de "
"validation divergente."
msgstr ""
"Правило или список, отклонённые проверкой, отклоняются ЗДЕСЬ так же, как при"
" реальной загрузке - никогда две расходящиеся логики проверки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:586
msgid ""
"Piège déjà rencontré par un utilisateur : ajouter le PACK via 'Modules' "
"n'est pas la même chose que créer une RÈGLE ici - cet écran fait désormais "
"les deux à la fois automatiquement."
msgstr ""
"Ловушка, на которую уже попадал пользователь: подключение ПАКЕТА через "
"'Модули' - не то же самое, что создание ПРАВИЛА здесь - этот экран теперь "
"делает и то и другое автоматически."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:591
msgid ""
"Retirer une liste ne supprime jamais son fichier : il reste proposé par "
"l'assistant, prêt à être rechargé."
msgstr ""
"Удаление списка из WAF никогда не удаляет его файл: мастер продолжает "
"предлагать его, готовым к повторной загрузке."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:599
msgid "WAF - Assistant règle personnalisée / chargement de liste"
msgstr "WAF - Мастер своего правила / загрузки списка"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:600
msgid "WAF - Règles et listes personnalisées -> Ajouter"
msgstr "WAF - Свои правила и списки -> Добавить"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:602
msgid ""
"Questionnaire en langage clair pour construire une règle WAF sans connaître "
"les expressions régulières (4 scénarios courants + mode Avance), OU pour "
"CHARGER une liste de chemins / de mots-clés depuis un fichier texte. Le "
"chargement d'une liste est une action explicite : rien n'est actif avant le "
"clic sur Charger."
msgstr ""
"Вопросы простым языком, чтобы составить правило WAF без знания регулярных "
"выражений (4 частых сценария + режим Расширенный), ИЛИ чтобы ЗАГРУЗИТЬ "
"список путей / ключевых слов из текстового файла. Загрузка списка - явное "
"действие: до нажатия Загрузить ничего не активно."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:609
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:140
msgid "Que voulez-vous détecter ?"
msgstr "Что вы хотите обнаруживать?"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:610
msgid "Choisit le scénario de détection."
msgstr "Выбирает сценарий обнаружения."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:612
msgid ""
"Un chemin précis visite, un mot-clé dans l'adresse/parametres, un mot-clé "
"envoyé en formulaire (POST), un outil de scan connu (User-Agent), Avance "
"(regex/portee libres), CHARGER une liste de chemins, CHARGER une liste de "
"mots-clés."
msgstr ""
"Конкретный посещаемый путь, ключевое слово в адресе/параметрах, ключевое "
"слово в отправленной форме (POST), известный инструмент сканирования (User-"
"Agent), Расширенный (свободные regex/область), ЗАГРУЗИТЬ список путей, "
"ЗАГРУЗИТЬ список ключевых слов."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:616
msgid "Change les champs affiches en dessous et leur indice."
msgstr "Меняет поля ниже и подсказку к ним."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:620
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:144
msgid "Valeur à détecter (mode simple)"
msgstr "Обнаруживаемое значение (простой режим)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:621
msgid "Le texte à repérer, saisi en clair (jamais une regex à écrire)."
msgstr ""
"Искомый текст, введённый как есть (никогда не regex, который нужно писать)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:622
msgid "Un mot ou un chemin, selon le scénario choisi ci-dessus."
msgstr "Слово или путь, в зависимости от выбранного выше сценария."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:623
msgid ""
"La regex réelle est CONSTRUITE automatiquement par le code (caractères "
"spéciaux jamais interprétés)."
msgstr ""
"Настоящий regex СТРОИТСЯ кодом автоматически (специальные символы никогда не"
" интерпретируются)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:624
msgid ""
"Aucun effet avant validation sur l'écran précédent (WafCustomRuleScreen)."
msgstr ""
"Без эффекта до подтверждения на предыдущем экране (WafCustomRuleScreen)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:627
msgid "Portée / Motif (mode Avance)"
msgstr "Область / Шаблон (режим Расширенный)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:628
msgid "Portée et expression régulière écrites directement."
msgstr "Область и регулярное выражение, введённые напрямую."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:629
msgid ""
"Portée : path, query, body, headers, user_agent, referer (séparés par des "
"virgules)."
msgstr ""
"Область: path, query, body, headers, user_agent, referer (через запятую)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:630
msgid "Utilisé tel quel si Avance est choisi."
msgstr "Используется как есть, если выбран Расширенный."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:631
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:638
msgid "Aucun effet avant validation sur l'écran précédent."
msgstr "Без эффекта до подтверждения на предыдущем экране."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:634
msgid "Gravité (règle)"
msgstr "Серьёзность (правило)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:635
msgid "Poids de la règle dans le calcul du score de menace."
msgstr "Вес правила при вычислении балла угрозы."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:636
msgid "Faible/Moyen/Eleve/Critique (1/3/6/9)."
msgstr "Низкая/Средняя/Высокая/Критическая (1/3/6/9)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:637
msgid "Inclus dans la règle produite."
msgstr "Входит в создаваемое правило."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:641
msgid "Fichier de liste (CHARGER)"
msgstr "Файл списка (ЗАГРУЗИТЬ)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:642
msgid "Le fichier texte qui contient la liste."
msgstr "Текстовый файл, содержащий список."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:644
msgid ""
"Vos fichiers .txt de secure/waf/rules/keywords/ (avec leur nombre "
"d'entrées), les références livrées avec omega-serv (sensitive-paths-hostile,"
" sensitive-paths-probe) pas encore copiées, ou 'Nouveau fichier...' (nom en "
"lettres, chiffres et '-')."
msgstr ""
"Ваши файлы .txt в secure/waf/rules/keywords/ (с числом записей), "
"поставляемые с omega-serv эталоны (sensitive-paths-hostile, sensitive-paths-"
"probe), ещё не скопированные, или 'Новый файл...' (имя из букв, цифр и '-')."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:649
msgid ""
"Une référence est COPIÉE dans keywords/ au chargement : c'est cette copie "
"locale que vous modifiez, une mise à jour d'omega-serv ne l'écrase jamais. "
"Choisir une référence pré-remplit tous les réglages conseillés."
msgstr ""
"При загрузке эталон КОПИРУЕТСЯ в keywords/: вы изменяете эту локальную "
"копию, обновление omega-serv её никогда не перезаписывает. Выбор эталона "
"заполняет все рекомендуемые настройки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:653
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:663
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:670
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:681
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:694
msgid "Aucun effet avant Charger."
msgstr "Без эффекта до Загрузить."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:656
msgid "Où chercher (liste de chemins)"
msgstr "Где искать (список путей)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:657
msgid "N'importe où dans l'adresse, ou seulement au début."
msgstr "В любом месте адреса или только в начале."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:659
msgid ""
"Partout attrape /blog/.env ; au début seulement est plus prudent pour des "
"chemins qu'un vrai site peut servir (/api, /admin)."
msgstr ""
"В любом месте ловит /blog/.env; только в начале - осторожнее для путей, "
"которые может отдавать настоящий сайт (/api, /admin)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:662
msgid "Champ anchor de la liste (any_segment / root)."
msgstr "Поле anchor списка (any_segment / root)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:666
msgid "Dans quelle partie de la requête (liste de mots-clés)"
msgstr "В какой части запроса (список ключевых слов)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:667
msgid "Où chercher les mots-clés."
msgstr "Где искать ключевые слова."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:668
msgid ""
"L'adresse et ses paramètres, un formulaire envoyé (POST), le User-Agent, ou "
"le Referer."
msgstr ""
"Адрес и его параметры, отправленная форма (POST), User-Agent или Referer."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:669
msgid "Champ scope de la liste."
msgstr "Поле scope списка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:673
msgid "Gravité (liste)"
msgstr "Серьёзность (список)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:674
msgid "Observation, Faible (1), Moyen (3), Élevé (6), Critique (9)."
msgstr "Наблюдение, Низкая (1), Средняя (3), Высокая (6), Критическая (9)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:676
msgid ""
"Observation (conseillé au premier chargement) : alertes journalisées, AUCUN "
"blocage, aucune récidive. Élevé (6) atteint le seuil de blocage : 403 dès le"
" premier accès. Moyen (3) ne bloque jamais seul."
msgstr ""
"Наблюдение (рекомендуется при первой загрузке): оповещения записываются в "
"журнал, НИКАКИХ блокировок и учёта повторных нарушений. Высокая (6) "
"достигает порога блокировки: 403 с первого обращения. Средняя (3) никогда не"
" блокирует сама по себе."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:680
msgid "Champs weight et observe_only de la liste."
msgstr "Поля weight и observe_only списка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:684
msgid "Récidive"
msgstr "Повторные нарушения"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:685
msgid ""
"Bannir après N accès à CETTE liste en M minutes, pendant une durée choisie."
msgstr ""
"Банить после N обращений к ЭТОМУ списку за M минут, на выбранный срок."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:687
msgid ""
"'pas de récidive propre' = compteur commun du WAF. Références : hostile 2 "
"accès en 10 min -> 24 h, sondage 5 en 10 min -> 1 h. Grise en Observation."
msgstr ""
"'без собственного учёта' = общий счётчик WAF. Эталоны: hostile 2 обращения "
"за 10 мин -> 24 ч, зондирование 5 за 10 мин -> 1 ч. Неактивно в режиме "
"Наблюдение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:691
msgid ""
"Ban applicatif temporaire (blocklist, réponse 451), jamais pour l'hôte local"
" (derrière un proxy de confiance), Tailscale ou le réseau local."
msgstr ""
"Временный бан на уровне приложения (blocklist, ответ 451), никогда для "
"локального хоста (за доверенным прокси), Tailscale или локальной сети."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:697
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:170
msgid "Ouvrir l'éditeur"
msgstr "Открыть редактор"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:698
msgid ""
"Ouvre le fichier choisi dans l'éditeur intégré (ou la référence si pas "
"encore copiée)."
msgstr ""
"Открывает выбранный файл во встроенном редакторе (или эталон, если он ещё не"
" скопирован)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:699
msgid "Pour vérifier ou adapter la liste AVANT de la charger."
msgstr "Чтобы проверить или адаптировать список ДО загрузки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:700
msgid "Rien n'est chargé dans le WAF depuis l'éditeur."
msgstr "Из редактора в WAF ничего не загружается."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:701
msgid "Les nombres d'entrées sont rafraîchis à la fermeture."
msgstr "Число записей обновляется при закрытии."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:704
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:270
msgid "Charger"
msgstr "Загрузить"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:705
msgid "Charge la liste dans le WAF."
msgstr "Загружает список в WAF."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:706
msgid "Dernier clic de l'assistant."
msgstr "Последний щелчок мастера."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:708
msgid ""
"Vérifie, dans l'ordre : nom de fichier, syntaxe (numéro de ligne en cas "
"d'erreur), lisibilité par le compte du service, absence de doublon, conflits"
" avec les routes du site. Si une seule vérification échoue, la configuration"
" n'est PAS modifiée. Active ensuite la réputation et l'auto-ban s'ils "
"étaient éteints (avec un message)."
msgstr ""
"Проверяет по порядку: имя файла, синтаксис (номер строки при ошибке), "
"читаемость учётной записью службы, отсутствие дубликата, конфликты с "
"маршрутами сайта. Если хоть одна проверка не пройдена, конфигурация НЕ "
"изменяется. Затем включает репутацию и автобан, если они были выключены (с "
"сообщением)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:717
msgid ""
"Règle : ne fait qu'assembler les valeurs, l'écriture a lieu sur l'écran WAF "
"- Règles et listes personnalisées. Liste : rien n'est actif tant que Charger"
" n'a pas réussi."
msgstr ""
"Правило: только собирает значения, запись происходит на экране WAF - Свои "
"правила и списки. Список: ничего не активно, пока Загрузить не выполнено "
"успешно."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:722
msgid ""
"Une liste qui bloque seule (gravité >= 5) et qui toucherait une route "
"réellement servie (alias, reverse proxy, zone Auth, fichier du webroot) est "
"refusée : ajoutez une exception '!/chemin' dans la liste, ou chargez-la en "
"Observation."
msgstr ""
"Список, блокирующий сам по себе (серьёзность >= 5) и задевающий реально "
"отдаваемый маршрут (псевдоним, обратный прокси, зона Auth, файл webroot), "
"отклоняется: добавьте в список исключение '!/путь' или загрузите его в "
"режиме Наблюдение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:731
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:92
msgid "WAF - Éditeur de liste"
msgstr "WAF - Редактор списка"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:732
msgid ""
"WAF - Règles et listes personnalisées -> Éditer la liste (ou Assistant -> "
"Ouvrir l'éditeur)"
msgstr ""
"WAF - Свои правила и списки -> Редактировать список (или Мастер -> Открыть "
"редактор)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:734
msgid ""
"Éditeur de texte intégré, sans éditeur externe, pour une liste de chemins ou"
" de mots-clés. Tout se fait à la SOURIS : aucun raccourci clavier, le "
"clavier ne sert qu'à la saisie (caractères, Entrée, flèches, Debut/Fin, Page"
" prec./suiv., Retour arrière, Suppr)."
msgstr ""
"Встроенный текстовый редактор, без внешнего редактора, для списка путей или "
"ключевых слов. Всё делается МЫШЬЮ: никаких сочетаний клавиш, клавиатура "
"служит только для ввода (символы, Enter, стрелки, Home/End, Page Up/Down, "
"Backspace, Delete)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:740
msgid "Syntaxe d'une liste de chemins"
msgstr "Синтаксис списка путей"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:741
msgid "Une entrée par ligne, '#' = commentaire."
msgstr "Одна запись на строку, '#' = комментарий."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:743
msgid ""
"/admin -> /admin et /admin/xxx (jamais /administrator) ; /.git/ -> tout ce "
"qui est sous /.git/ ; /*.bak -> fichiers finissant par .bak ; !/api/v1 -> "
"exception, toujours prioritaire sur les entrées, quel que soit l'ordre des "
"lignes."
msgstr ""
"/admin -> /admin и /admin/xxx (никогда /administrator); /.git/ -> всё, что "
"под /.git/; /*.bak -> файлы, оканчивающиеся на .bak; !/api/v1 -> исключение,"
" всегда приоритетнее записей, независимо от порядка строк."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:747
msgid ""
"Analysée en direct (compteur d'entrées, d'exceptions, d'erreurs et "
"d'avertissements)."
msgstr ""
"Анализируется в реальном времени (счётчик записей, исключений, ошибок и "
"предупреждений)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:748
msgid ""
"Les erreurs s'affichent avec leur numéro de ligne ; cliquer une erreur place"
" le curseur dessus."
msgstr ""
"Ошибки показываются с номером строки; щелчок по ошибке ставит на неё курсор."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:751
msgid "Barre d'outils"
msgstr "Панель инструментов"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:752
msgid ""
"Annuler la modif, Rétablir, Couper, Copier, Coller, Sélectionner la ligne, "
"Tout sélectionner, Supprimer la ligne."
msgstr ""
"Отменить, Повторить, Вырезать, Копировать, Вставить, Выделить строку, "
"Выделить всё, Удалить строку."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:753
msgid ""
"Clic. Le collage du terminal (clic du milieu, menu du terminal) fonctionne "
"aussi."
msgstr ""
"Щелчок. Вставка из терминала (средняя кнопка мыши, меню терминала) тоже "
"работает."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:754
msgid "Modifie le texte affiché, jamais le fichier."
msgstr "Изменяет отображаемый текст, никогда не файл."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:755
msgid "Toujours annulable."
msgstr "Всегда можно отменить."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:758
#: src/omega_serv/interfaces/tui/screens/text_file_editor_screen.py:148
msgid "Rechercher"
msgstr "Поиск"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:759
msgid "Trouve un texte dans la liste (casse ignorée)."
msgstr "Находит текст в списке (без учёта регистра)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:760
msgid "Taper le texte, puis Précédent / Suivant."
msgstr "Введите текст, затем Назад / Далее."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:761
msgid "Sélectionne l'occurrence trouvée."
msgstr "Выделяет найденное вхождение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:762
msgid "Recommence au début après la dernière occurrence."
msgstr "После последнего вхождения начинает сначала."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:765
msgid "Tester (liste de chemins)"
msgstr "Тест (список путей)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:766
msgid "Indique ce que ferait la liste EN COURS d'édition d'un chemin donné."
msgstr "Показывает, что сделал бы РЕДАКТИРУЕМЫЙ список с заданным путём."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:767
msgid "Taper un chemin (ex. /blog/.env), puis Tester."
msgstr "Введите путь (напр. /blog/.env), затем Тест."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:768
msgid "Même normalisation que le WAF (paramètres retirés, décodage URL)."
msgstr ""
"Та же нормализация, что и в WAF (параметры отброшены, URL-декодирование)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:769
msgid ""
"'DÉTECTÉ par la ligne N', 'AUTORISÉ : exception ligne N', ou 'aucune ligne "
"ne correspond'."
msgstr ""
"'ОБНАРУЖЕНО строкой N', 'РАЗРЕШЕНО: исключение в строке N' или 'ни одна "
"строка не совпадает'."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:772
msgid "Vérifier contre mes logs (liste de chemins)"
msgstr "Сверить с журналами (список путей)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:773
msgid ""
"Rejoue les requêtes RÉUSSIES (2xx/3xx) du journal d'accès contre la liste."
msgstr "Прогоняет УСПЕШНЫЕ запросы (2xx/3xx) из журнала доступа через список."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:774
msgid ""
"Chaque ligne de la liste qui aurait touché une requête probablement légitime"
" est montrée avec un exemple."
msgstr ""
"Каждая строка списка, которая задела бы, вероятно, легитимный запрос, "
"показывается с примером."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:775
msgid ""
"Cliquer une ligne : exception pour ce chemin, exception pour son dossier, ou"
" suppression de la ligne."
msgstr ""
"Щёлкните строку: исключение для этого пути, исключение для его каталога или "
"удаление строки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:776
msgid ""
"Modifie le texte affiché (annulable), jamais le fichier avant Enregistrer."
msgstr ""
"Изменяет отображаемый текст (можно отменить), никогда не файл до Сохранить."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:779
#: src/omega_serv/interfaces/tui/screens/path_list_editor_screen.py:131
msgid "Nouveautés de la référence"
msgstr "Новое в эталоне"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:780
msgid "Entrées de la référence livrée absentes de votre liste."
msgstr "Записи поставляемого эталона, отсутствующие в вашем списке."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:781
msgid "Cocher celles à ajouter, puis Ajouter la sélection."
msgstr "Отметьте те, что нужно добавить, затем Добавить выбранное."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:783
msgid ""
"Rien n'est ajouté sans être coché. Une ligne de la référence que vous "
"supprimez est marquée '#retire: /x' à l'enregistrement et n'est plus jamais "
"reproposée."
msgstr ""
"Без отметки ничего не добавляется. Удалённая вами строка эталона при "
"сохранении помечается '#retire: /x' и больше никогда не предлагается."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:786
msgid "Modifie le texte affiché."
msgstr "Изменяет отображаемый текст."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:790
msgid "Rend le fichier lisible par le compte du service (omega-serv)."
msgstr "Делает файл читаемым для учётной записи службы (omega-serv)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:791
msgid ""
"Proposé seulement si l'état signale que le service ne peut pas lire le "
"fichier."
msgstr ""
"Предлагается, только если состояние показывает, что служба не может "
"прочитать файл."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:793
msgid ""
"Liste chaque changement de droits avant de l'appliquer, uniquement sur ce "
"qui vous appartient - jamais via sudo."
msgstr ""
"Перечисляет каждое изменение прав перед применением, только для того, что "
"принадлежит вам - никогда через sudo."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:796
msgid "L'état est recalculé."
msgstr "Состояние пересчитывается."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:799
#: src/omega_serv/interfaces/tui/screens/text_file_editor_screen.py:165
msgid "Enregistrer et appliquer"
msgstr "Сохранить и применить"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:800
msgid "Écrit le fichier, puis recharge le serveur si la liste est chargée."
msgstr "Записывает файл, затем перезагружает сервер, если список загружен."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:801
msgid "Refusé tant qu'il reste une erreur."
msgstr "Отклоняется, пока остаётся ошибка."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:803
msgid ""
"Écriture sûre : droits et groupe conservés, nouveau fichier en 0644, refus "
"si le fichier a été modifié ailleurs depuis l'ouverture, ou si c'est un lien"
" symbolique."
msgstr ""
"Безопасная запись: права и группа сохраняются, новый файл создаётся с 0644, "
"отказ, если файл был изменён в другом месте после открытия или является "
"символической ссылкой."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:807
msgid ""
"Le rechargement n'est déclenché que si la vérification de la liste réussit -"
" sinon la raison est affichée et le serveur garde ses règles actuelles."
msgstr ""
"Перезагрузка запускается, только если проверка списка прошла успешно - иначе"
" показывается причина, и сервер сохраняет текущие правила."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:812
msgid "Fermer / Aide"
msgstr "Закрыть / Справка"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:813
msgid "Fermer l'éditeur, ou ouvrir cette fiche."
msgstr "Закрыть редактор или открыть эту карточку."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:814
msgid "Clic."
msgstr "Щелчок."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:815
msgid ""
"Fermer demande une confirmation s'il reste des modifications non "
"enregistrées."
msgstr ""
"Закрыть запрашивает подтверждение, если остались несохранённые изменения."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:816
msgid "Retour à l'écran précédent."
msgstr "Возврат к предыдущему экрану."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:820
msgid ""
"Le fichier n'est jamais modifié avant Enregistrer. Un fichier non modifiable"
" par votre compte s'ouvre en LECTURE SEULE, avec la raison."
msgstr ""
"Файл никогда не изменяется до Сохранить. Файл, недоступный для изменения "
"вашей учётной записью, открывается ТОЛЬКО ДЛЯ ЧТЕНИЯ, с указанием причины."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:825
msgid ""
"Échap et F1 ne font rien ici, volontairement (aucun raccourci) : utilisez "
"Fermer et Aide. Seul ctrl+q reste actif pour quitter l'application, avec "
"confirmation."
msgstr ""
"Esc и F1 здесь намеренно ничего не делают (никаких сочетаний клавиш): "
"используйте Закрыть и Справка. Активной остаётся только ctrl+q для выхода из"
" приложения, с подтверждением."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:829
msgid ""
"L'état en bas de l'écran indique si le compte du service peut lire le "
"fichier : un fichier illisible ferait échouer le prochain rechargement."
msgstr ""
"Состояние внизу экрана показывает, может ли учётная запись службы прочитать "
"файл: нечитаемый файл сорвал бы следующую перезагрузку."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:837
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:93
msgid "WAF - Modifier une liste"
msgstr "WAF - Изменить список"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:838
msgid "WAF - Règles et listes personnalisées -> Modifier (ligne Liste)"
msgstr "WAF - Свои правила и списки -> Изменить (строка Список)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:839
msgid ""
"Change les réglages d'une liste déjà chargée, sans toucher à son fichier."
msgstr "Меняет настройки уже загруженного списка, не трогая его файл."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:842
msgid "Nom affiché / Où chercher / Gravité / Récidive"
msgstr "Отображаемое имя / Где искать / Серьёзность / Повторные нарушения"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:843
msgid "Mêmes choix que dans l'assistant (voir sa fiche)."
msgstr "Те же варианты, что и в мастере (см. его карточку)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:844
msgid ""
"Passer d'Observation à une gravité bloquante une fois les alertes lues."
msgstr ""
"Переход от Наблюдения к блокирующей серьёзности после изучения оповещений."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:845
msgid "Vérifie la nouvelle configuration avant de l'écrire."
msgstr "Проверяет новую конфигурацию перед записью."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:846
msgid ""
"Rechargement automatique ; refus affiché avec sa raison si la vérification "
"échoue."
msgstr ""
"Автоматическая перезагрузка; при неудачной проверке показывается отказ с "
"причиной."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:849
msgid ""
"Rendre une liste bloquante réactive la réputation et l'auto-ban s'ils "
"avaient été éteints."
msgstr ""
"Перевод списка в блокирующий снова включает репутацию и автобан, если они "
"были выключены."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:855
msgid "Accueil -> Active Sécurité -> Magnet (bloc WAF)"
msgstr "Главная -> Активная безопасность -> Magnet (блок WAF)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:857
msgid ""
"Importe un script WAF mod_magnet Lighttpd EXISTANT (écrit pour un autre "
"site) sans le réécrire, comme renfort additif au WAF natif - il ne peut "
"jamais lever un blocage déjà décidé par le natif. Seuls les chemins "
"personnels du script (fichiers de log/blocage) se dissocient ici, jamais la "
"logique du script lui-même."
msgstr ""
"Импортирует СУЩЕСТВУЮЩИЙ WAF-скрипт mod_magnet для Lighttpd (написанный для "
"другого сайта) без переписывания, как дополнительное усиление встроенного "
"WAF - он никогда не может снять блокировку, уже принятую встроенным WAF. "
"Здесь отделяются только личные пути скрипта (файлы журналов/блокировки), "
"никогда не логика самого скрипта."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:864
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:295
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:65
msgid "Actif (oui/non)"
msgstr "Включён (да/нет)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:865
msgid "Active ou désactive le script magnet."
msgstr "Включает или отключает скрипт magnet."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:866
msgid "oui ou non."
msgstr "да или нет."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:871
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:67
msgid "Script (chemin relatif au projet)"
msgstr "Скрипт (путь относительно проекта)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:872
msgid ""
"Le fichier Lua à importer - une liste des scripts trouves sous "
"secure/waf/scripts/ est affichée en indice."
msgstr ""
"Импортируемый файл Lua - в подсказке показан список скриптов, найденных в "
"secure/waf/scripts/."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:873
msgid "Chemin relatif au projet, ex. secure/waf/scripts/waf.lua."
msgstr "Путь относительно проекта, напр. secure/waf/scripts/waf.lua."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:874
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:881
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:895
msgid "Enregistre avec Actif."
msgstr "Сохраняет вместе с Включён."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:875
msgid ""
"Aucun effet avant Enregistrer - utiliser Vérifier la compatibilité pour "
"tester sans rien écrire."
msgstr ""
"Без эффекта до Сохранить - используйте Проверить совместимость, чтобы "
"проверить, ничего не записывая."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:878
msgid "Délai maximum par appel (ms) / Comportement en cas d'erreur"
msgstr "Макс. время на вызов (мс) / Поведение при ошибке"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:879
msgid ""
"Borne le temps d'exécution du script par requête, et la décision prise si le"
" script plante ou dépasse ce délai."
msgstr ""
"Ограничивает время выполнения скрипта на запрос и задаёт решение, если "
"скрипт падает или превышает это время."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:880
msgid ""
"Délai en millisecondes ; ignore (laisse passer) ou fail-closed (bloque par "
"prudence)."
msgstr ""
"Время в миллисекундах; ignore (пропускает) или fail-closed (блокирует из "
"предосторожности)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:882
msgid ""
"fail-closed combiné à une incompatibilité détectée peut bloquer du trafic "
"légitime - avertissement explicite affiché par Vérifier la compatibilité "
"dans ce cas."
msgstr ""
"fail-closed в сочетании с обнаруженной несовместимостью может блокировать "
"легитимный трафик - в этом случае Проверить совместимость показывает явное "
"предупреждение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:885
msgid "Chemins personnels dissociés"
msgstr "Отделённые личные пути"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:887
msgid ""
"5 chemins (blocklist, dossier de règles, 2 journaux, fichier de persistance "
"du rate limiting) injectés dans le script à la place de ses chemins en dur "
"d'origine - propre à chaque script importe, jamais un contrat générique. "
"Blocklist par défaut : var/lib/waf/magnet-blocklist.txt (le script y ÉCRIT ;"
" un ancien secure/waf/magnet-blocklist.txt est repris une fois). Un chemin "
"choisi à la main doit rester inscriptible par le compte du service, sinon "
"les bans sont perdus sans message."
msgstr ""
"5 путей (blocklist, каталог правил, 2 журнала, файл сохранения ограничения "
"частоты), внедряемых в скрипт вместо его исходных жёстко заданных путей - "
"свои для каждого импортируемого скрипта, никогда не общий контракт. "
"Blocklist по умолчанию: var/lib/waf/magnet-blocklist.txt (скрипт в него "
"ПИШЕТ; старый secure/waf/magnet-blocklist.txt подхватывается один раз). "
"Путь, выбранный вручную, должен оставаться доступным для записи учётной "
"записи службы, иначе баны теряются без сообщения."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:894
msgid ""
"Vide = le script garde son propre chemin en dur (aucune injection pour ce "
"champ)."
msgstr ""
"Пусто = скрипт сохраняет свой собственный жёсткий путь (для этого поля "
"ничего не внедряется)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:896
msgid ""
"Les dossiers parents sont créés automatiquement à l'usage réel (jamais lors "
"d'un simple 'config check')."
msgstr ""
"Родительские каталоги создаются автоматически при реальном использовании "
"(никогда при простом 'config check')."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:899
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:87
msgid "Vérifier la compatibilité"
msgstr "Проверить совместимость"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:900
msgid ""
"Exécute RÉELLEMENT le script avec les valeurs du formulaire EN COURS DE "
"SAISIE, pas seulement celles déjà enregistrées."
msgstr ""
"ДЕЙСТВИТЕЛЬНО выполняет скрипт со значениями РЕДАКТИРУЕМОЙ формы, а не "
"только с уже сохранёнными."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:901
msgid ""
"À utiliser avant d'activer un script importe en production - répond à 'ce "
"script est-il compatible ?'."
msgstr ""
"Используйте перед включением импортированного скрипта в рабочей среде - "
"отвечает на вопрос 'совместим ли этот скрипт?'."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:902
msgid ""
"Scan statique (membres lighty.* non supportes) + exécution réelle sur une "
"requête de test bénigne."
msgstr ""
"Статический анализ (неподдерживаемые члены lighty.*) + реальное выполнение "
"на безобидном тестовом запросе."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:903
msgid ""
"Aucun effet sur le serveur ni sur la configuration enregistrée - purement "
"diagnostique."
msgstr ""
"Без эффекта на сервер и сохранённую конфигурацию - только диагностика."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:906
msgid ""
"Le natif reste toujours actif en parallèle - le magnet ne peut qu'ajouter un"
" blocage, jamais en lever un."
msgstr ""
"Встроенный WAF всегда остаётся активным параллельно - magnet может только "
"добавить блокировку, никогда не снять её."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:909
msgid ""
"Un script importe peut référencer une fonctionnalité lighty.* non supportée "
"par ce pont (toujours nil côté Lua) - toujours lancer Vérifier la "
"compatibilité avant d'activer un nouveau script en production, surtout avec "
"on_error=fail-closed."
msgstr ""
"Импортированный скрипт может обращаться к функциональности lighty.*, не "
"поддерживаемой этим мостом (на стороне Lua всегда nil) - всегда запускайте "
"Проверить совместимость перед включением нового скрипта в рабочей среде, "
"особенно с on_error=fail-closed."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:918
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:94
msgid "WAF - Choix d'un pack de règles"
msgstr "WAF - Выбор пакета правил"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:919
msgid "WAF - Modules -> Ajouter un pack"
msgstr "WAF - Модули -> Добавить пакет"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:920
msgid ""
"Liste RÉELLE des packs de règles présents sous secure/waf/rules/, exclut "
"ceux déjà référencés - jamais de doublon proposé."
msgstr ""
"РЕАЛЬНЫЙ список пакетов правил в secure/waf/rules/, без уже подключённых - "
"дубликаты никогда не предлагаются."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:923
msgid "Sélection du pack"
msgstr "Выбор пакета"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:924
msgid "Choisit un pack parmi ceux disponibles et non déjà référencés."
msgstr "Выбирает пакет среди доступных и ещё не подключённых."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:925
msgid ""
"Un menu déroulant, avec la description du pack (nombre de règles, état par "
"défaut) affichée en dessous."
msgstr ""
"Раскрывающийся список, под ним описание пакета (число правил, состояние по "
"умолчанию)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:926
msgid "Confirmer renvoie le chemin choisi à l'écran Modules."
msgstr "Подтвердить возвращает выбранный путь на экран Модули."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:927
msgid ""
"Aucun effet ici - la référence réelle est ajoutée par l'écran appelant."
msgstr "Здесь без эффекта - сама ссылка добавляется вызвавшим экраном."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:930
msgid "Aucune modification directe - purement une aide de sélection."
msgstr "Никаких прямых изменений - только помощь в выборе."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:935
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:109
msgid "Intervention manuelle - Bannir"
msgstr "Ручное вмешательство - Забанить"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:936
msgid "Accueil -> Active Sécurité -> Bannir (cadre INTERVENTION MANUELLE)"
msgstr ""
"Главная -> Активная безопасность -> Забанить (рамка РУЧНОЕ ВМЕШАТЕЛЬСТВО)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:938
msgid ""
"Bannit une adresse IP sans condition : aucune règle, aucun seuil. L'adresse "
"est ajoutée à la blocklist du WAF et reçoit la page 451 sur tout le site, "
"avant le routage - les backends (reverse proxy, FastCGI) ne la voient "
"jamais. Aucun droit administrateur n'est nécessaire."
msgstr ""
"Банит IP-адрес без условий: ни правил, ни порогов. Адрес добавляется в "
"blocklist WAF и получает страницу 451 на всём сайте до маршрутизации — "
"бэкенды (обратный прокси, FastCGI) его никогда не видят. Права "
"администратора не нужны."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:944
#: src/omega_serv/interfaces/tui/screens/manual_ban_screen.py:65
#: src/omega_serv/interfaces/tui/screens/manual_unban_screen.py:67
msgid "Adresse IP"
msgstr "IP-адрес"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:945
msgid "L'adresse à bannir, IPv4 ou IPv6."
msgstr "Адрес для бана, IPv4 или IPv6."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:946
msgid ""
"Une seule adresse (ex. 203.0.113.7 ou 2001:db8::7). Un réseau (/24...) est "
"refusé : il se bannit dans WAF -> Modules -> Liste de blocage."
msgstr ""
"Один адрес (например, 203.0.113.7 или 2001:db8::7). Сеть (/24...) "
"отклоняется: её банят в WAF -> Модули -> Список блокировки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:948
msgid "Vérifiée au clic sur Bannir."
msgstr "Проверяется при нажатии «Забанить»."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:949
msgid "Adresse invalide ou réseau : message d'erreur, rien n'est écrit."
msgstr ""
"Недопустимый адрес или сеть: сообщение об ошибке, ничего не записывается."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:952
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:102
#: src/omega_serv/interfaces/tui/screens/manual_ban_screen.py:67
#: src/omega_serv/interfaces/tui/screens/manual_unban_screen.py:67
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:105
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:194
msgid "Motif du ban"
msgstr "Причина бана"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:953
msgid ""
"Texte libre gardé avec le ban, affiché dans Débannir et Statut des bans."
msgstr ""
"Свободный текст, хранящийся вместе с баном; виден в «Разбанить» и «Статус "
"банов»."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:954
msgid "Facultatif : « Intervention manuelle » par défaut."
msgstr "Необязательно: по умолчанию « Ручное вмешательство »."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:955
msgid "Enregistré avec le ban."
msgstr "Сохраняется вместе с баном."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:956
msgid "Visible dans Statut des bans et dans les exports."
msgstr "Виден в «Статус банов» и в экспортах."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:959
#: src/omega_serv/interfaces/tui/screens/manual_ban_screen.py:69
msgid "Durée"
msgstr "Длительность"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:960
msgid "Combien de temps le ban reste en place."
msgstr "Сколько времени действует бан."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:961
msgid ""
"1 h, 6 h, 24 h, 7 jours, 30 jours, une durée libre en heures, ou permanent."
msgstr ""
"1 ч, 6 ч, 24 ч, 7 дней, 30 дней, произвольная длительность в часах или "
"навсегда."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:962
msgid "Calculée au moment du ban."
msgstr "Рассчитывается в момент бана."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:963
msgid ""
"À l'échéance, l'adresse est de nouveau acceptée, sans rien faire. Un ban "
"permanent demande une confirmation et reste jusqu'à Débannir."
msgstr ""
"По истечении срока адрес снова принимается, без каких-либо действий. "
"Постоянный бан требует подтверждения и действует до «Разбанить»."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:968
msgid ""
"Effet immédiat, sans redémarrage ni rechargement : le serveur relit la "
"blocklist dès qu'elle change, avec le moteur Python comme avec le moteur "
"natif. Le ban ne compte jamais dans la récidive RIPOSTE et n'a aucun lien "
"avec Active Defense."
msgstr ""
"Мгновенный эффект, без перезапуска и перезагрузки: сервер перечитывает "
"blocklist, как только он меняется, и с движком Python, и с нативным движком."
" Бан никогда не учитывается в повторных нарушениях RIPOSTE и не связан с "
"Active Defense."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:973
msgid ""
"WAF désactivé : la blocklist n'est pas consultée, le ban n'aurait aucun "
"effet - l'écran l'indique en haut. En mode log-only, le ban s'applique quand"
" même."
msgstr ""
"WAF отключён: blocklist не проверяется, бан не имел бы эффекта — экран "
"сообщает об этом вверху. В режиме log-only бан всё равно действует."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:975
msgid ""
"Adresse locale, privée ou Tailscale : une confirmation est demandée, vous "
"pourriez couper votre propre accès."
msgstr ""
"Локальный, частный адрес или адрес Tailscale: запрашивается подтверждение, "
"вы можете отрезать собственный доступ."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:977
msgid ""
"Si l'adresse est déjà bannie par une autre origine (auto-ban, RIPOSTE, "
"omega-jail), votre ban la remplace après confirmation ; un automate ne le "
"remplacera jamais."
msgstr ""
"Если адрес уже забанен другим источником (автобан, RIPOSTE, omega-jail), ваш"
" бан заменяет его после подтверждения; автоматика никогда его не заменит."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:984
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:110
msgid "Intervention manuelle - Débannir"
msgstr "Ручное вмешательство - Разбанить"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:985
msgid "Accueil -> Active Sécurité -> Débannir (cadre INTERVENTION MANUELLE)"
msgstr ""
"Главная -> Активная безопасность -> Разбанить (рамка РУЧНОЕ ВМЕШАТЕЛЬСТВО)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:986
msgid "Liste les bans posés par Bannir, et seulement eux, pour les lever."
msgstr ""
"Показывает баны, установленные через «Забанить», и только их, чтобы снять."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:989
msgid "Tableau des bans manuels"
msgstr "Таблица ручных банов"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:990
msgid "Adresse, motif, date de pose, expiration, état (en vigueur ou expiré)."
msgstr ""
"Адрес, причина, дата установки, срок, состояние (действует или истёк)."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:991
msgid "Sélectionnez une ligne, puis Lever."
msgstr "Выберите строку, затем «Снять»."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:992
msgid "Lever demande une confirmation."
msgstr "«Снять» требует подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:993
msgid ""
"L'adresse est retirée de la blocklist : elle accède de nouveau au site, "
"immédiatement."
msgstr ""
"Адрес удаляется из blocklist: он сразу же снова получает доступ к сайту."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:996
msgid "Retire l'entrée de la blocklist du WAF ; rien d'autre n'est touché."
msgstr "Удаляет запись из blocklist WAF; больше ничего не затрагивается."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:998
msgid ""
"Les autres bans se lèvent là où ils ont été posés : WAF -> Modules (réseaux,"
" auto-bans, CLI, omega-jail), RIPOSTE -> Actions. Un ban levé ici peut "
"revenir si une règle automatique bannit de nouveau l'adresse."
msgstr ""
"Остальные баны снимаются там, где были установлены: WAF -> Модули (сети, "
"автобаны, CLI, omega-jail), RIPOSTE -> Действия. Снятый здесь бан может "
"вернуться, если автоматическое правило снова забанит адрес."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1005
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:111
msgid "Intervention manuelle - Statut des bans"
msgstr "Ручное вмешательство - Статус банов"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1006
msgid ""
"Accueil -> Active Sécurité -> Statut des bans (cadre INTERVENTION MANUELLE)"
msgstr ""
"Главная -> Активная безопасность -> Статус банов (рамка РУЧНОЕ "
"ВМЕШАТЕЛЬСТВО)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1008
msgid ""
"Tous les bans de la blocklist du WAF, avec leur origine : intervention "
"manuelle, manuel (WAF -> Modules ou CLI), auto-ban WAF (règles ou liste), "
"RIPOSTE (politique), omega-jail (jail), et la liste du script Magnet s'il "
"est actif. Lecture seule."
msgstr ""
"Все баны из blocklist WAF с их источником: ручное вмешательство, вручную "
"(WAF -> Модули или CLI), автобан WAF (правила или список), RIPOSTE "
"(политика), omega-jail (jail) и список скрипта Magnet, если он активен. "
"Только чтение."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1014
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:78
msgid "Format d'export"
msgstr "Формат экспорта"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1015
msgid "JSON ou HTML de tous les bans, ou TXT d'injection."
msgstr "JSON или HTML всех банов либо TXT для загрузки."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1016
msgid ""
"TXT : bans actifs ou toute la liste. Une adresse par ligne, en-tête en "
"commentaires « # » - importable tel quel dans omega-fire (Bannir une liste "
"d'IPs). Un réseau n'y figure qu'en commentaire, omega-fire ne lisant que des"
" adresses."
msgstr ""
"TXT: активные баны или весь список. Один адрес в строке, заголовок в "
"комментариях « # » — импортируется как есть в omega-fire («Заблокировать "
"список IP»). Сеть попадает туда только как комментарий, поскольку omega-fire"
" читает только адреса."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1019
msgid "Exporter écrit le fichier dans le dossier d'exports."
msgstr "«Экспорт» записывает файл в папку экспорта."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1020
msgid "Le chemin du fichier écrit est affiché."
msgstr "Показывается путь к записанному файлу."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1024
msgid "Palette de couleurs de l'export HTML."
msgstr "Цветовая палитра экспорта HTML."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1025
msgid "Seulement pour le format HTML."
msgstr "Только для формата HTML."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1026
msgid "Appliqué à l'export."
msgstr "Применяется к экспорту."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1027
msgid "Même choix de thèmes que les autres exports."
msgstr "Тот же выбор тем, что и в других экспортах."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1030
msgid "Aucune - consultation et export seulement."
msgstr "Нет — только просмотр и экспорт."

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1032
msgid ""
"Le fichier TXT n'est jamais traduit : c'est un format lu par d'autres "
"outils."
msgstr ""
"Файл TXT никогда не переводится: это формат, который читают другие "
"инструменты."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:12
msgid "Accueil -> Configuration détaillée -> Voir options actives"
msgstr "Главная -> Подробная настройка -> Активные параметры"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:14
msgid ""
"Active ou désactive les options superposables (fonctionnalités optionnelles "
"qui s'ajoutent par-dessus le profil de base) et affiche leur état actuel."
msgstr ""
"Включает или отключает подключаемые параметры (необязательные функции поверх"
" базового профиля) и показывает их текущее состояние."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:19
msgid "Sélection + Activer / Désactiver"
msgstr "Выбор + Включить / Отключить"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:20
msgid "Chaque ligne du tableau représente une option superposable connue."
msgstr "Каждая строка таблицы - известный подключаемый параметр."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:22
msgid ""
"15 options connues : dirlisting, waf, auth, fastcgi, aliases, redirects, "
"rewrites, cache, trusted_proxy, upload, error_pages, access_control, "
"reverse_proxy, active_defense, riposte."
msgstr ""
"15 известных опций: dirlisting, waf, auth, fastcgi, aliases, redirects, "
"rewrites, cache, trusted_proxy, upload, error_pages, access_control, "
"reverse_proxy, active_defense, riposte."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:25
msgid ""
"Sélectionner une ligne puis Activer/Desactiver bascule option.enabled dans "
"la configuration."
msgstr ""
"Выбор строки и Включить/Отключить переключает option.enabled в конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:27
msgid ""
"Dépend de l'option : la plupart se rechargent à chaud (automatique si un "
"service actif existe). La 1ere activation de fastcgi/reverse_proxy exige un "
"REDÉMARRAGE COMPLET (leur client n'est construit qu'au démarrage). "
"active_defense exige TOUJOURS un redémarrage complet, à l'activation comme à"
" la désactivation."
msgstr ""
"Зависит от параметра: большинство перезагружаются на лету (автоматически, "
"если есть активная служба). Первое включение fastcgi/reverse_proxy требует "
"ПОЛНОГО ПЕРЕЗАПУСКА (их клиент создаётся только при запуске). active_defense"
" ВСЕГДА требует полного перезапуска, как при включении, так и при "
"отключении."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:32
msgid ""
"riposte aussi : son processus est lancé et surveillé par le service au "
"démarrage."
msgstr ""
"riposte тоже: его процесс запускается и контролируется службой при старте."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:37
msgid ""
"Activer une option ici ne configure que son interrupteur enabled - les "
"réglages détaillés (zones, règles, seuils...) vivent dans le sous-écran "
"dédié à cette option, dans Configuration détaillée."
msgstr ""
"Включение параметра здесь задаёт только его переключатель enabled - "
"подробные настройки (зоны, правила, пороги...) находятся на отдельном "
"подэкране этого параметра в Подробной настройке."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:43
msgid ""
"Activer une option ne suffit jamais à elle seule : sans un rechargement (ou "
"redémarrage) du service déjà lancé, rien ne change réellement - voir la FAQ "
"'Pourquoi mon option activée ne fonctionne pas ?'."
msgstr ""
"Одного включения параметра никогда не достаточно: без перезагрузки (или "
"перезапуска) уже запущенной службы ничего реально не меняется - см. FAQ "
"'Почему включённый параметр не работает?'."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:53
msgid "Accueil -> Service"
msgstr "Главная -> Служба"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:55
msgid ""
"Pilote le service système (systemd/OpenRC/runit) qui fait tourner OMEGA-SERV"
" : demarrer/arreter/redemarrer/recharger, activer/desactiver au démarrage, "
"installer/désinstaller l'unité."
msgstr ""
"Управляет системной службой (systemd/OpenRC/runit), в которой работает "
"OMEGA-SERV: запуск/остановка/перезапуск/перезагрузка, включение/отключение "
"при загрузке, установка/удаление юнита."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:61
msgid "Nom du service"
msgstr "Имя службы"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:62
msgid "Le nom de l'unité système pilotée par cet écran."
msgstr "Имя системного юнита, которым управляет этот экран."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:63
msgid ""
"Chaîne libre - figé si cette instance est enregistrée en multi-instance."
msgstr ""
"Произвольная строка - зафиксирована, если этот экземпляр зарегистрирован в "
"режиме нескольких экземпляров."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:64
msgid "Utilisé par tous les boutons de cet écran."
msgstr "Используется всеми кнопками этого экрана."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:65
msgid "Aucun effet seul - simplement le nom cible des actions ci-dessous."
msgstr "Само по себе без эффекта - просто имя цели для действий ниже."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:68
msgid "Démarrer / Arrêter / Redémarrer / Recharger"
msgstr "Запустить / Остановить / Перезапустить / Перезагрузить"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:69
msgid ""
"Actions directes de contrôle du service - Recharger (SIGHUP) est léger, les "
"autres coupent les connexions."
msgstr ""
"Прямые действия управления службой - Перезагрузить (SIGHUP) легковесно, "
"остальные обрывают соединения."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:70
msgid "Un clic suffit, aucune confirmation demandée pour ces 4 actions."
msgstr ""
"Достаточно одного щелчка, для этих 4 действий подтверждение не "
"запрашивается."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:71
msgid ""
"Exécute la commande système correspondante, avec élévation (sudo) ponctuelle"
" si nécessaire."
msgstr ""
"Выполняет соответствующую системную команду, при необходимости с разовым "
"повышением прав (sudo)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:72
msgid "Effet réel et immédiat sur le service."
msgstr "Реальный и немедленный эффект на службу."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:75
msgid "Activer / Désactiver au démarrage"
msgstr "Включить / Отключить при загрузке"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:76
msgid "Contrôle si le service démarre automatiquement avec la machine."
msgstr "Определяет, запускается ли служба автоматически вместе с машиной."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:77
msgid "Un clic suffit."
msgstr "Достаточно одного щелчка."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:78
msgid "Modifie l'enregistrement systemd/OpenRC/runit."
msgstr "Изменяет регистрацию в systemd/OpenRC/runit."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:79
msgid ""
"N'affecte jamais l'état actuel du service, seulement son comportement au "
"prochain démarrage machine."
msgstr ""
"Никогда не влияет на текущее состояние службы, только на её поведение при "
"следующей загрузке машины."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:82
msgid "Installer l'unité (systemd uniquement)"
msgstr "Установить юнит (только systemd)"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:83
msgid ""
"Crée le fichier d'unité systemd, le compte système dédié, et prépare les "
"accès nécessaires."
msgstr ""
"Создаёт файл юнита systemd, выделенную системную учётную запись и "
"подготавливает необходимые права доступа."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:84
msgid ""
"Une seule fois par instance - demande confirmation et une authentification "
"(sudo)."
msgstr ""
"Один раз на экземпляр - запрашивает подтверждение и аутентификацию (sudo)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:85
msgid ""
"Écrit /etc/systemd/system/<nom>.service, crée le compte dédié omega-"
"serv/omega-serv."
msgstr ""
"Записывает /etc/systemd/system/<имя>.service, создаёт выделенную учётную "
"запись omega-serv/omega-serv."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:87
msgid ""
"Deux garde-fous bloquent l'installation si un conflit est détecté (une autre"
" unité pointe déjà vers ce répertoire, ou ce nom est déjà utilisé par une "
"unité pointant ailleurs)."
msgstr ""
"Две защиты блокируют установку при обнаружении конфликта (другой юнит уже "
"указывает на этот каталог или это имя уже занято юнитом, указывающим в "
"другое место)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:93
msgid "Désinstaller l'unité (systemd uniquement)"
msgstr "Удалить юнит (только systemd)"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:94
msgid "Retire l'unité systemd installée."
msgstr "Удаляет установленный юнит systemd."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:95
msgid "Demande confirmation et une authentification (sudo)."
msgstr "Запрашивает подтверждение и аутентификацию (sudo)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:96
msgid "Arrête le service et supprime le fichier d'unité."
msgstr "Останавливает службу и удаляет файл юнита."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:97
msgid ""
"Le compte système dédié et le répertoire projet ne sont jamais supprimés par"
" cette action."
msgstr ""
"Выделенная системная учётная запись и каталог проекта этим действием никогда"
" не удаляются."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:101
msgid ""
"Installer/Desinstaller ne sont proposes QUE pour systemd - désactivés pour "
"OpenRC/runit (déjà configurés directement sur le système requis pour ces "
"gestionnaires)."
msgstr ""
"Установка/удаление предлагаются ТОЛЬКО для systemd - отключены для "
"OpenRC/runit (для этих менеджеров служба уже настраивается непосредственно в"
" системе)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:106
msgid ""
"Après 'Installer l'unité', une session déjà ouverte n'a pas automatiquement "
"le nouveau groupe système créé pour le compte dédié - reconnectez votre "
"session une seule fois si l'état semble incohérent (voir État & Ressources)."
msgstr ""
"После 'Установить юнит' уже открытый сеанс не получает автоматически новую "
"системную группу выделенной учётной записи - войдите в систему заново один "
"раз, если состояние кажется несогласованным (см. Состояние и ресурсы)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:116
msgid "Accueil -> Instances (N)"
msgstr "Главная -> Экземпляры (N)"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:118
msgid ""
"Registre de toutes les installations d'OMEGA-SERV connues sur cette machine,"
" avec le statut systemd de chacune - permet de créer une nouvelle instance "
"ou de basculer entre elles."
msgstr ""
"Реестр всех установок OMEGA-SERV, известных на этой машине, с состоянием "
"systemd каждой - позволяет создать новый экземпляр или переключаться между "
"ними."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:123
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:58
msgid "Créer une nouvelle instance"
msgstr "Создать новый экземпляр"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:124
msgid ""
"Dupliqué cette installation vers un nouveau répertoire FRÈRE (jamais à "
"l'intérieur de celui-ci)."
msgstr ""
"Дублирует эту установку в новый СОСЕДНИЙ каталог (никогда не внутри этого)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:125
msgid ""
"Nom, répertoire parent, adresse d'écoute, port (un port libre est proposé "
"par défaut)."
msgstr ""
"Имя, родительский каталог, адрес прослушивания, порт (по умолчанию "
"предлагается свободный порт)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:126
msgid ""
"Copie le code/l'environnement, crée la nouvelle configuration et "
"l'enregistre au registre."
msgstr ""
"Копирует код/окружение, создаёт новую конфигурацию и регистрирует её в "
"реестре."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:127
msgid ""
"Opération réelle sur disque, peut prendre du temps (progression affichée)."
msgstr ""
"Реальная операция на диске, может занять время (отображается ход "
"выполнения)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:130
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:61
msgid "Piloter cette instance"
msgstr "Управлять этим экземпляром"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:131
msgid ""
"Bascule l'interface pour piloter une AUTRE instance enregistrée, en quittant"
" celle-ci."
msgstr ""
"Переключает интерфейс на управление ДРУГИМ зарегистрированным экземпляром, "
"покидая текущий."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:132
msgid "Sélectionner une instance différente de la courante (jamais soi-même)."
msgstr "Выберите экземпляр, отличный от текущего (никогда себя)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:133
msgid ""
"Ferme cette interface et relance l'application pointée sur l'autre "
"répertoire."
msgstr ""
"Закрывает этот интерфейс и снова запускает приложение, направленное на "
"другой каталог."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:134
msgid ""
"Nécessite que l'environnement virtuel de l'instance cible existe réellement."
msgstr ""
"Требует, чтобы виртуальное окружение целевого экземпляра действительно "
"существовало."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:137
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:63
msgid "Désinstaller cette instance"
msgstr "Удалить этот экземпляр"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:138
msgid ""
"Retire l'unité systemd, le compte dédié (si plus utilisé par personne "
"d'autre) et l'entrée du registre."
msgstr ""
"Удаляет юнит systemd, выделенную учётную запись (если её больше никто не "
"использует) и запись в реестре."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:139
msgid "Ne peut jamais cibler l'instance courante (basculer ailleurs d'abord)."
msgstr ""
"Никогда не может быть применено к текущему экземпляру (сначала переключитесь"
" на другой)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:140
msgid ""
"Deux confirmations : l'opération elle-même, puis si le répertoire doit aussi"
" être supprimé."
msgstr ""
"Два подтверждения: сама операция, затем нужно ли также удалить каталог."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:141
msgid ""
"Le répertoire n'est supprimé que sur confirmation explicite séparée - "
"conservé par défaut."
msgstr ""
"Каталог удаляется только после отдельного явного подтверждения - по "
"умолчанию сохраняется."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:144
msgid ""
"Registre en lecture seule sinon - toute modification passe par les actions "
"ci-dessus."
msgstr ""
"В остальном реестр только для чтения - любые изменения выполняются "
"действиями выше."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:150
msgid "Accueil -> État & Ressources"
msgstr "Главная -> Состояние и ресурсы"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:152
msgid ""
"Tableau de bord en trois cadres, rafraîchi automatiquement toutes les 2 "
"secondes : état du serveur/service, flux du log d'accès en direct, "
"ressources système."
msgstr ""
"Панель из трёх блоков, автоматически обновляемая каждые 2 секунды: состояние"
" сервера/службы, поток журнала доступа в реальном времени, системные "
"ресурсы."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:158
msgid ""
"Force un rafraîchissement immédiat (sans attendre le prochain cycle de 2s)."
msgstr ""
"Принудительное немедленное обновление (не дожидаясь следующего 2-секундного "
"цикла)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:160
msgid "Relit l'état, les nouvelles lignes de log et les ressources système."
msgstr "Перечитывает состояние, новые строки журнала и системные ресурсы."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:164
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:182
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:81
#: src/omega_serv/interfaces/tui/screens/resource_status_screen.py:237
msgid "Simuler une requête"
msgstr "Имитировать запрос"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:165
msgid "Ouvre l'écran de simulation de routage."
msgstr "Открывает экран имитации маршрутизации."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:166
msgid "Aucune saisie ici."
msgstr "Здесь ввода нет."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:167
msgid "Ouvre SimulateRequestScreen."
msgstr "Открывает SimulateRequestScreen."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:174
msgid ""
"Le cadre FLUX ne lit que le log d'accès au format 'combined' - un format "
"différent ne produira aucune statistique."
msgstr ""
"Блок ПОТОК читает только журнал доступа в формате 'combined' - другой формат"
" не даст никакой статистики."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:183
msgid "Accueil -> État & Ressources -> Simuler une requête"
msgstr "Главная -> Состояние и ресурсы -> Имитировать запрос"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:185
msgid ""
"Rejoue le VRAI routage d'OMEGA-SERV (mêmes règles que pour une requête "
"réseau réelle) sans envoyer de requête réseau - utile pour diagnostiquer une"
" règle avant de la tester en vrai."
msgstr ""
"Воспроизводит НАСТОЯЩУЮ маршрутизацию OMEGA-SERV (те же правила, что и для "
"реального сетевого запроса), не отправляя сетевой запрос - полезно, чтобы "
"разобраться с правилом до реальной проверки."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:190
msgid "Méthode"
msgstr "Метод"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:191
msgid "Méthode HTTP simulée."
msgstr "Имитируемый метод HTTP."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:192
msgid "Chaîne libre, ex: GET, HEAD, POST. Valeur par défaut : GET."
msgstr ""
"Произвольная строка, напр.: GET, HEAD, POST. Значение по умолчанию: GET."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:194
msgid "Aucun effet (lecture seule, aucune requête réseau)."
msgstr "Без эффекта (только чтение, без сетевого запроса)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:197
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:73
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:73
#: src/omega_serv/interfaces/tui/screens/process_ip_screen.py:111
#: src/omega_serv/interfaces/tui/screens/simulate_request_screen.py:35
#: src/omega_serv/interfaces/tui/widgets/log_library_table.py:32
msgid "Chemin"
msgstr "Путь"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:198
msgid "Chemin d'URL simulé."
msgstr "Имитируемый путь URL."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:199
msgid "Chaîne libre commençant par '/'. Valeur par défaut : /."
msgstr "Произвольная строка, начинающаяся с '/'. Значение по умолчанию: /."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:200
msgid "Utilisé au clic sur Simuler."
msgstr "Используется при нажатии Имитировать."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:204
msgid ""
"Affiche le chemin normalisé, si la méthode est autorisée, si une règle "
"bloque la requête, le statut de réponse attendu et les en-têtes attendus."
msgstr ""
"Показывает нормализованный путь, разрешён ли метод, блокирует ли запрос "
"какое-либо правило, ожидаемый статус ответа и ожидаемые заголовки."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:209
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:82
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:66
msgid "Vérifier la configuration"
msgstr "Проверить конфигурацию"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:210
msgid "Accueil -> Configuration détaillée -> Vérifier la configuration"
msgstr "Главная -> Подробная настройка -> Проверить конфигурацию"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:212
msgid ""
"Vérifie la configuration en deux couches : structurelle (déjà vérifiée au "
"chargement) puis environnement réel (fichiers présents, permissions...)."
msgstr ""
"Проверяет конфигурацию в два слоя: структурно (уже проверено при загрузке), "
"затем реальное окружение (наличие файлов, права...)."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:217
#: src/omega_serv/interfaces/tui/screens/config_check_screen.py:43
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:40
msgid "Vérifier"
msgstr "Проверить"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:218
msgid "Relance explicitement la vérification."
msgstr "Явно запускает проверку повторно."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:219
msgid ""
"Aucune saisie - une première vérification a déjà lieu automatiquement à "
"l'ouverture de l'écran."
msgstr ""
"Ввода нет - первая проверка уже выполняется автоматически при открытии "
"экрана."

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:220
msgid "Relit la configuration et l'environnement réel."
msgstr "Перечитывает конфигурацию и реальное окружение."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:10
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:45
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:53
msgid "FastCGI / PHP-FPM"
msgstr "FastCGI / PHP-FPM"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:11
msgid "Accueil -> Configuration détaillée -> FastCGI / PHP-FPM"
msgstr "Главная -> Подробная настройка -> FastCGI / PHP-FPM"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:13
msgid ""
"Un seul enregistrement (jamais une liste) : proxy vers un serveur PHP-FPM "
"pour exécuter du PHP sous un préfixe d'URL donné."
msgstr ""
"Одна запись (никогда не список): прокси к серверу PHP-FPM для выполнения PHP"
" под заданным префиксом URL."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:18
msgid "Préfixe URL (url_prefix)"
msgstr "Префикс URL (url_prefix)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:19
msgid "Le préfixe d'URL sous lequel les requêtes sont relayées vers PHP-FPM."
msgstr "Префикс URL, под которым запросы ретранслируются в PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:20
msgid "Doit commencer par '/'. Valeur par défaut : /app/."
msgstr "Должен начинаться с '/'. Значение по умолчанию: /app/."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:21
msgid "Enregistre au clic sur Enregistrer, après validation structurelle."
msgstr "Сохраняет при нажатии Сохранить, после структурной проверки."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:23
msgid ""
"Si l'option fastcgi est déjà activé : rechargement suffit (automatique si un"
" service actif existe). Sinon, sa PREMIÈRE activation exige un redémarrage "
"complet."
msgstr ""
"Если параметр fastcgi уже включён: достаточно перезагрузки (автоматически, "
"если есть активная служба). Иначе его ПЕРВОЕ включение требует полного "
"перезапуска."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:28
msgid "Racine d'exécution (script_root)"
msgstr "Корень выполнения (script_root)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:29
msgid "Répertoire, relatif au projet, contenant les scripts PHP exécutables."
msgstr "Каталог относительно проекта, содержащий исполняемые скрипты PHP."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:30
msgid ""
"Chemin relatif - ne peut jamais être à l'intérieur du webroot (vérifié "
"structurellement)."
msgstr ""
"Относительный путь - никогда не может находиться внутри webroot (проверяется"
" структурно)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:31
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:38
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:45
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:52
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:59
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:69
msgid "Enregistre avec le reste des champs."
msgstr "Сохраняет вместе с остальными полями."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:32
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:39
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:46
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:53
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:60
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:70
msgid "Même réaction que url_prefix."
msgstr "Та же реакция, что у url_prefix."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:35
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:36
msgid "Socket PHP-FPM (socket_path)"
msgstr "Сокет PHP-FPM (socket_path)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:36
msgid "Chemin du socket Unix utilisé pour communiquer avec PHP-FPM."
msgstr "Путь к сокету Unix для связи с PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:37
msgid "Chemin relatif. Valeur par défaut : var/run/php-fpm.sock."
msgstr "Относительный путь. Значение по умолчанию: var/run/php-fpm.sock."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:43
msgid "Délais réseau appliqués à la communication avec PHP-FPM."
msgstr "Сетевые тайм-ауты для связи с PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:44
msgid "Nombres en secondes. Valeurs par défaut : 5 (connexion), 30 (lecture)."
msgstr ""
"Числа в секундах. Значения по умолчанию: 5 (подключение), 30 (чтение)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:49
msgid "Extensions autorisées"
msgstr "Разрешённые расширения"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:50
msgid "Extensions de fichiers exécutées via PHP-FPM."
msgstr "Расширения файлов, выполняемых через PHP-FPM."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:51
msgid "Liste séparée par des virgules. Valeur par défaut : .php."
msgstr "Список через запятую. Значение по умолчанию: .php."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:56
msgid "Fichiers d'index"
msgstr "Индексные файлы"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:57
msgid ""
"Fichiers cherches quand une URL sous ce préfixe pointe vers un répertoire."
msgstr "Файлы, ищущиеся, когда URL под этим префиксом указывает на каталог."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:58
msgid "Liste séparée par des virgules. Valeur par défaut : index.php."
msgstr "Список через запятую. Значение по умолчанию: index.php."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:63
msgid "Liste blanche de scripts"
msgstr "Белый список скриптов"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:65
msgid ""
"Restreint les scripts réellement exécutables (chemins relatifs à "
"script_root) - vide signifie 'tout fichier avec une extension autorisée sous"
" script_root reste exécutable'."
msgstr ""
"Ограничивает реально исполняемые скрипты (пути относительно script_root) - "
"пусто означает 'любой файл с разрешённым расширением в script_root остаётся "
"исполняемым'."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:68
msgid ""
"Liste séparée par des virgules, ex: index.php, api/router.php. Vide par "
"défaut."
msgstr ""
"Список через запятую, напр.: index.php, api/router.php. По умолчанию пусто."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:74
msgid ""
"La PREMIÈRE activation de l'option fastcgi (écran Options) exige un "
"REDÉMARRAGE COMPLET (le client FastCGI n'est construit qu'au démarrage). Une"
" fois déjà activé, modifier ces réglages ici ne demande plus qu'un simple "
"rechargement."
msgstr ""
"ПЕРВОЕ включение параметра fastcgi (экран Параметры) требует ПОЛНОГО "
"ПЕРЕЗАПУСКА (клиент FastCGI создаётся только при запуске). После включения "
"изменение этих настроек здесь требует лишь простой перезагрузки."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:80
msgid ""
"script_root ne peut structurellement jamais se trouver à l'intérieur du "
"webroot - bloqué avant même l'enregistrement, pas seulement par 'Vérifier la"
" configuration'."
msgstr ""
"script_root структурно никогда не может находиться внутри webroot - "
"блокируется ещё до сохранения, а не только кнопкой 'Проверить конфигурацию'."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:88
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:47
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:55
msgid "Authentification"
msgstr "Аутентификация"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:89
msgid "Accueil -> Configuration détaillée -> Authentification"
msgstr "Главная -> Подробная настройка -> Аутентификация"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:91
msgid ""
"Gestion des utilisateurs et des zones protégées par authentification HTTP. "
"Les identifiants et zones sont stockés dans des fichiers SÉPARÉS "
"(users.json/zones.json), jamais dans config/omega-serve.json."
msgstr ""
"Управление пользователями и зонами, защищёнными HTTP-аутентификацией. "
"Учётные данные и зоны хранятся в ОТДЕЛЬНЫХ файлах (users.json/zones.json), "
"никогда в config/omega-serve.json."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:97
msgid "Table Utilisateurs"
msgstr "Таблица Пользователи"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:99
msgid ""
"Liste les comptes existants - cliquer une ligne la SÉLECTIONNE (active "
"Changer le mot de passe/Supprimer) sans jamais retaper le nom d'utilisateur."
msgstr ""
"Показывает существующие учётные записи - щелчок по строке ВЫБИРАЕТ её "
"(активирует Сменить пароль/Удалить), без повторного ввода имени "
"пользователя."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:102
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:133
msgid "Sélection par clic, une seule ligne à la fois."
msgstr "Выбор щелчком, по одной строке."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:103
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:134
msgid "Aucune écriture - lecture seule."
msgstr "Без записи - только чтение."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:104
msgid "Active/desactive les boutons Changer le mot de passe et Supprimer."
msgstr "Включает/выключает кнопки Сменить пароль и Удалить."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:108
msgid "Crée un compte utilisateur."
msgstr "Создаёт учётную запись пользователя."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:109
msgid ""
"Nom d'utilisateur + mot de passe saisi deux fois (jamais affiché en clair)."
msgstr ""
"Имя пользователя + пароль, введённый дважды (никогда не отображается "
"открытым текстом)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:110
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:120
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:127
msgid "Écrit directement dans users.json."
msgstr "Записывает непосредственно в users.json."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:114
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:55
msgid "Changer le mot de passe"
msgstr "Сменить пароль"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:115
msgid "Change le mot de passe de l'utilisateur SÉLECTIONNÉ dans la table."
msgstr "Меняет пароль пользователя, ВЫБРАННОГО в таблице."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:117
msgid ""
"Sélectionner une ligne d'abord (le nom d'utilisateur n'est jamais retape) - "
"puis le nouveau mot de passe, saisi deux fois."
msgstr ""
"Сначала выберите строку (имя пользователя никогда не вводится повторно), "
"затем новый пароль, введённый дважды."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:124
msgid "Supprimer (utilisateur)"
msgstr "Удалить (пользователя)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:125
msgid "Retire définitivement le compte utilisateur SÉLECTIONNÉ dans la table."
msgstr ""
"Безвозвратно удаляет учётную запись пользователя, ВЫБРАННУЮ в таблице."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:126
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:151
msgid "Sélectionner une ligne d'abord, puis confirmer - aucune saisie."
msgstr "Сначала выберите строку, затем подтвердите - ввода нет."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:131
msgid "Table Zones protégées"
msgstr "Таблица Защищённые зоны"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:132
msgid ""
"Liste les zones existantes - cliquer une ligne la SÉLECTIONNE (active "
"Supprimer)."
msgstr ""
"Показывает существующие зоны - щелчок по строке ВЫБИРАЕТ её (активирует "
"Удалить)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:135
msgid "Active/desactive le bouton Supprimer."
msgstr "Включает/выключает кнопку Удалить."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:138
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:63
msgid "Créer une zone"
msgstr "Создать зону"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:139
msgid "Protège un préfixe d'URL par authentification HTTP."
msgstr "Защищает префикс URL HTTP-аутентификацией."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:141
msgid ""
"Préfixe URL (ex: /admin/), realm (texte affiché par le navigateur), "
"utilisateurs autorisés (séparés par des virgules), méthodes autorisées (vide"
" = toutes)."
msgstr ""
"Префикс URL (напр.: /admin/), realm (текст, показываемый браузером), "
"разрешённые пользователи (через запятую), разрешённые методы (пусто = все)."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:145
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:152
msgid "Écrit directement dans zones.json."
msgstr "Записывает непосредственно в zones.json."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:149
msgid "Supprimer (zone)"
msgstr "Удалить (зону)"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:150
msgid "Retire la protection de la zone SÉLECTIONNÉE dans la table."
msgstr "Снимает защиту с зоны, ВЫБРАННОЙ в таблице."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:156
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:69
msgid "Vérifier les permissions"
msgstr "Проверить права"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:157
msgid ""
"Vérifie que users.json/zones.json ne sont pas lisibles par d'autres "
"utilisateurs du système."
msgstr ""
"Проверяет, что users.json/zones.json не читаются другими пользователями "
"системы."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:158
msgid "Aucune saisie - lecture seule."
msgstr "Ввода нет - только чтение."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:159
msgid "Affiche le mode de permission réel de chaque fichier."
msgstr "Показывает фактический режим прав каждого файла."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:164
msgid ""
"L'option auth doit être activée (écran Options) pour que les zones protégées"
" soient réellement appliquées. Toute modification d'utilisateur/zone se "
"recharge à chaud."
msgstr ""
"Чтобы защищённые зоны реально применялись, параметр auth должен быть включён"
" (экран Параметры). Любое изменение пользователей/зон перезагружается на "
"лету."

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:169
msgid ""
"Une authentification active SANS TLS transmet les identifiants en clair sur "
"le réseau - l'assistant premier lancement demande une confirmation explicite"
" dans ce cas."
msgstr ""
"Аутентификация БЕЗ TLS передаёт учётные данные по сети открытым текстом - в "
"этом случае мастер первого запуска запрашивает явное подтверждение."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:11
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:54
msgid "TLS (menu)"
msgstr "TLS (меню)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:12
msgid "Accueil -> Configuration détaillée -> TLS"
msgstr "Главная -> Подробная настройка -> TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:13
msgid ""
"Sous-menu regroupant les 5 écrans liés à TLS : statut, génération, CA "
"locale, révocation, activation."
msgstr ""
"Подменю с 5 экранами, связанными с TLS: состояние, генерация, локальный CA, "
"отзыв, включение."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:20
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:55
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:28
msgid "Statut TLS"
msgstr "Состояние TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:21
msgid "Configuration détaillée -> TLS -> Statut TLS"
msgstr "Подробная настройка -> TLS -> Состояние TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:22
msgid ""
"Inspecte le certificat actuellement configuré : validité, expiration, "
"correspondance avec la clé privée, permissions."
msgstr ""
"Проверяет настроенный сейчас сертификат: срок действия, истечение, "
"соответствие закрытому ключу, права."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:26
msgid "Relit et reanalyse le certificat configuré."
msgstr "Перечитывает и заново анализирует настроенный сертификат."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:28
msgid "Relance l'inspection."
msgstr "Повторно запускает проверку."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:35
msgid ""
"Inspecte le FICHIER sur disque, pas nécessairement celui réellement servi "
"par un serveur déjà lancé si celui-ci a changé depuis le dernier "
"redémarrage."
msgstr ""
"Проверяет ФАЙЛ на диске, не обязательно тот, что реально отдаёт уже "
"запущенный сервер, если файл изменился после последнего перезапуска."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:43
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:56
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:29
msgid "Générer un certificat auto-signé"
msgstr "Сгенерировать самоподписанный сертификат"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:44
msgid "Configuration détaillée -> TLS -> Générer un certificat auto-signé"
msgstr ""
"Подробная настройка -> TLS -> Сгенерировать самоподписанный сертификат"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:45
msgid ""
"Génère un certificat auto-signé (jamais reconnu par défaut par les "
"navigateurs) et l'écrit sur disque."
msgstr ""
"Генерирует самоподписанный сертификат (по умолчанию никогда не признаётся "
"браузерами) и записывает его на диск."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:48
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:99
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:86
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:41
#: src/omega_serv/interfaces/tui/screens/wizard_tls_screen.py:51
msgid "Nom commun (CN)"
msgstr "Общее имя (CN)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:49
msgid "Nom commun du certificat."
msgstr "Общее имя сертификата."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:50
msgid "Chaîne libre, généralement le nom d'hôte du serveur."
msgstr "Произвольная строка, обычно имя хоста сервера."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:51
#: src/omega_serv/interfaces/tui/guide/content/tls.py:58
#: src/omega_serv/interfaces/tui/guide/content/tls.py:65
#: src/omega_serv/interfaces/tui/guide/content/tls.py:72
#: src/omega_serv/interfaces/tui/guide/content/tls.py:79
#: src/omega_serv/interfaces/tui/guide/content/tls.py:86
msgid "Utilisé à la génération."
msgstr "Используется при генерации."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:52
msgid "Écrit réellement le certificat/la clé sur disque immédiatement."
msgstr "Сразу реально записывает сертификат/ключ на диск."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:55
msgid "SAN DNS / SAN IP"
msgstr "SAN DNS / SAN IP"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:56
msgid "Noms DNS et adresses IP alternatifs couverts par le certificat."
msgstr "Альтернативные DNS-имена и IP-адреса, охватываемые сертификатом."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:57
msgid "Listes séparées par des virgules, optionnelles."
msgstr "Списки через запятую, необязательно."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:59
#: src/omega_serv/interfaces/tui/guide/content/tls.py:66
#: src/omega_serv/interfaces/tui/guide/content/tls.py:73
#: src/omega_serv/interfaces/tui/guide/content/tls.py:80
#: src/omega_serv/interfaces/tui/guide/content/tls.py:87
msgid "Écrit sur disque immédiatement."
msgstr "Сразу записывается на диск."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:62
msgid "Organisation / Unité / Ville / Région / Pays"
msgstr "Организация / Подразделение / Город / Регион / Страна"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:63
msgid "Champs d'identité du certificat (sujet X.509)."
msgstr "Поля идентификации сертификата (субъект X.509)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:64
msgid ""
"Chaînes libres, tous optionnels sauf Organisation (pré-rempli : OMEGA-SERV)."
msgstr ""
"Произвольные строки, все необязательны, кроме Организации (заполнено: OMEGA-"
"SERV)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:69
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:92
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:55
msgid "Validité en jours"
msgstr "Срок действия в днях"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:70
msgid "Durée de validité du certificat généré."
msgstr "Срок действия генерируемого сертификата."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:71
msgid "Entier positif, en jours. Valeur par défaut : 365."
msgstr "Положительное целое, в днях. Значение по умолчанию: 365."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:76
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:113
msgid "Type de clé"
msgstr "Тип ключа"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:77
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:114
msgid "Algorithme et taille de la clé privée générée."
msgstr "Алгоритм и размер генерируемого закрытого ключа."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:78
msgid ""
"Valeurs valides indiquées dans le sous-titre. Valeur par défaut : rsa2048."
msgstr ""
"Допустимые значения указаны в подзаголовке. Значение по умолчанию: rsa2048."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:83
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:59
msgid "Mot de passe de clé (optionnel)"
msgstr "Пароль ключа (необязательно)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:84
msgid "Passphrase protégeant la clé privée générée."
msgstr "Парольная фраза, защищающая генерируемый закрытый ключ."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:85
msgid "Chaîne libre, optionnelle - saisie masquée."
msgstr "Произвольная строка, необязательно - скрытый ввод."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:91
msgid ""
"Génère réellement des fichiers sur disque des le clic sur Générer. Si TLS "
"est DÉJÀ actif, le serveur en cours d'exécution continue de servir l'ANCIEN "
"certificat jusqu'à un REDÉMARRAGE COMPLET, même si le fichier a changé (le "
"contexte SSL n'est construit qu'une seule fois au démarrage)."
msgstr ""
"Реально создаёт файлы на диске сразу при нажатии Сгенерировать. Если TLS УЖЕ"
" включён, работающий сервер продолжает отдавать СТАРЫЙ сертификат до ПОЛНОГО"
" ПЕРЕЗАПУСКА, даже если файл изменился (контекст SSL создаётся только один "
"раз при запуске)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:100
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:57
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:30
msgid "Assistant CA locale"
msgstr "Мастер локального CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:101
msgid "Configuration détaillée -> TLS -> Assistant CA locale"
msgstr "Подробная настройка -> TLS -> Мастер локального CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:103
msgid ""
"Enchaîne trois étapes indépendantes : générer une autorité de certification "
"locale, générer une demande de signature (CSR) pour ce serveur, signer cette"
" CSR avec la CA - permet d'obtenir un certificat reconnu par les clients "
"ayant importe la CA, sans passer par une autorité publique."
msgstr ""
"Объединяет три независимых шага: создать локальный удостоверяющий центр, "
"создать запрос на подпись (CSR) для этого сервера, подписать этот CSR этим "
"CA - позволяет получить сертификат, признаваемый клиентами, импортировавшими"
" CA, без обращения к публичному центру."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:110
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:61
msgid "1. Générer la CA"
msgstr "1. Создать CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:111
msgid "Crée l'autorité de certification locale (clé + certificat racine)."
msgstr "Создаёт локальный удостоверяющий центр (ключ + корневой сертификат)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:112
msgid ""
"CN, organisation, validité (défaut 3650 jours), type de clé, passphrase "
"OBLIGATOIRE (saisie deux fois)."
msgstr ""
"CN, организация, срок действия (по умолчанию 3650 дней), тип ключа, "
"ОБЯЗАТЕЛЬНАЯ парольная фраза (вводится дважды)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:113
msgid ""
"Écrit root-ca.key/root-ca.pem/serial.txt/index.txt sous "
"secure/certificates/ca/."
msgstr ""
"Записывает root-ca.key/root-ca.pem/serial.txt/index.txt в "
"secure/certificates/ca/."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:114
msgid "Écrit réellement sur disque immédiatement. À faire une seule fois."
msgstr "Сразу реально записывает на диск. Выполняется один раз."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:117
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:63
msgid "2. Générer la CSR"
msgstr "2. Создать CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:118
msgid "Crée une demande de signature de certificat pour CE serveur."
msgstr "Создаёт запрос на подпись сертификата для ЭТОГО сервера."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:119
msgid "CN, SAN DNS/IP, identité, type de clé - pas de passphrase ici."
msgstr "CN, SAN DNS/IP, идентификация, тип ключа - без парольной фразы."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:120
msgid "Écrit le fichier .csr à côté de la clé privée du serveur."
msgstr "Записывает файл .csr рядом с закрытым ключом сервера."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:121
msgid "Écrit réellement sur disque immédiatement."
msgstr "Сразу реально записывает на диск."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:124
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:65
msgid "3. Signer la CSR"
msgstr "3. Подписать CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:125
msgid ""
"Signe la CSR générée à l'étape 2 avec la CA de l'étape 1, produit le "
"certificat final."
msgstr ""
"Подписывает CSR из шага 2 с помощью CA из шага 1, создаёт итоговый "
"сертификат."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:126
msgid ""
"Chemin de la CSR (pré-rempli), passphrase de la CA (resaisie), validité en "
"jours (défaut 365)."
msgstr ""
"Путь к CSR (заполнен), парольная фраза CA (вводится снова), срок действия в "
"днях (по умолчанию 365)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:127
msgid "Écrit le certificat signé (et la chaîne complète) sur disque."
msgstr "Записывает подписанный сертификат (и полную цепочку) на диск."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:129
msgid ""
"Écrit réellement sur disque immédiatement. Si TLS est DÉJÀ actif, un "
"REDÉMARRAGE COMPLET reste nécessaire pour que le serveur serve ce nouveau "
"certificat (le contexte SSL en mémoire ne se recharge jamais tout seul)."
msgstr ""
"Сразу реально записывает на диск. Если TLS УЖЕ включён, всё равно нужен "
"ПОЛНЫЙ ПЕРЕЗАПУСК, чтобы сервер отдавал этот новый сертификат (контекст SSL "
"в памяти никогда не перезагружается сам)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:136
msgid ""
"Le certificat racine de la CA (root-ca.pem) doit être importe manuellement "
"dans le magasin de confiance de chaque client pour que le certificat final "
"soit reconnu - rappelé dans le journal de l'assistant après chaque étape "
"réussie."
msgstr ""
"Корневой сертификат CA (root-ca.pem) нужно вручную импортировать в хранилище"
" доверенных сертификатов каждого клиента, чтобы итоговый сертификат "
"признавался - напоминание выводится в журнале мастера после каждого "
"успешного шага."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:142
msgid ""
"La passphrase de la CA n'est jamais conservée en mémoire entre les étapes - "
"elle est resaisie explicitement à l'étape 3."
msgstr ""
"Парольная фраза CA никогда не хранится в памяти между шагами - на шаге 3 она"
" вводится заново явно."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:150
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:58
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:31
msgid "Assistant Let's Encrypt (Certbot)"
msgstr "Мастер Let's Encrypt (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:151
msgid "Configuration détaillée -> TLS -> Assistant Let's Encrypt (Certbot)"
msgstr "Подробная настройка -> TLS -> Мастер Let's Encrypt (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:153
msgid ""
"Obtient un certificat public reconnu par les navigateurs via Certbot (défi "
"HTTP-01, mode webroot) - jamais --standalone (le port 80 est déjà occupé par"
" OMEGA-SERV) et jamais /etc/letsencrypt/ (tout est écrit sous "
"secure/certificates/letsencrypt/ du projet, entièrement non-privilégié). "
"Importe automatiquement le certificat obtenu et installe un script de "
"renouvellement (voir Renouvellement automatique (Certbot))."
msgstr ""
"Получает публичный сертификат, признаваемый браузерами, через Certbot "
"(проверка HTTP-01, режим webroot) - никогда --standalone (порт 80 уже занят "
"OMEGA-SERV) и никогда /etc/letsencrypt/ (всё записывается в "
"secure/certificates/letsencrypt/ проекта, полностью без привилегий). "
"Автоматически импортирует полученный сертификат и устанавливает скрипт "
"продления (см. Автоматическое продление (Certbot))."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:161
msgid "Domaine"
msgstr "Домен"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:162
msgid "Nom de domaine public déjà pointé vers ce serveur (obligatoire)."
msgstr ""
"Публичное доменное имя, уже направленное на этот сервер (обязательно)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:163
msgid ""
"Ex : monserveur.dynu.com - un DDNS (Dynu ou équivalent) reste à configurer "
"par vous-même, hors de cet assistant."
msgstr ""
"Напр.: myserver.dynu.com - DDNS (Dynu или аналог) настраивается вами "
"самостоятельно, вне этого мастера."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:164
msgid "Utilisé pour la demande Certbot et le défi HTTP-01."
msgstr "Используется для запроса Certbot и проверки HTTP-01."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:165
msgid ""
"Aucun effet avant confirmation - le résumé préalable rappelle le domaine et "
"le mode choisis."
msgstr ""
"Без эффекта до подтверждения - предварительная сводка напоминает выбранные "
"домен и режим."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:168
msgid "Email"
msgstr "Email"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:169
msgid ""
"Adresse utilisée par Let's Encrypt pour les alertes d'expiration "
"(optionnelle)."
msgstr ""
"Адрес, по которому Let's Encrypt присылает предупреждения об истечении "
"(необязательно)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:170
msgid ""
"Chaîne libre. Vide : Certbot s'enregistre sans email (--register-unsafely-"
"without-email)."
msgstr ""
"Произвольная строка. Пусто: Certbot регистрируется без email (--register-"
"unsafely-without-email)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:171
msgid "Transmis à Certbot à la demande."
msgstr "Передаётся Certbot при запросе."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:172
msgid "Aucun effet avant confirmation."
msgstr "Без эффекта до подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:175
msgid "Mode test (staging)"
msgstr "Тестовый режим (staging)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:176
msgid ""
"Utilise l'environnement de test de Let's Encrypt plutôt que la production."
msgstr "Использует тестовую среду Let's Encrypt вместо рабочей."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:177
msgid ""
"Case à cocher, COCHÉE PAR DÉFAUT - certificat non reconnu par les "
"navigateurs mais jamais soumis aux limites de taux réelles."
msgstr ""
"Флажок, УСТАНОВЛЕН ПО УМОЛЧАНИЮ - сертификат не признаётся браузерами, но "
"реальные ограничения частоты к нему никогда не применяются."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:178
msgid "Transmis à Certbot (--staging) si coché."
msgstr "Передаётся Certbot (--staging), если установлен."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:179
msgid ""
"À décocher seulement une fois le domaine/webroot vérifiés fonctionnels en "
"mode test."
msgstr ""
"Снимайте только после того, как домен/webroot проверены в тестовом режиме."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:182
#: src/omega_serv/interfaces/tui/screens/lets_encrypt_screen.py:70
msgid "Obtenir le certificat"
msgstr "Получить сертификат"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:183
msgid "Lance la demande après un résumé et une confirmation explicite."
msgstr "Запускает запрос после сводки и явного подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:184
msgid "Aucune saisie - déclenche l'appel réseau réel à Let's Encrypt."
msgstr "Ввода нет - запускает реальное сетевое обращение к Let's Encrypt."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:185
msgid ""
"Exécute Certbot puis importe le certificat obtenu (déporté dans un thread de"
" travail, l'interface reste réactive)."
msgstr ""
"Выполняет Certbot, затем импортирует полученный сертификат (в рабочем "
"потоке, интерфейс остаётся отзывчивым)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:187
msgid ""
"Écrit réellement sur disque en cas de succès. Si TLS est DÉJÀ actif, le "
"serveur en cours d'exécution continue de servir l'ANCIEN certificat jusqu'à "
"un REDÉMARRAGE COMPLET."
msgstr ""
"При успехе реально записывает на диск. Если TLS УЖЕ включён, работающий "
"сервер продолжает отдавать СТАРЫЙ сертификат до ПОЛНОГО ПЕРЕЗАПУСКА."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:194
msgid ""
"Le port 80 doit rester accessible depuis Internet le temps du défi HTTP-01 "
"(webroot) - échoue sinon (pare-feu, redirection de port non faite sur le "
"routeur, DNS/DDNS pas encore propagé). Soumis aux limites de taux réelles de"
" Let's Encrypt en mode production (jamais en mode test)."
msgstr ""
"Порт 80 должен оставаться доступным из Интернета на время проверки HTTP-01 "
"(webroot) - иначе ошибка (межсетевой экран, не настроено перенаправление "
"порта на маршрутизаторе, DNS/DDNS ещё не распространился). В рабочем режиме "
"действуют реальные ограничения частоты Let's Encrypt (в тестовом - никогда)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:201
msgid ""
"Le DDNS (Dynu ou équivalent) et la redirection de port restent ENTIÈREMENT à"
" votre charge - cet assistant ne configure jamais rien en dehors de ce "
"serveur."
msgstr ""
"DDNS (Dynu или аналог) и перенаправление порта остаются ПОЛНОСТЬЮ на вас - "
"этот мастер никогда ничего не настраивает за пределами этого сервера."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:205
msgid ""
"Si OMEGA-SERV tourne dans un conteneur : exécutez cet assistant HORS du "
"conteneur qui sert le trafic (sur l'hôte, ou un conteneur/sidecar distinct "
"partageant le même volume secure/ et le même webroot) - jamais Certbot à "
"l'intérieur du conteneur servant déjà le trafic public, voir la FAQ."
msgstr ""
"Если OMEGA-SERV работает в контейнере: запускайте этот мастер ВНЕ "
"контейнера, обслуживающего трафик (на хосте или в отдельном "
"контейнере/sidecar с тем же томом secure/ и тем же webroot) - никогда не "
"запускайте Certbot внутри контейнера, уже обслуживающего публичный трафик, "
"см. FAQ."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:215
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:59
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:32
msgid "Renouvellement automatique (Certbot)"
msgstr "Автоматическое продление (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:216
msgid "Configuration détaillée -> TLS -> Renouvellement automatique (Certbot)"
msgstr "Подробная настройка -> TLS -> Автоматическое продление (Certbot)"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:218
msgid ""
"Planifie le renouvellement automatique des certificats Certbot déjà obtenus "
"(Assistant Let's Encrypt) - s'adapte au gestionnaire de service réellement "
"détecté pour CETTE instance : timer systemd installé depuis l'interface, "
"sinon une ligne crontab si possible, sinon des instructions manuelles "
"affichées sans rien écrire. Jamais un mécanisme global partagé entre "
"plusieurs instances multi-instance."
msgstr ""
"Планирует автоматическое продление уже полученных сертификатов Certbot "
"(Мастер Let's Encrypt) - подстраивается под менеджер служб, реально "
"обнаруженный для ЭТОГО экземпляра: таймер systemd, устанавливаемый из "
"интерфейса, иначе строка crontab, если возможно, иначе ручные инструкции без"
" какой-либо записи. Никогда не общий механизм для нескольких экземпляров."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:226
#: src/omega_serv/interfaces/tui/screens/renewal_schedule_screen.py:51
msgid "Configurer maintenant"
msgstr "Настроить сейчас"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:227
msgid ""
"Installe (ou réinstalle) le mécanisme de renouvellement adapté à ce système."
msgstr ""
"Устанавливает (или переустанавливает) механизм продления, подходящий для "
"этой системы."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:230
msgid ""
"systemd : écrit et active un timer (sudo ponctuel, même mécanisme que "
"l'écran SERVICE). OpenRC/runit/aucun gestionnaire reconnu : ajoute une ligne"
" à votre crontab utilisateur si `crontab` est disponible, sinon affiche la "
"ligne à ajouter vous-même."
msgstr ""
"systemd: записывает и включает таймер (разовый sudo, тот же механизм, что на"
" экране СЛУЖБА). OpenRC/runit/менеджер не распознан: добавляет строку в ваш "
"пользовательский crontab, если `crontab` доступен, иначе показывает строку, "
"которую нужно добавить самостоятельно."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:235
msgid ""
"Reconfigurer ne dupliqué jamais l'entrée (idempotent) - remplace toujours "
"l'entrée précédente de CETTE instance."
msgstr ""
"Повторная настройка никогда не дублирует запись (идемпотентно) - всегда "
"заменяет предыдущую запись ЭТОГО экземпляра."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:239
msgid ""
"Une fois installé, le renouvellement tourne deux fois par jour sans aucune "
"intervention - le script de hook (Assistant Let's Encrypt) réimporte "
"automatiquement chaque certificat renouvelé puis redémarre le service."
msgstr ""
"После установки продление выполняется дважды в день без какого-либо "
"вмешательства - скрипт hook (Мастер Let's Encrypt) автоматически заново "
"импортирует каждый продлённый сертификат и затем перезапускает службу."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:245
msgid ""
"Sur certaines distributions (dont Arch/Manjaro), le paquet Certbot "
"n'installe AUCUN timer par défaut, contrairement à Debian/Ubuntu - vérifiez "
"toujours le statut affiché ici plutôt que de supposer qu'un mécanisme existe"
" déjà."
msgstr ""
"В некоторых дистрибутивах (в том числе Arch/Manjaro) пакет Certbot по "
"умолчанию НЕ устанавливает таймер, в отличие от Debian/Ubuntu - всегда "
"проверяйте показанное здесь состояние, а не предполагайте, что механизм уже "
"есть."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:250
msgid ""
"Ne concerne QUE les certificats gérés par Certbot "
"(secure/certificates/letsencrypt/) - un certificat auto-signé ou signé par "
"la CA locale n'a pas besoin (et ne bénéficie pas) de ce renouvellement."
msgstr ""
"Касается ТОЛЬКО сертификатов, управляемых Certbot "
"(secure/certificates/letsencrypt/) - самоподписанный сертификат или "
"подписанный локальным CA в этом продлении не нуждается (и не получает его)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:259
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:60
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:33
msgid "Révoquer un certificat"
msgstr "Отозвать сертификат"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:260
msgid "Configuration détaillée -> TLS -> Révoquer un certificat"
msgstr "Подробная настройка -> TLS -> Отозвать сертификат"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:261
msgid ""
"Marque un certificat comme révoqué dans le registre de la CA (index.txt) - "
"action irréversible pour ce certificat."
msgstr ""
"Помечает сертификат как отозванный в реестре CA (index.txt) - необратимое "
"действие для этого сертификата."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:264
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:40
msgid "Certificat à révoquer"
msgstr "Сертификат для отзыва"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:265
msgid "Chemin du certificat à marquer comme révoqué."
msgstr "Путь к сертификату, помечаемому как отозванный."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:266
msgid "Chemin relatif au projet."
msgstr "Путь относительно проекта."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:267
#: src/omega_serv/interfaces/tui/guide/content/tls.py:274
#: src/omega_serv/interfaces/tui/guide/content/tls.py:281
msgid "Utilisé à la confirmation."
msgstr "Используется при подтверждении."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:268
msgid "Modifie index.txt immédiatement après confirmation."
msgstr "Изменяет index.txt сразу после подтверждения."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:271
msgid "Clé / Certificat de la CA"
msgstr "Ключ / Сертификат CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:272
msgid ""
"Identité de l'autorité de certification qui a signé le certificat visé."
msgstr "Удостоверяющий центр, подписавший целевой сертификат."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:273
msgid "Chemins pré-remplis vers secure/certificates/ca/."
msgstr "Пути заполнены значениями secure/certificates/ca/."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:275
#: src/omega_serv/interfaces/tui/guide/content/tls.py:282
msgid "Modifie index.txt immédiatement."
msgstr "Сразу изменяет index.txt."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:278
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:127
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:52
msgid "Passphrase de la clé CA"
msgstr "Парольная фраза ключа CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:279
msgid "Nécessaire pour prouver l'autorité sur la CA avant de révoquer."
msgstr "Нужна, чтобы подтвердить полномочия над CA перед отзывом."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:280
msgid "Saisie masquée."
msgstr "Скрытый ввод."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:286
msgid ""
"Demande une confirmation explicite (action irréversible pour ce certificat)."
" Si le certificat révoqué est celui ACTUELLEMENT utilisé par un serveur TLS "
"déjà actif, un REDÉMARRAGE COMPLET est nécessaire, sinon il continue d'être "
"présenté aux clients malgré sa révocation."
msgstr ""
"Запрашивает явное подтверждение (необратимое действие для этого "
"сертификата). Если отзываемый сертификат СЕЙЧАС используется уже включённым "
"TLS-сервером, нужен ПОЛНЫЙ ПЕРЕЗАПУСК, иначе он продолжает предъявляться "
"клиентам несмотря на отзыв."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:293
msgid ""
"Pas de distribution CRL complète en V1 - la révocation reste locale "
"(index.txt), jamais publiée vers les clients automatiquement."
msgstr ""
"Полного распространения CRL в V1 нет - отзыв остаётся локальным (index.txt) "
"и никогда не публикуется клиентам автоматически."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:301
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:61
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:34
msgid "Activer / désactiver TLS"
msgstr "Включить / отключить TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:302
msgid "Configuration détaillée -> TLS -> Activer / désactiver TLS"
msgstr "Подробная настройка -> TLS -> Включить / отключить TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:303
msgid ""
"Active ou désactive TLS, et choisit son mode (direct ou derrière un proxy "
"qui termine déjà le TLS)."
msgstr ""
"Включает или отключает TLS и выбирает его режим (прямой или за прокси, "
"который уже завершает TLS)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:307
msgid "Comment TLS est géré par ce serveur."
msgstr "Как этот сервер работает с TLS."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:309
msgid ""
"direct (ce serveur termine TLS lui-même, via ssl.SSLContext local) ou "
"behind_proxy (TLS déjà terminé en amont, ce serveur reste en HTTP simple)."
msgstr ""
"direct (этот сервер сам завершает TLS через локальный ssl.SSLContext) или "
"behind_proxy (TLS уже завершён выше, этот сервер остаётся на обычном HTTP)."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:312
msgid "Enregistre au clic sur Activer TLS."
msgstr "Сохраняет при нажатии Включить TLS."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:313
msgid ""
"Nécessite TOUJOURS un REDÉMARRAGE COMPLET, jamais un simple rechargement."
msgstr "ВСЕГДА требует ПОЛНОГО ПЕРЕЗАПУСКА, никогда не простой перезагрузки."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:316
msgid "Chemin du certificat / de la clé privée"
msgstr "Путь к сертификату / закрытому ключу"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:317
msgid ""
"Fichiers utilisés si le mode est 'direct'. Optionnels : conservent la valeur"
" actuelle si vides."
msgstr ""
"Файлы, используемые в режиме 'direct'. Необязательно: если пусто, "
"сохраняется текущее значение."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:318
msgid "Chemins relatifs au projet."
msgstr "Пути относительно проекта."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:320
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET."
msgstr "ВСЕГДА требует ПОЛНОГО ПЕРЕЗАПУСКА."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:324
msgid ""
"Le contexte SSL n'est construit qu'une seule fois au démarrage - activer, "
"désactiver, ou changer le mode TLS exige SYSTÉMATIQUEMENT un redémarrage "
"complet, que ce soit pour l'activation ou la désactivation."
msgstr ""
"Контекст SSL создаётся только один раз при запуске - включение, отключение "
"или смена режима TLS ВСЕГДА требуют полного перезапуска, как при включении, "
"так и при отключении."

#: src/omega_serv/interfaces/tui/guide/content/tls.py:330
msgid ""
"À ne pas confondre avec le réglage 'reverse_proxy' (Configuration détaillée "
"-> Reverse Proxy) : ici, 'behind_proxy' signifie qu'OMEGA-SERV est DERRIÈRE "
"un proxy TLS externe, l'inverse d'agir soi-même comme proxy."
msgstr ""
"Не путайте с настройкой 'reverse_proxy' (Подробная настройка -> Обратный "
"прокси): здесь 'behind_proxy' означает, что OMEGA-SERV находится ЗА внешним "
"TLS-прокси, в отличие от работы самим прокси."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:10
msgid "Assistant premier lancement - 1/8 Bienvenue"
msgstr "Мастер первого запуска - 1/8 Добро пожаловать"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:11
msgid "Accueil -> Assistant premier lancement"
msgstr "Главная -> Мастер первого запуска"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:13
msgid ""
"Point d'entrée de l'assistant guide qui compose une première configuration "
"complète, étape par étape."
msgstr ""
"Точка входа пошагового мастера, составляющего полную первую конфигурацию."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:18
#: src/omega_serv/interfaces/tui/screens/wizard_welcome_screen.py:42
msgid "Commencer"
msgstr "Начать"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:19
msgid "Démarre le parcours guide."
msgstr "Запускает пошаговый путь."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:20
msgid "Aucune saisie à cette étape."
msgstr "На этом шаге ввода нет."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:21
msgid "Ouvre l'étape 2/8 (Registre des capacités)."
msgstr "Открывает шаг 2/8 (Реестр возможностей)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:22
msgid "Aucun effet sur disque - rien n'est écrit avant l'étape 7 (Résumé)."
msgstr "Без эффекта на диск - до шага 7 (Сводка) ничего не записывается."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:25
msgid "Aucune - purement informatif."
msgstr "Нет - только для информации."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:30
msgid "Assistant premier lancement - 2/8 Capacités"
msgstr "Мастер первого запуска - 2/8 Возможности"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:31
msgid "Assistant premier lancement -> étape 2/8"
msgstr "Мастер первого запуска -> шаг 2/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:33
msgid ""
"Scan en lecture seule de l'environnement (port par défaut déjà occupé, "
"openssl présent...), avec le port par défaut - aucun profil ni port "
"personnalisé n'est encore choisi."
msgstr ""
"Сканирование окружения только для чтения (порт по умолчанию уже занят, "
"наличие openssl...) с портом по умолчанию - ни профиль, ни свой порт ещё не "
"выбраны."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:38
msgid "Suivant / Précédent"
msgstr "Далее / Назад"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:39
msgid "Navigation entre les étapes."
msgstr "Переход между шагами."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:40
msgid "Aucune saisie à cette étape (table en lecture seule)."
msgstr "На этом шаге ввода нет (таблица только для чтения)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:41
msgid "Suivant ouvre l'étape 3/8 (Profil)."
msgstr "Далее открывает шаг 3/8 (Профиль)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:42
msgid "Aucun effet - purement informatif."
msgstr "Без эффекта - только для информации."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:50
msgid "Assistant premier lancement - 3/8 Profil"
msgstr "Мастер первого запуска - 3/8 Профиль"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:51
msgid "Assistant premier lancement -> étape 3/8"
msgstr "Мастер первого запуска -> шаг 3/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:52
msgid "Choix d'un profil de base parmi les quatre profils preconfigures."
msgstr "Выбор базового профиля из четырёх предустановленных."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:55
msgid "Table des profils"
msgstr "Таблица профилей"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:56
msgid "Liste des profils disponibles avec leur description au clic."
msgstr "Список доступных профилей, описание по щелчку."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:57
msgid "4 profils : minimal, standard, hardened, development."
msgstr "4 профиля: minimal, standard, hardened, development."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:58
msgid ""
"Sélectionner une ligne affiche sa description et active le bouton Suivant."
msgstr "Выбор строки показывает её описание и активирует кнопку Далее."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:59
msgid ""
"Le profil choisi est appliqué à la CONFIGURATION CANDIDATE EN MÉMOIRE "
"uniquement."
msgstr ""
"Выбранный профиль применяется ТОЛЬКО К КАНДИДАТНОЙ КОНФИГУРАЦИИ В ПАМЯТИ."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:62
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:86
msgid "Rien n'est encore écrit sur disque à cette étape."
msgstr "На этом шаге на диск ещё ничего не записано."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:67
msgid "Assistant premier lancement - 4/8 Configuration de base"
msgstr "Мастер первого запуска - 4/8 Базовая настройка"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:68
msgid "Assistant premier lancement -> étape 4/8"
msgstr "Мастер первого запуска -> шаг 4/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:69
msgid ""
"Ajuste uniquement l'adresse d'écoute et le port - le reste vient du profil "
"choisi."
msgstr ""
"Настраивает только адрес прослушивания и порт - остальное берётся из "
"выбранного профиля."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:72
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:56
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:130
#: src/omega_serv/interfaces/tui/screens/wizard_base_config_screen.py:36
msgid "Adresse d'écoute (server.bind)"
msgstr "Адрес прослушивания (server.bind)"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:73
msgid "Adresse IP sur laquelle le serveur écoutera."
msgstr "IP-адрес, на котором будет слушать сервер."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:74
msgid "Une adresse IP valide. Pré-remplie avec la valeur du profil choisi."
msgstr "Допустимый IP-адрес. Заполнен значением выбранного профиля."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:75
msgid "Validée (structurellement) au clic sur Suivant."
msgstr "Проверяется (структурно) при нажатии Далее."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:76
msgid ""
"En mémoire uniquement à ce stade - voir l'étape 7 pour l'écriture réelle."
msgstr "На этом этапе только в памяти - реальную запись см. на шаге 7."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:79
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:58
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:131
#: src/omega_serv/interfaces/tui/screens/wizard_base_config_screen.py:38
msgid "Port (server.port)"
msgstr "Порт (server.port)"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:81
msgid "Un entier de port valide. Pré-rempli avec la valeur du profil choisi."
msgstr "Допустимое целое число порта. Заполнено значением выбранного профиля."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:82
msgid "Validé au clic sur Suivant."
msgstr "Проверяется при нажатии Далее."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:83
msgid "En mémoire uniquement à ce stade."
msgstr "На этом этапе только в памяти."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:91
msgid "Assistant premier lancement - 5/8 TLS"
msgstr "Мастер первого запуска - 5/8 TLS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:92
msgid "Assistant premier lancement -> étape 5/8"
msgstr "Мастер первого запуска -> шаг 5/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:94
msgid ""
"Propose de générer un certificat auto-signé et d'activer TLS - jamais force,"
" et jamais proposé du tout si le profil choisi est 'development'."
msgstr ""
"Предлагает сгенерировать самоподписанный сертификат и включить TLS - никогда"
" принудительно и вообще не предлагается, если выбран профиль 'development'."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:100
msgid ""
"Nom commun (Common Name) du certificat - généralement le nom d'hôte du "
"serveur."
msgstr "Общее имя (Common Name) сертификата - обычно имя хоста сервера."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:101
msgid "Chaîne libre, ex: mon-serveur.local."
msgstr "Произвольная строка, напр.: my-server.local."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:102
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:109
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:116
msgid "Utilisé au clic sur 'Générer et activer TLS'."
msgstr "Используется при нажатии 'Сгенерировать и включить TLS'."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:103
msgid ""
"Génère réellement le certificat sur disque immédiatement (pas différé à "
"l'étape 7)."
msgstr ""
"Сразу реально генерирует сертификат на диске (не откладывается до шага 7)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:106
msgid "SAN DNS"
msgstr "SAN DNS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:107
msgid ""
"Noms DNS alternatifs couverts par le certificat (Subject Alternative Name)."
msgstr ""
"Альтернативные DNS-имена, охватываемые сертификатом (Subject Alternative "
"Name)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:108
msgid "Liste séparée par des virgules, optionnelle."
msgstr "Список через запятую, необязательно."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:110
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:117
msgid "Génère réellement le certificat sur disque immédiatement."
msgstr "Сразу реально генерирует сертификат на диске."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:115
msgid ""
"Valeurs valides listées dans le sous-titre du champ. Valeur par défaut : "
"rsa2048."
msgstr ""
"Допустимые значения указаны в подзаголовке поля. Значение по умолчанию: "
"rsa2048."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:121
msgid ""
"Générer un certificat ici écrit réellement des fichiers sur disque tout de "
"suite (contrairement au reste de l'assistant) - active tls.enabled en "
"mémoire pour la suite du parcours, écrit dans la configuration finale à "
"l'étape 7."
msgstr ""
"Генерация сертификата здесь сразу реально записывает файлы на диск (в "
"отличие от остальной части мастера) - включает tls.enabled в памяти для "
"дальнейшего пути, в итоговую конфигурацию записывается на шаге 7."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:126
msgid ""
"Cette étape est entièrement absente pour le profil 'development' - remplacée"
" par un simple message."
msgstr ""
"Для профиля 'development' этот шаг полностью отсутствует - вместо него "
"простое сообщение."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:132
msgid "Assistant premier lancement - 6/8 Vérification"
msgstr "Мастер первого запуска - 6/8 Проверка"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:133
msgid "Assistant premier lancement -> étape 6/8"
msgstr "Мастер первого запуска -> шаг 6/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:135
msgid ""
"Vérification automatique (structurelle puis environnement réel) avant de "
"pouvoir continuer - les mêmes deux couches que l'écran 'Vérifier la "
"configuration'."
msgstr ""
"Автоматическая проверка (структурная, затем реального окружения) перед "
"продолжением - те же два слоя, что на экране 'Проверить конфигурацию'."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:140
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:36
msgid "Confirmer : bind public + certificat auto-signé"
msgstr "Подтвердить: публичный bind + самоподписанный сертификат"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:142
msgid ""
"Porte de confirmation explicite requise pour continuer si le serveur écoute "
"publiquement avec un certificat auto-signé (jamais reconnu par les "
"navigateurs)."
msgstr ""
"Явное подтверждение, необходимое для продолжения, если сервер слушает "
"публично с самоподписанным сертификатом (никогда не признаётся браузерами)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:145
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:155
msgid "À cocher uniquement si cette combinaison est réellement voulue."
msgstr "Отмечайте, только если такое сочетание действительно нужно."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:146
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:156
msgid "Pris en compte au prochain clic sur Vérifier."
msgstr "Учитывается при следующем нажатии Проверить."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:147
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:157
msgid ""
"Sans cette confirmation, le bouton Suivant reste désactivé si la situation "
"s'applique."
msgstr ""
"Без этого подтверждения кнопка Далее остаётся неактивной, если ситуация "
"имеет место."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:150
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:37
msgid "Confirmer : authentification sans TLS"
msgstr "Подтвердить: аутентификация без TLS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:152
msgid ""
"Porte de confirmation explicite requise pour continuer si l'authentification"
" est active sans TLS (identifiants transmis en clair)."
msgstr ""
"Явное подтверждение, необходимое для продолжения, если аутентификация "
"включена без TLS (учётные данные передаются открытым текстом)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:160
msgid ""
"Rien n'est encore écrit sur disque à cette étape - seulement des "
"vérifications."
msgstr "На этом шаге на диск ещё ничего не записано - только проверки."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:165
msgid "Assistant premier lancement - 7/8 Résumé"
msgstr "Мастер первого запуска - 7/8 Сводка"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:166
msgid "Assistant premier lancement -> étape 7/8"
msgstr "Мастер первого запуска -> шаг 7/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:168
msgid ""
"Affiche la différence complète entre les valeurs par défaut et la "
"configuration composée par l'assistant, puis écrit réellement le fichier de "
"configuration."
msgstr ""
"Показывает полную разницу между значениями по умолчанию и конфигурацией, "
"составленной мастером, затем реально записывает файл конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:173
#: src/omega_serv/interfaces/tui/screens/wizard_summary_screen.py:40
msgid "Écrire la configuration"
msgstr "Записать конфигурацию"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:174
msgid "Confirme et écrit la configuration composée."
msgstr "Подтверждает и записывает составленную конфигурацию."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:175
msgid "À vérifier attentivement le résumé affiché avant de cliquer."
msgstr "Внимательно проверьте показанную сводку перед нажатием."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:176
msgid ""
"Écrit config/omega-serve.json (une sauvegarde de l'ancien fichier est faite "
"automatiquement s'il existait)."
msgstr ""
"Записывает config/omega-serve.json (резервная копия старого файла создаётся "
"автоматически, если он был)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:177
msgid ""
"C'EST LA PREMIÈRE ÉCRITURE RÉELLE de tout le parcours - ouvre ensuite "
"l'étape 8/8."
msgstr "ЭТО ПЕРВАЯ РЕАЛЬНАЯ ЗАПИСЬ за весь путь - затем открывается шаг 8/8."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:180
msgid ""
"Écrase config/omega-serve.json (avec sauvegarde automatique du fichier "
"précédent s'il existait)."
msgstr ""
"Перезаписывает config/omega-serve.json (с автоматической резервной копией "
"предыдущего файла, если он был)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:185
msgid "Assistant premier lancement - 8/8 Service"
msgstr "Мастер первого запуска - 8/8 Служба"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:186
msgid "Assistant premier lancement -> étape 8/8"
msgstr "Мастер первого запуска -> шаг 8/8"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:187
msgid ""
"La configuration est écrite - propose de lancer le serveur, de l'installer "
"comme service, ou de terminer."
msgstr ""
"Конфигурация записана - предлагает запустить сервер, установить его как "
"службу или завершить."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:190
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:59
msgid "Lancer maintenant"
msgstr "Запустить сейчас"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:191
msgid "Lance réellement le serveur au premier plan, tout de suite."
msgstr "Сразу реально запускает сервер на переднем плане."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:192
msgid "Pour un test immédiat sans installer de service système."
msgstr "Для немедленной проверки без установки системной службы."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:193
msgid ""
"Rend la main au terminal réel et bloque jusqu'à Ctrl+C (ou arrêt du "
"service)."
msgstr ""
"Передаёт управление настоящему терминалу и блокирует до Ctrl+C (или "
"остановки службы)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:194
msgid ""
"Le serveur écoute réellement le temps de cette action - revient à l'accueil "
"à l'arrêt."
msgstr ""
"Сервер реально слушает на время этого действия - после остановки возврат на "
"главную."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:197
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:61
msgid "Installer le service"
msgstr "Установить службу"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:198
msgid ""
"Ouvre l'écran SERVICE pour installer une unité systemd (démarrage "
"automatique)."
msgstr ""
"Открывает экран СЛУЖБА для установки юнита systemd (автоматический запуск)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:199
msgid "Pour un usage durable (le serveur redémarre avec la machine)."
msgstr "Для постоянного использования (сервер запускается вместе с машиной)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:200
msgid "Ouvre l'écran SERVICE."
msgstr "Открывает экран СЛУЖБА."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:201
msgid "Voir la fiche SERVICE - une authentification (sudo) sera demandée."
msgstr "См. карточку СЛУЖБА - будет запрошена аутентификация (sudo)."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:204
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:63
msgid "Terminer"
msgstr "Завершить"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:205
msgid "Quitte l'assistant sans rien lancer."
msgstr "Выходит из мастера, ничего не запуская."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:206
msgid "À choisir si vous comptez lancer le serveur plus tard manuellement."
msgstr "Выберите, если планируете запустить сервер позже вручную."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:207
msgid "Revient à l'accueil."
msgstr "Возвращает на главную."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:208
msgid ""
"Le serveur ne tourne pas - `omega-serv.sh serve` (CLI) reste à lancer "
"manuellement."
msgstr ""
"Сервер не запущен - `omega-serv.sh serve` (CLI) нужно запустить вручную."

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:211
msgid ""
"La configuration est déjà écrite depuis l'étape précédente - cet écran ne "
"fait que décider comment démarrer."
msgstr ""
"Конфигурация уже записана на предыдущем шаге - этот экран лишь решает, как "
"запускать."

