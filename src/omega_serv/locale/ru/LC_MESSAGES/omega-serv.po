#: src/omega_serv/interfaces/tui/screens/home.py:93
msgid "Gestion des logs"
msgstr "Управление журналами"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:46
msgid ""
"Consultation, suivi en direct, rotation/archivage et statistiques des "
"journaux."
msgstr ""
"Просмотр, отслеживание в реальном времени, ротация/архивирование и "
"статистика журналов."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:47
msgid "Consultation et maintenance des logs."
msgstr "Просмотр и обслуживание журналов."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:48
msgid "Ouvre le menu de gestion des logs."
msgstr "Открывает меню управления журналами."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:52
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:52
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:77
#: src/omega_serv/interfaces/tui/screens/home.py:82
