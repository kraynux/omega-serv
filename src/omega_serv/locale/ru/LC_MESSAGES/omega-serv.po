msgid "Profils"
msgstr "Профили"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:32
msgid ""
"Quatre profils de base preconfigures "
"(minimal/standard/hardened/development)."
msgstr ""
"Четыре предустановленных базовых профиля "
"(minimal/standard/hardened/development)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:33
msgid "Consultation puis application optionnelle."
msgstr "Просмотр, затем необязательное применение."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:34
msgid "Ouvre l'écran des profils."
msgstr "Открывает экран профилей."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:35
msgid ""
"Appliquer un profil ÉCRASE la configuration active - voir sa propre fiche."
msgstr ""
"Применение профиля ПЕРЕЗАПИСЫВАЕТ активную конфигурацию - см. его "
"собственную карточку."

