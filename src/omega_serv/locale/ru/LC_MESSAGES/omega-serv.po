msgstr "Мастер первого запуска"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:18
msgid ""
"Parcours guide en 8 étapes pour composer et écrire une première "
"configuration."
msgstr ""
"Пошаговый путь из 8 шагов для составления и записи первой конфигурации."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:19
msgid ""
"À utiliser une seule fois, au tout premier démarrage (ou pour repartir de "
"zéro)."
msgstr ""
"Используется один раз, при самом первом запуске (или чтобы начать с нуля)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:20
msgid "Ouvre l'assistant."
msgstr "Открывает мастер."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:21
msgid ""
"Aucun effet tant que l'étape 7 (Résumé) n'a pas été validée - rien n'est "
"écrit avant."
msgstr ""
"Без эффекта, пока не подтверждён шаг 7 (Сводка) - до этого ничего не "
"записывается."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:24
#: src/omega_serv/interfaces/tui/guide/content/divers.py:11
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:32
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:33
#: src/omega_serv/interfaces/tui/screens/home.py:81
msgid "Registre des capacités"
msgstr "Реестр возможностей"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:25
msgid ""
"Scan en lecture seule de l'environnement (port libre, openssl présent, PHP-"
"FPM...)."
msgstr ""
"Сканирование окружения только для чтения (свободный порт, наличие openssl, "
"PHP-FPM...)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:26
msgid "Consultation uniquement."
msgstr "Только просмотр."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:27
msgid "Ouvre le registre des capacités."
msgstr "Открывает реестр возможностей."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:28
#: src/omega_serv/interfaces/tui/guide/content/accueil.py:86
