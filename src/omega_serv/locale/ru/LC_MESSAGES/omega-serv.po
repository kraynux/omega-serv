#: src/omega_serv/interfaces/tui/screens/log_simple_viewer_screen.py:89
#: src/omega_serv/interfaces/tui/widgets/log_library_table.py:32
msgid "Service"
msgstr "Служба"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:53
msgid ""
"Pilotage du service système "
"(demarrer/arreter/redemarrer/recharger/installer)."
msgstr ""
"Управление системной службой "
"(запуск/остановка/перезапуск/перезагрузка/установка)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:54
msgid "À utiliser pour piloter le serveur en tant que service système."
msgstr "Для управления сервером как системной службой."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:55
msgid "Ouvre l'écran Service."
msgstr "Открывает экран Служба."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:56
msgid ""
"Voir sa propre fiche - certaines actions demandent une authentification "
"(sudo)."
msgstr ""
"См. его собственную карточку - некоторые действия требуют аутентификации "
"(sudo)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:59
msgid "Multi-instance / Instances (N)"
msgstr "Несколько экземпляров / Экземпляры (N)"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:60
msgid "Registre des installations d'OMEGA-SERV connues sur cette machine."
msgstr "Реестр установок OMEGA-SERV, известных на этой машине."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:61
msgid ""
"Le libellé affiche le nombre d'instances dès que 2 ou plus sont "
"enregistrées."
msgstr ""
"Подпись показывает число экземпляров, как только их зарегистрировано 2 или "
"больше."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:62
msgid "Ouvre l'écran Multi-instance."
msgstr "Открывает экран Несколько экземпляров."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:63
msgid ""
"Aucun effet direct (lecture) - voir sa propre fiche pour les actions "
"possibles."
msgstr ""
"Без прямого эффекта (чтение) - возможные действия см. в его собственной "
"карточке."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:66
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:149
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:80
#: src/omega_serv/interfaces/tui/screens/home.py:91
msgid "État & Ressources"
msgstr "Состояние и ресурсы"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:67
msgid ""
"Vue d'ensemble en direct : état du serveur/service, flux du log d'accès, "
"ressources système."
msgstr ""
"Обзор в реальном времени: состояние сервера/службы, поток журнала доступа, "
"системные ресурсы."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:68
msgid "À consulter pour un diagnostic rapide."
msgstr "Для быстрой диагностики."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:69
msgid "Ouvre l'écran État & Ressources."
msgstr "Открывает экран Состояние и ресурсы."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:70
msgid ""
"Aucun effet (lecture, rafraîchie automatiquement toutes les 2 secondes)."
msgstr "Без эффекта (чтение, автоматически обновляется каждые 2 секунды)."

