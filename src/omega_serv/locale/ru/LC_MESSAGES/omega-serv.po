#: src/omega_serv/interfaces/tui/guide/content/accueil.py:39
msgid ""
"Tous les réglages du serveur et des options superposables, écran par écran."
msgstr "Все настройки сервера и подключаемых параметров, экран за экраном."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:40
msgid "Le cœur de la configuration au quotidien."
msgstr "Основа повседневной настройки."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:41
msgid "Ouvre le menu de configuration détaillée."
msgstr "Открывает меню подробной настройки."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:42
#: src/omega_serv/interfaces/tui/guide/content/accueil.py:49
