msgstr "У вас последняя опубликованная версия ({version})."

#: src/omega_serv/interfaces/cli/main.py:1665
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:195
#, python-brace-format
msgid ""
"Votre version ({installed}) est plus récente que la dernière publiée "
"({latest}) : version en cours, pas encore publiée."
msgstr ""
"Ваша версия ({installed}) новее последней опубликованной ({latest}): версия "
"в разработке, ещё не опубликована."

#: src/omega_serv/interfaces/cli/main.py:1668
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:198
#, python-brace-format
msgid ""
"Version installée : {version}. Site injoignable ou liste des versions "
"illisible : réessayez plus tard."
msgstr ""
"Установленная версия: {version}. Сайт недоступен или список версий не "
"читается: повторите попытку позже."

#: src/omega_serv/interfaces/cli/main.py:1677
msgid ""
"Serveur web sécurisé (WAF, TLS, RIPOSTE, Active Defense). Sans argument : "
"interface interactive. Avec une commande : ligne de commande, scriptable."
msgstr ""
"Защищённый веб-сервер (WAF, TLS, RIPOSTE, Active Defense). Без аргументов: "
"интерактивный интерфейс. С командой: командная строка, для скриптов."

#: src/omega_serv/interfaces/cli/main.py:1679
msgid "Toutes les commandes : omega-serv help. Manuel : man omega-serv."
msgstr "Все команды: omega-serv help. Руководство: man omega-serv."

