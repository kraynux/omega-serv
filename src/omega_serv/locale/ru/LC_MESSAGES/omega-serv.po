msgid "FICHIER"
msgstr "ФАЙЛ"

#: src/omega_serv/interfaces/cli/main.py:1682
msgid ""
"Fichier de configuration (défaut : config/omega-serve.json de "
"l'installation)."
msgstr "Файл конфигурации (по умолчанию: config/omega-serve.json установки)."

#: src/omega_serv/interfaces/cli/main.py:1685
msgid "Accepte un certificat auto-signé sur une adresse publique."
msgstr "Принимает самоподписанный сертификат на публичном адресе."

#: src/omega_serv/interfaces/cli/main.py:1686
msgid ""
"Accepte des zones à mot de passe sans TLS (mots de passe lisibles sur le "
"réseau)."
msgstr "Принимает зоны с паролем без TLS (пароли читаемы в сети)."

#: src/omega_serv/interfaces/cli/main.py:1687
msgid "Méthode HTTP (défaut : GET)."
msgstr "Метод HTTP (по умолчанию: GET)."

#: src/omega_serv/interfaces/cli/main.py:1690
msgid ""
"Démarre le serveur au premier plan (c'est ce que lance le service système). "
"Refuse de tourner en root."
msgstr ""
"Запускает сервер на переднем плане (именно это запускает системная служба). "
"Отказывается работать от root."

#: src/omega_serv/interfaces/cli/main.py:1696
msgid "Fichier de configuration : création, vérification, TLS, sauvegardes."
msgstr "Файл конфигурации: создание, проверка, TLS, резервные копии."

#: src/omega_serv/interfaces/cli/main.py:1697
msgid "Crée le fichier de configuration par défaut."
msgstr "Создаёт файл конфигурации по умолчанию."

#: src/omega_serv/interfaces/cli/main.py:1698
msgid "Écrase le fichier existant."
msgstr "Перезаписывает существующий файл."

#: src/omega_serv/interfaces/cli/main.py:1701
msgid ""
"Vérifie la configuration et l'environnement (chemins, droits, certificats) "
"sans démarrer."
msgstr ""
"Проверяет конфигурацию и окружение (пути, права, сертификаты) без запуска."

#: src/omega_serv/interfaces/cli/main.py:1705
msgid "Affiche la configuration chargée, en JSON."
msgstr "Показывает загруженную конфигурацию в JSON."

#: src/omega_serv/interfaces/cli/main.py:1706
msgid "Active TLS dans la configuration."
msgstr "Включает TLS в конфигурации."

#: src/omega_serv/interfaces/cli/main.py:1708
msgid "Certificat à utiliser (sinon celui déjà configuré)."
msgstr "Сертификат для использования (иначе уже настроенный)."

#: src/omega_serv/interfaces/cli/main.py:1710
msgid "Clé privée à utiliser (sinon celle déjà configurée)."
msgstr "Закрытый ключ для использования (иначе уже настроенный)."

#: src/omega_serv/interfaces/cli/main.py:1712
msgid ""
"direct : omega-serv chiffre lui-même ; behind_proxy : derrière un reverse "
"proxy (défaut : direct)."
msgstr ""
"direct: omega-serv шифрует сам; behind_proxy: за обратным прокси (по "
"умолчанию: direct)."

#: src/omega_serv/interfaces/cli/main.py:1714
msgid "Désactive TLS dans la configuration."
msgstr "Отключает TLS в конфигурации."

#: src/omega_serv/interfaces/cli/main.py:1717
msgid ""
"Crée une sauvegarde : la configuration toujours, le reste selon les options "
"--include-*."
msgstr ""
"Создаёт резервную копию: всегда конфигурацию, остальное в зависимости от "
"параметров --include-*."

#: src/omega_serv/interfaces/cli/main.py:1718
msgid "Ajoute les règles et listes du WAF."
msgstr "Добавляет правила и списки WAF."

#: src/omega_serv/interfaces/cli/main.py:1720
msgid ""
"Ajoute les utilisateurs et les zones protégées (secrets : demande --confirm-"
"secrets)."
msgstr ""
"Добавляет пользователей и защищённые зоны (секреты: требуется --confirm-"
"secrets)."

#: src/omega_serv/interfaces/cli/main.py:1722
msgid ""
"Ajoute les certificats et les clés TLS (secrets : demande --confirm-"
"secrets)."
msgstr ""
"Добавляет сертификаты и ключи TLS (секреты: требуется --confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:1724
msgid "Ajoute la base Active Defense."
msgstr "Добавляет базу Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1726
msgid "Ajoute les pages d'erreur personnalisées."
msgstr "Добавляет собственные страницы ошибок."

#: src/omega_serv/interfaces/cli/main.py:1728
msgid "Ajoute les préférences de l'interface."
msgstr "Добавляет настройки интерфейса."

#: src/omega_serv/interfaces/cli/main.py:1730
msgid "Ajoute la bibliothèque des journaux."
msgstr "Добавляет библиотеку журналов."

#: src/omega_serv/interfaces/cli/main.py:1731
msgid "Ajoute la base RIPOSTE."
msgstr "Добавляет базу RIPOSTE."

#: src/omega_serv/interfaces/cli/main.py:1733
msgid ""
"Tout sauvegarder : toutes les options --include-* (secrets compris : demande"
" --confirm-secrets)."
msgstr ""
"Сохранить всё: все параметры --include-* (включая секреты: требуется "
"--confirm-secrets)."

#: src/omega_serv/interfaces/cli/main.py:1735
msgid ""
"Confirme l'ajout de secrets non chiffrés (hash de mots de passe, clés "
"privées)."
msgstr ""
"Подтверждает добавление незашифрованных секретов (хеши паролей, закрытые "
"ключи)."

#: src/omega_serv/interfaces/cli/main.py:1736
#: src/omega_serv/interfaces/cli/main.py:1785
#: src/omega_serv/interfaces/cli/main.py:1786
#: src/omega_serv/interfaces/cli/main.py:1800
#: src/omega_serv/interfaces/cli/main.py:1821
#: src/omega_serv/interfaces/cli/main.py:1901
#: src/omega_serv/interfaces/cli/main.py:1903
#: src/omega_serv/interfaces/cli/main.py:1904
#: src/omega_serv/interfaces/cli/main.py:1905
#: src/omega_serv/interfaces/cli/main.py:2014
#: src/omega_serv/interfaces/cli/main.py:2053
msgid "TEXTE"
msgstr "ТЕКСТ"

#: src/omega_serv/interfaces/cli/main.py:1737
msgid "Texte libre enregistré avec la sauvegarde."
msgstr "Произвольный текст, сохраняемый вместе с резервной копией."

#: src/omega_serv/interfaces/cli/main.py:1739
msgid "Restaure une sauvegarde."
msgstr "Восстанавливает резервную копию."

#: src/omega_serv/interfaces/cli/main.py:1740
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:80
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:101
msgid "ID"
msgstr "ID"

#: src/omega_serv/interfaces/cli/main.py:1741
msgid "Identifiant de la sauvegarde (voir config list-backups)."
msgstr "Идентификатор резервной копии (см. config list-backups)."

#: src/omega_serv/interfaces/cli/main.py:1743
msgid ""
"Arrête le service, restaure, puis le redémarre (nécessaire si le service "
"tourne)."
msgstr ""
"Останавливает службу, восстанавливает, затем перезапускает её (нужно, если "
"служба работает)."

#: src/omega_serv/interfaces/cli/main.py:1745
msgid "Liste les sauvegardes."
msgstr "Выводит список резервных копий."

#: src/omega_serv/interfaces/cli/main.py:1747
msgid "Profils de configuration prêts à l'emploi."
msgstr "Готовые профили конфигурации."

#: src/omega_serv/interfaces/cli/main.py:1748
msgid "Liste les profils disponibles."
msgstr "Выводит список доступных профилей."

#: src/omega_serv/interfaces/cli/main.py:1749
msgid "Nom du profil (voir profile list)."
msgstr "Имя профиля (см. profile list)."

#: src/omega_serv/interfaces/cli/main.py:1750
msgid "Affiche un profil et les valeurs qu'il fixe."
msgstr "Показывает профиль и задаваемые им значения."

#: src/omega_serv/interfaces/cli/main.py:1754
msgid ""
"Applique un profil à la configuration (modifications et conflits affichés "
"d'abord)."
msgstr ""
"Применяет профиль к конфигурации (сначала показываются изменения и "
"конфликты)."

#: src/omega_serv/interfaces/cli/main.py:1757
msgid "Montre seulement ce qui changerait, sans rien écrire."
msgstr "Только показывает, что изменилось бы, ничего не записывая."

#: src/omega_serv/interfaces/cli/main.py:1758
msgid "Applique malgré des problèmes bloquants."
msgstr "Применяет, несмотря на блокирующие проблемы."

#: src/omega_serv/interfaces/cli/main.py:1762
msgid "Modules optionnels (waf, fastcgi, active_defense, riposte...)."
msgstr "Дополнительные модули (waf, fastcgi, active_defense, riposte...)."

#: src/omega_serv/interfaces/cli/main.py:1763
msgid "Liste les options et leur état."
msgstr "Выводит список параметров и их состояние."

#: src/omega_serv/interfaces/cli/main.py:1764
msgid "Nom de l'option (voir option list)."
msgstr "Имя параметра (см. option list)."

#: src/omega_serv/interfaces/cli/main.py:1765
msgid "Active une option."
msgstr "Включает параметр."

#: src/omega_serv/interfaces/cli/main.py:1766
msgid ""
"Première activation du WAF : tous les packs de secure/waf/rules/ sont "
"ajoutés, en mode log-only."
msgstr ""
"Первое включение WAF: добавляются все пакеты из secure/waf/rules/, в режиме "
"log-only."

#: src/omega_serv/interfaces/cli/main.py:1769
msgid "Désactive une option."
msgstr "Отключает параметр."

#: src/omega_serv/interfaces/cli/main.py:1774
msgid ""
"Montre comment le serveur traiterait une requête (chemin, règles, statut, "
"en-têtes), sans l'envoyer."
msgstr ""
"Показывает, как сервер обработал бы запрос (путь, правила, статус, "
"заголовки), не отправляя его."

#: src/omega_serv/interfaces/cli/main.py:1776
#: src/omega_serv/interfaces/cli/main.py:1784
#: src/omega_serv/interfaces/cli/main.py:1819
#: src/omega_serv/interfaces/cli/main.py:2013
#: src/omega_serv/interfaces/cli/main.py:2023
msgid "CHEMIN"
msgstr "ПУТЬ"

#: src/omega_serv/interfaces/cli/main.py:1777
msgid "Chemin demandé, par exemple /docs/index.html."
msgstr "Запрошенный путь, например /docs/index.html."

#: src/omega_serv/interfaces/cli/main.py:1780
msgid "Pare-feu applicatif (WAF)."
msgstr "Межсетевой экран приложений (WAF)."

#: src/omega_serv/interfaces/cli/main.py:1782
msgid ""
"Soumet une requête fictive au WAF et affiche sa décision (règles, score, "
"statut)."
msgstr ""
"Отправляет фиктивный запрос в WAF и показывает его решение (правила, баллы, "
"статус)."

#: src/omega_serv/interfaces/cli/main.py:1784
msgid "Chemin de la requête."
msgstr "Путь запроса."

#: src/omega_serv/interfaces/cli/main.py:1785
msgid "Chaîne de requête, sans le « ? »."
msgstr "Строка запроса, без «?»."

#: src/omega_serv/interfaces/cli/main.py:1786
msgid "Corps de la requête."
msgstr "Тело запроса."

#: src/omega_serv/interfaces/cli/main.py:1788
msgid "Adresse du client simulé (défaut : 127.0.0.1)."
msgstr "Адрес имитируемого клиента (по умолчанию: 127.0.0.1)."

#: src/omega_serv/interfaces/cli/main.py:1791
msgid "Affiche les réseaux jamais bannis automatiquement (lu par omega-jail)."
msgstr ""
"Показывает сети, которые никогда не банятся автоматически (читается omega-"
"jail)."

#: src/omega_serv/interfaces/cli/main.py:1794
msgid "Adresses bannies."
msgstr "Забаненные адреса."

#: src/omega_serv/interfaces/cli/main.py:1795
msgid "Affiche les bans : réseau, origine, expiration, motif."
msgstr "Показывает баны: сеть, источник, истечение, причина."

#: src/omega_serv/interfaces/cli/main.py:1797
msgid "Bannit une adresse ou un réseau."
msgstr "Банит адрес или сеть."

#: src/omega_serv/interfaces/cli/main.py:1798
#: src/omega_serv/interfaces/cli/main.py:1806
#: src/omega_serv/interfaces/cli/riposte_action_commands.py:322
msgid "RESEAU"
msgstr "СЕТЬ"

#: src/omega_serv/interfaces/cli/main.py:1799
msgid "Adresse IP ou réseau CIDR, par exemple 203.0.113.7 ou 203.0.113.0/24."
msgstr "IP-адрес или сеть CIDR, например 203.0.113.7 или 203.0.113.0/24."

#: src/omega_serv/interfaces/cli/main.py:1800
msgid "Motif du ban."
msgstr "Причина бана."

#: src/omega_serv/interfaces/cli/main.py:1801
#: src/omega_serv/interfaces/cli/main.py:2061
msgid "SECONDES"
msgstr "СЕКУНДЫ"

#: src/omega_serv/interfaces/cli/main.py:1802
msgid ""
"Durée du ban. Sans durée, le ban est permanent et demande --confirm-"
"permanent."
msgstr ""
"Длительность бана. Без длительности бан постоянный и требует --confirm-"
"permanent."

#: src/omega_serv/interfaces/cli/main.py:1803
msgid "Confirme un ban permanent."
msgstr "Подтверждает постоянный бан."

#: src/omega_serv/interfaces/cli/main.py:1805
msgid "Lève un ban."
msgstr "Снимает бан."

#: src/omega_serv/interfaces/cli/main.py:1807
msgid "Adresse ou réseau, tel qu'affiché par blocklist list."
msgstr "Адрес или сеть, как показывает blocklist list."

#: src/omega_serv/interfaces/cli/main.py:1811
msgid ""
"Active Defense : état, simulation, purge (voir aussi threats, incidents, "
"deception)."
msgstr ""
"Active Defense: состояние, имитация, очистка (см. также threats, incidents, "
"deception)."

#: src/omega_serv/interfaces/cli/main.py:1814
msgid ""
"Affiche l'état : mode, mode guerre, leurres, nombre de sources suivies."
msgstr ""
"Показывает состояние: режим, боевой режим, ловушки, число отслеживаемых "
"источников."

#: src/omega_serv/interfaces/cli/main.py:1817
msgid ""
"Montre la décision qu'Active Defense prendrait pour une source, sans rien "
"écrire."
msgstr ""
"Показывает решение, которое Active Defense принял бы для источника, ничего "
"не записывая."

#: src/omega_serv/interfaces/cli/main.py:1818
msgid "Adresse de la source simulée."
msgstr "Адрес имитируемого источника."

#: src/omega_serv/interfaces/cli/main.py:1820
msgid "Chemin observé (défaut : /)."
msgstr "Наблюдаемый путь (по умолчанию: /)."

#: src/omega_serv/interfaces/cli/main.py:1822
msgid "User-Agent de la source."
msgstr "User-Agent источника."

#: src/omega_serv/interfaces/cli/main.py:1823
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:230
msgid "CLASSE"
msgstr "КЛАСС"

#: src/omega_serv/interfaces/cli/main.py:1824
msgid "Classe d'attaque (défaut : scan ; liste affichée si inconnue)."
msgstr ""
"Класс атаки (по умолчанию: scan; если неизвестен, показывается список)."

#: src/omega_serv/interfaces/cli/main.py:1825
msgid "POINTS"
msgstr "БАЛЛЫ"

#: src/omega_serv/interfaces/cli/main.py:1826
msgid "Points ajoutés au score de menace (défaut : 10)."
msgstr "Баллы, добавляемые к оценке угрозы (по умолчанию: 10)."

#: src/omega_serv/interfaces/cli/main.py:1829
msgid ""
"Purge les menaces expirées, ferme les incidents redevenus calmes, supprime "
"les incidents fermés depuis plus de 90 jours."
msgstr ""
"Удаляет истёкшие угрозы, закрывает затихшие инциденты, удаляет инциденты, "
"закрытые более 90 дней назад."

#: src/omega_serv/interfaces/cli/main.py:1832
msgid "Logs d'omega-serv."
msgstr "Журналы omega-serv."

#: src/omega_serv/interfaces/cli/main.py:1834
msgid ""
"Fait tourner les logs dont l'automatisation (Rotate / archivage) est à "
"échéance."
msgstr ""
"Выполняет ротацию журналов, у которых подошёл срок автоматизации (Ротация / "
"архивирование)."

#: src/omega_serv/interfaces/cli/main.py:1835
msgid ""
"Lancée chaque nuit par le timer systemd ou la ligne crontab installés par "
"l'interface."
msgstr ""
"Запускается каждую ночь таймером systemd или строкой crontab, установленными"
" из интерфейса."

#: src/omega_serv/interfaces/cli/main.py:1838
msgid "Moteur HTTP (Python ou natif)."
msgstr "HTTP-движок (Python или нативный)."

#: src/omega_serv/interfaces/cli/main.py:1840
msgid ""
"Affiche le moteur demandé, celui qui tourne et la raison d'un éventuel "
"repli."
msgstr ""
"Показывает запрошенный движок, работающий движок и причину возможного "
"отката."

#: src/omega_serv/interfaces/cli/main.py:1844
msgid "RIPOSTE : bans de plus en plus longs pour les récidivistes."
msgstr "RIPOSTE: всё более длительные баны для повторных нарушителей."

#: src/omega_serv/interfaces/cli/main.py:1846
msgid ""
"Lance le processus RIPOSTE au premier plan (normalement lancé par serve ; "
"utile au diagnostic)."
msgstr ""
"Запускает процесс RIPOSTE на переднем плане (обычно его запускает serve; "
"полезно для диагностики)."

#: src/omega_serv/interfaces/cli/main.py:1848
msgid "Affiche l'état de RIPOSTE (lecture seule)."
msgstr "Показывает состояние RIPOSTE (только чтение)."

#: src/omega_serv/interfaces/cli/main.py:1852
msgid "Menaces suivies par Active Defense."
msgstr "Угрозы, отслеживаемые Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1853
msgid "Liste les sources suivies avec leur score et leur niveau."
msgstr "Выводит список отслеживаемых источников с их баллами и уровнем."

#: src/omega_serv/interfaces/cli/main.py:1855
msgid "Seulement ce niveau."
msgstr "Только этот уровень."

#: src/omega_serv/interfaces/cli/main.py:1857
msgid "Affiche le détail d'une source suivie."
msgstr "Показывает подробности отслеживаемого источника."

#: src/omega_serv/interfaces/cli/main.py:1858
#: src/omega_serv/interfaces/cli/main.py:1892
msgid "SOURCE"
msgstr "ИСТОЧНИК"

#: src/omega_serv/interfaces/cli/main.py:1859
msgid "Identifiant de la source, tel qu'affiché par threats list."
msgstr "Идентификатор источника, как показывает threats list."

#: src/omega_serv/interfaces/cli/main.py:1862
msgid "Incidents Active Defense."
msgstr "Инциденты Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1863
msgid "Identifiant de l'incident (voir incidents list)."
msgstr "Идентификатор инцидента (см. incidents list)."

#: src/omega_serv/interfaces/cli/main.py:1864
msgid "Liste les incidents."
msgstr "Выводит список инцидентов."

#: src/omega_serv/interfaces/cli/main.py:1866
msgid "Seulement les incidents ouverts (open) ou fermés (closed)."
msgstr "Только открытые (open) или закрытые (closed) инциденты."

#: src/omega_serv/interfaces/cli/main.py:1867
msgid "HEURES"
msgstr "ЧАСЫ"

#: src/omega_serv/interfaces/cli/main.py:1868
msgid "Seulement les incidents des N dernières heures."
msgstr "Только инциденты за последние N часов."

#: src/omega_serv/interfaces/cli/main.py:1870
msgid "Affiche un incident et sa chronologie."
msgstr "Показывает инцидент и его хронологию."

#: src/omega_serv/interfaces/cli/main.py:1874
msgid "Ferme un incident (et l'exporte si l'export automatique est activé)."
msgstr ""
"Закрывает инцидент (и экспортирует его, если включён автоматический "
"экспорт)."

#: src/omega_serv/interfaces/cli/main.py:1878
msgid "Exporte les indicateurs de compromission (IoC) d'un incident."
msgstr "Экспортирует индикаторы компрометации (IoC) инцидента."

#: src/omega_serv/interfaces/cli/main.py:1880
msgid "FORMATS"
msgstr "ФОРМАТЫ"

#: src/omega_serv/interfaces/cli/main.py:1881
msgid ""
"Un ou plusieurs formats séparés par des virgules : json, csv, stix, misp "
"(défaut : json)."
msgstr ""
"Один или несколько форматов через запятую: json, csv, stix, misp (по "
"умолчанию: json)."

#: src/omega_serv/interfaces/cli/main.py:1884
msgid "Écrit le rapport Markdown d'un incident."
msgstr "Записывает отчёт Markdown об инциденте."

#: src/omega_serv/interfaces/cli/main.py:1888
msgid "Leurres Active Defense."
msgstr "Ловушки Active Defense."

#: src/omega_serv/interfaces/cli/main.py:1889
msgid "Liste les sources envoyées vers un leurre."
msgstr "Выводит список источников, направленных в ловушку."

#: src/omega_serv/interfaces/cli/main.py:1891
msgid "Libère une source de son leurre."
msgstr "Освобождает источник из его ловушки."

#: src/omega_serv/interfaces/cli/main.py:1893
msgid "Identifiant de la source, tel qu'affiché par deception list."
msgstr "Идентификатор источника, как показывает deception list."

#: src/omega_serv/interfaces/cli/main.py:1896
msgid "Certificats TLS (via OpenSSL)."
msgstr "Сертификаты TLS (через OpenSSL)."

#: src/omega_serv/interfaces/cli/main.py:1902
msgid "Organisation (défaut : OMEGA-SERV)."
msgstr "Организация (по умолчанию: OMEGA-SERV)."

#: src/omega_serv/interfaces/cli/main.py:1903
msgid "Service ou département."
msgstr "Подразделение или отдел."

#: src/omega_serv/interfaces/cli/main.py:1904
msgid "Ville."
msgstr "Город."

#: src/omega_serv/interfaces/cli/main.py:1905
msgid "Région."
msgstr "Регион."

#: src/omega_serv/interfaces/cli/main.py:1906
msgid "Pays, code à deux lettres (FR, BE...)."
msgstr "Страна, двухбуквенный код (FR, BE...)."

#: src/omega_serv/interfaces/cli/main.py:1910
msgid "Noms de domaine supplémentaires couverts par le certificat."
msgstr "Дополнительные доменные имена, охватываемые сертификатом."

#: src/omega_serv/interfaces/cli/main.py:1912
msgid "Adresses IP couvertes par le certificat."
msgstr "IP-адреса, охватываемые сертификатом."

#: src/omega_serv/interfaces/cli/main.py:1914
msgid "Nom commun : le nom de domaine principal."
msgstr "Общее имя: основное доменное имя."

#: src/omega_serv/interfaces/cli/main.py:1916
msgid ""
"Génère un certificat auto-signé aux chemins de la configuration (l'ancien "
"est sauvegardé)."
msgstr ""
"Создаёт самоподписанный сертификат по путям из конфигурации (старый "
"сохраняется)."

#: src/omega_serv/interfaces/cli/main.py:1919
#: src/omega_serv/interfaces/cli/main.py:1930
#: src/omega_serv/interfaces/cli/main.py:1954
#: src/omega_serv/interfaces/cli/main.py:1988
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:244
msgid "JOURS"
msgstr "ДНИ"

#: src/omega_serv/interfaces/cli/main.py:1920
#: src/omega_serv/interfaces/cli/main.py:1955
msgid "Validité en jours (défaut : 365)."
msgstr "Срок действия в днях (по умолчанию: 365)."

#: src/omega_serv/interfaces/cli/main.py:1922
#: src/omega_serv/interfaces/cli/main.py:1942
msgid "Type de clé (défaut : rsa2048)."
msgstr "Тип ключа (по умолчанию: rsa2048)."

#: src/omega_serv/interfaces/cli/main.py:1923
#: src/omega_serv/interfaces/cli/main.py:1934
#: src/omega_serv/interfaces/cli/main.py:1952
#: src/omega_serv/interfaces/cli/main.py:1973
#: src/omega_serv/interfaces/cli/main.py:2000
#: src/omega_serv/interfaces/cli/main.py:2009
msgid "MOT-DE-PASSE"
msgstr "ПАРОЛЬ"

#: src/omega_serv/interfaces/cli/main.py:1924
msgid "Chiffre la clé privée avec ce mot de passe (facultatif)."
msgstr "Шифрует закрытый ключ этим паролем (необязательно)."

#: src/omega_serv/interfaces/cli/main.py:1928
msgid "Crée une autorité de certification locale dans secure/certificates/ca."
msgstr "Создаёт локальный центр сертификации в secure/certificates/ca."

#: src/omega_serv/interfaces/cli/main.py:1929
msgid "Nom de l'autorité de certification."
msgstr "Имя центра сертификации."

#: src/omega_serv/interfaces/cli/main.py:1931
msgid "Validité en jours (défaut : 3650)."
msgstr "Срок действия в днях (по умолчанию: 3650)."

#: src/omega_serv/interfaces/cli/main.py:1933
msgid "Type de clé (défaut : rsa4096)."
msgstr "Тип ключа (по умолчанию: rsa4096)."

#: src/omega_serv/interfaces/cli/main.py:1935
msgid ""
"Mot de passe de la clé de CA ; sans cette option, il est demandé deux fois "
"au clavier (conseillé)."
msgstr ""
"Пароль ключа CA; без этого параметра он запрашивается дважды с клавиатуры "
"(рекомендуется)."

#: src/omega_serv/interfaces/cli/main.py:1939
msgid ""
"Génère une clé et une demande de signature (CSR) à faire signer par une CA."
msgstr "Создаёт ключ и запрос на подпись (CSR) для подписи центром CA."

#: src/omega_serv/interfaces/cli/main.py:1943
msgid "Clé privée à créer."
msgstr "Создаваемый закрытый ключ."

#: src/omega_serv/interfaces/cli/main.py:1944
msgid "Demande de signature à créer."
msgstr "Создаваемый запрос на подпись."

#: src/omega_serv/interfaces/cli/main.py:1947
msgid "Mot de passe de la clé de CA (sinon demandé au clavier, conseillé)."
msgstr "Пароль ключа CA (иначе запрашивается с клавиатуры, рекомендуется)."

#: src/omega_serv/interfaces/cli/main.py:1948
msgid "Signe une demande de signature (CSR) avec une CA."
msgstr "Подписывает запрос на подпись (CSR) с помощью CA."

#: src/omega_serv/interfaces/cli/main.py:1949
msgid "Demande de signature à signer."
msgstr "Подписываемый запрос на подпись."

#: src/omega_serv/interfaces/cli/main.py:1950
#: src/omega_serv/interfaces/cli/main.py:1971
msgid "Clé privée de la CA."
msgstr "Закрытый ключ CA."

#: src/omega_serv/interfaces/cli/main.py:1951
#: src/omega_serv/interfaces/cli/main.py:1972
msgid "Certificat de la CA."
msgstr "Сертификат CA."

#: src/omega_serv/interfaces/cli/main.py:1956
msgid "Certificat signé à écrire."
msgstr "Записываемый подписанный сертификат."

#: src/omega_serv/interfaces/cli/main.py:1958
msgid "Écrit aussi la chaîne complète (certificat puis CA)."
msgstr "Также записывает полную цепочку (сертификат, затем CA)."

#: src/omega_serv/interfaces/cli/main.py:1962
msgid ""
"Installe un certificat existant aux chemins de la configuration (Let's "
"Encrypt, CA d'entreprise...)."
msgstr ""
"Устанавливает существующий сертификат по путям из конфигурации (Let's "
"Encrypt, корпоративный CA...)."

#: src/omega_serv/interfaces/cli/main.py:1963
msgid "Clé privée."
msgstr "Закрытый ключ."

#: src/omega_serv/interfaces/cli/main.py:1964
msgid "Certificat."
msgstr "Сертификат."

#: src/omega_serv/interfaces/cli/main.py:1966
msgid "Chaîne des certificats intermédiaires (facultatif)."
msgstr "Цепочка промежуточных сертификатов (необязательно)."

#: src/omega_serv/interfaces/cli/main.py:1969
msgid "Révoque un certificat émis par une CA locale."
msgstr "Отзывает сертификат, выданный локальным CA."

#: src/omega_serv/interfaces/cli/main.py:1970
msgid "Certificat à révoquer."
msgstr "Отзываемый сертификат."

#: src/omega_serv/interfaces/cli/main.py:1977
msgid "Certificat à lire (défaut : celui de la configuration)."
msgstr "Читаемый сертификат (по умолчанию: из конфигурации)."

#: src/omega_serv/interfaces/cli/main.py:1979
msgid ""
"Vérifie un certificat : dates, correspondance avec la clé, droits de la clé."
" Code 1 s'il a expiré."
msgstr ""
"Проверяет сертификат: даты, соответствие ключу, права на ключ. Код 1, если "
"срок истёк."

#: src/omega_serv/interfaces/cli/main.py:1982
msgid "Affiche le détail d'un certificat (même rapport que verify)."
msgstr "Показывает подробности сертификата (тот же отчёт, что verify)."

#: src/omega_serv/interfaces/cli/main.py:1986
msgid "Même rapport que verify, avec une alerte si l'expiration approche."
msgstr "Тот же отчёт, что verify, с предупреждением, если срок истекает."

#: src/omega_serv/interfaces/cli/main.py:1989
msgid "Seuil d'alerte en jours (défaut : 30)."
msgstr "Порог предупреждения в днях (по умолчанию: 30)."

#: src/omega_serv/interfaces/cli/main.py:1993
msgid "Authentification HTTP Basic : utilisateurs et zones protégées."
msgstr "Аутентификация HTTP Basic: пользователи и защищённые зоны."

#: src/omega_serv/interfaces/cli/main.py:1994
msgid "Nom d'utilisateur."
msgstr "Имя пользователя."

#: src/omega_serv/interfaces/cli/main.py:1995
msgid ""
"Mot de passe (sinon demandé au clavier, conseillé : il resterait dans "
"l'historique)."
msgstr ""
"Пароль (иначе запрашивается с клавиатуры, рекомендуется: он остался бы в "
"истории)."

#: src/omega_serv/interfaces/cli/main.py:1996
msgid "Début de chemin protégé, par exemple /admin."
msgstr "Начало защищённого пути, например /admin."

#: src/omega_serv/interfaces/cli/main.py:1998
msgid "Crée un utilisateur."
msgstr "Создаёт пользователя."

#: src/omega_serv/interfaces/cli/main.py:2003
msgid "Supprime un utilisateur."
msgstr "Удаляет пользователя."

#: src/omega_serv/interfaces/cli/main.py:2007
msgid "Change le mot de passe d'un utilisateur."
msgstr "Меняет пароль пользователя."

#: src/omega_serv/interfaces/cli/main.py:2012
msgid "Protège un chemin par mot de passe."
msgstr "Защищает путь паролем."

#: src/omega_serv/interfaces/cli/main.py:2015
msgid "Nom affiché par le navigateur dans la demande de connexion."
msgstr "Имя, которое браузер показывает в запросе входа."

#: src/omega_serv/interfaces/cli/main.py:2017
msgid "Utilisateurs autorisés dans la zone."
msgstr "Пользователи, допущенные в зону."

#: src/omega_serv/interfaces/cli/main.py:2018
msgid "METHODE"
msgstr "МЕТОД"

#: src/omega_serv/interfaces/cli/main.py:2019
msgid ""
"Seules ces méthodes HTTP sont acceptées dans la zone (défaut : toutes celles"
" que le serveur autorise)."
msgstr ""
"В зоне принимаются только эти методы HTTP (по умолчанию: все, что разрешает "
"сервер)."

#: src/omega_serv/interfaces/cli/main.py:2022
msgid "Retire la protection d'un chemin."
msgstr "Снимает защиту с пути."

#: src/omega_serv/interfaces/cli/main.py:2026
msgid "Liste les utilisateurs et les zones protégées."
msgstr "Выводит список пользователей и защищённых зон."

#: src/omega_serv/interfaces/cli/main.py:2028
msgid ""
"Vérifie que les fichiers des utilisateurs et des zones ne sont lisibles que "
"par leur propriétaire."
msgstr ""
"Проверяет, что файлы пользователей и зон доступны для чтения только "
"владельцу."

#: src/omega_serv/interfaces/cli/main.py:2032
msgid "Service système (systemd, OpenRC ou runit)."
msgstr "Системная служба (systemd, OpenRC или runit)."

#: src/omega_serv/interfaces/cli/main.py:2033
msgid "Nom du service (défaut : omega-serv)."
msgstr "Имя службы (по умолчанию: omega-serv)."

#: src/omega_serv/interfaces/cli/main.py:2034
msgid "Fichier d'unité (défaut : /etc/systemd/system/<nom>.service)."
msgstr "Файл юнита (по умолчанию: /etc/systemd/system/<имя>.service)."

#: src/omega_serv/interfaces/cli/main.py:2037
msgid "Affiche l'état du service."
msgstr "Показывает состояние службы."

#: src/omega_serv/interfaces/cli/main.py:2038
msgid "Démarre le service."
msgstr "Запускает службу."

#: src/omega_serv/interfaces/cli/main.py:2039
msgid "Arrête le service."
msgstr "Останавливает службу."

#: src/omega_serv/interfaces/cli/main.py:2040
msgid "Redémarre le service (nécessaire après une mise à jour)."
msgstr "Перезапускает службу (нужно после обновления)."

#: src/omega_serv/interfaces/cli/main.py:2042
msgid ""
"Recharge sans couper : règles WAF et zones ; bind, port, TLS et moteur "
"demandent un redémarrage."
msgstr ""
"Перезагружает без прерывания: правила WAF и зоны; bind, порт, TLS и движок "
"требуют перезапуска."

#: src/omega_serv/interfaces/cli/main.py:2043
msgid "Active le démarrage automatique au boot."
msgstr "Включает автозапуск при загрузке."

#: src/omega_serv/interfaces/cli/main.py:2044
msgid "Désactive le démarrage automatique au boot."
msgstr "Отключает автозапуск при загрузке."

#: src/omega_serv/interfaces/cli/main.py:2051
msgid ""
"Crée l'unité systemd du service (systemd seulement ; demande les droits "
"administrateur)."
msgstr ""
"Создаёт юнит systemd для службы (только systemd; требуются права "
"администратора)."

#: src/omega_serv/interfaces/cli/main.py:2054
msgid "Description de l'unité (défaut : OMEGA-SERV web server)."
msgstr "Описание юнита (по умолчанию: OMEGA-SERV web server)."

#: src/omega_serv/interfaces/cli/main.py:2056
msgid "Python à utiliser (défaut : celui du .venv de l'installation)."
msgstr "Используемый Python (по умолчанию: из .venv установки)."

#: src/omega_serv/interfaces/cli/main.py:2058
msgid "Compte système qui fait tourner le service (défaut : omega-serv)."
msgstr ""
"Системная учётная запись, от которой работает служба (по умолчанию: omega-"
"serv)."

#: src/omega_serv/interfaces/cli/main.py:2060
msgid "Groupe du service (défaut : omega-serv)."
msgstr "Группа службы (по умолчанию: omega-serv)."

#: src/omega_serv/interfaces/cli/main.py:2062
msgid "Délai laissé à l'arrêt avant de forcer (défaut : 15)."
msgstr ""
"Время на остановку перед принудительным завершением (по умолчанию: 15)."

#: src/omega_serv/interfaces/cli/main.py:2066
msgid "Supprime l'unité du service."
msgstr "Удаляет юнит службы."

#: src/omega_serv/interfaces/cli/main.py:2071
msgid "Audit de sécurité."
msgstr "Аудит безопасности."

#: src/omega_serv/interfaces/cli/main.py:2073
msgid ""
"Audite l'installation : configuration, droits, TLS, service. Code 1 si "
"critique, 2 si élevé, 3 si la configuration est illisible."
msgstr ""
"Проверяет установку: конфигурация, права, TLS, служба. Код 1 при "
"критическом, 2 при высоком, 3 если конфигурация нечитаема."

#: src/omega_serv/interfaces/cli/main.py:2076
msgid "Format du rapport (défaut : text)."
msgstr "Формат отчёта (по умолчанию: text)."

#: src/omega_serv/interfaces/cli/main.py:2078
msgid "N'affiche que ce niveau et les plus graves (défaut : info)."
msgstr ""
"Показывает только этот уровень и более серьёзные (по умолчанию: info)."

#: src/omega_serv/interfaces/cli/main.py:2088
msgid ""
"Affiche la version installée ; --check la compare à la dernière version "
"publiée sur le site."
msgstr ""
"Показывает установленную версию; --check сравнивает её с последней версией, "
"опубликованной на сайте."

#: src/omega_serv/interfaces/cli/main.py:2090
msgid ""
"Lit la liste des versions publiées (download/sha.txt du site) ; rien n'est "
"envoyé."
msgstr ""
"Читает список опубликованных версий (download/sha.txt сайта); ничего не "
"отправляется."

#: src/omega_serv/interfaces/cli/main.py:2094
msgid ""
"Affiche l'arbre de toutes les commandes, ou d'une branche (ex. : omega-serv "
"help riposte)."
msgstr ""
"Показывает дерево всех команд или одной ветви (напр.: omega-serv help "
"riposte)."

#: src/omega_serv/interfaces/cli/main.py:2095
msgid "Branche à afficher (facultatif)."
msgstr "Показываемая ветвь (необязательно)."

