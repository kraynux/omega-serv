msgstr "Cấp (hoặc gỡ) nhóm omega-synchro cho dịch vụ của instance này, để dịch vụ đọc được vùng trung lập: tệp bổ sung systemd <service>.service.d/omega-synchro.conf, unit không bị động đến. Do omega-connect yêu cầu; có hiệu lực ở lần khởi động lại dịch vụ tiếp theo."

#: src/omega_serv/interfaces/cli/main.py:2535
msgid "ACTION"
msgstr "HÀNH ĐỘNG"

#: src/omega_serv/interfaces/cli/main.py:2536
msgid "ajouter ou retirer."
msgstr "ajouter (thêm) hoặc retirer (gỡ)."

#: src/omega_serv/interfaces/cli/main.py:2538
msgid "Nom du service (défaut : celui de cette instance)."
msgstr "Tên dịch vụ (mặc định: dịch vụ của instance này)."

