msgid "Service"
msgstr "Dịch vụ"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:53
msgid "Pilotage du service système (demarrer/arreter/redemarrer/recharger/installer)."
msgstr "Điều khiển dịch vụ hệ thống (khởi động/dừng/khởi động lại/nạp lại/cài đặt)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:54
msgid "À utiliser pour piloter le serveur en tant que service système."
msgstr "Dùng để điều khiển máy chủ dưới dạng dịch vụ hệ thống."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:55
msgid "Ouvre l'écran Service."
msgstr "Mở màn hình Dịch vụ."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:56
msgid "Voir sa propre fiche - certaines actions demandent une authentification (sudo)."
msgstr "Xem mục riêng của nó - một số hành động yêu cầu xác thực (sudo)."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:59
msgid "Multi-instance / Instances (N)"
msgstr "Đa instance / Instance (N)"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:60
msgid "Registre des installations d'OMEGA-SERV connues sur cette machine."
msgstr "Sổ đăng ký các bản cài OMEGA-SERV đã biết trên máy này."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:61
msgid "Le libellé affiche le nombre d'instances dès que 2 ou plus sont enregistrées."
msgstr "Nhãn hiển thị số instance ngay khi có từ 2 instance trở lên được đăng ký."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:62
msgid "Ouvre l'écran Multi-instance."
msgstr "Mở màn hình Đa instance."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:63
msgid "Aucun effet direct (lecture) - voir sa propre fiche pour les actions possibles."
msgstr "Không có tác dụng trực tiếp (chỉ đọc) - xem mục riêng của nó để biết các hành động có thể làm."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:66
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:149
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:78
#: src/omega_serv/interfaces/tui/screens/home.py:91
msgid "État & Ressources"
msgstr "Trạng thái & Tài nguyên"

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:67
msgid "Vue d'ensemble en direct : état du serveur/service, flux du log d'accès, ressources système."
msgstr "Tổng quan trực tiếp: trạng thái máy chủ/dịch vụ, luồng log truy cập, tài nguyên hệ thống."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:68
msgid "À consulter pour un diagnostic rapide."
msgstr "Xem để chẩn đoán nhanh."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:69
msgid "Ouvre l'écran État & Ressources."
msgstr "Mở màn hình Trạng thái & Tài nguyên."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:70
msgid "Aucun effet (lecture, rafraîchie automatiquement toutes les 2 secondes)."
msgstr "Không có tác dụng (chỉ đọc, tự làm mới mỗi 2 giây)."

