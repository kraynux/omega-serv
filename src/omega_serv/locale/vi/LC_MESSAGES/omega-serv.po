msgstr "Chỉ để tra cứu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:45
msgid "Accueil -> Profils"
msgstr "Trang chủ -> Hồ sơ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:46
msgid "Liste les 4 profils fournis (minimal/standard/hardened/development) et vos profils personnalisés (colonne Type), avec leur libellé."
msgstr "Liệt kê 4 hồ sơ có sẵn (minimal/standard/hardened/development) và các hồ sơ tùy chỉnh của bạn (cột Loại), kèm nhãn của chúng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:50
#: src/omega_serv/interfaces/tui/guide/content/divers.py:123
#: src/omega_serv/interfaces/tui/screens/apply_profile_screen.py:46
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:42
msgid "Appliquer"
msgstr "Áp dụng"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:51
msgid "Ouvre l'écran de confirmation d'application du profil sélectionné."
msgstr "Mở màn hình xác nhận áp dụng hồ sơ đã chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:52
msgid "Sélectionner un profil active ce bouton."
msgstr "Chọn một hồ sơ để bật nút này."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:53
msgid "Ouvre ApplyProfileScreen."
msgstr "Mở ApplyProfileScreen."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:54
msgid "Un profil personnalisé ne fixe que la sécurité et l'état des options : adresse, port, TLS, chemins, journaux et réglages des options (zones, listes) restent ceux de l'instance."
msgstr "Hồ sơ tùy chỉnh chỉ cố định phần bảo mật và trạng thái của các tùy chọn: địa chỉ, cổng, TLS, đường dẫn, nhật ký và thiết lập của các tùy chọn (vùng, danh sách) vẫn giữ như của instance."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:58
#: src/omega_serv/interfaces/tui/guide/content/divers.py:78
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:36
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:44
msgid "Créer un profil personnalisé"
msgstr "Tạo hồ sơ tùy chỉnh"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:59
msgid "Ouvre l'assistant. Si un profil personnalisé est sélectionné, l'assistant repart de ses choix (un profil personnalisé ne se modifie pas : on en recrée un)."
msgstr "Mở trình hướng dẫn. Nếu một hồ sơ tùy chỉnh đang được chọn, trình hướng dẫn bắt đầu lại từ các lựa chọn của nó (hồ sơ tùy chỉnh không sửa được: hãy tạo lại một hồ sơ mới)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:61
msgid "Aucune limite de nombre : un seul profil est appliqué à la fois."
msgstr "Không giới hạn số lượng: mỗi lúc chỉ áp dụng một hồ sơ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:62
msgid "Enregistre config/profiles/custom/<nom>.json ; la configuration n'est pas touchée."
msgstr "Lưu config/profiles/custom/<tên>.json; cấu hình không bị động đến."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:63
msgid "Compris dans toute sauvegarde de configuration et repris lors d'une mise à jour."
msgstr "Có trong mọi bản sao lưu cấu hình và được giữ lại khi cập nhật."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:66
#: src/omega_serv/interfaces/tui/guide/content/divers.py:297
#: src/omega_serv/interfaces/tui/guide/content/logs.py:88
#: src/omega_serv/interfaces/tui/guide/content/logs.py:139
#: src/omega_serv/interfaces/tui/screens/access_control_screen.py:72
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:89
#: src/omega_serv/interfaces/tui/screens/aliases_screen.py:55
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:76
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:86
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:89
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:104
#: src/omega_serv/interfaces/tui/screens/log_favorites_screen.py:51
#: src/omega_serv/interfaces/tui/screens/profiles_screen.py:46
#: src/omega_serv/interfaces/tui/screens/purge_log_archives_screen.py:38
#: src/omega_serv/interfaces/tui/screens/redirects_screen.py:58
#: src/omega_serv/interfaces/tui/screens/remote_log_sources_screen.py:77
#: src/omega_serv/interfaces/tui/screens/reverse_proxy_screen.py:184
#: src/omega_serv/interfaces/tui/screens/rewrites_screen.py:63
#: src/omega_serv/interfaces/tui/screens/routing_rule_editor_screen.py:56
#: src/omega_serv/interfaces/tui/screens/trusted_proxy_screen.py:71
#: src/omega_serv/interfaces/tui/screens/upstream_editor_screen.py:65
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:93
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:195
msgid "Supprimer"
msgstr "Xóa"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:67
msgid "Supprime le profil personnalisé sélectionné, après confirmation."
msgstr "Xóa hồ sơ tùy chỉnh đang chọn, sau khi xác nhận."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:68
msgid "Grisé pour les profils fournis."
msgstr "Bị làm mờ với các hồ sơ có sẵn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:69
msgid "Efface son fichier ; la configuration actuelle n'est pas modifiée."
msgstr "Xóa tệp của nó; cấu hình hiện tại không bị thay đổi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:73
msgid "Aucune modification de la configuration depuis cet écran lui-même."
msgstr "Bản thân màn hình này không thay đổi cấu hình."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:79
msgid "Accueil -> Profils -> Créer un profil personnalisé"
msgstr "Trang chủ -> Hồ sơ -> Tạo hồ sơ tùy chỉnh"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:80
msgid "Assistant guidé : on part d'un serveur web minimal sans protection et on choisit chaque réglage dans une liste. Ce que le cœur HTTP impose (analyse stricte, confinement au webroot, rejet de la traversée, normalisation, HSTS jamais sans TLS) reste toujours actif et n'est pas proposé."
msgstr "Trình hướng dẫn từng bước: bắt đầu từ một máy chủ web tối giản không có bảo vệ và chọn từng thiết lập trong một danh sách. Những gì lõi HTTP bắt buộc (phân tích nghiêm ngặt, giới hạn trong webroot, chặn duyệt ngược đường dẫn, chuẩn hóa, không bao giờ HSTS khi không có TLS) luôn được bật và không được đưa ra để chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:85
msgid "Nom, libellé, description"
msgstr "Tên, nhãn, mô tả"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:86
msgid "Identification du profil, relue par le tableau de bord."
msgstr "Định danh của hồ sơ, được bảng điều khiển đọc lại."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:87
msgid "Nom : 3 à 32 caractères a-z, 0-9, « - », « _ » (nom du fichier), jamais celui d'un autre profil. Libellé : 3 à 40 caractères imprimables. Description : 200 au plus."
msgstr "Tên: 3 đến 32 ký tự a-z, 0-9, “-”, “_” (tên tệp), không bao giờ trùng tên hồ sơ khác. Nhãn: 3 đến 40 ký tự in được. Mô tả: tối đa 200."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:89
msgid "Vérifiés à chaque frappe ; l'erreur s'affiche sous le champ, rien n'est effacé."
msgstr "Được kiểm tra mỗi lần gõ phím; lỗi hiển thị dưới trường, không có gì bị xóa."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:90
msgid "Enregistrer reste grisé tant qu'un champ est faux."
msgstr "Nút Lưu bị làm mờ khi còn một trường sai."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:93
msgid "Choix"
msgstr "Lựa chọn"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:94
msgid "En-têtes de sécurité, CSP, fichiers cachés, Host, méthodes HTTP, WAF, authentification, directory listing, FastCGI, cache, proxy de confiance, contrôle d'accès, reverse proxy."
msgstr "Header bảo mật, CSP, tệp ẩn, Host, phương thức HTTP, WAF, xác thực, directory listing, FastCGI, cache, proxy tin cậy, kiểm soát truy cập, reverse proxy."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:96
msgid "Listes déroulantes uniquement : aucune valeur à deviner ou à taper."
msgstr "Chỉ có danh sách thả xuống: không có giá trị nào phải đoán hay gõ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:97
msgid "La vérification se met à jour à chaque changement."
msgstr "Phần kiểm tra cập nhật sau mỗi thay đổi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:98
msgid "Les réglages détaillés (zones, listes, règles) se font ensuite dans la Configuration détaillée, comme pour tout profil."
msgstr "Các thiết lập chi tiết (vùng, danh sách, quy tắc) được thực hiện sau đó trong Cấu hình chi tiết, như với mọi hồ sơ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:102
msgid "Vérification"
msgstr "Kiểm tra"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:103
msgid "Les « trous » de la combinaison choisie : bloquants (ex. FastCGI sans POST) ou à accepter (ex. pas d'en-têtes de sécurité, fichiers cachés servis, pas de WAF), plus les contrôles de la configuration qui en résulterait."
msgstr "Các “lỗ hổng” của tổ hợp đã chọn: chặn (vd. FastCGI không có POST) hoặc cần chấp nhận (vd. không có header bảo mật, tệp ẩn được phục vụ, không có WAF), cùng với các kiểm tra của cấu hình sẽ được tạo ra."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:106
msgid "Un trou bloquant se corrige en changeant un choix ; chaque trou à accepter est décrit, suivi de sa propre case « J'accepte ce point »."
msgstr "Lỗ hổng chặn được sửa bằng cách đổi một lựa chọn; mỗi lỗ hổng cần chấp nhận đều được mô tả, kèm theo ô riêng “Tôi chấp nhận điểm này”."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:108
msgid "Enregistrer n'est actif que sans trou bloquant et avec chaque trou accepté."
msgstr "Nút Lưu chỉ hoạt động khi không có lỗ hổng chặn và mọi lỗ hổng đều đã được chấp nhận."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:109
msgid "Jamais une erreur découverte après coup."
msgstr "Không bao giờ có lỗi bị phát hiện sau khi đã xong."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:112
msgid "Enregistrer crée le profil sans l'appliquer : appliquez-le ensuite depuis l'écran Profils, avec la différence complète affichée avant."
msgstr "Lưu tạo hồ sơ mà không áp dụng nó: sau đó hãy áp dụng từ màn hình Hồ sơ, với toàn bộ khác biệt được hiển thị trước."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:118
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:35
msgid "Appliquer un profil"
msgstr "Áp dụng hồ sơ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:119
msgid "Profils -> Appliquer"
msgstr "Hồ sơ -> Áp dụng"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:120
msgid "Affiche TOUJOURS la différence complète avant toute confirmation, puis écrase la configuration active avec le profil choisi."
msgstr "LUÔN hiển thị toàn bộ khác biệt trước mọi xác nhận, sau đó ghi đè cấu hình đang dùng bằng hồ sơ đã chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:124
msgid "Confirme et écrit le profil choisi."
msgstr "Xác nhận và ghi hồ sơ đã chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:125
msgid "Le diff complet est déjà affiché au-dessus - à vérifier avant de cliquer."
msgstr "Toàn bộ diff đã hiển thị bên trên - hãy kiểm tra trước khi nhấn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:126
msgid "Écrase config/omega-serve.json avec la configuration composée du profil."
msgstr "Ghi đè config/omega-serve.json bằng cấu hình được tạo từ hồ sơ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:128
msgid "Un profil peut changer N'IMPORTE QUEL réglage d'un coup. Si bind/port/listen_backlog/TLS changent, un REDÉMARRAGE COMPLET est nécessaire ; sinon un simple rechargement suffit (automatique si un service actif existe)."
msgstr "Một hồ sơ có thể đổi BẤT KỲ thiết lập nào cùng lúc. Nếu bind/port/listen_backlog/TLS thay đổi, cần KHỞI ĐỘNG LẠI HOÀN TOÀN; nếu không, nạp lại đơn giản là đủ (tự động nếu có dịch vụ đang hoạt động)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:134
msgid "Des conflits ou erreurs de validation bloquants demandent une confirmation supplémentaire explicite pour forcer quand même."
msgstr "Các xung đột hoặc lỗi kiểm tra mang tính chặn đòi hỏi thêm một xác nhận rõ ràng để vẫn ép áp dụng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:136
msgid "Un profil ne modifie QUE les champs qu'il spécifie explicitement - le reste de la configuration active est conservé tel quel."
msgstr "Một hồ sơ CHỈ sửa các trường nó chỉ định rõ - phần còn lại của cấu hình đang dùng được giữ nguyên."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:143
msgid "Accueil -> Audit de sécurité"
msgstr "Trang chủ -> Kiểm tra bảo mật"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:144
msgid "Vérifications consultatives (service, rotation des logs, mode WAF...) - mêmes règles que l'audit CLI."
msgstr "Các kiểm tra mang tính tư vấn (dịch vụ, xoay vòng log, chế độ WAF...) - cùng quy tắc với lệnh audit CLI."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:147
#: src/omega_serv/interfaces/tui/screens/audit_screen.py:53
msgid "Auditer"
msgstr "Kiểm tra"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:148
msgid "Relance explicitement l'audit."
msgstr "Chạy lại kiểm tra một cách rõ ràng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:149
msgid "Aucune saisie - un premier audit a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "Không cần nhập - một lần kiểm tra đầu tiên đã tự động chạy khi mở màn hình."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:150
msgid "Relit la configuration et recalculé toutes les règles d'audit."
msgstr "Đọc lại cấu hình và tính lại mọi quy tắc kiểm tra."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:151
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:539
msgid "Aucun effet sur le serveur (lecture seule) - notifie explicitement le résultat sur un clic explicite."
msgstr "Không có tác dụng lên máy chủ (chỉ đọc) - thông báo rõ kết quả khi nhấn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:154
msgid "Fichiers sensibles sous webroot (PERM-003, PERM-004)"
msgstr "Tệp nhạy cảm dưới webroot (PERM-003, PERM-004)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:155
msgid "Chaque fichier est nommé sous le constat, avec la raison (nom connu comme .env, ou extension comme .key) et ce qu'il contient vraiment, lu dans le fichier et non deviné d'après son nom : clé privée, certificat, conteneur PKCS#12, dossier, contenu présent ou fichier vide."
msgstr "Mỗi tệp được nêu tên dưới nhận định, kèm lý do (tên đã biết như .env, hoặc phần mở rộng như .key) và nội dung thật của nó, được đọc từ tệp chứ không đoán theo tên: khóa riêng, chứng chỉ, vùng chứa PKCS#12, thư mục, có nội dung hoặc tệp trống."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:159
msgid "Un fichier qui a du contenu est critique (PERM-003). Un fichier vide, par exemple un exemple posé pour l'icône du directory listing, est seulement une information (PERM-004)."
msgstr "Tệp có nội dung là mức nghiêm trọng (PERM-003). Tệp trống, ví dụ một tệp mẫu đặt cho biểu tượng của directory listing, chỉ là thông tin (PERM-004)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:161
msgid "Dix fichiers au plus sont listés à l'écran, puis « et N autres » ; la liste complète est dans « omega-serv audit security --format json »."
msgstr "Màn hình liệt kê tối đa mười tệp, sau đó là “và N mục khác”; danh sách đầy đủ có trong “omega-serv audit security --format json”."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:163
msgid "Rien n'est déplacé ni supprimé : à vous de sortir ces fichiers du webroot (ex. secure/)."
msgstr "Không có gì bị di chuyển hay xóa: bạn tự đưa các tệp này ra khỏi webroot (vd: secure/)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:166
#: src/omega_serv/interfaces/tui/guide/content/divers.py:526
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:542
msgid "Purement consultatif - ne modifie jamais rien."
msgstr "Chỉ để tra cứu - không bao giờ sửa gì."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:172
msgid "Accueil -> Sauvegarde de configuration"
msgstr "Trang chủ -> Sao lưu cấu hình"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:173
msgid "Créer, lister, restaurer ou supprimer des sauvegardes complètes de la configuration - le fichier de configuration est toujours inclus, jamais chiffre par défaut."
msgstr "Tạo, liệt kê, khôi phục hoặc xóa các bản sao lưu đầy đủ của cấu hình - tệp cấu hình luôn được bao gồm, mặc định không bao giờ được mã hóa."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:176
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:55
msgid "Tout sauvegarder (configuration complète)"
msgstr "Sao lưu tất cả (cấu hình đầy đủ)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:177
msgid "Coche toutes les cases : de quoi retrouver la configuration entière et ses modules."
msgstr "Đánh dấu mọi ô: đủ để khôi phục toàn bộ cấu hình và các mô-đun của nó."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:178
msgid "Case à cocher ; les secrets (zones Auth, clés TLS) restent confirmés à la création."
msgstr "Ô đánh dấu; các bí mật (vùng Auth, khóa TLS) vẫn cần xác nhận khi tạo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:179
#: src/omega_serv/interfaces/tui/guide/content/divers.py:197
#: src/omega_serv/interfaces/tui/guide/content/divers.py:204
#: src/omega_serv/interfaces/tui/guide/content/divers.py:211
#: src/omega_serv/interfaces/tui/guide/content/divers.py:218
msgid "Pris en compte à la création."
msgstr "Được tính khi tạo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:180
msgid "Ce qui est désigné hors du dossier omega-serv (ex. un certificat dans /etc) n'est jamais archivé, et c'est indiqué après la création."
msgstr "Những gì nằm ngoài thư mục omega-serv (ví dụ một chứng chỉ trong /etc) không bao giờ được lưu trữ, và điều này được báo sau khi tạo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:184
msgid "RIPOSTE, pages d'erreur, préférences, bibliothèque des journaux"
msgstr "RIPOSTE, trang lỗi, tùy chọn cá nhân, thư viện nhật ký"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:185
msgid "Base RIPOSTE ; pages d'erreur personnalisées ; thème, langues et nom du service ; favoris, sources distantes et rotations planifiées des journaux."
msgstr "Cơ sở dữ liệu RIPOSTE; trang lỗi tùy chỉnh; giao diện, ngôn ngữ và tên dịch vụ; mục yêu thích, nguồn từ xa và xoay vòng nhật ký đã lên lịch."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:187
msgid "Cases à cocher. Les règles WAF comprennent aussi les listes de mots-clés et les scripts Magnet."
msgstr "Ô đánh dấu. Quy tắc WAF cũng gồm các danh sách từ khóa và script Magnet."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:188
msgid "Pris en compte à la création ; les bases (Active Defense, RIPOSTE) sont copiées de façon cohérente, serveur en marche."
msgstr "Được tính khi tạo; các cơ sở dữ liệu (Active Defense, RIPOSTE) được sao chép nhất quán khi máy chủ đang chạy."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:190
msgid "Une sauvegarde qui contient une base n'est jamais restaurée sous un serveur actif : « Arrêter, restaurer, redémarrer » est proposé, et les bases actuelles sont mises de côté."
msgstr "Bản sao lưu chứa cơ sở dữ liệu không bao giờ được khôi phục khi máy chủ đang chạy: hệ thống đề xuất « Dừng, khôi phục, khởi động lại », và các cơ sở dữ liệu hiện tại được để riêng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:194
msgid "Inclure les règles WAF"
msgstr "Bao gồm quy tắc WAF"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:195
msgid "Ajoute les règles WAF et la liste de blocage à la sauvegarde."
msgstr "Thêm quy tắc WAF và danh sách chặn vào bản sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:196
#: src/omega_serv/interfaces/tui/guide/content/divers.py:217
msgid "Case à cocher."
msgstr "Ô đánh dấu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:198
#: src/omega_serv/interfaces/tui/guide/content/divers.py:250
msgid "Aucun effet immédiat - juste le contenu de la sauvegarde créée."
msgstr "Không có tác dụng ngay - chỉ là nội dung của bản sao lưu được tạo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:201
msgid "Inclure les zones d'authentification"
msgstr "Bao gồm vùng xác thực"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:202
msgid "Ajoute users.json/zones.json (SECRETS RÉELS : hash de mots de passe) à la sauvegarde."
msgstr "Thêm users.json/zones.json (BÍ MẬT THẬT: hash mật khẩu) vào bản sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:203
#: src/omega_serv/interfaces/tui/guide/content/divers.py:210
msgid "Case à cocher - demande une confirmation supplémentaire explicite si cochée."
msgstr "Ô đánh dấu - yêu cầu thêm một xác nhận rõ ràng nếu được chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:205
msgid "La sauvegarde contient des secrets réels, jamais chiffres."
msgstr "Bản sao lưu chứa bí mật thật, không bao giờ được mã hóa."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:208
msgid "Inclure les certificats"
msgstr "Bao gồm chứng chỉ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:209
msgid "Ajoute les certificats TLS, CLÉS PRIVÉES INCLUSES, à la sauvegarde."
msgstr "Thêm chứng chỉ TLS, BAO GỒM KHÓA RIÊNG, vào bản sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:212
msgid "La sauvegarde contient des clés privées réelles, jamais chiffrées."
msgstr "Bản sao lưu chứa khóa riêng thật, không bao giờ được mã hóa."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:215
msgid "Inclure Active Defense"
msgstr "Bao gồm Active Defense"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:216
msgid "Ajoute la base de menaces/incidents Active Defense à la sauvegarde."
msgstr "Thêm cơ sở dữ liệu mối đe dọa/sự cố Active Defense vào bản sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:219
#: src/omega_serv/interfaces/tui/guide/content/divers.py:278
msgid "Aucun effet immédiat."
msgstr "Không có tác dụng ngay."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:222
msgid "Inclure le contenu du site (webroot)"
msgstr "Bao gồm nội dung trang web (webroot)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:223
msgid "Ajoute tout le dossier du site (pages, images, fichiers), en plus de la configuration."
msgstr "Thêm toàn bộ thư mục trang web (trang, hình ảnh, tệp), ngoài cấu hình."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:224
msgid "Case à cocher, jamais comprise dans « Tout sauvegarder » : ce n'est pas de la configuration, et un gros site rend la sauvegarde longue et lourde."
msgstr "Ô đánh dấu, không bao giờ nằm trong “Sao lưu tất cả”: đây không phải cấu hình, và một trang web lớn khiến bản sao lưu lâu và nặng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:226
msgid "La liste affiche un indicateur d'attente pendant la création ; l'écran reste utilisable."
msgstr "Danh sách hiển thị chỉ báo chờ trong lúc tạo; màn hình vẫn dùng được."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:227
msgid "La configuration, elle, contient déjà tout ce qui a été saisi à la main (alias, rewrites, redirections, directory listing, cache, reverse proxy et ses zones)."
msgstr "Còn cấu hình thì đã chứa mọi thứ được nhập tay (alias, rewrites, chuyển hướng, directory listing, cache, reverse proxy và các vùng của nó)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:231
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:69
msgid "Inclure les données des zones personnalisées"
msgstr "Gồm dữ liệu của các vùng tùy chỉnh"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:232
msgid "Ajoute les dossiers vers lesquels pointent les zones : cible des alias, dossiers du listing (avec leurs fichiers HEADER et README), scripts FastCGI (hors du site par construction). Les réglages de toutes les zones sont déjà dans la configuration."
msgstr "Thêm các thư mục mà các vùng trỏ tới: đích của alias, thư mục listing (cùng tệp HEADER và README của chúng), script FastCGI (vốn nằm ngoài trang web). Thiết lập của mọi vùng đã có trong cấu hình."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:235
msgid "Case à cocher, jamais comprise dans « Tout sauvegarder ». Rewrites, redirections et cache n'ont que des réglages ; le cache du reverse proxy se reconstruit et n'est jamais sauvegardé."
msgstr "Ô đánh dấu, không bao giờ nằm trong “Sao lưu tất cả”. Rewrites, chuyển hướng và bộ nhớ đệm chỉ có thiết lập; bộ nhớ đệm của reverse proxy được dựng lại và không bao giờ được sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:237
msgid "Un dossier déjà couvert par le contenu du site n'est archivé qu'une fois. Une cible hors du dossier omega-serv (alias vers /srv/..., par exemple) est signalée après la création, pas sauvegardée."
msgstr "Thư mục đã nằm trong nội dung trang web chỉ được lưu trữ một lần. Đích nằm ngoài thư mục omega-serv (ví dụ alias tới /srv/...) được báo sau khi tạo, không được sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:240
msgid "À l'import, ces dossiers sont acceptés seulement si la configuration de l'archive les désigne, jamais un emplacement de l'installation (src, tools, native...)."
msgstr "Khi nhập, các thư mục này chỉ được chấp nhận nếu cấu hình của tệp lưu trữ chỉ tới chúng, không bao giờ là một vị trí của bản cài đặt (src, tools, native...)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:244
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:74
msgid "Inclure les rapports d'export"
msgstr "Gồm các báo cáo xuất"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:245
msgid "Ajoute le dossier des exports (rapports HTML, TXT, JSON, IoC...) : celui choisi dans Réglages, var/exports par défaut."
msgstr "Thêm thư mục xuất (báo cáo HTML, TXT, JSON, IoC...): thư mục chọn trong Cài đặt, mặc định là var/exports."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:247
msgid "Case à cocher, jamais comprise dans « Tout sauvegarder » : ce sont des documents produits, pas de la configuration."
msgstr "Ô đánh dấu, không bao giờ nằm trong “Sao lưu tất cả”: đây là tài liệu được tạo ra, không phải cấu hình."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:249
msgid "Un dossier d'export hors du dossier omega-serv est signalé, pas sauvegardé."
msgstr "Thư mục xuất nằm ngoài thư mục omega-serv được báo, không được sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:253
#: src/omega_serv/interfaces/tui/guide/content/divers.py:517
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:87
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:92
#: src/omega_serv/interfaces/tui/screens/full_report_screen.py:68
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:62
#: src/omega_serv/interfaces/tui/screens/logs_menu_screen.py:49
msgid "Exporter"
msgstr "Xuất"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:254
msgid "Copie la sauvegarde SÉLECTIONNÉE hors du dossier omega-serv, avec son empreinte .sha256."
msgstr "Sao chép bản sao lưu ĐANG CHỌN ra ngoài thư mục omega-serv, kèm mã băm .sha256 của nó."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:255
msgid "Dossier de destination (votre dossier personnel par défaut). Un fichier déjà présent n'est jamais écrasé ; l'archive est lisible par vous seul (elle peut contenir des secrets)."
msgstr "Thư mục đích (mặc định là thư mục cá nhân của bạn). Tệp đã có sẵn không bao giờ bị ghi đè; tệp lưu trữ chỉ mình bạn đọc được (nó có thể chứa bí mật)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:257
msgid "Écrit omega-serv-<instance>-<id>.tar.gz et le fichier .sha256 à côté."
msgstr "Ghi omega-serv-<instance>-<id>.tar.gz và tệp .sha256 bên cạnh."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:258
msgid "Une sauvegarde exportée survit à la désinstallation d'omega-serv (le dossier var/backups est supprimé avec l'instance)."
msgstr "Bản sao lưu đã xuất vẫn còn sau khi gỡ cài đặt omega-serv (thư mục var/backups bị xóa cùng với instance)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:262
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:81
msgid "Importer une sauvegarde"
msgstr "Nhập bản sao lưu"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:263
msgid "Ajoute à la liste une sauvegarde exportée, par exemple sur une installation neuve."
msgstr "Thêm vào danh sách một bản sao lưu đã xuất, ví dụ trên một bản cài đặt mới."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:264
msgid "Chemin de l'archive ; son fichier .sha256 doit être à côté. Refusée si l'empreinte est absente ou fausse, si l'archive contient un chemin absolu, « .. », un lien ou un emplacement qu'une sauvegarde omega-serv ne contient pas, ou si elle n'a pas de config/omega-serve.json."
msgstr "Đường dẫn của tệp lưu trữ; tệp .sha256 của nó phải nằm bên cạnh. Bị từ chối nếu mã băm thiếu hoặc sai, nếu tệp lưu trữ chứa đường dẫn tuyệt đối, “..”, liên kết hoặc vị trí mà bản sao lưu omega-serv không có, hoặc nếu nó không có config/omega-serve.json."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:268
msgid "Copie l'archive vérifiée dans la liste ; rien n'est encore restauré."
msgstr "Sao chép tệp lưu trữ đã kiểm tra vào danh sách; chưa có gì được khôi phục."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:269
msgid "La restauration reste une étape à part, confirmée : la fenêtre signale une version d'omega-serv différente et un conflit de port avec une autre instance (on peut alors garder l'adresse, le port et le nom de service de l'instance actuelle)."
msgstr "Khôi phục vẫn là một bước riêng, có xác nhận: cửa sổ báo phiên bản omega-serv khác nhau và xung đột cổng với instance khác (khi đó có thể giữ địa chỉ, cổng và tên dịch vụ của instance này)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:274
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:75
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:98
msgid "Description"
msgstr "Mô tả"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:275
msgid "Note libre associée à la sauvegarde, pour la retrouver plus tard."
msgstr "Ghi chú tự do gắn với bản sao lưu, để tìm lại sau này."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:276
msgid "Texte libre, optionnel."
msgstr "Văn bản tự do, tùy chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:277
msgid "Enregistrée avec la sauvegarde."
msgstr "Được lưu cùng bản sao lưu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:281
#: src/omega_serv/interfaces/tui/screens/backup_screen.py:85
#: src/omega_serv/interfaces/tui/screens/restore_log_archive_screen.py:36
msgid "Restaurer"
msgstr "Khôi phục"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:282
msgid "Écrase les fichiers actuels avec ceux de la sauvegarde sélectionnée, AUX MÊMES EMPLACEMENTS."
msgstr "Ghi đè các tệp hiện tại bằng các tệp trong bản sao lưu đã chọn, TẠI CÙNG VỊ TRÍ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:283
#: src/omega_serv/interfaces/tui/guide/content/divers.py:299
msgid "Sélectionner une sauvegarde, puis confirmer."
msgstr "Chọn một bản sao lưu, rồi xác nhận."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:284
msgid "Écriture réelle et immédiate des fichiers concernés."
msgstr "Ghi thật và ngay lập tức các tệp liên quan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:286
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET par prudence - une restauration peut écraser n'importe quel fichier (configuration, certificats TLS...), et un certificat déjà en mémoire ne se recharge jamais tout seul."
msgstr "LUÔN cần KHỞI ĐỘNG LẠI HOÀN TOÀN để thận trọng - một lần khôi phục có thể ghi đè bất kỳ tệp nào (cấu hình, chứng chỉ TLS...), và chứng chỉ đã nằm trong bộ nhớ không bao giờ tự nạp lại."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:290
msgid "Après la restauration, les dossiers des zones actives qui manquent sur le disque (cible d'un alias, dossier d'un listing, scripts d'une zone FastCGI) sont listés sous la liste des sauvegardes : un alias ou un listing absent répond 404, une zone FastCGI active sans dossier empêche le serveur de démarrer."
msgstr "Sau khi khôi phục, các thư mục của vùng đang hoạt động bị thiếu trên đĩa (đích của alias, thư mục listing, script của vùng FastCGI) được liệt kê bên dưới danh sách bản sao lưu: alias hoặc listing bị thiếu trả về 404, vùng FastCGI đang hoạt động mà không có thư mục sẽ ngăn máy chủ khởi động."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:298
msgid "Supprime définitivement une sauvegarde (n'existe pas côté CLI, confort TUI uniquement)."
msgstr "Xóa vĩnh viễn một bản sao lưu (không có ở CLI, chỉ là tiện ích của TUI)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:300
msgid "Suppression immédiate et définitive."
msgstr "Xóa ngay lập tức và vĩnh viễn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:301
msgid "Aucun effet sur le serveur - seulement sur les sauvegardes disponibles."
msgstr "Không có tác dụng lên máy chủ - chỉ ảnh hưởng đến các bản sao lưu hiện có."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:304
msgid "Restaurer écrase directement les fichiers vises, sans filet - la seule protection est la confirmation demandée avant."
msgstr "Khôi phục ghi đè trực tiếp các tệp liên quan, không có lưới an toàn - biện pháp bảo vệ duy nhất là xác nhận được yêu cầu trước đó."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:309
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:122
msgid "Réglages de l'application"
msgstr "Thiết lập ứng dụng"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:310
msgid "Raccourci clavier 'o' (footer), depuis n'importe quel écran"
msgstr "Phím tắt 'o' (footer), từ bất kỳ màn hình nào"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:312
msgid "PRÉFÉRENCES D'INTERFACE uniquement (thème, rendu, chemins d'export/captures) - PAS des réglages du serveur (ceux-là vivent dans Configuration détaillée)."
msgstr "CHỈ là TÙY CHỌN GIAO DIỆN (giao diện, chế độ hiển thị, đường dẫn xuất/ảnh chụp) - KHÔNG PHẢI thiết lập máy chủ (những thiết lập đó nằm trong Cấu hình chi tiết)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:318
msgid "Thème visuel de l'interface elle-même."
msgstr "Giao diện hình ảnh của chính ứng dụng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:319
msgid "Un des thèmes disponibles."
msgstr "Một trong các giao diện có sẵn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:320
msgid "Appliqué immédiatement au changement."
msgstr "Áp dụng ngay khi thay đổi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:321
msgid "Effet immédiat, aucun redémarrage nécessaire."
msgstr "Có hiệu lực ngay, không cần khởi động lại."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:324
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:207
msgid "Profil de rendu"
msgstr "Hồ sơ hiển thị"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:325
msgid "Force un profil de rendu Textual particulier plutôt que la détection automatique."
msgstr "Ép dùng một hồ sơ hiển thị Textual cụ thể thay vì tự động phát hiện."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:326
msgid "Automatique, ou un profil précis."
msgstr "Tự động, hoặc một hồ sơ cụ thể."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:327
msgid "Enregistre la préférence."
msgstr "Lưu tùy chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:328
msgid "Appliqué seulement AU PROCHAIN DÉMARRAGE de l'interface, jamais à chaud."
msgstr "Chỉ được áp dụng VÀO LẦN KHỞI ĐỘNG TIẾP THEO của giao diện, không bao giờ áp dụng nóng."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:333
msgid "Langue de l'interface. Chaque langue est écrite dans sa propre langue, Français toujours en tête ; le libellé 'Langue / Language' n'est jamais traduit, pour être retrouvé même dans une langue qu'on ne lit pas. Une langue non encore validée porte la mention 'en test'."
msgstr "Ngôn ngữ của giao diện. Mỗi ngôn ngữ được viết bằng chính ngôn ngữ đó, tiếng Pháp luôn đứng đầu; nhãn 'Langue / Language' không bao giờ được dịch, để luôn tìm được kể cả khi đang ở một ngôn ngữ mình không đọc được. Ngôn ngữ chưa được xác nhận sẽ có ghi chú 'đang thử nghiệm'."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:338
msgid "Choisir une langue dans la liste, puis confirmer le redémarrage de l'interface."
msgstr "Chọn một ngôn ngữ trong danh sách, rồi xác nhận khởi động lại giao diện."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:340
msgid "Enregistre la langue puis redémarre L'INTERFACE (pas le service : le serveur continue de tourner). Un écran de confirmation affiche la langue et la phrase d'invite déjà traduite."
msgstr "Lưu ngôn ngữ rồi khởi động lại GIAO DIỆN (không phải dịch vụ: máy chủ vẫn tiếp tục chạy). Một màn hình xác nhận hiển thị ngôn ngữ và câu nhắc đã được dịch."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:344
msgid "Retour au français toujours possible : ce même réglage ; ou lancer une fois 'OMEGA_SERV_LANG=fr serv' ; ou retirer la clé 'language' de var/settings.json. Langue indisponible ou catalogue illisible : l'interface démarre en français avec un message. Les journaux du serveur (journalctl) restent toujours en français."
msgstr "Luôn có thể quay về tiếng Pháp: dùng chính thiết lập này; hoặc chạy một lần 'OMEGA_SERV_LANG=fr serv'; hoặc gỡ khóa 'language' khỏi var/settings.json. Ngôn ngữ không khả dụng hoặc catalogue không đọc được: giao diện khởi động bằng tiếng Pháp kèm một thông báo. Log của máy chủ (journalctl) luôn bằng tiếng Pháp."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:351
msgid "Export / Captures d'écran (chemins)"
msgstr "Xuất / Ảnh chụp màn hình (đường dẫn)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:352
msgid "Répertoires où sont écrits les exports et les captures d'écran."
msgstr "Các thư mục nơi ghi bản xuất và ảnh chụp màn hình."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:353
msgid "Chemin libre - vide revient au répertoire par défaut."
msgstr "Đường dẫn tự do - để trống sẽ quay về thư mục mặc định."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:354
msgid "Enregistre à chaque changement de texte."
msgstr "Lưu mỗi khi văn bản thay đổi."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:355
msgid "Effet immédiat sur les prochains exports/captures."
msgstr "Có hiệu lực ngay với các lần xuất/chụp tiếp theo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:358
#: src/omega_serv/interfaces/tui/screens/settings_screen.py:105
msgid "Langue des exports"
msgstr "Ngôn ngữ bản xuất"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:360
msgid "Langue des exports HTML (registre des capacités, archives de logs, guide d'aide) et du rapport d'incident Markdown - un fichier qui se diffuse, pas forcément à quelqu'un qui lit la langue de l'interface. Les exports JSON et CSV n'ont pas de texte à traduire."
msgstr "Ngôn ngữ của các bản xuất HTML (sổ đăng ký khả năng, kho lưu trữ log, hướng dẫn trợ giúp) và báo cáo sự cố Markdown - một tệp được chia sẻ, không nhất thiết cho người đọc được ngôn ngữ giao diện. Bản xuất JSON và CSV không có văn bản cần dịch."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:364
msgid "« Comme l'interface » (défaut) ou une des langues de la liste."
msgstr "« Giống giao diện » (mặc định) hoặc một trong các ngôn ngữ trong danh sách."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:366
msgid "Enregistre immédiatement. Dans une autre langue que l'interface, chaque export est produit par un processus séparé lancé dans cette langue : quelques secondes, l'interface reste utilisable."
msgstr "Lưu ngay. Với ngôn ngữ khác ngôn ngữ giao diện, mỗi bản xuất được tạo bởi một tiến trình riêng chạy bằng ngôn ngữ đó: vài giây, giao diện vẫn dùng được."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:371
msgid "Si ce processus échoue, l'export HTML n'est pas écrit (raison affichée) ; le rapport d'incident, lui, est quand même écrit dans la langue de l'interface, avec un avertissement."
msgstr "Nếu tiến trình đó thất bại, bản xuất HTML không được ghi (có hiển thị lý do); còn báo cáo sự cố vẫn được ghi bằng ngôn ngữ giao diện, kèm cảnh báo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:376
msgid "Supprimer les exports / Supprimer les screenshots"
msgstr "Xóa bản xuất / Xóa ảnh chụp"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:377
msgid "Vide complètement le répertoire concerne."
msgstr "Làm trống hoàn toàn thư mục liên quan."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:378
msgid "Confirmation obligatoire."
msgstr "Bắt buộc xác nhận."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:379
msgid "Suppression immédiate et définitive de tous les fichiers du répertoire."
msgstr "Xóa ngay lập tức và vĩnh viễn mọi tệp trong thư mục."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:380
msgid "Action irréversible."
msgstr "Hành động không thể hoàn tác."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:383
msgid "Ne touche jamais config/omega-serve.json - réglages purement locaux à cette interface."
msgstr "Không bao giờ động đến config/omega-serve.json - chỉ là thiết lập cục bộ của giao diện này."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:388
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:123
#: src/omega_serv/interfaces/tui/screens/guide_menu_screen.py:69
msgid "Contact et support"
msgstr "Liên hệ và hỗ trợ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:389
msgid "Guide d'aide (touche a) -> Contact et support"
msgstr "Hướng dẫn trợ giúp (phím a) -> Liên hệ và hỗ trợ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:390
msgid "Payer un café au développeur, se déclarer utilisateur anonyme d'omega-serv, contacter le support, ou vérifier si une nouvelle version est publiée. Les adresses sont toujours affichées en clair."
msgstr "Mời nhà phát triển một ly cà phê, khai báo là người dùng ẩn danh của omega-serv, liên hệ hỗ trợ, hoặc kiểm tra xem đã có phiên bản mới được phát hành chưa. Các địa chỉ luôn được hiển thị đầy đủ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:395
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:49
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:53
msgid "Payer un café"
msgstr "Mời một ly cà phê"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:396
msgid "Ouvre la page PayPal du développeur (https://paypal.me/kraynux)."
msgstr "Mở trang PayPal của nhà phát triển (https://paypal.me/kraynux)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:397
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:466
#: src/omega_serv/interfaces/tui/guide/content/tls.py:27
#: src/omega_serv/interfaces/tui/guide/content/tls.py:52
#: src/omega_serv/interfaces/tui/guide/content/tls.py:252
msgid "Aucune saisie."
msgstr "Không cần nhập."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:398
msgid "Ouvre l'adresse dans votre navigateur, même si l'interface tourne sous sudo."
msgstr "Mở địa chỉ trong trình duyệt của bạn, kể cả khi giao diện chạy bằng sudo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:399
msgid "Sans session graphique (SSH, serveur), un message rappelle l'adresse à ouvrir vous-même."
msgstr "Không có phiên đồ họa (SSH, máy chủ), một thông báo nhắc địa chỉ để bạn tự mở."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:402
msgid "Se déclarer utilisateur (anonyme) / Modifier ma déclaration"
msgstr "Khai báo là người dùng (ẩn danh) / Sửa khai báo của tôi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:403
msgid "Ouvre le formulaire de déclaration anonyme."
msgstr "Mở biểu mẫu khai báo ẩn danh."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:404
msgid "Le libellé devient « Modifier ma déclaration » une fois déclaré."
msgstr "Nhãn sẽ thành « Sửa khai báo của tôi » sau khi đã khai báo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:405
msgid "Ouvre le formulaire Se déclarer utilisateur (anonyme)."
msgstr "Mở biểu mẫu Khai báo là người dùng (ẩn danh)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:406
msgid "Aucun effet ici - voir la fiche du formulaire."
msgstr "Không có tác dụng ở đây - xem trang của biểu mẫu."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:409
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:63
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:128
msgid "Ne plus me déclarer"
msgstr "Không khai báo tôi nữa"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:410
msgid "Retire la déclaration."
msgstr "Rút lại khai báo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:411
msgid "Actif seulement une fois déclaré ; une confirmation est demandée."
msgstr "Chỉ hoạt động khi đã khai báo; cần xác nhận."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:412
msgid "Envoie un retrait : votre entrée est supprimée du compteur, puis la clé est effacée de cette installation et les envois quotidiens s'arrêtent."
msgstr "Gửi yêu cầu rút lại: mục của bạn bị xóa khỏi bộ đếm, sau đó khóa bị xóa khỏi bản cài đặt này và việc gửi hằng ngày dừng lại."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:414
msgid "Réception injoignable : la clé est quand même effacée ; l'entrée disparaît seule (90 jours en envoi quotidien, 1 an en envoi unique)."
msgstr "Không kết nối được nơi nhận: khóa vẫn bị xóa; mục sẽ tự biến mất (90 ngày với gửi hằng ngày, 1 năm với gửi một lần)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:418
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:65
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:69
msgid "Contacter le support"
msgstr "Liên hệ hỗ trợ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:419
msgid "Ouvre le formulaire de contact du site (https://kraynux.snake-mackarel.ts.net/contact/). L'adresse kraynux@proton.me est aussi affichée."
msgstr "Mở biểu mẫu liên hệ của trang web (https://kraynux.snake-mackarel.ts.net/contact/). Địa chỉ kraynux@proton.me cũng được hiển thị."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:421
msgid "Aucune saisie : omega-serv n'envoie jamais de message lui-même."
msgstr "Không cần nhập gì: omega-serv không bao giờ tự gửi thư."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:422
msgid "Ouvre l'adresse dans votre navigateur."
msgstr "Mở địa chỉ trong trình duyệt của bạn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:423
msgid "Sans session graphique, recopiez l'adresse affichée."
msgstr "Không có phiên đồ họa, hãy sao chép địa chỉ được hiển thị."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:426
msgid "Vérifier les mises à jour / Voir les nouveautés"
msgstr "Kiểm tra cập nhật / Xem có gì mới"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:427
msgid "Compare la version installée (aussi affichée dans la barre de titre) à la liste des versions publiées sur le site (download/sha.txt)."
msgstr "So sánh phiên bản đã cài (cũng hiển thị trên thanh tiêu đề) với danh sách các phiên bản đã phát hành trên trang web (download/sha.txt)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:429
msgid "Seulement sur votre clic : aucune vérification automatique, rien n'est envoyé. Même vérification en ligne de commande : omega-serv version --check."
msgstr "Chỉ khi bạn nhấp: không có kiểm tra tự động, không có gì được gửi đi. Kiểm tra tương tự trên dòng lệnh: omega-serv version --check."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:431
msgid "Affiche « à jour », la nouvelle version avec l'adresse de son archive, ou une version en cours plus récente que la dernière publiée."
msgstr "Hiển thị \"đã cập nhật\", phiên bản mới kèm địa chỉ tệp lưu trữ của nó, hoặc phiên bản đang phát triển mới hơn phiên bản mới nhất đã phát hành."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:433
msgid "Si une version plus récente existe, « Voir les nouveautés » ouvre son résumé dans votre navigateur. Rien n'est installé : la mise à jour se fait comme décrit dans le README."
msgstr "Nếu có phiên bản mới hơn, \"Xem có gì mới\" sẽ mở bản tóm tắt của nó trong trình duyệt. Không có gì được cài đặt: việc cập nhật được thực hiện như mô tả trong README."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:437
msgid "Rien n'est envoyé sans un clic explicite sur Envoyer (formulaire de déclaration) ou sur Ne plus me déclarer."
msgstr "Không gì được gửi nếu không bấm rõ ràng vào Gửi (biểu mẫu khai báo) hoặc Không khai báo tôi nữa."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:443
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:124
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:55
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:61
#: src/omega_serv/interfaces/tui/screens/contact_support_screen.py:96
msgid "Se déclarer utilisateur (anonyme)"
msgstr "Khai báo là người dùng (ẩn danh)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:444
msgid "Contact et support -> Se déclarer utilisateur (anonyme)"
msgstr "Liên hệ và hỗ trợ -> Khai báo là người dùng (ẩn danh)"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:445
msgid "Déclaration volontaire et anonyme : elle compte les utilisateurs d'omega-serv et, si vous le souhaitez, leur continent ou leur pays. Rien n'est activé par défaut."
msgstr "Khai báo tự nguyện và ẩn danh: dùng để đếm số người dùng omega-serv và, nếu bạn muốn, châu lục hoặc quốc gia của họ. Mặc định không bật gì cả."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:449
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:85
msgid "Envoi"
msgstr "Gửi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:450
msgid "Une seule fois, ou chaque jour."
msgstr "Một lần, hoặc mỗi ngày."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:451
msgid "Obligatoire, aucun choix présélectionné : Envoyer reste grisé tant qu'il n'est pas choisi."
msgstr "Bắt buộc, không có lựa chọn sẵn: nút Gửi bị mờ cho đến khi chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:452
msgid "Une seule fois : un envoi maintenant. Chaque jour : le service omega-serv renvoie le même message au plus une fois par 24 h, ce qui permet de compter les installations actives."
msgstr "Một lần: gửi một lần ngay bây giờ. Mỗi ngày: dịch vụ omega-serv gửi lại cùng thông điệp tối đa một lần mỗi 24 giờ, nhờ đó có thể đếm các bản cài đặt đang hoạt động."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:454
msgid "L'envoi quotidien tourne dans un processus à part : il ne ralentit jamais le serveur, ni au démarrage ni à l'arrêt. DO_NOT_TRACK=1 dans l'environnement du service le désactive."
msgstr "Việc gửi hằng ngày chạy trong một tiến trình riêng: không bao giờ làm chậm máy chủ, cả khi khởi động lẫn khi dừng. Đặt DO_NOT_TRACK=1 trong môi trường của dịch vụ sẽ tắt nó."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:458
msgid "Continent / Pays"
msgstr "Châu lục / Quốc gia"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:459
msgid "Deux listes indépendantes, facultatives, chacune avec « Autre (non référencé) »."
msgstr "Hai danh sách độc lập, không bắt buộc, mỗi danh sách có « Khác (không có trong danh sách) »."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:460
msgid "Laisser « Non précisé » pour ne rien envoyer de ce champ."
msgstr "Để « Không nêu » nếu không muốn gửi gì cho trường này."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:461
msgid "Ajoute le code choisi au message (EU, FR... ou autre)."
msgstr "Thêm mã đã chọn vào thông điệp (EU, FR... hoặc autre)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:462
msgid "Ni ville, ni texte libre."
msgstr "Không có thành phố, không có văn bản tự do."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:465
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:102
msgid "Message envoyé"
msgstr "Thông điệp được gửi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:466
msgid "Le message exact, mis à jour à chaque choix."
msgstr "Thông điệp chính xác, được cập nhật sau mỗi lựa chọn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:467
#: src/omega_serv/interfaces/tui/guide/content/divers.py:504
#: src/omega_serv/interfaces/tui/guide/content/riposte.py:197
msgid "Lecture seule."
msgstr "Chỉ đọc."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:468
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:45
msgid "Aucune."
msgstr "Không có."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:469
msgid "Une clé tirée au hasard (32 caractères) est créée au premier envoi, sous var/lib/declaration/ ; elle ne dérive ni de la machine ni de vous."
msgstr "Một khóa ngẫu nhiên (32 ký tự) được tạo ở lần gửi đầu tiên, trong var/lib/declaration/; nó không được suy ra từ máy cũng như từ bạn."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:473
#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:115
msgid "Envoyer"
msgstr "Gửi"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:474
msgid "Envoie la déclaration en HTTPS vers le site du développeur."
msgstr "Gửi khai báo qua HTTPS đến trang web của nhà phát triển."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:475
msgid "5 secondes au plus ; l'écran ne se fige pas."
msgstr "Tối đa 5 giây; màn hình không bao giờ bị treo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:476
msgid "Succès : retour à Contact et support, état « déclaré »."
msgstr "Thành công: quay lại Liên hệ và hỗ trợ, trạng thái « đã khai báo »."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:477
msgid "Réception injoignable : en « une seule fois », rien n'est enregistré ; en « chaque jour », l'accord est gardé et le service réessaie dans 24 h."
msgstr "Không kết nối được nơi nhận: với « một lần », không có gì được ghi lại; với « mỗi ngày », sự đồng ý được giữ lại và dịch vụ thử lại sau 24 giờ."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:482
msgid "L'adresse IP n'est pas enregistrée dans les déclarations, mais comme pour toute visite d'un site, elle passe par les contrôles de sécurité et le journal technique du serveur de réception."
msgstr "Địa chỉ IP không được ghi trong các khai báo, nhưng như với bất kỳ lượt truy cập trang web nào, nó đi qua các kiểm tra bảo mật và nhật ký kỹ thuật của máy chủ nhận."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:484
msgid "Ligne de commande : omega-serv declaration status | declare --mode unique|quotidien [--continent X] [--pays Y] --yes | withdraw."
msgstr "Dòng lệnh: omega-serv declaration status | declare --mode unique|quotidien [--continent X] [--pays Y] --yes | withdraw."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:492
msgid "Accueil -> Rapport complet"
msgstr "Trang chủ -> Báo cáo đầy đủ"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:493
msgid "Ce qui est configuré et actif, d'un coup d'œil, sans passer par chaque menu : réglages et système, jamais le trafic des visiteurs. Aucun secret : mots de passe, clés et jetons apparaissent au plus comme « défini » ou « absent »."
msgstr "Những gì đã cấu hình và đang hoạt động, trong một lần xem, không cần vào từng menu: thiết lập và hệ thống, không bao giờ có lưu lượng của khách truy cập. Không có bí mật: mật khẩu, khóa và token hiển thị tối đa là “đã đặt” hoặc “không có”."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:498
msgid "Sommaire"
msgstr "Tóm tắt"

#: src/omega_serv/interfaces/tui/guide/content/divers.py:499
msgid "Le minimum, toujours présent : identité (instance, dossier, version, profil, machine), fonctionnement (service, unité, en marche, démarrage, uptime, compte, processus), adresse et mode (site web, reverse proxy ou les deux), moteur utilisé, TLS (expiration), options, nombres de zones, sécurité, contrôles de la configuration, sauvegardes, journaux."
msgstr "Phần tối thiểu, luôn có mặt: định danh (instance, thư mục, phiên bản, hồ sơ, máy), hoạt động (dịch vụ, unit, đang chạy, khởi động cùng máy, uptime, tài khoản, tiến trình), địa chỉ và chế độ (trang web, reverse proxy hoặc cả hai), bộ máy đang dùng, TLS (hết hạn), tùy chọn, số lượng vùng, bảo mật, kiểm tra cấu hình, bản sao lưu, nhật ký."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:503
msgid "Actualiser relit tout ; un indicateur d'attente s'affiche pendant la génération."
msgstr "Làm mới đọc lại mọi thứ; một chỉ báo chờ hiển thị trong lúc tạo báo cáo."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:505
msgid "L'écran ne gèle jamais, même sur un serveur très configuré."
