msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:25
msgid "Deux zones ne peuvent pas avoir le même préfixe (/blog et /blog/ comptent pour un)."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:26
msgid "Valider enregistre la zone, après validation ; une erreur reste affichée dans le formulaire, saisie intacte."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:29
msgid "Si l'option fastcgi est déjà activé : rechargement suffit (automatique si un service actif existe). Sinon, sa PREMIÈRE activation exige un redémarrage complet."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:34
