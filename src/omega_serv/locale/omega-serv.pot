msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:586
msgid "L'adresse du maître doit être dans les réseaux permis de cette instance (Configuration distante), sinon ses appels reçoivent 403."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:588
msgid "Hors de cette machine, l'administration web est toujours en HTTPS : c'est ce qui protège le jeton du maître."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:596
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:84
msgid "Administration web - alertes"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:597
msgid "Accueil -> Instances -> Configuration distante -> Alertes"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:598
msgid "Alertes locales : rien n'est envoyé hors de cette machine. Le processus d'administration surveille le disque, la mémoire, le swap, le processeur, la température, la batterie, le taux d'erreurs 5xx du site, les backends, les incidents Active Defense et les certificats. Une alerte s'ouvre quand le seuil est dépassé pendant un moment, et se ferme quand la mesure redescend nettement."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:604
#: src/omega_serv/interfaces/tui/screens/admin_alerts_screen.py:60
msgid "Seuils"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:605
msgid "Un seuil par règle ; vide = règle coupée."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:606
msgid "Nombre dans les bornes indiquées. Disque 90 %, mémoire 90 %, swap 80 %, processeur 95 %, température 85 °C, batterie 15 %, erreurs 5xx 5 % (sur 5 minutes, à partir de 50 requêtes), certificat 30 jours (puis 14, 7 et 1)."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:609
msgid "Enregistrer, puis Recharger : le processus d'administration prend les nouveaux seuils."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:610
msgid "Une alerte ouverte d'une règle coupée se ferme."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:613
msgid "Maintenance 1 h / 24 h, Fin de maintenance"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:614
msgid "Pendant une maintenance, aucune nouvelle alerte ne s'ouvre ; celles déjà ouvertes se ferment normalement."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:616
msgid "Avant un redémarrage, une mise à jour, un gros transfert."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:617
msgid "Effet immédiat (fichier var/lib/admin/alertes-maintenance.json)."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:618
msgid "Le panneau web l'indique en haut de la vue Alertes."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:621
msgid "Les alertes s'affichent dans le panneau web (vue Alertes, avec leur nombre dans la barre des vues) et dans var/log/alertes.log ; 30 jours d'historique dans var/lib/admin/alertes.json."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:624
msgid "Il faut l'administration web active (en boucle locale suffit, rien n'est ouvert au réseau). Disque, mémoire, swap, processeur, température, batterie et erreurs 5xx demandent aussi l'Historique."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:626
msgid "Un service arrêté ne peut rien signaler lui-même : les alertes s'arrêtent avec lui."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:632
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:85
msgid "Administration web - sessions ouvertes"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:633
msgid "Accueil -> Instances -> Configuration distante -> Comptes -> Sessions"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:634
msgid "Navigateurs connectés au panneau web : compte, adresse, ouverture et dernière activité. Liste publiée toutes les 5 secondes par le processus d'administration, sans jamais le jeton de session."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:638
#: src/omega_serv/interfaces/tui/screens/admin_sessions_screen.py:38
msgid "Fermer la session"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:639
msgid "Déconnecte le navigateur choisi."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:640
msgid "Choisir une session dans la liste."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:641
msgid "Dépose une demande que le processus d'administration applique dans les 5 secondes."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:642
msgid "Ligne « session fermee par TUI » dans le journal d'audit ; le navigateur revient à la page de connexion."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:646
msgid "Aussi dans le panneau web (vue Sessions) : un compte administration y voit et ferme toutes les sessions, un compte lecture les siennes."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:649
msgid "Une session vit 30 minutes sans activité et 8 heures au plus ; un redémarrage du service les ferme toutes."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:11
msgid "Accueil -> Configuration détaillée -> FastCGI / PHP-FPM"
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:13
msgid "Liste des zones PHP : chaque zone relaie un préfixe d'URL vers un serveur PHP-FPM (sa socket), avec ses propres scripts, délais, extensions, fichiers d'index et liste blanche, et son propre interrupteur. Plusieurs applications PHP peuvent ainsi tourner sur une même instance (/blog/ et /wiki/, par exemple) ; le préfixe le plus long l'emporte. L'option fastcgi du menu Options reste l'interrupteur général. Une ancienne configuration à une seule zone s'affiche comme une ligne de la liste et passe au nouveau format au premier enregistrement."
msgstr ""

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:22
