msgstr "<chiave estratta a caso all'invio>"

#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:162
msgid "Envoi en cours..."
msgstr "Invio in corso..."

#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:178
msgid ""
"Réception injoignable : votre accord est gardé, le serveur réessaiera dans "
"24 h."
msgstr ""
"Ricezione irraggiungibile: il vostro consenso viene conservato, il server "
"riproverà tra 24 h."

#: src/omega_serv/interfaces/tui/screens/declaration_screen.py:183
msgid "Réception injoignable : rien n'a été enregistré, réessayez plus tard."
msgstr ""
"Ricezione irraggiungibile: non è stato registrato nulla, riprovate più "
"tardi."

