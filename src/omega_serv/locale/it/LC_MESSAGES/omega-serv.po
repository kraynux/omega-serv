msgstr "Aggiorna rilancia la scansione; le esportazioni scrivono un file con data e ora."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:27
msgid "Aucun effet sur le serveur ou sa configuration (lecture seule + export)."
msgstr "Nessun effetto sul server né sulla sua configurazione (sola lettura + esportazione)."

#: src/omega_serv/interfaces/tui/guide/content/divers.py:30
