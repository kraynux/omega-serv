msgstr "영구 차단을 확정합니다."

#: src/omega_serv/interfaces/cli/main.py:1899
#: src/omega_serv/interfaces/cli/main.py:1905
msgid "OUTIL"
msgstr "도구"

#: src/omega_serv/interfaces/cli/main.py:1900
msgid ""
"Outil qui pose le ban (ex. omega-fire) : lui seul pourra le lever avec "
"--origin."
msgstr "차단을 설정하는 도구(예: omega-fire): 그 도구만 --origin으로 해제할 수 있습니다."

#: src/omega_serv/interfaces/cli/main.py:1902
msgid "Lève un ban."
msgstr "차단을 해제합니다."

#: src/omega_serv/interfaces/cli/main.py:1904
