#: src/omega_serv/interfaces/cli/main.py:1890
msgid ""
"text (défaut, traduit) ou json (pour les autres outils, jamais traduit)."
msgstr "text(기본값, 번역됨) 또는 json(다른 도구용, 번역 안 함)."

