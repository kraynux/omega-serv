#: src/omega_serv/interfaces/tui/guide/content/accueil.py:41
msgid "Ouvre le menu de configuration détaillée."
msgstr "상세 설정 메뉴를 엽니다."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:42
#: src/omega_serv/interfaces/tui/guide/content/accueil.py:49
#: src/omega_serv/interfaces/tui/guide/content/accueil.py:79
msgid "Dépend de l'écran ouvert ensuite - voir sa propre fiche."
msgstr "다음에 여는 화면에 따라 다름 - 해당 항목 참조."

#: src/omega_serv/interfaces/tui/guide/content/accueil.py:45
#: src/omega_serv/interfaces/tui/guide/content/faq.py:468
#: src/omega_serv/interfaces/tui/guide/content/faq.py:1060
