msgstr "관찰된 경로(기본값: /)."

#: src/omega_serv/interfaces/cli/main.py:1921
msgid "User-Agent de la source."
msgstr "출처의 User-Agent."

#: src/omega_serv/interfaces/cli/main.py:1922
#: src/omega_serv/interfaces/cli/riposte_query_commands.py:230
msgid "CLASSE"
msgstr "분류"

