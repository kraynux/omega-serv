msgstr "자동으로 차단되지 않는 네트워크를 표시합니다(omega-jail이 읽음)."

#: src/omega_serv/interfaces/cli/main.py:1887
msgid "Adresses bannies."
msgstr "차단된 주소."

#: src/omega_serv/interfaces/cli/main.py:1888
