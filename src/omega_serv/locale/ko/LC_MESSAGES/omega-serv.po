msgid "Affiche la configuration chargée, en JSON."
msgstr "불러온 설정을 JSON으로 표시합니다."

#: src/omega_serv/interfaces/cli/main.py:1799
msgid "Active TLS dans la configuration."
msgstr "설정에서 TLS를 활성화합니다."

#: src/omega_serv/interfaces/cli/main.py:1801
msgid "Certificat à utiliser (sinon celui déjà configuré)."
msgstr "사용할 인증서(지정하지 않으면 이미 설정된 인증서)."

#: src/omega_serv/interfaces/cli/main.py:1803
msgid "Clé privée à utiliser (sinon celle déjà configurée)."
msgstr "사용할 개인 키(지정하지 않으면 이미 설정된 키)."

#: src/omega_serv/interfaces/cli/main.py:1805
msgid ""
"direct : omega-serv chiffre lui-même ; behind_proxy : derrière un reverse "
