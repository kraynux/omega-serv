#: src/omega_serv/domain/security/riposte/scenarios.py:31
#: src/omega_serv/domain/security/riposte/scenarios.py:37
#: src/omega_serv/interfaces/tui/screens/riposte_policy_form_screen.py:93
msgid "Scanner récidiviste"
msgstr "재범 스캐너"

#: src/omega_serv/domain/security/riposte/scenarios.py:32
msgid "Un site exposé qui voit revenir les mêmes robots d'exploration."
msgstr "같은 크롤러가 계속 돌아오는 공개 사이트."

#: src/omega_serv/domain/security/riposte/scenarios.py:33
msgid ""
"Au 3e épisode de scan d'une même IP en 7 jours, ban local de plus en plus "
"long (paliers : 1 h, 6 h, 24 h, 7 j)."
msgstr "같은 IP의 7일 내 세 번째 스캔 에피소드에서 점점 더 긴 로컬 차단(단계: 1시간, 6시간, 24시간, 7일)."

#: src/omega_serv/domain/security/riposte/scenarios.py:35
msgid ""
"Ne réagit jamais à un premier passage : le WAF et son ban automatique s'en "
"chargent."
msgstr "첫 방문에는 절대 반응하지 않습니다: WAF와 그 자동 차단이 처리합니다."

#: src/omega_serv/domain/security/riposte/scenarios.py:43
#: src/omega_serv/domain/security/riposte/scenarios.py:49
msgid "Force brute"
msgstr "무차별 대입"

#: src/omega_serv/domain/security/riposte/scenarios.py:44
msgid "Un site avec une page de connexion ou une zone protégée."
msgstr "로그인 페이지나 보호 영역이 있는 사이트."

#: src/omega_serv/domain/security/riposte/scenarios.py:45
msgid ""
"Au 2e épisode d'essais d'identifiants d'une même IP en 24 h, ban local "
"progressif."
msgstr "같은 IP의 24시간 내 두 번째 자격 증명 시도 에피소드에서 단계별 로컬 차단."

#: src/omega_serv/domain/security/riposte/scenarios.py:46
msgid ""
"Ne voit que ce que le WAF classe en essais d'identifiants : les erreurs 401 "
"seules restent pour la jail omega-jail « auth-bruteforce »."
msgstr ""
"WAF가 자격 증명 시도로 분류한 것만 봅니다: 401 오류만 있는 경우는 omega-jail의 jail 'auth-"
"bruteforce'에 맡깁니다."

#: src/omega_serv/domain/security/riposte/scenarios.py:55
#: src/omega_serv/domain/security/riposte/scenarios.py:60
msgid "Injections répétées"
msgstr "반복 인젝션"

#: src/omega_serv/domain/security/riposte/scenarios.py:56
msgid ""
"Tout site : une injection (SQL, XSS, commandes) ou une traversée de chemin "
"n'est jamais un accident."
msgstr "모든 사이트: 인젝션(SQL, XSS, 명령)이나 경로 탐색은 결코 우연이 아닙니다."

#: src/omega_serv/domain/security/riposte/scenarios.py:57
msgid ""
"Dès le 2e épisode d'injection d'une même IP en 24 h, ban local progressif."
msgstr "같은 IP의 24시간 내 두 번째 인젝션 에피소드부터 단계별 로컬 차단."

#: src/omega_serv/domain/security/riposte/scenarios.py:58
msgid ""
"Pas de ban réseau par défaut : l'ajouter dans le formulaire si omega-jail "
"est installé."
msgstr "기본적으로 네트워크 차단 없음: omega-jail이 설치되어 있으면 양식에서 추가하세요."

#: src/omega_serv/domain/security/riposte/scenarios.py:66
#: src/omega_serv/domain/security/riposte/scenarios.py:71
msgid "Explorateur de leurres"
msgstr "미끼 탐색자"

#: src/omega_serv/domain/security/riposte/scenarios.py:67
msgid "Un site qui utilise les leurres d'Active Defense."
msgstr "Active Defense 미끼를 사용하는 사이트."

#: src/omega_serv/domain/security/riposte/scenarios.py:68
msgid "Une IP qui a déjà visité 2 leurres pendant un épisode y reste 24 h."
msgstr "한 에피소드 동안 이미 미끼 두 개를 방문한 IP는 24시간 동안 그곳에 머뭅니다."

#: src/omega_serv/domain/security/riposte/scenarios.py:69
msgid ""
"Ne bannit pas : la source continue de voir le leurre, pas le vrai site."
msgstr "차단하지 않습니다: 출처는 실제 사이트 대신 계속 미끼를 보게 됩니다."

#: src/omega_serv/domain/security/riposte/scenarios.py:78
#: src/omega_serv/domain/security/riposte/scenarios.py:83
msgid "Sonde upload / API"
msgstr "업로드 / API 탐색"

#: src/omega_serv/domain/security/riposte/scenarios.py:79
msgid "Un site avec une API ou un envoi de fichiers."
msgstr "API나 파일 업로드가 있는 사이트."

#: src/omega_serv/domain/security/riposte/scenarios.py:80
msgid ""
"Une IP qui sonde l'envoi de fichiers ou l'API est envoyée 24 h vers le "
"leurre « fake_api »."
msgstr "파일 업로드나 API를 탐색하는 IP는 24시간 동안 'fake_api' 미끼로 보내집니다."

#: src/omega_serv/domain/security/riposte/scenarios.py:81
msgid ""
"Ne bannit pas ; exige le profil de leurre « fake_api » activé dans Active "
"Defense."
msgstr "차단하지 않습니다. Active Defense에서 'fake_api' 미끼 프로필을 활성화해야 합니다."

#: src/omega_serv/domain/security/tls/acme.py:44
msgid "le domaine ne peut pas être vide"
msgstr "도메인은 비워 둘 수 없습니다"

#: src/omega_serv/domain/security/tls/acme.py:46
msgid "le chemin du webroot ne peut pas être vide"
msgstr "webroot 경로는 비워 둘 수 없습니다"

#: src/omega_serv/domain/security/tls/acme.py:48
msgid "le chemin du script de hook ne peut pas être vide"
msgstr "hook 스크립트 경로는 비워 둘 수 없습니다"

#: src/omega_serv/domain/security/tls/renewal_schedule.py:78
#, python-brace-format
msgid ""
"Aucun mécanisme de planification automatique détecté sur ce système (ni systemd, ni crontab). Ajoutez cette ligne vous-même à votre planificateur habituel (crontab -e, /etc/cron.d/, tâche OpenRC/runit équivalente...) :\n"
"\n"
"{cron_line}"
msgstr ""
"이 시스템에서 자동 예약 메커니즘이 감지되지 않았습니다(systemd도 crontab도 없음). 평소 쓰는 스케줄러(crontab -e, /etc/cron.d/, 동등한 OpenRC/runit 작업...)에 다음 행을 직접 추가하십시오:\n"
"\n"
"{cron_line}"

