msgstr "为所选事件生成一份完整的 Markdown 报告。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:252
msgid "Écrit un fichier Markdown dans le répertoire d'export configuré."
msgstr "在所配置的导出目录中写入一个 Markdown 文件。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:256
msgid "Purement consultatif sauf fermeture d'incident (irréversible) et exports (écriture disque)."
msgstr "纯粹用于查看，关闭事件（不可撤销）和导出（写入磁盘）除外。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:261
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:111
msgid "Active Defense - Leurres"
msgstr "Active Defense - 诱饵"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:262
msgid "Accueil -> Active Sécurité -> Deception"
msgstr "主页 -> 主动安全 -> Deception"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:263
msgid "Liste les affectations actives (et expirées non libérées) vers les leurres de deception, permet de les libérer."
msgstr "列出到 deception 诱饵的有效分配（以及已过期但未释放的分配），并可释放它们。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:266
#: src/omega_serv/interfaces/tui/screens/deception_screen.py:44
msgid "Libérer"
msgstr "释放"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:267
msgid "Retire l'affectation d'une source vers son leurre."
msgstr "移除某个来源到其诱饵的分配。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:268
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:609
msgid "Sélectionner une ligne, puis confirmer."
msgstr "选择一行，然后确认。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:269
msgid "Libère immédiatement l'affectation."
msgstr "立即释放该分配。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:270
msgid "Effet immédiat - la source n'est plus redirigée vers le leurre à la prochaine requête."
msgstr "立即生效 - 下一个请求时，该来源不再被重定向到诱饵。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:274
msgid "Les affectations expirées mais jamais libérées restent visibles avec l'état 'expirée' - distinct d'une libération manuelle."
msgstr "已过期但从未释放的分配仍以“已过期”状态显示 - 与手动释放不同。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:281
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:107
msgid "Active Defense - Simuler"
msgstr "Active Defense - 模拟"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:282
msgid "Accueil -> Active Sécurité -> Simuler"
msgstr "主页 -> 主动安全 -> 模拟"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:283
msgid "Simule une décision Active Defense (score, classe d'attaque) SANS aucun effet réel - dry-run complet."
msgstr "模拟一次 Active Defense 判定（分数、攻击类别），没有任何实际效果 - 完整的演练（dry-run）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:286
msgid "IP simulée"
msgstr "模拟 IP"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:287
msgid "Adresse IP source utilisée pour la simulation. Depuis la 3.0.0, une source est identifiée par son adresse seule : le User-Agent, choisi par le client, n'y entre plus."
msgstr "用于模拟的源 IP 地址。自 3.0.0 起，来源仅按其地址识别：由客户端选择的 User-Agent 不再计入。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:289
msgid "Une IP quelconque. Valeur par défaut : 203.0.113.42."
msgstr "任意 IP。默认值：203.0.113.42。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:290
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:297
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:304
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:311
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:506
msgid "Utilisée au clic sur Simuler."
msgstr "点击“模拟”时使用。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:291
msgid "Aucun effet réel - aucune écriture, aucun impact réseau."
msgstr "没有实际效果 - 不写入任何内容，不影响网络。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:294
msgid "Chemin simulé"
msgstr "模拟路径"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:295
msgid "Chemin de la requête simulée."
msgstr "模拟请求的路径。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:296
msgid "Chaîne libre. Valeur par défaut : /wp-login.php."
msgstr "自由文本。默认值：/wp-login.php。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:298
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:305
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:312
msgid "Aucun effet réel."
msgstr "没有实际效果。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:301
#: src/omega_serv/interfaces/tui/screens/riposte_simulate_screen.py:55
msgid "Classe d'attaque"
msgstr "攻击类别"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:302
msgid "Type d'attaque simulé."
msgstr "模拟的攻击类型。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:303
msgid "Doit être une classe connue (ex: scan). Valeur par défaut : scan."
msgstr "必须是已知的类别（例如：scan）。默认值：scan。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:308
#: src/omega_serv/interfaces/tui/screens/threats_screen.py:47
msgid "Score"
msgstr "分数"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:309
msgid "Delta de score appliqué à la simulation."
msgstr "应用于模拟的分数增量。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:310
msgid "Entier. Valeur par défaut : 10."
msgstr "整数。默认值：10。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:315
msgid "Aucune - dry-run complet, jamais d'écriture (aucun repository.save()/create() appelé)."
msgstr "无 - 完整的演练，从不写入（不调用任何 repository.save()/create()）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:320
msgid "WAF - État"
msgstr "WAF - 状态"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:321
msgid "Accueil -> Active Sécurité -> État (bloc WAF)"
msgstr "主页 -> 主动安全 -> 状态（WAF 模块）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:323
msgid "Vue d'ensemble en lecture seule : mode, comportement en cas d'erreur interne, packs de règles référencés, taille de la blocklist. Avec le moteur natif, aussi : combien de règles il évalue lui-même, s'il sert seul les requêtes sans correspondance (sinon pourquoi), et le contrôle 1/N."
msgstr "只读总览：模式、内部错误时的行为、已引用的规则包、封禁列表的大小。使用原生引擎时还显示：它自行检查多少条规则、是否独自响应没有匹配的请求（如果不是，原因是什么）以及 1/N 抽查。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:331
msgid "Si aucun pack de règles n'est référence, le WAF ne peut RIEN détecter même actif - l'écran l'indique explicitement, corrige un vrai trou signalé par l'utilisateur."
msgstr "如果没有引用任何规则包，即使启用了 WAF 也什么都检测不到 - 界面会明确指出这一点，修复了用户报告的一个真实漏洞。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:339
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:98
msgid "WAF - Modules"
msgstr "WAF - 模块"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:340
msgid "Accueil -> Active Sécurité -> Modules (bloc WAF)"
msgstr "主页 -> 主动安全 -> 模块（WAF 模块）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:341
msgid "Trois sections : mode/comportement d'erreur et inspection du corps, gestion des packs de règles actifs, gestion de la liste de blocage."
msgstr "三个部分：模式/错误行为和请求体检查、已启用规则包的管理、封禁列表的管理。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:345
msgid "Comportement du WAF face à une requête jugée malveillante."
msgstr "WAF 面对被判定为恶意的请求时的行为。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:346
msgid "log-only (journalise sans bloquer) ou block (bloque réellement)."
msgstr "log-only（只记录不拦截）或 block（真正拦截）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:348
msgid "Rechargement AUTOMATIQUE déclenché des l'enregistrement si un service actif existe."
msgstr "如有活动服务，保存后会自动触发重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:351
msgid "Comportement en cas d'erreur interne"
msgstr "内部错误时的行为"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:352
msgid "Que faire si le moteur WAF rencontre une erreur inattendue en analysant une requête."
msgstr "WAF 引擎在分析请求时遇到意外错误该怎么办。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:353
msgid "fail-open (laisse passer) ou fail-closed (bloque par prudence)."
msgstr "fail-open（放行）或 fail-closed（出于谨慎而拦截）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:354
#: src/omega_serv/interfaces/tui/guide/content/tls.py:343
msgid "Enregistre avec le mode."
msgstr "与模式一起保存。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:355
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:382
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:392
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:407
msgid "Rechargement automatique."
msgstr "自动重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:358
msgid "Contrôle du moteur natif (native_check_every)"
msgstr "原生引擎抽查（native_check_every）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:360
msgid "Avec le moteur natif, une requête sur laquelle aucune règle ne correspond est servie sans passer par Python. Ce réglage en soumet quand même une sur N à Python, pour vérifier que les deux donnent le même verdict."
msgstr "使用原生引擎时，没有任何规则匹配的请求不经过 Python 直接响应。此设置仍会每 N 个中交给 Python 一个，以核对两者的判定是否一致。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:365
msgid "Entier de 0 à 1000000. 0 (par défaut) = jamais ; 1000 = une requête propre sur mille, un coût négligeable. Sans effet avec le moteur Python."
msgstr "0 到 1000000 的整数。0（默认）= 从不；1000 = 每一千个干净请求抽查一个，开销可忽略。使用 Python 引擎时无效。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:368
msgid "Enregistre dans options.waf.native_check_every, avec le mode."
msgstr "与模式一起保存到 options.waf.native_check_every。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:370
msgid "Rechargement automatique. La requête contrôlée reçoit le verdict de Python ; un désaccord est écrit dans le journal d'erreurs."
msgstr "自动重新加载。被抽查的请求采用 Python 的判定；不一致会写入错误日志。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:375
msgid "Taille du corps de requête inspectée (body_max_inspect_bytes)"
msgstr "检查的请求体大小（body_max_inspect_bytes）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:377
msgid "Le WAF n'inspecte que le début du corps d'une requête, sur toutes les routes (statique, reverse proxy, FastCGI, envoi de fichiers). Le corps entier part toujours vers la route."
msgstr "WAF 在所有路由（静态、反向代理、FastCGI、文件上传）上只检查请求体的开头部分。完整的请求体始终会发送到路由。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:380
msgid "Nombre d'octets, 65536 par défaut. Plus grand = plus de CPU par requête."
msgstr "字节数，默认 65536。越大，每个请求消耗的 CPU 越多。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:381
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:391
msgid "Enregistre dans options.waf.inspect, avec le mode."
msgstr "与模式一起保存到 options.waf.inspect。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:385
msgid "Corps plus grand que cette taille (body_over_limit)"
msgstr "大于此大小的请求体（body_over_limit）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:386
msgid "Ce que devient la partie du corps que le WAF n'a pas inspectée."
msgstr "WAF 未检查的那部分请求体如何处理。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:388
msgid "pass (par défaut) : la suite part sans inspection ; reject : la requête est refusée (413), en mode block seulement."
msgstr "pass（默认）：其余部分不经检查直接发送；reject：拒绝请求（413），仅在 block 模式下。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:395
msgid "Fichiers binaires non inspectés (binary_formats)"
msgstr "不检查的二进制文件（binary_formats）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:397
msgid "Formats de fichiers que le WAF ne lit pas comme du texte : une image ou une archive contient forcément des suites d'octets qui ressemblent à une attaque, et serait refusée à tort."
msgstr "WAF 不按文本读取的文件格式：图片或压缩包必然含有看似攻击的字节序列，会被误拒。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:401
msgid "Le format est reconnu au contenu réel (signature des premiers octets), jamais à l'extension ni au seul type annoncé. Un formulaire, du JSON, du XML ou du texte est toujours inspecté ; dans un formulaire avec fichiers, seuls les fichiers reconnus sont retirés. Par défaut, tous les formats connus ; vide = tout inspecter, comme avant la 3.0.0."
msgstr "格式按真实内容（前几个字节的签名）识别，从不按扩展名，也不仅凭声明的类型。表单、JSON、XML 或文本始终检查；在带文件的表单中，只移除被识别的文件。默认：所有已知格式；留空 = 全部检查，与 3.0.0 之前相同。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:406
msgid "Enregistre dans options.waf.inspect, avec le mode ; un format inconnu est refusé."
msgstr "连同模式保存到 options.waf.inspect；未知格式会被拒绝。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:410
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:108
msgid "Packs de règles (rule_paths)"
msgstr "规则包（rule_paths）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:411
msgid "Fichiers de règles réellement charges par le WAF - sans au moins un pack, rien n'est détecté."
msgstr "WAF 真正加载的规则文件 - 没有至少一个规则包，就什么都检测不到。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:412
msgid "Ajouter ouvre un sélecteur des packs présents sous secure/waf/rules/ non déjà référencés."
msgstr "“添加”会打开一个选择器，列出 secure/waf/rules/ 下尚未引用的规则包。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:413
msgid "Ajoute/retire une référence de pack."
msgstr "添加/移除一个规则包引用。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:414
msgid "Rechargement automatique déclenché immédiatement (recompile les règles en mémoire)."
msgstr "立即自动触发重新加载（在内存中重新编译规则）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:417
#: src/omega_serv/interfaces/tui/screens/waf_modules_screen.py:117
msgid "Liste de blocage"
msgstr "封禁列表"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:419
msgid "IP/reseaux bannis, avec motif et expiration optionnelle. Fichier par défaut : var/lib/waf/blocklist.json (sous var/, le seul dossier où le service systemd peut écrire ses auto-bans). Un ancien secure/waf/blocklist.json est repris une fois au démarrage et laissé en place comme sauvegarde."
msgstr "被封禁的 IP/网络，带原因和可选的过期时间。默认文件：var/lib/waf/blocklist.json（位于 var/ 下，这是 systemd 服务唯一可以写入其自动封禁记录的目录）。旧的 secure/waf/blocklist.json 会在启动时被迁移一次，并保留在原处作为备份。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:424
msgid "Réseau (CIDR), motif, durée en secondes (vide = permanent, confirmation requise dans ce cas)."
msgstr "网络（CIDR）、原因、以秒为单位的时长（留空 = 永久，此时需要确认）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:425
msgid "« Bloquer un réseau » ajoute une entrée, « Débloquer » retire celle qui est sélectionnée (boutons de la barre du bas, toujours visibles)."
msgstr "“封禁网络”添加一项，“解除封禁”删除选中的一项（底部栏的按钮，始终可见）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:428
msgid "EFFET IMMÉDIAT, sans rechargement nécessaire - la blocklist est relue depuis le disque à CHAQUE requête, jamais mise en cache en mémoire (contrairement au mode et aux packs de règles)."
msgstr "立即生效，无需重新加载 - 封禁列表在每个请求时都从磁盘重新读取，从不缓存在内存中（与模式和规则包不同）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:435
msgid "Mode/comportement d'erreur/packs de règles nécessitent un rechargement pour s'appliquer (automatique si un service actif existe). La liste de blocage, elle, s'applique instantanément sans aucune action supplémentaire."
msgstr "模式/错误行为/规则包需要重新加载才能生效（如有活动服务则自动进行）。而封禁列表则会立即生效，无需任何额外操作。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:443
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:99
msgid "WAF - Limitations (exclusions et débit)"
msgstr "WAF - 限制(排除项与速率限制)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:444
msgid "Accueil -> Active Sécurité -> Limitations (bloc WAF)"
msgstr "首页 -> 主动安全 -> 限制(WAF 区块)"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:446
msgid "Règle la limite de débit (rate limit) du WAF natif : la limite globale, des règles par dossier et des règles par IP/réseau, ainsi que les exclusions d'inspection. Sert surtout aux pages lourdes (une galerie d'images, par exemple) qui dépassent la limite globale et reçoivent une erreur 429."
msgstr "设置原生 WAF 的速率限制（rate limit）：全局限制、按目录的规则和按 IP/网络的规则，以及检查排除项。主要用于超出全局限制并收到 429 错误的重型页面（例如图片图库）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:453
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:84
msgid "Limite globale"
msgstr "全局限制"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:454
msgid "Nombre de requêtes autorisées par IP et par fenêtre, pour tout ce qui n'a pas de règle spécifique."
msgstr "每个 IP 在每个时间窗口内允许的请求数，适用于所有没有专门规则的内容。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:455
msgid "Rate limit actif (oui/non), nombre de requêtes, fenêtre en secondes."
msgstr "启用 rate limit（是/否）、请求数、时间窗口（秒）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:457
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:902
msgid "Rechargement automatique déclenché si un service actif existe."
msgstr "如有活动服务，会自动触发重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:460
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:94
msgid "Règles par dossier"
msgstr "按目录的规则"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:462
msgid "Une règle REMPLACE la limite globale pour ce dossier et a son propre compteur : les requêtes sur ce dossier ne consomment plus la limite globale. 0 = illimité. Si plusieurs dossiers correspondent, le plus long gagne. /images couvre /images/a.png mais jamais /images2."
msgstr "规则会替换该目录的全局限制，并拥有独立计数器：对该目录的请求不再消耗全局限制。0 = 不限。若有多个目录匹配，最长者优先。/images 覆盖 /images/a.png，但绝不覆盖 /images2。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:467
msgid "Ajouter / Modifier : dossier, requêtes par fenêtre, fenêtre en secondes. Sélectionner une ligne pour la modifier ou la retirer."
msgstr "添加 / 修改：目录、每个窗口的请求数、窗口（秒）。选中一行即可修改或移除。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:468
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:486
msgid "Enregistré dès la validation du formulaire."
msgstr "表单确认后立即保存。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:470
msgid "Rechargement automatique. Une IP publique qui dépasse une règle de dossier est toujours journalisée comme un blocage, donc bannissable par omega-jail."
msgstr "自动重新加载。超出目录规则的公网 IP 仍记录为拦截，因此可被 omega-jail 封禁。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:475
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:109
msgid "Règles par IP / réseau"
msgstr "按 IP / 网络的规则"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:477
msgid "Même principe pour une IP ou un réseau (ex. le réseau Tailscale 100.64.0.0/10). Une règle de dossier passe avant une règle IP/réseau ; entre deux réseaux, le plus précis gagne."
msgstr "对 IP 或网络同理（例如 Tailscale 网络 100.64.0.0/10）。目录规则优先于 IP/网络规则；两个网络之间，更精确者优先。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:482
msgid "IP ou réseau (CIDR), requêtes, fenêtre, Source sûre (oui/non). Une source sûre qui dépasse la limite reçoit toujours le 429, mais la ligne est journalisée « throttle » : jamais bannissable."
msgstr "IP 或网络（CIDR）、请求数、窗口、可信来源（是/否）。超出限制的可信来源仍会收到 429，但该行记录为“throttle”：绝不会被封禁。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:488
msgid "Les réseaux never_auto_block (affichés au-dessus du tableau) sont toujours sûrs d'office. Sans proxy de confiance actif, une règle couvrant 127.0.0.1/::1 est ignorée."
msgstr "never_auto_block 网络（显示在表格上方）始终默认可信。未启用可信代理时，覆盖 127.0.0.1/::1 的规则会被忽略。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:494
#: src/omega_serv/interfaces/tui/screens/waf_rate_limit_screen.py:120
msgid "Exclusions d'inspection"
msgstr "检查排除项"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:495
msgid "Dossiers et extensions jamais inspectés par le WAF natif ni par magnet, et dossiers dont seul le corps n'est pas inspecté."
msgstr "原生 WAF 和 magnet 均不检查的目录和扩展名，以及仅不检查请求体的目录。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:496
msgid "Valeurs séparées par des virgules ; un dossier commence par « / »."
msgstr "以逗号分隔；目录以“/”开头。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:497
msgid "Enregistre au clic sur « Enregistrer les exclusions » (barre du bas, toujours visible)."
msgstr "点击“保存排除项”时保存（底部栏，始终可见）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:498
msgid "Le rate limit s'applique toujours à ces chemins : une exclusion ne règle jamais un 429."
msgstr "速率限制仍作用于这些路径：排除项永远解决不了 429。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:501
msgid "Une règle de débit ne désactive jamais l'inspection : une attaque sur un dossier à débit élevé reste détectée et bloquée."
msgstr "速率规则绝不会关闭检查：针对高速率目录的攻击仍会被检测并拦截。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:504
msgid "Un dossier en illimité (0) ne protège plus contre un robot qui le martèle depuis une IP publique : préférer une valeur haute (ex. 600 / 60 s) à l'illimité."
msgstr "不限（0）的目录无法再防御从公网 IP 狂刷的机器人：建议使用较高的值（例如 600 / 60 秒）而不是不限。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:508
msgid "Sans rapport avec « Requêtes max par connexion keep-alive » (Configuration détaillée -> Résistance et limites) : ce réglage ferme seulement une connexion après N requêtes, le navigateur en rouvre une aussitôt. Il ne renvoie jamais 429 et ne compte rien par IP : c'est la limite de débit, ici, qui produit le 429."
msgstr "与“每个 keep-alive 连接的最大请求数”（详细配置 -> 抗压与限制）无关：该设置只是在 N 个请求后关闭连接，浏览器会立即重新打开一个。它从不返回 429，也不按 IP 计数：这里产生 429 的是速率限制。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:514
msgid "Script magnet : son propre rate limit (429) ne compte jamais comme une détection, donc ne mène jamais à l'auto-ban. Sur une requête couverte par une règle de dossier ou d'IP/réseau ci-dessus, c'est cette règle qui fait foi : le 429 de magnet est ignoré (ses signatures d'attaque restent appliquées)."
msgstr "magnet 脚本：它自身的速率限制（429）绝不计为检测，因此绝不会导致自动封禁。对于受上方目录或 IP/网络规则覆盖的请求，以该规则为准：magnet 的 429 会被忽略（其攻击特征仍然生效）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:524
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:97
msgid "WAF - Tester une requête"
msgstr "WAF - 测试请求"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:525
msgid "Accueil -> Active Sécurité -> Tester (bloc WAF)"
msgstr "主页 -> 主动安全 -> 测试（WAF 模块）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:526
msgid "Teste une requête simulée contre les règles WAF ACTUELLEMENT ENREGISTRÉES (pas nécessairement celles réellement chargées par un serveur déjà lancé), sans requête réseau."
msgstr "用当前已保存的 WAF 规则（不一定是已启动服务器真正加载的规则）测试一个模拟请求，不发出网络请求。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:529
msgid "Méthode / Chemin / Query / Body / IP distante"
msgstr "方法 / 路径 / Query / Body / 远程 IP"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:530
msgid "Composants de la requête HTTP simulée."
msgstr "模拟 HTTP 请求的组成部分。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:531
msgid "Valeurs libres - méthode et chemin pré-remplis (GET, /)."
msgstr "自由填写 - 方法和路径已预填（GET，/）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:532
msgid "Utilisés au clic sur Tester."
msgstr "点击“测试”时使用。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:533
msgid "Aucun effet réel, aucune requête réseau."
msgstr "没有实际效果，不发出网络请求。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:539
msgid "Reconstruit le moteur WAF à partir de la configuration SAUVEGARDÉE sur disque à chaque test - si un serveur déjà lancé n'a pas encore été rechargé après un changement de règles, ce test peut refléter un comportement différent de ce que ce serveur applique réellement pour l'instant."
msgstr "每次测试都会根据磁盘上已保存的配置重建 WAF 引擎 - 如果已启动的服务器在规则更改后尚未重新加载，此测试反映的行为可能与该服务器目前实际应用的行为不同。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:549
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:100
msgid "WAF - Règles et listes personnalisées"
msgstr "WAF - 自定义规则与列表"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:550
msgid "Accueil -> Active Sécurité -> Custom (bloc WAF)"
msgstr "主页 -> 主动安全 -> Custom（WAF 模块）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:552
msgid "Un seul tableau pour les RÈGLES (écrites dans secure/waf/rules/custom.json, pack référence automatiquement) et les LISTES (fichiers texte de secure/waf/rules/keywords/, chargées explicitement par l'assistant). La colonne Type fait la différence : une liste n'est pas une règle de custom.json."
msgstr "一张表格同时显示规则（写入 secure/waf/rules/custom.json，规则包自动引用）和列表（secure/waf/rules/keywords/ 中的文本文件，由向导显式加载）。“类型”列用于区分：列表不是 custom.json 中的规则。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:560
msgid "Ouvre l'assistant : une règle simple, ou CHARGER une liste (voir sa fiche)."
msgstr "打开向导：一条简单规则，或加载一个列表（见其说明）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:561
msgid "Clic, puis suivre l'assistant."
msgstr "点击，然后按向导操作。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:562
msgid "Règle : écrite dans custom.json. Liste : ajoutée à options.waf.rules.keyword_lists."
msgstr "规则：写入 custom.json。列表：添加到 options.waf.rules.keyword_lists。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:563
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:747
msgid "Rechargement automatique déclenché immédiatement si un service actif existe."
msgstr "如有活动服务，立即自动触发重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:566
msgid "Colonne Détail (listes)"
msgstr "详情列（列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:567
msgid "Nombre d'entrées du fichier, ou un avertissement."
msgstr "文件中的条目数量，或一条警告。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:569
msgid "'fichier absent', 'illisible par le service' ou 'emplacement refusé' : la liste n'est pas chargeable telle quelle - ouvrez-la avec Éditer la liste."
msgstr "“文件缺失”“服务无法读取”或“位置被拒绝”：该列表无法按原样加载 - 请用“编辑列表”打开它。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:572
msgid "Recalculé à chaque affichage du tableau."
msgstr "每次显示表格时重新计算。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:573
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:580
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:651
msgid "Aucun effet en lui-même."
msgstr "本身没有效果。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:576
msgid "Colonne Gravité (listes)"
msgstr "严重级别列（列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:577
msgid "Observation, Faible, Moyen, Élevé ou Critique, suivie de la récidive propre à la liste."
msgstr "观察、低、中、高或严重，后接列表自己的再犯设置。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:578
msgid "Ex. 'Élevé, 2 en 10 min -> ban 24 h'."
msgstr "例如“高，10 分钟内 2 次 -> 封禁 24 小时”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:579
msgid "Se change avec Modifier."
msgstr "用“修改”更改。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:583
msgid "Modifier (listes)"
msgstr "修改（列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:584
msgid "Change gravité, récidive, zone de recherche et nom affiché d'une liste déjà chargée."
msgstr "更改已加载列表的严重级别、再犯设置、查找范围和显示名称。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:585
msgid "Sélectionner une ligne Liste, puis Modifier."
msgstr "选择一行“列表”，然后点击“修改”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:587
msgid "Vérifie la nouvelle configuration comme au chargement : rendre bloquante une liste qui toucherait une route du site est refusé avec la raison."
msgstr "像加载时一样检查新配置：如果让某个会影响网站路由的列表变为拦截模式，会被拒绝并说明原因。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:590
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:604
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:611
msgid "Rechargement automatique déclenché immédiatement."
msgstr "立即自动触发重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:593
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:89
msgid "Éditer la liste"
msgstr "编辑列表"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:594
msgid "Ouvre l'éditeur intégré sur le fichier de la liste (voir sa fiche)."
msgstr "在内置编辑器中打开列表文件（见其说明）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:595
msgid "Sélectionner une ligne Liste, puis Éditer la liste."
msgstr "选择一行“列表”，然后点击“编辑列表”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:596
msgid "Aucune écriture tant que l'éditeur n'a pas enregistré."
msgstr "在编辑器保存之前不写入任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:597
msgid "Le tableau est rafraîchi à la fermeture de l'éditeur."
msgstr "关闭编辑器时刷新表格。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:600
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_screen.py:91
msgid "Activer/Desactiver"
msgstr "启用/禁用"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:601
msgid "Bascule une règle ou une liste sans la supprimer."
msgstr "切换一条规则或一个列表的状态而不删除它。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:602
msgid "Sélectionner une ligne, puis cliquer."
msgstr "选择一行，然后点击。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:603
msgid "Règle : champ enabled de custom.json. Liste : champ enabled de keyword_lists."
msgstr "规则：custom.json 的 enabled 字段。列表：keyword_lists 的 enabled 字段。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:607
msgid "Supprimer / Retirer"
msgstr "删除 / 移除"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:608
msgid "Supprimer une règle, ou Retirer une liste du WAF."
msgstr "删除一条规则，或从 WAF 中移除一个列表。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:610
msgid "Règle : retirée de custom.json. Liste : retirée de la configuration, FICHIER CONSERVÉ."
msgstr "规则：从 custom.json 中移除。列表：从配置中移除，文件保留。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:615
msgid "Une règle ou une liste refusée par la validation est refusée ICI de la même façon qu'elle le serait au chargement réel - jamais une double logique de validation divergente."
msgstr "验证拒绝的规则或列表，在这里会以与真正加载时完全相同的方式被拒绝 - 从不存在两套不一致的验证逻辑。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:620
msgid "Piège déjà rencontré par un utilisateur : ajouter le PACK via 'Modules' n'est pas la même chose que créer une RÈGLE ici - cet écran fait désormais les deux à la fois automatiquement."
msgstr "用户曾遇到的陷阱：通过“模块”添加规则包，与在这里创建规则不是一回事 - 现在此界面会自动同时完成这两件事。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:625
msgid "Retirer une liste ne supprime jamais son fichier : il reste proposé par l'assistant, prêt à être rechargé."
msgstr "移除列表从不删除其文件：它仍会出现在向导中，随时可以重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:633
msgid "WAF - Assistant règle personnalisée / chargement de liste"
msgstr "WAF - 自定义规则向导 / 加载列表"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:634
msgid "WAF - Règles et listes personnalisées -> Ajouter"
msgstr "WAF - 自定义规则与列表 -> 添加"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:636
msgid "Questionnaire en langage clair pour construire une règle WAF sans connaître les expressions régulières (4 scénarios courants + mode Avance), OU pour CHARGER une liste de chemins / de mots-clés depuis un fichier texte. Le chargement d'une liste est une action explicite : rien n'est actif avant le clic sur Charger."
msgstr "用通俗语言填写的问卷，无需了解正则表达式即可构建 WAF 规则（4 种常见场景 + 高级模式），或者从文本文件加载路径/关键词列表。加载列表是一个显式操作：点击“加载”之前什么都不会生效。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:643
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:140
msgid "Que voulez-vous détecter ?"
msgstr "您想检测什么？"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:644
msgid "Choisit le scénario de détection."
msgstr "选择检测场景。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:646
msgid "Un chemin précis visite, un mot-clé dans l'adresse/parametres, un mot-clé envoyé en formulaire (POST), un outil de scan connu (User-Agent), Avance (regex/portee libres), CHARGER une liste de chemins, CHARGER une liste de mots-clés."
msgstr "访问某个特定路径、地址/参数中的关键词、表单（POST）中提交的关键词、已知的扫描工具（User-Agent）、高级（自由的正则/范围）、加载路径列表、加载关键词列表。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:650
msgid "Change les champs affiches en dessous et leur indice."
msgstr "改变下方显示的字段及其提示。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:654
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:144
msgid "Valeur à détecter (mode simple)"
msgstr "要检测的值（简单模式）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:655
msgid "Le texte à repérer, saisi en clair (jamais une regex à écrire)."
msgstr "要查找的文本，直接输入（从不需要写正则）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:656
msgid "Un mot ou un chemin, selon le scénario choisi ci-dessus."
msgstr "一个词或一个路径，取决于上面所选的场景。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:657
msgid "La regex réelle est CONSTRUITE automatiquement par le code (caractères spéciaux jamais interprétés)."
msgstr "真正的正则由代码自动构建（特殊字符从不被解释）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:658
msgid "Aucun effet avant validation sur l'écran précédent (WafCustomRuleScreen)."
msgstr "在上一个界面（WafCustomRuleScreen）确认之前无效果。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:661
msgid "Portée / Motif (mode Avance)"
msgstr "范围 / 模式（高级模式）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:662
msgid "Portée et expression régulière écrites directement."
msgstr "直接书写的范围和正则表达式。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:663
msgid "Portée : path, query, body, headers, user_agent, referer (séparés par des virgules)."
msgstr "范围：path、query、body、headers、user_agent、referer（用逗号分隔）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:664
msgid "Utilisé tel quel si Avance est choisi."
msgstr "选择“高级”时按原样使用。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:665
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:672
msgid "Aucun effet avant validation sur l'écran précédent."
msgstr "在上一个界面确认之前无效果。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:668
msgid "Gravité (règle)"
msgstr "严重级别（规则）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:669
msgid "Poids de la règle dans le calcul du score de menace."
msgstr "规则在威胁分数计算中的权重。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:670
msgid "Faible/Moyen/Eleve/Critique (1/3/6/9)."
msgstr "低/中/高/严重（1/3/6/9）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:671
msgid "Inclus dans la règle produite."
msgstr "包含在生成的规则中。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:675
msgid "Fichier de liste (CHARGER)"
msgstr "列表文件（加载）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:676
msgid "Le fichier texte qui contient la liste."
msgstr "包含列表的文本文件。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:678
msgid "Vos fichiers .txt de secure/waf/rules/keywords/ (avec leur nombre d'entrées), les références livrées avec omega-serv (sensitive-paths-hostile, sensitive-paths-probe) pas encore copiées, ou 'Nouveau fichier...' (nom en lettres, chiffres et '-')."
msgstr "您在 secure/waf/rules/keywords/ 中的 .txt 文件（及其条目数量）、omega-serv 随附但尚未复制的参考列表（sensitive-paths-hostile、sensitive-paths-probe），或“新文件...”（名称只能用字母、数字和 '-'）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:683
msgid "Une référence est COPIÉE dans keywords/ au chargement : c'est cette copie locale que vous modifiez, une mise à jour d'omega-serv ne l'écrase jamais. Choisir une référence pré-remplit tous les réglages conseillés."
msgstr "参考列表在加载时会被复制到 keywords/：您修改的是这份本地副本，omega-serv 更新时从不覆盖它。选择参考列表会预填所有建议的设置。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:687
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:697
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:704
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:715
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:728
msgid "Aucun effet avant Charger."
msgstr "点击“加载”之前无效果。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:690
msgid "Où chercher (liste de chemins)"
msgstr "查找位置（路径列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:691
msgid "N'importe où dans l'adresse, ou seulement au début."
msgstr "地址中的任何位置，或仅在开头。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:693
msgid "Partout attrape /blog/.env ; au début seulement est plus prudent pour des chemins qu'un vrai site peut servir (/api, /admin)."
msgstr "“任何位置”能捕获 /blog/.env；对于真实网站可能会提供的路径（/api、/admin），“仅在开头”更稳妥。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:696
msgid "Champ anchor de la liste (any_segment / root)."
msgstr "列表的 anchor 字段（any_segment / root）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:700
msgid "Dans quelle partie de la requête (liste de mots-clés)"
msgstr "请求的哪一部分（关键词列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:701
msgid "Où chercher les mots-clés."
msgstr "在哪里查找关键词。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:702
msgid "L'adresse et ses paramètres, un formulaire envoyé (POST), le User-Agent, ou le Referer."
msgstr "地址及其参数、提交的表单（POST）、User-Agent 或 Referer。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:703
msgid "Champ scope de la liste."
msgstr "列表的 scope 字段。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:707
msgid "Gravité (liste)"
msgstr "严重级别（列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:708
msgid "Observation, Faible (1), Moyen (3), Élevé (6), Critique (9)."
msgstr "观察、低（1）、中（3）、高（6）、严重（9）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:710
msgid "Observation (conseillé au premier chargement) : alertes journalisées, AUCUN blocage, aucune récidive. Élevé (6) atteint le seuil de blocage : 403 dès le premier accès. Moyen (3) ne bloque jamais seul."
msgstr "观察（首次加载时建议）：记录告警，不拦截，没有再犯处理。高（6）达到拦截阈值：首次访问即返回 403。中（3）单独永远不会拦截。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:714
msgid "Champs weight et observe_only de la liste."
msgstr "列表的 weight 和 observe_only 字段。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:718
msgid "Récidive"
msgstr "再犯"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:719
msgid "Bannir après N accès à CETTE liste en M minutes, pendant une durée choisie."
msgstr "在 M 分钟内命中此列表 N 次后封禁，时长可选。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:721
msgid "'pas de récidive propre' = compteur commun du WAF. Références : hostile 2 accès en 10 min -> 24 h, sondage 5 en 10 min -> 1 h. Grise en Observation."
msgstr "“无专属再犯设置”= 使用 WAF 的公共计数器。参考值：hostile 10 分钟内 2 次 -> 24 小时，探测 10 分钟内 5 次 -> 1 小时。在“观察”模式下呈灰色。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:725
msgid "Ban applicatif temporaire (blocklist, réponse 451), jamais pour l'hôte local (derrière un proxy de confiance), Tailscale ou le réseau local."
msgstr "临时的应用层封禁（封禁列表，响应 451），从不针对本机（位于可信代理之后时）、Tailscale 或局域网。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:731
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:170
msgid "Ouvrir l'éditeur"
msgstr "打开编辑器"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:732
msgid "Ouvre le fichier choisi dans l'éditeur intégré (ou la référence si pas encore copiée)."
msgstr "在内置编辑器中打开所选文件（如果尚未复制，则打开参考列表）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:733
msgid "Pour vérifier ou adapter la liste AVANT de la charger."
msgstr "用于在加载之前检查或调整列表。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:734
msgid "Rien n'est chargé dans le WAF depuis l'éditeur."
msgstr "从编辑器中不会向 WAF 加载任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:735
msgid "Les nombres d'entrées sont rafraîchis à la fermeture."
msgstr "关闭时刷新条目数量。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:738
#: src/omega_serv/interfaces/tui/screens/waf_custom_rule_wizard_screen.py:270
msgid "Charger"
msgstr "加载"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:739
msgid "Charge la liste dans le WAF."
msgstr "将列表加载到 WAF 中。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:740
msgid "Dernier clic de l'assistant."
msgstr "向导的最后一次点击。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:742
msgid "Vérifie, dans l'ordre : nom de fichier, syntaxe (numéro de ligne en cas d'erreur), lisibilité par le compte du service, absence de doublon, conflits avec les routes du site. Si une seule vérification échoue, la configuration n'est PAS modifiée. Active ensuite la réputation et l'auto-ban s'ils étaient éteints (avec un message)."
msgstr "依次检查：文件名、语法（出错时给出行号）、服务账户能否读取、是否重复、与网站路由是否冲突。只要有一项检查失败，配置就不会被修改。之后，如果信誉和自动封禁处于关闭状态，会将它们开启（并显示一条消息）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:751
msgid "Règle : ne fait qu'assembler les valeurs, l'écriture a lieu sur l'écran WAF - Règles et listes personnalisées. Liste : rien n'est actif tant que Charger n'a pas réussi."
msgstr "规则：只负责组合各项值，写入在“WAF - 自定义规则与列表”界面上进行。列表：在“加载”成功之前什么都不会生效。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:756
msgid "Une liste qui bloque seule (gravité >= 5) et qui toucherait une route réellement servie (alias, reverse proxy, zone Auth, fichier du webroot) est refusée : ajoutez une exception '!/chemin' dans la liste, ou chargez-la en Observation."
msgstr "能够单独拦截（严重级别 >= 5）且会影响真正提供服务的路由（别名、反向代理、Auth 区域、webroot 中的文件）的列表会被拒绝：请在列表中添加 '!/路径' 例外，或以“观察”模式加载。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:765
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:102
msgid "WAF - Éditeur de liste"
msgstr "WAF - 列表编辑器"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:766
msgid "WAF - Règles et listes personnalisées -> Éditer la liste (ou Assistant -> Ouvrir l'éditeur)"
msgstr "WAF - 自定义规则与列表 -> 编辑列表（或 向导 -> 打开编辑器）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:768
msgid "Éditeur de texte intégré, sans éditeur externe, pour une liste de chemins ou de mots-clés. Tout se fait à la SOURIS : aucun raccourci clavier, le clavier ne sert qu'à la saisie (caractères, Entrée, flèches, Debut/Fin, Page prec./suiv., Retour arrière, Suppr)."
msgstr "内置文本编辑器，无需外部编辑器，用于编辑路径列表或关键词列表。一切都用鼠标完成：没有任何键盘快捷键，键盘只用于输入（字符、回车、方向键、Home/End、PageUp/PageDown、退格、Delete）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:774
msgid "Syntaxe d'une liste de chemins"
msgstr "路径列表的语法"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:775
msgid "Une entrée par ligne, '#' = commentaire."
msgstr "每行一个条目，'#' = 注释。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:777
msgid "/admin -> /admin et /admin/xxx (jamais /administrator) ; /.git/ -> tout ce qui est sous /.git/ ; /*.bak -> fichiers finissant par .bak ; !/api/v1 -> exception, toujours prioritaire sur les entrées, quel que soit l'ordre des lignes."
msgstr "/admin -> /admin 和 /admin/xxx（从不包括 /administrator）；/.git/ -> /.git/ 下的所有内容；/*.bak -> 以 .bak 结尾的文件；!/api/v1 -> 例外，始终优先于普通条目，与行的顺序无关。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:781
msgid "Analysée en direct (compteur d'entrées, d'exceptions, d'erreurs et d'avertissements)."
msgstr "实时分析（条目、例外、错误和警告计数）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:782
msgid "Les erreurs s'affichent avec leur numéro de ligne ; cliquer une erreur place le curseur dessus."
msgstr "错误会连同行号一起显示；点击某个错误会把光标移到该处。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:785
msgid "Barre d'outils"
msgstr "工具栏"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:786
msgid "Annuler la modif, Rétablir, Couper, Copier, Coller, Sélectionner la ligne, Tout sélectionner, Supprimer la ligne."
msgstr "撤销修改、重做、剪切、复制、粘贴、选择整行、全选、删除整行。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:787
msgid "Clic. Le collage du terminal (clic du milieu, menu du terminal) fonctionne aussi."
msgstr "点击。终端的粘贴（鼠标中键、终端菜单）也可以使用。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:788
msgid "Modifie le texte affiché, jamais le fichier."
msgstr "修改显示的文本，从不修改文件。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:789
msgid "Toujours annulable."
msgstr "始终可以撤销。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:792
#: src/omega_serv/interfaces/tui/screens/text_file_editor_screen.py:148
msgid "Rechercher"
msgstr "查找"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:793
msgid "Trouve un texte dans la liste (casse ignorée)."
msgstr "在列表中查找文本（不区分大小写）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:794
msgid "Taper le texte, puis Précédent / Suivant."
msgstr "输入文本，然后点击“上一个 / 下一个”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:795
msgid "Sélectionne l'occurrence trouvée."
msgstr "选中找到的匹配项。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:796
msgid "Recommence au début après la dernière occurrence."
msgstr "到达最后一个匹配项后从头开始。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:799
msgid "Tester (liste de chemins)"
msgstr "测试（路径列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:800
msgid "Indique ce que ferait la liste EN COURS d'édition d'un chemin donné."
msgstr "显示正在编辑的列表对某个给定路径会如何处理。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:801
msgid "Taper un chemin (ex. /blog/.env), puis Tester."
msgstr "输入一个路径（例如 /blog/.env），然后点击“测试”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:802
msgid "Même normalisation que le WAF (paramètres retirés, décodage URL)."
msgstr "与 WAF 相同的规范化（去掉参数、URL 解码）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:803
msgid "'DÉTECTÉ par la ligne N', 'AUTORISÉ : exception ligne N', ou 'aucune ligne ne correspond'."
msgstr "“被第 N 行检测到”“允许：第 N 行的例外”或“没有匹配的行”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:806
msgid "Vérifier contre mes logs (liste de chemins)"
msgstr "对照我的日志检查（路径列表）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:807
msgid "Rejoue les requêtes RÉUSSIES (2xx/3xx) du journal d'accès contre la liste."
msgstr "用列表重放访问日志中成功的请求（2xx/3xx）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:808
msgid "Chaque ligne de la liste qui aurait touché une requête probablement légitime est montrée avec un exemple."
msgstr "列表中每一行如果会命中一个可能合法的请求，都会附带一个示例显示出来。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:809
msgid "Cliquer une ligne : exception pour ce chemin, exception pour son dossier, ou suppression de la ligne."
msgstr "点击某一行：为该路径添加例外、为其目录添加例外，或删除该行。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:810
msgid "Modifie le texte affiché (annulable), jamais le fichier avant Enregistrer."
msgstr "修改显示的文本（可撤销），在“保存”之前从不修改文件。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:813
#: src/omega_serv/interfaces/tui/screens/path_list_editor_screen.py:131
msgid "Nouveautés de la référence"
msgstr "参考列表的新增内容"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:814
msgid "Entrées de la référence livrée absentes de votre liste."
msgstr "随附参考列表中有、而您的列表中没有的条目。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:815
msgid "Cocher celles à ajouter, puis Ajouter la sélection."
msgstr "勾选要添加的条目，然后点击“添加所选项”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:817
msgid "Rien n'est ajouté sans être coché. Une ligne de la référence que vous supprimez est marquée '#retire: /x' à l'enregistrement et n'est plus jamais reproposée."
msgstr "未勾选的条目不会被添加。您删除的参考列表行在保存时会被标记为 '#retire: /x'，以后再也不会被推荐。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:820
msgid "Modifie le texte affiché."
msgstr "修改显示的文本。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:824
msgid "Rend le fichier lisible par le compte du service (omega-serv)."
msgstr "使服务账户（omega-serv）能够读取该文件。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:825
msgid "Proposé seulement si l'état signale que le service ne peut pas lire le fichier."
msgstr "仅在状态显示服务无法读取该文件时提供。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:827
msgid "Liste chaque changement de droits avant de l'appliquer, uniquement sur ce qui vous appartient - jamais via sudo."
msgstr "在应用之前列出每一项权限更改，只针对属于您的内容 - 从不通过 sudo。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:830
msgid "L'état est recalculé."
msgstr "重新计算状态。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:833
#: src/omega_serv/interfaces/tui/screens/text_file_editor_screen.py:165
msgid "Enregistrer et appliquer"
msgstr "保存并应用"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:834
msgid "Écrit le fichier, puis recharge le serveur si la liste est chargée."
msgstr "写入文件，如果列表已加载则重新加载服务器。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:835
msgid "Refusé tant qu'il reste une erreur."
msgstr "只要还有错误就会被拒绝。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:837
msgid "Écriture sûre : droits et groupe conservés, nouveau fichier en 0644, refus si le fichier a été modifié ailleurs depuis l'ouverture, ou si c'est un lien symbolique."
msgstr "安全写入：保留权限和组，新文件权限为 0644；如果文件在打开后被其他地方修改过，或者是符号链接，则拒绝。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:841
msgid "Le rechargement n'est déclenché que si la vérification de la liste réussit - sinon la raison est affichée et le serveur garde ses règles actuelles."
msgstr "只有列表检查通过才会触发重新加载 - 否则会显示原因，服务器保留当前规则。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:846
msgid "Fermer / Aide"
msgstr "关闭 / 帮助"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:847
msgid "Fermer l'éditeur, ou ouvrir cette fiche."
msgstr "关闭编辑器，或打开此说明。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:848
msgid "Clic."
msgstr "点击。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:849
msgid "Fermer demande une confirmation s'il reste des modifications non enregistrées."
msgstr "如果还有未保存的修改，关闭时会要求确认。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:850
msgid "Retour à l'écran précédent."
msgstr "返回上一个界面。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:854
msgid "Le fichier n'est jamais modifié avant Enregistrer. Un fichier non modifiable par votre compte s'ouvre en LECTURE SEULE, avec la raison."
msgstr "在“保存”之前从不修改文件。您的账户无法修改的文件会以只读方式打开，并说明原因。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:859
msgid "Échap et F1 ne font rien ici, volontairement (aucun raccourci) : utilisez Fermer et Aide. Seul ctrl+q reste actif pour quitter l'application, avec confirmation."
msgstr "Esc 和 F1 在这里有意不做任何事（没有快捷键）：请使用“关闭”和“帮助”。只有 ctrl+q 仍可用于退出应用程序，需确认。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:863
msgid "L'état en bas de l'écran indique si le compte du service peut lire le fichier : un fichier illisible ferait échouer le prochain rechargement."
msgstr "界面底部的状态显示服务账户能否读取该文件：无法读取的文件会导致下一次重新加载失败。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:871
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:103
msgid "WAF - Modifier une liste"
msgstr "WAF - 修改列表"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:872
msgid "WAF - Règles et listes personnalisées -> Modifier (ligne Liste)"
msgstr "WAF - 自定义规则与列表 -> 修改（“列表”行）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:873
msgid "Change les réglages d'une liste déjà chargée, sans toucher à son fichier."
msgstr "更改已加载列表的设置，而不改动其文件。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:876
msgid "Nom affiché / Où chercher / Gravité / Récidive"
msgstr "显示名称 / 查找位置 / 严重级别 / 再犯"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:877
msgid "Mêmes choix que dans l'assistant (voir sa fiche)."
msgstr "与向导中的选项相同（见其说明）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:878
msgid "Passer d'Observation à une gravité bloquante une fois les alertes lues."
msgstr "阅读告警后，从“观察”切换到会拦截的严重级别。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:879
msgid "Vérifie la nouvelle configuration avant de l'écrire."
msgstr "在写入之前检查新配置。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:880
msgid "Rechargement automatique ; refus affiché avec sa raison si la vérification échoue."
msgstr "自动重新加载；如果检查失败，会显示拒绝原因。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:883
msgid "Rendre une liste bloquante réactive la réputation et l'auto-ban s'ils avaient été éteints."
msgstr "让列表变为拦截模式时，如果信誉和自动封禁已被关闭，会将其重新开启。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:889
msgid "Accueil -> Active Sécurité -> Magnet (bloc WAF)"
msgstr "主页 -> 主动安全 -> Magnet（WAF 模块）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:891
msgid "Importe un script WAF mod_magnet Lighttpd EXISTANT (écrit pour un autre site) sans le réécrire, comme renfort additif au WAF natif - il ne peut jamais lever un blocage déjà décidé par le natif. Seuls les chemins personnels du script (fichiers de log/blocage) se dissocient ici, jamais la logique du script lui-même."
msgstr "导入一个已有的 Lighttpd mod_magnet WAF 脚本（为另一个网站编写），无需改写，作为原生 WAF 的附加增强 - 它永远无法解除原生 WAF 已经作出的拦截。这里只解耦脚本的个人路径（日志/封禁文件），从不改动脚本本身的逻辑。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:898
#: src/omega_serv/interfaces/tui/screens/active_defense_settings_screen.py:297
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:65
msgid "Actif (oui/non)"
msgstr "启用（是/否）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:899
msgid "Active ou désactive le script magnet."
msgstr "启用或禁用 magnet 脚本。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:900
msgid "oui ou non."
msgstr "是或否。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:905
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:67
msgid "Script (chemin relatif au projet)"
msgstr "脚本（相对于项目的路径）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:906
msgid "Le fichier Lua à importer - une liste des scripts trouves sous secure/waf/scripts/ est affichée en indice."
msgstr "要导入的 Lua 文件 - 提示中会列出在 secure/waf/scripts/ 下找到的脚本。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:907
msgid "Chemin relatif au projet, ex. secure/waf/scripts/waf.lua."
msgstr "相对于项目的路径，例如 secure/waf/scripts/waf.lua。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:908
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:915
#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:929
msgid "Enregistre avec Actif."
msgstr "与“启用”一起保存。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:909
msgid "Aucun effet avant Enregistrer - utiliser Vérifier la compatibilité pour tester sans rien écrire."
msgstr "点击“保存”之前无效果 - 使用“检查兼容性”可以在不写入任何内容的情况下进行测试。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:912
msgid "Délai maximum par appel (ms) / Comportement en cas d'erreur"
msgstr "每次调用的最长时间（毫秒）/ 出错时的行为"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:913
msgid "Borne le temps d'exécution du script par requête, et la décision prise si le script plante ou dépasse ce délai."
msgstr "限制脚本每个请求的执行时间，以及脚本崩溃或超时时所作的决定。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:914
msgid "Délai en millisecondes ; ignore (laisse passer) ou fail-closed (bloque par prudence)."
msgstr "以毫秒为单位的时长；ignore（放行）或 fail-closed（出于谨慎而拦截）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:916
msgid "fail-closed combiné à une incompatibilité détectée peut bloquer du trafic légitime - avertissement explicite affiché par Vérifier la compatibilité dans ce cas."
msgstr "fail-closed 与检测到的不兼容同时存在时，可能会拦截合法流量 - 此时“检查兼容性”会显示明确的警告。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:919
msgid "Chemins personnels dissociés"
msgstr "解耦的个人路径"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:921
msgid "5 chemins (blocklist, dossier de règles, 2 journaux, fichier de persistance du rate limiting) injectés dans le script à la place de ses chemins en dur d'origine - propre à chaque script importe, jamais un contrat générique. Blocklist par défaut : var/lib/waf/magnet-blocklist.txt (le script y ÉCRIT ; un ancien secure/waf/magnet-blocklist.txt est repris une fois). Un chemin choisi à la main doit rester inscriptible par le compte du service, sinon les bans sont perdus sans message."
msgstr "5 个路径（封禁列表、规则目录、2 个日志、限流持久化文件）注入脚本，替代其原来硬编码的路径 - 每个导入脚本各不相同，从不是通用约定。默认封禁列表：var/lib/waf/magnet-blocklist.txt（脚本会写入该文件；旧的 secure/waf/magnet-blocklist.txt 会被迁移一次）。手动选择的路径必须保持服务账户可写，否则封禁记录会在没有任何消息的情况下丢失。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:928
msgid "Vide = le script garde son propre chemin en dur (aucune injection pour ce champ)."
msgstr "留空 = 脚本保留自己的硬编码路径（此字段不注入）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:930
msgid "Les dossiers parents sont créés automatiquement à l'usage réel (jamais lors d'un simple 'config check')."
msgstr "父目录会在实际使用时自动创建（从不在简单的“config check”时创建）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:933
#: src/omega_serv/interfaces/tui/screens/waf_magnet_screen.py:90
msgid "Vérifier la compatibilité"
msgstr "检查兼容性"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:934
msgid "Exécute RÉELLEMENT le script avec les valeurs du formulaire EN COURS DE SAISIE, pas seulement celles déjà enregistrées."
msgstr "使用表单中正在填写的值真正运行脚本，而不仅仅是已保存的值。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:935
msgid "À utiliser avant d'activer un script importe en production - répond à 'ce script est-il compatible ?'."
msgstr "在生产环境启用导入的脚本之前使用 - 回答“这个脚本兼容吗？”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:936
msgid "Scan statique (membres lighty.* non supportes) + exécution réelle sur une requête de test bénigne."
msgstr "静态扫描（不支持的 lighty.* 成员）+ 在一个无害的测试请求上真正运行。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:937
msgid "Aucun effet sur le serveur ni sur la configuration enregistrée - purement diagnostique."
msgstr "对服务器和已保存的配置无影响 - 纯粹用于诊断。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:940
msgid "Le natif reste toujours actif en parallèle - le magnet ne peut qu'ajouter un blocage, jamais en lever un."
msgstr "原生 WAF 始终并行运行 - magnet 只能增加拦截，永远无法解除拦截。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:943
msgid "Un script importe peut référencer une fonctionnalité lighty.* non supportée par ce pont (toujours nil côté Lua) - toujours lancer Vérifier la compatibilité avant d'activer un nouveau script en production, surtout avec on_error=fail-closed."
msgstr "导入的脚本可能引用此桥接不支持的 lighty.* 功能（在 Lua 中始终为 nil）- 在生产环境启用新脚本之前，务必运行“检查兼容性”，尤其是使用 on_error=fail-closed 时。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:952
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:104
msgid "WAF - Choix d'un pack de règles"
msgstr "WAF - 选择规则包"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:953
msgid "WAF - Modules -> Ajouter un pack"
msgstr "WAF - 模块 -> 添加规则包"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:954
msgid "Liste RÉELLE des packs de règles présents sous secure/waf/rules/, exclut ceux déjà référencés - jamais de doublon proposé."
msgstr "secure/waf/rules/ 下实际存在的规则包列表，排除已引用的规则包 - 从不推荐重复项。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:957
msgid "Sélection du pack"
msgstr "规则包选择"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:958
msgid "Choisit un pack parmi ceux disponibles et non déjà référencés."
msgstr "从可用且尚未引用的规则包中选择一个。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:959
msgid "Un menu déroulant, avec la description du pack (nombre de règles, état par défaut) affichée en dessous."
msgstr "一个下拉菜单，下方显示规则包的描述（规则数量、默认状态）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:960
msgid "Confirmer renvoie le chemin choisi à l'écran Modules."
msgstr "“确认”会将所选路径返回给“模块”界面。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:961
msgid "Aucun effet ici - la référence réelle est ajoutée par l'écran appelant."
msgstr "此处无效果 - 真正的引用由调用此界面的界面添加。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:964
msgid "Aucune modification directe - purement une aide de sélection."
msgstr "不直接修改任何内容 - 纯粹是选择辅助。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:969
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:119
msgid "Intervention manuelle - Bannir"
msgstr "手动干预 - 封禁"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:970
msgid "Accueil -> Active Sécurité -> Bannir (cadre INTERVENTION MANUELLE)"
msgstr "主页 -> 主动安全 -> 封禁（手动干预 框）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:972
msgid "Bannit une adresse IP sans condition : aucune règle, aucun seuil. L'adresse est ajoutée à la blocklist du WAF et reçoit la page 451 sur tout le site, avant le routage - les backends (reverse proxy, FastCGI) ne la voient jamais. Aucun droit administrateur n'est nécessaire."
msgstr "无条件封禁一个 IP 地址：没有规则，没有阈值。该地址被加入 WAF 的 blocklist，在整个网站上收到 451 页面，发生在路由之前 - 后端（反向代理、FastCGI）永远看不到它。不需要管理员权限。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:979
msgid "L'adresse à bannir, IPv4 ou IPv6."
msgstr "要封禁的地址，IPv4 或 IPv6。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:980
msgid "Une seule adresse (ex. 203.0.113.7 ou 2001:db8::7). Un réseau (/24...) est refusé : il se bannit dans WAF -> Modules -> Liste de blocage."
msgstr "单个地址（例如 203.0.113.7 或 2001:db8::7）。网络（/24...）会被拒绝：网络在 WAF -> 模块 -> 封禁列表 中封禁。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:982
msgid "Vérifiée au clic sur Bannir."
msgstr "点击“封禁”时检查。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:983
msgid "Adresse invalide ou réseau : message d'erreur, rien n'est écrit."
msgstr "地址无效或为网络：显示错误信息，不写入任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:987
msgid "Texte libre gardé avec le ban, affiché dans Débannir et Statut des bans."
msgstr "随封禁保存的自由文本，显示在“解除封禁”和“封禁状态”中。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:988
msgid "Facultatif : « Intervention manuelle » par défaut."
msgstr "可选：默认为 « 手动干预 »。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:989
msgid "Enregistré avec le ban."
msgstr "随封禁一起保存。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:990
msgid "Visible dans Statut des bans et dans les exports."
msgstr "显示在“封禁状态”和导出文件中。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:994
msgid "Combien de temps le ban reste en place."
msgstr "封禁持续多久。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:995
msgid "1 h, 6 h, 24 h, 7 jours, 30 jours, une durée libre en heures, ou permanent."
msgstr "1 小时、6 小时、24 小时、7 天、30 天、以小时计的自定义时长，或永久。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:996
msgid "Calculée au moment du ban."
msgstr "在封禁时计算。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:997
msgid "À l'échéance, l'adresse est de nouveau acceptée, sans rien faire. Un ban permanent demande une confirmation et reste jusqu'à Débannir."
msgstr "到期后，该地址重新被接受，无需任何操作。永久封禁需要确认，并一直有效直到“解除封禁”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1002
msgid "Effet immédiat, sans redémarrage ni rechargement : le serveur relit la blocklist dès qu'elle change, avec le moteur Python comme avec le moteur natif. Le ban ne compte jamais dans la récidive RIPOSTE et n'a aucun lien avec Active Defense."
msgstr "立即生效，无需重启或重新加载：blocklist 一有变化服务器就会重新读取，Python 引擎和原生引擎都是如此。该封禁从不计入 RIPOSTE 的再犯，与 Active Defense 无关。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1007
msgid "WAF désactivé : la blocklist n'est pas consultée, le ban n'aurait aucun effet - l'écran l'indique en haut. En mode log-only, le ban s'applique quand même."
msgstr "WAF 已禁用：不会查询 blocklist，封禁不会生效 - 屏幕顶部会提示。在 log-only 模式下，封禁仍然生效。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1009
msgid "Adresse locale, privée ou Tailscale : une confirmation est demandée, vous pourriez couper votre propre accès."
msgstr "本地、私有或 Tailscale 地址：需要确认，你可能会切断自己的访问。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1011
msgid "Si l'adresse est déjà bannie par une autre origine (auto-ban, RIPOSTE, omega-jail), votre ban la remplace après confirmation ; un automate ne le remplacera jamais."
msgstr "如果该地址已被其他来源封禁（自动封禁、RIPOSTE、omega-jail），确认后你的封禁将取代它；自动机制永远不会取代你的封禁。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1018
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:120
msgid "Intervention manuelle - Débannir"
msgstr "手动干预 - 解除封禁"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1019
msgid "Accueil -> Active Sécurité -> Débannir (cadre INTERVENTION MANUELLE)"
msgstr "主页 -> 主动安全 -> 解除封禁（手动干预 框）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1020
msgid "Liste les bans posés par Bannir, et seulement eux, pour les lever."
msgstr "列出通过“封禁”设置的封禁（仅限这些），以便解除。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1023
msgid "Tableau des bans manuels"
msgstr "手动封禁表"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1024
msgid "Adresse, motif, date de pose, expiration, état (en vigueur ou expiré)."
msgstr "地址、原因、设置日期、到期时间、状态（生效中或已过期）。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1025
msgid "Sélectionnez une ligne, puis Lever."
msgstr "选择一行，然后点击“解除”。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1026
msgid "Lever demande une confirmation."
msgstr "“解除”需要确认。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1027
msgid "L'adresse est retirée de la blocklist : elle accède de nouveau au site, immédiatement."
msgstr "该地址从 blocklist 中移除：立即可以重新访问网站。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1030
msgid "Retire l'entrée de la blocklist du WAF ; rien d'autre n'est touché."
msgstr "从 WAF 的 blocklist 中移除该条目；其他内容不受影响。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1032
msgid "Les autres bans se lèvent là où ils ont été posés : WAF -> Modules (réseaux, auto-bans, CLI, omega-jail), RIPOSTE -> Actions. Un ban levé ici peut revenir si une règle automatique bannit de nouveau l'adresse."
msgstr "其他封禁在设置它们的地方解除：WAF -> 模块（网络、自动封禁、CLI、omega-jail），RIPOSTE -> 操作。如果自动规则再次封禁该地址，在此解除的封禁可能会恢复。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1039
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:121
msgid "Intervention manuelle - Statut des bans"
msgstr "手动干预 - 封禁状态"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1040
msgid "Accueil -> Active Sécurité -> Statut des bans (cadre INTERVENTION MANUELLE)"
msgstr "主页 -> 主动安全 -> 封禁状态（手动干预 框）"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1042
msgid "Tous les bans de la blocklist du WAF, avec leur origine : intervention manuelle, manuel (WAF -> Modules ou CLI), auto-ban WAF (règles ou liste), RIPOSTE (politique), omega-jail (jail), et la liste du script Magnet s'il est actif. Lecture seule."
msgstr "WAF 的 blocklist 中的所有封禁及其来源：手动干预、手动（WAF -> 模块或 CLI）、WAF 自动封禁（规则或列表）、RIPOSTE（策略）、omega-jail（jail），以及 Magnet 脚本处于启用状态时它的列表。只读。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1048
#: src/omega_serv/interfaces/tui/screens/ban_status_screen.py:78
msgid "Format d'export"
msgstr "导出格式"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1049
msgid "JSON ou HTML de tous les bans, ou TXT d'injection."
msgstr "所有封禁的 JSON 或 HTML，或用于导入的 TXT。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1050
msgid "TXT : bans actifs ou toute la liste. Une adresse par ligne, en-tête en commentaires « # » - importable tel quel dans omega-fire (Bannir une liste d'IPs). Un réseau n'y figure qu'en commentaire, omega-fire ne lisant que des adresses."
msgstr "TXT：生效中的封禁或整个列表。每行一个地址，文件头为 « # » 注释 - 可原样导入 omega-fire（封禁一批 IP）。网络只以注释形式出现，因为 omega-fire 只读取地址。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1053
msgid "Exporter écrit le fichier dans le dossier d'exports."
msgstr "“导出”将文件写入导出文件夹。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1054
msgid "Le chemin du fichier écrit est affiché."
msgstr "会显示所写文件的路径。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1058
msgid "Palette de couleurs de l'export HTML."
msgstr "HTML 导出的配色方案。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1059
msgid "Seulement pour le format HTML."
msgstr "仅用于 HTML 格式。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1060
msgid "Appliqué à l'export."
msgstr "应用于导出。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1061
msgid "Même choix de thèmes que les autres exports."
msgstr "与其他导出相同的主题选择。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1064
msgid "Aucune - consultation et export seulement."
msgstr "无 - 仅查看和导出。"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:1066
msgid "Le fichier TXT n'est jamais traduit : c'est un format lu par d'autres outils."
msgstr "TXT 文件从不翻译：它是供其他工具读取的格式。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:12
msgid "Accueil -> Configuration détaillée -> Voir options actives"
msgstr "主页 -> 详细配置 -> 查看已启用的选项"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:14
msgid "Active ou désactive les options superposables (fonctionnalités optionnelles qui s'ajoutent par-dessus le profil de base) et affiche leur état actuel."
msgstr "启用或禁用可叠加选项（叠加在基础配置档案之上的可选功能），并显示它们的当前状态。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:19
msgid "Sélection + Activer / Désactiver"
msgstr "选择 + 启用 / 禁用"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:20
msgid "Chaque ligne du tableau représente une option superposable connue."
msgstr "表格的每一行代表一个已知的可叠加选项。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:22
msgid "16 options connues : dirlisting, waf, auth, fastcgi, aliases, redirects, rewrites, cache, trusted_proxy, upload, error_pages, access_control, reverse_proxy, active_defense, riposte, admin_web."
msgstr "16 个已知选项：dirlisting、waf、auth、fastcgi、aliases、redirects、rewrites、cache、trusted_proxy、upload、error_pages、access_control、reverse_proxy、active_defense、riposte、admin_web。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:26
msgid "Sélectionner une ligne puis Activer/Desactiver bascule option.enabled dans la configuration."
msgstr "选择一行，然后点击“启用/禁用”，即可切换配置中的 option.enabled。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:28
msgid "Dépend de l'option : la plupart se rechargent à chaud (automatique si un service actif existe). La 1ere activation de fastcgi/reverse_proxy exige un REDÉMARRAGE COMPLET (leur client n'est construit qu'au démarrage). active_defense exige TOUJOURS un redémarrage complet, à l'activation comme à la désactivation."
msgstr "取决于选项：大多数支持热重载（如有活动服务则自动进行）。首次启用 fastcgi/reverse_proxy 需要完全重启（它们的客户端只在启动时构建）。active_defense 无论启用还是禁用，始终需要完全重启。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:33
msgid "riposte aussi : son processus est lancé et surveillé par le service au démarrage."
msgstr "riposte 也一样:其进程在启动时由服务启动和监管。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:34
msgid "admin_web aussi : le processus d'administration web est lancé au démarrage ; ses réglages (adresse, port, TLS, réseaux permis) se font dans Instances -> Configuration distante."
msgstr "admin_web 也是如此：Web 管理进程在启动时运行；其设置（地址、端口、TLS、允许的网络）在“实例 -> 远程配置”中完成。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:40
msgid "Activer une option ici ne configure que son interrupteur enabled - les réglages détaillés (zones, règles, seuils...) vivent dans le sous-écran dédié à cette option, dans Configuration détaillée."
msgstr "在这里启用选项只会设置它的 enabled 开关 - 详细设置（区域、规则、阈值……）位于“详细配置”中该选项的专用子界面。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:46
msgid "Activer une option ne suffit jamais à elle seule : sans un rechargement (ou redémarrage) du service déjà lancé, rien ne change réellement - voir la FAQ 'Pourquoi mon option activée ne fonctionne pas ?'."
msgstr "仅启用一个选项永远不够：如果不重新加载（或重启）已在运行的服务，什么都不会真正改变 - 见常见问题“为什么我启用的选项不起作用？”。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:56
msgid "Accueil -> Service"
msgstr "主页 -> 服务"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:58
msgid "Pilote le service système (systemd/OpenRC/runit) qui fait tourner OMEGA-SERV, en cinq lignes dans l'ordre d'usage : nom du service, installation, démarrage avec la machine, permissions, pilotage. Sous chaque titre, l'état actuel ; seuls les boutons qui ont un sens dans cet état sont actifs (par exemple Démarrer est grisé si le service tourne déjà, Installer si l'unité existe). L'état se met à jour seul toutes les 3 secondes et après chaque action."
msgstr "控制运行 OMEGA-SERV 的系统服务（systemd/OpenRC/runit），按使用顺序分为五行：服务名称、安装、开机启动、权限、控制。每个标题下显示当前状态；只有在该状态下有意义的按钮才可用（例如服务已在运行时“启动”为灰色，单元已存在时“安装单元”为灰色）。状态每 3 秒以及每次操作后自动刷新。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:66
#: src/omega_serv/interfaces/tui/screens/service_screen.py:131
msgid "Nom du service"
msgstr "服务名称"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:67
msgid "Le nom de l'unité système pilotée par cet écran. Le champ est verrouillé : une faute de frappe ne peut plus changer le service piloté par accident."
msgstr "此界面所控制的系统单元的名称。该字段处于锁定状态：输入错误不会再意外更改所控制的服务。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:69
msgid "Modifier déverrouille le champ, Valider enregistre. 1 à 64 caractères : minuscules, chiffres, « - », « _ », « . » (sans « .service »). Rien n'est enregistré avant Valider ; Échap quitte l'écran sans rien changer. Figé si cette instance est enregistrée en multi-instance."
msgstr "修改用于解锁字段，确认用于保存。1 到 64 个字符：小写字母、数字、“-”、“_”、“.”（不含“.service”）。点确认之前不会保存任何内容；Esc 会退出界面而不做任何更改。如果此实例已在多实例中注册，则名称固定。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:73
msgid "Si une unité de cette installation existe sous l'ancien nom, une fenêtre détaille avant toute action l'enchaînement : arrêter et désactiver l'ancienne, la désinstaller, installer la nouvelle, puis la réactiver au démarrage et la redémarrer si c'était le cas (une seule authentification sudo). Sans unité installée, seul le nom change."
msgstr "如果此安装的单元以旧名称存在，在执行任何操作之前，会有一个窗口详细列出整个流程：停止并禁用旧单元，卸载它，安装新单元，然后如果原先如此，再重新启用开机启动并重启（只需一次 sudo 身份验证）。如果没有已安装的单元，则只更改名称。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:77
msgid "Un nom déjà pris par une autre installation est refusé. Jamais deux unités pour le même dossier. Si une étape échoue, l'enchaînement s'arrête et le message dit laquelle."
msgstr "已被其他安装占用的名称会被拒绝。同一个目录绝不会有两个单元。如果某个步骤失败，流程会停止，消息会指出是哪一步。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:81
msgid "Démarrer / Arrêter / Redémarrer / Recharger"
msgstr "启动 / 停止 / 重启 / 重新加载"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:82
msgid "Actions directes de contrôle du service - Recharger (SIGHUP) est léger, les autres coupent les connexions."
msgstr "直接控制服务的操作 - 重新加载（SIGHUP）是轻量的，其他操作会断开连接。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:83
msgid "Un clic suffit, aucune confirmation demandée pour ces 4 actions."
msgstr "点击一下即可，这 4 个操作不要求确认。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:84
msgid "Exécute la commande système correspondante, avec élévation (sudo) ponctuelle si nécessaire."
msgstr "执行相应的系统命令，必要时临时提权（sudo）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:85
msgid "Effet réel et immédiat sur le service."
msgstr "对服务立即产生真实影响。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:88
msgid "Activer / Désactiver au démarrage"
msgstr "启用 / 禁用开机启动"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:89
msgid "Contrôle si le service démarre automatiquement avec la machine."
msgstr "控制服务是否随机器自动启动。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:90
msgid "Un clic suffit."
msgstr "点击一下即可。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:91
msgid "Modifie l'enregistrement systemd/OpenRC/runit."
msgstr "修改 systemd/OpenRC/runit 中的注册。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:92
msgid "N'affecte jamais l'état actuel du service, seulement son comportement au prochain démarrage machine."
msgstr "从不影响服务的当前状态，只影响下次开机时的行为。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:95
msgid "Installer l'unité (systemd uniquement)"
msgstr "安装单元（仅限 systemd）"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:96
msgid "Crée le fichier d'unité systemd, le compte système dédié, et prépare les accès nécessaires."
msgstr "创建 systemd 单元文件和专用系统账户，并准备所需的访问权限。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:97
msgid "Une seule fois par instance - demande confirmation et une authentification (sudo)."
msgstr "每个实例只需一次 - 需要确认和身份验证（sudo）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:98
msgid "Écrit /etc/systemd/system/<nom>.service, crée le compte dédié omega-serv/omega-serv."
msgstr "写入 /etc/systemd/system/<名称>.service，创建专用账户 omega-serv/omega-serv。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:100
msgid "Deux garde-fous bloquent l'installation si un conflit est détecté (une autre unité pointe déjà vers ce répertoire, ou ce nom est déjà utilisé par une unité pointant ailleurs)."
msgstr "检测到冲突时，两道防护会阻止安装（已有另一个单元指向该目录，或该名称已被指向其他位置的单元使用）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:106
#: src/omega_serv/interfaces/tui/screens/service_screen.py:149
msgid "Permissions"
msgstr "权限"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:107
msgid "Vérifie à l'ouverture, en lecture seule, que var/ est partagé avec le compte du service (groupe omega-serv, lecture et écriture de groupe) ; var/backups, privé, est ignoré."
msgstr "打开时以只读方式检查 var/ 是否与服务账户共享（omega-serv 组，组可读写）；私有的 var/backups 会被忽略。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:113
msgid "État affiché sous le titre : correctes, « N à réparer » ou compte absent. Réparer les permissions n'est actif que si quelque chose est faux (ou si la vérification n'a pas pu se faire)."
msgstr "标题下显示的状态：正确、“N 项待修复”或账户不存在。只有在某项有误（或无法完成检查）时，修复权限才可用。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:116
msgid "Réparer réapplique le partage sur var/ et secure/auth/, avec confirmation et sudo, sans toucher à l'unité."
msgstr "修复权限会在确认并通过 sudo 后，重新对 var/ 和 secure/auth/ 应用共享设置，不会改动单元。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:118
msgid "Utile après une mise à jour par extraction d'archive, qui remet les permissions d'origine."
msgstr "通过解压归档进行更新后很有用，因为这会恢复原始权限。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:121
msgid "Désinstaller l'unité (systemd uniquement)"
msgstr "卸载单元（仅限 systemd）"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:122
msgid "Retire l'unité systemd installée."
msgstr "移除已安装的 systemd 单元。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:123
msgid "Demande confirmation et une authentification (sudo)."
msgstr "需要确认和身份验证（sudo）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:124
msgid "Arrête le service et supprime le fichier d'unité."
msgstr "停止服务并删除单元文件。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:125
msgid "Le compte système dédié et le répertoire projet ne sont jamais supprimés par cette action."
msgstr "此操作从不删除专用系统账户和项目目录。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:129
msgid "Installer/Desinstaller ne sont proposes QUE pour systemd - désactivés pour OpenRC/runit (déjà configurés directement sur le système requis pour ces gestionnaires)."
msgstr "安装/卸载仅对 systemd 提供 - 对 OpenRC/runit 禁用（这些管理器所需的配置已直接在系统上完成）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:134
msgid "Après 'Installer l'unité', une session déjà ouverte n'a pas automatiquement le nouveau groupe système créé pour le compte dédié - reconnectez votre session une seule fois si l'état semble incohérent (voir État & Ressources)."
msgstr "执行“安装单元”后，已打开的会话不会自动获得为专用账户创建的新系统组 - 如果状态看起来不一致，请重新登录会话一次（见“状态与资源”）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:144
msgid "Accueil -> Instances (N)"
msgstr "主页 -> 实例 (N)"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:146
msgid "Registre de toutes les installations d'OMEGA-SERV connues sur cette machine, avec le statut systemd de chacune - permet de créer une nouvelle instance ou de basculer entre elles."
msgstr "本机上所有已知的 OMEGA-SERV 安装的注册表，以及各自的 systemd 状态 - 可以创建新实例或在实例之间切换。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:148
msgid "L'instance courante figure toujours en tête du tableau, marquée « (courante) », même quand elle n'est pas inscrite au registre (installation d'origine) : sa Configuration distante est donc toujours accessible."
msgstr "当前实例总是位于表格顶部，并标记为“（当前）”，即使它不在注册表中（原始安装）：因此它的远程配置始终可以访问。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:154
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:94
msgid "Créer une nouvelle instance"
msgstr "创建新实例"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:155
msgid "Dupliqué cette installation vers un nouveau répertoire FRÈRE (jamais à l'intérieur de celui-ci)."
msgstr "将此安装复制到一个新的同级目录（从不位于本目录之内）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:156
msgid "Nom, répertoire parent, adresse d'écoute, port (un port libre est proposé par défaut)."
msgstr "名称、父目录、监听地址、端口（默认会提供一个空闲端口）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:157
msgid "Copie le code/l'environnement, crée la nouvelle configuration et l'enregistre au registre."
msgstr "复制代码/环境，创建新配置并将其写入注册表。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:158
msgid "Opération réelle sur disque, peut prendre du temps (progression affichée)."
msgstr "真实的磁盘操作，可能需要一些时间（会显示进度）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:161
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:100
msgid "Piloter cette instance"
msgstr "控制此实例"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:162
msgid "Bascule l'interface pour piloter une AUTRE instance enregistrée, en quittant celle-ci."
msgstr "切换界面以控制另一个已注册的实例，并退出当前实例。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:163
msgid "Sélectionner une instance différente de la courante (jamais soi-même)."
msgstr "选择一个与当前实例不同的实例（从不能选自己）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:164
msgid "Ferme cette interface et relance l'application pointée sur l'autre répertoire."
msgstr "关闭此界面，并以另一个目录重新启动应用程序。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:165
msgid "Nécessite que l'environnement virtuel de l'instance cible existe réellement."
msgstr "要求目标实例的虚拟环境确实存在。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:168
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:102
msgid "Configuration distante"
msgstr "远程配置"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:169
msgid "Règle l'administration web de l'instance choisie : adresse, port, chiffrement (TLS) et réseaux permis. La colonne « Accès distant » dit, pour chaque instance, si elle est active."
msgstr "设置所选实例的 Web 管理：地址、端口、加密（TLS）和允许的网络。“远程访问”列显示每个实例是否已启用。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:171
msgid "Sélectionner une instance dont l'option admin_web est active (Voir options actives) ; sinon le bouton reste grisé et la raison s'affiche sous le tableau."
msgstr "选择一个已启用 admin_web 选项的实例（查看已启用的选项）；否则按钮保持灰色，原因显示在表格下方。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:173
msgid "Instance pilotée : ouvre l'écran de réglage. Autre instance : demande confirmation (avec son nom), bascule sur elle, puis ouvre son écran de réglage - jamais de réglage écrit à distance dans une autre instance."
msgstr "当前控制的实例：打开设置界面。其他实例：先请求确认（显示其名称），切换到该实例，然后打开其设置界面 - 从不远程写入其他实例的设置。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:176
msgid "Aucun effet avant Enregistrer dans l'écran de réglage."
msgstr "在设置界面点击“保存”之前无效果。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:179
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:104
msgid "Relier au maître"
msgstr "关联主控"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:180
msgid "Fait suivre l'instance choisie par une autre instance de cette machine, depuis la page Instances du tableau de bord web de ce maître."
msgstr "让所选实例由本机上的另一个实例监控，在该主控的 Web 仪表板的实例页面中完成。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:182
msgid "Sélectionner l'instance à suivre, puis choisir le maître (l'instance courante par défaut) et ses droits : lecture ou administration. L'administration web doit être active sur les deux ; sinon le bouton reste grisé et la raison s'affiche sous le tableau."
msgstr "选择要监控的实例，然后选择主控（默认为当前实例）及其权限：只读或管理。两者都必须启用 Web 管理；否则按钮保持灰色，原因显示在表格下方。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:185
msgid "Chaque instance enregistre elle-même la liaison, par sa propre commande : l'instance suivie accepte le maître, puis le maître l'ajoute à sa page Instances. Rien à recopier."
msgstr "每个实例通过自己的命令自行记录关联：被监控的实例接受主控，然后主控将其添加到实例页面。无需复制任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:187
msgid "Si l'instance a déjà un autre maître, une confirmation est demandée : l'ancien est révoqué aussitôt. Une instance d'une autre machine se relie par le code d'appairage (Configuration distante -> Maître)."
msgstr "如果该实例已有其他主控，会要求确认：旧主控将立即被吊销。其他机器上的实例通过配对码关联（远程配置 -> 主控）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:192
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:96
msgid "Désinstaller cette instance"
msgstr "卸载此实例"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:193
msgid "Retire l'unité systemd, le compte dédié (si plus utilisé par personne d'autre) et l'entrée du registre."
msgstr "移除 systemd 单元、专用账户（如果不再被其他实例使用）以及注册表中的条目。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:194
msgid "Ne peut jamais cibler l'instance courante, ni un répertoire qui la contient : le bouton reste grisé et le programme refuse aussi de lui-même (basculer ailleurs d'abord)."
msgstr "永远不能针对当前实例，也不能针对包含它的目录：按钮保持灰色，程序本身也会拒绝（请先切换到其他实例）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:196
msgid "Deux confirmations : l'opération elle-même, puis si le répertoire doit aussi être supprimé."
msgstr "两次确认：操作本身，以及是否同时删除目录。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:197
msgid "Le répertoire n'est supprimé que sur confirmation explicite séparée - conservé par défaut."
msgstr "只有在单独明确确认后才会删除目录 - 默认保留。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:200
msgid "Registre en lecture seule sinon - toute modification passe par les actions ci-dessus."
msgstr "除此之外，注册表是只读的 - 任何修改都通过上述操作进行。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:205
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:81
msgid "Administration web - configuration distante"
msgstr "Web 管理 - 远程配置"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:206
msgid "Accueil -> Instances -> Configuration distante"
msgstr "主页 -> 实例 -> 远程配置"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:208
msgid "Réglages de l'administration web : le tableau de bord de l'instance dans un navigateur, servi par un processus à part sur son propre port, jamais sur le port du site. L'option admin_web s'active dans Voir options actives (redémarrage complet)."
msgstr "Web 管理设置：在浏览器中查看实例的仪表板，由独立进程在自己的端口上提供，从不使用站点端口。admin_web 选项在“查看已启用的选项”中启用（需完全重启）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:211
msgid "Tout se règle dans cet écran, sans commande à taper ailleurs : le cadre État dit ce qui est prêt et ce qui manque, avec le bouton qui le règle (Activer, Générer le certificat, Comptes, Redémarrer, Recharger), l'adresse à ouvrir sur l'autre appareil et le pare-feu actif."
msgstr "一切都在此界面中设置，无需在别处输入命令：“状态”框显示哪些已就绪、哪些还缺少，并附上对应的按钮（启用、生成证书、账户、重启、重新加载）、在其他设备上要打开的地址以及已启用的防火墙。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:214
msgid "La page de connexion demande identifiant, mot de passe et code TOTP (s'il est activé), et le mode d'arrivée : Tableau de bord (consulter) ou Administration (agir, comptes administration seulement). Le Tableau de bord montre, rafraîchis toutes les 2 secondes : État & Ressources (les trois cadres de l'écran du TUI, BACKENDS compris), Journaux (instantané ou direct : journaux de l'instance et fichiers de la bibliothèque), Sécurité (bans, RIPOSTE, incidents) et, pour les comptes administration, le journal d'audit."
msgstr "登录页面要求输入标识符、密码和 TOTP 代码（如已启用），并选择进入的界面：仪表板（查看）或管理（操作，仅限 administration 账户）。仪表板每 2 秒刷新一次，显示：状态与资源（TUI 界面的三个框，包括后端）、日志（快照或实时：实例的日志和日志库中的文件）、安全（封禁、RIPOSTE、事件），以及（对 administration 账户）审计日志。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:220
msgid "La vue Historique trace la machine (processeur, mémoire, swap, charge, réseau, connexions, disque, processus, température, batterie) et cette instance (requêtes, processus d'omega-serv, téléchargements et téléversement des visiteurs) sur 1 heure, 3 heures, 12 heures, 24 heures, 7 jours ou 30 jours, en Moyenne ou en Max 1 min (la minute la plus chargée de chaque tranche) ; le relevé continue même quand aucune page n'est ouverte."
msgstr "历史视图绘制整台机器（处理器、内存、swap、负载、网络、连接、磁盘、进程、温度、电池）和本实例（请求数、omega-serv 进程、访客的下载与上传）在 1 小时、3 小时、12 小时、24 小时、7 天或 30 天内的图表，可选平均或最大 1 分钟（每个时间段中负载最高的一分钟）；即使没有打开任何页面，采集也会继续。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:224
msgid "Le mode Administration propose, chacune avec une page de confirmation et une ligne dans le journal d'audit : bannir et débannir une adresse IP (intervention manuelle), fermer un incident, arrêt d'urgence de RIPOSTE et sa levée, DRAINING, MAINTENANCE ou retour à l'automatique d'un backend, archiver un journal de l'instance ou supprimer une archive, recharger la configuration. Une action demande une saisie de moins de 15 minutes : sinon le mot de passe (et le code) est redemandé, puis l'action est proposée de nouveau."
msgstr "管理模式提供以下操作，每个都有确认页面并在审计日志中记录一行：封禁和解除封禁 IP 地址（手动干预）、关闭事件、RIPOSTE 紧急停止及其解除、后端的 DRAINING、MAINTENANCE 或恢复为自动、归档实例的日志或删除归档、重新加载配置。操作要求在 15 分钟内输入过凭据：否则会重新要求输入密码（和代码），然后再次提供该操作。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:230
msgid "La page Instances fait de cette instance un maître : elle montre les instances qui l'ont acceptée (état, type, requêtes par seconde, erreurs 5xx, bans, incidents), ouvre leur tableau de bord et, si elles lui ont donné le droit d'administration, y lance les mêmes actions. Le bouton Maître règle l'inverse : quel maître peut suivre cette instance."
msgstr "实例页面使此实例成为主控：它显示接受了它的实例（状态、类型、每秒请求数、5xx 错误、封禁、事件），打开它们的仪表板，并在获得管理权限时对其执行相同的操作。主控按钮设置相反方向：哪个主控可以监控此实例。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:238
msgid "Bilan de l'administration web, une ligne par point : ✓ prêt, ✗ manque, • information."
msgstr "Web 管理检查结果，每项一行：✓ 已就绪，✗ 缺少，• 信息。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:239
msgid "Option active ; adresse à ouvrir sur l'autre appareil ; certificat ; comptes et TOTP ; port pris par une autre instance ; administration en écoute (ou la raison de son arrêt : port pris par un autre programme, adresse absente, certificat illisible...) ; pare-feu actif (ufw, firewalld, nftables) hors de cette machine."
msgstr "选项已启用；在其他设备上打开的地址；证书；账户与 TOTP；端口被其他实例占用；Web 管理正在监听（或其停止原因：端口被其他程序占用、地址不存在、证书无法读取...）；本机以外时已启用的防火墙（ufw、firewalld、nftables）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:243
msgid "Activer : option admin_web, puis redémarrage complet proposé. Générer le certificat : auto-signé au nom de la machine et de ses adresses (valable 825 jours), clé lisible par le service ; un ancien fichier est gardé en .ancien ; sudo est demandé seulement si votre session n'a pas encore le groupe omega-serv. Comptes : créer un compte ou activer son TOTP. Redémarrer, Recharger : le service. Ouvrir le port : quand omega-fire et cette instance sont inscrits dans la zone omega-connect, omega-fire ouvre le port pour vos réseaux permis (boucle locale exclue), dans son pare-feu et dans ufw ou firewalld s'ils sont actifs ; sudo est demandé par-dessus la TUI ; une fois fait, la ligne passe à ✓ tant que le port et les réseaux ne changent pas."
msgstr "启用：admin_web 选项，随后建议完全重启。生成证书：以本机名称及其地址自签名（有效期 825 天），服务可读取密钥；旧文件保留为 .ancien；仅当您的会话尚未加入 omega-serv 组时才会要求 sudo。账户：创建账户或为其启用 TOTP。重启、重新加载：作用于服务。开放端口：当 omega-fire 和本实例都已登记在 omega-connect 区域中时，omega-fire 会为您允许的网络开放该端口（本地回环除外），既在它自己的防火墙中，也在已启用的 ufw 或 firewalld 中；会在 TUI 之上请求 sudo；完成后，只要端口和网络不变，该行就会显示 ✓。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:252
msgid "Sans omega-fire inscrit dans la zone omega-connect avec cette instance, le pare-feu est seulement signalé : ouvrez-y le port pour vos réseaux permis avec l'outil du pare-feu."
msgstr "如果 omega-fire 未与本实例一起登记在 omega-connect 区域中，防火墙只做提示：请使用防火墙自带的工具在其中为您允许的网络开放该端口。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:256
#: src/omega_serv/interfaces/tui/screens/admin_web_screen.py:108
msgid "Adresse d'écoute"
msgstr "监听地址"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:257
msgid "Adresse IP sur laquelle l'administration web écoute."
msgstr "Web 管理监听的 IP 地址。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:258
msgid "127.0.0.1 (défaut) : depuis cette machine seulement. Adresse Tailscale ou du réseau local pour un autre appareil ; 0.0.0.0 : toutes les adresses. Hors de 127.0.0.1, TLS est obligatoire : avec « Aucun », Enregistrer choisit tout seul « Certificat dédié »."
msgstr "127.0.0.1（默认）：仅限本机。其他设备请使用 Tailscale 地址或局域网地址；0.0.0.0：所有地址。不是 127.0.0.1 时必须使用 TLS：若选择“无”，保存时会自动改为“专用证书”。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:261
msgid "Prise en compte au rechargement (Enregistrer le propose)."
msgstr "重新加载时生效（“保存”时会提示）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:262
msgid "Une adresse invalide est refusée sans rien écrire."
msgstr "无效地址会被拒绝，不写入任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:266
msgid "Port de l'administration web (9643 par défaut)."
msgstr "Web 管理端口（默认 9643）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:267
msgid "Toujours différent du port du site ; un port déjà pris par une autre instance du registre est signalé. 8443 était le défaut avant la 3.0.0 : d'autres outils l'utilisent souvent."
msgstr "始终与站点端口不同；若端口已被注册表中的其他实例占用，会给出提示。8443 是 3.0.0 之前的默认值：其他工具也常用它。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:269
msgid "Prise en compte au rechargement. Enregistrer essaie d'abord d'écouter : un port déjà pris par un autre programme, ou une adresse absente de cette machine, est refusé sans rien écrire."
msgstr "重新加载后生效。保存会先尝试监听：端口已被其他程序占用，或本机没有该地址时，会被拒绝且不写入任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:271
msgid "Port pris au démarrage : le site démarre, l'administration reste arrêtée et le dit dans error.log et dans le cadre État."
msgstr "启动时端口被占用：站点照常启动，Web 管理保持停止，并在 error.log 和“状态”框中说明。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:275
#: src/omega_serv/interfaces/tui/screens/admin_web_screen.py:116
msgid "Chiffrement (TLS)"
msgstr "加密（TLS）"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:276
msgid "Aucun (cette machine seulement), certificat du site (écran TLS), ou certificat dédié (chemins à indiquer)."
msgstr "无（仅限本机）、站点证书（TLS 界面）或专用证书（需填写路径）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:278
msgid "Un certificat auto-signé suffit : le navigateur demande de l'accepter la première fois."
msgstr "自签名证书即可：首次访问时浏览器会要求接受它。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:279
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:288
msgid "Prise en compte au rechargement."
msgstr "重新加载时生效。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:280
msgid "Certificat absent ou illisible : signalé dans Vérifier la configuration ; le site démarre, l'administration reste arrêtée jusqu'au rechargement suivant."
msgstr "证书缺失或无法读取：会在“检查配置”中提示；站点照常启动，Web 管理保持停止，直到下一次重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:284
#: src/omega_serv/interfaces/tui/screens/admin_web_screen.py:123
msgid "Réseaux permis"
msgstr "允许的网络"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:285
msgid "Adresses autorisées à joindre l'administration web, séparées par des virgules."
msgstr "允许连接 Web 管理的地址，用逗号分隔。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:286
msgid "Par défaut : cette machine, Tailscale et le réseau local. Une adresse hors liste est refusée (403) avant même la page de connexion."
msgstr "默认：本机、Tailscale 和局域网。列表外的地址甚至在登录页面之前就会被拒绝（403）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:289
msgid "La connexion par compte reste toujours exigée, même depuis un réseau permis."
msgstr "即使来自允许的网络，也始终需要使用账户登录。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:293
#: src/omega_serv/interfaces/tui/screens/admin_web_screen.py:129
msgid "Graphes de la machine et de cette instance, de 1 heure à 30 jours, dans la vue Historique du tableau de bord."
msgstr "仪表板历史视图中本机和本实例的图表，范围从 1 小时到 30 天。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:298
msgid "Activé par défaut. Désactivé : plus de relevé, plus de vue Historique."
msgstr "默认启用。禁用后：不再采样，也没有历史视图。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:299
msgid "Un relevé toutes les 10 secondes par le processus d'administration, gardé dans var/run/admin/history.json (écrit toutes les 5 minutes et à l'arrêt, relu au démarrage)."
msgstr "管理进程每 10 秒采样一次，保存在 var/run/admin/history.json（每 5 分钟及停止时写入，启动时重新读取）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:301
msgid "Processeur et mémoire : toute la machine. Requêtes : lignes ajoutées au journal d'accès de cette instance, comptées sans être relues."
msgstr "处理器和内存：整台机器。请求：追加到此实例访问日志中的行（无需重新读取即可统计）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:305
#: src/omega_serv/interfaces/tui/screens/admin_web_screen.py:133
msgid "Thème du panneau web"
msgstr "Web 面板主题"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:306
msgid "Couleurs du panneau web, parmi les 10 thèmes omega de la TUI. « Comme la TUI » (par défaut) suit le thème de cette instance (touche t)."
msgstr "Web 面板的配色，从 TUI 的 10 个 omega 主题中选择。“与 TUI 相同”（默认）跟随此实例的主题（t 键）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:308
msgid "Chaque navigateur peut choisir un autre thème dans la liste de la barre du haut du panneau ; ce choix reste dans ce navigateur (cookie), jamais sur le serveur. « Thème de l'instance » l'efface."
msgstr "每个浏览器都可以在面板顶部栏的列表中选择其他主题；该选择保留在该浏览器中（Cookie），绝不写入服务器。“实例主题”会清除它。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:311
msgid "Enregistrer, puis Recharger ; « Comme la TUI » suit la touche t dès la page suivante."
msgstr "保存，然后重新加载；“与 TUI 相同”从下一页起跟随 t 键。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:312
msgid "Les couleurs trop pâles pour être lues sur le web sont foncées ou éclaircies tout seules ; omega-base garde la charte du site."
msgstr "在 Web 上过淡难以阅读的颜色会自动加深或调亮；omega-base 保持网站的风格。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:316
#: src/omega_serv/interfaces/tui/screens/admin_web_screen.py:138
msgid "Adresses IP dans la vue Trafic"
msgstr "流量视图中的 IP 地址"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:317
msgid "Entières, ou masquées : dernier nombre à 0 en IPv4, 48 premiers bits seulement en IPv6."
msgstr "完整显示，或遮蔽：IPv4 最后一段为 0，IPv6 仅保留前 48 位。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:318
msgid "Masquées si le panneau est consulté par d'autres personnes que l'administrateur du site."
msgstr "如果除站点管理员外还有其他人查看面板，请遮蔽。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:319
msgid "Enregistrer, puis Recharger."
msgstr "先“保存”，再“重新加载”。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:320
msgid "Seul l'affichage change : le journal d'accès garde les adresses entières."
msgstr "只改变显示：访问日志仍保留完整地址。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:324
msgid "Ouvre l'écran des alertes locales : seuils, maintenance, alertes en cours."
msgstr "打开本地警报界面：阈值、维护、当前警报。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:325
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:473
msgid "Aucune saisie ici."
msgstr "此处无需输入。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:326
msgid "Ouvre l'écran."
msgstr "打开该界面。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:327
msgid "Aucun effet par lui-même."
msgstr "本身不产生任何效果。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:330
msgid "Enregistrer valide d'abord : un réglage refusé n'écrit rien et la saisie reste dans le formulaire. Un problème de l'administration web n'empêche jamais le site de démarrer."
msgstr "“保存”会先进行验证：被拒绝的设置不会写入任何内容，输入内容保留在表单中。Web 管理的问题从不会阻止站点启动。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:333
msgid "Activer ou désactiver l'option demande un redémarrage complet ; changer un réglage demande seulement un rechargement."
msgstr "启用或禁用该选项需要完全重启；更改设置只需重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:335
msgid "Jamais depuis le web : modifier la configuration, les profils, les zones ou les comptes, redémarrer ou arrêter le serveur. Ces gestes restent réservés au TUI et à la CLI."
msgstr "绝不能从网页进行：修改配置、配置档案、区域或账户，重启或停止服务器。这些操作仍只能在 TUI 和 CLI 中进行。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:342
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:82
msgid "Administration web - comptes"
msgstr "Web 管理 - 账户"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:343
msgid "Accueil -> Instances -> Configuration distante -> Comptes"
msgstr "主页 -> 实例 -> 远程配置 -> 账户"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:345
msgid "Comptes qui peuvent se connecter à l'administration web. Ils se créent et se modifient seulement ici ou par la CLI (omega-serv admin-web account), jamais depuis le navigateur. Rôle lecture : Tableau de bord seulement ; rôle administration : Tableau de bord et Administration."
msgstr "可以登录 Web 管理的账户。只能在此处或通过 CLI（omega-serv admin-web account）创建和修改，绝不能从浏览器操作。lecture 角色：仅仪表板；administration 角色：仪表板和管理。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:354
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:73
msgid "Ajouter un compte"
msgstr "添加账户"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:355
msgid "Identifiant, mot de passe (12 caractères au moins, saisi deux fois) et rôle."
msgstr "标识符、密码（至少 12 个字符，输入两次）和角色。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:356
msgid "Identifiant : lettres, chiffres, point, tiret, soulignement (32 au plus)."
msgstr "标识符：字母、数字、点、连字符、下划线（最多 32 个）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:357
msgid "Le mot de passe est enregistré haché (scrypt), jamais en clair."
msgstr "密码以哈希（scrypt）形式保存，绝不保存明文。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:358
msgid "Une saisie refusée reste dans le formulaire avec la raison."
msgstr "被拒绝的输入会连同原因保留在表单中。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:361
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:410
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:86
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:82
msgid "Activer TOTP"
msgstr "启用 TOTP"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:362
msgid "Deuxième facteur : un code à 6 chiffres qui change toutes les 30 secondes dans une application du téléphone (Aegis, FreeOTP, 2FAS, Google Authenticator...)."
msgstr "第二因素：手机应用（Aegis、FreeOTP、2FAS、Google Authenticator...）中每 30 秒变化一次的 6 位代码。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:364
msgid "Scanner le QR code depuis un autre appareil, ou, sans scan, saisir le secret affiché ou ouvrir le lien sur le téléphone ; puis taper le code affiché par l'application."
msgstr "用其他设备扫描 QR 码；不扫描时，输入显示的密钥或在手机上打开链接；然后输入应用显示的代码。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:366
msgid "Le secret n'est enregistré que si le code est juste ; 10 codes de secours s'affichent alors une seule fois, à noter."
msgstr "只有代码正确时才会保存密钥；随后 10 个备用码仅显示一次，请记下。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:368
msgid "Obligatoire pour un compte administration dès que l'administration web sort de cette machine."
msgstr "一旦 Web 管理开放到本机以外，administration 账户必须启用。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:371
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:86
msgid "Nouveaux codes de secours"
msgstr "新备用码"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:372
msgid "La colonne « Codes de secours » montre combien il en reste (par exemple 7 sur 10) ; un message prévient quand il en reste 2 ou moins."
msgstr "“备用码”列显示剩余数量（例如 7 / 10）；剩余 2 个或更少时会有消息提醒。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:374
msgid "Sélectionner un compte dont TOTP est activé, puis confirmer."
msgstr "选择一个已启用 TOTP 的账户，然后确认。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:375
msgid "Génère 10 nouveaux codes, affichés une seule fois ; les anciens ne marchent plus."
msgstr "生成 10 个新代码，仅显示一次；旧代码不再有效。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:376
msgid "Le TOTP du téléphone ne change pas et les sessions ouvertes restent ouvertes."
msgstr "手机上的 TOTP 不变，已打开的会话保持打开。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:379
msgid "Mot de passe, Rôle, Désactiver TOTP, Supprimer"
msgstr "密码、角色、禁用 TOTP、删除"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:380
msgid "Modifient le compte choisi dans le tableau."
msgstr "修改表格中选定的账户。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:381
msgid "Sélectionner une ligne d'abord."
msgstr "请先选择一行。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:382
msgid "Effet immédiat, sans rechargement."
msgstr "立即生效，无需重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:383
msgid "Les sessions web ouvertes du compte sont fermées."
msgstr "该账户已打开的 Web 会话将被关闭。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:386
msgid "Téléphone perdu : un code de secours remplace le code une fois ; sans code de secours, désactivez TOTP ici puis réactivez-le."
msgstr "手机丢失：一个备用码可代替一次代码；没有备用码时，请在此处禁用 TOTP 后重新启用。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:389
msgid "L'heure du serveur et du téléphone doit être juste (moins de 30 secondes d'écart) : sinon les codes sont refusés."
msgstr "服务器和手机的时间必须准确（误差小于 30 秒），否则代码会被拒绝。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:396
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:87
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:98
msgid "Codes de secours"
msgstr "备用码"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:397
msgid "Accueil -> Instances -> Configuration distante -> Comptes -> Nouveaux codes de secours"
msgstr "主页 -> 实例 -> 远程配置 -> 账户 -> 新备用码"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:398
msgid "Les 10 nouveaux codes de secours du compte, au format XXXX-XXXX, affichés une seule fois : omega-serv n'en garde que l'empreinte et ne peut pas les réafficher."
msgstr "该账户的 10 个新备用码，格式为 XXXX-XXXX，仅显示一次：omega-serv 只保存其哈希值，无法再次显示。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:400
msgid "Chaque code remplace une fois le code TOTP à la connexion (téléphone perdu ou indisponible), puis ne marche plus. Ils n'expirent pas avec le temps."
msgstr "每个代码可在登录时代替一次 TOTP 代码（手机丢失或无法使用时），之后即失效。备用码不会随时间过期。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:403
msgid "Les noter ailleurs que sur le téléphone de l'application TOTP : papier, ou gestionnaire de mots de passe sur un autre appareil."
msgstr "请将其记在 TOTP 应用所在手机以外的地方：纸上，或另一台设备上的密码管理器中。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:411
msgid "Accueil -> Instances -> Configuration distante -> Comptes -> Activer TOTP"
msgstr "主页 -> 实例 -> 远程配置 -> 账户 -> 启用 TOTP"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:412
msgid "Associe une application d'authentification du téléphone au compte choisi."
msgstr "将手机上的身份验证应用与所选账户关联。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:415
msgid "QR code, secret et lien"
msgstr "QR 码、密钥和链接"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:416
msgid "Trois façons de transmettre le même secret à l'application."
msgstr "向应用传递同一密钥的三种方式。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:417
msgid "QR code : à scanner depuis un autre appareil. Si ce terminal est sur le téléphone lui-même, saisir le secret (groupes de 4 lettres et chiffres) ou ouvrir le lien otpauth."
msgstr "QR 码：用其他设备扫描。如果此终端就在手机上运行，请输入密钥（4 个字母和数字为一组）或打开 otpauth 链接。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:419
msgid "Rien n'est enregistré à ce stade."
msgstr "此时尚未保存任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:420
msgid "Quitter l'écran sans valider laisse le compte tel qu'il était."
msgstr "不确认就离开此界面，账户保持原样。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:423
msgid "Copier le secret / Copier le lien"
msgstr "复制密钥 / 复制链接"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:424
msgid "Met le secret ou le lien otpauth dans le presse-papiers, pour le coller dans l'application sans le recopier à la main."
msgstr "将密钥或 otpauth 链接放入剪贴板，无需重新输入即可粘贴到应用中。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:426
msgid "Secret : à coller dans la saisie manuelle de l'application (type « basé sur le temps »). Lien : à ouvrir sur l'appareil qui a l'application."
msgstr "密钥：粘贴到应用的手动输入中（“基于时间”类型）。链接：在装有应用的设备上打开。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:428
msgid "Presse-papiers de cette machine (wl-copy, xclip ou xsel) et, en plus, celui du terminal : utile par SSH, selon le terminal."
msgstr "本机剪贴板（wl-copy、xclip 或 xsel），另外也发送到终端剪贴板：通过 SSH 时有用，取决于终端。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:430
msgid "Un message dit où le texte a été copié ; le presse-papiers garde le secret jusqu'à la prochaine copie."
msgstr "消息会说明文本复制到了哪里；剪贴板会保留密钥，直到下一次复制。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:434
#: src/omega_serv/interfaces/tui/screens/admin_accounts_screen.py:268
msgid "Valider le code"
msgstr "确认代码"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:435
msgid "Le code à 6 chiffres affiché maintenant par l'application."
msgstr "应用当前显示的 6 位代码。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:436
msgid "Le taper puis Valider le code."
msgstr "输入后点击“确认代码”。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:437
msgid "Code juste : TOTP activé, codes de secours affichés une seule fois."
msgstr "代码正确：TOTP 已启用，备用码仅显示一次。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:438
msgid "Code faux : rien n'est enregistré ; vérifier l'heure du téléphone et réessayer."
msgstr "代码错误：不保存任何内容；请检查手机时间后重试。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:446
msgid "Accueil -> État & Ressources"
msgstr "主页 -> 状态与资源"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:448
msgid "Tableau de bord en trois cadres, rafraîchi automatiquement toutes les 2 secondes : état du serveur/service, flux du log d'accès en direct, ressources système."
msgstr "三栏仪表板，每 2 秒自动刷新：服务器/服务状态、实时访问日志流、系统资源。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:451
msgid "Le type d'instance s'affiche en tête du premier cadre, lu dans la configuration : site (statique, listing, envoi de fichiers), application PHP (FastCGI actif), reverse proxy (une zone de reverse proxy sur « / » : tout part aux backends) ou mixte (des zones de reverse proxy à côté d'un site servi en local)."
msgstr "实例类型显示在第一个框的顶部，从配置中读取：网站（静态、目录列表、文件上传）、PHP 应用（启用 FastCGI）、反向代理（« / » 上有反向代理区域：全部转发到后端）或混合（反向代理区域与本地提供的网站并存）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:455
msgid "Pour un reverse proxy ou une instance mixte, le cadre FLUX gagne une section BACKENDS, avant les chemins les plus demandés : pour chaque backend de chaque zone, son état, ses requêtes, celles en cours, ses erreurs 502 (connexion impossible ou réponse invalide) et 504 (délai de lecture dépassé) et son temps de réponse moyen. Ce sont des mesures en direct depuis le démarrage du serveur, lues dans le serveur en marche : rien n'est gardé d'un démarrage à l'autre. Un nom DNS résolu en plusieurs adresses par le moteur natif donne une ligne par adresse."
msgstr "对于反向代理或混合实例，流量框在最常请求的路径之前增加后端部分：对每个区域的每个后端，显示其状态、请求数、处理中的请求、502 错误（无法连接或响应无效）和 504 错误（读取超时）以及平均响应时间。这些是自服务器启动以来的实时数据，从运行中的服务器读取：每次启动之间不保留任何数据。原生引擎解析为多个地址的 DNS 名称，每个地址显示一行。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:465
msgid "Force un rafraîchissement immédiat (sans attendre le prochain cycle de 2s)."
msgstr "立即强制刷新（无需等待下一个 2 秒周期）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:467
msgid "Relit l'état, les nouvelles lignes de log et les ressources système."
msgstr "重新读取状态、新的日志行和系统资源。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:471
#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:495
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:90
#: src/omega_serv/interfaces/tui/screens/resource_status_screen.py:210
msgid "Simuler une requête"
msgstr "模拟请求"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:472
msgid "Ouvre l'écran de simulation de routage."
msgstr "打开路由模拟界面。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:474
msgid "Ouvre SimulateRequestScreen."
msgstr "打开 SimulateRequestScreen。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:481
msgid "Le cadre FLUX ne lit que le log d'accès au format 'combined' - un format différent ne produira aucune statistique."
msgstr "“流量”栏只读取 'combined' 格式的访问日志 - 其他格式不会产生任何统计。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:484
msgid "La section BACKENDS interroge le serveur par sa route d'administration, comme « État en direct » de l'écran Reverse proxy : trusted_proxy doit être actif avec 127.0.0.1 dans ses réseaux de confiance, sinon la section indique que l'administration est refusée."
msgstr "后端部分通过服务器的管理路由查询，与反向代理界面的 « 实时状态 » 相同：必须启用 trusted_proxy 并将 127.0.0.1 加入可信网络，否则该部分会提示管理被拒绝。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:487
msgid "Le temps moyen est une moyenne glissante, celle qu'utilise la stratégie least_response_time : une tentative en échec y compte pour le délai de lecture de la zone. Une zone servie par Python avec plusieurs processus n'est comptée que dans le processus qui répond à l'administration."
msgstr "平均时间是移动平均值，与 least_response_time 策略使用的相同：失败的尝试按区域的读取超时计入。由多进程 Python 服务的区域只在响应管理请求的那个进程中计数。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:496
msgid "Accueil -> État & Ressources -> Simuler une requête"
msgstr "主页 -> 状态与资源 -> 模拟请求"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:498
msgid "Rejoue le VRAI routage d'OMEGA-SERV (mêmes règles que pour une requête réseau réelle) sans envoyer de requête réseau - utile pour diagnostiquer une règle avant de la tester en vrai."
msgstr "重放 OMEGA-SERV 真实的路由（与真实网络请求相同的规则），但不发送网络请求 - 便于在实际测试之前诊断某条规则。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:503
msgid "Méthode"
msgstr "方法"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:504
msgid "Méthode HTTP simulée."
msgstr "模拟的 HTTP 方法。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:505
msgid "Chaîne libre, ex: GET, HEAD, POST. Valeur par défaut : GET."
msgstr "自由文本，例如：GET、HEAD、POST。默认值：GET。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:507
msgid "Aucun effet (lecture seule, aucune requête réseau)."
msgstr "无效果（只读，不发出网络请求）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:511
msgid "Chemin d'URL simulé."
msgstr "模拟的 URL 路径。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:512
msgid "Chaîne libre commençant par '/'. Valeur par défaut : /."
msgstr "以 '/' 开头的自由文本。默认值：/。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:513
msgid "Utilisé au clic sur Simuler."
msgstr "点击“模拟”时使用。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:517
msgid "Affiche le chemin normalisé, si la méthode est autorisée, si une règle bloque la requête, le statut de réponse attendu et les en-têtes attendus."
msgstr "显示规范化后的路径、方法是否被允许、是否有规则拦截该请求、预期的响应状态以及预期的响应头。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:522
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:91
#: src/omega_serv/interfaces/tui/screens/server_config_menu_screen.py:68
msgid "Vérifier la configuration"
msgstr "检查配置"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:523
msgid "Accueil -> Configuration détaillée -> Vérifier la configuration"
msgstr "主页 -> 详细配置 -> 检查配置"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:525
msgid "Vérifie la configuration en deux couches : structurelle (déjà vérifiée au chargement) puis environnement réel (fichiers présents, permissions...)."
msgstr "分两层检查配置：结构层（加载时已检查）和真实环境层（文件是否存在、权限……）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:528
msgid "Un dossier de zone active absent du disque est signalé : cible d'un alias ou dossier d'un listing en avertissement (la zone répond 404 tant qu'il manque), dossier des scripts d'une zone FastCGI active en erreur (le serveur ne démarre pas). Au démarrage, un alias ou un listing absent laisse aussi une ligne dans error.log."
msgstr "磁盘上缺失的活动区域文件夹会被提示：别名目标或列表文件夹为警告（缺失期间该区域返回 404），活动 FastCGI 区域的脚本文件夹为错误（服务器不启动）。启动时，缺失的别名或列表还会在 error.log 中留下一行。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:535
#: src/omega_serv/interfaces/tui/screens/config_check_screen.py:44
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:40
msgid "Vérifier"
msgstr "检查"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:536
msgid "Relance explicitement la vérification."
msgstr "显式重新运行检查。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:537
msgid "Aucune saisie - une première vérification a déjà lieu automatiquement à l'ouverture de l'écran."
msgstr "无需输入 - 打开界面时已自动进行了第一次检查。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:538
msgid "Relit la configuration et l'environnement réel."
msgstr "重新读取配置和真实环境。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:547
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:83
msgid "Administration web - maître"
msgstr "Web 管理 - 主控"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:548
msgid "Accueil -> Instances -> Configuration distante -> Maître"
msgstr "主页 -> 实例 -> 远程配置 -> 主控"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:550
msgid "Le maître accepté par cette instance : une autre instance omega-serv qui la suit depuis la page Instances de son tableau de bord web, et la pilote si vous lui donnez le droit d'administration. Un seul maître à la fois ; en accepter un autre remplace l'ancien, révoqué aussitôt. Si le maître s'arrête, cette instance continue sans rien changer."
msgstr "此实例接受的主控：另一个 omega-serv 实例，它通过其 Web 仪表板的实例页面监控此实例，并在您授予管理权限时操控它。同一时间只能有一个主控；接受另一个会替换旧的，旧的立即被吊销。如果主控停止，此实例照常运行，不受影响。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:557
#: src/omega_serv/interfaces/tui/screens/admin_master_screen.py:61
#: src/omega_serv/interfaces/tui/screens/link_master_dialog.py:40
msgid "Droits donnés au maître"
msgstr "授予主控的权限"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:558
msgid "Lecture : le maître voit l'état, le flux, les ressources et la sécurité. Administration : il peut aussi lancer les actions du mode Administration (bans, incidents, RIPOSTE, backends, archives, rechargement)."
msgstr "只读：主控可查看状态、流量、资源和安全。管理：还可执行管理模式中的操作（封禁、事件、RIPOSTE、后端、归档、重新加载）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:561
msgid "Choisir avant d'ouvrir la fenêtre d'appairage."
msgstr "在打开配对窗口之前选择。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:562
msgid "Les droits sont fixés ici, jamais par le maître."
msgstr "权限在此处设定，绝不由主控设定。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:563
msgid "Une action demandée par un maître en lecture est refusée et écrite dans le journal d'audit."
msgstr "只读主控请求的操作会被拒绝并写入审计日志。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:566
#: src/omega_serv/interfaces/tui/screens/admin_master_screen.py:67
msgid "Accepter un maître (code)"
msgstr "接受主控（代码）"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:567
msgid "Ouvre une fenêtre d'appairage de 10 minutes et affiche un code comme K7QF-3M9X."
msgstr "打开 10 分钟的配对窗口，并显示类似 K7QF-3M9X 的代码。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:568
msgid "Sur le maître : page Instances -> « Ajouter à la main » -> adresse IP de cette instance, port de son administration web, et le code."
msgstr "在主控上：实例页面 -> “手动添加” -> 此实例的 IP 地址、其 Web 管理端口和代码。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:570
msgid "Le code sert une seule fois ; 3 essais faux ferment la fenêtre. Le maître retient l'empreinte du certificat de cette instance : un certificat changé ensuite est refusé et signalé."
msgstr "代码只能使用一次；错误 3 次将关闭窗口。主控会记录此实例证书的指纹：之后若证书更改，将被拒绝并提示。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:572
msgid "Si un maître est déjà accepté, une confirmation est demandée : il sera remplacé à la fin de l'appairage."
msgstr "如果已接受一个主控，会要求确认：它将在配对结束时被替换。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:576
#: src/omega_serv/interfaces/tui/screens/admin_master_screen.py:71
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:56
msgid "Révoquer"
msgstr "吊销"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:577
msgid "Retire le maître accepté."
msgstr "移除已接受的主控。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:578
msgid "Confirmer."
msgstr "确认。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:579
msgid "Ses appels sont refusés dès maintenant (ligne dans le journal d'audit)."
msgstr "从现在起其调用将被拒绝（审计日志中记录一行）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:580
msgid "Le maître affiche « jeton refusé » pour cette instance."
msgstr "主控对此实例显示“令牌被拒绝”。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:583
msgid "Maître sur cette machine, rien à recopier : écran Instances -> « Relier au maître » (il lance admin-web master accept sur cette instance, puis admin-web instances add sur le maître)."
msgstr "主控在本机，无需复制任何内容：实例界面 -> “关联主控”（它会在此实例上运行 admin-web master accept，再在主控上运行 admin-web instances add）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:586
msgid "L'adresse du maître doit être dans les réseaux permis de cette instance (Configuration distante), sinon ses appels reçoivent 403."
msgstr "主控的地址必须在此实例允许的网络内（远程配置），否则其调用会收到 403。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:588
msgid "Hors de cette machine, l'administration web est toujours en HTTPS : c'est ce qui protège le jeton du maître."
msgstr "在本机之外，Web 管理始终使用 HTTPS：正是这保护了主控的令牌。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:596
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:84
msgid "Administration web - alertes"
msgstr "Web 管理 - 警报"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:597
msgid "Accueil -> Instances -> Configuration distante -> Alertes"
msgstr "主页 -> 实例 -> 远程配置 -> 警报"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:598
msgid "Alertes locales : rien n'est envoyé hors de cette machine. Le processus d'administration surveille le disque, la mémoire, le swap, le processeur, la température, la batterie, le taux d'erreurs 5xx du site, les backends, les incidents Active Defense et les certificats. Une alerte s'ouvre quand le seuil est dépassé pendant un moment, et se ferme quand la mesure redescend nettement."
msgstr "本地警报：不会向本机以外发送任何内容。管理进程监控磁盘、内存、swap、处理器、温度、电池、站点 5xx 错误率、后端、Active Defense 事件和证书。超过阈值持续一段时间后打开警报，测量值明显回落后关闭警报。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:604
#: src/omega_serv/interfaces/tui/screens/admin_alerts_screen.py:60
msgid "Seuils"
msgstr "阈值"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:605
msgid "Un seuil par règle ; vide = règle coupée."
msgstr "每条规则一个阈值；留空 = 停用该规则。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:606
msgid "Nombre dans les bornes indiquées. Disque 90 %, mémoire 90 %, swap 80 %, processeur 95 %, température 85 °C, batterie 15 %, erreurs 5xx 5 % (sur 5 minutes, à partir de 50 requêtes), certificat 30 jours (puis 14, 7 et 1)."
msgstr "在所示范围内的数字。磁盘 90 %，内存 90 %，swap 80 %，处理器 95 %，温度 85 °C，电池 15 %，5xx 错误 5 %（5 分钟内，至少 50 个请求时），证书 30 天（之后 14、7 和 1 天）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:609
msgid "Enregistrer, puis Recharger : le processus d'administration prend les nouveaux seuils."
msgstr "先“保存”，再“重新加载”：管理进程会采用新的阈值。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:610
msgid "Une alerte ouverte d'une règle coupée se ferme."
msgstr "已停用规则的未关闭警报会被关闭。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:613
msgid "Maintenance 1 h / 24 h, Fin de maintenance"
msgstr "维护 1 小时 / 24 小时、结束维护"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:614
msgid "Pendant une maintenance, aucune nouvelle alerte ne s'ouvre ; celles déjà ouvertes se ferment normalement."
msgstr "维护期间不会打开新警报；已打开的警报照常关闭。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:616
msgid "Avant un redémarrage, une mise à jour, un gros transfert."
msgstr "在重启、更新或大量传输之前。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:617
msgid "Effet immédiat (fichier var/lib/admin/alertes-maintenance.json)."
msgstr "立即生效（文件 var/lib/admin/alertes-maintenance.json）。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:618
msgid "Le panneau web l'indique en haut de la vue Alertes."
msgstr "Web 面板会在警报视图顶部显示这一点。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:621
msgid "Les alertes s'affichent dans le panneau web (vue Alertes, avec leur nombre dans la barre des vues) et dans var/log/alertes.log ; 30 jours d'historique dans var/lib/admin/alertes.json."
msgstr "警报显示在 Web 面板中（警报视图，视图栏中显示其数量）以及 var/log/alertes.log 中；var/lib/admin/alertes.json 中保留 30 天历史。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:624
msgid "Il faut l'administration web active (en boucle locale suffit, rien n'est ouvert au réseau). Disque, mémoire, swap, processeur, température, batterie et erreurs 5xx demandent aussi l'Historique."
msgstr "需要启用 Web 管理（仅本地回环即可，不会向网络开放任何内容）。磁盘、内存、swap、处理器、温度、电池和 5xx 错误还需要启用历史。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:626
msgid "Un service arrêté ne peut rien signaler lui-même : les alertes s'arrêtent avec lui."
msgstr "已停止的服务无法自行报告任何情况：警报会随之停止。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:632
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:85
msgid "Administration web - sessions ouvertes"
msgstr "Web 管理 - 打开的会话"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:633
msgid "Accueil -> Instances -> Configuration distante -> Comptes -> Sessions"
msgstr "主页 -> 实例 -> 远程配置 -> 账户 -> 会话"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:634
msgid "Navigateurs connectés au panneau web : compte, adresse, ouverture et dernière activité. Liste publiée toutes les 5 secondes par le processus d'administration, sans jamais le jeton de session."
msgstr "连接到 Web 面板的浏览器：账户、地址、打开时间和最后活动时间。列表由管理进程每 5 秒发布一次，从不包含会话令牌。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:638
#: src/omega_serv/interfaces/tui/screens/admin_sessions_screen.py:38
msgid "Fermer la session"
msgstr "关闭会话"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:639
msgid "Déconnecte le navigateur choisi."
msgstr "断开所选浏览器的连接。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:640
msgid "Choisir une session dans la liste."
msgstr "在列表中选择一个会话。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:641
msgid "Dépose une demande que le processus d'administration applique dans les 5 secondes."
msgstr "提交一个请求，管理进程会在 5 秒内执行。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:642
msgid "Ligne « session fermee par TUI » dans le journal d'audit ; le navigateur revient à la page de connexion."
msgstr "审计日志中出现一行“session fermee par TUI”；浏览器回到登录页面。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:646
msgid "Aussi dans le panneau web (vue Sessions) : un compte administration y voit et ferme toutes les sessions, un compte lecture les siennes."
msgstr "Web 面板中也有（会话视图）：administration 账户可以查看并关闭所有会话，只读账户只能查看并关闭自己的会话。"

#: src/omega_serv/interfaces/tui/guide/content/service_et_instances.py:649
msgid "Une session vit 30 minutes sans activité et 8 heures au plus ; un redémarrage du service les ferme toutes."
msgstr "会话无活动 30 分钟后失效，最长 8 小时；重启服务会关闭所有会话。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:11
msgid "Accueil -> Configuration détaillée -> FastCGI / PHP-FPM"
msgstr "主页 -> 详细配置 -> FastCGI / PHP-FPM"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:13
msgid "Liste des zones PHP : chaque zone relaie un préfixe d'URL vers un serveur PHP-FPM (sa socket), avec ses propres scripts, délais, extensions, fichiers d'index et liste blanche, et son propre interrupteur. Plusieurs applications PHP peuvent ainsi tourner sur une même instance (/blog/ et /wiki/, par exemple) ; le préfixe le plus long l'emporte. L'option fastcgi du menu Options reste l'interrupteur général. Une ancienne configuration à une seule zone s'affiche comme une ligne de la liste et passe au nouveau format au premier enregistrement."
msgstr "PHP 区域列表：每个区域把一个 URL 前缀转发到一个 PHP-FPM 服务器（其 socket），并有自己的脚本、超时、扩展名、索引文件、白名单和开关。这样，同一实例上可以运行多个 PHP 应用（例如 /blog/ 和 /wiki/）；最长的前缀优先。“选项”菜单中的 fastcgi 选项仍是总开关。旧的单区域配置显示为列表中的一行，并在第一次保存时转换为新格式。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:22
msgid "Ajouter / Modifier (une zone)"
msgstr "添加 / 修改（区域）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:23
msgid "Ouvre le formulaire de la zone : préfixe, racine des scripts, socket, délais, extensions, fichiers d'index, liste blanche."
msgstr "打开区域表单：前缀、脚本根目录、socket、超时、扩展名、索引文件、白名单。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:25
msgid "Deux zones ne peuvent pas avoir le même préfixe (/blog et /blog/ comptent pour un)."
msgstr "两个区域不能使用相同的前缀（/blog 与 /blog/ 视为同一个）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:26
msgid "Valider enregistre la zone, après validation ; une erreur reste affichée dans le formulaire, saisie intacte."
msgstr "“确认”在验证后保存区域；出错时错误显示在表单中，输入内容保持不变。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:29
msgid "Si l'option fastcgi est déjà activé : rechargement suffit (automatique si un service actif existe). Sinon, sa PREMIÈRE activation exige un redémarrage complet."
msgstr "如果 fastcgi 选项已启用：重新加载即可（如有活动服务则自动进行）。否则，首次启用需要完全重启。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:34
msgid "Préfixe URL (url_prefix)"
msgstr "URL 前缀（url_prefix）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:35
msgid "Le préfixe d'URL sous lequel les requêtes sont relayées vers PHP-FPM."
msgstr "其下的请求被转发到 PHP-FPM 的 URL 前缀。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:36
msgid "Doit commencer par '/'. Valeur par défaut : /app/."
msgstr "必须以 '/' 开头。默认值：/app/。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:37
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:44
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:53
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:60
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:70
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:77
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:84
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:94
msgid "Enregistre avec le reste des champs."
msgstr "与其他字段一起保存。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:38
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:45
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:54
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:61
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:71
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:78
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:85
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:95
msgid "Même réaction que Ajouter / Modifier."
msgstr "与“添加 / 修改”相同。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:41
msgid "Racine d'exécution (script_root)"
msgstr "执行根目录（script_root）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:42
msgid "Répertoire, relatif au projet, contenant les scripts PHP exécutables."
msgstr "相对于项目的目录，包含可执行的 PHP 脚本。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:43
msgid "Chemin relatif - ne peut jamais être à l'intérieur du webroot (vérifié structurellement)."
msgstr "相对路径 - 永远不能位于 webroot 之内（在结构上进行检查）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:48
#: src/omega_serv/interfaces/tui/screens/fastcgi_screen.py:41
msgid "Socket PHP-FPM (socket_path)"
msgstr "PHP-FPM socket（socket_path）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:49
msgid "Chemin du socket Unix utilisé pour communiquer avec PHP-FPM."
msgstr "与 PHP-FPM 通信所使用的 Unix socket 路径。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:50
msgid "Chemin relatif. Valeur par défaut : var/run/php-fpm.sock. Plusieurs zones peuvent partager une socket ; une socket par zone (un pool PHP-FPM par zone) donne à chaque zone ses propres réglages PHP et son propre compte système."
msgstr "相对路径。默认值：var/run/php-fpm.sock。多个区域可以共用一个 socket；每个区域一个 socket（每个区域一个 PHP-FPM pool）可让每个区域拥有自己的 PHP 设置和系统账户。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:58
msgid "Délais réseau appliqués à la communication avec PHP-FPM."
msgstr "与 PHP-FPM 通信时应用的网络超时。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:59
msgid "Nombres en secondes. Valeurs par défaut : 5 (connexion), 30 (lecture)."
msgstr "以秒为单位的数字。默认值：5（连接），30（读取）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:64
msgid "Taille maximale de requête"
msgstr "最大请求大小"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:65
msgid "Taille maximale du corps d'une requête vers cette zone, en octets (envoi de fichiers, formulaires)."
msgstr "发往此区域的请求正文的最大大小，单位为字节（文件上传、表单）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:67
msgid "Nombre entier d'octets (10485760 = 10 Mo). Vide : la taille de l'écran Limites s'applique. Plus grande pour une zone d'administration qui reçoit de gros fichiers, ou plus petite pour une zone ouverte au public."
msgstr "整数字节数（10485760 = 10 MB）。留空：使用“限制”界面的大小。接收大文件的管理区域可设得更大，对公众开放的区域可设得更小。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:74
msgid "Extensions autorisées"
msgstr "允许的扩展名"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:75
msgid "Extensions de fichiers exécutées via PHP-FPM."
msgstr "通过 PHP-FPM 执行的文件扩展名。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:76
msgid "Liste séparée par des virgules. Valeur par défaut : .php."
msgstr "逗号分隔的列表。默认值：.php。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:81
msgid "Fichiers d'index"
msgstr "索引文件"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:82
msgid "Fichiers cherches quand une URL sous ce préfixe pointe vers un répertoire."
msgstr "当此前缀下的 URL 指向目录时查找的文件。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:83
msgid "Liste séparée par des virgules. Valeur par défaut : index.php."
msgstr "逗号分隔的列表。默认值：index.php。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:88
msgid "Liste blanche de scripts"
msgstr "脚本白名单"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:90
msgid "Restreint les scripts réellement exécutables (chemins relatifs à script_root) - vide signifie 'tout fichier avec une extension autorisée sous script_root reste exécutable'."
msgstr "限制真正可执行的脚本（相对于 script_root 的路径）- 为空表示“script_root 下任何具有允许扩展名的文件都可执行”。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:93
msgid "Liste séparée par des virgules, ex: index.php, api/router.php. Vide par défaut."
msgstr "逗号分隔的列表，例如：index.php, api/router.php。默认为空。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:98
msgid "Désactiver / Activer (une zone)"
msgstr "禁用 / 启用（区域）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:99
msgid "Interrupteur de la zone choisie, pour une maintenance de ses fichiers sans couper les autres zones."
msgstr "所选区域的开关，用于维护其文件而不关闭其他区域。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:101
msgid "Choisissez la zone dans le tableau ; le bouton indique l'action possible. Colonne « Active » : oui ou non."
msgstr "在表格中选择区域；按钮显示可执行的操作。“启用”列：是或否。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:103
msgid "Enregistre aussitôt l'état de la zone."
msgstr "立即保存区域的状态。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:104
msgid "Rechargement suffit. Une zone désactivée répond 503 (maintenance) sur tout son préfixe, sans servir un fichier du webroot à sa place ; son dossier et sa socket ne sont plus exigés au démarrage."
msgstr "重新加载即可。已禁用的区域在其整个前缀上返回 503（维护），不会改为提供 webroot 中的文件；启动时不再要求其目录和 socket 存在。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:109
msgid "Supprimer (une zone)"
msgstr "删除（区域）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:110
msgid "Retire la zone choisie de la liste, après confirmation."
msgstr "确认后从列表中移除所选区域。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:111
msgid "Les scripts ne sont pas effacés : seule la zone disparaît de la configuration."
msgstr "脚本不会被删除：只是从配置中移除该区域。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:112
msgid "Enregistre aussitôt."
msgstr "立即保存。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:113
msgid "Rechargement suffit ; les URL de ce préfixe reviennent au reste du site."
msgstr "重新加载即可；该前缀的 URL 回归网站其余部分处理。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:117
msgid "La PREMIÈRE activation de l'option fastcgi (écran Options) exige un REDÉMARRAGE COMPLET (le client FastCGI n'est construit qu'au démarrage). Une fois déjà activé, modifier ces réglages ici ne demande plus qu'un simple rechargement."
msgstr "首次启用 fastcgi 选项（“选项”界面）需要完全重启（FastCGI 客户端只在启动时构建）。启用之后，在这里修改这些设置只需简单的重新加载。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:123
msgid "script_root ne peut structurellement jamais se trouver à l'intérieur du webroot - bloqué avant même l'enregistrement, pas seulement par 'Vérifier la configuration'."
msgstr "script_root 在结构上永远不能位于 webroot 之内 - 甚至在保存之前就会被阻止，而不只是由“检查配置”发现。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:126
msgid "Une zone désactivée garde cette règle : elle peut être réactivée à tout moment."
msgstr "已禁用的区域仍保留此规则：可随时重新启用。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:127
msgid "omega-serv n'installe, n'écrit ni ne vérifie la configuration de PHP-FPM : son édition reste de la responsabilité de l'administrateur. omega-serv ne transmet jamais de valeur PHP par requête (PHP_VALUE) : sur un pool partagé, elle déborderait sur les autres zones. Des réglages PHP différents (mémoire, taille d'envoi, open_basedir) passent par un pool par zone ; le minimum que chaque pool doit contenir est décrit dans la FAQ « réglages PHP différents par zone »."
msgstr "omega-serv 不安装、不写入也不检查 PHP-FPM 的配置：其编辑由管理员负责。omega-serv 从不按请求传递 PHP 值（PHP_VALUE）：在共享 pool 上，它会影响其他区域。不同的 PHP 设置（内存、上传大小、open_basedir）通过每个区域一个 pool 来实现；每个 pool 至少应包含的内容见 FAQ“各区域使用不同的 PHP 设置”。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:132
msgid "Chaque zone peut fixer sa propre taille maximale de requête (en octets), plus grande ou plus petite que celle de l'écran Limites ; vide, c'est celle de l'écran Limites qui s'applique. Un envoi plus gros est refusé (413) avant d'atteindre PHP, quel que soit le réglage du pool."
msgstr "每个区域可以设置自己的最大请求大小（字节），可大于或小于“限制”界面的值；留空则使用“限制”界面的值。更大的上传会在到达 PHP 之前被拒绝（413），与 pool 的设置无关。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:135
msgid "Depuis la 3.0.0, un en-tête de requête nommé Proxy n'est jamais transmis à PHP (HTTP_PROXY servirait à détourner les appels sortants du script, faille « httpoxy »), ni un en-tête dont le nom contient « _ » (X_Forwarded_For se confondrait avec X-Forwarded-For une fois traduit en HTTP_X_FORWARDED_FOR)."
msgstr "自 3.0.0 起，名为 Proxy 的请求头永远不会传给 PHP（HTTP_PROXY 可被用来劫持脚本的对外调用，即“httpoxy”漏洞），名称中含有“_”的请求头也不会传递（X_Forwarded_For 转换为 HTTP_X_FORWARDED_FOR 后会与 X-Forwarded-For 混淆）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:144
msgid "Accueil -> Configuration détaillée -> Authentification"
msgstr "主页 -> 详细配置 -> 身份验证"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:146
msgid "Gestion des utilisateurs et des zones protégées par authentification HTTP. Les identifiants et zones sont stockés dans des fichiers SÉPARÉS (users.json/zones.json), jamais dans config/omega-serve.json."
msgstr "管理用户以及受 HTTP 身份验证保护的区域。凭据和区域存储在单独的文件中（users.json/zones.json），从不存放在 config/omega-serve.json 中。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:152
msgid "Table Utilisateurs"
msgstr "用户表格"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:154
msgid "Liste les comptes existants - cliquer une ligne la SÉLECTIONNE (active Changer le mot de passe/Supprimer) sans jamais retaper le nom d'utilisateur."
msgstr "列出现有账户 - 点击一行即可选中（启用“修改密码/删除”），无需再次输入用户名。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:157
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:188
msgid "Sélection par clic, une seule ligne à la fois."
msgstr "点击选择，一次只能选一行。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:158
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:189
msgid "Aucune écriture - lecture seule."
msgstr "不写入 - 只读。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:159
msgid "Active/desactive les boutons Changer le mot de passe et Supprimer."
msgstr "启用/禁用“修改密码”和“删除”按钮。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:163
msgid "Crée un compte utilisateur."
msgstr "创建一个用户账户。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:164
msgid "Nom d'utilisateur + mot de passe saisi deux fois (jamais affiché en clair)."
msgstr "用户名 + 输入两次的密码（从不以明文显示）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:165
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:175
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:182
msgid "Écrit directement dans users.json."
msgstr "直接写入 users.json。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:169
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:74
msgid "Changer le mot de passe"
msgstr "修改密码"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:170
msgid "Change le mot de passe de l'utilisateur SÉLECTIONNÉ dans la table."
msgstr "修改表格中所选用户的密码。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:172
msgid "Sélectionner une ligne d'abord (le nom d'utilisateur n'est jamais retape) - puis le nouveau mot de passe, saisi deux fois."
msgstr "先选择一行（从不需要再次输入用户名）- 然后输入两次新密码。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:179
msgid "Supprimer (utilisateur)"
msgstr "删除（用户）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:180
msgid "Retire définitivement le compte utilisateur SÉLECTIONNÉ dans la table."
msgstr "永久移除表格中所选的用户账户。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:181
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:215
msgid "Sélectionner une ligne d'abord, puis confirmer - aucune saisie."
msgstr "先选择一行，然后确认 - 无需输入。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:186
msgid "Table Zones protégées"
msgstr "受保护区域表格"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:187
msgid "Liste les zones existantes - cliquer une ligne la SÉLECTIONNE (active Modifier et Supprimer)."
msgstr "列出现有区域 - 点击一行即可选中（启用“修改”和“删除”）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:190
msgid "Active/desactive les boutons Modifier et Supprimer."
msgstr "启用/禁用“修改”和“删除”按钮。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:193
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:82
msgid "Créer une zone"
msgstr "创建区域"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:194
msgid "Protège un préfixe d'URL par authentification HTTP."
msgstr "用 HTTP 身份验证保护某个 URL 前缀。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:196
msgid "Préfixe URL (ex: /admin/), realm (texte affiché par le navigateur), utilisateurs autorisés (séparés par des virgules), méthodes autorisées (vide = toutes)."
msgstr "URL 前缀（例如：/admin/）、realm（浏览器显示的文本）、允许的用户（用逗号分隔）、允许的方法（留空 = 全部）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:200
#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:216
msgid "Écrit directement dans zones.json."
msgstr "直接写入 zones.json。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:204
msgid "Modifier (zone)"
msgstr "修改（区域）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:205
msgid "Corrige la zone SÉLECTIONNÉE : préfixe, realm, utilisateurs autorisés, méthodes."
msgstr "修改所选区域：前缀、realm、允许的用户、方法。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:206
msgid "Le formulaire s'ouvre déjà rempli. Une saisie invalide (préfixe sans « / », aucun utilisateur, préfixe déjà pris par une autre zone) est signalée dans le formulaire, et ce que vous avez tapé est gardé."
msgstr "表单打开时已填好。无效输入（前缀没有“/”、没有用户、前缀已被其他区域使用）会在表单中提示，您输入的内容会保留。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:209
msgid "Écrit directement dans zones.json ; la zone garde sa place dans la liste."
msgstr "直接写入 zones.json；区域在列表中的位置保持不变。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:213
msgid "Supprimer (zone)"
msgstr "删除（区域）"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:214
msgid "Retire la protection de la zone SÉLECTIONNÉE dans la table."
msgstr "解除表格中所选区域的保护。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:220
msgid "Protection des mots de passe"
msgstr "密码保护"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:222
msgid "Réglages du cache des succès et de la limite des échecs (valeurs par défaut entre parenthèses) : succès retenu (300 s, renouvelées à chaque requête ; 0 = aucun cache), durée maximale d'un succès retenu (3600 s), succès retenus au plus (4096), fenêtre de comptage des échecs (300 s), échecs par adresse avant 429 (10), échecs par nom d'utilisateur avant 429 (30), vérifications en attente au plus avant 503 (10)."
msgstr "成功缓存与失败上限的设置（默认值在括号中）：记住的成功（300 秒，每次请求时续期；0 = 不缓存），记住的成功的最长保留时间（3600 秒），最多记住的成功数（4096），失败计数窗口（300 秒），429 之前每个地址的失败次数（10），429 之前每个用户名的失败次数（30），503 之前最多等待的验证数（10）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:228
msgid "Modifier les réglages : un formulaire, un nombre entier par réglage ; une valeur hors bornes est refusée avec ses limites."
msgstr "修改设置：一个表单，每项设置一个整数；超出范围的值会被拒绝并给出其范围。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:229
msgid "Écrit dans config/omega-serve.json (options.auth.password_protection)."
msgstr "已写入 config/omega-serve.json（options.auth.password_protection）。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:230
msgid "Appliqué au prochain rechargement ; les succès retenus sont alors oubliés et les compteurs repartent de zéro."
msgstr "在下次重新加载时生效；届时记住的成功将被遗忘，计数器从零重新开始。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:233
#: src/omega_serv/interfaces/tui/screens/auth_menu_screen.py:103
msgid "Vérifier les permissions"
msgstr "检查权限"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:234
msgid "Vérifie que users.json/zones.json ne sont pas lisibles par d'autres utilisateurs du système."
msgstr "检查 users.json/zones.json 不能被系统中的其他用户读取。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:235
msgid "Aucune saisie - lecture seule."
msgstr "无需输入 - 只读。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:236
msgid "Affiche le mode de permission réel de chaque fichier."
msgstr "显示每个文件的实际权限模式。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:241
msgid "L'option auth doit être activée (écran Options) pour que les zones protégées soient réellement appliquées. Toute modification d'utilisateur/zone se recharge à chaud."
msgstr "必须启用 auth 选项（“选项”界面），受保护的区域才会真正生效。对用户/区域的任何修改都支持热重载。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:246
msgid "Une authentification active SANS TLS transmet les identifiants en clair sur le réseau - l'assistant premier lancement demande une confirmation explicite dans ce cas."
msgstr "在没有 TLS 的情况下启用身份验证会在网络上以明文传输凭据 - 此时首次启动向导会要求明确确认。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:249
msgid "Coût d'une vérification : environ 0,3 à 0,5 s de calcul (scrypt). Un succès est retenu 5 minutes, renouvelées à chaque requête, une heure au plus, puis vérifié à nouveau ; tout est oublié à chaque modification d'utilisateur ou de zone. Après 10 mauvais mots de passe d'une même adresse (ou 30 pour un même nom d'utilisateur) en 5 minutes, réponse 429 immédiate, sans calcul, jusqu'à la fin des 5 minutes. Plus de 10 vérifications en attente : 503 immédiat."
msgstr "一次校验的成本：约 0.3 到 0.5 秒计算（scrypt）。成功会被记住 5 分钟，每次请求续期，最多一小时，之后重新校验；每次修改用户或区域时全部清除。5 分钟内同一地址输错 10 次密码（同一用户名 30 次）后，在 5 分钟结束前立即返回 429，不做计算。排队校验超过 10 个：立即返回 503。"

#: src/omega_serv/interfaces/tui/guide/content/services_avances.py:254
msgid "Ces valeurs sont celles par défaut, réglables dans « Protection des mots de passe ». Un seuil trop bas bloque vite un utilisateur qui se trompe ; un succès retenu à 0 relance le calcul à chaque requête."
msgstr "这些是默认值，可在“密码保护”中调整。阈值过低会很快封锁输错的用户；将记住的成功设为 0 会在每次请求时重新计算。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:11
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:55
msgid "TLS (menu)"
msgstr "TLS（菜单）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:12
msgid "Accueil -> Configuration détaillée -> TLS"
msgstr "主页 -> 详细配置 -> TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:13
msgid "Sous-menu regroupant les 5 écrans liés à TLS : statut, génération, CA locale, révocation, activation."
msgstr "汇集 5 个 TLS 相关界面的子菜单：状态、生成、本地 CA、吊销、启用。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:20
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:56
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:29
msgid "Statut TLS"
msgstr "TLS 状态"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:21
msgid "Configuration détaillée -> TLS -> Statut TLS"
msgstr "详细配置 -> TLS -> TLS 状态"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:22
msgid "Inspecte le certificat actuellement configuré : validité, expiration, correspondance avec la clé privée, permissions."
msgstr "检查当前配置的证书：有效性、过期时间、与私钥是否匹配、权限。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:26
msgid "Relit et reanalyse le certificat configuré."
msgstr "重新读取并分析所配置的证书。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:28
msgid "Relance l'inspection."
msgstr "重新运行检查。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:35
msgid "Inspecte le FICHIER sur disque, pas nécessairement celui réellement servi par un serveur déjà lancé si celui-ci a changé depuis le dernier redémarrage."
msgstr "检查的是磁盘上的文件，如果自上次重启以来证书有变化，则不一定是已启动服务器实际使用的证书。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:43
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:57
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:30
msgid "Échéances des certificats"
msgstr "证书到期日"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:44
msgid "Configuration détaillée -> TLS -> Échéances des certificats"
msgstr "详细配置 -> TLS -> 证书到期日"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:45
msgid "Liste tous les certificats de cette instance : celui du site, celui du panneau web et chaque fichier de secure/certificates/ qui contient un certificat (CA locale, copies de Certbot). Pour chacun : fin de validité, jours restants, noms couverts."
msgstr "列出此实例的所有证书：站点证书、Web 面板证书，以及 secure/certificates/ 中每个包含证书的文件（本地 CA、Certbot 副本）。每个证书显示：有效期截止日、剩余天数、覆盖的名称。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:51
msgid "Relit tous les certificats."
msgstr "重新读取所有证书。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:53
msgid "openssl lit chaque fichier, hors du fil de l'écran."
msgstr "openssl 在后台读取每个文件，不会卡住界面。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:57
msgid "Aucune - purement consultatif. Le panneau web montre la même liste (vue Certificats) et ouvre une alerte à 30, 14, 7 et 1 jour de l'échéance."
msgstr "无 - 仅供查看。Web 面板显示相同的列表（证书视图），并在到期前 30、14、7 和 1 天打开警报。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:60
msgid "Certificats sur cette machine seulement : ceux des backends distants ne sont pas vérifiés (aucune connexion). Les clés privées ne sont jamais lues. Sans openssl, l'échéance est « inconnue »."
msgstr "仅限本机上的证书：不检查远程后端的证书（不建立任何连接）。从不读取私钥。没有 openssl 时，到期日为“未知”。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:67
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:58
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:31
msgid "Générer un certificat auto-signé"
msgstr "生成自签名证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:68
msgid "Configuration détaillée -> TLS -> Générer un certificat auto-signé"
msgstr "详细配置 -> TLS -> 生成自签名证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:69
msgid "Génère un certificat auto-signé (jamais reconnu par défaut par les navigateurs) et l'écrit sur disque."
msgstr "生成一张自签名证书（浏览器默认从不认可）并写入磁盘。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:72
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:99
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:111
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:41
#: src/omega_serv/interfaces/tui/screens/wizard_tls_screen.py:51
msgid "Nom commun (CN)"
msgstr "通用名称（CN）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:73
msgid "Nom commun du certificat."
msgstr "证书的通用名称。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:74
msgid "Chaîne libre, généralement le nom d'hôte du serveur."
msgstr "自由文本，通常是服务器的主机名。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:75
#: src/omega_serv/interfaces/tui/guide/content/tls.py:82
#: src/omega_serv/interfaces/tui/guide/content/tls.py:89
#: src/omega_serv/interfaces/tui/guide/content/tls.py:96
#: src/omega_serv/interfaces/tui/guide/content/tls.py:103
#: src/omega_serv/interfaces/tui/guide/content/tls.py:110
msgid "Utilisé à la génération."
msgstr "生成时使用。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:76
msgid "Écrit réellement le certificat/la clé sur disque immédiatement."
msgstr "立即将证书/密钥真正写入磁盘。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:79
msgid "SAN DNS / SAN IP"
msgstr "SAN DNS / SAN IP"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:80
msgid "Noms DNS et adresses IP alternatifs couverts par le certificat."
msgstr "证书所涵盖的备用 DNS 名称和 IP 地址。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:81
msgid "Listes séparées par des virgules, optionnelles."
msgstr "逗号分隔的列表，可选。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:83
#: src/omega_serv/interfaces/tui/guide/content/tls.py:90
#: src/omega_serv/interfaces/tui/guide/content/tls.py:97
#: src/omega_serv/interfaces/tui/guide/content/tls.py:104
#: src/omega_serv/interfaces/tui/guide/content/tls.py:111
msgid "Écrit sur disque immédiatement."
msgstr "立即写入磁盘。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:86
msgid "Organisation / Unité / Ville / Région / Pays"
msgstr "组织 / 部门 / 城市 / 地区 / 国家"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:87
msgid "Champs d'identité du certificat (sujet X.509)."
msgstr "证书的身份字段（X.509 主题）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:88
msgid "Chaînes libres, tous optionnels sauf Organisation (pré-rempli : OMEGA-SERV)."
msgstr "自由文本，除“组织”外均为可选（预填：OMEGA-SERV）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:93
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:117
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:55
msgid "Validité en jours"
msgstr "有效期（天）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:94
msgid "Durée de validité du certificat généré."
msgstr "所生成证书的有效期。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:95
msgid "Entier positif, en jours. Valeur par défaut : 365."
msgstr "正整数，单位为天。默认值：365。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:100
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:113
msgid "Type de clé"
msgstr "密钥类型"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:101
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:114
msgid "Algorithme et taille de la clé privée générée."
msgstr "所生成私钥的算法和长度。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:102
msgid "Valeurs valides indiquées dans le sous-titre. Valeur par défaut : rsa2048."
msgstr "有效值见副标题。默认值：rsa2048。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:107
#: src/omega_serv/interfaces/tui/screens/generate_self_signed_screen.py:59
msgid "Mot de passe de clé (optionnel)"
msgstr "密钥密码（可选）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:108
msgid "Passphrase protégeant la clé privée générée."
msgstr "保护所生成私钥的口令。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:109
msgid "Chaîne libre, optionnelle - saisie masquée."
msgstr "自由文本，可选 - 输入时隐藏。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:115
msgid "Génère réellement des fichiers sur disque des le clic sur Générer. Si TLS est DÉJÀ actif, le serveur en cours d'exécution continue de servir l'ANCIEN certificat jusqu'à un REDÉMARRAGE COMPLET, même si le fichier a changé (le contexte SSL n'est construit qu'une seule fois au démarrage)."
msgstr "点击“生成”后立即在磁盘上真正生成文件。如果 TLS 已经启用，运行中的服务器会继续使用旧证书，直到完全重启，即使文件已经改变（SSL 上下文只在启动时构建一次）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:124
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:59
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:32
msgid "Assistant CA locale"
msgstr "本地 CA 向导"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:125
msgid "Configuration détaillée -> TLS -> Assistant CA locale"
msgstr "详细配置 -> TLS -> 本地 CA 向导"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:127
msgid "Enchaîne trois étapes indépendantes : générer une autorité de certification locale, générer une demande de signature (CSR) pour ce serveur, signer cette CSR avec la CA - permet d'obtenir un certificat reconnu par les clients ayant importe la CA, sans passer par une autorité publique."
msgstr "依次完成三个独立的步骤：生成本地证书颁发机构、为本服务器生成证书签名请求（CSR）、用该 CA 签署此 CSR - 无需经过公共机构，即可获得被导入了该 CA 的客户端认可的证书。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:134
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:86
msgid "1. Générer la CA"
msgstr "1. 生成 CA"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:135
msgid "Crée l'autorité de certification locale (clé + certificat racine)."
msgstr "创建本地证书颁发机构（密钥 + 根证书）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:136
msgid "CN, organisation, validité (défaut 3650 jours), type de clé, passphrase OBLIGATOIRE (saisie deux fois)."
msgstr "CN、组织、有效期（默认 3650 天）、密钥类型、必填的口令（输入两次）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:137
msgid "Écrit root-ca.key/root-ca.pem/serial.txt/index.txt sous secure/certificates/ca/."
msgstr "在 secure/certificates/ca/ 下写入 root-ca.key/root-ca.pem/serial.txt/index.txt。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:138
msgid "Écrit réellement sur disque immédiatement. À faire une seule fois."
msgstr "立即真正写入磁盘。只需执行一次。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:141
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:88
msgid "2. Générer la CSR"
msgstr "2. 生成 CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:142
msgid "Crée une demande de signature de certificat pour CE serveur."
msgstr "为本服务器创建一个证书签名请求。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:143
msgid "CN, SAN DNS/IP, identité, type de clé - pas de passphrase ici."
msgstr "CN、SAN DNS/IP、身份信息、密钥类型 - 这里不需要口令。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:144
msgid "Écrit le fichier .csr à côté de la clé privée du serveur."
msgstr "将 .csr 文件写在服务器私钥旁边。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:145
msgid "Écrit réellement sur disque immédiatement."
msgstr "立即真正写入磁盘。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:148
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:90
msgid "3. Signer la CSR"
msgstr "3. 签署 CSR"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:149
msgid "Signe la CSR générée à l'étape 2 avec la CA de l'étape 1, produit le certificat final."
msgstr "用第 1 步的 CA 签署第 2 步生成的 CSR，生成最终证书。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:150
msgid "Chemin de la CSR (pré-rempli), passphrase de la CA (resaisie), validité en jours (défaut 365)."
msgstr "CSR 路径（已预填）、CA 口令（重新输入）、有效期（天，默认 365）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:151
msgid "Écrit le certificat signé (et la chaîne complète) sur disque."
msgstr "将签署后的证书（以及完整证书链）写入磁盘。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:153
msgid "Écrit réellement sur disque immédiatement. Si TLS est DÉJÀ actif, un REDÉMARRAGE COMPLET reste nécessaire pour que le serveur serve ce nouveau certificat (le contexte SSL en mémoire ne se recharge jamais tout seul)."
msgstr "立即真正写入磁盘。如果 TLS 已经启用，仍需完全重启，服务器才会使用这张新证书（内存中的 SSL 上下文永远不会自动重新加载）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:160
msgid "Le certificat racine de la CA (root-ca.pem) doit être importe manuellement dans le magasin de confiance de chaque client pour que le certificat final soit reconnu - rappelé dans le journal de l'assistant après chaque étape réussie."
msgstr "必须手动将 CA 的根证书（root-ca.pem）导入每个客户端的信任存储，最终证书才会被认可 - 每个步骤成功后，向导日志中都会提醒这一点。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:166
msgid "La passphrase de la CA n'est jamais conservée en mémoire entre les étapes - elle est resaisie explicitement à l'étape 3."
msgstr "CA 口令从不在步骤之间保留在内存中 - 第 3 步需要明确地重新输入。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:174
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:60
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:33
msgid "Assistant Let's Encrypt (Certbot)"
msgstr "Let's Encrypt 向导（Certbot）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:175
msgid "Configuration détaillée -> TLS -> Assistant Let's Encrypt (Certbot)"
msgstr "详细配置 -> TLS -> Let's Encrypt 向导（Certbot）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:177
msgid "Obtient un certificat public reconnu par les navigateurs via Certbot (défi HTTP-01, mode webroot) - jamais --standalone (le port 80 est déjà occupé par OMEGA-SERV) et jamais /etc/letsencrypt/ (tout est écrit sous secure/certificates/letsencrypt/ du projet, entièrement non-privilégié). Importe automatiquement le certificat obtenu et installe un script de renouvellement (voir Renouvellement automatique (Certbot))."
msgstr "通过 Certbot 获取被浏览器认可的公共证书（HTTP-01 质询，webroot 模式）- 从不使用 --standalone（80 端口已被 OMEGA-SERV 占用），也从不使用 /etc/letsencrypt/（一切都写在项目的 secure/certificates/letsencrypt/ 下，完全无需特权）。自动导入获得的证书并安装续期脚本（见“自动续期（Certbot）”）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:185
msgid "Domaine"
msgstr "域名"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:186
msgid "Nom de domaine public déjà pointé vers ce serveur (obligatoire)."
msgstr "已指向此服务器的公共域名（必填）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:187
msgid "Ex : monserveur.dynu.com - un DDNS (Dynu ou équivalent) reste à configurer par vous-même, hors de cet assistant."
msgstr "例如：monserveur.dynu.com - DDNS（Dynu 或同类服务）需要您自己在此向导之外配置。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:188
msgid "Utilisé pour la demande Certbot et le défi HTTP-01."
msgstr "用于 Certbot 申请和 HTTP-01 质询。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:189
msgid "Aucun effet avant confirmation - le résumé préalable rappelle le domaine et le mode choisis."
msgstr "确认之前无效果 - 事先的汇总会再次显示所选的域名和模式。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:192
msgid "Email"
msgstr "电子邮件"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:193
msgid "Adresse utilisée par Let's Encrypt pour les alertes d'expiration (optionnelle)."
msgstr "Let's Encrypt 用于发送过期提醒的地址（可选）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:194
msgid "Chaîne libre. Vide : Certbot s'enregistre sans email (--register-unsafely-without-email)."
msgstr "自由文本。留空：Certbot 不使用电子邮件注册（--register-unsafely-without-email）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:195
msgid "Transmis à Certbot à la demande."
msgstr "申请时传给 Certbot。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:196
msgid "Aucun effet avant confirmation."
msgstr "确认之前无效果。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:199
msgid "Mode test (staging)"
msgstr "测试模式（staging）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:200
msgid "Utilise l'environnement de test de Let's Encrypt plutôt que la production."
msgstr "使用 Let's Encrypt 的测试环境，而不是生产环境。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:201
msgid "Case à cocher, COCHÉE PAR DÉFAUT - certificat non reconnu par les navigateurs mais jamais soumis aux limites de taux réelles."
msgstr "复选框，默认勾选 - 证书不被浏览器认可，但从不受真实的速率限制。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:202
msgid "Transmis à Certbot (--staging) si coché."
msgstr "勾选时传给 Certbot（--staging）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:203
msgid "À décocher seulement une fois le domaine/webroot vérifiés fonctionnels en mode test."
msgstr "只有在测试模式下确认域名/webroot 工作正常后才取消勾选。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:206
#: src/omega_serv/interfaces/tui/screens/lets_encrypt_screen.py:70
msgid "Obtenir le certificat"
msgstr "获取证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:207
msgid "Lance la demande après un résumé et une confirmation explicite."
msgstr "在汇总和明确确认之后发起申请。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:208
msgid "Aucune saisie - déclenche l'appel réseau réel à Let's Encrypt."
msgstr "无需输入 - 触发对 Let's Encrypt 的真实网络调用。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:209
msgid "Exécute Certbot puis importe le certificat obtenu (déporté dans un thread de travail, l'interface reste réactive)."
msgstr "运行 Certbot，然后导入获得的证书（在工作线程中进行，界面保持响应）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:211
msgid "Écrit réellement sur disque en cas de succès. Si TLS est DÉJÀ actif, le serveur en cours d'exécution continue de servir l'ANCIEN certificat jusqu'à un REDÉMARRAGE COMPLET."
msgstr "成功时真正写入磁盘。如果 TLS 已经启用，运行中的服务器会继续使用旧证书，直到完全重启。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:218
msgid "Le port 80 doit rester accessible depuis Internet le temps du défi HTTP-01 (webroot) - échoue sinon (pare-feu, redirection de port non faite sur le routeur, DNS/DDNS pas encore propagé). Soumis aux limites de taux réelles de Let's Encrypt en mode production (jamais en mode test)."
msgstr "在 HTTP-01 质询（webroot）期间，80 端口必须能从互联网访问 - 否则会失败（防火墙、路由器上未做端口转发、DNS/DDNS 尚未生效）。生产模式下受 Let's Encrypt 真实的速率限制（测试模式下从不受限）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:225
msgid "Le DDNS (Dynu ou équivalent) et la redirection de port restent ENTIÈREMENT à votre charge - cet assistant ne configure jamais rien en dehors de ce serveur."
msgstr "DDNS（Dynu 或同类服务）和端口转发完全由您负责 - 此向导从不配置本服务器之外的任何东西。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:229
msgid "Si OMEGA-SERV tourne dans un conteneur : exécutez cet assistant HORS du conteneur qui sert le trafic (sur l'hôte, ou un conteneur/sidecar distinct partageant le même volume secure/ et le même webroot) - jamais Certbot à l'intérieur du conteneur servant déjà le trafic public, voir la FAQ."
msgstr "如果 OMEGA-SERV 运行在容器中：请在处理流量的容器之外运行此向导（在宿主机上，或在共享同一 secure/ 卷和同一 webroot 的独立容器/sidecar 中）- 绝不要在已经处理公共流量的容器内运行 Certbot，见常见问题。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:239
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:61
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:34
msgid "Renouvellement automatique (Certbot)"
msgstr "自动续期（Certbot）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:240
msgid "Configuration détaillée -> TLS -> Renouvellement automatique (Certbot)"
msgstr "详细配置 -> TLS -> 自动续期（Certbot）"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:242
msgid "Planifie le renouvellement automatique des certificats Certbot déjà obtenus (Assistant Let's Encrypt) - s'adapte au gestionnaire de service réellement détecté pour CETTE instance : timer systemd installé depuis l'interface, sinon une ligne crontab si possible, sinon des instructions manuelles affichées sans rien écrire. Jamais un mécanisme global partagé entre plusieurs instances multi-instance."
msgstr "为已通过 Let's Encrypt 向导获得的 Certbot 证书计划自动续期 - 根据为本实例实际检测到的服务管理器进行适配：从界面安装 systemd 定时器；否则尽可能添加一行 crontab；再否则显示手动操作说明而不写入任何内容。从不是多个实例之间共享的全局机制。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:250
#: src/omega_serv/interfaces/tui/screens/renewal_schedule_screen.py:51
msgid "Configurer maintenant"
msgstr "立即配置"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:251
msgid "Installe (ou réinstalle) le mécanisme de renouvellement adapté à ce système."
msgstr "安装（或重新安装）适合本系统的续期机制。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:254
msgid "systemd : écrit et active un timer (sudo ponctuel, même mécanisme que l'écran SERVICE). OpenRC/runit/aucun gestionnaire reconnu : ajoute une ligne à votre crontab utilisateur si `crontab` est disponible, sinon affiche la ligne à ajouter vous-même."
msgstr "systemd：写入并启用一个定时器（临时使用 sudo，与“服务”界面的机制相同）。OpenRC/runit/未识别到管理器：如果有 `crontab`，则向您的用户 crontab 添加一行，否则显示需要您自己添加的那一行。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:259
msgid "Reconfigurer ne dupliqué jamais l'entrée (idempotent) - remplace toujours l'entrée précédente de CETTE instance."
msgstr "重新配置从不会重复添加条目（幂等）- 始终替换本实例之前的条目。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:263
msgid "Une fois installé, le renouvellement tourne deux fois par jour sans aucune intervention - le script de hook (Assistant Let's Encrypt) réimporte automatiquement chaque certificat renouvelé puis redémarre le service."
msgstr "安装后，续期每天运行两次，无需任何干预 - hook 脚本（Let's Encrypt 向导）会自动重新导入每张续期的证书，然后重启服务。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:269
msgid "Sur certaines distributions (dont Arch/Manjaro), le paquet Certbot n'installe AUCUN timer par défaut, contrairement à Debian/Ubuntu - vérifiez toujours le statut affiché ici plutôt que de supposer qu'un mécanisme existe déjà."
msgstr "在某些发行版上（包括 Arch/Manjaro），与 Debian/Ubuntu 不同，Certbot 软件包默认不安装任何定时器 - 请始终检查这里显示的状态，而不要假定已经存在某种机制。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:274
msgid "Ne concerne QUE les certificats gérés par Certbot (secure/certificates/letsencrypt/) - un certificat auto-signé ou signé par la CA locale n'a pas besoin (et ne bénéficie pas) de ce renouvellement."
msgstr "只涉及由 Certbot 管理的证书（secure/certificates/letsencrypt/）- 自签名证书或由本地 CA 签署的证书不需要（也不会受益于）此续期。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:283
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:62
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:35
msgid "Révoquer un certificat"
msgstr "吊销证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:284
msgid "Configuration détaillée -> TLS -> Révoquer un certificat"
msgstr "详细配置 -> TLS -> 吊销证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:285
msgid "Marque un certificat comme révoqué dans le registre de la CA (index.txt) - action irréversible pour ce certificat."
msgstr "在 CA 的登记表（index.txt）中将证书标记为已吊销 - 对该证书而言是不可撤销的操作。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:288
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:40
msgid "Certificat à révoquer"
msgstr "要吊销的证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:289
msgid "Chemin du certificat à marquer comme révoqué."
msgstr "要标记为已吊销的证书路径。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:290
msgid "Chemin relatif au projet."
msgstr "相对于项目的路径。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:291
#: src/omega_serv/interfaces/tui/guide/content/tls.py:298
#: src/omega_serv/interfaces/tui/guide/content/tls.py:305
msgid "Utilisé à la confirmation."
msgstr "确认时使用。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:292
msgid "Modifie index.txt immédiatement après confirmation."
msgstr "确认后立即修改 index.txt。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:295
msgid "Clé / Certificat de la CA"
msgstr "CA 密钥 / 证书"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:296
msgid "Identité de l'autorité de certification qui a signé le certificat visé."
msgstr "签署目标证书的证书颁发机构的身份。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:297
msgid "Chemins pré-remplis vers secure/certificates/ca/."
msgstr "已预填指向 secure/certificates/ca/ 的路径。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:299
#: src/omega_serv/interfaces/tui/guide/content/tls.py:306
msgid "Modifie index.txt immédiatement."
msgstr "立即修改 index.txt。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:302
#: src/omega_serv/interfaces/tui/screens/ca_wizard_screen.py:154
#: src/omega_serv/interfaces/tui/screens/revoke_certificate_screen.py:52
msgid "Passphrase de la clé CA"
msgstr "CA 密钥口令"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:303
msgid "Nécessaire pour prouver l'autorité sur la CA avant de révoquer."
msgstr "在吊销之前用于证明对 CA 的权限。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:304
msgid "Saisie masquée."
msgstr "输入时隐藏。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:310
msgid "Demande une confirmation explicite (action irréversible pour ce certificat). Si le certificat révoqué est celui ACTUELLEMENT utilisé par un serveur TLS déjà actif, un REDÉMARRAGE COMPLET est nécessaire, sinon il continue d'être présenté aux clients malgré sa révocation."
msgstr "需要明确确认（对该证书而言不可撤销）。如果被吊销的证书正被已启用 TLS 的服务器使用，则需要完全重启，否则尽管已吊销，它仍会继续出示给客户端。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:317
msgid "Pas de distribution CRL complète en V1 - la révocation reste locale (index.txt), jamais publiée vers les clients automatiquement."
msgstr "V1 中没有完整的 CRL 分发 - 吊销仅在本地生效（index.txt），从不自动发布给客户端。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:325
#: src/omega_serv/interfaces/tui/guide/menu_tree.py:63
#: src/omega_serv/interfaces/tui/screens/tls_menu_screen.py:36
msgid "Activer / désactiver TLS"
msgstr "启用 / 禁用 TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:326
msgid "Configuration détaillée -> TLS -> Activer / désactiver TLS"
msgstr "详细配置 -> TLS -> 启用 / 禁用 TLS"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:327
msgid "Active ou désactive TLS, et choisit son mode (direct ou derrière un proxy qui termine déjà le TLS)."
msgstr "启用或禁用 TLS，并选择其模式（直接，或位于已终止 TLS 的代理之后）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:331
msgid "Comment TLS est géré par ce serveur."
msgstr "本服务器如何处理 TLS。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:333
msgid "direct (ce serveur termine TLS lui-même, via ssl.SSLContext local) ou behind_proxy (TLS déjà terminé en amont, ce serveur reste en HTTP simple)."
msgstr "direct（本服务器自己终止 TLS，使用本地 ssl.SSLContext）或 behind_proxy（TLS 已在上游终止，本服务器保持普通 HTTP）。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:336
msgid "Enregistre au clic sur Activer TLS."
msgstr "点击“启用 TLS”时保存。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:337
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET, jamais un simple rechargement."
msgstr "始终需要完全重启，简单的重新加载永远不够。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:340
msgid "Chemin du certificat / de la clé privée"
msgstr "证书 / 私钥路径"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:341
msgid "Fichiers utilisés si le mode est 'direct'. Optionnels : conservent la valeur actuelle si vides."
msgstr "模式为 'direct' 时使用的文件。可选：留空则保留当前值。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:342
msgid "Chemins relatifs au projet."
msgstr "相对于项目的路径。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:344
msgid "Nécessite TOUJOURS un REDÉMARRAGE COMPLET."
msgstr "始终需要完全重启。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:348
msgid "Le contexte SSL n'est construit qu'une seule fois au démarrage - activer, désactiver, ou changer le mode TLS exige SYSTÉMATIQUEMENT un redémarrage complet, que ce soit pour l'activation ou la désactivation."
msgstr "SSL 上下文只在启动时构建一次 - 启用、禁用或更改 TLS 模式，无论是启用还是禁用，都一律需要完全重启。"

#: src/omega_serv/interfaces/tui/guide/content/tls.py:354
msgid "À ne pas confondre avec le réglage 'reverse_proxy' (Configuration détaillée -> Reverse Proxy) : ici, 'behind_proxy' signifie qu'OMEGA-SERV est DERRIÈRE un proxy TLS externe, l'inverse d'agir soi-même comme proxy."
msgstr "不要与“reverse_proxy”设置（详细配置 -> 反向代理）混淆：这里的 'behind_proxy' 表示 OMEGA-SERV 位于外部 TLS 代理之后，与自己充当代理正好相反。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:10
msgid "Assistant premier lancement - 1/8 Bienvenue"
msgstr "首次启动向导 - 1/8 欢迎"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:11
msgid "Accueil -> Assistant premier lancement"
msgstr "主页 -> 首次启动向导"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:13
msgid "Point d'entrée de l'assistant guide qui compose une première configuration complète, étape par étape."
msgstr "引导式向导的入口，逐步组合出第一份完整的配置。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:18
#: src/omega_serv/interfaces/tui/screens/wizard_welcome_screen.py:42
msgid "Commencer"
msgstr "开始"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:19
msgid "Démarre le parcours guide."
msgstr "开始引导流程。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:20
msgid "Aucune saisie à cette étape."
msgstr "此步骤无需输入。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:21
msgid "Ouvre l'étape 2/8 (Registre des capacités)."
msgstr "打开第 2/8 步（能力清单）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:22
msgid "Aucun effet sur disque - rien n'est écrit avant l'étape 7 (Résumé)."
msgstr "对磁盘无影响 - 第 7 步（汇总）之前不会写入任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:25
msgid "Aucune - purement informatif."
msgstr "无 - 纯粹提供信息。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:30
msgid "Assistant premier lancement - 2/8 Capacités"
msgstr "首次启动向导 - 2/8 能力"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:31
msgid "Assistant premier lancement -> étape 2/8"
msgstr "首次启动向导 -> 第 2/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:33
msgid "Scan en lecture seule de l'environnement (port par défaut déjà occupé, openssl présent...), avec le port par défaut - aucun profil ni port personnalisé n'est encore choisi."
msgstr "只读扫描运行环境（默认端口是否已被占用、openssl 是否存在……），使用默认端口 - 此时尚未选择任何配置档案或自定义端口。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:38
msgid "Suivant / Précédent"
msgstr "下一步 / 上一步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:39
msgid "Navigation entre les étapes."
msgstr "在步骤之间导航。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:40
msgid "Aucune saisie à cette étape (table en lecture seule)."
msgstr "此步骤无需输入（只读表格）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:41
msgid "Suivant ouvre l'étape 3/8 (Profil)."
msgstr "“下一步”打开第 3/8 步（配置档案）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:42
msgid "Aucun effet - purement informatif."
msgstr "无效果 - 纯粹提供信息。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:50
msgid "Assistant premier lancement - 3/8 Profil"
msgstr "首次启动向导 - 3/8 配置档案"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:51
msgid "Assistant premier lancement -> étape 3/8"
msgstr "首次启动向导 -> 第 3/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:52
msgid "Choix d'un profil de base parmi les quatre profils preconfigures."
msgstr "从四个预设配置档案中选择一个基础配置档案。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:55
msgid "Table des profils"
msgstr "配置档案表格"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:56
msgid "Liste des profils disponibles avec leur description au clic."
msgstr "可用配置档案的列表，点击后显示其描述。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:57
msgid "4 profils : minimal, standard, hardened, development."
msgstr "4 个配置档案：minimal、standard、hardened、development。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:58
msgid "Sélectionner une ligne affiche sa description et active le bouton Suivant."
msgstr "选择一行会显示其描述，并启用“下一步”按钮。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:59
msgid "Le profil choisi est appliqué à la CONFIGURATION CANDIDATE EN MÉMOIRE uniquement."
msgstr "所选配置档案只应用于内存中的候选配置。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:62
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:86
msgid "Rien n'est encore écrit sur disque à cette étape."
msgstr "此步骤尚未向磁盘写入任何内容。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:67
msgid "Assistant premier lancement - 4/8 Configuration de base"
msgstr "首次启动向导 - 4/8 基本配置"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:68
msgid "Assistant premier lancement -> étape 4/8"
msgstr "首次启动向导 -> 第 4/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:69
msgid "Ajuste uniquement l'adresse d'écoute et le port - le reste vient du profil choisi."
msgstr "只调整监听地址和端口 - 其余部分来自所选配置档案。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:72
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:56
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:317
#: src/omega_serv/interfaces/tui/screens/wizard_base_config_screen.py:36
msgid "Adresse d'écoute (server.bind)"
msgstr "监听地址（server.bind）"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:73
msgid "Adresse IP sur laquelle le serveur écoutera."
msgstr "服务器将要监听的 IP 地址。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:74
msgid "Une adresse IP valide. Pré-remplie avec la valeur du profil choisi."
msgstr "一个有效的 IP 地址。已预填所选配置档案的值。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:75
msgid "Validée (structurellement) au clic sur Suivant."
msgstr "点击“下一步”时（在结构上）进行验证。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:76
msgid "En mémoire uniquement à ce stade - voir l'étape 7 pour l'écriture réelle."
msgstr "此阶段仅在内存中 - 真正写入见第 7 步。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:79
#: src/omega_serv/interfaces/tui/screens/base_config_screen.py:58
#: src/omega_serv/interfaces/tui/screens/instances_screen.py:318
#: src/omega_serv/interfaces/tui/screens/wizard_base_config_screen.py:38
msgid "Port (server.port)"
msgstr "端口（server.port）"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:81
msgid "Un entier de port valide. Pré-rempli avec la valeur du profil choisi."
msgstr "一个有效的端口整数。已预填所选配置档案的值。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:82
msgid "Validé au clic sur Suivant."
msgstr "点击“下一步”时进行验证。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:83
msgid "En mémoire uniquement à ce stade."
msgstr "此阶段仅在内存中。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:91
msgid "Assistant premier lancement - 5/8 TLS"
msgstr "首次启动向导 - 5/8 TLS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:92
msgid "Assistant premier lancement -> étape 5/8"
msgstr "首次启动向导 -> 第 5/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:94
msgid "Propose de générer un certificat auto-signé et d'activer TLS - jamais force, et jamais proposé du tout si le profil choisi est 'development'."
msgstr "提供生成自签名证书并启用 TLS 的选项 - 从不强制，如果所选配置档案是 'development' 则完全不提供。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:100
msgid "Nom commun (Common Name) du certificat - généralement le nom d'hôte du serveur."
msgstr "证书的通用名称（Common Name）- 通常是服务器的主机名。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:101
msgid "Chaîne libre, ex: mon-serveur.local."
msgstr "自由文本，例如：mon-serveur.local。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:102
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:109
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:116
msgid "Utilisé au clic sur 'Générer et activer TLS'."
msgstr "点击“生成并启用 TLS”时使用。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:103
msgid "Génère réellement le certificat sur disque immédiatement (pas différé à l'étape 7)."
msgstr "立即在磁盘上真正生成证书（不推迟到第 7 步）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:106
msgid "SAN DNS"
msgstr "SAN DNS"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:107
msgid "Noms DNS alternatifs couverts par le certificat (Subject Alternative Name)."
msgstr "证书所涵盖的备用 DNS 名称（Subject Alternative Name）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:108
msgid "Liste séparée par des virgules, optionnelle."
msgstr "逗号分隔的列表，可选。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:110
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:117
msgid "Génère réellement le certificat sur disque immédiatement."
msgstr "立即在磁盘上真正生成证书。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:115
msgid "Valeurs valides listées dans le sous-titre du champ. Valeur par défaut : rsa2048."
msgstr "有效值列在字段的副标题中。默认值：rsa2048。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:121
msgid "Générer un certificat ici écrit réellement des fichiers sur disque tout de suite (contrairement au reste de l'assistant) - active tls.enabled en mémoire pour la suite du parcours, écrit dans la configuration finale à l'étape 7."
msgstr "在这里生成证书会立刻向磁盘真正写入文件（与向导的其余部分不同）- 在内存中为后续流程启用 tls.enabled，并在第 7 步写入最终配置。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:126
msgid "Cette étape est entièrement absente pour le profil 'development' - remplacée par un simple message."
msgstr "对于 'development' 配置档案，此步骤完全不存在 - 由一条简单的消息代替。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:132
msgid "Assistant premier lancement - 6/8 Vérification"
msgstr "首次启动向导 - 6/8 检查"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:133
msgid "Assistant premier lancement -> étape 6/8"
msgstr "首次启动向导 -> 第 6/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:135
msgid "Vérification automatique (structurelle puis environnement réel) avant de pouvoir continuer - les mêmes deux couches que l'écran 'Vérifier la configuration'."
msgstr "继续之前的自动检查（先结构，后真实环境）- 与“检查配置”界面相同的两层检查。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:140
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:36
msgid "Confirmer : bind public + certificat auto-signé"
msgstr "确认：公网监听 + 自签名证书"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:142
msgid "Porte de confirmation explicite requise pour continuer si le serveur écoute publiquement avec un certificat auto-signé (jamais reconnu par les navigateurs)."
msgstr "如果服务器以自签名证书（浏览器从不认可）公开监听，需要明确确认才能继续。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:145
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:155
msgid "À cocher uniquement si cette combinaison est réellement voulue."
msgstr "只有确实需要这种组合时才勾选。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:146
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:156
msgid "Pris en compte au prochain clic sur Vérifier."
msgstr "下次点击“检查”时生效。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:147
#: src/omega_serv/interfaces/tui/guide/content/wizard.py:157
msgid "Sans cette confirmation, le bouton Suivant reste désactivé si la situation s'applique."
msgstr "如果出现这种情况而未确认，“下一步”按钮将保持禁用。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:150
#: src/omega_serv/interfaces/tui/screens/wizard_check_screen.py:37
msgid "Confirmer : authentification sans TLS"
msgstr "确认：无 TLS 的身份验证"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:152
msgid "Porte de confirmation explicite requise pour continuer si l'authentification est active sans TLS (identifiants transmis en clair)."
msgstr "如果在没有 TLS 的情况下启用了身份验证（凭据以明文传输），需要明确确认才能继续。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:160
msgid "Rien n'est encore écrit sur disque à cette étape - seulement des vérifications."
msgstr "此步骤尚未向磁盘写入任何内容 - 只是检查。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:165
msgid "Assistant premier lancement - 7/8 Résumé"
msgstr "首次启动向导 - 7/8 汇总"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:166
msgid "Assistant premier lancement -> étape 7/8"
msgstr "首次启动向导 -> 第 7/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:168
msgid "Affiche la différence complète entre les valeurs par défaut et la configuration composée par l'assistant, puis écrit réellement le fichier de configuration."
msgstr "显示默认值与向导所组合配置之间的完整差异，然后真正写入配置文件。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:173
#: src/omega_serv/interfaces/tui/screens/wizard_summary_screen.py:40
msgid "Écrire la configuration"
msgstr "写入配置"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:174
msgid "Confirme et écrit la configuration composée."
msgstr "确认并写入所组合的配置。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:175
msgid "À vérifier attentivement le résumé affiché avant de cliquer."
msgstr "点击前请仔细检查显示的汇总。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:176
msgid "Écrit config/omega-serve.json (une sauvegarde de l'ancien fichier est faite automatiquement s'il existait)."
msgstr "写入 config/omega-serve.json（如果旧文件存在，会自动备份）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:177
msgid "C'EST LA PREMIÈRE ÉCRITURE RÉELLE de tout le parcours - ouvre ensuite l'étape 8/8."
msgstr "这是整个流程中第一次真正写入 - 之后打开第 8/8 步。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:180
msgid "Écrase config/omega-serve.json (avec sauvegarde automatique du fichier précédent s'il existait)."
msgstr "覆盖 config/omega-serve.json（如果之前的文件存在，会自动备份）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:185
msgid "Assistant premier lancement - 8/8 Service"
msgstr "首次启动向导 - 8/8 服务"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:186
msgid "Assistant premier lancement -> étape 8/8"
msgstr "首次启动向导 -> 第 8/8 步"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:187
msgid "La configuration est écrite - propose de lancer le serveur, de l'installer comme service, ou de terminer."
msgstr "配置已写入 - 可以启动服务器、将其安装为服务，或直接结束。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:190
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:59
msgid "Lancer maintenant"
msgstr "立即启动"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:191
msgid "Lance réellement le serveur au premier plan, tout de suite."
msgstr "立即在前台真正启动服务器。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:192
msgid "Pour un test immédiat sans installer de service système."
msgstr "用于立即测试，无需安装系统服务。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:193
msgid "Rend la main au terminal réel et bloque jusqu'à Ctrl+C (ou arrêt du service)."
msgstr "将控制权交还给真实终端，并阻塞直到按下 Ctrl+C（或服务停止）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:194
msgid "Le serveur écoute réellement le temps de cette action - revient à l'accueil à l'arrêt."
msgstr "在此操作期间服务器真正监听 - 停止后返回主页。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:197
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:61
msgid "Installer le service"
msgstr "安装服务"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:198
msgid "Ouvre l'écran SERVICE pour installer une unité systemd (démarrage automatique)."
msgstr "打开“服务”界面以安装 systemd 单元（自动启动）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:199
msgid "Pour un usage durable (le serveur redémarre avec la machine)."
msgstr "用于长期使用（服务器随机器一起重启）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:200
msgid "Ouvre l'écran SERVICE."
msgstr "打开“服务”界面。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:201
msgid "Voir la fiche SERVICE - une authentification (sudo) sera demandée."
msgstr "见“服务”的说明 - 将要求身份验证（sudo）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:204
#: src/omega_serv/interfaces/tui/screens/wizard_service_screen.py:63
msgid "Terminer"
msgstr "完成"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:205
msgid "Quitte l'assistant sans rien lancer."
msgstr "退出向导，不启动任何东西。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:206
msgid "À choisir si vous comptez lancer le serveur plus tard manuellement."
msgstr "如果您打算以后手动启动服务器，请选择此项。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:207
msgid "Revient à l'accueil."
msgstr "返回主页。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:208
msgid "Le serveur ne tourne pas - `omega-serv.sh serve` (CLI) reste à lancer manuellement."
msgstr "服务器没有运行 - 需要手动运行 `omega-serv.sh serve`（CLI）。"

#: src/omega_serv/interfaces/tui/guide/content/wizard.py:211
msgid "La configuration est déjà écrite depuis l'étape précédente - cet écran ne fait que décider comment démarrer."
msgstr "配置在上一步已经写入 - 此界面只决定如何启动。"

