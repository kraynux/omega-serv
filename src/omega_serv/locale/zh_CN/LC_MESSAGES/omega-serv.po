#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:249
#: src/omega_serv/interfaces/tui/screens/incidents_screen.py:88
msgid "Générer rapport"
msgstr "生成报告"

#: src/omega_serv/interfaces/tui/guide/content/securite_active.py:250
