/* Regles communes aux 4 profils de rendu. Portees depuis omega-check
   (D-007/D-008 : meme catalogue de themes, memes conventions visuelles
   pour toute la suite omega-), reduites au sous-ensemble reellement
   utilise par la Phase I (coquille applicative seule) - les classes
   propres a des ecrans pas encore construits (formulaires, tableaux,
   panneaux de progression...) seront ajoutees phase par phase, jamais
   par anticipation (voir plan interface §12).

   Boutons : patron porte tel quel. Le contour rond vit EXCLUSIVEMENT sur
   ".omega-btn-frame" (un Container), jamais sur le Button lui-meme
   ("border: none" partout) : remplir le fond d'un widget au survol/focus
   peint TOUJOURS tout son rectangle, y compris l'anneau de bordure round
   — separer decoration (frame, jamais recolore) et interactivite (Button,
   fond $accent au survol/focus) evite ce bug tout en gardant un focus
   colore selon le theme. ".omega-actions"/".omega-confirm-buttons" ne
   portent PAS de contour a eux : le bouton est deja entoure par son
   propre frame, un deuxieme cadre autour du groupe est redondant. */

Screen {
    background: $background;
    color: $foreground;
}

.omega-title {
    text-style: bold;
    color: $primary;
    border: round $accent;
    padding: 0 1;
    width: auto;
    margin: 1 0;
}

.omega-subtitle {
    color: $secondary;
    padding: 0 0 1 0;
}

.omega-hint {
    color: $foreground 60%;
    padding: 0 0 1 0;
}

.omega-hidden {
    display: none;
}

.omega-panel {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

.omega-form-panel {
    padding: 1 2;
    height: 1fr;
    align-horizontal: center;
    overflow-y: auto;
}

.omega-form-panel > Select,
.omega-form-panel > Input {
    width: 70;
    margin-bottom: 1;
}

/* Choix du moteur HTTP (Configuration de base, plan moteur C++ lot 9) : meme colonne que les champs ; un choix
   impossible est visiblement grise (decision utilisateur 2026-11-02 : griser + expliquer comment degriser). */
.omega-form-panel > RadioSet {
    width: 70;
    margin-bottom: 1;
}

.omega-form-panel RadioButton:disabled {
    text-opacity: 45%;
}

.omega-form-panel .omega-title,
.omega-form-panel .omega-subtitle,
.omega-form-panel .omega-hint {
    width: 70;
}

.omega-form-panel .omega-title {
    content-align: center middle;
}

.omega-form-panel > .omega-actions {
    width: 70;
    align: center middle;
    height: auto;
}

.omega-form-panel > DataTable {
    /* Retour utilisateur 2026-10-10 : premiere DataTable dans un panel
       centre (zones CSP, security_screen.py) - meme largeur que le
       reste du formulaire (Input/Select/titre/sous-titre), sinon elle
       deborderait la colonne de 70 caracteres du reste du panneau. */
    width: 70;
    height: auto;
    max-height: 10;
    margin-bottom: 1;
}

.omega-home-root {
    align: center middle;
    height: 1fr;
    overflow-y: auto;
}

.omega-splash-middle {
    width: 1fr;
}

.omega-splash-hero {
    color: $accent;
    text-align: left;
    width: auto;
}

.omega-splash-prompt {
    color: $secondary;
    width: auto;
    margin-top: 1;
    text-style: italic;
}

.omega-home-wordmark {
    width: auto;
    text-align: left;
    padding-bottom: 1;
}

.omega-home-menu {
    background: $panel;
    border: round $accent;
    border-title-align: center;
    border-title-color: $background;
    border-title-background: $accent;
    border-title-style: bold;
    padding: 1 4;
    width: auto;
    height: auto;
}

.omega-panel-row {
    /* Deux panneaux `.omega-home-menu` cote a cote (retour utilisateur
       2026-10-10, ecran Active Securite : "que cela puisse etre
       lisible") - chacun garde sa largeur/hauteur "auto" propre,
       seul un espacement entre eux est ajoute ici. */
    width: auto;
    height: auto;
}

.omega-panel-row > .omega-home-menu {
    margin-right: 2;
}

.omega-panel-row > .omega-home-menu:last-child {
    margin-right: 0;
}

.omega-actions {
    align: left middle;
    height: auto;
    width: auto;
    margin-top: 1;
    overflow-x: auto;
}

.omega-labeled-input-row {
    /* Une ligne "Static (etiquette) + Input" sans aucun Button/
       Container.omega-btn-frame comme troisieme enfant se retrouve
       incorrectement bornee a la largeur CSS explicite de l'Input
       (24, voir ".omega-actions > Input" plus bas) au lieu de la
       largeur du panneau - bug reel trouve en testant a 80 colonnes
       (le minimum supporte), ou "Nom du service :" disparaissait
       entierement et le champ de saisie devenait inaccessible sans
       defiler horizontalement. Largeur explicite en 1fr plutot que
       "auto" pour forcer le panneau entier, contournement cible a
       cette ligne precise (les lignes de boutons purs, elles,
       calculent leur largeur automatique correctement). */
    width: 1fr;
}

.omega-input-row-label {
    /* Largeur explicite plutot que "auto" (voir .omega-labeled-input-row
       ci-dessus - le meme calcul de largeur automatique qui posait
       probleme sur l'Input semblait aussi affecter ce Static voisin) -
       20 colonnes couvre "Nom du service :" (17 caracteres) avec marge. */
    width: 20;
}

.omega-btn-frame {
    border: round $accent;
    padding: 0;
    width: auto;
    height: auto;
}

.omega-actions > Input {
    /* Meme cause que dans omega-track (bug utilisateur deja rencontre
       et corrige la : Input a "width: 100%" dans le CSS natif de
       Textual, indefini dans un conteneur ".omega-actions" - "width:
       auto" -, provoquant un ascenseur horizontal qui masque les
       boutons suivants). Fixe la meme regle verbatim plutot que de
       laisser le bug reapparaitre ici. */
    width: 24;
    height: 3;
}

.omega-home-menu .omega-btn-frame {
    width: 32;
    height: 3;
    margin-bottom: 0;
}

.omega-home-menu-2col {
    /* Variante scopee (retour utilisateur 2026-09-09) : Configuration
       detaillee du serveur a trop de sous-ecrans (15) pour une colonne
       unique sans defilement excessif - deux colonnes cote a cote dans
       le meme cadre, jamais applique a .omega-home-menu seule (menu
       principal/autres sous-menus, qui restent une seule colonne).
       grid-rows explicite obligatoire : contrairement a une Vertical
       (chaque enfant garde sa propre hauteur "height: 3"), un Grid
       Textual repartit la hauteur totale disponible entre les pistes
       de lignes lui-meme - sans grid-rows, les 8 lignes (15 boutons /
       2 colonnes) etaient ecrasees pour tenir dans la hauteur du
       panneau, rendant le texte des boutons invisible (bug reel trouve
       par capture d'ecran utilisateur : cadres vides, hauteur mesuree
       a 0 sur le Button en test). */
    layout: grid;
    grid-size: 2;
    grid-gutter: 0 1;
    grid-rows: 3;
    grid-columns: 32;
}

.omega-home-menu-2col .omega-btn-frame {
    /* Largeur fixe (comme la version a une colonne, jamais "1fr") -
       retour utilisateur 2026-09-09 : "1fr" demandait a chaque bouton
       de remplir toute la largeur disponible de sa cellule de grille,
       ce qui, combine a un Grid dont la largeur "auto" s'etend alors
       pour occuper tout le terminal, faisait deborder tout le cadre
       "SOUS-ECRANS" sur la largeur complete de l'ecran au lieu de ne
       garder que la largeur necessaire, centree. grid-columns: 32
       (ci-dessus) fixe deja la largeur des colonnes ; ce
       width: 32 (identique a .omega-home-menu .omega-btn-frame,
       repete ici pour rester explicite) fait juste correspondre le
       cadre du bouton a sa cellule. */
    width: 32;
}

.omega-actions Button,
.omega-confirm-buttons Button,
.omega-home-menu Button {
    background: $surface;
    border: none;
    color: $foreground;
    min-width: 10;
}

.omega-home-menu Button {
    width: 100%;
    height: 100%;
    min-width: 0;
}

.omega-actions Button.-primary,
.omega-confirm-buttons Button.-primary {
    background: $surface;
    border: none;
    color: $primary;
}

.omega-actions Button.-error,
.omega-confirm-buttons Button.-error {
    background: $surface;
    border: none;
    color: $error;
}

.omega-actions Button:hover,
.omega-confirm-buttons Button:hover,
.omega-home-menu Button:hover,
.omega-actions Button:focus,
.omega-confirm-buttons Button:focus,
.omega-home-menu Button:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.omega-actions Button.-error:hover,
.omega-confirm-buttons Button.-error:hover,
.omega-actions Button.-error:focus,
.omega-confirm-buttons Button.-error:focus {
    background: $error;
    color: $background;
    text-style: bold;
}

.omega-confirm-box {
    width: 60;
    height: auto;
    border: round $accent;
    padding: 1 2;
    align: center middle;
}

.omega-confirm-title {
    text-style: bold;
    color: $error;
    width: 60;
    content-align: center middle;
    margin-bottom: 1;
}

.omega-confirm-buttons {
    width: 60;
    height: auto;
    align: center middle;
}

.omega-dynamic-form-box {
    /* Retour utilisateur 2026-09-13 ("probleme d'ascenseur" sur le
       formulaire WAF Custom, 7 champs - le plus grand du projet ; "le
       container doit faire le tour du terminal comme les autres") : une
       boite figee a 70 colonnes, centree par Middle()+Center(), forcait
       un defilement interne pour atteindre Valider/Annuler des qu'un
       formulaire depassait ~5 champs (chaque Input Textual occupant 3
       lignes avec sa bordure - un formulaire a 7 champs depasse
       largement les 80% d'un terminal de taille courante). Les autres
       ecrans du projet (.omega-panel/.omega-form-panel) remplissent
       tout le terminal via `height: 1fr`, sans Middle() (qui centre
       verticalement un contenu de taille fixe - incompatible avec
       "remplir tout l'espace") : meme traitement ici, Middle() retire
       du compose() (dynamic_form_screen.py), seul Center() garde pour
       centrer horizontalement une boite qui ne fait pas toute la
       largeur.
       ATTENTION - un `height` en POURCENTAGE (`height: 90%` essaye plus
       tot) REGRESSE dans ce contexte : la boite se resolvait a une
       hauteur quasi nulle (height=0 mesure reellement), rendant tout le
       contenu invisible ("interface vide" - vrai bug reproduit et
       corrige). `height: 1fr` (une fraction d'espace disponible, pas un
       pourcentage) n'a PAS ce probleme - c'est la meme unite que celle
       deja utilisee sans souci par .omega-panel/.omega-form-panel
       partout ailleurs dans ce fichier - verifie par sonde directe
       (region/size mesures) avant d'appliquer. Le defilement interne
       (`overflow-y: auto`) reste en secours pour les formulaires encore
       plus grands qu'un terminal minimal (80x24) ou qu'un tres grand
       formulaire ne suffirait pas a eliminer completement, mais Tab
       fait deja defiler automatiquement le champ focalise en vue
       (verifie par sonde : scroll_offset avance quand le focus atteint
       un champ hors-vue). */
    width: 90%;
    height: 1fr;
    border: round $accent;
    padding: 1 2;
    overflow-y: auto;
}

.omega-dynamic-form-box .omega-title {
    width: 100%;
    content-align: center middle;
}

.omega-dynamic-form-box Input {
    width: 100%;
    margin-bottom: 1;
}

/* Ecran "Etat & Ressources" (retour utilisateur 2026-09-09) - portee
   depuis omega-fire (interfaces/tui/styles/base.tcss::#dashboard-body/
   .dash-col/.omega-dash-box) : 3 colonnes, chaque conteneur est un
   Static borde (titre via border_title, jamais un Rich Panel - meme
   convention deja etablie pour les boutons ailleurs dans ce fichier).
   Contrairement aux ecrans-rapport existants de SERV (log_stats_screen.py
   etc., Static plats sans cadre individuel), cet ecran demande
   explicitement un "visu" de type tableau de bord - exception
   deliberee, pas une derive de convention. */
#resource-dashboard-body {
    height: 1fr;
}

.resource-dash-col {
    width: 1fr;
    height: 1fr;
}

.omega-dash-box {
    border: round $accent;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
    scrollbar-size-vertical: 1;  /* cadres etroits : une seule colonne pour la barre (2026-11-05) */
}

/* Tableau de bord remonte (2026-11-05) : ni retrait du panneau ni marge au-dessus du titre - deux
   lignes de plus pour les cadres, l'ecart titre / cadres est garde. Les autres ecrans ne changent pas. */
#resource-panel {
    padding: 0 2 1 2;  /* les 4 cotes : un `padding-top` seul remettait tout a zero */
}

#resource-panel .omega-title {
    margin: 0 0 1 0;
}

/* Titres des cadres centres (2026-11-05) - seulement ici, pas le panneau stats du viewer de logs. */
#resource-dashboard-body .omega-dash-box {
    border-title-align: center;
}

/* Viewer 1 (log_simple_viewer_screen.py, gestion des logs, refonte menu
   2026-10-15) - panneau stats a gauche (largeur fixe), tableau d'entrees
   parsees a droite (flexible) - repris d'omega-log/base.tcss, regle
   oubliee lors du portage initial (retour utilisateur : "il n'y a aucun
   parser, juste les stats http" - la table etait ecrasee a 1 colonne de
   large, invisible, faute de cette largeur fixe sur sa voisine). */
#stats-frame {
    width: 34;
    height: 1fr;
}

/* Viewer Simple : le corps prend toute la hauteur et le tableau defile (meme regle que #live-body
   d'omega-fire) - sans elle, hauteur auto : 30 lignes visibles, aucun ascenseur (retour utilisateur
   2026-11-02). */
#simple-viewer-body {
    height: 1fr;
}

/* Viewer Simple remonte (retour utilisateur 2026-11-07 : l'ascenseur cachait encore la fin du cadre de stats) :
   ni retrait haut et bas du panneau ni marge au-dessus du titre - 3 lignes de plus pour les cadres, l'ecart
   titre / cadres et cadres / Retour est garde. */
#simple-viewer-panel {
    padding: 0 2 0 2;  /* les 4 cotes : un `padding-top` seul remettait tout a zero */
}

#simple-viewer-panel .omega-title {
    margin: 0 0 1 0;
}

/* Voir et traiter IP, recherche manuelle (2026-11-07) : une IPv6 complete fait 39 caracteres, la largeur 24 des
   champs de .omega-actions la couperait. */
#ip-input {
    width: 42;
}

#simple-viewer-body > DataTable {
    width: 1fr;
    height: 1fr;
}

/* RIPOSTE (OMEGA-SERV_PLAN-DETAILLE_RIPOSTE.md, lot 5, topo §6.3) - ecran ACTIVE SECURITE a trois
   colonnes WAF / ACTIVE DEFENSE / RIPOSTE : classe dediee a cet ecran (les autres menus gardent leur
   cadre de 32). Cadre de bouton 20 (18 cellules de libelle : « Einschränkungen » = 15), padding 1 1 :
   3 x (20 + 2 bordure + 2 padding) + 2 x 2 de marge = 76 colonnes, tient dans 80. */
.omega-security-menu {
    /* Sans ligne vide au-dessus ni au-dessous des boutons (retour de l'auteur du 2026-11-15) : meme serrage
       qu'INTERVENTION MANUELLE et que les cadres de Configuration detaillee, Retour remonte de deux lignes. */
    padding: 0 1;
}

.omega-security-menu .omega-btn-frame {
    width: 20;
}

/* INTERVENTION MANUELLE (decision utilisateur 2026-11-06) : une ligne sous les trois colonnes, exactement de leur
   largeur (3 x 24 + 2 x 2 de marge = 76), titre centre sur la bordure ; trois boutons de 20 centres. */
.omega-home-menu.omega-intervention-menu {
    width: 76;
    height: 5;
    padding: 0 1;
    /* Colle aux trois colonnes, comme « Options et verification » sous « Sous-ecrans » (retour de l'auteur du
       2026-11-15) : une ligne de gagnee pour que Retour remonte, sans barre fixe (reservee aux ecrans de modules). */
    margin-top: 0;
    align: center middle;
}

.omega-intervention-menu .omega-btn-frame {
    width: 20;
    margin: 0 1;
}

/* Tableaux des ecrans RIPOSTE : hauteur auto bornee (jamais 1fr dans une zone qui defile - le tableau
   tomberait a la seule ligne d'en-tete). */
.omega-riposte-table {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

/* Barre d'actions HORS de la zone qui defile (toujours visible) : meme style que .omega-actions. */
.omega-riposte-actions {
    padding: 0 2;
    margin-top: 0;
}

/* Ecran Reverse proxy (lot 11) : deux rangees de boutons hors de la zone qui defile. */
.omega-proxy-actions {
    height: auto;
}

/* Registre des capacites (2026-11-17, barre d'actions fixe en bas) : le tableau prend la place restante et defile
   lui-meme ; en hauteur automatique il debordait du panneau et poussait « Theme d'export HTML » hors de l'ecran. */
#capabilities-table {
    height: 1fr;
    min-height: 4;
}

#proxy-zones-table {
    margin-bottom: 1;
}

/* Modale a plusieurs choix (choice_screen.py) : boutons empiles, pleine largeur de la boite. */
.omega-choice-box {
    width: 72;
    height: auto;
    border: round $accent;
    padding: 1 2;
}

.omega-choice-message {
    padding: 0 0 1 0;
}

.omega-choice-buttons {
    width: 100%;
    height: auto;
}

.omega-choice-buttons .omega-btn-frame {
    width: 100%;
}

.omega-choice-buttons Button {
    width: 100%;
}

.omega-choice-message-scroll {
    height: auto;
    max-height: 14;
}

/* Statistiques et Sante des logs (2026-11-07) : tables dans un panneau qui defile = hauteur du contenu,
   plafonnee (piege omega-log/omega-fire : `1fr` y ecrase la table a son en-tete). Au-dela, la table defile. */
LogStatsScreen #library-table, LogHealthScreen #health-table {
    height: auto;
    max-height: 14;
}

LogHealthScreen #health-disks, LogHealthScreen #health-archives, LogHealthScreen #health-automations {
    margin-bottom: 1;
}

/* Fleche des listes deroulantes (Select) : Textual la dessine en $foreground 50 %, a peine visible dans certains
   themes tant que la liste n'a pas le focus (constat de l'auteur, 2026-11-15). Couleur d'accent du theme, valable
   pour les 10 themes omega : on voit qu'il y a un choix a ouvrir. */
SelectCurrent .arrow {
    color: $primary;
}

/* Ecran Service en formulaire (decision de l'auteur du 2026-11-15) : titre + etat a gauche, boutons de meme largeur
   a droite (colonnes de 14 ; les boutons larges en valent 2), comme la selection des modules WAF ; Retour seul en
   bas, hors de la zone qui defile. */
.omega-panel.omega-service-panel {
    /* 80x24 : les 5 lignes de 3 rangees tiennent avec le titre encadre garde ; seules les marges verticales du cadre
       sont retirees (terminal_frame.tcss pose padding 1 2, d'ou la double classe pour passer devant). */
    padding: 0 2;
}

.omega-service-panel > .omega-title {
    margin: 0 0 1 0;
}

/* Formulaire centre sous le titre centre (grand menu, 2026-11-15) : en 80 colonnes rien ne bouge, sur un terminal
   large le formulaire reste aligne sur le titre et le Retour. Le centrage porte sur le groupe des lignes (elles
   restent alignees a gauche entre elles) ; il se fait ici et non sur le panneau, dont les textes d'aide pleine
   largeur annuleraient le decalage. */
.omega-service-form {
    width: 100%;
    height: auto;
    align-horizontal: center;
    /* Aeration sous le titre (retour de l'auteur du 2026-11-15 : « trop serre ») ; la ligne Pilotage demande une
       ligne de defilement de plus en 80x24, choix assume. */
    margin-top: 1;
}

.omega-service-row {
    width: auto;
    height: 3;
}

.omega-service-label {
    width: 18;
    height: 3;
    padding: 0 1 0 0;
}

.omega-service-label-title {
    text-style: bold;
    color: $primary;
}

.omega-service-label-state {
    color: $foreground;
}

.omega-service-row .omega-btn-frame {
    width: 13;
    height: 3;
}

.omega-service-row .omega-btn-frame.omega-service-wide {
    width: 26;
}

.omega-service-row Button {
    width: 1fr;
    min-width: 0;
    padding: 0;
    background: $surface;
    border: none;
    color: $foreground;
}

.omega-service-row Button.-error {
    color: $error;
}

.omega-service-row Button:hover,
.omega-service-row Button:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.omega-service-row Button:disabled {
    text-opacity: 45%;
}

.omega-service-name-input {
    width: 39;
    height: 3;
}

.omega-service-back {
    height: auto;
    width: 1fr;
    align: center middle;
    margin-top: 0;
}

/* Assistant de profil personnalise : la liste des points a accepter prend la hauteur de son contenu (un Vertical
   vaut 1fr par defaut : dans une zone qui defile il tombait a une ligne et coupait la fin du formulaire). */
#accept-box, .omega-accept-item {
    height: auto;
}

.omega-accept-item > .omega-accept-message {
    padding: 0;
}

.omega-accept-item > Checkbox {
    margin-bottom: 1;
}

/* Grands menus (demande de l'auteur du 2026-11-15) : titre centre dans un cadre de 70 colonnes (comme celui des
   Reglages), aligne sur le Retour centre de la barre fixe. Le panneau garde ses marges laterales seulement. */
.omega-main-title-row {
    width: 100%;
    height: auto;
    align: center top;
}

.omega-main-title-row > .omega-main-title {
    width: 70;
    max-width: 100%;
    content-align: center middle;
    margin: 0 0 1 0;
}

.omega-panel.omega-main-panel {
    padding: 0 2;
}

/* Menus Active Securite et Configuration detaillee (retour de l'auteur du 2026-11-15) : une seule ligne entre le
   plafond et le cadre du titre (celle de la marge du titre) au lieu de deux. */
.omega-panel.omega-menu-panel {
    padding: 0 2;
}

/* « Options et verification » (Configuration detaillee) serre comme INTERVENTION MANUELLE d'Active Securite (retour
   de l'auteur du 2026-11-15) : pas de ligne vide au-dessus ni au-dessous des boutons, Retour remonte de deux lignes.
   Meme largeur que « Sous-ecrans » (padding lateral 4 garde, regle suivante). */
.omega-home-menu-2col.omega-status-menu {
    height: 5;
}

/* Meme serrage pour « Sous-ecrans » sur ce menu seulement (le menu principal garde son padding). */
.omega-menu-panel .omega-home-menu-2col {
    padding: 0 4;
}

/* Guide d'aide (retour de l'auteur du 2026-11-15) : un seul ascenseur, celui du tableau, qui prend la place restante
   (le panneau ne defile plus, il ne deborde plus) ; theme d'export sur une ligne avec son libelle. */
.omega-guide-panel {
    overflow-y: hidden;
}

.omega-guide-panel > #guide-menu-table {
    height: 1fr;
    max-height: 100%;
}

.omega-actions.omega-guide-theme-row {
    width: 100%;
    height: 3;
    margin-top: 0;
    margin-bottom: 1;
}

.omega-guide-panel > .omega-hint {
    padding: 0;
}

.omega-guide-theme-label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 0 1 0 0;
}

.omega-guide-theme-row > Select {
    width: 26;
    margin-right: 1;
}

/* Configuration distante, lot 8 : bilan « prêt / ce qui manque », une ligne par point et son bouton. */
.omega-readiness {
    height: auto;
}

.omega-readiness-row {
    height: auto;
}

.omega-readiness-text {
    width: 1fr;
    height: auto;
    padding: 1 1 0 0;
}

/* Bouton d'un point du bilan : sous son texte, a gauche, au style des autres boutons (.omega-actions). */
.omega-readiness-actions {
    margin-top: 0;
    margin-left: 2;
}

/* FAQ (retour de l'auteur du 2026-11-18) : themes repliables, question en accent, reponse decalee. */
.omega-faq-group {
    margin: 0 0 1 0;
    padding: 0;
    border-top: none;
    background: transparent;
}

.omega-faq-group CollapsibleTitle {
    color: $secondary;
    text-style: bold;
    padding: 0 1;
}

.omega-faq-group CollapsibleTitle:focus {
    background: $boost;
    color: $secondary;
}

.omega-faq-group Contents {
    padding: 0 0 0 2;
}

.omega-faq-question {
    color: $accent;
    text-style: bold;
    padding: 1 0 0 0;
}

.omega-faq-answer {
    color: $foreground;
    padding: 0 0 0 3;
}
