worker_processes WORKERS;
pid @W@/nginx/nginx.pid;
error_log @W@/logs/nginx-error.log;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  sendfile on; tcp_nopush on;
  keepalive_requests 100000;
  access_log @W@/logs/nginx-access.log;
  client_body_temp_path @W@/nginx/tmp; proxy_temp_path @W@/nginx/tmp; fastcgi_temp_path @W@/nginx/tmp; uwsgi_temp_path @W@/nginx/tmp; scgi_temp_path @W@/nginx/tmp;
  server { listen 127.0.0.1:18951; root @W@/www; }
}
