ServerRoot "/usr/lib/httpd"
Listen 127.0.0.1:18955
PidFile "@W@/logs/apache.pid"
ErrorLog "@W@/logs/apache-error.log"
LoadModule mpm_event_module modules/mod_mpm_event.so
LoadModule unixd_module modules/mod_unixd.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule mime_module modules/mod_mime.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule dir_module modules/mod_dir.so
# WORKERS processus (mpm event), nombre fixe : pas de creation/destruction pendant la mesure
StartServers WORKERS
ServerLimit WORKERS
ThreadsPerChild 64
MaxRequestWorkers MAXRW
MinSpareThreads 1
MaxSpareThreads MAXRW
MaxConnectionsPerChild 0
KeepAlive On
MaxKeepAliveRequests 100000
EnableSendfile On
TypesConfig /etc/httpd/conf/mime.types
LogFormat "%h %l %u %t \"%r\" %>s %b" common
CustomLog "@W@/logs/apache-access.log" common
DocumentRoot "@W@/www"
<Directory "@W@/www">
    Require all granted
</Directory>
