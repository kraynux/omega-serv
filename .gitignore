# ==============================================================================
# omega-serv - fichiers jamais versionnes
# Meme logique que les exclusions de build-release.sh : ce qui n'est pas livre
# dans l'archive (etat, secrets, binaires compiles) n'est pas commit non plus.
# ==============================================================================

# --- Environnement Python et caches d'outils ---------------------------------
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/
.coverage
htmlcov/

# --- Etat vivant sous var/ (recree au demarrage) -----------------------------
# Tout var/ est de l'etat (journaux, bases Active Defense et RIPOSTE, blocklist,
# cle de declaration anonyme, favoris, bibliotheque, sources distantes SSH) :
# seuls les .gitkeep gardent l'arborescence.
var/**
!var/
!var/*/
!var/*/.gitkeep

# --- Configuration active (config init) --------------------------------------
# config/profiles, schemas et defaults restent versionnes (references).
config/omega-serve.json

# --- Secrets et donnees propres au site --------------------------------------
secure/auth/*
!secure/auth/.gitkeep
secure/secrets/*
!secure/secrets/.gitkeep
secure/certificates/**/*.key
secure/certificates/**/*.pem
secure/certificates/**/*.crt
secure/certificates/**/*.csr
secure/certificates/**/*.p12
secure/certificates/**/*.pfx
secure/certificates/**/*.der
secure/certificates/**/serial.txt
secure/certificates/**/index.txt
secure/certificates/acme/**
secure/certificates/letsencrypt/**
secure/waf/blocklist.json
secure/waf/allowlist.json
# Regles et script propres au site de l'auteur (waf.lua generique, lui, versionne)
secure/waf/rules/custom.json
secure/waf/scripts/waf-personal.lua
# Listes de mots-cles saisies par l'utilisateur (seul le .example est versionne)
secure/waf/rules/keywords/*.txt

# --- Moteur natif : compilations et binaire ----------------------------------
# Recompile par build-release.sh (archive) ou install.sh (sur place).
native/*/build*/
/bin/

# --- Site servi : contenu propre a chaque installation -----------------------
webroot/*
!webroot/assets/
webroot/assets/*
!webroot/assets/.gitkeep
**/HEADER.txt

# --- Archives distribuables et sorties de build ------------------------------
omega-serv.tar.gz
omega-serv-*.tar.gz
vendor/
dist/
/build/

# --- Editeurs et systeme -----------------------------------------------------
*~
*.bak
*.orig
*.rej
*.swp
.DS_Store
Thumbs.db
.claude/
