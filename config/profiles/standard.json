{
  "name": "standard",
  "description": "Site statique ou petit site de production raisonnablement protege : headers de securite usuels, CSP de base stricte, directory listing/CGI/FastCGI desactives.",
  "server": {
    "bind": "127.0.0.1"
  },
  "security": {
    "allowed_methods": ["GET", "HEAD"],
    "deny_hidden_files": true,
    "reject_path_traversal": true,
    "normalize_url": true,
    "require_valid_host": true,
    "security_headers_enabled": true,
    "csp_mode": "enforce"
  },
  "options": {
    "waf": { "enabled": false },
    "auth": { "enabled": false },
    "dirlisting": { "enabled": false },
    "fastcgi": { "enabled": false },
    "cache": { "enabled": true },
    "trusted_proxy": { "enabled": false }
  }
}
